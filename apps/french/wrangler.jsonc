{
  // icanspeak French — https://icanspeak.it/french/*
  // Assets only (no Worker code): the static build, copied under french/ by
  // `pnpm cf:prepare` (scripts/nest-dist.mjs), because the route keeps the /french prefix.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "icanspeak-french",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cf-dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "icanspeak.it/french", "zone_name": "icanspeak.it" },
    { "pattern": "icanspeak.it/french/*", "zone_name": "icanspeak.it" }
  ]
}
