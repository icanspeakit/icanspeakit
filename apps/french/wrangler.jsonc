{
  // icanspeak French — https://icanspeak.it/francais/*
  // Assets only (no Worker code): the static build, copied under francais/ by
  // `pnpm cf:prepare` (scripts/nest-dist.mjs), because the route keeps the /francais prefix.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "icanspeak-french",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cf-dist",
    "not_found_handling": "404-page",
    // Canonicals, sitemap and internal links have no trailing slash; serve the page there
    // directly instead of a 307 to the slash version (same as apps/english).
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "icanspeak.it/francais", "zone_name": "icanspeak.it" },
    { "pattern": "icanspeak.it/francais/*", "zone_name": "icanspeak.it" }
  ]
}
