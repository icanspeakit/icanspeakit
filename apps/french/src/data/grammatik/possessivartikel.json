            ["la fille de Mamadou", "Mamadou's daughter"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: mon amie",
          "variant": "dat",
          "items": [
            "mon amie, mon adresse, mon école: feminine nouns that start with a vowel.",
            "With a consonant, use ma: ma mère, ma clé."
          ]
        },
        {
          "badge": "No article with a possessive",
          "items": [
            "C'est mon fils. Not: C'est le mon fils.",
            "C'est le fils de Léa. With de, use the article."
          ]
        }
      ]
    }
  },
