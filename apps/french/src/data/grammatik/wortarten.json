    "exampleHtml": "<span class=\"vp-prep\">La</span> <span class=\"vp-verb\">maison</span> neuve <span class=\"vp-verb\">est</span> à Lyon.",
    "qa": [
      {
        "html": "<strong>Noun</strong> (<em>nom</em>): names a person, thing or place: <em>maison, médecin, Paris</em>. It has a gender. <strong>Article</strong> (<em>article</em>): comes before a noun: <em>le, la, l', les, un, une, des</em>.",
        "tag": "Noun, article"
      },
      {
        "html": "<strong>Verb</strong> (<em>verbe</em>): says what someone does or what something is: <em>travaille, manges, est</em>. Its ending changes for the person.",
        "tag": "Verb"
      },
      {
        "html": "<strong>Adjective</strong> (<em>adjectif</em>): describes a noun and matches it: <em>une maison blanche</em>. <strong>Adverb</strong> (<em>adverbe</em>): says how, when or where, and does not change: <em>bien, aujourd'hui, ici, très</em>.",
        "tag": "Adjective, adverb"
      },
      {
        "html": "<strong>Pronoun</strong> (<em>pronom</em>): stands for a noun: <em>je, tu, elle</em>. <strong>Preposition</strong> (<em>préposition</em>): a small word before a noun: <em>à, de, en, dans, avec, pour</em>. <strong>Conjunction</strong> (<em>conjonction</em>): joins words or sentences: <em>et, ou, mais, parce que</em>.",
        "tag": "Small words"
      }
    ],
    "noteHtml": "A quick test: can you put <em>le</em> or <em>la</em> in front of the word? Then it is probably a noun. Does it change with <em>je, tu, il</em>? Then it is a verb. Does it get an <em>-e</em> with a feminine noun (<em>grand, grande</em>)? Then it is probably an adjective.",
