{
  "id": "nomen-verb-verbindungen",
  "name": "Verb + noun collocations: prendre une décision, faire la queue",
  "level": "B2",
  "variety": "fr-FR",
  "subtitle": "French has fixed verb + noun pairs that you must learn as a unit: prendre une décision, prendre rendez-vous, faire attention, faire la queue, poser une question, porter plainte, rendre service. The verb is often not the English one: you take a decision (not make one), and passer un examen means to take an exam, not to pass it. To pass, say réussir un examen.",
  "briefMarks": [
    "prendre une décision",
    "prendre rendez-vous",
    "faire attention",
    "faire la queue",
    "poser une question",
    "porter plainte",
    "passer un examen",
    "réussir un examen"
  ],
  "source": "icanspeak French original text (grammar-b2 run, 2026-11-08)",
  "concept": {
