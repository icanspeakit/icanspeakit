            ["J'ai une voiture.", "Je n'ai pas de voiture."],
            ["Il a des enfants.", "Il n'a pas d'enfants."],
            ["Il y a du lait.", "Il n'y a pas de lait."],
            ["C'est un problème.", "Ce n'est pas un problème."]
          ],
          "note": "After être, un and une do not change."
        }
      ],
      "boxes": [
        {
          "badge": "The order",
          "variant": "dat",
          "items": [
            "ne + verb + pas: Je ne sais pas.",
            "n' + vowel: Je n'ai pas, Il n'y a pas.",
            "pas de (pas d') after avoir and il y a."
          ]
        }
      ]
    }
  },
