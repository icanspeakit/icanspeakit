        { "pron": "ils, elles", "end": "-ent" }
      ],
      "verbs": [
        { "inf": "parler", "forms": ["parl|e", "parl|es", "parl|e", "parl|ons", "parl|ez", "parl|ent"] },
        { "inf": "habiter", "forms": ["habit|e", "habit|es", "habit|e", "habit|ons", "habit|ez", "habit|ent"] },
