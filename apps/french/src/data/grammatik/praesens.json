  "name": "Present tense: regular -er verbs",
  "level": "A1",
  "variety": "fr-FR",
  "subtitle": "Most French verbs end in -er. Take off -er and add the ending for the person: parler → je parle, tu parles, nous parlons, vous parlez. Je parle, tu parles, il parle and ils parlent all sound the same.",
  "briefMarks": ["-er", "-e", "-es", "-ons", "-ez", "-ent"],
  "source": "icanspeak French original text (grammar-a1 run, 2026-11-08)",
  "concept": {
    "qaWithTable": true,
    "flow": [
      { "text": "stem: parl-", "variant": "prep" },
      { "text": "ending: -e, -es, -e, -ons, -ez, -ent", "variant": "verb" },
      { "text": "je parle, nous parlons" }
    ],
    "exampleHtml": "Je travaill<span class=\"vp-verb\">e</span> dans un hôtel. · Tu parl<span class=\"vp-verb\">es</span> anglais<em> ?</em> · Nous habit<span class=\"vp-verb\">ons</span> à Lille. · Elles étudi<span class=\"vp-verb\">ent</span> le soir.",
    "table": {
      "caption": "Present tense: the endings",
