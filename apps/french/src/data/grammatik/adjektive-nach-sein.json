            ["-en", "italien", "italienne", "italiens", "italiennes"],
            ["-er", "cher", "chère", "chers", "chères"],
            ["beau", "beau (bel + vowel)", "belle", "beaux", "belles"],
            ["nouveau", "nouveau (nouvel + vowel)", "nouvelle", "nouveaux", "nouvelles"],
            ["vieux", "vieux (vieil + vowel)", "vieille", "vieux", "vieilles"]
          ]
        },
        {
          "caption": "Useful adjectives",
          "head": ["Adjective", "Opposite", "Meaning"],
          "rows": [
            ["grand", "petit", "big, small"],
            ["nouveau", "vieux", "new, old"],
            ["facile", "difficile", "easy, difficult"],
            ["propre", "sale", "clean, dirty"],
            ["content", "triste", "happy, sad"],
            ["bon", "mauvais", "good, bad"]
          ]
        },
        {
          "caption": "Short adjectives before the noun",
          "head": ["Adjective", "Examples"],
          "rows": [
            ["petit, grand", "un petit café, une grande chambre"],
            ["bon, mauvais", "un bon médecin, une mauvaise idée"],
            ["beau, joli", "un bel appartement, une jolie rue"],
            ["nouveau, vieux, jeune", "un nouvel ami, une vieille maison, un jeune homme"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: colours",
          "variant": "dat",
          "items": [
            "Most colours add -e: vert → verte, bleu → bleue, noir → noire, blanc → blanche.",
            "Colours in -e stay the same: rouge, jaune, rose.",
            "Marron and orange never change: des chaussures marron."
          ]
        }
      ]
    }
  },
