{
  "id": "irgend",
  "name": "n'importe: any … at all (Appelle-moi n'importe quand)",
  "level": "B2",
  "variety": "fr-FR",
  "subtitle": "n'importe + a question word means \"any … at all, it makes no difference\": n'importe qui, n'importe quoi, n'importe où, n'importe quand, n'importe comment. Appelle-moi n'importe quand. Before a noun use n'importe quel / quelle, and as a pronoun n'importe lequel / laquelle. n'importe quoi can also mean \"nonsense\": Il dit n'importe quoi. For someone specific but unknown, use quelqu'un instead.",
  "briefMarks": [
    "n'importe qui",
    "n'importe quoi",
    "n'importe où",
    "n'importe quand",
    "n'importe comment",
    "n'importe quel jour",
    "n'importe quelle pharmacie",
    "n'importe lequel"
  ],
  "source": "icanspeak French original text (grammar-b2 run, 2026-11-08)",
  "concept": {
    "flow": [
