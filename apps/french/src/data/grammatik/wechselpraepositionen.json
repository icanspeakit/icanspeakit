{
  "id": "wechselpraepositionen",
  "name": "Places and towns: à, en, au, aux, chez",
  "level": "A2",
  "variety": "fr-FR",
  "subtitle": "Use à with a city (à Paris), en with feminine countries and countries that start with a vowel (en France, en Iran), au with masculine countries (au Maroc) and aux with plural ones (aux États-Unis). French uses the same word for \"in\" and \"to\". To say where you come from, use de, d', du or des: Je viens du Maroc.",
  "briefMarks": ["à", "en", "au", "aux", "chez", "à la", "à l'", "de", "d'", "du", "des"],
  "source": "icanspeak French original text (grammar-a2 run, 2026-11-08)",
  "concept": {
    "flow": [
      { "text": "j'habite · je vais · je suis", "variant": "verb" },
      { "text": "à · en · au · aux · chez", "variant": "prep" },
      { "text": "the place" }
    ],
    "exampleHtml": "<span class=\"vp-verb\">J'habite</span> <span class=\"vp-prep\">à</span> Paris. · <span class=\"vp-verb\">Je vais</span> <span class=\"vp-prep\">en</span> France. · <span class=\"vp-verb\">Elle vit</span> <span class=\"vp-prep\">au</span> Maroc. · <span class=\"vp-verb\">Nous allons</span> <span class=\"vp-prep\">chez</span> le médecin. · <span class=\"vp-verb\">Je viens</span> <span class=\"vp-prep\">du</span> Maroc.",
    "qa": [
      {
        "html": "A city takes <strong>à</strong>, whether you are there or going there: <em>J'habite à Lyon. Je vais à Marseille.</em>",
        "tag": "à + city"
      },
      {
        "html": "<strong>en</strong> goes with feminine countries (most end in <em>-e</em>) and with any country that starts with a vowel: <em>en France, en Italie, en Espagne, en Algérie, en Iran</em>. Continents too: <em>en Europe, en Afrique</em>.",
        "tag": "en"
      },
      {
        "html": "<strong>au</strong> goes with masculine countries, <strong>aux</strong> with plural ones: <em>au Maroc, au Canada, au Portugal, au Japon; aux États-Unis, aux Pays-Bas</em>.",
        "tag": "au, aux"
      },
      {
        "html": "French uses <strong>one word for \"in\" and \"to\"</strong>: <em>Je suis en Italie. Je vais en Italie.</em> <em>Elle est au Maroc. Elle va au Maroc.</em> You do not have to choose between being and going.",
        "tag": "in = to"
      },
      {
        "html": "For buildings and daily places use <strong>au, à la, à l'</strong>: <em>Je suis au travail. Elle est à la mairie. Il va à l'hôpital.</em> For a person's place use <strong>chez</strong>: <em>chez le médecin, chez moi, chez Karim</em>.",
        "tag": "au, à la, chez"
      },
      {
        "html": "Where you come from takes <strong>de</strong>, <strong>d'</strong> before a vowel, <strong>du</strong> or <strong>des</strong>: <em>Je viens de Paris, de France, d'Algérie, du Maroc, des États-Unis.</em>",
        "tag": "Coming from"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Je vais en Paris</em> → ✓ <em>Je vais à Paris</em>. ✗ <em>J'habite à France</em> → ✓ <em>J'habite en France</em>. ✗ <em>Je vais à Canada</em> → ✓ <em>Je vais au Canada</em>. ✗ <em>Je vais au médecin</em> → ✓ <em>Je vais chez le médecin</em>. ✗ <em>Je viens de le Maroc</em> → ✓ <em>Je viens du Maroc</em>. ✗ <em>Je viens de États-Unis</em> → ✓ <em>Je viens des États-Unis</em>. Next: <a href=\"/prepositions-of-place\">prepositions of place</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "In or to",
          "head": ["Place", "Word", "Example"],
