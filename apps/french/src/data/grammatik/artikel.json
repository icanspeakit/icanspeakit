            ["la + école", "l'école"],
            ["le + ami", "l'ami"],
            ["la + amie", "l'amie"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: au, aux, du",
          "variant": "dat",
          "items": [
            "Je vais au centre de santé. Not: à le centre.",
            "C'est le livre du professeur. Not: de le professeur.",
            "Nous allons aux urgences. Not: à les urgences."
          ]
        },
        {
          "badge": "No article",
          "items": [
            "Jobs after être: Je suis électricien.",
            "Most languages after parler: Je parle arabe.",
            "Most towns: Paris, Lyon."
          ]
        }
      ]
    }
  },
