{
  "id": "artikel",
  "name": "Articles: le, la, l', les, un, une, des",
  "level": "A1",
  "variety": "fr-FR",
  "subtitle": "French has le, la and l' for “the” in the singular, and les in the plural. For “a” it has un and une, and des for “some”. The article shows if the noun is masculine or feminine, singular or plural.",
  "briefMarks": ["le", "la", "l'", "les", "un", "une", "des", "au", "aux", "du"],
  "source": "icanspeak French original text (grammar-a1 run, 2026-11-08)",
  "concept": {
    "flow": [
      { "text": "le / la / l' / les", "variant": "prep" },
      { "text": "un / une / des", "variant": "prep" },
      { "text": "noun", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">un</span> livre → <span class=\"vp-prep\">le</span> livre · <span class=\"vp-prep\">une</span> clé → <span class=\"vp-prep\">la</span> clé · <span class=\"vp-prep\">un</span> hôtel → <span class=\"vp-prep\">l'</span>hôtel · <span class=\"vp-prep\">des</span> livres → <span class=\"vp-prep\">les</span> livres",
    "qa": [
      {
        "html": "<strong>le, la, l', les</strong> mean “the”. Use them for something you both know: <em>La pharmacie est ici.</em> Before a vowel or a silent h, <em>le</em> and <em>la</em> become <strong>l'</strong>: <em>l'école, l'hôpital</em>.",
        "tag": "the"
      },
      {
        "html": "<strong>un, une</strong> mean “a”. <strong>des</strong> means “some”. Use them for something new: <em>Je cherche une pharmacie.</em> <em>J'ai des amis à Lyon.</em>",
        "tag": "a, some"
      },
      {
        "html": "<strong>à + le = au</strong>, <strong>à + les = aux</strong>, <strong>de + le = du</strong>, <strong>de + les = des</strong>: <em>Je vais au marché.</em> <em>Elle vient du travail.</em> The others do not join: <em>à la, à l', de la, de l'</em>.",
        "tag": "au, aux, du, des"
      },
      {
        "html": "Say a job after <em>être</em> without an article: <em>Il est infirmier. Elle est boulangère.</em> Not: <em>Il est un infirmier.</em>",
        "tag": "Jobs"
      },
      {
        "html": "French uses <em>le, la, les</em> for things in general, where English uses no article: <em>J'aime le café. Les enfants aiment les gâteaux.</em> Not: <em>J'aime café.</em>",
        "tag": "In general"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Je vais à le marché</em> → ✓ <em>Je vais au marché</em>. ✗ <em>Il est un infirmier</em> → ✓ <em>Il est infirmier</em>. ✗ <em>la école</em> → ✓ <em>l'école</em>. Not sure about the gender? See <a href=\"/noun-gender\">Nouns and gender</a>. For <em>c'est un médecin</em>, see <a href=\"/hay-estar\">il y a, c'est and il est</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "All the articles",
          "head": ["", "masculine", "feminine"],
          "rows": [
            ["“the”, singular", "le livre, l'hôtel", "la maison, l'école"],
            ["“the”, plural", "les livres", "les maisons"],
            ["“a”, singular", "un livre", "une maison"],
            ["“some”, plural", "des livres", "des maisons"]
          ]
        },
        {
          "caption": "à and de with the article",
          "note": "Here des is “de + les”. It is not the same des as in “some books”.",
          "head": ["", "le", "la", "l'", "les"],
          "rows": [
            ["à", "au", "à la", "à l'", "aux"],
            ["de", "du", "de la", "de l'", "des"]
          ]
        },
        {
          "caption": "Elision: le and la before a vowel",
