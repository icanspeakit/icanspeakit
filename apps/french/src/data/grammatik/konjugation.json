            ["mettre", "put, put on", "Je mets mon manteau."],
            ["voir", "see", "Je vois le médecin."],
            ["dire", "say, tell", "Je dis bonjour."]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: the plural",
          "variant": "dat",
          "items": [
            "Four irregular verbs end in -ont: ils vont, ils font, ils sont, ils ont.",
            "venir and prendre double the n: ils viennent, ils prennent.",
            "vous faites and vous dites (not faisez, disez)."
          ]
        }
      ]
    }
  },
