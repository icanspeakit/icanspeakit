          "right": { "name": "quaki", "expr": "happy", "say": "Oui, j'{ai} très faim." }
        },
        {
          "caption": "age: avoir",
          "tag": "{ai} · {as} · a",
          "left": { "name": "quaki", "expr": "thinking", "say": "Tu {as} quel âge ?" },
