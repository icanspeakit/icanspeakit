---
import Layout from "../../layouts/Layout.astro";
import ExamShell from "../../components/ExamShell.astro";
import SatzListe from "../../components/SatzListe.astro";
import ExamPractice from "../../components/ExamPractice.astro";
import ExamFormat from "../../components/ExamFormat.astro";
import telcFormate from "../../data/pruefungen/telc-formate.json";

// TCF by level (content-plan §2: the telc slot). Format data comes from telc-formate.json.
// The real TCF is one test whose questions rise in difficulty; each set here holds the tasks
// aimed at one band. Official exam items are never reproduced here.
const formate = telcFormate.formate;
---
<Layout
  title="TCF by level: practice and exam format – icanspeak French"
  description="Practise TCF-style tasks band by band, from A1 to C1: reading, listening, writing and speaking at each band, with a timer and answers. Not official exam material."
>
  <ExamShell
    bild="telc"
    header="TCF by level"
    title="TCF by level"
    titleKey="telc.title"
    lead="TCF-style tasks, one band at a time. The real TCF (tout public, IRN and Canada) is one test whose questions get harder as you go; here you can practise the tasks that aim at your level, band by band."
    leadKey="telc.lead"
    badges={["A1–C1"]}
    practiceHeading="Practise for the TCF by level"
    practiceHeadingKey="telc.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="telc.who.title">Who is the TCF for?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="telc.who.badge.level">Tasks from A1 to C1</span>
          <span class="exam-meta-badge" data-i18n="telc.who.badge.modular">A result per skill</span>
        </div>
        <p data-i18n="telc.who.text">
          The TCF (Test de connaissance du français) is run by France Éducation international. It is one
          test for all levels rather than one exam per level, and it gives a level, not a pass or a fail.
          The TCF tout public is for study and work, the TCF IRN is for residence and nationality
          procedures in France, and the TCF Canada is for Canadian immigration. Which version you need,
          and which level, depends on the institution or procedure, so check before you book (to verify).
        </p>
        <p><a class="plan-link" href="/exams/delf-tcf-or-tef" data-i18n="testdaf.whichExam">DELF, TCF or TEF? Compare them by purpose →</a></p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Skills tested</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Reading</h4><p data-i18n="skill.lesen.desc">Reading comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Listening</h4><p data-i18n="skill.hoeren.desc">Listening comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Writing</h4><p data-i18n="skill.schreiben.desc">Written expression</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Speaking</h4><p data-i18n="skill.sprechen.oralDesc">Spoken expression</p></div>
        </div>
        <p class="format-note" data-i18n="telc.sprachbausteine.note">
          The TCF tout public also has a compulsory paper on language structures (structures de la
          langue), and its writing and speaking papers are optional in some versions (to verify). Our
          sets hold the four skills. For grammar and vocabulary in context, use the language-in-use
          trainer below.
        </p>
      </section>

      {formate.map((f) => <ExamFormat format={f} />)}

      <section class="exam-section">
        <h2 data-i18n="telc.moreLevels.title">How this differs from the real test</h2>
        <p class="format-note" data-i18n="telc.moreLevels.text">
          The bands are our way of cutting up one test: you can't book a "TCF B1". Our tasks follow the
          kinds of task the TCF is known for, but numbers of questions, timings and word counts are our own
          and the real ones may differ (to verify). Check the current details with France Éducation
          international or your test centre.
        </p>
      </section>
    </Fragment>

    <SatzListe exam="telc" />

    <div class="mock-cta">
      <h2 data-i18n="telc.sb.title">Practise language in use</h2>
      <p data-i18n="telc.sb.text">
        More gap-fill practice with grammar and vocabulary in context. It is general practice in the spirit
        of the lexique et structure section of the TEF, so its layout isn't the TCF's.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/tef/language-in-use" data-i18n="telc.sb.cta">To the language-in-use trainer</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="fallen.title">Exam traps</h2>
      <p data-i18n="fallen.entry.blurb">Spots with a catch – briefly explained, with an example and a task to try.</p>
      <a class="quiz-btn quiz-btn--primary" href="/exams/traps" data-i18n="fallen.entry.cta">See the traps</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="telc.a1.title">More at A1: our DELF A1 practice test</h2>
      <p data-i18n="telc.a1.text">
        Our own A1 practice test in the style of the DELF, for more A1 practice than the first TCF tasks
        give. It is marked against a 60 % pass line, which is our own convention, not an official mark.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/delf-dalf/a1" data-i18n="exam.startSet">Start the practice set</a>
    </div>

    <ExamPractice
      heading="Train the basics"
      headingKey="exam.practice.heading"
      intro="These tools help at every level and for every exam. They train articles, grammar and vocabulary in general, not TCF-specific task types."
      introKey="telc.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>
