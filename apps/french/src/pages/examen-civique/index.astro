---
import Layout from "../../layouts/Layout.astro";
import ExamShell from "../../components/ExamShell.astro";
import ExamPractice from "../../components/ExamPractice.astro";
import lid from "../../data/leben-in-deutschland.json";

const { meta, questions, bundeslaender } = lid;
---
<Layout
  title="France's civic exam: format and practice – icanspeak French"
  description="The civic exam for French residence cards and nationality: how it works, what the questions are about and how to prepare. Our own practice questions; general orientation, not legal advice."
>
  <ExamShell
    bild="leben-in-deutschland"
    header="Civic exam"
    title="Civic exam"
    titleKey="exam.lid.name"
    lead="France's civic exam: a multiple-choice test, in French, on the values of the Republic, its institutions, history, rights and duties and daily life. It is linked to residence cards and naturalisation."
    leadKey="lid.lead"
    badges={["Knowledge test"]}
    badgeKeys={["lid.badge.knowledgeTest"]}
    practiceHeading="Practise for the exam"
    practiceHeadingKey="lid.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="lid.who.title">Who is the civic exam for?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="lid.who.badge.noCefr">No CEFR level: a knowledge test</span>
          <span class="exam-meta-badge" data-i18n="lid.who.badge.course">Residence card or naturalisation</span>
        </div>
        <p><a href="/residence-et-nationalite" data-i18n="nat.link.more">How residence and nationality work, step by step</a></p>
        <p data-i18n="lid.who.text">The civic exam does not test your level of French but your knowledge of the Republic and of life in France. As far as we could check in November 2026, people who apply for a multi-year residence card, a resident card or French nationality by naturalisation may have to pass it, usually together with a French language level, and some applicants are exempt. This is general orientation, not legal advice: check who must take it, and when, on service-public.gouv.fr and with your préfecture.</p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Skills tested</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Reading</h4><p data-i18n="lid.skill.lesen.desc">Reading and understanding the questions</p></div>
          <div class="skill-card skill-card--na"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Listening</h4><p data-i18n="lid.skill.hoeren.desc">No listening in this exam</p></div>
          <div class="skill-card skill-card--na"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Writing</h4><p data-i18n="lid.skill.schreiben.desc">No writing part: choosing answers only</p></div>
          <div class="skill-card skill-card--na"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Speaking</h4><p data-i18n="lid.skill.sprechen.desc">No separate speaking part in this exam</p></div>
        </div>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.format.title">Format</h2>
        <div class="format-table-wrap">
          <table class="format-table">
            <thead><tr><th data-i18n="format.th.part">Part</th><th data-i18n="format.th.what">What is tested</th><th data-i18n="format.th.scope">Scope</th></tr></thead>
            <tbody>
              {meta.tareas.map((t) => (
                <tr><td lang="fr">{t.title}</td><td data-i18n={`lid.tarea.${t.n}.what`}>{t.title}</td><td data-i18n={`lid.tarea.${t.options === 2 ? "tf" : "mc"}`} data-i18n-vars={JSON.stringify({ n: t.realCount })}>{t.realCount}</td></tr>
              ))}
              <tr><td data-i18n="lid.fmt.state.part">Our extra: the regions</td><td data-i18n="lid.fmt.state.what">Practice questions on the regions of France (not part of the real exam)</td><td data-i18n="lid.fmt.state.scope" data-i18n-vars={JSON.stringify({ st: meta.stateQuestions })}>{meta.stateQuestions}</td></tr>
            </tbody>
          </table>
        </div>
        <p class="format-note" data-i18n-html="lid.format.note" data-i18n-vars={JSON.stringify({ t: meta.totalQuestions, m: meta.minutes, pass: meta.passScore, fed: questions.length })}>
          {meta.totalQuestions} questions, {meta.minutes} minutes, pass with {meta.passScore} correct answers.
        </p>
        <p class="format-note" data-i18n="lid.format.more">The exam is taken in French on a computer at an approved centre. The price, the registration steps and how long a result stays valid change, so check them on service-public.gouv.fr and with the centre before you register.</p>
        <p class="format-note">{meta.sourceNote}</p>
      </section>
    </Fragment>

    <div class="mock-cta mock-cta--lead">
      <h2 data-i18n="lid.cta.title" data-i18n-vars={JSON.stringify({ n: meta.federalQuestions, t: meta.totalQuestions, st: meta.stateQuestions, m: meta.minutes, pass: meta.passScore, fed: questions.length, bl: bundeslaender.length, src: meta.sourceNote, facts: meta.stateFactsNote })}>{questions.length} questions on France</h2>
      <p data-i18n="lid.cta.text" data-i18n-vars={JSON.stringify({ n: meta.federalQuestions, t: meta.totalQuestions, st: meta.stateQuestions, m: meta.minutes, pass: meta.passScore, fed: questions.length, bl: bundeslaender.length, src: meta.sourceNote, facts: meta.stateFactsNote })}>
        Our own questions on the values of the Republic, institutions, rights and duties, history and daily life, each with a short explanation in English. There is also extra practice on the regions of France (bl to choose from).
      </p>
      <div class="exam-meta-row">
        <a class="quiz-btn quiz-btn--primary" href="/examen-civique/test" data-i18n="lid.cta.test">To the practice test</a>
        <a class="quiz-btn quiz-btn--primary" href="/examen-civique/faits" data-i18n="lid.cta.facts">Learn the facts</a>
      </div>
    </div>

    <ExamPractice
      heading="Prepare the language side"
      headingKey="lid.practice.heading"
      introKey="lid.practice.intro"
      intro="The civic exam checks knowledge, not a language level, but you do have to understand the questions and the answer options. These tools help with that side. It has no speaking or writing part, so the speaking and writing tools are not linked here."
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>
