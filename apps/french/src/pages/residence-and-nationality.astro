---
// The path to a French residence card and to naturalisation (content-plan §2.3, §5.11): language
// level and civic exam per step, who may be exempt, the steps in order. General orientation,
// never legal advice. Every uncertain fact is worded "to verify" and listed in
// reports/nationality-path.md. All text lives in public/i18n/en.json, read here so that one
// file holds each sentence.
import ExamDisclaimer from "../components/ExamDisclaimer.astro";
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import "../styles/pruefungen.css";
import en from "../../public/i18n/en.json";

const tx = (key: string) => (en as Record<string, string>)[key];

const levels = ["multi", "res", "nat", "mar", "ren"];
const how = ["1", "2", "3", "4"];
const exempt = ["1", "2", "3", "4"];
const shortVersion = ["1", "2", "3", "4"];
const stepNumbers = ["1", "2", "3", "4", "5", "6", "7"];
const words = [
  ["la préfecture", "prefecture"],
  ["le titre de séjour", "titre"],
  ["la carte de séjour pluriannuelle", "pluri"],
  ["la carte de résident", "resident"],
  ["la naturalisation", "naturalisation"],
  ["le décret", "decret"],
  ["l’entretien d’assimilation", "entretien"],
  ["l’examen civique", "civique"],
  ["le justificatif de domicile", "domicile"],
  ["l’acte de naissance", "naissance"],
  ["la traduction assermentée", "traduction"],
  ["l’OFII", "ofii"],
  ["l’ANEF", "anef"],
];
const practice = [
  { key: "civic", href: "/civic-exam" },
  { key: "mock", href: "/residence-and-nationality/tcf-irn/practice-set" },
  { key: "exams", href: "/exams/delf-tcf-or-tef" },
];
// Starting points for the learner, not sources of ours: each one is "to verify" in the report.
const sources = [
  { key: "sp", url: "https://www.service-public.gouv.fr/particuliers/vosdroits/F34501" },
  { key: "nat", url: "https://www.service-public.gouv.fr/particuliers/vosdroits/N111" },
  { key: "int", url: "https://www.immigration.interieur.gouv.fr/" },
  { key: "ofii", url: "https://www.ofii.fr/" },
  { key: "fei", url: "https://www.france-education-international.fr/tcf-irn" },
];
---
<Layout
  title="French residence card and nationality: language level and civic exam – icanspeak French"
  description="The path to a French residence card and to French nationality: which language level and which civic exam each step asks for, who may be exempt, and the steps in order. General orientation, not legal advice."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main practice-main--wide">
    <a href="/exams" class="vp-back-link" data-i18n="fallen.back">{tx("fallen.back")}</a>

    <div class="practice-hero">
      <p class="eyebrow" data-i18n="nat.eyebrow">{tx("nat.eyebrow")}</p>
      <h1 data-i18n="nat.title">{tx("nat.title")}</h1>
      <p data-i18n="nat.lead">{tx("nat.lead")}</p>
      <p data-i18n-html="nat.legal" set:html={tx("nat.legal")} />
      <ExamDisclaimer />
    </div>

    <section class="exam-section">
      <h2 data-i18n="nat.short.title">{tx("nat.short.title")}</h2>
      <ul class="task-points">
        {shortVersion.map((n) => <li data-i18n={`nat.short.${n}`}>{tx(`nat.short.${n}`)}</li>)}
      </ul>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.lv.title">{tx("nat.lv.title")}</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead>
            <tr>
              <th data-i18n="nat.lv.th.step">{tx("nat.lv.th.step")}</th>
              <th data-i18n="nat.lv.th.lang">{tx("nat.lv.th.lang")}</th>
              <th data-i18n="nat.lv.th.civic">{tx("nat.lv.th.civic")}</th>
            </tr>
          </thead>
          <tbody>
            {levels.map((k) => (
              <tr>
                <th scope="row" data-i18n={`nat.lv.${k}.step`}>{tx(`nat.lv.${k}.step`)}</th>
                <td data-i18n={`nat.lv.${k}.lang`}>{tx(`nat.lv.${k}.lang`)}</td>
                <td data-i18n={`nat.lv.${k}.civic`}>{tx(`nat.lv.${k}.civic`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="format-note" data-i18n="nat.lv.note">{tx("nat.lv.note")}</p>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.how.title">{tx("nat.how.title")}</h2>
      <ul class="task-points">
        {how.map((n) => <li data-i18n={`nat.how.${n}`}>{tx(`nat.how.${n}`)}</li>)}
      </ul>
      <h3 data-i18n="nat.ex.title">{tx("nat.ex.title")}</h3>
      {exempt.map((n) => <p data-i18n={`nat.ex.${n}`}>{tx(`nat.ex.${n}`)}</p>)}
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.cir.title">{tx("nat.cir.title")}</h2>
      <p data-i18n="nat.cir.1">{tx("nat.cir.1")}</p>
      <p data-i18n="nat.cir.2">{tx("nat.cir.2")}</p>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.steps.title">{tx("nat.steps.title")}</h2>
      {stepNumbers.map((n) => (
        <>
          <h3 data-i18n={`nat.s${n}.title`}>{tx(`nat.s${n}.title`)}</h3>
          <p data-i18n={`nat.s${n}.text`}>{tx(`nat.s${n}.text`)}</p>
        </>
      ))}
      <p data-i18n="nat.s7.after">{tx("nat.s7.after")}</p>
      <p class="format-note" data-i18n="nat.other">{tx("nat.other")}</p>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.words.title">{tx("nat.words.title")}</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead><tr><th data-i18n="nat.words.th.fr">{tx("nat.words.th.fr")}</th><th data-i18n="nat.words.th.en">{tx("nat.words.th.en")}</th></tr></thead>
          <tbody>
            {words.map(([fr, key]) => (
              <tr>
                <th scope="row" lang="fr" translate="no">{fr}</th>
                <td data-i18n={`nat.w.${key}`}>{tx(`nat.w.${key}`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.practice.title">{tx("nat.practice.title")}</h2>
      {practice.map((p) => (
        <div class="mock-cta">
          <h3 data-i18n={`nat.p.${p.key}.title`}>{tx(`nat.p.${p.key}.title`)}</h3>
          <p data-i18n={`nat.p.${p.key}.text`}>{tx(`nat.p.${p.key}.text`)}</p>
          <a class="quiz-btn quiz-btn--primary" href={p.href} data-i18n={`nat.p.${p.key}.cta`}>{tx(`nat.p.${p.key}.cta`)}</a>
        </div>
      ))}
      <div class="mock-cta">
        <h3 data-i18n="nat.p.plan.title">{tx("nat.p.plan.title")}</h3>
        <p data-i18n="nat.p.plan.text">{tx("nat.p.plan.text")}</p>
        <a class="plan-link" href="/exam-plan" data-i18n="plan.link">{tx("plan.link")}</a>
      </div>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.sources.title">{tx("nat.sources.title")}</h2>
      <ul class="task-points">
        {sources.map((s) => (
          <li><a href={s.url} rel="noopener" data-i18n={`nat.src.${s.key}`}>{tx(`nat.src.${s.key}`)}</a></li>
        ))}
      </ul>
      <p class="format-note" data-i18n="nat.checked">{tx("nat.checked")}</p>
    </section>
  </main>
</Layout>
