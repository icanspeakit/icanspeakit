---
// One file on /knowledge as a schoolbook card: the cover on top (BookCover.astro), the real
// title and what is inside below it. A button, not a link: the card opens the sheet that
// says what is in the file, and the download happens from there. A 210 KB PDF that turns
// out to be the wrong level is a wasted download on a phone plan.
import Icon from "../Icon.astro";
import BookCover from "./BookCover.astro";

interface Props {
  file: {
    id: string; category: string; level: string; title: string; desc: string; emoji?: string;
    pages?: number | null; size: string; editions: { lang: string }[];
  };
  /** Position on the shelf, for the cover's mascot. */
  i?: number;
}
const { file: f, i = 0 } = Astro.props;
---
<button class="wi-card wi-card--book" type="button" id={f.id} data-file={f.id}>
  <BookCover file={f} i={i} />
  <b>{f.title}</b>
  {/* File titles stay German — they name a German-language PDF. The line under each says
      what is inside it, which is the part worth translating. */}
  <i data-i18n={`wissen.file.${f.id}.desc`}>{f.desc}</i>
  <span class="wi-card-foot">
    <span class="wi-meta">
      PDF{f.pages ? <span data-i18n="wissen.pagesSuffix" data-i18n-vars={JSON.stringify({ n: f.pages })}>{` · ${f.pages} Seiten`}</span> : ""} · {f.size}
      {f.editions.length > 0 && <span class="wi-meta-eds"> · +{f.editions.map((e) => e.lang.toUpperCase()).join("/")}</span>}
    </span>
    <span class="wi-dl" aria-hidden="true"><Icon name="chevron-right" size={18} /></span>
  </span>
</button>
