---
// The sign-in card on the account page: Google, or an email link (no password). One account
// for every course on icanspeak.it; progress is saved per course (src/lib/account/sync.js).
// Three views, switched by src/lib/account/page.js: out (sign in), sent (check your inbox),
// in (signed in). The same file in every course app; the page passes its own links.
import "../styles/auth.css";

interface Props {
  termsHref: string;
  privacyHref: string;
  progressHref: string;
}
const { termsHref, privacyHref, progressHref } = Astro.props;
---

<div class="da-auth-page" data-acct-card>
  <div class="da-auth-card">
    <p class="da-auth-error" role="alert" data-acct-error hidden></p>

    <div data-view="out">
      <h1 class="da-auth-title" data-i18n="auth.title">Sign in</h1>
      <p class="da-auth-lead" data-i18n="auth.lead">Sign in so your progress follows you to every device.</p>

      <button type="button" class="da-auth-btn da-auth-btn--ghost" data-acct-google>
        <span class="da-auth-spinner da-auth-spinner--dark" aria-hidden="true" hidden></span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
          <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z" />
          <path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z" />
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z" />
        </svg>
        <span data-i18n="auth.google">Sign in with Google</span>
      </button>

      <div class="da-auth-or"><span data-i18n="auth.or">or</span></div>

      <form class="da-auth-form" data-acct-form novalidate>
        <label class="da-auth-label" for="da-acct-email" data-i18n="auth.email.label">Email address</label>
        <input class="da-auth-input" id="da-acct-email" type="email" name="email" autocomplete="email" inputmode="email" required data-acct-input />
        <button type="submit" class="da-auth-btn da-auth-btn--primary" data-acct-send>
          <span class="da-auth-spinner" aria-hidden="true" hidden></span>
          <span data-i18n="auth.email.submit">Send me a link</span>
        </button>
        <p class="da-auth-fineprint" data-i18n="auth.email.hint">No password needed — you get a link to sign in.</p>
      </form>

      <p class="da-auth-legal">
        <span data-i18n="auth.legal.pre">By signing in you agree to the</span>{" "}
        <a href={termsHref} data-i18n="auth.legal.terms">Terms of Use</a>{" "}
        <span data-i18n="auth.legal.mid">and confirm you have read the</span>{" "}
        <a href={privacyHref} data-i18n="auth.legal.privacy">Privacy Policy</a><span data-i18n="auth.legal.post">.</span>
      </p>
    </div>

    <div class="da-auth-card--sent" data-view="sent" hidden>
      <h1 class="da-auth-title" data-i18n="auth.sent.title">Check your inbox</h1>
      <p class="da-auth-lead"><span data-i18n="auth.sent.lead">We sent a link to</span> <b data-acct-sent-to data-private></b></p>
      <p class="da-auth-fineprint" data-i18n="auth.sent.hint">Open it on this device and you are signed in.</p>
      <p class="da-auth-fineprint" data-i18n="auth.sent.spam">Nothing arrived? Check the spam folder — or try again.</p>
      <button type="button" class="da-auth-btn da-auth-btn--ghost" data-acct-back data-i18n="auth.sent.back">Use a different address</button>
    </div>

    <div data-view="in" hidden>
      <h1 class="da-auth-title"><span data-acct-name data-private></span></h1>
      <p class="da-auth-lead"><span data-i18n="auth.nav.signedIn">Signed in</span>: <b data-acct-email data-private></b></p>
      <a class="da-auth-btn da-auth-btn--primary" href={progressHref} data-i18n="nav.account.progress.short">Progress</a>
      <button type="button" class="da-auth-btn da-auth-btn--ghost" data-acct-signout>
        <span class="da-auth-spinner da-auth-spinner--dark" aria-hidden="true" hidden></span>
        <span data-i18n="auth.nav.signOut">Sign out</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { initAccountPage } from "../lib/account/page.js";
  import { BACKEND } from "../lib/backend.js";
  if (BACKEND.accounts) initAccountPage(document.querySelector("[data-acct-card]"));
</script>
