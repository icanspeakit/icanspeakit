    {
      "placeholder": "Form",
      "items": [
        {
          "prompt": "Je suis content que tu ___ hier soir à la réunion.",
          "hint": "venir (you came)",
          "answer": "sois venu",
          "choices": [
            "viennes",
            "sois venu",
            "es venu"
          ],
          "why": "Hier is before now, so the subjonctif passé is needed, and the indicative never follows être content que."
        },
        {
          "prompt": "Je suis content que tu ___ demain à la réunion.",
          "hint": "venir (you will come)",
          "answer": "viennes",
          "choices": [
            "sois venu",
            "viens",
            "viennes"
          ],
          "why": "Demain is later than the main verb, so use the subjonctif présent."
        },
        {
          "prompt": "Mme Lefèvre regrette que son collègue ___ l'entreprise le mois dernier.",
          "hint": "quitter (he left)",
          "answer": "ait quitté",
          "choices": [
            "ait quitté",
            "quitte",
            "quittera"
          ],
          "why": "Le mois dernier is earlier than the main verb: subjonctif passé."
        },
        {
          "prompt": "Je ne pense pas que le propriétaire ___ ma lettre hier.",
          "hint": "recevoir (he got it)",
          "answer": "ait reçu",
          "choices": [
            "reçoive",
            "recevrait",
            "ait reçu"
          ],
          "why": "Hier points to an earlier time, and je ne pense pas que takes the subjunctive."
        },
        {
          "prompt": "Bien que Léa ___ trois fois la semaine dernière, la préfecture n'a pas répondu.",
          "hint": "appeler (she called)",
          "answer": "ait appelé",
          "choices": [
            "appelle",
            "ait appelé",
            "aurait appelé"
          ],
          "why": "Bien que takes the subjunctive, and la semaine dernière makes it the passé."
        }
      ]
    },
    {
      "placeholder": "Form",
      "items": [
        {
          "prompt": "Je voulais que tu ___ à la préfecture avec moi.",
          "hint": "venir (you come along)",
          "answer": "viennes",
          "choices": [
            "viennes",
            "viendrais",
            "venais"
          ],
          "why": "After vouloir que the subjonctif présent is used, even when vouloir is in the imparfait."
        },
        {
          "prompt": "Le propriétaire exigeait que nous ___ le loyer avant le 5.",
          "hint": "payer",
          "answer": "payions",
          "choices": [
            "paierions",
            "avons payé",
            "payions"
          ],
          "why": "Exiger que takes the subjonctif présent, whatever the tense of exiger."
        },
        {
          "prompt": "Léa était contente que son collègue ___ la veille.",
          "hint": "partir (he had left)",
          "answer": "soit parti",
          "choices": [
            "parte",
            "est parti",
            "soit parti"
          ],
          "why": "La veille is earlier than the main verb: subjonctif passé with être."
        },
        {
          "prompt": "Il a fallu que Karim ___ trois fois à la mairie.",
          "hint": "retourner",
          "answer": "retourne",
          "choices": [
            "retourne",
            "retournera",
            "retournait"
          ],
          "why": "Il faut que, in any tense, takes the subjonctif présent for a later action."
        },
        {
          "prompt": "Elle a été surprise que nous ___ déjà tout préparé quand elle est arrivée.",
          "hint": "avoir (we had prepared)",
          "answer": "ayons",
          "choices": [
            "avons",
            "aurions",
            "ayons"
          ],
          "why": "Être surpris que takes the subjunctive, and the preparation came first: ayons préparé."
        }
      ]
    },
