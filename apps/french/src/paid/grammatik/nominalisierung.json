      "items": [
        {
          "prompt": "___ du directeur est prévu pour le mois de mars.",
          "hint": "partir: leaving (masculine)",
          "answer": "Le départ",
          "choices": [
            "La partie",
            "La départ",
            "Le départ"
          ],
          "why": "Partir gives le départ, a masculine noun with no suffix."
        },
        {
          "prompt": "___ du guichet a lieu à 9 h.",
          "hint": "ouvrir: opening (-ure)",
          "answer": "L'ouverture",
          "choices": [
            "L'ouverture",
            "L'ouvrage",
            "L'ouvert"
          ],
          "why": "Ouvrir gives l'ouverture; l'ouvrage means a piece of work."
        },
        {
          "prompt": "Mamadou conteste ___ de sa demande par la préfecture.",
          "hint": "refuser: refusal",
          "answer": "le refus",
          "choices": [
            "la refus",
            "le refusement",
            "le refus"
          ],
          "why": "Refuser gives le refus: masculine, no suffix."
        },
        {
          "prompt": "Oksana attend ___ de ses frais de transport.",
          "hint": "rembourser: refund (-ment)",
          "answer": "le remboursement",
          "choices": [
            "la remboursement",
            "le remboursement",
            "la remboursure"
          ],
          "why": "Nouns in -ment are masculine: le remboursement."
        },
        {
          "prompt": "___ des locaux a lieu chaque vendredi.",
