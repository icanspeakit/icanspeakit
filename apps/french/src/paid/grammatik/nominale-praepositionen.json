        {
          "prompt": "Votre demande est recevable ; ___, il manque encore un justificatif.",
          "hint": "contrast: however",
          "answer": "néanmoins",
          "choices": [
            "par conséquent",
            "néanmoins",
            "en outre"
          ],
          "why": "The request is acceptable but something is missing: that is a contrast."
        },
        {
          "prompt": "Le dossier est incomplet ; ___, nous ne pouvons pas le traiter.",
          "hint": "result: therefore",
          "answer": "par conséquent",
          "choices": [
            "toutefois",
            "en revanche",
            "par conséquent"
          ],
          "why": "Not being able to process the file is the result of the incomplete file."
        },
        {
          "prompt": "Le loyer reste stable ; ___, les charges ont fortement augmenté.",
          "hint": "on the other hand",
          "answer": "en revanche",
          "choices": [
            "dès lors",
            "en revanche",
            "de surcroît"
          ],
          "why": "Two opposite developments, rent and charges, call for en revanche."
        },
        {
          "prompt": "Le salarié n'a pas fourni de certificat ; ___, son absence est considérée comme injustifiée.",
          "hint": "from then on, as a result",
          "answer": "dès lors",
          "choices": [
            "dès lors",
            "en revanche",
            "néanmoins"
          ],
          "why": "The unjustified absence follows from the missing certificate."
        },
        {
          "prompt": "Le logement est bien situé. ___, il est lumineux et récemment rénové.",
          "hint": "what is more (two answers possible)",
          "answer": [
            "En outre",
            "De surcroît"
          ],
          "choices": [
            "Toutefois",
            "En outre",
            "Dès lors"
          ],
          "why": "A further advantage is added, so use an adding connector."
        },
        {
          "prompt": "Karim pensait avoir tout envoyé. ___, le dossier était incomplet.",
          "hint": "logical “now”",
          "answer": "Or",
          "choices": [
            "Ou",
            "Or",
            "Dès"
          ],
          "why": "Or introduces the fact that changes the picture; ou means “or”."
        }
      ]
    },
