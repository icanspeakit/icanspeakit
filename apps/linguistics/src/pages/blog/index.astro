---
import { u } from '../../lib/url';
import TileHero from '../../components/TileHero.astro';
import { look, ccStyle, motifStyle } from '../../lib/looks';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="Blog — icanspeak.it" description="Deep dives into word origins, false friends, and the strange journeys of everyday language.">
  <TileHero eyebrow="The blog" title="Stories words don't tell you" mark="out loud" lede="Short, well-sourced deep dives into where words actually came from." mascot="bruno" bubble="True story!" />

  <section class="blog-list">
    <div class="container">
      <div class="blog-list__grid">
        {posts.map((post, i) => (
          <a class="isk-cc isk-rise post-card" style={ccStyle(look(i), i)} href={u(`/blog/${post.id}/`)}>
            <span class={`isk-tile ${look(i).motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(look(i))}></span>
            {post.data.word && <span class="tag">{post.data.word}</span>}
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <span class="isk-cc__meta">{dateFmt.format(post.data.pubDate)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-list__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 720px) {
    .blog-list__grid { grid-template-columns: 1fr; }
  }

  .post-card .tag + h2 { margin-block-start: 1.6rem; }
</style>
