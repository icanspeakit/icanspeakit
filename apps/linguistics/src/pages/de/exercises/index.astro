---
import { u } from '../../../lib/url';
import TileHero from '../../../components/TileHero.astro';
import Layout from '../../../layouts/Layout.astro';
import ExerciseGrid from '../../../components/ExerciseGrid.astro';
import { topics } from '../../../data/exercises/topics';
---

<Layout title="Übungen — icanspeak.it" description="Audiogestützte Übungen für die Mechanik einer klaren englischen Aussprache." altHref={u("/exercises/")}>
  <TileHero eyebrow="Üben" title="" mark="Übungen" lede="Hör dir das Modell an, probier es selbst und vergleich beides direkt — Übungen zum Selbst-Bewerten, die auf die Mechanik der Aussprache zielen, nicht auf eine Punktzahl." mascot="quaki" bubble="Hör mal!" />

  <section class="container">

    <ExerciseGrid topics={topics} />
  </section>
</Layout>
