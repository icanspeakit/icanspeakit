---
import { u } from '../../../lib/url';
import TileHero from '../../../components/TileHero.astro';
import Layout from '../../../layouts/Layout.astro';
import ExerciseGrid from '../../../components/ExerciseGrid.astro';
import { studyFormats } from '../../../data/study/formats';
---

<Layout
  title="Study — icanspeak.it"
  description="Fünf echte, funktionierende Formate zum Lesen, Wortschatz, Dialog, Hören und Schreiben."
  altHref={u("/study/")}
>
  <TileHero eyebrow="Study" title="" mark="Study" lede="Nebenan trainieren die Exercises die Sprechmechanik — hier geht es um alles drumherum: Lesen, Wortschatz, Dialog, Hörverstehen und Schreiben. Gespeicherte Wörter aus Story Stream und Zielphrasen aus Dialogue Lab fließen direkt ins Daily Deck — die fünf Formate bauen aufeinander auf, statt nur nebeneinander zu stehen." mascot="regi" bubble="Lies weiter!" />

  <section class="container">

    <ExerciseGrid topics={studyFormats} />
  </section>
</Layout>
