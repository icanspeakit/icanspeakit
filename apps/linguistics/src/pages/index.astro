---
import { u } from '../lib/url';
import TileHero from '../components/TileHero.astro';
import { look, ccStyle, motifStyle } from '../lib/looks';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ExerciseGrid from '../components/ExerciseGrid.astro';
import DashboardShell from '../components/dashboard/DashboardShell.astro';
import { topics } from '../data/exercises/topics';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="icanspeak.it — Word origins & speaking practice" altHref={u("/de/")}>
  <TileHero eyebrow="A language hub for the curious" title="Every word has a story. Every sound has a" mark="mechanism." lede="icanspeak.it is a small, ad-free corner of the internet about language — where words came from, and how to actually say them. Dig into etymology, or train the sounds, stress, and rhythm of English with audio-driven exercises that explain the mechanics instead of just scoring your accent." mascot="regi" bubble="Let's dig in!">
    <a href={u("/exercises/")} class="button button--primary">Start practicing</a>
    <a href={u("/blog/")} class="button button--ghost">Read the blog</a>
  </TileHero>

  <section class="progress-teaser">
    <div class="container progress-teaser__intro">
      <p class="eyebrow">New</p>
      <h2>Watch your practice add up</h2>
      <p class="text-muted">
        One dashboard for every format: practice the drills, check real accuracy and session history, or
        see all seven at a glance. Try it live below, or open it full-screen.
      </p>
      <a href={u("/dashboard/")} class="button button--primary">Open full-screen →</a>
    </div>
    <div class="container">
      <DashboardShell activeLens="progress" />
    </div>
  </section>

  <section class="practice">
    <div class="container">
      <div class="section-head practice__head">
        <div>
          <p class="eyebrow">Practice</p>
          <h2>Sound mechanics, not accent scores</h2>
        </div>
        <span class="practice__count">{topics.length} formats</span>
      </div>
      <ExerciseGrid topics={topics} offset={2} />
    </div>
  </section>

  <section class="why">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why bother with etymology?</p>
        <h2>Because language is the longest-running story we've ever told</h2>
      </div>
      <div class="why__grid">
        <a class="isk-cc isk-rise why-card" style={ccStyle(look(0, 3), 0)} href={u("/blog/salary-a-tiny-history-lesson/")}>
          <span class={`isk-tile ${look(0, 3).motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(look(0, 3))}></span>
          <h3>Every word is a tiny history lesson</h3>
          <p class="text-muted">
            "Salary" comes from the Latin for salt, once part of a Roman soldier's pay. Say the word and
            you're quoting a two-thousand-year-old paycheck.
          </p>
          <span class="isk-cc__go">Read the full story →</span>
        </a>
        <a class="isk-cc isk-rise why-card" style={ccStyle(look(1, 3), 1)} href={u("/blog/how-languages-borrow-from-each-other/")}>
          <span class={`isk-tile ${look(1, 3).motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(look(1, 3))}></span>
          <h3>Languages secretly borrow from each other</h3>
          <p class="text-muted">
            English alone has pulled words from more than 350 languages. "Ketchup" traveled from a Hokkien
            fish sauce through Malay trade routes before it ever met a tomato.
          </p>
          <span class="isk-cc__go">Read the full story →</span>
        </a>
        <a class="isk-cc isk-rise why-card" style={ccStyle(look(2, 3), 2)} href={u("/blog/how-word-meanings-drift/")}>
          <span class={`isk-tile ${look(2, 3).motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(look(2, 3))}></span>
          <h3>Meanings drift — sometimes on purpose</h3>
          <p class="text-muted">
            "Nice" once meant "foolish" in Latin. Give a word three centuries and enough gossip, and it can
            end up meaning almost the opposite of where it started.
          </p>
          <span class="isk-cc__go">Read the full story →</span>
        </a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">From the blog</p>
          <h2>Recent deep dives</h2>
        </div>
        <div class="latest__grid">
          {posts.map((post, i) => (
            <a class="isk-cc isk-rise post-card" style={ccStyle(look(i, 5), i)} href={u(`/blog/${post.id}/`)}>
              <span class={`isk-tile ${look(i, 5).motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(look(i, 5))}></span>
              {post.data.word && <span class="tag">{post.data.word}</span>}
              <h3>{post.data.title}</h3>
              <p class="text-muted">{post.data.description}</p>
              <span class="isk-cc__meta">{dateFmt.format(post.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="container cta__inner">
      <p class="eyebrow">Keep going</p>
      <h2>Pick a word, pull the thread</h2>
      <p class="lede">
        The word-card wall has bite-sized origin stories you can flip through in a coffee break —
        false friends, loanwords, and words invented on purpose.
      </p>
      <a href={u("/words/")} class="button button--primary">Open the word cards</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block-start: clamp(3.5rem, 7vw, 6rem); }
  .hero__inner { max-width: 46rem; }
  .hero h1 { margin-block: 0.75rem 1.25rem; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-block-start: 1.75rem; }

  .hero__lede--short { display: none; }

  @media (max-width: 640px) {
    /* The full three-sentence lede reads as a wall of text once the
       headline alone fills most of a phone screen — swap in a one-line
       version and give the section extra side breathing room to match. */
    .hero__inner {
      padding-inline: 1.75rem;
    }

    .hero__lede--full { display: none; }
    .hero__lede--short { display: block; }
  }

  .progress-teaser__intro {
    max-width: 42rem;
    margin-block-end: clamp(1.5rem, 3vw, 2rem);
  }

  .progress-teaser__intro h2 {
    margin-block: 0.6rem 0.75rem;
  }

  .progress-teaser__intro .button {
    margin-block-start: 1.5rem;
  }

  .practice { padding-block-start: 0; }

  .practice__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .practice__count {
    font-size: 0.85rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .why__grid,
  .latest__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }





  @media (max-width: 860px) {
    .why__grid, .latest__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .why__grid, .latest__grid { grid-template-columns: 1fr; }
  }


  .post-card .tag + h3 { margin-block-start: 1.6rem; }

  .cta {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
  }

  .cta__inner { max-width: 40rem; text-align: left; }
  .cta__inner h2 { margin-block: 0.5rem 0.9rem; }
  .cta__inner .button { margin-block-start: 1.5rem; }
</style>
