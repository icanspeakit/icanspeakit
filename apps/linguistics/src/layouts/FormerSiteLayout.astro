---
import ConsentBanner from "../components/ConsentBanner.astro";
import { u } from '../lib/url';
import Header from '../components/former-site/Header.astro';
import Footer from '../components/former-site/Footer.astro';
import '../styles/former-site.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sprachausbildung für Fachkräfte im Recruiting-Prozess – organisiert, effizient und mit messbarer Qualität.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <!-- PostHog, and the consent banner that decides cookieless or replay (src/lib/analytics.js).
         No privacy page of its own: the English course's covers all of icanspeak.it. -->
    <ConsentBanner app="linguistics" privacyHref="/english/privacy" />
  </body>
</html>
