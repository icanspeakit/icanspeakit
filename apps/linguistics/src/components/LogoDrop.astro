---
// The wordmark, falling into place letter by letter (same feel as the tile ribbon).
// The logo file is never split or redrawn: each letter is the full SVG cropped with clip-path to
// that letter's column, so at rest the slices add up to the original image. The plain <img>
// underneath keeps the size, the alt text and the no-animation fallback.
// The same file lives in apps/hub and apps/linguistics. Keep the copies identical.
interface Props { src: string; alt: string; width: number; height: number; class?: string }
const { src, alt, width, height, class: cls } = Astro.props;

// Column edges in % of the wordmark width, measured from icanspeak-wordmark.svg (i c a n s p e a k !).
// Cuts sit in the gaps between the black letters; the colour ghosts of the split go with their letter.
const cuts = [0, 5.6, 16.1, 27.3, 39.8, 49.2, 61.35, 71.6, 82.75, 94.9, 100];
const slices = cuts.slice(0, -1).map((l, i) => ({ l, r: 100 - cuts[i + 1], i, tilt: i % 2 ? 9 : -9 }));
---

<span class:list={['isk-drop', cls]}>
  <img class="isk-drop__base" src={src} alt={alt} width={width} height={height} />
  {slices.map((s) => (
    <span class="isk-drop__l" aria-hidden="true" style={`--l:${s.l}%;--r:${s.r}%;--i:${s.i};--tilt:${s.tilt}deg`}>
      <img src={src} alt="" width={width} height={height} />
    </span>
  ))}
</span>

<style>
  .isk-drop { position: relative; display: inline-block; line-height: 0; }
  .isk-drop__l { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    .isk-drop__base { opacity: 0; animation: isk-drop-base 0s linear 1.4s forwards; }
    .isk-drop__l {
      display: block; position: absolute; inset: 0; pointer-events: none;
      clip-path: inset(-60% var(--r) -60% var(--l));
      /* Fall in one after another; once settled, the plain image takes over and the slices step aside. */
      animation: isk-drop-fall 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.1s + var(--i) * 55ms) both,
        isk-drop-hide 0s linear 1.4s forwards;
    }
    .isk-drop .isk-drop__l img { display: block; width: 100%; height: 100%; }
  }

  @keyframes isk-drop-fall {
    0% { opacity: 0; transform: translateY(-160%) rotate(var(--tilt)); }
    35% { opacity: 1; }
    100% { opacity: 1; transform: none; }
  }
  @keyframes isk-drop-base { to { opacity: 1; } }
  @keyframes isk-drop-hide { to { visibility: hidden; } }
</style>
