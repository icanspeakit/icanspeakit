---
// Exercise and study formats as colour cards (styles/brand-ui.css): brand colour, corner motif,
// category pill and the format's call to action. Used on the home, /exercises/ and /study/ pages.
import type { Topic } from '../data/exercises/topics';
import { hrefFor, statusCta } from '../data/exercises/topics';
import { look, ccStyle, motifStyle } from '../lib/looks';
import '../styles/tiles.css';

interface Props {
  topics: Topic[];
  /** Start the colour cycle further along, so neighbouring grids don't repeat. */
  offset?: number;
}

const { topics, offset = 0 } = Astro.props;
const locale = (Astro.currentLocale ?? 'en') as 'en' | 'de';
---

<div class="isk-cc-grid exercise-grid">
  {topics.map((topic, i) => {
    const l = topic.featured ? { ...look(i, offset), bg: 'var(--isk-navy)', a: 'var(--isk-yellow)' } : look(i, offset);
    return (
      <a
        href={hrefFor(topic.href, locale)}
        class:list={['isk-cc', 'isk-rise', 'exercise-card', { 'isk-cc--dark': topic.featured, 'exercise-card--featured': topic.featured }]}
        style={ccStyle(l, i)}
        data-status={topic.status}
      >
        <span class={`isk-tile ${l.motif} isk-cc__motif`} aria-hidden="true" style={motifStyle(l)}></span>
        <span class="isk-cc__pill">{topic.category[locale]}</span>
        <h3>{topic.title[locale]}</h3>
        <p>{topic.description[locale]}</p>
        <span class="isk-cc__go">{statusCta(topic.status, locale)} <span aria-hidden="true">→</span></span>
      </a>
    );
  })}
</div>

<style>
  .exercise-card h3 { margin-block-start: 2.2rem; }
</style>
