---
import { u } from '../lib/url';
import LogoDrop from './LogoDrop.astro';
// The site root is the hub (another app); in dev it runs on its own port (apps/hub, 4320).
const siteHome = import.meta.env.DEV ? 'http://localhost:4320/' : '/';
interface Props {
  altHref?: string;
}

const { altHref } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

const copy = {
  en: {
    tagline: 'Word origins & speaking practice',
  },
  de: {
    tagline: 'Wortursprünge & Sprechtraining',
  },
} as const;

const t = copy[locale as 'en' | 'de'] ?? copy.en;
const otherLocale = locale === 'de' ? 'en' : 'de';
const otherHref = altHref ?? (locale === 'de' ? u('/') : u('/de/'));
---

<header class="site-header">
  <div class="site-header__inner container">
    <span class="isk-lockup">
      <a href={siteHome} class="isk-lockup__home" aria-label={locale === 'de' ? 'icanspeak.it, alle Sprachen' : 'icanspeak.it, all languages'}><LogoDrop src={u("/logos/icanspeak-wordmark.svg")} alt="" width={164} height={34} /></a>
      <a href={locale === 'de' ? u('/de/') : u('/')} class="isk-pill" aria-label={locale === 'de' ? 'icanspeak Linguistik, Start' : 'icanspeak linguistics, home'}>{locale === 'de' ? 'linguistik' : 'linguistics'}</a>
    </span>
    <span class="brand__tagline">{t.tagline}</span>

    <a href={otherHref} class="lang-switch" hreflang={otherLocale} lang={otherLocale} aria-label={otherLocale === 'de' ? 'Deutsch' : 'English'} title={otherLocale === 'de' ? 'Deutsch' : 'English'}>
      {otherLocale.toUpperCase()}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--isk-white);
    border-bottom: 2px solid var(--isk-navy);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-block: 0.9rem;
  }

  .isk-lockup { display: inline-flex; align-items: center; gap: 12px; }
  .isk-lockup a { display: inline-flex; }
  .isk-lockup :global(.isk-drop__base) { display: block; height: 34px; width: auto; }
  .isk-pill {
    align-items: center;
    background: var(--isk-yellow);
    color: var(--isk-navy);
    font-family: var(--isk-font-display);
    font-weight: 900;
    font-size: 16px;
    line-height: 1;
    padding: 0.3em 0.75em;
    border-radius: var(--isk-radius-pill);
    white-space: nowrap;
  }
  a.isk-pill:hover { filter: brightness(0.95); }

  .brand__tagline {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-inline-start: auto;
    border-radius: 999px;
    border: 2px solid var(--isk-navy);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--isk-navy);
  }

  .lang-switch:hover { background: var(--isk-yellow-soft); }

  @media (max-width: 720px) {
    .brand__tagline { display: none; }
  }

  /* 44px touch target on touch-sized viewports. */
  @media (max-width: 640px) {
    .isk-lockup :global(.isk-drop__base) { height: 28px; }
    .isk-pill { font-size: 14px; }
    .lang-switch { width: 2.75rem; height: 2.75rem; }
  }
</style>
