---
// The consent banner for session replay (2026-11-15). What each answer switches on is in
// src/lib/analytics.js; this file decides when to ask and starts PostHog on every page.
// The same file lives in every app (hub and linguistics included). Keep the copies identical.
//
// It carries its own words in the six interface languages and follows <html lang>, so it
// also works on the hub and linguistics sites, which have no i18n files.
//
// Buttons of equal weight on purpose: German regulators (and the CJEU in Planet49) treat a
// bright "Accept" next to a greyed-out "Decline" as a nudge, which voids the consent.
//
// When it appears (as on deutschacademy, where asking on arrival cost LCP and annoyed):
//   at once   on the second page of a visit (same-site referrer) or a campaign landing
//             (utm_*, gclid, fbclid, msclkid): unhidden by the inline script before paint;
//   "time"    40 s after the first scroll/tap/key on a page without that.
// Unanswered, PostHog stays cookieless, so nobody is lost from the counts while it waits.
interface Props {
  /** Which part of icanspeak.it sends the events (analytics.js `app`). */
  app: string;
  /** The privacy page that explains it, with the base path. */
  privacyHref: string;
}
const { app, privacyHref } = Astro.props;

const TEXT = {
  en: {
    title: "Help us make the exercises better?",
    body: "With your consent, PostHog (EU) records how you use the site, including a replay of clicks and scrolling (never what you type). That shows us which exercises are too hard and where the site gets stuck. Without it we only count page views, without cookies.",
    more: "Details", deny: "Decline", accept: "Accept",
  },
  de: {
    title: "Hilfst du uns, die Übungen besser zu machen?",
    body: "Mit deiner Zustimmung zeichnet PostHog (EU) auf, wie du die Seite benutzt, auch als Wiedergabe von Klicks und Scrollen (nie, was du eintippst). So sehen wir, welche Übungen zu schwer sind und wo die Seite hakt. Ohne Zustimmung zählen wir nur Seitenaufrufe, ohne Cookies.",
    more: "Details", deny: "Ablehnen", accept: "Akzeptieren",
  },
  fr: {
    title: "Tu nous aides à améliorer les exercices ?",
    body: "Avec ton accord, PostHog (UE) enregistre ta façon d’utiliser le site, y compris une rediffusion des clics et du défilement (jamais ce que tu tapes). Nous voyons ainsi quels exercices sont trop difficiles et où le site bloque. Sans accord, nous comptons seulement les pages vues, sans cookies.",
    more: "Détails", deny: "Refuser", accept: "Accepter",
  },
  es: {
    title: "¿Nos ayudas a mejorar los ejercicios?",
    body: "Con tu permiso, PostHog (UE) registra cómo usas el sitio, también como reproducción de clics y desplazamiento (nunca lo que escribes). Así vemos qué ejercicios son demasiado difíciles y dónde falla el sitio. Sin permiso solo contamos páginas vistas, sin cookies.",
    more: "Detalles", deny: "Rechazar", accept: "Aceptar",
  },
  it: {
    title: "Ci aiuti a migliorare gli esercizi?",
    body: "Con il tuo consenso, PostHog (UE) registra come usi il sito, anche come riproduzione di clic e scorrimento (mai quello che scrivi). Così vediamo quali esercizi sono troppo difficili e dove il sito si blocca. Senza consenso contiamo solo le pagine viste, senza cookie.",
    more: "Dettagli", deny: "Rifiuta", accept: "Accetta",
  },
  pt: {
    title: "Ajudas-nos a melhorar os exercícios?",
    body: "Com o teu consentimento, a PostHog (UE) regista como usas o site, incluindo uma reprodução de cliques e deslocamento (nunca o que escreves). Assim vemos que exercícios são difíceis demais e onde o site falha. Sem consentimento contamos só as páginas vistas, sem cookies.",
    more: "Detalhes", deny: "Recusar", accept: "Aceitar",
  },
};
const en = TEXT.en;
---
<div class="consent" role="dialog" aria-live="polite" aria-labelledby="consent-title" hidden data-consent data-app={app}>
  <p class="consent-text">
    <strong id="consent-title" data-ct="title">{en.title}</strong>
    <span data-ct="body">{en.body}</span>
    <a href={privacyHref} data-ct="more">{en.more}</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="consent-btn" data-consent-choice="denied" data-ct="deny">{en.deny}</button>
    <button type="button" class="consent-btn" data-consent-choice="granted" data-ct="accept">{en.accept}</button>
  </div>
  <script type="application/json" data-consent-text set:html={JSON.stringify(TEXT)}></script>
</div>

<script is:inline>
  // The "at once" triggers, before first paint (waiting for the bundled module made the
  // banner the LCP element on deutschacademy). Mirrors blocked() and getConsent() in
  // src/lib/analytics.js; keep them in sync.
  (function () {
    try {
      var el = document.currentScript.previousElementSibling;
      var h = location.hostname;
      if (/^(localhost|127\.0\.0\.1|\[::1\]|0\.0\.0\.0)$/.test(h) ||
          /^(10|192\.168|172\.(1[6-9]|2\d|3[01]))\./.test(h) || h.endsWith(".local")) return;
      if (new URLSearchParams(location.search).get("intern") === "1") return;
      if (localStorage.getItem("da_internal") === "1") return;
      if (window.self !== window.top) return;
      var c = localStorage.getItem("da_consent");
      if (c === "granted" || c === "denied") return;
      var why = "";
      if (/(^|[?&])(utm_[a-z]+|gclid|fbclid|msclkid)=/.test(location.search)) why = "campaign";
      if (!why && document.referrer) {
        try {
          var r = new URL(document.referrer);
          if (r.host === location.host && r.pathname !== location.pathname) why = "page2";
        } catch (e) {}
      }
      if (!why) return;
      el.dataset.trigger = why;
      el.hidden = false;
    } catch (e) {}
  })();
</script>

<script>
  import { initAnalytics, setConsent, getConsent, onConsentChange } from "../lib/analytics.js";

  const ZEIT_MS = 40_000;
  const banner = document.querySelector<HTMLElement>("[data-consent]");

  if (banner) {
    const text = JSON.parse(banner.querySelector("[data-consent-text]")?.textContent || "{}");
    const paint = () => {
      const lang = (document.documentElement.lang || "en").slice(0, 2).toLowerCase();
      const t = text[lang] ?? text.en;
      banner.querySelectorAll<HTMLElement>("[data-ct]").forEach((el) => {
        const v = t?.[el.dataset.ct ?? ""];
        if (v) el.textContent = v;
      });
    };
    paint();
    // The interface language can change on the page (the language menu sets <html lang>).
    new MutationObserver(paint).observe(document.documentElement, { attributes: true, attributeFilter: ["lang"] });

    const show = (why: string) => {
      if (!banner.hidden || getConsent() !== null) return;
      banner.dataset.trigger = why;
      banner.hidden = false;
    };

    const unanswered = initAnalytics(banner.dataset.app);
    if (!unanswered) banner.hidden = true;
    else if (!banner.dataset.trigger) {
      const types = ["scroll", "pointerdown", "keydown"];
      const first = () => {
        types.forEach((t) => removeEventListener(t, first));
        setTimeout(() => show("time"), ZEIT_MS);
      };
      types.forEach((t) => addEventListener(t, first, { passive: true }));
    }

    banner.querySelectorAll<HTMLButtonElement>("[data-consent-choice]").forEach((btn) =>
      btn.addEventListener("click", () => {
        setConsent(btn.dataset.consentChoice === "granted" ? "granted" : "denied", { trigger: banner.dataset.trigger });
      })
    );
    // Answered: hide. Withdrawn on the privacy page: ask again right away.
    onConsentChange((value) => {
      if (value !== null) banner.hidden = true;
      else show("withdrawn");
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    inset-inline: 16px;
    bottom: 16px;
    z-index: 1000;
    max-width: 560px;
    margin-inline: auto;
    padding: 16px 18px;
    display: grid;
    gap: 12px;
    background: var(--surface-card, #fff);
    color: var(--ink, #1a2230);
    border: 1px solid var(--border-strong, #cbd2db);
    border-radius: 14px;
    box-shadow: 0 10px 30px rgba(15, 20, 28, 0.18);
    font-family: var(--font-body, inherit);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .consent[hidden] { display: none; }
  .consent-text { margin: 0; }
  .consent-text strong { display: block; margin-bottom: 4px; font-size: 0.95rem; }
  .consent-text a { color: var(--brand-blue-dark, #1e3a8a); margin-inline-start: 4px; }
  .consent-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; }
  .consent-btn {
    flex: 1 1 140px;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 10px;
    border: 1px solid var(--brand-blue, #2541b2);
    background: var(--brand-blue, #2541b2);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .consent-btn:hover { background: var(--brand-blue-dark, #1e3a8a); }
  .consent-btn:focus-visible { outline: 3px solid var(--accent, #f5c518); outline-offset: 2px; }
  /* Phone: the same words in less room, so it does not cover the first question. */
  @media (max-width: 520px) {
    .consent { inset-inline: 8px; bottom: 8px; padding: 12px 14px; gap: 10px; font-size: 0.8125rem; line-height: 1.4; }
    .consent-text strong { font-size: 0.875rem; margin-bottom: 2px; }
    .consent-btn { padding: 8px 12px; }
  }
</style>
