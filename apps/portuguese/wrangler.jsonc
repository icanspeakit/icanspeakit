{
  // icanspeak Portuguese — https://icanspeak.it/portuguese/*
  // Assets only (no Worker code): the static build, copied under portuguese/ by
  // `pnpm cf:prepare` (scripts/nest-dist.mjs), because the route keeps the /portuguese prefix.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "icanspeak-portuguese",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cf-dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "icanspeak.it/portuguese", "zone_name": "icanspeak.it" },
    { "pattern": "icanspeak.it/portuguese/*", "zone_name": "icanspeak.it" }
  ]
}
