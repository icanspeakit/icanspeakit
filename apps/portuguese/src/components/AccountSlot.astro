---
// The account control's slot in the nav. Rendered signed out ("Sign in" -> /conta); for a
// stored session src/lib/account/nav.js swaps in the learner's first name and starts the
// progress sync. One account for every course on icanspeak.it.
//
// Same markup classes as the old Supabase island (auth/AuthStatus.jsx in englishacademy),
// so src/styles/auth.css styles it unchanged.
import "../styles/auth.css";

interface Props {
  /** "nav": the pill in the desktop cluster; "drawer": the card in the mobile panel. */
  variant?: "nav" | "drawer";
}
const { variant = "nav" } = Astro.props;
---
{variant === "drawer" ? (
  <div class="da-acct-card" data-acct-slot>
    <a class="da-acct-card-main" href="/conta">
      <span class="lp-drawer-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 21a8 8 0 0 1 16 0" />
        </svg>
      </span>
      <span class="lp-drawer-txt">
        <b data-acct-label data-i18n="auth.nav.signIn">Sign in</b>
        <i data-acct-sub data-i18n="auth.nav.signIn.sub">Progress on every device</i>
      </span>
    </a>
  </div>
) : (
  <a class="da-auth-signin" href="/conta" data-acct-slot>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8" r="4" />
      <path d="M4 21a8 8 0 0 1 16 0" />
    </svg>
    <span data-acct-label data-i18n="auth.nav.signIn">Sign in</span>
  </a>
)}

<script>
  import { initAccountNav } from "../lib/account/nav.js";
  initAccountNav().catch((e) => console.warn("[account]", e?.message || e));
</script>
