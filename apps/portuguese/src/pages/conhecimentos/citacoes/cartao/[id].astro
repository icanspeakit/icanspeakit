---
// /conhecimentos/citacoes/cartao/<id> — one quote card as a bare HTML fragment (no layout), fetched by
// the hub /conhecimentos/citacoes for today's quote and for ‹ ›. Not for people or search engines:
// the full page for a quote is /conhecimentos/citacoes/<id>.
import ZitatCard from "../../../../components/zitate/ZitatCard.astro";
import { quotes } from "../../../../lib/zitateData.js";

export const partial = true;
export function getStaticPaths() {
  return quotes.map((q: any) => ({ params: { id: q.id }, props: { q } }));
}
const { q } = Astro.props;
---
<ZitatCard q={q} />
<p class="zt-more"><a href={`/conhecimentos/citacoes/${q.id}`} data-i18n="zitate.card.ownPage">This quote’s own page</a></p>
