---
import Layout from "../layouts/Layout.astro";
import ExamShell from "../components/ExamShell.astro";
import ExamPractice from "../components/ExamPractice.astro";
import ExamFormat from "../components/ExamFormat.astro";
import SatzListe from "../components/SatzListe.astro";
import goetheFormate from "../data/pruefungen/goethe-formate.json";
---
<Layout
  title="CAPLE exams A1–C2 (CIPLE, DEPLE, DIPLE …): format and practice – icanspeak Portuguese"
  description="The CAPLE certificates of Portuguese as a foreign language, from ACESSO A1 and CIPLE A2 to DUPLE C2: who they are for, how each exam works, and free practice."
>
  <ExamShell
    bild="goethe"
    header="CAPLE"
    title="CAPLE exams"
    lead="The Portuguese as a foreign language certificates of CAPLE, at the University of Lisbon: one exam per level, used for residence, nationality, work and study."
    leadKey="goethe.lead"
    badges={["A1–C2"]}
    practiceHeading="Practise for the CAPLE exams"
    practiceHeadingKey="goethe.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="goethe.who.title">Who are the CAPLE exams for?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="goethe.who.badge.level">Levels A1–C2</span>
          <span class="exam-meta-badge" data-i18n="goethe.who.badge.perLevel">One certificate per level</span>
        </div>
        <p data-i18n="goethe.who.text">
          CAPLE has a separate exam for each level, from ACESSO A1 to DUPLE C2.
        </p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Skills tested</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Reading</h4><p data-i18n="skill.lesen.desc">Reading comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Listening</h4><p data-i18n="skill.hoeren.desc">Listening comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Writing</h4><p data-i18n="skill.schreiben.desc">Written expression</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Speaking</h4><p data-i18n="skill.sprechen.oralDesc">Spoken expression</p></div>
        </div>
      </section>

      {goetheFormate.formate.map((f) => <ExamFormat format={f} />)}

      <section class="exam-section" id="modellsaetze">
        <h2 data-i18n="goethe.modell.title">Official sample tests</h2>
        <p class="format-note" data-i18n="goethe.moreLevels.text">
          CAPLE publishes information and sample material for its exams.
        </p>
        <p class="format-note"><a href="https://caple.letras.ulisboa.pt/" target="_blank" rel="noopener noreferrer" data-i18n="goethe.modell.link">The CAPLE website, University of Lisbon (in Portuguese)</a></p>
      </section>
    </Fragment>

    <SatzListe exam="goethe" />

    <div class="mock-cta">
      <p class="joint-exam" aria-label="Our own A1 test, not an official exam" data-i18n-attr="aria-label:exam.joint.label">
        <span>ACESSO A1</span><b aria-hidden="true">·</b><span data-i18n="exam.joint.own">our own practice test</span>
      </p>
      <h2 data-i18n="goethe.a1.title">A1: our own practice test</h2>
      <p data-i18n="goethe.a1.text">
        Our A1 practice test follows the general shape of the ACESSO A1.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/caple/acesso-a1" data-i18n="exam.startSet">Start the practice set</a>
      <a class="quiz-btn" href="/caple/level-check" data-i18n="goethe.a1.telcLink">To the level check</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="delesiele.title">CIPLE, DEPLE or Celpe-Bras?</h2>
      <p data-i18n="delesiele.entry.blurb">Which exam fits your purpose: residence and nationality in Portugal, work, study, or Brazil.</p>
      <a class="quiz-btn" href="/exams/ciple-deple-celpe-bras" data-i18n="delesiele.entry.cta">Compare the exams</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="goethe.c2.title">C2: the format only</h2>
      <p data-i18n="goethe.c2.text">The DUPLE C2 is above the range of this course (A1 to C1), so there is no practice set for it here. Its format is on this page, with the other levels.</p>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="goethe.languageUse.title">Language use (uso da língua)</h2>
      <p data-i18n="goethe.languageUse.text">From B2, gap texts train grammar and vocabulary in context. Practise them on their own with two sets at B2 and C1.</p>
      <a class="quiz-btn" href="/caple/language-use" data-i18n="goethe.languageUse.cta">To the language-use trainer</a>
    </div>

    <ExamPractice
      heading="Train the basics"
      headingKey="exam.practice.heading"
      intro="These tools help at every level and for every exam."
      introKey="goethe.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>

