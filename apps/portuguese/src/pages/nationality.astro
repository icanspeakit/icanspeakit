---
// The path to Portuguese residence and nationality (content-plan §2, §5.11). General orientation,
// never legal advice. Written from general knowledge of the rules in force up to 2025, NOT checked
// against the official texts: every figure and rule is listed as "to verify" in
// reports/nationality-path.md. All text lives in public/i18n/en.json, read here so that one file
// holds each sentence.
import ExamDisclaimer from "../components/ExamDisclaimer.astro";
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import "../styles/pruefungen.css";
import en from "../../public/i18n/en.json";

const tx = (key: string) => (en as Record<string, string>)[key];

const perm = ["1", "2", "3", "4"];
const routes = ["gen", "spouse", "desc", "born", "seph"];
const tests = ["most", "ciple", "cplp", "school", "test", "minor", "disp"];
const shortVersion = ["1", "2", "3", "4"];
const steps = ["1", "2", "3", "4", "5", "6", "7"];
const changes = ["1", "2", "3", "4"];
const words = [
  ["a AIMA", "aima"],
  ["a autorização de residência", "autorizacao"],
  ["o NIF", "nif"],
  ["o NISS", "niss"],
  ["o atestado de residência", "atestado"],
  ["a certidão de nascimento", "certidao"],
  ["o certificado de registo criminal", "registo"],
  ["a apostila", "apostila"],
  ["a Conservatória", "conservatoria"],
  ["a naturalização", "naturalizacao"],
  ["o Cartão de Cidadão", "cartao"],
];
const practice = [
  { key: "civics", href: "/civics" },
  { key: "mock", href: "/nationality/ciple-a2/practice-set" },
  { key: "set", href: "/dele/a2" },
];
const sources = [
  { key: "aima", url: "https://aima.gov.pt" },
  { key: "irn", url: "https://irn.justica.gov.pt" },
  { key: "eportugal", url: "https://eportugal.gov.pt" },
  { key: "dr", url: "https://diariodarepublica.pt" },
  { key: "caple", url: "https://caple.letras.ulisboa.pt" },
];
---
<Layout
  title="Residence and nationality in Portugal: CIPLE A2 and the path – icanspeak Portuguese"
  description="The path to Portuguese residence and nationality: residence time, who needs the CIPLE A2 language proof, who is exempt, what changed recently and the steps in order. General orientation, not legal advice."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main practice-main--wide">
    <a href="/exams" class="vp-back-link" data-i18n="fallen.back">{tx("fallen.back")}</a>

    <div class="practice-hero">
      <p class="eyebrow" data-i18n="nat.eyebrow">{tx("nat.eyebrow")}</p>
      <h1 data-i18n="nat.title">{tx("nat.title")}</h1>
      <p data-i18n="nat.lead">{tx("nat.lead")}</p>
      <p data-i18n-html="nat.legal" set:html={tx("nat.legal")} />
      <ExamDisclaimer />
    </div>

    <section class="exam-section">
      <h2 data-i18n="nat.short.title">{tx("nat.short.title")}</h2>
      <ul class="task-points">
        {shortVersion.map((n) => <li data-i18n={`nat.short.${n}`}>{tx(`nat.short.${n}`)}</li>)}
      </ul>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.perm.title">{tx("nat.perm.title")}</h2>
      {perm.map((n) => <p data-i18n-html={`nat.perm.${n}`} set:html={tx(`nat.perm.${n}`)} />)}
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.res.title">{tx("nat.res.title")}</h2>
      {/* Headed paragraphs, not a table: the texts are too long for a narrow column on a phone. */}
      {routes.map((n) => (
        <>
          <h3 data-i18n={`nat.res.${n}.time`}>{tx(`nat.res.${n}.time`)}</h3>
          <p data-i18n-html={`nat.res.${n}.who`} set:html={tx(`nat.res.${n}.who`)} />
        </>
      ))}
      <p class="format-note" data-i18n="nat.res.note">{tx("nat.res.note")}</p>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.tests.title">{tx("nat.tests.title")}</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead><tr><th data-i18n="nat.tests.th.who">{tx("nat.tests.th.who")}</th><th data-i18n="nat.tests.th.proof">{tx("nat.tests.th.proof")}</th></tr></thead>
          <tbody>
            {tests.map((k) => (
              <tr>
                <th scope="row" data-i18n={`nat.t.${k}.who`}>{tx(`nat.t.${k}.who`)}</th>
                <td data-i18n={`nat.t.${k}.proof`}>{tx(`nat.t.${k}.proof`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3 data-i18n="nat.list.title">{tx("nat.list.title")}</h3>
      <p data-i18n="nat.list.text">{tx("nat.list.text")}</p>
      <p data-i18n-html="nat.list.warn" set:html={tx("nat.list.warn")} />
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.steps.title">{tx("nat.steps.title")}</h2>
      {steps.map((n) => (
        <>
          <h3 data-i18n={`nat.s${n}.title`}>{tx(`nat.s${n}.title`)}</h3>
          <p data-i18n-html={`nat.s${n}.text`} set:html={tx(`nat.s${n}.text`)} />
        </>
      ))}
      <p data-i18n="nat.s7.after">{tx("nat.s7.after")}</p>
      <p class="format-note" data-i18n="nat.other">{tx("nat.other")}</p>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.changes.title">{tx("nat.changes.title")}</h2>
      <ul class="task-points">
        {changes.map((n) => <li data-i18n-html={`nat.changes.${n}`} set:html={tx(`nat.changes.${n}`)} />)}
      </ul>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.words.title">{tx("nat.words.title")}</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead><tr><th data-i18n="nat.words.th.pt">{tx("nat.words.th.pt")}</th><th data-i18n="nat.words.th.en">{tx("nat.words.th.en")}</th></tr></thead>
          <tbody>
            {words.map(([pt, key]) => (
              <tr>
                <th scope="row" lang="pt-PT" translate="no">{pt}</th>
                <td data-i18n={`nat.w.${key}`}>{tx(`nat.w.${key}`)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.practice.title">{tx("nat.practice.title")}</h2>
      {practice.map((p) => (
        <div class="mock-cta">
          <h3 data-i18n={`nat.p.${p.key}.title`}>{tx(`nat.p.${p.key}.title`)}</h3>
          <p data-i18n={`nat.p.${p.key}.text`}>{tx(`nat.p.${p.key}.text`)}</p>
          <a class="quiz-btn quiz-btn--primary" href={p.href} data-i18n={`nat.p.${p.key}.cta`}>{tx(`nat.p.${p.key}.cta`)}</a>
        </div>
      ))}
      <div class="mock-cta">
        <h3 data-i18n="nat.p.plan.title">{tx("nat.p.plan.title")}</h3>
        <p data-i18n="nat.p.plan.text">{tx("nat.p.plan.text")}</p>
        <a class="plan-link" href="/exam-plan" data-i18n="plan.link">{tx("plan.link")}</a>
      </div>
    </section>

    <section class="exam-section">
      <h2 data-i18n="nat.sources.title">{tx("nat.sources.title")}</h2>
      <ul class="task-points">
        {sources.map((s) => (
          <li><a href={s.url} rel="noopener" data-i18n={`nat.src.${s.key}`}>{tx(`nat.src.${s.key}`)}</a></li>
        ))}
      </ul>
      <p class="format-note" data-i18n="nat.checked">{tx("nat.checked")}</p>
    </section>
  </main>
</Layout>
