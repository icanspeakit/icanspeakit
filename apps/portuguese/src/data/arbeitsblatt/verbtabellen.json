{
  "variety": "pt-PT",
  "ptBR": { "note": "In Brazil people say você, not tu: Quando você corre? Written Portuguese from Portugal uses tu with friends, você is cooler or formal." },
  "tandemFrageBeispiel": {
    "infinitiv": "correr",
    "kacheln": ["quando", "correr", "(tu)"],
    "frage": "Quando corres?",
    "antwortKacheln": ["(eu)", "correr", "de manhã"],
    "antwort": "Corro de manhã."
  },
  "tandemSoGehts": [
    "Cut the cards in the middle. Partner A takes the left half, Partner B the right half.",
    "A builds question 1 from the tiles and asks it: “Quando volta a tua irmã?” The verb tile is the infinitive: you choose the form and the tense.",
    "B hears the question and puts the verb in the right form: volta (presente), comi (pretérito perfeito), tenho escrito (perfeito composto: ter + participle, for something that keeps happening). Irregular forms must be learnt: ir, fui, ido. A tile in brackets, like (eu), says who; it is not written.",
    "Then B asks question 2 and A answers. Take turns. At the end, check with the answer sheet.",
    "Finally: swap cards and do it all again, faster."
  ],
  "tandemRedemittel": [
    { "p1": "Número 1: Quando volta …?", "p2": "Volta …" },
    { "p1": "É «fui» ou «tenho ido»?", "p2": "«Ontem fui», mas «ultimamente tenho ido» muitas vezes." },
    { "p1": "Desculpa, podes repetir, por favor?", "p2": "Número 2: O que …?" }
