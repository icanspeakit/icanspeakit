        "left": {
          "name": "hamsti",
          "expr": "celebrate",
          "say": "Posso dizer «is»? Então, {é}."
        },
        "right": {
          "name": "quaki",
          "expr": "celebrate",
          "say": "Agora {é} que sei!"
        }
      }
    ]
