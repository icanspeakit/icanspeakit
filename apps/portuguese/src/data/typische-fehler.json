          },
          "b": {
            "w": "mais",
            "pos": "adverb: more",
            "ex": "Quero <b>mais</b> café, por favor."
          },
          "why": "mas = but. mais = more. Listen for the vowel: mais has an “ai” sound, mas has a short “a”.",
          "tr": {},
          "check": {
            "gap": "Quero ir à praia, ___ está a chover.",
            "options": [
              "mas",
