          "level": "A2",
          "a": {
            "w": "por",
            "pos": "preposition: for, by",
            "ex": "Obrigada <b>por</b> tudo."
          },
          "b": {
            "w": "pôr",
            "pos": "verb: to put",
            "ex": "Vou <b>pôr</b> a mesa."
          },
          "why": "pôr (with a circumflex) is the verb: pôr a mesa, pôr o casaco. Without the accent, por is a preposition: por favor, por causa de.",
          "tr": {},
          "check": {
            "gap": "Podes ___ o casaco na cadeira?",
