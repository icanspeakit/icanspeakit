          "variety": "pt-PT"
        },
        {
          "id": "porque-porque",
          "level": "A2",
          "a": {
            "w": "porque",
            "pos": "because / why (in the middle)",
            "ex": "Não vou <b>porque</b> estou doente."
          },
          "b": {
            "w": "porquê",
            "pos": "why (at the end of a sentence)",
            "ex": "Não vais? <b>Porquê</b>?"
          },
          "why": "porque (no accent) = because, and why at the start of a question. porquê (circumflex) = why, said alone or at the end: Porquê? Não sei porquê.",
          "tr": {},
          "check": {
            "gap": "Ele não veio. Não sei ___.",
            "options": [
              "porque",
              "porquê"
            ],
            "answer": "b"
          },
          "variety": "pt-PT"
        }
      ]
