  "rules": [
    { "variety": "pt-PT", "id": "aussage", "curve": "fall", "name": "Statement", "text": "The voice falls at the end.", "parts": [{ "t": "Vivo em Lisboa.", "type": "aussage" }] },
    { "variety": "pt-PT", "id": "w", "curve": "fall", "name": "Question-word question", "text": "The voice usually falls at the end, as in a statement. Questions with o que, onde, quando, quem, como, porquê, quanto and qual. In everyday speech you often hear quando é que, onde é que. With a gentle rise instead, they sound extra friendly.", "parts": [{ "t": "De onde és?", "type": "w" }] },
    { "variety": "pt-PT", "id": "jn", "curve": "rise", "name": "Yes/no question", "text": "Often the same words as a statement: only the melody makes it a question (there is no inverted word order and no ¿). The voice rises at the end.", "parts": [{ "t": "És de Portugal?", "type": "jn" }] },
    { "variety": "pt-PT", "id": "echo", "curve": "echo", "name": "Echo question", "text": "The voice rises high at the end. You're surprised or checking what you heard. You can start it with Então or Ai é? and repeat the part you did not believe.", "parts": [{ "t": "Então és de Portugal?", "type": "echo" }] },
    { "variety": "pt-PT", "id": "ausruf", "curve": "excl", "name": "Exclamation", "text": "The stressed word goes very high, then the voice falls a long way. Feeling: joy, anger, surprise.", "parts": [{ "t": "Que bonito!", "type": "ausruf" }] },
    { "variety": "pt-PT", "id": "liste", "curve": "flat", "name": "List", "text": "The voice stays level → until the list is finished. Then it falls ↘.", "parts": [{ "t": "Compro pão,", "type": "weiter" }, { "t": "leite", "type": "weiter" }, { "t": "e queijo.", "type": "aussage" }] },
    { "variety": "pt-PT", "id": "oder", "curve": "rise", "name": "Either-or question", "text": "First choice ↗, last choice ↘.", "parts": [{ "t": "Queres chá", "type": "jn" }, { "t": "ou café?", "type": "w" }] },
    { "variety": "pt-PT", "id": "cortes", "curve": "rise", "name": "Polite request", "text": "In Portugal a polite request is often a question with pode or podia, or a statement with queria. The voice rises gently at the end, and se faz favor or por favor does the rest.", "parts": [{ "t": "Pode trazer-me um café, se faz favor?", "type": "jn" }] }
  ]
