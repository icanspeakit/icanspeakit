            ["ser", "origin, nationality", "Somos do Senegal."],
            ["ser", "what it is like", "O apartamento é pequeno."],
            ["ser", "time, day", "São duas horas. É terça-feira."],
            ["estar", "where now", "A chave está na mesa."],
            ["estar", "state right now", "Estamos cansados."],
            ["estar", "how you are", "Como estás?"],
            ["ficar (or ser)", "where a place is", "A Junta fica ao lado da igreja."]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: accents",
          "variant": "dat",
          "items": [
            "está = he, she or it is. esta = this.",
            "é = is. e = and.",
            "estás, está and estão always have their marks."
          ]
        }
      ]
    }
  },
