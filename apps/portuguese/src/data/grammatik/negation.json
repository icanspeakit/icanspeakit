{
  "id": "negation",
  "name": "Negation: não, nunca, nada, ninguém, nenhum, nem, já não",
  "level": "A2",
  "variety": "pt-PT",
  "ptBR": { "note": "Same rules in Brazil. In speech Brazilians often put não after the verb for emphasis (Sei não); in pt-PT stick to não before the verb." },
  "subtitle": "Put não before the verb: Não trabalho. Portuguese uses double negatives: Não vejo ninguém. Não como nunca carne. If the negative word comes before the verb, drop não: Ninguém vem. Nunca como carne.",
  "briefMarks": ["não", "nunca", "nada", "ninguém", "nenhum", "também não", "nem", "já não"],
  "source": "icanspeak Portuguese original text (grammar-a2 run, 2026-11-13)",
  "concept": {
    "flow": [
      { "text": "não", "variant": "prep" },
      { "text": "verb", "variant": "verb" },
      { "text": "nada · ninguém · nunca · nenhum", "variant": "prep" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">Não</span> <span class=\"vp-verb\">tenho</span> <span class=\"vp-prep\">nada</span>. · <span class=\"vp-prep\">Não</span> <span class=\"vp-verb\">conheço</span> <span class=\"vp-prep\">ninguém</span>. · <span class=\"vp-prep\">Nunca</span> <span class=\"vp-verb\">chega</span> tarde. · <span class=\"vp-prep\">Ninguém</span> <span class=\"vp-verb\">sabe</span> as horas.",
    "qa": [
      {
        "html": "<strong>não</strong> goes directly before the verb. Small pronouns stay between <em>não</em> and the verb: <em>Não trabalho. Não o sei. Não me liga.</em> With the perfect: <em>Não comi.</em>",
        "tag": "não"
      },
      {
        "html": "After <em>não</em> + verb, use <strong>nada</strong> (nothing), <strong>ninguém</strong> (no one), <strong>nunca</strong> (never), <strong>nenhum, nenhuma</strong> (no, none). Two negatives are correct in Portuguese: <em>Não tenho nada. Não vem ninguém.</em>",
        "tag": "Double negatives"
      },
      {
        "html": "Put the negative word <strong>before the verb</strong> and drop <em>não</em>: <em>Nunca vou. = Não vou nunca. Ninguém vem. = Não vem ninguém.</em>",
        "tag": "Before the verb"
      },
      {
        "html": "<strong>também não</strong> means “not either”: <em>Não tenho carro, e o meu irmão também não.</em> Short answers: <em>Eu também não.</em> or <em>Nem eu.</em> After a positive sentence use <em>também</em>: <em>Eu também.</em>",
        "tag": "também não"
      },
      {
        "html": "<strong>nem… nem</strong> means “neither… nor”: <em>Não tenho nem tempo nem dinheiro.</em> <strong>já não</strong> means “not any more”: <em>Já não vivo em Lisboa.</em>",
        "tag": "nem, já não"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Não tenho alguma coisa</em> → ✓ <em>Não tenho nada</em>. ✗ <em>Ninguém não vem</em> → ✓ <em>Ninguém vem</em>. ✗ <em>Nunca não vou</em> → ✓ <em>Nunca vou</em>. ✗ <em>Eu também não</em> after a positive sentence → ✓ <em>Eu também</em>. ✗ <em>O não sei</em> → ✓ <em>Não o sei</em>. English speakers: “I don't have anything” is <em>não tenho nada</em>, with two negatives. Spanish speakers: there is no <em>tampoco</em>, say <em>também não</em> or <em>nem eu</em>. See also <a href=\"/indefinites\">alguém, algum, nenhum</a>.",
