  "ptBR": { "note": "Same in Brazil. Brazilians also use bem and meio before adjectives (bem caro, meio cansado). tão and tanto work the same." },
  "subtitle": "muito goes before an adjective or adverb and after a verb, and then it never changes: muito cansado, Trabalho muito. Before a noun it agrees: muita gente, muitos problemas. pouco, bastante, demasiado, tão and tanto follow the same pattern.",
  "briefMarks": ["muito", "muita", "pouco", "um pouco", "bastante", "demasiado", "tão", "tanto"],
  "source": "icanspeak Portuguese original text (grammar-a2 run, 2026-11-13)",
  "concept": {
    "flow": [
      { "text": "muito + adjective", "variant": "prep" },
      { "text": "verb + muito", "variant": "verb" },
      { "text": "muito · muita · muitos · muitas + noun" }
    ],
    "exampleHtml": "Estou <span class=\"vp-prep\">muito</span> cansado. · Trabalho <span class=\"vp-prep\">muito</span>. · Há <span class=\"vp-prep\">muita</span> gente. · Tenho <span class=\"vp-prep\">pouco</span> dinheiro. · É <span class=\"vp-prep\">demasiado</span> caro.",
    "qa": [
      {
        "html": "<strong>muito</strong> before an adjective or adverb never changes: <em>Ela é muito alta. Eles são muito simpáticos. Vivo muito perto.</em> It can stand alone as an answer: <em>Estás cansado? — Muito.</em>",
        "tag": "muito + adjective"
      },
      {
        "html": "<strong>muito</strong> after a verb does not change either: <em>A Ana trabalha muito. Gosto muito.</em>",
        "tag": "verb + muito"
      },
      {
        "html": "<strong>muito</strong> before a noun agrees with it: <em>muito trabalho, muita gente, muitos problemas, muitas horas</em>. Note: <em>gente</em> is feminine singular.",
        "tag": "muito + noun"
      },
      {
        "html": "<strong>pouco</strong> follows the same pattern: <em>Durmo pouco. Tenho pouco tempo e poucas ganas.</em> <strong>um pouco</strong> is positive: <em>Estou um pouco cansado. Falo um pouco de português. Quero um pouco de água.</em>",
        "tag": "pouco, um pouco"
      },
      {
        "html": "<strong>bastante</strong> = quite, enough. Before a plural noun it adds -s: <em>É bastante caro. Trabalho bastante. Tenho bastantes problemas.</em>",
        "tag": "bastante"
      },
      {
        "html": "<strong>demasiado</strong> = too, too much. With an adjective or a verb it does not change: <em>É demasiado caro. Trabalhas demasiado.</em> With a noun it agrees: <em>demasiada gente, demasiados papéis</em>.",
        "tag": "demasiado"
      },
      {
        "html": "<strong>tão</strong> + adjective or adverb = so: <em>É tão caro! Fala tão depressa.</em> <strong>tanto</strong> after a verb = so much: <em>Trabalhas tanto!</em> Before a noun it agrees: <em>tanto trânsito, tanta gente, tantos problemas, tantas horas</em>.",
        "tag": "tão, tanto"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Estou muita cansada</em> → ✓ <em>Estou muito cansada</em> (before an adjective it never changes). ✗ <em>muito gente</em> → ✓ <em>muita gente</em>. ✗ <em>muitas gentes</em> → ✓ <em>muita gente</em>. ✗ <em>muito fome</em> → ✓ <em>muita fome</em>: <em>fome</em> and <em>sede</em> are nouns, and so are <em>frio, calor, sono</em>: <em>Tenho muito frio.</em> ✗ <em>Tenho muito de trabalho</em> → ✓ <em>Tenho muito trabalho</em>. Spanish speakers: there is no <em>muy</em>, say <em>muito</em> everywhere.",
