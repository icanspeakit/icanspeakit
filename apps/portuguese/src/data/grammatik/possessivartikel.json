            ["nós", "o nosso", "a nossa", "os nossos", "as nossas"],
            ["vocês", "o vosso", "a vossa", "os vossos", "as vossas"]
          ]
        },
        {
          "caption": "His, her, their: after the noun",
          "head": ["Owner", "Example", "Meaning"],
          "rows": [
            ["ele", "o carro dele", "his car"],
            ["ela", "a casa dela", "her house"],
            ["eles", "os filhos deles", "their children"],
            ["elas", "a mãe delas", "their mother"],
            ["a Carla", "o irmão da Carla", "Carla’s brother"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: the article stays",
