        {
          "badge": "Careful: à has an accent",
          "variant": "dat",
          "items": [
            "à = a + a: Vou à farmácia. Without the accent, a is just “the” or “to”.",
            "às = a + as: Chego às oito. Vou às Finanças."
          ]
        },
        {
          "badge": "No article",
