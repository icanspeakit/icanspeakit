  "variety": "pt-PT",
  "ptBR": { "note": "The same endings work in Brazil, where diminutives are used even more often (agorinha, cafezinho, rapidinho)." },
  "subtitle": "The ending of a Portuguese noun often tells you what it means and its gender. -ção and -dade make feminine nouns: a informação, a cidade. -mento makes masculine ones: o nascimento. -eiro/-eira is a person with a job, -aria is the shop, -ista works for men and women. -inho and -zinho make things small.",
  "briefMarks": ["-ção", "-dade", "-mento", "-eiro", "-eira", "-aria", "-ista", "-inho", "-zinho"],
  "source": "icanspeak Portuguese original text (grammar-b1 run, 2026-11-13)",
  "concept": {
    "comic": {
      "title": "A {padaria} do Bruno",
      "panels": [
        {
          "caption": "The shop",
          "tag": "{-aria} = the shop",
          "left": { "name": "quaki", "expr": "thinking", "say": "Onde fica a {padaria}?" },
          "right": { "name": "regi", "expr": "happy", "say": "Ali, na esquina." }
        },
        {
          "caption": "The person",
          "tag": "{-eiro} = the job",
          "left": { "name": "quaki", "expr": "happy", "say": "É o {padeiro}?" },
          "right": { "name": "bruno", "expr": "celebrate", "say": "Sou! Um {momentinho}, por favor." }
        }
      ]
    },
    "flow": [
      { "text": "informar · possível · nascer · pão", "variant": "verb" },
      { "text": "-ção · -dade · -mento · -eiro · -aria", "variant": "prep" }
    ],
    "qa": [
      {
        "html": "<strong>-ção</strong> makes nouns from verbs. They are <strong>feminine</strong>: <em>informar → a informação, organizar → a organização, renovar → a renovação, inscrever-se → a inscrição</em>. The plural is <em>-ções</em>: <em>as informações, as soluções</em>. (The famous exception is <em>o coração</em>. Some nouns end in <em>-são</em> instead: <em>decidir → a decisão</em>.)",
        "tag": "-ção"
      },
      {
        "html": "<strong>-dade</strong> makes nouns, often from adjectives. They are <strong>feminine</strong> too: <em>possível → a possibilidade, responsável → a responsabilidade, feliz → a felicidade</em>; also <em>a cidade, a universidade, a nacionalidade</em>. Plural: <em>-dades</em>.",
        "tag": "-dade"
      },
      {
        "html": "<strong>-mento</strong> makes nouns from verbs. They are <strong>masculine</strong>: <em>nascer → o nascimento, conhecer → o conhecimento, pagar → o pagamento, arrendar → o arrendamento, atender → o atendimento</em>. Note the vowel before it: <em>-amento</em> (verbs in -ar), <em>-imento</em> (verbs in -er and -ir).",
        "tag": "-mento"
      },
      {
        "html": "<strong>-eiro / -eira</strong>: a person with a job. <em>o padeiro, a padeira, o sapateiro, o jardineiro, o peixeiro</em>. <strong>-aria</strong>: the shop or place. <em>a padaria, a pastelaria, a sapataria, a livraria, a papelaria, a peixaria</em>. Not every shop follows this: the butcher's is <em>o talho</em> and the hairdresser is <em>o cabeleireiro / a cabeleireira</em>, for the person and the place.",
        "tag": "-eiro, -aria"
      },
      {
        "html": "<strong>-ista</strong> is a person too, for a man or a woman: <em>o dentista, a dentista; o/a taxista, o/a jornalista, o/a eletricista, o/a turista</em>. Only the article changes, never the ending. Compare <em>-eiro/-eira</em>, which changes.",
        "tag": "-ista"
      },
      {
        "html": "<strong>-inho / -inha</strong> makes something small, or sounds kinder. If the word ends in an unstressed vowel, drop it: <em>casa → casinha, livro → livrinho, momento → momentinho</em>. Watch the spelling: <em>pouco → pouquinho</em>. If the word ends in a stressed vowel, a nasal or a consonant, add <strong>-zinho / -zinha</strong>: <em>café → cafezinho, pão → pãozinho (plural pãezinhos), flor → florzinha, papel → papelzinho</em>. Some small forms are words of their own: <em>um bocadinho</em> (a little bit, a short while).",
        "tag": "-inho, -zinho"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>o informação</em> → ✓ <em>a informação</em>. ✗ <em>a nascimento</em> → ✓ <em>o nascimento</em>. ✗ <em>o cidade</em> → ✓ <em>a cidade</em>. ✗ <em>um poucinho</em> → ✓ <em>um pouquinho</em>. ✗ <em>o dentista</em> for a woman → ✓ <em>a dentista</em>. Don't confuse <em>a padeira</em> (a person) with <em>a padaria</em> (a shop).",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
