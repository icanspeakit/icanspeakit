{
  "id": "wechselpraepositionen",
  "name": "a, para or em: going and being",
  "level": "A2",
  "variety": "pt-PT",
  "ptBR": { "note": "Brazil says ir para far more than ir a (vou pra casa), and chego em casa instead of chego a casa. Moro em and estou em work the same." },
  "subtitle": "Use a or para for movement towards a place: Vou a Lisboa, vou para casa. Use em for being in a place: Estou em Lisboa. With de… a and desde… até you say where a journey or a time starts and ends.",
  "briefMarks": ["a", "para", "em", "ao", "de… a", "desde… até"],
  "source": "icanspeak Portuguese original text (grammar-a2 run, 2026-11-13)",
  "concept": {
    "flow": [
      { "text": "vou · chego · volto + a / para", "variant": "prep" },
      { "text": "estou · vivo · trabalho + em", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-verb\">Vou</span> <span class=\"vp-prep\">a</span> Lisboa. · <span class=\"vp-verb\">Estou</span> <span class=\"vp-prep\">em</span> Lisboa. · <span class=\"vp-verb\">Chegamos</span> <span class=\"vp-prep\">ao</span> trabalho às oito. · <span class=\"vp-verb\">Trabalho</span> <span class=\"vp-prep\">num</span> hotel.",
    "qa": [
      {
        "html": "<strong>a</strong> = towards a place. It goes with verbs of movement: <em>ir, vir, chegar, voltar, viajar</em>. <em>Vou à farmácia. Voltamos a Braga.</em> For a short visit use <em>a</em>; to go and stay or go home, use <strong>para</strong>: <em>Vou para casa. Vou para o Porto (to live there).</em>",
        "tag": "Movement: a, para"
      },
      {
        "html": "<strong>em</strong> = inside or at a place, no movement: <em>estar, viver, trabalhar, comer, ficar</em>. <em>Estou na farmácia. Vivo em Braga.</em>",
        "tag": "Being there: em"
      },
      {
        "html": "<strong>a + o = ao</strong>, <strong>a + a = à</strong>: <em>Vou ao médico. Vou à escola. Chego ao trabalho.</em> <em>em + o = no, em + a = na</em>: <em>Estou no escritório. Estou na escola.</em> Watch the accent: <em>à</em> (to the) and <em>a</em> (to, no article) are different.",
        "tag": "ao, à, no, na"
      },
      {
        "html": "<strong>chegar</strong> takes <em>a</em>, even when you are there at the end: <em>Chego a Lisboa às dez. Chego a casa às sete.</em> <strong>entrar</strong> takes <em>em</em>: <em>Entro no escritório.</em>",
        "tag": "chegar, entrar"
      },
      {
        "html": "How you travel takes <strong>de</strong>: <em>Vou de metro, de comboio, de carro, de autocarro.</em> On foot is <strong>a pé</strong>. You can also say <em>no autocarro</em>, <em>no comboio</em> when you mean inside it.",
        "tag": "de metro, a pé"
      },
      {
        "html": "Start and end: <strong>de… a</strong> or <strong>desde… até</strong>. <em>Trabalho das nove às duas. O comboio vai de Lisboa a Faro. Vamos a pé desde casa até ao parque.</em> Where you come from takes <em>de</em>: <em>Venho do trabalho.</em>",
        "tag": "Start and end"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Vou em Lisboa</em> → ✓ <em>Vou a Lisboa</em>. ✗ <em>Estou a Lisboa</em> → ✓ <em>Estou em Lisboa</em>. ✗ <em>Chego em casa</em> → ✓ <em>Chego a casa</em>. ✗ <em>Vou a o médico</em> → ✓ <em>Vou ao médico</em>. ✗ <em>Vou em metro</em> → ✓ <em>Vou de metro</em>. Spanish speakers: <em>en</em> is <em>em</em>, but <em>en metro</em> is <em>de metro</em>. For exact places, see <a href=\"/prepositions-of-place\">saying where</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "a, para or em",
          "head": ["Word", "Verbs", "Example"],
          "rows": [
            ["a", "ir, vir, chegar, voltar, viajar", "Vou ao escritório."],
            ["para", "ir, voltar (to stay, or home)", "Vou para casa."],
            ["em", "estar, viver, trabalhar, comer, ficar", "Estou no escritório."],
            ["de", "vir, sair, voltar", "Saio do escritório."],
            ["de (transport)", "ir, viajar", "Vou de metro."]
          ]
        },
        {
          "caption": "Start and end",
          "head": ["Form", "Example", "Used for"],
          "rows": [
            ["de… a", "Trabalho das nove às duas.", "time"],
            ["de… a", "O comboio vai de Lisboa a Faro.", "place"],
            ["desde… até", "Espero por ti desde as três até às cinco.", "time"],
            ["desde… até", "Andamos desde casa até ao parque.", "place"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful",
          "variant": "dat",
          "items": [
            "Vou para casa. / Estou em casa. No article with casa here.",
            "Venho de casa. / Saio de casa.",
            "a pé, but de metro, de comboio, de carro."
          ]
        }
      ]
    }
  },
