    "@playwright/test": "^1.63.0",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.20.2",
    "postcss": "^8.5.28",
    "postcss-rtlcss": "^6.0.0",
    "sharp": "^0.35.4",
    "wrangler": "^4.157.0"
