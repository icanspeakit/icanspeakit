{
  // icanspeak Spanish — https://icanspeak.it/spanish/*
  // Assets only (no Worker code): the static build, copied under spanish/ by
  // `pnpm cf:prepare` (scripts/nest-dist.mjs), because the route keeps the /spanish prefix.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "icanspeak-spanish",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cf-dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "icanspeak.it/spanish", "zone_name": "icanspeak.it" },
    { "pattern": "icanspeak.it/spanish/*", "zone_name": "icanspeak.it" }
  ]
}
