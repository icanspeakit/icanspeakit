---
// A little looping film of the pronunciation check, for MascotGuide's "sim" slot. Three scenes,
// 4 s each, in step with the guide's three steps:
//   1  phone: a big round microphone button pulses, sound-wave bars dance above it
//   2  phone: a sentence as five word pills, they turn green one by one, one turns amber
//   3  phone: the cursor taps the amber pill, a speaker sends out arcs, the mic pulses again and
//      the pill turns green
//
// Same make as UmfrageSim.astro: pure SVG + CSS, no words inside (bars stand for text), one 12 s
// cycle, colours from the theme tokens. The dancing bars and pulse rings loop faster inside their
// scene (1.2 s divides the 12 s cycle). Reduced motion: no film, scene 2 stands still.
const PILLS = [
  [124, 50, 18], [146, 50, 24], [174, 50, 20],
  [124, 70, 28], [156, 70, 22],
] as const; // x, y, width of the five word pills (the fourth is the one that needs work)
const BARS = [12, 20, 28, 34, 38, 34, 28, 20, 12];
---
<div class="sim" aria-hidden="true">
  <svg viewBox="0 0 320 180" role="presentation">
    <rect class="desk" x="0" y="0" width="320" height="180" rx="14" />
    <rect class="bezel" x="112" y="5" width="96" height="170" rx="12" />
    <rect class="screen" x="118" y="13" width="84" height="154" rx="7" />

    <!-- 1 · sprechen -->
    <g class="sc sc1">
      <rect class="line" x="128" y="24" width="64" height="5" rx="2.5" />
      <rect class="line" x="128" y="35" width="44" height="5" rx="2.5" />
      <g class="in" style="animation-delay:0.8s">
        {BARS.map((h, i) => (
          <rect class="bar" style={`animation-delay:-${(i * 0.13).toFixed(2)}s`} x={126 + i * 8.5} y={64 - h / 2} width="5" height={h} rx="2.5" />
        ))}
      </g>
      <g transform="translate(160 118)">
        <g class="in" style="animation-delay:0.8s">
          <circle class="pulse" r="22" />
          <circle class="pulse pulse--2" r="22" />
        </g>
        <circle class="mic-bg" r="22" />
        <circle class="mic-flash" r="22" />
        <rect class="mic" x="-6" y="-12" width="12" height="20" rx="6" />
        <path class="mic-line" d="M-10 1a10 10 0 0 0 20 0M0 11v6" />
      </g>
      <path class="cursor cursor--1" d="M0 0v14l4-3.5 3 6.5 2.5-1.2-3-6.3H12z" />
    </g>

    <!-- 2 · Wörter bewertet -->
    <g class="sc sc2">
      {PILLS.map(([x, y, w], i) => (
        <g>
          <rect class="wp" x={x} y={y} width={w} height="14" rx="7" />
          <rect class:list={["fill", i === 3 ? "fill--amber" : "fill--green"]} style={`animation-delay:${4.4 + i * 0.5}s`} x={x} y={y} width={w} height="14" rx="7" />
          <rect class="wp-bar" x={x + 6} y={y + 5} width={w - 12} height="4" rx="2" />
        </g>
      ))}
      <g transform="translate(160 142) scale(.62)">
        <circle class="mic-bg" r="22" />
        <rect class="mic" x="-6" y="-12" width="12" height="20" rx="6" />
        <path class="mic-line" d="M-10 1a10 10 0 0 0 20 0M0 11v6" />
      </g>
    </g>

    <!-- 3 · nachsprechen -->
    <g class="sc sc3">
      {PILLS.map(([x, y, w], i) => (
        <g>
          <rect class="wp" x={x} y={y} width={w} height="14" rx="7" />
          <rect class:list={["wp-static", i === 3 ? "fill--amber" : "fill--green"]} x={x} y={y} width={w} height="14" rx="7" />
          {i === 3 && <rect class="fill fill--green" style="animation-delay:11.3s" x={x} y={y} width={w} height="14" rx="7" />}
          <rect class="wp-bar" x={x + 6} y={y + 5} width={w - 12} height="4" rx="2" />
        </g>
      ))}
      <g class="in" style="animation-delay:8.9s">
        <path class="spk" d="M150 104h4l5-4v14l-5-4h-4z" />
        <path class="arc arc1" d="M164 105a5 5 0 0 1 0 8" />
        <path class="arc arc2" d="M168 101.5a10 10 0 0 1 0 15" />
        <path class="arc arc3" d="M172 98a15 15 0 0 1 0 22" />
      </g>
      <g transform="translate(160 142) scale(.62)">
        <g class="in" style="animation-delay:10.1s">
          <circle class="pulse" r="22" />
          <circle class="pulse pulse--2" r="22" />
        </g>
        <circle class="mic-bg" r="22" />
        <rect class="mic" x="-6" y="-12" width="12" height="20" rx="6" />
        <path class="mic-line" d="M-10 1a10 10 0 0 0 20 0M0 11v6" />
      </g>
      <path class="cursor cursor--3" d="M0 0v14l4-3.5 3 6.5 2.5-1.2-3-6.3H12z" />
    </g>
  </svg>
</div>

<style>
  .sim { width: 100%; }
  .sim svg { display: block; width: 100%; height: auto; }

  .desk { fill: var(--blue-100); }
  .bezel { fill: var(--rail-surface); }
  .screen { fill: var(--surface-card); }
  .line { fill: var(--border-strong); }
  .bar { fill: var(--brand-blue); }
  .mic-bg { fill: var(--brand-blue); }
  .mic-flash { fill: var(--ink); opacity: 0; }
  .mic { fill: #fff; }
  .mic-line { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; }
  .pulse { fill: none; stroke: var(--brand-blue); stroke-width: 2.5; opacity: 0; }
  .wp { fill: var(--surface-card); stroke: var(--border-strong); stroke-width: 1.2; }
  .wp-bar { fill: var(--ink); opacity: .55; }
  .fill--green { fill: var(--success); }
  .fill--amber { fill: var(--warning); }
  .spk { fill: var(--brand-blue); stroke: var(--brand-blue); stroke-width: 1; stroke-linejoin: round; }
  .arc { fill: none; stroke: var(--brand-blue); stroke-width: 2; stroke-linecap: round; }
  .cursor { fill: var(--ink); stroke: var(--surface-card); stroke-width: 1; }

  /* everything timed: one 12 s cycle, started per part by animation-delay */
  .sc, .in, .fill, .cursor, .mic-flash {
    animation-duration: 12s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-out;
    transform-box: fill-box;
  }
  .sc { opacity: 0; animation-name: aus-sim-scene; }
  .sc2 { animation-delay: 4s; }
  .sc3, .sc3 .cursor { animation-delay: 8s; }
  @keyframes aus-sim-scene { 0% { opacity: 0 } 2%, 31% { opacity: 1 } 33%, 100% { opacity: 0 } }

  /* pops in, stays to the end of its scene */
  .in { opacity: 0; transform-origin: center; animation-name: aus-sim-in; }
  @keyframes aus-sim-in {
    0% { opacity: 0; transform: scale(.4) }
    3% { opacity: 1; transform: scale(1.15) }
    5%, 31% { opacity: 1; transform: scale(1) }
    33%, 100% { opacity: 0 }
  }

  /* a pill takes its colour */
  .fill { opacity: 0; animation-name: aus-sim-fill; }
  @keyframes aus-sim-fill { 0% { opacity: 0 } 3% { opacity: 1 } 31% { opacity: 1 } 33%, 100% { opacity: 0 } }

  /* faster loops inside a scene: dancing bars, pulse rings, speaker arcs (all 1.2 s, 12 / 1.2 = 10) */
  .bar, .pulse, .arc {
    animation-duration: 1.2s;
    animation-iteration-count: infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .bar { animation-name: aus-sim-dance; animation-timing-function: ease-in-out; }
  @keyframes aus-sim-dance { 0%, 100% { transform: scaleY(.25) } 50% { transform: scaleY(1) } }
  .pulse { animation-name: aus-sim-pulse; animation-timing-function: ease-out; }
  .pulse--2 { animation-delay: .6s; }
  @keyframes aus-sim-pulse { 0% { transform: scale(1); opacity: .7 } 100% { transform: scale(1.5); opacity: 0 } }
  .arc { opacity: 0; animation-name: aus-sim-arc; }
  .arc2 { animation-delay: .25s; }
  .arc3 { animation-delay: .5s; }
  @keyframes aus-sim-arc { 0%, 10% { opacity: 0 } 30%, 60% { opacity: 1 } 80%, 100% { opacity: 0 } }

  /* scene 1: tap the mic */
  .cursor--1 { animation-name: aus-sim-cursor1; }
  @keyframes aus-sim-cursor1 {
    0%, 2% { transform: translate(196px, 154px) }
    5% { transform: translate(162px, 120px) }
    6.5% { transform: translate(162px, 120px) scale(.8) }
    8%, 22% { transform: translate(162px, 120px) }
    30%, 100% { transform: translate(196px, 154px) }
  }
  .mic-flash { animation-name: aus-sim-flash1; }
  @keyframes aus-sim-flash1 { 0%, 5.5% { opacity: 0 } 6.5% { opacity: .3 } 10%, 100% { opacity: 0 } }

  /* scene 3: tap the amber pill */
  .wp-static { opacity: 1; }
  .cursor--3 { animation-name: aus-sim-cursor3; }
  @keyframes aus-sim-cursor3 {
    0%, 3% { transform: translate(196px, 154px) }
    8% { transform: translate(138px, 84px) }
    9.5% { transform: translate(138px, 84px) scale(.8) }
    11%, 18% { transform: translate(138px, 84px) }
    26%, 100% { transform: translate(196px, 154px) }
  }

  /* MascotGuide's pause button */
  :global(.mg-paused) .sim * { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .sim * { animation: none !important; }
    .sc2, .sc2 .fill { opacity: 1; }
    .sim .cursor { display: none; }
  }
</style>
