---
// /culture/mistakes — typical mistakes by first language.
//
// Every language is rendered into the HTML (for crawlers and no-JS readers); the chip
// row only hides the others. Framed as transfer from the first language — a property of
// the language systems, not of the people who speak them — and every language opens with
// what it makes EASIER, so the page does not read as a list of what "the Arabs" or "the
// Italians" get wrong.
//
// Styled like /exercises (src/styles/kultur-fehler.css): Hamsti on top, the languages as
// tiles, each mistake a card. The same content in a side-nav layout is on trial at /test123.
//
// Under each language: pronunciation drills for exactly the sounds that language makes hard,
// right on the page (the first one open) rather than a link away to the Check
// (<AusspracheFuerDich>, the same component as the Aussprache-Check's „Für dich") — hear the
// minimal pairs, a short listening test, and the drill sentence read into the microphone and
// scored like the Aussprache-Check, with the typical-mistake findings for that language.
//
// A pronunciation mistake that has a drill offers „Jetzt üben →", which opens that drill
// further down the same section (#drill-<lang>-<drill>). The Check's „Warum passiert das?"
// lands here as ?lang=<id>#<mistake id> — the language's tab opens and the entry lights up.
// The chosen tab is the learner's first language (src/lib/muttersprache.js), shared with the
// Check's picker.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import FehlerSprache from "../../components/FehlerSprache.astro";
import data from "../../data/fehler-nach-sprache.json";
import { mutterspracheInfo } from "../../lib/mutterspracheData";
import { langMark } from "../../lib/langMark.js";
import "../../styles/practice.css";
import "../../styles/uebungen-vorschau.css";
import "../../styles/hub-pics.css";
import "../../styles/kultur.css";
import "../../styles/kultur-insider.css";
import "../../styles/kultur-fehler.css";

const { languages, note, quiz } = data;
const total = languages.reduce((n, l) => n + l.mistakes.length, 0);
const vars = (v: Record<string, unknown>) => JSON.stringify(v);
const info = mutterspracheInfo();
---
<Layout
  title="Common mistakes by first language – icanspeak Spanish"
  description="Typical mistakes in Spanish depending on your first language, why they happen and how to correct them."
>
  <div class="uv">
    <SiteNav active="landeskunde" />
    <main class="uv-main fe2" id="fe-page">
      <a href="/culture" class="vp-back-link" data-i18n="kultur.back">Alle Themen</a>

      <SectionMascot name="hamsti" say="Welche Sprache sprichst du?" align="center" class="hub-mascot uv-hub-mascot" />
      <header class="fe-hero">
        <p class="uv-eyebrow" data-i18n="kultur.fehler.eyebrow">Landeskunde · Sprache</p>
        <h1 data-i18n="kultur.fehler.title">Typische Fehler nach Muttersprache</h1>
        <p data-i18n="kultur.fehler.lead" data-i18n-vars={vars({ n: languages.length, m: total })}>
          {`Jede Sprache bringt ihre eigenen Gewohnheiten mit ins Deutsche. ${languages.length} Sprachen, ${total} typische Fehler — und was deine Muttersprache dir leichter macht.`}
        </p>
      </header>

      <p class="uv-eyebrow" data-i18n="kultur.fehler.chooseLang">Muttersprache wählen</p>
      <div class="fe-picks" role="group" aria-label="Muttersprache wählen" data-i18n-attr="aria-label:kultur.fehler.chooseLang">
        <button class="fe-pick is-on" type="button" data-lang="alle" aria-pressed="true">
          <span class="fe-mark fe-mark--all" aria-hidden="true">{languages.length}</span>
          <span class="fe-pick-txt"><b data-i18n="kultur.fehler.all">Alle</b><i>{total} Fehler</i></span>
        </button>
        {languages.map((l) => (
          <button class="fe-pick" type="button" data-lang={l.id} aria-pressed="false">
            <span class="fe-mark" aria-hidden="true">{langMark(l.id)}</span>
            <span class="fe-pick-txt"><b>{l.name}</b><i dir={l.rtl ? "rtl" : undefined}>{l.native}</i></span>
          </button>
        ))}
      </div>

      <div class="fe-list">
        {languages.map((l) => <FehlerSprache lang={l} />)}
      </div>

      <section class="fe-card">
        <h2 data-i18n="kultur.fehler.quizTitle">Quiz: Erkennst du die Fehler?</h2>
        <p data-i18n="skills.quizIntro" data-i18n-vars={vars({ n: quiz.length })}>{quiz.length} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
        <div class="quiz-card" id="fe-quiz"></div>
      </section>

      <section class="fe-note">
        <span aria-hidden="true">💡</span>
        <div>
          <h2 data-i18n="kultur.fehler.noteTitle">Wichtig</h2>
          <p>{note}</p>
        </div>
      </section>
    </main>
  </div>

  <script type="application/json" id="fe-muttersprache" set:html={JSON.stringify(info)}></script>
  <script>
    import { mountFehlerSeite } from "../../lib/fehlerSeite.js";
    mountFehlerSeite(document.getElementById("fe-page")!);
  </script>

  <script type="application/json" id="fe-quiz-data" set:html={JSON.stringify(quiz)}></script>
  <script type="module">
    import { mountQuiz } from "../../lib/quiz.js";
    import { recordAttempt } from "../../lib/progress.js";

    const questions = JSON.parse(document.getElementById("fe-quiz-data").textContent);
    mountQuiz(document.getElementById("fe-quiz"), questions, {
      mode: "choice",
      meldung: (q, i) => `k:fehler/q${i + 1}`,
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "kultur", correct: ok }),
    });
  </script>
</Layout>
