{
  "id": "negation",
  "name": "Negation: non, mai, niente, nessuno, neanche, né… né",
  "level": "A2",
  "variety": "it-IT",
  "subtitle": "Put non before the verb: Non lavoro. Italian uses double negatives: Non vedo nessuno. Non mangio mai carne. If the negative word comes before the verb, drop non: Nessuno viene. Niente funziona.",
  "briefMarks": ["non", "mai", "niente", "nessuno", "neanche", "né… né", "non… più", "non… ancora"],
  "source": "icanspeak Italian original text (grammar-a2 run, 2026-11-13)",
  "concept": {
    "flow": [
      { "text": "non", "variant": "prep" },
      { "text": "verb", "variant": "verb" },
      { "text": "niente · nessuno · mai · più · ancora", "variant": "prep" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">Non</span> <span class=\"vp-verb\">ho</span> <span class=\"vp-prep\">niente</span>. · <span class=\"vp-prep\">Non</span> <span class=\"vp-verb\">conosco</span> <span class=\"vp-prep\">nessuno</span>. · <span class=\"vp-prep\">Non</span> <span class=\"vp-verb\">arriva</span> <span class=\"vp-prep\">mai</span> tardi. · <span class=\"vp-prep\">Nessuno</span> <span class=\"vp-verb\">sa</span> l'ora.",
    "qa": [
      {
        "html": "<strong>non</strong> goes directly before the verb, and before small pronouns: <em>Non lavoro. Non lo so. Non mi chiama.</em> With the passato prossimo it stands before the auxiliary: <em>Non ho mangiato.</em>",
        "tag": "non"
      },
      {
        "html": "After <em>non</em> + verb, use <strong>niente</strong> or <strong>nulla</strong> (nothing), <strong>nessuno</strong> (no one), <strong>mai</strong> (never), <strong>nessun, nessuna</strong> (no, none) and <strong>neanche</strong> (not even, neither). Two negatives are correct in Italian: <em>Non ho niente. Non viene nessuno.</em>",
        "tag": "Double negatives"
      },
      {
        "html": "<strong>non… più</strong> = not any more, <strong>non… ancora</strong> = not yet, <strong>non… mai</strong> = never. They stand around the verb: <em>Non abito più a Roma. Non ho ancora pagato. Non vado mai in palestra.</em> With a compound tense, <em>più, mai, ancora</em> go between the auxiliary and the participle: <em>Non ho mai visto Venezia.</em>",
        "tag": "più, ancora, mai"
      },
      {
        "html": "Put <strong>nessuno</strong> or <strong>niente</strong> <strong>before the verb</strong> and drop <em>non</em>: <em>Nessuno viene. = Non viene nessuno. Niente funziona. = Non funziona niente.</em> <em>Mai</em> is normally put after the verb with <em>non</em>.",
        "tag": "Before the verb"
      },
      {
        "html": "<strong>neanche</strong> (also <em>nemmeno, neppure</em>) means “not either”: <em>Non ho la macchina, e neanche mio fratello.</em> <em>Anche</em> goes with a positive: <em>Anch'io.</em> <em>Neanche io.</em> answers a negative.",
        "tag": "neanche"
      },
      {
        "html": "<strong>né… né</strong> means “neither… nor”: <em>Non ho né tempo né soldi.</em> With <em>né… né</em> before the verb, there is no <em>non</em>: <em>Né Marco né Anna lo sanno.</em>",
        "tag": "né… né"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Non ho qualcosa</em> → ✓ <em>Non ho niente</em>. ✗ <em>Nessuno non viene</em> → ✓ <em>Nessuno viene</em>. ✗ <em>Non mai vado</em> → ✓ <em>Non vado mai</em>. ✗ <em>Anche io no</em> → ✓ <em>Neanche io</em>. ✗ <em>Lo non so</em> → ✓ <em>Non lo so</em>. See also <a href=\"/indefinites\">qualcosa, qualcuno, qualche</a>.",
    "reference": {
