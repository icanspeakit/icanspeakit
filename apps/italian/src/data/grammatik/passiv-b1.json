{
  "id": "passiv-b1",
  "name": "Ci and ne: ci vado, ci penso, ne ho due",
  "level": "B1",
  "variety": "it-IT",
  "subtitle": "Ci and ne are small words that replace a whole phrase. Ci replaces a place or a thing with a/in: Vai in banca? Sì, ci vado. Ci penso. Ne replaces a quantity or di + something: Quanti figli hai? Ne ho due. Ne parlo con il mio capo. Both stand before the verb. Ci vuole / ci vogliono tell how much time or how many things you need.",
  "briefMarks": [
    "ci",
    "ne",
    "ci vado",
    "ci penso",
    "ne ho due",
    "ci vuole",
    "ci vogliono"
  ],
  "source": "icanspeak Italian original text (grammar-b1 run, 2026-11-13)",
