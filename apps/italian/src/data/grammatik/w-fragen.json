          "rows": [
            ["Come ti chiami? / Come si chiama?", "What is your name?"],
            ["Di dove sei? / Di dov'è?", "Where are you from?"],
            ["Quanti anni hai? / Quanti anni ha?", "How old are you?"],
            ["Che lavoro fai?", "What do you do (for work)?"],
            ["Qual è il Suo indirizzo?", "What is your address? (polite)"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: qual è, dov'è",
          "variant": "dat",
          "items": [
            "qual è: no apostrophe (qual is a full word on its own).",
            "dov'è: apostrophe (dove loses its -e before è)."
          ]
        }
      ]
    }
  },
