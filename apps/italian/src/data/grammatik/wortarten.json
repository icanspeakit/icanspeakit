    ],
    "exampleHtml": "<span class=\"vp-prep\">La</span> <span class=\"vp-verb\">casa</span> nuova <span class=\"vp-verb\">è</span> a Bologna.",
    "qa": [
      {
        "html": "<strong>Noun</strong> (<em>nome</em> or <em>sostantivo</em>): names a person, thing or place: <em>casa, medico, Roma</em>. It has a gender. <strong>Article</strong> (<em>articolo</em>): comes before a noun: <em>il, lo, la, un, una</em>.",
        "tag": "Noun, article"
      },
      {
        "html": "<strong>Verb</strong> (<em>verbo</em>): says what someone does or what something is: <em>lavoro, mangi, è</em>. Its ending changes for the person.",
        "tag": "Verb"
      },
      {
        "html": "<strong>Adjective</strong> (<em>aggettivo</em>): describes a noun and matches it: <em>una casa bianca</em>. <strong>Adverb</strong> (<em>avverbio</em>): says how, when or where, and does not change: <em>bene, oggi, qui, sempre</em>.",
        "tag": "Adjective, adverb"
      },
      {
        "html": "<strong>Pronoun</strong> (<em>pronome</em>): stands for a noun: <em>io, tu, lei</em>. <strong>Preposition</strong> (<em>preposizione</em>): a small word before a noun: <em>a, di, da, in, con, per</em>. <strong>Conjunction</strong> (<em>congiunzione</em>): joins words or sentences: <em>e, o, ma, perché</em>.",
        "tag": "Small words"
      }
    ],
    "noteHtml": "A quick test: can you put <em>il, la</em> or <em>un</em> in front of the word? Then it is probably a noun. Does it change with <em>io, tu, lui</em>? Then it is a verb. Does it change to <em>-o, -a, -i, -e</em> next to a noun? Then it is probably an adjective.",
    "reference": {
