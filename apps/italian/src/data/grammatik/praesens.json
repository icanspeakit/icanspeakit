          "badge": "Careful: -isc- verbs",
          "variant": "dat",
          "items": [
            "capire → capisco, capisci, capisce, capiamo, capite, capiscono",
            "preferire → preferisco · pulire → pulisco · spedire → spedisco",
            "Not all -ire verbs: dormo, parto, apro, sento."
          ]
        }
      ]
    }
  },
