{
  "id": "ja-nein-fragen",
  "name": "Yes/no questions and negation with non",
  "level": "A1",
  "variety": "it-IT",
  "subtitle": "A yes/no question uses the same words as a statement. Only the question mark in writing and your voice going up show that it is a question. Put non before the verb to say “not”.",
  "briefMarks": ["?", "sì", "no", "non"],
  "source": "icanspeak Italian original text (grammar-a1 run, 2026-11-12)",
  "concept": {
    "flow": [
      { "text": "(person)" },
      { "text": "(non)", "variant": "prep" },
      { "text": "verb", "variant": "verb" },
      { "text": "rest ?" }
    ],
    "exampleHtml": "Marco lavora oggi. → Marco <span class=\"vp-verb\">lavora</span> oggi? · Hai la macchina. → <span class=\"vp-verb\">Hai</span> la macchina? · Parlo inglese. → <span class=\"vp-prep\">Non</span> <span class=\"vp-verb\">parlo</span> inglese.",
    "qa": [
      {
        "html": "Italian has no word like <em>do</em> or <em>does</em>, and the words do not change places. A statement becomes a question with your voice: <em>Abiti qui. → Abiti qui?</em>",
        "tag": "No extra word"
      },
      {
        "html": "A named person can come before or after the verb: <em>Marco lavora oggi?</em> or <em>Lavora oggi, Marco?</em> The first is the most common.",
        "tag": "Word order"
      },
      {
        "html": "Put <strong>non</strong> right before the verb: <em>Non lavoro il lunedì. Mio figlio non mangia carne.</em> Not after it: ✗ <em>Lavoro non.</em>",
        "tag": "non + verb"
      },
      {
        "html": "“No” as an answer is <strong>no</strong>; “not” before a verb is <strong>non</strong>. So a short answer often has both: <em>Hai figli? – <strong>No, non</strong> ho figli.</em> Yes is <strong>sì</strong>: <em>Sì, ho due figli.</em>",
        "tag": "no and non"
      },
      {
        "html": "Add <strong>vero?</strong> or <strong>no?</strong> to check something: <em>Abiti qui, vero?</em> <em>È medico, no?</em>",
        "tag": "vero?"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>No parlo inglese</em> → ✓ <em>Non parlo inglese</em>. ✗ <em>Parlo non inglese</em> → ✓ <em>Non parlo inglese</em>. ✗ <em>si</em> for “yes” → ✓ <em>sì</em> (<em>si</em> without an accent is another word: <em>si chiama</em>). With question words: <a href=\"/question-words\">Question words</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "Statement, question, negative",
          "head": ["Statement", "Question", "Negative"],
          "rows": [
            ["Abiti qui.", "Abiti qui?", "Non abiti qui."],
            ["Ha la macchina.", "Ha la macchina?", "Non ha la macchina."],
            ["Sono del Perù.", "Sono del Perù?", "Non sono del Perù."],
            ["C'è latte.", "C'è latte?", "Non c'è latte."]
          ]
        },
        {
          "caption": "Short answers",
          "head": ["Question", "Yes", "No"],
          "rows": [
            ["Parli italiano?", "Sì, parlo italiano.", "No, non parlo italiano."],
            ["Hai figli?", "Sì, ho due figli.", "No, non ho figli."],
            ["Sei di qui?", "Sì, sono di qui.", "No, non sono di qui."]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: sì and si, no and non",
          "variant": "dat",
          "items": [
            "sì with an accent = yes. si without an accent: si chiama, si dice.",
            "no = the answer “no”. non = “not”, before a verb."
          ]
        }
      ]
    }
  },
