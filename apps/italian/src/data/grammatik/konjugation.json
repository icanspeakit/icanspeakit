          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: accents",
          "variant": "dat",
          "items": [
            "dare: lui dà needs the accent. da without an accent means “from”.",
            "fare: lui fa, no accent. sapere: lui sa, no accent.",
            "essere and avere are irregular too: they have their own page."
          ]
        }
      ]
