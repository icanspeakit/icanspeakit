{
  "id": "imperativ",
  "name": "Imperative: parla, non parlare, parli, dimmelo",
  "level": "B1",
  "variety": "it-IT",
  "subtitle": "Use the imperative to give instructions, advice and invitations. To a friend (tu): Parla più piano! Vieni qui! To someone you address formally (Lei): Mi dica. Si accomodi. The negative with tu uses non + infinitive: Non parlare! With pronouns they attach to the end for tu, noi and voi (Dimmelo! Aspettami!), and go before the verb with Lei (Me lo dica).",
  "briefMarks": [
    "parla",
    "prendi",
    "parli",
    "prenda",
    "non parlare",
    "dimmi",
    "dammi",
    "vai",
    "di'",
    "fai"
  ],
  "source": "icanspeak Italian original text (grammar-b1 run, 2026-11-13)",
  "concept": {
    "flow": [
      {
        "text": "tu: parla · prendi · parti",
        "variant": "verb"
      },
      {
        "text": "Lei: parli · prenda · parta",
        "variant": "prep"
      },
