            ["noi", "per noi", "con noi", "da noi"],
            ["voi", "per voi", "con voi", "da voi"],
            ["loro", "per loro", "con loro", "da loro"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: me, te, sé",
          "variant": "dat",
          "items": [
            "me and te: no accent (per me, con te).",
            "tè = tea, sé = oneself: they keep the accent.",
            "senza di me, dietro di te: di is often added."
          ]
        }
      ]
    }
  },
