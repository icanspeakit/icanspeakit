  "rules": [
    { "variety": "it-IT", "id": "aussage", "curve": "fall", "name": "Statement", "text": "The voice falls at the end.", "parts": [{ "t": "Abito a Torino.", "type": "aussage" }] },
    { "variety": "it-IT", "id": "w", "curve": "fall", "name": "Question-word question", "text": "The voice usually falls at the end, as in a statement. Questions with che, chi, cosa, come, quando, dove, perché, quanto and quale. With a gentle rise instead, they sound extra friendly.", "parts": [{ "t": "Di dove sei?", "type": "w" }] },
    { "variety": "it-IT", "id": "jn", "curve": "rise", "name": "Yes/no question", "text": "The words are the same as in a statement, and the word order too: only the melody, and the ? in writing, makes it a question. The voice rises at the end.", "parts": [{ "t": "Sei portoghese?", "type": "jn" }] },
    { "variety": "it-IT", "id": "echo", "curve": "echo", "name": "Echo question", "text": "The voice rises high at the end. You're surprised or checking what you heard. Italians often repeat the word, or start with Come? or Davvero?", "parts": [{ "t": "Sei portoghese?", "type": "echo" }] },
    { "variety": "it-IT", "id": "ausruf", "curve": "excl", "name": "Exclamation", "text": "The stressed word goes very high, then the voice falls a long way. Feeling: joy, anger, surprise.", "parts": [{ "t": "Che bello!", "type": "ausruf" }] },
    { "variety": "it-IT", "id": "liste", "curve": "flat", "name": "List", "text": "The voice stays level → until the list is finished. Then it falls ↘.", "parts": [{ "t": "Compro il pane,", "type": "weiter" }, { "t": "il latte", "type": "weiter" }, { "t": "e il formaggio.", "type": "aussage" }] },
    { "variety": "it-IT", "id": "oder", "curve": "rise", "name": "Either-or question", "text": "First choice ↗, last choice ↘.", "parts": [{ "t": "Vuoi un tè", "type": "jn" }, { "t": "o un caffè?", "type": "w" }] },
    { "variety": "it-IT", "id": "cortes", "curve": "rise", "name": "Polite request", "text": "In Italy a polite request is usually a question. The voice rises gently at the end, per favore and Lei do the rest. Mi porta un caffè? is polite; Portami un caffè is an order between friends.", "parts": [{ "t": "Mi porta un caffè, per favore?", "type": "jn" }] }
  ]
