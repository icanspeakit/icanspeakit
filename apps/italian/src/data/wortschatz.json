[
  {"front":"Secondo me, …","note":"Giving your opinion: a safe way to start in any conversation.","variety":"it-IT","translations":{"en":"In my opinion, …","de":"Meiner Meinung nach …","es":"En mi opinión, …","fr":"À mon avis, …","pt":"Na minha opinião, …"}},
  {"front":"Sono d'accordo.","note":"Agreeing. The opposite: Non sono d'accordo. Very common too: Hai ragione (you are right).","variety":"it-IT","translations":{"en":"I agree.","de":"Ich stimme zu.","es":"Estoy de acuerdo.","fr":"Je suis d'accord.","pt":"Concordo."}},
  {"front":"Come stai?","note":"A friendly greeting with tu. Answer: Bene, grazie. E tu? With Lei: Come sta?","variety":"it-IT","translations":{"en":"How are you?","de":"Wie geht es dir?","es":"¿Cómo estás?","fr":"Comment vas-tu ?","pt":"Como vai?"}},
  {"front":"Di dove sei?","note":"Answer: Sono di [town] (a town) or Sono [nationality]. With Lei: Di dov'è?","variety":"it-IT","translations":{"en":"Where are you from?","de":"Woher kommst du?","es":"¿De dónde eres?","fr":"D'où viens-tu ?","pt":"De onde você é?"},"img":"/img/openmoji/1F30D.svg"},
  {"front":"Che lavoro fai?","note":"Asking about someone's job. Answer without an article: Sono infermiera.","variety":"it-IT","translations":{"en":"What do you do?","de":"Was machst du beruflich?","es":"¿A qué te dedicas?","fr":"Qu'est-ce que tu fais dans la vie ?","pt":"O que você faz da vida?"},"img":"/img/openmoji/1F4BC.svg"},
  {"front":"Che lingue parli?","note":"Answer: Parlo …","variety":"it-IT","translations":{"en":"Which languages do you speak?","de":"Welche Sprachen sprichst du?","es":"¿Qué idiomas hablas?","fr":"Quelles langues parles-tu ?","pt":"Que línguas você fala?"},"img":"/img/openmoji/1F5E3.svg"},
  {"front":"Dove abiti?","note":"Answer: Abito a [town] / in via [street]. With Lei: Dove abita?","variety":"it-IT","translations":{"en":"Where do you live?","de":"Wo wohnst du?","es":"¿Dónde vives?","fr":"Où habites-tu ?","pt":"Onde você mora?"},"img":"/img/openmoji/1F3E0.svg"},
  {"front":"il cane","note":"Good: great company, and it gets you outside. Bad: it needs a walk every day.","variety":"it-IT","translations":{"en":"dog","de":"der Hund","es":"el perro","fr":"le chien","pt":"o cachorro"},"img":"/img/openmoji/1F415.svg"},
  {"front":"il gatto","note":"Good: it doesn't need much space. Bad: it can scratch the furniture.","variety":"it-IT","translations":{"en":"cat","de":"die Katze","es":"el gato","fr":"le chat","pt":"o gato"},"img":"/img/openmoji/1F408.svg"},
  {"front":"il criceto","note":"A small pet: it needs little space and little food.","variety":"it-IT","translations":{"en":"hamster","de":"der Hamster","es":"el hámster","fr":"le hamster","pt":"o hamster"}},
  {"front":"la gabbia","note":"You need to clean it every week.","variety":"it-IT","translations":{"en":"cage","de":"der Käfig","es":"la jaula","fr":"la cage","pt":"a gaiola"}},
  {"front":"il veterinario, la veterinaria","note":"Take your pet to the vet when it is ill: Porto il cane dal veterinario.","variety":"it-IT","translations":{"en":"vet","de":"der Tierarzt, die Tierärztin","es":"el veterinario, la veterinaria","fr":"le vétérinaire, la vétérinaire","pt":"o veterinário, a veterinária"}},
  {"front":"organizzare un viaggio","note":"Talk together: where to stay, what to do and how much it costs.","variety":"it-IT","translations":{"en":"to plan a trip","de":"eine Reise planen","es":"organizar un viaje","fr":"préparer un voyage","pt":"planejar uma viagem"},"img":"/img/openmoji/1F5FA.svg"},
  {"front":"Dove dormiamo?","note":"Planning a trip and making suggestions. Also: Dove alloggiamo? (more formal).","variety":"it-IT","translations":{"en":"Where shall we stay?","de":"Wo übernachten wir?","es":"¿Dónde nos quedamos?","fr":"Où est-ce qu'on loge ?","pt":"Onde ficamos?"},"img":"/img/openmoji/1F3E8.svg"},
  {"front":"Quanto vogliamo spendere?","note":"Asking about money when you plan something together.","variety":"it-IT","translations":{"en":"How much do we want to spend?","de":"Wie viel wollen wir ausgeben?","es":"¿Cuánto queremos gastar?","fr":"Combien voulons-nous dépenser ?","pt":"Quanto queremos gastar?"},"img":"/img/openmoji/1F4B5.svg"}
