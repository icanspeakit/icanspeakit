---
import Layout from "../../../layouts/Layout.astro";
import ExamShell from "../../../components/ExamShell.astro";
import SatzListe from "../../../components/SatzListe.astro";
import ExamPractice from "../../../components/ExamPractice.astro";
import ExamFormat from "../../../components/ExamFormat.astro";
import telcFormate from "../../../data/pruefungen/telc-formate.json";

// CELI by level (content-plan §2: the telc slot; the page moves to /celi with `routes`).
// Format data comes from telc-formate.json and the sets from saetze/telc-*, both converted by
// `exams-cils-celi`. Each CELI level is its own exam. Official exam items are never
// reproduced here; exam facts are worded as orientation and "to verify" in the run reports.
const formate = telcFormate.formate;
---
<Layout
  title="CELI by level: practice and exam format – icanspeak Italian"
  description="Practise for the CELI at A2 and B1: reading, listening, writing and speaking in exam style, with a timer and answers. Not official exam material."
>
  <ExamShell
    bild="telc"
    header="CELI"
    title="CELI"
    titleKey="telc.title"
    lead="The CELI certificates of the Università per Stranieri di Perugia, one exam per level. Here you can practise in their style at A2 and B1."
    leadKey="telc.lead"
    badges={["A2–B1"]}
    practiceHeading="Practise for the CELI"
    practiceHeadingKey="telc.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="telc.who.title">Who is the CELI for?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="telc.who.badge.level">One exam per level</span>
          <span class="exam-meta-badge" data-i18n="telc.who.badge.modular">Four skills</span>
        </div>
        <p data-i18n="telc.who.text">
          Each CELI level is a separate exam with its own name: CELI 1 is A2, CELI 2 is B1, CELI 3 is
          B2 and CELI 4 is C1, with CELI Impatto (A1) below and CELI 5 (C2) above; this numbering is to verify. People use it for study, for work
          and, at the level required, as the language proof for citizenship or the long-term residence
          permit. Check what your office or university asks for before you book.
        </p>
        <p><a class="plan-link" href="/exams/dele-or-siele" data-i18n="testdaf.whichExam">CILS, CELI, PLIDA or CERT.IT? Compare them by purpose →</a></p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Skills tested</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Reading</h4><p data-i18n="skill.lesen.desc">Reading comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Listening</h4><p data-i18n="skill.hoeren.desc">Listening comprehension</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Writing</h4><p data-i18n="skill.schreiben.desc">Written expression</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Speaking</h4><p data-i18n="skill.sprechen.oralDesc">Spoken expression</p></div>
        </div>
        <p class="format-note" data-i18n="telc.sprachbausteine.note">
          At the higher levels the written exam also tests grammar and vocabulary in context. Check the
          exact parts for your level on the website of the Università per Stranieri di Perugia (CVCL).
        </p>
      </section>

      {formate.map((f) => <ExamFormat format={f} />)}

      <section class="exam-section">
        <h2 data-i18n="telc.moreLevels.title">How this differs from the real exam</h2>
        <p class="format-note" data-i18n="telc.moreLevels.text">
          Our sets follow the general shape of the CELI levels, but every text and task is our own, and
          our timings and marks are a guide, not the official ones. The Università per Stranieri di
          Perugia publishes the current format and sample papers; we do not copy them. Check the details
          there before you book.
        </p>
      </section>
    </Fragment>

    <SatzListe exam="telc" />

    <div class="mock-cta">
      <h2 data-i18n="telc.sb.title">Practise language use</h2>
      <p data-i18n="telc.sb.text">
        More gap-fill practice with grammar and vocabulary in context (strutture di comunicazione),
        useful for the language-use tasks of the written exams.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/dele/language-use" data-i18n="telc.sb.cta">To the language-use trainer</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="fallen.title">Exam traps</h2>
      <p data-i18n="fallen.entry.blurb">Spots with a catch – briefly explained, with an example and a task to try.</p>
      <a class="quiz-btn quiz-btn--primary" href="/exams/traps" data-i18n="fallen.entry.cta">See the traps</a>
    </div>

    <div class="mock-cta">
      <h2 data-i18n="telc.a1.title">More at A1: our Italian A1 practice test</h2>
      <p data-i18n="telc.a1.text">
        Our own A1 practice test in the style of the A1 exams, for learners not yet at A2. It is marked
        against a 60 % pass line, which is our own convention, not an official mark.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/dele/a1" data-i18n="exam.startSet">Start the practice set</a>
    </div>

    <ExamPractice
      heading="Train the basics"
      headingKey="exam.practice.heading"
      intro="These tools help at every level and for every exam. They train articles, grammar and vocabulary in general, not CELI-specific task types."
      introKey="telc.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>
