---
// /lesson — a Stunde of the Stundenplan for a learner alone: step by step through the
// site's own pages, with the session bar in its learner mode. Logic in
// src/lib/unterricht/lernseite.js; the plan is rebuilt from the URL like the teacher's.
//   /lesson?niveau=a1-1&block=1[&stunden=3&stunde=1&min=90]
// Tier 1 (docs/schueler-stunde-tier1-v1.md): saved on this device only. Bare /lesson (Üben →
// „Meine Stunde“) goes on to the next Stunde. English only (lang="en"), like the teacher's lesson.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SectionMascot from "../components/mascots/SectionMascot.astro";
import { unterrichtDaten } from "../lib/unterricht/seitenDaten.js";
import texteRoh from "../data/lernstunde-texte.json";
import "../styles/unterricht.css";
import "../styles/lernstunde.css";

const { levels, bilder, themen, wortfelder } = unterrichtDaten();
// Learner texts: in production only reviewed ones ("geprueft": true); in development the
// drafts too, marked „Entwurf“ on the page, so they can be read in place.
const texte = Object.fromEntries(Object.entries(texteRoh as Record<string, any>)
  .filter(([k, t]) => !k.startsWith("_") && (import.meta.env.DEV || t.geprueft)));
---
<Layout
  title="Your lesson – icanspeak Spanish"
  description="A Spanish lesson step by step, on your own: warm-up, words, grammar, practice, using it – at your own pace."
  noindex
>
  <SiteNav />
  <main class="ut ls" id="ls-root" lang="en">
    <section class="ls-start" data-view="start" hidden>
      <p class="ut-eyebrow" data-meta></p>
      <h1 class="ut-title" data-title>Your lesson</h1>
      <div class="ut-timeline" data-start-bar aria-hidden="true"></div>
      <div class="ls-card ls-start-card">
        <SectionMascot name="bruno" expr="happy" say="Step by step." />
        <p class="ls-start-msg" data-start-msg role="status"></p>
        <ol class="ls-start-steps" data-start-steps></ol>
        <div class="ls-btns">
          <button type="button" class="lp-btn lp-btn--primary" data-start-go>Let’s go</button>
          <button type="button" class="lp-btn lp-btn--outline" data-start-fresh hidden>Start again</button>
        </div>
        <p class="ut-muted">You can stop at any time: the lesson stays saved on this device, so you can carry on later.</p>
      </div>
    </section>

    <section class="ut-stage ls-stage" data-view="stage" hidden>
      <p class="ut-eyebrow" data-stage-meta></p>
      <div class="ut-timeline ut-timeline--nav" data-stage-bar></div>
      <article class="ut-card" data-card aria-live="polite"></article>
    </section>

    <section class="ls-card ls-done" data-view="done" hidden>
      <SectionMascot name="bruno" expr="celebrate" say="You did it!" />
      <h1 class="ut-title">Lesson complete</h1>
      <p>Time taken: <b data-done-time></b></p>
      <table class="ut-done-table">
        <thead><tr><th scope="col">Step</th><th scope="col">Status</th></tr></thead>
        <tbody data-done-rows></tbody>
      </table>
      <div class="ls-btns"><a class="lp-btn lp-btn--primary" data-done-next href="/progress">On to the next lesson</a></div>
    </section>

    <section class="ls-card" data-view="missing" hidden>
      <h1 class="ut-title">This lesson does not exist</h1>
      <p>The link does not match any lesson in the course plan.</p>
      <a class="lp-btn lp-btn--primary" href="/progress">Go to your progress</a>
    </section>
  </main>
  <script type="application/json" id="ls-data" set:html={JSON.stringify({ levels, bilder, themen, wortfelder, texte })}></script>

  <script>
    import { mountLernstunde } from "../lib/unterricht/lernseite.js";
    const root = document.getElementById("ls-root");
    const data = JSON.parse(document.getElementById("ls-data")!.textContent!);
    if (root) mountLernstunde(root, data);
  </script>
</Layout>
