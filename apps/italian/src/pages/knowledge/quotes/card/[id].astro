---
// /knowledge/quotes/card/<id> — one quote card as a bare HTML fragment (no layout), fetched by
// the hub /knowledge/quotes for today's quote and for ‹ ›. Not for people or search engines:
// the full page for a quote is /knowledge/quotes/<id>.
import ZitatCard from "../../../../components/zitate/ZitatCard.astro";
import { quotes } from "../../../../lib/zitateData.js";

export const partial = true;
export function getStaticPaths() {
  return quotes.map((q: any) => ({ params: { id: q.id }, props: { q } }));
}
const { q } = Astro.props;
---
<ZitatCard q={q} />
<p class="zt-more"><a href={`/knowledge/quotes/${q.id}`} data-i18n="zitate.card.ownPage">This quote’s own page</a></p>
