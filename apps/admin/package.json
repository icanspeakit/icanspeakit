{
  "name": "@icanspeak/admin",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "collect": "node scripts/collect.mjs",
    "dev": "node scripts/collect.mjs && astro dev --port 4330",
    "build": "node scripts/collect.mjs && astro build",
    "cf:prepare": "node scripts/cf-prepare.mjs",
    "preview": "pnpm build && pnpm cf:prepare && wrangler dev",
    "deploy": "pnpm build && pnpm cf:prepare && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": { "astro": "^7.4.2" },
  "devDependencies": { "wrangler": "^4.157.0" }
}
