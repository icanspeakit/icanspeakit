---
// /intern: Edgar's ops board. Static; the numbers come from scripts/collect.mjs at build time,
// the reminders from src/data/todos.json. Locked by Cloudflare Access, plus noindex.
import Admin from "../layouts/Admin.astro";
import status from "../data/status.json";
import { todos } from "../data/todos.json";

const today = new Date().toISOString().slice(0, 10);
const open = todos.filter((t) => !t.done).sort((a, b) => a.due.localeCompare(b.due));
const days = (d: string) => Math.round((Date.parse(d) - Date.parse(today)) / 86400000);
const when = (d: string) => { const n = days(d); return n < 0 ? `${-n} day${n === -1 ? "" : "s"} overdue` : n === 0 ? "due today" : `in ${n} day${n === 1 ? "" : "s"}`; };
const state = (d: string) => (days(d) < 0 ? "late" : days(d) <= 3 ? "soon" : "ok");
const pct = (c: any) => (c.words ? Math.min(100, Math.round(((c.audio.wortschatz ?? 0) / c.words) * 100)) : 0);

const links = [
  ["Cloudflare dashboard", "https://dash.cloudflare.com/"],
  ["PostHog (EU)", "https://eu.posthog.com/"],
  ["Live site", "https://icanspeak.it/"],
  ["DEPLOY.md", "https://github.com/"],
];
---
<Admin active="" title="Cockpit" sub={`Built ${status.generated.slice(0, 16).replace("T", " ")} UTC · numbers are read from the repo at deploy time · redeploy to refresh`}>
<style is:global>
      .todo { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--isk-line); }
      .todo:first-of-type { border-top: 0; padding-top: 0; }
      .todo b { color: var(--isk-navy); } .todo p { margin: 2px 0 0; color: var(--isk-muted); font-size: .92rem; }
</style>

      <section class="card">
        <h2>Reminders {open.length ? `(${open.length})` : ""}</h2>
        {open.length === 0 && <p class="none">Nothing open.</p>}
        {open.map((t) => (
          <div class="todo">
            <span class={`pill ${state(t.due)}`}>{when(t.due)}</span>
            <div><b>{t.title}</b> <span class="none">· {t.due}{t.course ? ` · ${t.course}` : ""}</span>{t.detail && <p>{t.detail}</p>}</div>
          </div>
        ))}
      </section>

      <section class="card">
        <h2>Audio and content by course</h2>
        <div class="scroll">
        <table>
          <thead><tr><th>Course</th><th class="n">Words</th><th class="n">Audio files</th><th>Vocab voiced</th><th>Audio folders (files)</th><th>Pages that expect audio but have none</th></tr></thead>
          <tbody>
            {status.courses.map((c) => (
              <tr>
                <td><a href={`https://icanspeak.it${c.path}`}><b>{c.name}</b></a><br /><span class="none">{c.lastDate}</span></td>
                <td class="n">{c.words.toLocaleString("en")}</td>
                <td class="n">{c.audioTotal.toLocaleString("en")}</td>
                <td><div class="bar" title={`${pct(c)}%`}><i style={`width:${pct(c)}%`}></i></div>{pct(c)}%</td>
                <td>{Object.keys(c.audio).length ? Object.entries(c.audio).map(([k, v]) => `${k} ${v}`).join(" · ") : <span class="none">none</span>}</td>
                <td>{c.missing.length ? <div class="miss">{c.missing.map((m) => <code>{m}</code>)}</div> : <span class="none">none</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </section>

      <section class="card">
        <h2>Links</h2>
        <div class="links">{links.map(([n, h]) => <a href={h} rel="noopener">{n}</a>)}</div>
      </section>
    </Admin>
