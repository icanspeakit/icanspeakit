---
// /intern: Edgar's ops board. Static; the numbers come from scripts/collect.mjs at build time,
// the reminders from src/data/todos.json. Locked by Cloudflare Access, plus noindex.
import "../styles/tokens.css";
import status from "../data/status.json";
import { todos } from "../data/todos.json";

const today = new Date().toISOString().slice(0, 10);
const open = todos.filter((t) => !t.done).sort((a, b) => a.due.localeCompare(b.due));
const days = (d: string) => Math.round((Date.parse(d) - Date.parse(today)) / 86400000);
const when = (d: string) => { const n = days(d); return n < 0 ? `${-n} day${n === -1 ? "" : "s"} overdue` : n === 0 ? "due today" : `in ${n} day${n === 1 ? "" : "s"}`; };
const state = (d: string) => (days(d) < 0 ? "late" : days(d) <= 3 ? "soon" : "ok");
const pct = (c: any) => (c.words ? Math.min(100, Math.round(((c.audio.wortschatz ?? 0) / c.words) * 100)) : 0);

const links = [
  ["Cloudflare dashboard", "https://dash.cloudflare.com/"],
  ["PostHog (EU)", "https://eu.posthog.com/"],
  ["Live site", "https://icanspeak.it/"],
  ["DEPLOY.md", "https://github.com/"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <title>Ops board</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />
    <style is:global>
      body { margin: 0; background: var(--isk-cream); color: var(--isk-text); font-family: var(--isk-font-body); line-height: 1.5; }
      main { max-width: 1040px; margin: 0 auto; padding: 32px 16px 64px; }
      h1, h2 { font-family: var(--isk-font-display); font-weight: 900; color: var(--isk-navy); margin: 0; }
      h1 { font-size: 2rem; } h2 { font-size: 1.25rem; margin-bottom: 12px; }
      .sub { color: var(--isk-muted); margin: 4px 0 28px; }
      .card { background: var(--isk-white); border: 1px solid var(--isk-line); border-radius: var(--isk-radius-card); padding: 20px; margin-bottom: 20px; }
      .todo { display: flex; gap: 12px; padding: 12px 0; border-top: 1px solid var(--isk-line); }
      .todo:first-of-type { border-top: 0; padding-top: 0; }
      .pill { flex: none; align-self: flex-start; font-size: .8rem; font-weight: 700; padding: 2px 10px; border-radius: var(--isk-radius-pill); background: var(--isk-green-soft); color: var(--isk-navy); }
      .pill.soon { background: var(--isk-yellow-soft); } .pill.late { background: var(--isk-coral-soft); }
      .todo b { color: var(--isk-navy); } .todo p { margin: 2px 0 0; color: var(--isk-muted); font-size: .92rem; }
      table { width: 100%; border-collapse: collapse; font-size: .92rem; }
      th, td { text-align: left; padding: 8px 10px; border-top: 1px solid var(--isk-line); vertical-align: top; }
      th { color: var(--isk-muted); font-weight: 600; border-top: 0; }
      td.n { font-variant-numeric: tabular-nums; text-align: right; } th.n { text-align: right; }
      .bar { height: 8px; border-radius: 4px; background: var(--isk-line); overflow: hidden; min-width: 80px; }
      .bar > i { display: block; height: 100%; background: var(--isk-green); }
      .miss { display: flex; flex-wrap: wrap; gap: 4px; }
      .miss code { background: var(--isk-coral-soft); color: var(--isk-navy); padding: 0 6px; border-radius: 6px; font-size: .8rem; }
      .none { color: var(--isk-muted); font-style: italic; }
      .links { display: flex; flex-wrap: wrap; gap: 8px; }
      .links a { color: var(--isk-navy); font-weight: 600; border: 1px solid var(--isk-line); border-radius: var(--isk-radius-pill); padding: 4px 14px; text-decoration: none; background: var(--isk-white); }
      .links a:hover { background: var(--isk-yellow-soft); }
      .scroll { overflow-x: auto; }
    </style>
  </head>
  <body>
    <main>
      <h1>Ops board</h1>
      <p class="sub">Built {status.generated.slice(0, 16).replace("T", " ")} UTC · numbers are read from the repo at deploy time · redeploy to refresh</p>

      <section class="card">
        <h2>Reminders {open.length ? `(${open.length})` : ""}</h2>
        {open.length === 0 && <p class="none">Nothing open.</p>}
        {open.map((t) => (
          <div class="todo">
            <span class={`pill ${state(t.due)}`}>{when(t.due)}</span>
            <div><b>{t.title}</b> <span class="none">· {t.due}{t.course ? ` · ${t.course}` : ""}</span>{t.detail && <p>{t.detail}</p>}</div>
          </div>
        ))}
      </section>

      <section class="card">
        <h2>Audio and content by course</h2>
        <div class="scroll">
        <table>
          <thead><tr><th>Course</th><th class="n">Words</th><th class="n">Audio files</th><th>Vocab voiced</th><th>Audio folders (files)</th><th>Pages that expect audio but have none</th></tr></thead>
          <tbody>
            {status.courses.map((c) => (
              <tr>
                <td><a href={`https://icanspeak.it${c.path}`}><b>{c.name}</b></a><br /><span class="none">{c.lastDate}</span></td>
                <td class="n">{c.words.toLocaleString("en")}</td>
                <td class="n">{c.audioTotal.toLocaleString("en")}</td>
                <td><div class="bar" title={`${pct(c)}%`}><i style={`width:${pct(c)}%`}></i></div>{pct(c)}%</td>
                <td>{Object.keys(c.audio).length ? Object.entries(c.audio).map(([k, v]) => `${k} ${v}`).join(" · ") : <span class="none">none</span>}</td>
                <td>{c.missing.length ? <div class="miss">{c.missing.map((m) => <code>{m}</code>)}</div> : <span class="none">none</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </section>

      <section class="card">
        <h2>Links</h2>
        <div class="links">{links.map(([n, h]) => <a href={h} rel="noopener">{n}</a>)}</div>
      </section>
    </main>
  </body>
</html>
