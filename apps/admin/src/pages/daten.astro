const links = [["Cloudflare dashboard", "https://dash.cloudflare.com/"], ["Cloudflare Zero Trust (Access)", "https://one.dash.cloudflare.com/"], ["PostHog (EU)", "https://eu.posthog.com/"], ["Live site", "https://icanspeak.it/"]];
