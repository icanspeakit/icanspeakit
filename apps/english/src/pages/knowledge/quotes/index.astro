---
// /knowledge/quotes — Zitat des Tages: one famous German sentence a day, the three words a
// learner needs for it and a short life of the person who said it. Below, all 365 quotes
// by person, each linking to its own page (/knowledge/quotes/<id>).
//
// The site is static, so "today" is picked in the browser (src/lib/zitate.js: every calendar
// day has a fixed quote, the same one the Monday mail counts with) and its card is fetched
// as a small fragment from /knowledge/quotes/card/<id>. Rendering all 365 cards here made the
// page 1.8 MB. ‹ › fetch the neighbouring days the same way.
//
// The quotes live in src/data/zitate.json: documented wording and sources only (each has a
// `check` URL), by authors who died before 1956. Linked from the Wissen menu (navZitate).
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import ZitatAbo from "../../../components/zitate/ZitatAbo.astro";
import { quotes, authors, lastName, oneLine } from "../../../lib/zitateData.js";
import "../../../styles/practice.css";
import "../../../styles/teacher-switch.css";
import "../../../styles/zitate.css";

const byAuthor = Object.entries(authors as Record<string, any>)
  .map(([id, a]) => ({ id, ...a, quotes: quotes.filter((q: any) => q.author === id) }))
  .filter((a) => a.quotes.length)
  .sort((a, b) => lastName(a.name).localeCompare(lastName(b.name), "de"));
// Quote ids in calendar order, for the script: index = day of the year (src/lib/zitate.js).
const ids = quotes.map((q: any) => q.id);
---
<Layout
  title="Quote of the day – famous quotes in English with key words and a short biography – icanspeak English"
  description={`A famous quote in English every day, from writers, scientists and thinkers – with the key words, a simple explanation and the person's life. ${quotes.length} quotes from ${byAuthor.length} people, free.`}
>
  <SiteNav active="wissen" />
  <main class="practice-main practice-main--wide zt-page">
    <header class="practice-hero zt-hero">
      <p class="eyebrow" data-i18n="zitate.eyebrow">Quotes</p>
      <h1 data-i18n="zitate.title">Quote of the day</h1>
      <p class="zt-lead" data-i18n="zitate.lead">A famous sentence in English every day – with the words you need for it and the person behind it.</p>
    </header>

    <section class="zt-day" aria-label="Quote of the day" data-i18n-attr="aria-label:zitate.title" data-day data-ids={JSON.stringify(ids)}>
      <div class="zt-nav">
        <button type="button" class="zt-step" data-step="-1" aria-label="Previous day’s quote" data-i18n-attr="aria-label:zitate.day.prevAria">‹</button>
        <p class="zt-date" data-date aria-live="polite">Today</p>
        <button type="button" class="zt-step" data-step="1" aria-label="Next day’s quote" data-i18n-attr="aria-label:zitate.day.nextAria">›</button>
      </div>
      <div data-slot>
        <p class="zt-loading" data-i18n="zitate.day.loading">Loading the quote …</p>
        <noscript><p class="zt-loading" data-i18n="zitate.day.noscript">You’ll find all quotes below.</p></noscript>
      </div>
    </section>

    <ZitatAbo />

    <section class="zt-all" aria-labelledby="zt-all-h">
      <h2 id="zt-all-h" data-i18n="zitate.all.title" data-i18n-vars={JSON.stringify({ n: quotes.length })}>All {quotes.length} quotes</h2>
      <p class="zt-all-lead" data-i18n="zitate.all.lead" data-i18n-vars={JSON.stringify({ n: byAuthor.length })}>From {byAuthor.length} people. Tap a name, then a quote.</p>
      <div class="zt-groups">
        {byAuthor.map((a) => (
          <details class="zt-group">
            <summary><h3 lang="de">{a.name} <small>{a.years}</small></h3><span class="zt-n">{a.quotes.length}</span></summary>
            <ul>
              {a.quotes.map((q: any) => (
                <li><a href={`/knowledge/quotes/${q.id}`} lang="de">„{oneLine(q.text)}“</a> <span class="zt-lv">{q.level}</span></li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>
  </main>
</Layout>

<script>
import { withBase, BASE_PATH } from "../../../lib/paths.js";
  import { getLang } from "../../../lib/i18n.js";
  import { t, i18nAttrs, onUiText } from "../../../lib/uiText.js";
  import { localYmd, addDays, indexFor } from "../../../lib/zitate.js";
  import { fillTr, initCards } from "../../../lib/zitateClient.js";

  const day = document.querySelector<HTMLElement>("[data-day]")!;
  const slot = day.querySelector<HTMLElement>("[data-slot]")!;
  const dateEl = day.querySelector<HTMLElement>("[data-date]")!;
  const ids: string[] = JSON.parse(day.dataset.ids!);
  const today = localYmd();
  const cache = new Map<string, Promise<string>>();
  let offset = 0;

  const idFor = (off: number) => ids[indexFor(addDays(today, off), ids.length)];
  const card = (id: string) => {
    if (!cache.has(id)) cache.set(id, fetch(withBase(`/knowledge/quotes/card/${id}`)).then((r) => (r.ok ? r.text() : Promise.reject(r.status))));
    return cache.get(id)!;
  };

  function label(off: number) {
    if (off === 0) return t("dash.date.today", "Today");
    if (off === -1) return t("dash.date.yesterday", "Yesterday");
    if (off === 1) return t("zitate.day.tomorrow", "Tomorrow");
    const lang = getLang();
    const locale = lang === "de" ? "de-DE" : lang === "pt" ? "pt-BR" : lang;
    return new Date(`${addDays(today, off)}T12:00:00`).toLocaleDateString(locale, { weekday: "long", day: "numeric", month: "long" });
  }

  async function show(off: number) {
    offset = off;
    dateEl.textContent = label(off);
    const id = idFor(off);
    try {
      const html = await card(id);
      if (offset !== off) return; // a later click won
      slot.innerHTML = html;
      initCards(slot);
    } catch {
      slot.innerHTML = `<p class="zt-loading"><span${i18nAttrs("kaufen.start.failed.title")}>${t("kaufen.start.failed.title", "That didn’t work.")}</span> <a href="${BASE_PATH}/knowledge/quotes/${id}"${i18nAttrs("zitate.day.toQuote")}>${t("zitate.day.toQuote", "Go to the quote")}</a></p>`;
    }
    // The next day in the background, so › is instant.
    card(idFor(off + 1)).catch(() => {});
  }

  day.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
    b.addEventListener("click", () => show(offset + Number(b.dataset.step))),
  );
  show(0);
  onUiText(() => {
    dateEl.textContent = label(offset);
    fillTr(slot);
  });
</script>
