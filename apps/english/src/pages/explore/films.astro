---
// /explore/films: the ten best things on the site, each as its „So funktioniert's" film. A
// card under „Entdecken" (catalog.js navEntdecken) for everyone, and the second Vorschau beside
// the dock's „▶ Vorschau" (DemoDock.astro): one page to scroll instead of ten to click through –
// the film, what it is, three steps, a way to the page. Was /intern/filme (redirect in
// astro.config.mjs).
//
// The ten and their titles come from the Vorschau's own list (src/lib/vorschau.js STEPS), so
// both stay the same ten. Each film is a MascotGuide sim (src/components/sims/): a 12 s loop in
// three scenes that light up the three steps beside it. Umfragen and Stundenplan use the films
// their pages already show; the other eight were made for this page and can go on their pages
// the same way.
//
// The crew shares the films – Bruno three, Regi three, Hamsti and Quaki two each – and every
// film gives its mascot its own prop (mascots.js PROPS: whistle, magnifier, stopwatch,
// megaphone …), so no two films look alike.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import MascotGuide from "../../components/mascots/MascotGuide.astro";
import EinfachSim from "../../components/sims/EinfachSim.astro";
import GrammatikSim from "../../components/sims/GrammatikSim.astro";
import WortschatzSim from "../../components/sims/WortschatzSim.astro";
import AusspracheSim from "../../components/sims/AusspracheSim.astro";
import PruefungSim from "../../components/sims/PruefungSim.astro";
import FortschrittSim from "../../components/sims/FortschrittSim.astro";
import LiveQuizSim from "../../components/sims/LiveQuizSim.astro";
import StundenplanSim from "../../components/sims/StundenplanSim.astro";
import UmfrageSim from "../../components/sims/UmfrageSim.astro";
import ArbeitsblattSim from "../../components/sims/ArbeitsblattSim.astro";
import { STEPS } from "../../lib/vorschau.js";

// Per Vorschau step (by its page): the film and the three steps it plays through.
type Extra = "pfeife" | "stoppuhr" | "megafon" | "pokal" | "ballon" | "zeigestock" | "bleistift" | "lupe" | "mikrofon" | "karten";
const FILME: Record<string, { sim: any; mascot?: "bruno" | "regi" | "hamsti" | "quaki"; extra?: Extra; expr?: "happy" | "thinking" | "celebrate"; steps: [string, string, string] }> = {
  "/step-by-step": {
    sim: EinfachSim,
    extra: "ballon",
    steps: [
      "One step per screen, one big button – Bruno tells you what comes next.",
      "Look at the picture and tap one of three answers: green means right, otherwise Bruno shows the answer.",
      "Step by step the path fills up; at the end you get a star.",
    ],
  },
  "/two-objects": {
    sim: GrammatikSim,
    mascot: "regi",
    extra: "lupe",
    steps: [
      "The rule in a few lines, with a table and colours.",
      "Fill a gap in the exercise. Wrong? The explanation comes at once, for exactly that mistake.",
      "Correct it, see green, move on: the bar shows how much of the topic you have done.",
    ],
  },
  "/vocabulary/a1-04": {
    sim: WortschatzSim,
    mascot: "hamsti",
    extra: "karten",
    steps: [
      "Tap a card with a picture and sound: it turns over and shows the English word.",
      "Choose your own language at the top – Spanish, Arabic, Ukrainian and many more.",
      "Knew it or not: the card comes back just when you are about to forget it.",
    ],
  },
  "/pronunciation-check": {
    sim: AusspracheSim,
    mascot: "quaki",
    extra: "mikrofon",
    steps: [
      "Tap the microphone and say the sentence – right in the browser, no app.",
      "Every word gets a score: green sounds good, yellow not quite yet.",
      "Tap the yellow word, listen, say it again – until it turns green.",
    ],
  },
  "/exams": {
    sim: PruefungSim,
    mascot: "regi",
    extra: "stoppuhr",
    steps: [
      "Choose an exam and a part: reading, listening, writing or speaking – Cambridge, IELTS and Trinity.",
      "Tasks in the real format, with a timer like in the exam.",
      "At the end, your score: points for each part and whether it is enough to pass.",
    ],
  },
  "/progress": {
    sim: FortschrittSim,
    mascot: "hamsti",
    extra: "pokal",
    expr: "celebrate",
    steps: [
      "Every day you practise counts towards your streak.",
      "For each topic you see how far you are – from real answers, not a guess.",
      "Your most common mistakes are in a list. Tap one and it becomes your next exercise.",
    ],
  },
  "/teachers/quiz": {
    sim: LiveQuizSim,
    extra: "pfeife",
    steps: [
      "Show the code on the projector: the class joins on their phones, no account.",
      "The question on the projector, the answers on the phones – four colours, against the clock.",
      "After the last question, the winners' podium.",
    ],
  },
  "/teachers/timetable": {
    sim: StundenplanSim,
    extra: "zeigestock",
    steps: [
      "Choose the level, topic block and number of lessons.",
      "The plan is ready at once: every lesson in stages, with timings, steps and matching exercises.",
      "“Start the lesson” shows it step by step on the projector, with a timer for each stage.",
    ],
  },
  "/teachers/surveys": {
    sim: UmfrageSim,
    mascot: "quaki",
    extra: "megafon",
    steps: [
      "Choose the level and the questions and create the poll.",
      "Show the QR code on the projector: the class answers on their phones, anonymously.",
      "The results come in live; tap “Close” when everyone has finished.",
    ],
  },
  "/teachers/worksheets": {
    sim: ArbeitsblattSim,
    mascot: "regi",
    extra: "bleistift",
    steps: [
      "Choose a worksheet for a grammar topic.",
      "Look at the preview and tap Print – or save it as a PDF.",
      "Ready on paper, plus games for the group.",
    ],
  },
};
const filme = STEPS.map((s, i) => ({ ...s, n: i + 1, ...FILME[s.href] })).filter((f) => f.sim);
---
<Layout title="How it works: ten short films – icanspeak English" description="The ten best features of icanspeak English, each as a 15-second film in three steps: Step by step, grammar, vocabulary, pronunciation, exams, live quiz and more.">
  <SiteNav active="entdecken" />
  <main class="fi" lang="en">
    <header class="fi-head">
      <p class="fi-eyebrow"><a href="/explore" data-i18n="nav.entdecken">Explore</a></p>
      <h1 data-i18n="fi.title">How it works: ten short films</h1>
      <p class="fi-lead" data-i18n="fi.lead">Each film lasts 15 seconds, plays in three steps and then starts again. “Go to the page” opens the feature itself.</p>
      <nav class="fi-toc" aria-label="Contents" data-i18n-attr="aria-label:fi.toc">
        {filme.map((f) => <a href={`#film-${f.n}`}><span>{f.n}</span>{f.title}</a>)}
      </nav>
    </header>

    {filme.map((f) => {
      const Sim = f.sim;
      return (
        <section class="fi-film" id={`film-${f.n}`} aria-labelledby={`film-${f.n}-h`}>
          <div class="fi-film-head">
            <span class="fi-n" aria-hidden="true">{f.n}</span>
            <div>
              <h2 id={`film-${f.n}-h`}>{f.title}</h2>
              <p>{f.pitch}</p>
            </div>
            <a class="fi-go" href={f.href}><span data-i18n="fi.go">Go to the page</span><svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M8 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          </div>
          <MascotGuide id={`film-${f.n}`} title="So funktioniert’s" titleKey="uf.t.guide.title" name={f.mascot ?? "bruno"} extra={f.extra} expr={f.expr} once>
            <Sim slot="sim" />
            {f.steps.map((s) => <li>{s}</li>)}
          </MascotGuide>
        </section>
      );
    })}
  </main>
</Layout>

<style>
  .fi { max-width: 880px; margin: 0 auto; padding: 24px 16px 96px; }
  .fi-head { margin-bottom: 28px; }
  .fi-eyebrow a { color: inherit; text-decoration: none; }
  .fi-eyebrow a:hover { text-decoration: underline; }
  .fi-eyebrow { margin: 0 0 6px; font-family: var(--font-label); font-size: .75rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--brand-blue-dark); }
  .fi-head h1 { margin: 0 0 8px; font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.15; }
  .fi-lead { margin: 0 0 16px; color: var(--muted); }
  /* A table of contents, not a cloud of pills: two columns read top to bottom (1–5, 6–10),
     every number in the same place, so the list scans like the chapters of a book. */
  .fi-toc {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(5, auto); grid-auto-flow: column; gap: 2px 16px;
    padding: 8px; border: 1px solid var(--border); border-radius: var(--radius-lg, 16px);
    background: var(--surface-card);
  }
  .fi-toc a {
    display: flex; align-items: center; gap: 10px; min-height: 44px; padding: 6px 8px;
    border-radius: var(--radius, 10px);
    color: var(--ink); font-size: .9rem; font-weight: 600; line-height: 1.25; text-decoration: none;
  }
  .fi-toc a:hover { background: var(--blue-50); }
  .fi-toc span {
    flex: 0 0 26px; height: 26px; display: grid; place-items: center; border-radius: 50%;
    background: var(--blue-50); color: var(--brand-blue-dark); font-size: .8rem; font-variant-numeric: tabular-nums;
  }
  @media (max-width: 560px) {
    .fi-toc { gap: 0 8px; padding: 6px; }
    .fi-toc a { gap: 8px; padding: 6px 4px; font-size: .8125rem; }
    .fi-toc span { flex-basis: 22px; height: 22px; font-size: .72rem; }
  }
  .fi-film { margin: 0 0 36px; scroll-margin-top: 90px; }
  .fi-film-head { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 12px; }
  .fi-film-head > div { flex: 1 1 auto; min-width: 0; }
  .fi-film-head h2 { margin: 2px 0 4px; font-size: 1.25rem; }
  .fi-film-head p { margin: 0; color: var(--muted); line-height: 1.45; }
  .fi-n {
    flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 36px; border-radius: 50%; background: var(--brand-blue); color: #fff; font-weight: 700;
  }
  /* The way into the real thing, so it is the one filled button in each section. */
  .fi-go {
    flex: none; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 16px 0 20px;
    border: 0; border-radius: 999px; background: var(--brand-blue);
    color: #fff; font-size: .95rem; font-weight: 700; text-decoration: none; white-space: nowrap;
    box-shadow: 0 4px 12px color-mix(in srgb, var(--brand-blue) 30%, transparent);
    transition: background .15s ease, transform .15s ease;
  }
  .fi-go svg { transition: transform .15s ease; }
  .fi-go:hover { background: var(--brand-blue-dark); }
  .fi-go:hover svg { transform: translateX(2px); }
  .fi-go:focus-visible, .fi-toc a:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  @media (max-width: 560px) {
    .fi-film-head { flex-wrap: wrap; }
    .fi-film-head > div { flex-basis: calc(100% - 50px); }
    .fi-go { margin-inline-start: 50px; }
  }
</style>
