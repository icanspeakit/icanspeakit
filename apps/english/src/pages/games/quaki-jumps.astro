---
// /games/quaki-jumps — Quaki springt: der Sprachturm von A1 bis C1. Halten lädt den Sprung,
// ← / → (oder links/Mitte/rechts tippen) zielt, Loslassen springt. Vor jeder Lücke ein Schild mit
// einer Frage, auf den Seerosen die Antworten – die falsche sinkt. Sanft (Fahne pro Stufe) und
// Wut-Modus (keine Fahnen). Logik: src/lib/quakiSpringt/, Turm src/data/quakiSpringt/turm.json,
// Plan QUAKI-SPRINGT-TIERED-PROMPT.md. Prototyp: noindex, nicht im Menü (EXPERIMENTE.md).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { TXT } from "../../lib/quakiSpringt/main.js";
import "../../styles/artikel-sprint.css";
import "../../styles/quaki-springt.css";
---
<Layout
  title="Quaki Jumps: the language tower – icanspeak English"
  description="Quaki jumps up the language tower, from A1 to C1. Hold, aim, let go – and find the right answer on the water lilies."
  noindex
>
  <SiteNav active="ueben" />
  <main class="asp-page qs-page">
    <div class="asp qs" id="quaki-springt" data-phase="start">
      <div class="asp-hud qs-hud" data-hud hidden>
        <span class="asp-hud-item qs-lv" title={TXT.level}><b data-lv>A1</b></span>
        <span class="asp-hud-item"><span class="asp-hud-k">{TXT.height}</span> <b data-h>0 m</b></span>
        <span class="asp-hud-item"><span class="asp-hud-k">{TXT.falls}</span> <b data-falls>0</b></span>
        <span class="asp-hud-item qs-rec"><span class="asp-hud-k">{TXT.record}</span> <b data-rec>0 m</b></span>
        <span class="asp-hud-item qs-time" data-time-wrap hidden><b data-time>0:00,00</b></span>
        <span class="asp-hud-tools">
          <button type="button" class="asp-icon-btn" data-pause aria-label={TXT.pauseBtn} title={TXT.pauseBtn}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
          </button>
          <button type="button" class="asp-icon-btn" data-mute aria-pressed="false" aria-label={TXT.soundOff} title={TXT.soundOff}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
          </button>
        </span>
      </div>

      <div class="asp-stage qs-stage" data-stage tabindex="-1">
        <canvas class="asp-canvas" data-canvas role="img" aria-label={TXT.canvas}></canvas>

        <div class="qs-q" data-q hidden aria-live="polite">
          <p class="qs-q-text" lang="en" data-q-text></p>
          <p class="qs-q-rule" lang="en" data-q-rule hidden></p>
        </div>

        <div class="qs-fall" data-fall hidden aria-hidden="true">
          <span class="qs-fall-k">{TXT.quaak}</span>
          <span class="qs-fall-m" data-fall-m>0 m</span>
        </div>

        <p class="qs-toast" data-toast hidden role="status"></p>

        <div class="qs-touch" data-touch hidden aria-hidden="true">
          <span data-zone="-1">◀ {TXT.touchL}</span>
          <span data-zone="0">▲ {TXT.touchU}</span>
          <span data-zone="1">{TXT.touchR} ▶</span>
        </div>

        <section class="asp-screen" data-screen="start">
          <div class="asp-card">
            <h1 class="asp-title">{TXT.title}</h1>
            <p class="asp-lead">{TXT.lead}</p>
            <button type="button" class="asp-btn asp-btn--go" data-start-sanft>{TXT.sanft}</button>
            <p class="asp-mode-hint">{TXT.sanftHint}</p>
            <button type="button" class="asp-btn asp-btn--quiet" data-start-wut>{TXT.wut}</button>
            <p class="asp-mode-hint">{TXT.wutHint}</p>
            <details class="asp-how" open>
              <summary>{TXT.how}</summary>
              <ul>
                <li set:html={TXT.how1} />
                <li set:html={TXT.how2} />
                <li set:html={TXT.how3} />
                <li set:html={TXT.how4} />
              </ul>
            </details>
          </div>
        </section>

        <section class="asp-screen" data-screen="pause" hidden>
          <div class="asp-card asp-card--small">
            <h2 class="asp-title">{TXT.pause}</h2>
            <button type="button" class="asp-btn asp-btn--go" data-resume>{TXT.resume}</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-restart>{TXT.restart}</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-quit>{TXT.quit}</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-mute aria-pressed="false">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
              <span>{TXT.sound}</span>
            </button>
            <div data-melden></div>
          </div>
        </section>

        <section class="asp-screen" data-screen="over" hidden>
          <div class="asp-card">
            <h2 class="asp-title" data-o-title>{TXT.overTitle}</h2>
            <dl class="asp-stats">
              <div><dt>{TXT.overStats.time}</dt><dd data-o-time>0</dd></div>
              <div><dt>{TXT.overStats.falls}</dt><dd data-o-falls>0</dd></div>
              <div><dt>{TXT.overStats.longest}</dt><dd data-o-longest>0</dd></div>
              <div><dt>{TXT.overStats.answers}</dt><dd data-o-answers>0</dd></div>
              <div><dt>{TXT.overStats.height}</dt><dd data-o-height>0</dd></div>
            </dl>
            <div class="asp-missed qs-missed" data-o-missed-wrap hidden>
              <h3>{TXT.missed}</h3>
              <ul data-o-missed></ul>
            </div>
            <button type="button" class="asp-btn asp-btn--go" data-again>{TXT.again}</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-tostart>{TXT.toStart}</button>
            <div data-melden></div>
          </div>
        </section>
      </div>
    </div>
  </main>

  <script>
    import { mountQuakiSpringt } from "../../lib/quakiSpringt/main.js";
    const root = document.getElementById("quaki-springt");
    if (root) mountQuakiSpringt(root);
  </script>
</Layout>
