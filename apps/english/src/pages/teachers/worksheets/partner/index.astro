---
// Partner and group work in one place: the partner and group sheets (src/data/partneruebungen,
// live only the checked ones, on the dev server the drafts too, marked „Entwurf“) and the
// Tandembogen of every grammar topic (src/lib/partneruebungen/tandem.js). Same level chips
// and search as the library (indexFilter.js); the AbCards row links the three pages.
import TeacherNudge from "../../../../components/TeacherNudge.astro";
import { tandemPath } from "../../../../lib/routes.js";
import Layout from "../../../../layouts/Layout.astro";
import SiteNav from "../../../../components/SiteNav.astro";
import AbCards from "../../../../components/arbeitsblatt/AbCards.astro";
import "../../../../styles/arbeitsblatt.css";
import "../../../../styles/teacher-switch.css";
import { allSheets, publicSheets } from "../../../../lib/partneruebungen/index.js";
import { FORMAT_NAMES, LEVELS } from "../../../../lib/partneruebungen/schema.js";
import { skills } from "../../../../lib/partneruebungen/render.js";
import { tandemSheets } from "../../../../lib/partneruebungen/tandem.js";

const partner = import.meta.env.DEV ? allSheets() : publicSheets();
const tandems = tandemSheets().slice().sort((a, b) => a.level.localeCompare(b.level) || a.name.localeCompare(b.name, "de"));
const levels = LEVELS.filter((l) => partner.some((s) => s.niveau === l) || tandems.some((t) => t.level === l));
---
<Layout
  title="Pair and group work: worksheets – icanspeak English"
  description="Worksheets for pair and group work in the English class: cards for A and B with tips and answers, and a tandem sheet for every grammar topic. Free to print."
>
  <SiteNav active="lehrkraefte" />

  <main class="abi" id="abi-root" data-level="A1">
    <header class="abi-head">
      <p class="abi-eyebrow" data-i18n="ab.index.eyebrow">Für Lehrkräfte</p>
      <h1 class="abi-title" data-i18n="ab.pg.title">Partner- und Gruppenarbeit</h1>
      <p class="abi-lead" data-i18n="ab.pg.lead">Blätter, bei denen zwei oder mehr zusammen sprechen: Karten für A und B mit Tipps und Lösungen – und zu jedem Grammatik-Thema ein Tandembogen, bei dem sich die Partner gegenseitig kontrollieren.</p>
    </header>
    <TeacherNudge />

    <AbCards current="partner" />

    <div class="abi-controls">
      <div class="abi-levels t-sw t-sw--fill" role="group" aria-label="Niveau" data-i18n-attr="aria-label:ab.index.level">
        {levels.map((l, i) => <button type="button" data-abi-level={l} aria-pressed={i === 0 ? "true" : "false"}>{l}</button>)}
      </div>
      <input class="abi-search" type="search" placeholder="Suchen …" data-abi-search aria-label="Arbeitsblätter durchsuchen" data-i18n-attr="placeholder:ab.index.search;aria-label:ab.index.searchLabel" />
    </div>

    {partner.length > 0 && (
      <section class="abi-sec">
        <h2 class="abi-h"><span data-i18n="ab.partner.section">Partner- & Gruppenübungen</span> <small data-abi-count></small></h2>
        <ul class="abi-list abi-list--partner">
          {partner.map((s) => (
            <li data-abi-row data-level={s.niveau} data-q={`${s.titel} ${s.thema} ${s.grammatik.join(" ")} ${FORMAT_NAMES[s.format]}`.toLowerCase()}>
              <a href={`/teachers/worksheets/partner/${s.id}`}>
                <span class="abi-badge">{s.niveau}</span>
                <span class="abi-name">{s.titel}{!s.quelle.geprueft && <span class="pu-draft-tag" data-i18n="ab.partner.draftShort">Entwurf</span>}<small class="abi-sub">{FORMAT_NAMES[s.format]} · {skills(s).join(", ")}</small></span>
                <span class="abi-meta">
                  {s.modus === "gruppe"
                    ? <span data-i18n="ab.partner.group" data-i18n-vars={JSON.stringify({ n: s.personen })}>Gruppe ({s.personen})</span>
                    : <span data-i18n="ab.partner.pair">Paar</span>}
                  {" · "}<span data-i18n="ab.partner.minutes" data-i18n-vars={JSON.stringify({ n: s.dauerMin })}>{s.dauerMin} Min.</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="abi-sec" id="tandem">
      <h2 class="abi-h"><span data-i18n="ab.pg.tandem">Tandembögen zur Grammatik</span> <small data-abi-count></small></h2>
      <ul class="abi-list">
        {tandems.map((t) => (
          <li data-abi-row data-level={t.level} data-q={`${t.name} tandem grammatik`.toLowerCase()}>
            <a href={tandemPath(t.slug)}>
              <span class="abi-badge">{t.level}</span>
              <span class="abi-name">{t.name}{!t.reviewed && <span class="pu-draft-tag" data-i18n="ab.partner.draftShort">Entwurf</span>}<small class="abi-sub" data-i18n="ab.pg.tandemSub">Tandembogen · Paar</small></span>
              <span class="abi-meta">{t.spec.loesungen.length} <span data-i18n="ab.tandem.items">Aufgaben</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <p class="abi-empty" data-abi-empty hidden data-i18n="ab.index.empty">Nichts gefunden. Anderes Niveau oder anderer Suchbegriff?</p>
  </main>

  <script>
    import { mountIndexFilter } from "../../../../lib/arbeitsblatt/indexFilter.js";
    mountIndexFilter(document.getElementById("abi-root"));
  </script>
</Layout>
