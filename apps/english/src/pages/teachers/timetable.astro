---
// /teachers/timetable — a lesson plan for one block of the course plan, on demand:
// level, block, number of lessons and their length in, timed phases with activities and
// links out. The rules are in src/lib/stundenplan.js (no AI, same input → same plan); the
// blocks come from src/data/kursinhalte.json, and the links to grammar pages, Wortlisten
// and games are resolved at build time (src/lib/stundenplanLinks.js), so the plan only
// links pages that exist.
// Every setting is in the URL (?niveau=b1-1&block=2&stunden=3&min=90): the link reopens
// the same plan, and each block on /syllabus/<niveau> links here with its own.
// English only (lang="en"), like the course plan; no keys. The phases and activities come
// from src/lib/stundenplan.js (still German until the `teachers` item).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { planLevels } from "../../lib/stundenplanLinks.js";
import MascotGuide from "../../components/mascots/MascotGuide.astro";
import StundenplanSim from "../../components/sims/StundenplanSim.astro";
import "../../styles/practice.css";

const levels = planLevels();
---
<Layout
  title="Lesson plan generator for English courses A1–C1 | icanspeak English"
  description="Lesson planning at the press of a button: choose the level, topic block, number and length of lessons and get a plan with stages, timings, activities and matching exercises, free to print."
  breadcrumb={[{ name: "For teachers", path: "/teachers" }]}
>
  <SiteNav active="lehrkraefte" />
  <main class="practice-main sp" lang="en">
    <header class="sp-hero" data-sp-hide-print>
      <p class="sp-eyebrow"><a href="/teachers">For teachers</a> · Lesson plan</p>
      <h1>Lesson plan for a topic block</h1>
      <p class="sp-lead">
        Choose a level and a block from the <a href="/syllabus">syllabus</a>, then the number
        and length of your lessons. You get a plan with timings, activities and the matching
        exercises right here on the page. The settings are in the link: share it, and others
        get exactly the same plan.
      </p>
    </header>

    <MascotGuide id="stundenplan" title="How it works" titleKey="uf.t.guide.title" extra="klemmbrett" class="sp-guide">
      <StundenplanSim slot="sim" />
      <li>Choose the level, the topic block and how many lessons you have.</li>
      <li>The plan is ready at once: every lesson in stages, with timings, steps, interaction and the matching exercises.</li>
      <li>“Start the lesson” shows it step by step on the projector, with a timer for each stage.</li>
      <li class="mg-tip">The settings are in the link: share it, and others get the same plan. Or print it as a PDF.</li>
    </MascotGuide>

    <form class="sp-form" data-sp-form data-sp-hide-print>
      <label>Level
        <select name="niveau">{levels.map((l) => <option value={l.id}>{l.label} – {l.titel}</option>)}</select>
      </label>
      <label class="sp-wide">Topic block
        <select name="block"></select>
      </label>
      <label>Lessons
        <select name="stunden">{[1, 2, 3, 4, 5, 6].map((n) => <option value={n} selected={n === 3}>{n}</option>)}</select>
      </label>
      <label>Minutes per lesson
        <select name="min">{[45, 60, 90, 120].map((m) => <option value={m} selected={m === 90}>{m}</option>)}</select>
      </label>
      {/* Optional: with a start time the Zeit column shows the clock (09:00–09:10), without
          it the minutes into the lesson (0–10). */}
      <label>Start time <small>(optional)</small>
        <input type="time" name="ab" step="300" />
      </label>
    </form>

    <div class="sp-actions" data-sp-hide-print>
      {/* The plan taught live: Stunde 1 of this plan with a group, step by step on the
          projector (/teachers/lesson). Each Stunde below has its own start too. */}
      <a class="lp-btn lp-btn--primary sp-go" data-sp-go href="/teachers/lesson">▶ Start the lesson</a>
      <button type="button" class="lp-btn lp-btn--outline" data-sp-print>Print / save as PDF</button>
      <a class="lp-btn lp-btn--outline" href="/syllabus" data-sp-block-link>This block in the syllabus</a>
    </div>

    <div class="sp-plan" data-sp-plan aria-live="polite"></div>
    <p class="sp-legend" data-sp-legend hidden>
      <b>Interaction:</b> <abbr>Ind</abbr> individual work · <abbr>PW</abbr> pair work ·
      <abbr>GW</abbr> group work · <abbr>WC</abbr> whole class
    </p>
    <p class="sp-note">
      A suggestion, not a rule: the timings and activities are a guide for a group of 8–15
      people. Adapt them to your group.
    </p>
  </main>
  <script type="application/json" id="sp-data" set:html={JSON.stringify(levels)}></script>
</Layout>

<style>
  /* Wide enough for the five-column plan table. */
  .sp { max-width: 1080px; }
  .sp-eyebrow { margin: 0 0 6px; font-size: var(--text-sm); font-weight: var(--fw-semibold); color: var(--muted); }
  .sp-eyebrow a, .sp-lead a { color: var(--brand-blue-dark); }
  .sp-hero h1 { margin: 0 0 8px; font-size: var(--text-4xl); line-height: 1.15; }
  .sp-lead { margin: 0 0 20px; color: var(--muted); line-height: 1.55; }

  .sp-form {
    display: grid; grid-template-columns: 1fr 1.6fr .6fr .8fr .8fr; gap: 12px; align-items: end;
    padding: 16px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-card);
  }
  .sp-form label { display: grid; gap: 6px; font-size: var(--text-sm); font-weight: var(--fw-semibold); color: var(--muted); min-width: 0; }
  .sp-form small { font-weight: var(--fw-regular); }
  .sp-form select, .sp-form input {
    font: inherit; font-weight: var(--fw-medium); min-height: 44px; padding: 8px 10px; width: 100%;
    border: 1px solid var(--border-strong); border-radius: 10px; background: var(--page-bg); color: var(--ink);
  }
  .sp-actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 24px; }
  .sp-go { padding-inline: 30px; font-size: var(--text-base); }

  .sp-plan { display: grid; gap: 16px; }
  .sp-plan :global(.sp-head) { display: grid; gap: 4px; }
  .sp-plan :global(.sp-head h2) { margin: 0; font-size: var(--text-2xl); line-height: 1.2; }
  .sp-plan :global(.sp-head p) { margin: 0; color: var(--muted); }
  .sp-plan :global(.sp-head .sp-books) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 6px; font-size: var(--text-sm); }
  .sp-plan :global(.sp-books > span:first-child) { margin-right: 2px; }
  .sp-plan :global(.sp-book) {
    display: inline-flex; align-items: baseline; gap: 4px; padding: 3px 10px; border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill); background: var(--surface-card); color: var(--muted); font-size: var(--text-xs);
  }
  .sp-plan :global(.sp-book b) { color: var(--ink); font-size: var(--text-sm); }
  .sp-plan :global(.sp-lesson) {
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-card); overflow: hidden;
  }
  .sp-plan :global(.sp-lesson-head) {
    display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; padding: 12px 16px;
    background: var(--surface); border-bottom: 1px solid var(--border);
  }
  .sp-plan :global(.sp-lesson-head h3) { margin: 0; font-size: var(--text-lg); }
  .sp-plan :global(.sp-lesson-head span) { color: var(--muted); font-size: var(--text-sm); }
  .sp-plan :global(.sp-goals) { margin: 0; padding: 10px 16px 0; font-size: var(--text-sm); color: var(--muted); }
  /* The phases as a timeline bar (each phase as wide as its minutes) and as a table. */
  .sp-plan :global(.sp-bar) { display: flex; gap: 2px; margin: 12px 16px 0; height: 26px; border-radius: 6px; overflow: hidden; }
  .sp-plan :global(.sp-bar span) {
    display: flex; align-items: center; justify-content: center; min-width: 0; overflow: hidden;
    font-size: 11px; font-weight: var(--fw-semibold); white-space: nowrap; color: #1f2937;
  }

  .sp-plan :global(.sp-table) { width: calc(100% - 32px); margin: 10px 16px 14px; border-collapse: collapse; text-align: left; table-layout: fixed; }
  /* Same column widths in every lesson, so the plans line up on screen and on paper. */
  .sp-plan :global(.sp-table th:nth-child(1)) { width: 112px; }
  .sp-plan :global(.sp-table th:nth-child(2)) { width: 130px; }
  .sp-plan :global(.sp-table th:nth-child(4)) { width: 104px; }
  .sp-plan :global(.sp-table th:nth-child(5)) { width: 230px; }
  .sp-plan :global(.sp-table th), .sp-plan :global(.sp-table td) { padding: 10px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .sp-plan :global(.sp-table thead th) {
    font-size: var(--text-xs); text-transform: uppercase; letter-spacing: .05em; color: var(--muted);
    font-weight: var(--fw-semibold); border-bottom: 2px solid var(--border-strong); white-space: nowrap;
  }
  .sp-plan :global(.sp-table tbody tr:last-child > *) { border-bottom: 0; }
  .sp-plan :global(.sp-time) { white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: var(--fw-bold); }
  .sp-plan :global(.sp-time small) { display: block; font-weight: var(--fw-regular); color: var(--muted); font-size: var(--text-xs); }
  .sp-plan :global(.sp-ph) { font-weight: var(--fw-semibold); white-space: nowrap; }
  .sp-plan :global(.sp-ph i) { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .25); }
  .sp-plan :global(.sp-text) { line-height: 1.5; }
  .sp-plan :global(.sp-soc) { white-space: nowrap; }
  .sp-plan :global(.sp-soc abbr) {
    display: inline-block; margin: 0 2px 2px 0; padding: 1px 6px; border-radius: 6px; text-decoration: none;
    background: var(--blue-50); border: 1px solid var(--blue-200); font-size: var(--text-xs); font-weight: var(--fw-bold);
  }
  .sp-plan :global(.sp-none) { color: var(--muted); }
  .sp-legend { margin: 16px 0 0; font-size: var(--text-sm); color: var(--muted); }
  .sp-legend abbr { text-decoration: none; font-weight: var(--fw-bold); color: var(--ink); }
  .sp-plan :global(.sp-links) { display: flex; flex-wrap: wrap; gap: 6px; }
  .sp-plan :global(.sp-links a) {
    padding: 2px 10px; border-radius: var(--radius-pill); border: 1px solid var(--border-strong);
    font-size: var(--text-xs); font-weight: var(--fw-semibold); color: var(--brand-blue-dark); text-decoration: none;
  }
  .sp-plan :global(.sp-links a:hover) { border-color: var(--brand-blue); }
  /* Videos on other sites (YouTube, DW): told apart from the site's own pages. */
  .sp-plan :global(.sp-links a.sp-ext) { border-style: dashed; color: var(--ink); }
  .sp-plan :global(.sp-start) {
    margin-left: auto; padding: 4px 14px; border-radius: var(--radius-pill); border: 1px solid var(--brand-blue);
    font-size: var(--text-sm); font-weight: var(--fw-bold); color: var(--brand-blue-dark); text-decoration: none; white-space: nowrap;
  }
  .sp-plan :global(.sp-start:hover) { background: var(--blue-50); }
  /* „Als Aufgabe stellen“ beside it: the same pill, quieter, not pushed to the edge again. */
  .sp-plan :global(.sp-task) { margin-left: 0; background: none; border-color: var(--border-strong); color: var(--ink); font-family: inherit; cursor: pointer; }
  .sp-plan :global(.sp-task[hidden]) { display: none; }
  .sp-plan :global(.sp-progress) {
    padding: 10px 14px; border-radius: var(--radius); background: var(--blue-50); border: 1px solid var(--blue-200); font-size: var(--text-sm);
  }
  .sp-plan :global(.sp-progress ul) { margin: 4px 0 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .sp-plan :global(.sp-progress li > span) { font-weight: var(--fw-semibold); }
  .sp-plan :global(.sp-progress a) { color: var(--brand-blue-dark); font-weight: var(--fw-semibold); }
  .sp-plan :global(.sp-done) { color: var(--ink); }
  .sp-note { margin: 20px 0 0; font-size: var(--text-sm); color: var(--muted); }

  @media (max-width: 720px) {
    .sp-form { grid-template-columns: 1fr 1fr; }
    .sp-wide { grid-column: 1 / -1; }
    /* The table stacks: time, phase and Sozialform on one line, then the activity and material. */
    .sp-plan :global(.sp-table thead) { display: none; }
    .sp-plan :global(.sp-table), .sp-plan :global(.sp-table tbody) { display: block; }
    .sp-plan :global(.sp-table tr) {
      display: grid; grid-template-columns: auto 1fr auto; gap: 4px 10px; align-items: baseline;
      padding: 10px 0; border-bottom: 1px solid var(--border);
    }
    .sp-plan :global(.sp-table tbody tr:last-child) { border-bottom: 0; }
    .sp-plan :global(.sp-table td) { padding: 0; border: 0; }
    .sp-plan :global(.sp-time small) { display: inline; margin-left: 4px; }
    .sp-plan :global(.sp-soc) { grid-row: 1; grid-column: 3; }
    .sp-plan :global(.sp-text), .sp-plan :global(.sp-mat) { grid-column: 1 / -1; width: auto; }
    .sp-plan :global(.sp-bar span) { font-size: 0; }
    .sp-plan :global(.sp-mat .sp-none) { display: none; }
  }
  @media (max-width: 480px) {
    .sp { padding-left: 16px; padding-right: 16px; padding-top: 24px; }
    .sp-form { grid-template-columns: 1fr; padding: 12px; }
    .sp-actions .lp-btn { flex: 1 1 100%; }
  }

  @media print {
    :global(body:has(.sp) > :not(main)) { display: none !important; }
    /* Global: the progress line and the start links are drawn by the script, so they
       carry no scoped class and a scoped rule would miss them. */
    :global([data-sp-hide-print]), :global(.sp-guide) { display: none !important; }
    .sp { padding: 0; max-width: none; font-size: 9pt; }
    .sp-plan :global(.sp-head h2) { font-size: 14pt; }
    /* A Stunde may run over a page (one too long for the rest of a page used to push it
       whole onto the next and leave the first nearly empty); a row never splits, and the
       head, goals and bar stay with the table. */
    .sp-plan :global(.sp-lesson) { break-inside: auto; border-color: #bbb; }
    .sp-plan :global(.sp-lesson-head), .sp-plan :global(.sp-goals), .sp-plan :global(.sp-bar) { break-after: avoid; }
    .sp-plan :global(.sp-table tr) { break-inside: avoid; }
    .sp-plan :global(.sp-lesson-head) { padding: 4pt 8pt; background: none; }
    .sp-plan :global(.sp-bar) { margin: 4pt 8pt 0; height: 14pt; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .sp-plan :global(.sp-ph i) { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .sp-plan :global(.sp-table) { width: calc(100% - 16pt); margin: 4pt 8pt 6pt; }
    .sp-plan :global(.sp-table th), .sp-plan :global(.sp-table td) { padding: 3pt 4pt; border-color: #ccc; }
    .sp-plan :global(.sp-table th:nth-child(1)) { width: 62pt; }
    .sp-plan :global(.sp-table th:nth-child(2)) { width: 70pt; }
    .sp-plan :global(.sp-table th:nth-child(4)) { width: 50pt; }
    .sp-plan :global(.sp-table th:nth-child(5)) { width: 140pt; }
    .sp-plan :global(.sp-table thead th) { font-size: 6.5pt; white-space: normal; }
    .sp-plan :global(.sp-links) { gap: 1pt; }
    .sp-plan :global(.sp-links a) { overflow-wrap: anywhere; line-height: 1.25; }
    .sp-plan :global(.sp-soc abbr) { border: 0; background: none; padding: 0; }
    .sp-plan :global(.sp-links a) { border: 0; padding: 0; color: #333; }
    .sp-plan :global(.sp-links a::after) { content: " (icanspeak.it/english" attr(href) ")"; font-weight: normal; font-size: 7pt; color: #666; }
    /* A YouTube search URL on paper is noise; the name says what to look for. */
    .sp-plan :global(.sp-links a.sp-ext::after) { content: none; }
  }
</style>

<script>
  import { build } from "../../lib/stundenplan.js";
  import { phaseColor } from "../../lib/unterricht/phasen.js";
  import { BASE_PATH } from "../../lib/paths.js";

  const levels = JSON.parse(document.getElementById("sp-data")!.textContent!);
  const form = document.querySelector<HTMLFormElement>("[data-sp-form]")!;
  const plan = document.querySelector<HTMLElement>("[data-sp-plan]")!;
  const blockLink = document.querySelector<HTMLAnchorElement>("[data-sp-block-link]")!;
  const goLink = document.querySelector<HTMLAnchorElement>("[data-sp-go]")!;
  const legend = document.querySelector<HTMLElement>("[data-sp-legend]")!;
  const sel = (n: string) => form.elements.namedItem(n) as HTMLSelectElement;
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const fillBlocks = (level: any, want?: string) => {
    sel("block").innerHTML = level.blocks.map((b: any, i: number) => `<option value="${i + 1}">Block ${i + 1}: ${esc(b.thema)}</option>`).join("");
    if (want && Number(want) >= 1 && Number(want) <= level.blocks.length) sel("block").value = want;
  };

  // Settings from the link, else the defaults in the form.
  const q = new URLSearchParams(location.search);
  if (levels.some((l: any) => l.id === q.get("niveau"))) sel("niveau").value = q.get("niveau")!;
  if (q.get("stunden") && [...sel("stunden").options].some((o) => o.value === q.get("stunden"))) sel("stunden").value = q.get("stunden")!;
  if (q.get("min") && [...sel("min").options].some((o) => o.value === q.get("min"))) sel("min").value = q.get("min")!;
  const ab = form.elements.namedItem("ab") as HTMLInputElement;
  if (/^\d{2}:\d{2}$/.test(q.get("ab") ?? "")) ab.value = q.get("ab")!;
  fillBlocks(levels.find((l: any) => l.id === sel("niveau").value), q.get("block") ?? undefined);

  function render() {
    const level = levels.find((l: any) => l.id === sel("niveau").value);
    const bi = Number(sel("block").value) - 1;
    const block = level.blocks[bi];
    const n = Number(sel("stunden").value);
    const minutes = Number(sel("min").value);
    const p = build({ level, block, n, minutes, links: { grammar: block.grammar, words: level.words, game: level.game, videos: level.videos } });

    const url = new URL(location.href);
    const params = new URLSearchParams({ niveau: level.id, block: String(bi + 1), stunden: String(n), min: String(minutes) });
    if (ab.value) params.set("ab", ab.value);
    url.search = params.toString();
    history.replaceState(null, "", url);
    blockLink.href = `${BASE_PATH}/syllabus/${level.id}`;
    goLink.href = `${BASE_PATH}/teachers/lesson?${new URLSearchParams({ niveau: level.id, block: String(bi + 1), stunden: String(n), stunde: "1", min: String(minutes) })}`;

    const links = (ls: any[]) => ls.length
      ? `<span class="sp-links">${ls.map((l) => l.ext
        ? `<a class="sp-ext" href="${esc(l.href)}" target="_blank" rel="noopener">${esc(l.name)} ↗</a>`
        : `<a href="${esc(l.href)}">${esc(l.name)}</a>`).join("")}</span>`
      : `<span class="sp-none">–</span>`;
    // Minutes since the start → "09:10" with a start time, else "10".
    const [h0, m0] = ab.value ? ab.value.split(":").map(Number) : [0, 0];
    const clock = (m: number) => {
      if (!ab.value) return String(m);
      const t = (h0 * 60 + m0 + m) % (24 * 60);
      return `${String(Math.floor(t / 60)).padStart(2, "0")}:${String(t % 60).padStart(2, "0")}`;
    };
    // The plan's codes (EA, PA, GA, PL, from stundenplan.js) shown as English abbreviations.
    const SOC: Record<string, string> = { EA: "individual work", PA: "pair work", GA: "group work", PL: "whole class" };
    const SHORT: Record<string, string> = { EA: "Ind", PA: "PW", GA: "GW", PL: "WC" };

    plan.innerHTML = `
      <div class="sp-head">
        <h2>${esc(p.level)} · Block ${bi + 1}: ${esc(p.thema)}</h2>
        <p>${n} ${n === 1 ? "lesson" : "lessons"} of ${minutes} minutes · ${esc(level.titel)}</p>
        ${level.books?.length ? `<p class="sp-books"><span>Goes with these coursebooks</span>${level.books.map((b: string) => {
          const [name, verlag] = b.split(/\s*\((.*)\)$/);
          return `<span class="sp-book"><b>${esc(name)}</b>${verlag ? ` ${esc(verlag)}` : ""}</span>`;
        }).join("")}</p>` : ""}
      </div>
      <div class="sp-progress" data-sp-progress data-sp-hide-print hidden></div>
      ${p.lessons.map((s: any) => {
        let at = 0;
        const rows = s.phases.map((ph: any) => {
          const from = at;
          at += ph.minutes;
          return { ...ph, from, to: at };
        });
        return `
        <section class="sp-lesson">
          <div class="sp-lesson-head"><h3>Lesson ${s.n}</h3><span>${s.final ? "Use and revise" : `Focus: ${esc(s.focus)}`}</span>
            <a class="sp-start" data-sp-hide-print href="${BASE_PATH}/teachers/lesson?${new URLSearchParams({ niveau: level.id, block: String(bi + 1), stunden: String(n), stunde: String(s.n), min: String(minutes) })}">▶ Start the lesson</a>
            <button type="button" class="sp-start sp-task" data-sp-hide-print data-sp-task="${s.n}" data-sp-task-name="${esc(`Lesson ${s.n}: ${s.final ? "Use and revise" : s.focus}`)}" hidden>Set as homework</button></div>
          ${s.goals.length ? `<p class="sp-goals">${s.goals.length > 1 ? "Learning goals" : "Learning goal"}: ${s.goals.map((g: string) => esc(g)).join(" ")}</p>` : ""}
          <div class="sp-bar" aria-hidden="true">${rows.map((r: any) => `<span style="flex:${r.minutes};background:${phaseColor(r.id).bg}" title="${esc(r.name)} · ${r.minutes} min">${r.minutes >= 10 ? esc(r.name) : ""}</span>`).join("")}</div>
          <table class="sp-table">
            <thead><tr><th scope="col">Time</th><th scope="col">Stage</th><th scope="col">Procedure</th><th scope="col">Interaction</th><th scope="col">Materials</th></tr></thead>
            <tbody>${rows.map((r: any) => `
              <tr>
                <td class="sp-time">${clock(r.from)}–${clock(r.to)}<small>${r.minutes} min</small></td>
                <td class="sp-ph"><i style="background:${phaseColor(r.id).bg}"></i>${esc(r.name)}</td>
                <td class="sp-text">${esc(r.text)}</td>
                <td class="sp-soc">${r.social.map((f: string) => `<abbr title="${SOC[f] ?? f}">${SHORT[f] ?? f}</abbr>`).join("")}</td>
                <td class="sp-mat">${links(r.links)}</td>
              </tr>`).join("")}
            </tbody>
          </table>
        </section>`;
      }).join("")}`;
    legend.hidden = false;
    showProgress({ niveau: level.id, block: bi + 1, stunden: n, minuten: minutes }, p);
  }

  // Per group, how far this plan got (/teachers/lesson): "Gruppe A: Stunde 1 ✓ ·
  // Stunde 2 bei Grammatik". Only for a signed-in teacher; asked again whenever the plan
  // changes, and an answer for an older plan is dropped.
  let asked = 0;
  async function showProgress(key: any, p: any) {
    const box = plan.querySelector<HTMLElement>("[data-sp-progress]");
    const ask = ++asked;
    if (!box || !/(^|;\s*)sb-[^=]*-auth-token[^=]*=/.test(document.cookie)) return;
    try {
      const [{ currentUser, isTeacher }, { planFortschritt }, { fortschrittJeGruppe, sessionHref }] = await Promise.all([
        import("../../lib/liveQuiz/custom.js"), import("../../lib/unterricht/sitzung.js"), import("../../lib/unterricht/speichern.js"),
      ]);
      if (!isTeacher(await currentUser())) return;
      // A teacher: each Stunde can also go to a class as homework, walked alone on /lesson.
      plan.querySelectorAll<HTMLElement>("[data-sp-task]").forEach((b) => (b.hidden = false));
      const rows = await planFortschritt(key);
      if (ask !== asked) return;
      const groups = fortschrittJeGruppe(rows, (stunde: number, i: number) => p.lessons[stunde - 1]?.phases[i]?.name ?? `Step ${i + 1}`);
      if (!groups.length) return;
      box.innerHTML = `<b>Progress</b><ul>${groups.map((g: any) => `<li><span>${esc(g.gruppe)}:</span> ${
        Object.keys(g.stunden).map(Number).sort((a, b) => a - b).map((st) => {
          const x = g.stunden[st];
          return x.done
            ? `<span class="sp-done">Lesson ${st} ✓</span>`
            : `<a href="${sessionHref(x.id)}">Lesson ${st} at ${esc(x.step)}${x.status === "paused" ? " (paused)" : ""}</a>`;
        }).join(" · ")}</li>`).join("")}</ul>`;
      box.hidden = false;
    } catch {
      // No progress line is fine; the plan itself does not depend on it.
    }
  }

  // „Als Aufgabe stellen“: the Stunde with this plan's exact key (src/lib/unterricht/stundeAufgabe.js).
  plan.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-sp-task]");
    if (!btn) return;
    const key = { niveau: sel("niveau").value, block: Number(sel("block").value), stunden: Number(sel("stunden").value), stunde: Number(btn.dataset.spTask), minuten: Number(sel("min").value) };
    const { openStundeAufgabe } = await import("../../lib/unterricht/stundeAufgabe.js");
    openStundeAufgabe({ key, name: btn.dataset.spTaskName ?? "" });
  });

  form.addEventListener("change", (e) => {
    if ((e.target as HTMLElement).getAttribute("name") === "niveau") fillBlocks(levels.find((l: any) => l.id === sel("niveau").value));
    render();
  });
  document.querySelector("[data-sp-print]")!.addEventListener("click", () => window.print());
  render();
</script>
