---
// The curated deck: Redemittel and everyday phrases, hand-written rather than drawn from
// the lexicon, and the only deck with all four translation languages filled in.
// Lexicon decks — a whole level, or one Lernset — live at /vocabulary/[deck].
// This page keeps its own URL because it is the one every CTA on the site points at, and
// because it is the only deck with ar/ru/tr filled in.
import Layout from "../../layouts/Layout.astro";
import VokabelTrainer from "../../components/VokabelTrainer.astro";
import wortschatz from "../../data/wortschatz.json";
import { TRANSLATION_LANGS } from "../../lib/lexicon.js";

// Three of the notes explain usage ("Zustimmen — klingt natürlicher …") and are scaffolding,
// so they carry a key for the UI language. The rest are German model answers and example
// arguments — the language being practised — and stay as they are.
const EXPLAINED = new Set([0, 1, 2]);
const cards = wortschatz.map((c, i) => (EXPLAINED.has(i) ? { ...c, noteKey: `ws.redemittel.note.${i}` } : c));
// The German hint tab, then every card language of the registry that all of these cards carry.
const langs = ["de", ...TRANSLATION_LANGS].filter((l) => cards.every((c) => c.translations?.[l]));
---
<Layout title="English vocabulary with flashcards – icanspeak English" description="English vocabulary with flashcards: word sets by level, the most common words and useful phrases for everyday life — with a/an, example sentences and audio.">
  <VokabelTrainer
    cards={cards}
    heading="Everyday Phrases & Vocabulary"
    headingKey="wortschatz.hero.title"
    sub="Hand-written, not from the lexicon — and the only deck in four languages."
    subParts={[{ text: "Hand-written, not from the lexicon — and the only deck in four languages.", key: "ws.redemittel.sub" }]}
    deck="redemittel"
    langs={langs}
  />
</Layout>
