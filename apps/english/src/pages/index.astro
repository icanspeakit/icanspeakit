---
// The course home, in the icanspeak brand pattern (brand/kit/BRAND.md §5): white header,
// ribbon, hero with the 3×3 mascot tile grid, the navy "What you practise here" band, the
// exercise cards, the glass band with the five courses, the yellow placement band and the
// navy footer. Layout: design/english-landing/D-canspeak-tiles.dc.html. Tiles are CSS
// (src/styles/tiles.css) and decoration only: aria-hidden.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Mascot from "../components/mascots/Mascot.astro";
import { landingTools } from "../lib/catalog.js";
import "../styles/home4.css";

// The ribbon: one row of small tiles, cycled. Colours are the brand's four plus navy/white.
const RIBBON = [
  { cls: "isk-tile--half", bg: "var(--isk-navy)", a: "var(--isk-yellow)", b: "#fff" },
  { cls: "isk-tile--dots", bg: "var(--isk-sky)", a: "var(--isk-navy)", b: "#fff" },
  { cls: "isk-tile--bowl", bg: "#fff", a: "var(--isk-navy)", b: "var(--isk-yellow)" },
  { cls: "isk-tile--quarter", bg: "var(--isk-coral)", a: "var(--isk-navy)", b: "#fff" },
  { cls: "isk-tile--stripes", bg: "#fff", a: "var(--isk-yellow)", b: "#fff" },
  { cls: "isk-tile--dside", bg: "var(--isk-navy)", a: "var(--isk-coral)", b: "#fff" },
  { cls: "isk-tile--dome", bg: "var(--isk-green)", a: "var(--isk-navy)", b: "#fff" },
  { cls: "", bg: "var(--isk-navy)", a: "var(--isk-yellow)", b: "#fff", glyph: "¡" },
];
const RIBBON_TILES = Array.from({ length: 24 }, (_, i) => RIBBON[i % RIBBON.length]);

// The 3×3 hero grid, reading order. Mascots keep their colour (src/lib/mascots.js).
const HERO = [
  { cls: "", bg: "var(--isk-sky)", a: "var(--isk-navy)", b: "#fff", mascot: "bruno" },
  { cls: "isk-tile--dots", bg: "var(--isk-navy)", a: "var(--isk-yellow)", b: "#fff" },
  { cls: "isk-tile--half", bg: "var(--isk-coral)", a: "var(--isk-navy)", b: "var(--isk-yellow)" },
  { cls: "", bg: "var(--isk-navy)", a: "var(--isk-yellow)", b: "#fff", glyph: "¡" },
  { cls: "", bg: "var(--isk-yellow)", a: "var(--isk-navy)", b: "#fff", mascot: "regi" },
  { cls: "isk-tile--bubble", bg: "var(--isk-sky)", a: "#fff", b: "#fff", say: "home4.here" },
  { cls: "isk-tile--stripes", bg: "#fff", a: "var(--isk-yellow)", b: "#fff" },
  { cls: "", bg: "var(--isk-coral)", a: "var(--isk-navy)", b: "#fff", mascot: "quaki" },
  { cls: "", bg: "var(--isk-green)", a: "var(--isk-navy)", b: "#fff", mascot: "hamsti" },
];

// The four mascots, one card each in the navy band.
const CREW = [
  { name: "regi", colour: "var(--isk-yellow)", kicker: "home4.card.grammar.kicker", kickerText: "with Regi", title: "home4.card.grammar.title", titleText: "Grammar", desc: "home4.card.grammar.desc", descText: "Tenses, questions, conditionals and word order from A1 to B2, one small step at a time." },
  { name: "bruno", colour: "var(--isk-sky)", kicker: "home4.card.everyday.kicker", kickerText: "with Bruno", title: "home4.card.everyday.title", titleText: "Everyday English", desc: "home4.card.everyday.desc", descText: "The situations you meet abroad: the doctor, the landlord, small talk at work." },
  { name: "quaki", colour: "var(--isk-coral)", kicker: "home4.card.speaking.kicker", kickerText: "with Quaki", title: "home4.card.speaking.title", titleText: "Speaking", desc: "home4.card.speaking.desc", descText: "Role plays, partner tasks and picture descriptions: the part most apps leave out." },
  { name: "hamsti", colour: "var(--isk-green)", kicker: "home4.card.vocab.kicker", kickerText: "with Hamsti", title: "home4.card.vocab.title", titleText: "Vocabulary & exams", desc: "home4.card.vocab.desc", descText: "Flashcards that come back at the right time, and mock tests for Cambridge, IELTS and Trinity." },
];

// The exercise cards come from the one catalogue (src/lib/catalog.js), as on /exercises.
const CARD_GLYPHS = ["Aa", "“”", "¿", "!", "¡", "?"];

// The five courses. Only english is live; the others are shown, not linked, until they are.
const COURSES = [
  { label: "english", live: true, href: "/" },
  { label: "español" },
  { label: "français" },
  { label: "português" },
  { label: "italiano" },
];
---
<Layout>
  <div class="home4">
    <SiteNav />

    <div class="isk-ribbon h4-ribbon" aria-hidden="true">
      {RIBBON_TILES.map((t) => (
        <div class={`isk-tile ${t.cls}`} style={`--t:var(--isk-tile);--bg:${t.bg};--a:${t.a};--b:${t.b}`}>
          {t.glyph && <span class="isk-tile__fill">{t.glyph}</span>}
        </div>
      ))}
    </div>

    <!-- Hero -->
    <section class="h4-hero">
      <div class="h4-hero__copy">
        <p class="h4-eyebrow" data-i18n="home4.eyebrow">English from A1 to B2</p>
        <h1 class="h4-h1">
          <span data-i18n="home4.h1a">Learn English.</span><br />
          <span class="h4-h1__mark" data-i18n="home4.h1b">Step by step.</span>
        </h1>
        <p class="h4-lead" data-i18n="home4.lead">Grammar, everyday English and speaking from A1 to B2. Every exercise was taught in a real English class before it went online.</p>
        <div class="h4-cta">
          <a href="/placement-test" class="h4-btn h4-btn--primary" data-i18n="home4.cta1">Start where you are</a>
          <a href="/exams" class="h4-btn h4-btn--outline" data-i18n="home4.cta2">See the exams</a>
        </div>
        <p class="h4-free" data-i18n="home4.free">Free exercises, no account needed.</p>
      </div>
      <div class="h4-hero__grid" aria-hidden="true">
        {HERO.map((t) => (
          <div class={`isk-tile ${t.cls}`} style={`--t:150px;--bg:${t.bg};--a:${t.a};--b:${t.b}`}>
            {t.mascot && <div class="isk-tile__fill"><Mascot name={t.mascot} size={120} /></div>}
            {t.glyph && <div class="isk-tile__fill">{t.glyph}</div>}
            {t.say && <span class="isk-tile__say" data-i18n={t.say}>Here for you!</span>}
          </div>
        ))}
      </div>
    </section>

    <!-- Navy band -->
    <section class="h4-band">
      <div class="h4-wrap">
        <h2 class="h4-h2 h4-h2--light" data-i18n="home4.band.title">What you practise here</h2>
        <div class="h4-crew">
          {CREW.map((c) => (
            <article class="h4-card">
              <div class="h4-card__top" style={`background:${c.colour}`}>
                <Mascot name={c.name} size={140} />
              </div>
              <div class="h4-card__body">
                <span class="h4-kicker" data-i18n={c.kicker}>{c.kickerText}</span>
                <h3 class="h4-h3" data-i18n={c.title}>{c.titleText}</h3>
                <p class="h4-p" data-i18n={c.desc}>{c.descText}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="isk-ribbon h4-ribbon" aria-hidden="true">
      {RIBBON_TILES.map((t) => (
        <div class={`isk-tile ${t.cls}`} style={`--t:var(--isk-tile);--bg:${t.bg};--a:${t.a};--b:${t.b}`}>
          {t.glyph && <span class="isk-tile__fill">{t.glyph}</span>}
        </div>
      ))}
    </div>

    <!-- Exercise cards: the catalogue -->
    <section class="h4-wrap h4-exercises">
      <div class="h4-row">
        <h2 class="h4-h2" data-i18n="home4.exercises.title">All exercises</h2>
        <a href="/exercises" class="h4-link" data-i18n="home4.exercises.all">Browse everything</a>
      </div>
      <div class="h4-grid">
        {landingTools.map((t, i) => (
          <a href={t.href} class="h4-ex">
            <span class="isk-tile isk-tile--dots h4-ex__glyph" aria-hidden="true" style="--t:56px;--bg:var(--isk-navy);--a:var(--isk-yellow);--b:#fff"><span class="isk-tile__fill">{CARD_GLYPHS[i % CARD_GLYPHS.length]}</span></span>
            <span class="h4-ex__title" data-i18n={t.titleKey}>{t.title}</span>
            <span class="h4-ex__desc" data-i18n={t.descKey}>{t.desc}</span>
            <span class="h4-badge" data-i18n={t.countKey} data-i18n-vars={t.countVars ? JSON.stringify(t.countVars) : undefined}>{t.count}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Glass band: the five courses -->
    <section class="h4-glass">
      <div class="h4-wrap h4-glass__row">
        <div class="h4-glass__img">
          <img src="/img/home/icanspeak-glass.svg" alt="" aria-hidden="true" />
        </div>
        <div class="h4-glass__copy">
          <h2 class="h4-h2 h4-h2--light" data-i18n="home4.langs.title">One place, five languages</h2>
          <p class="h4-p h4-p--light" data-i18n="home4.langs.lead">The same method, the same crew, for every course on icanspeak.it.</p>
          <div class="h4-pills">
            {COURSES.map((c) => c.live
              ? <a href={c.href} class="h4-pill h4-pill--live" aria-current="page">{c.label}</a>
              : <span class="h4-pill">{c.label}</span>)}
          </div>
        </div>
      </div>
    </section>

    <!-- Yellow band: the placement test -->
    <section class="h4-place">
      <div class="h4-wrap h4-place__row">
        <Mascot name="quaki" expr="celebrate" size={150} />
        <div>
          <h2 class="h4-h2" data-i18n="home4.place.title">Not sure where to start?</h2>
          <p class="h4-p" data-i18n="home4.place.lead">Take the placement test and start at your level.</p>
        </div>
        <a href="/placement-test" class="h4-btn h4-btn--primary" data-i18n="home4.place.cta">Find your level</a>
      </div>
    </section>

    <div class="isk-ribbon h4-ribbon" aria-hidden="true">
      {RIBBON_TILES.map((t) => (
        <div class={`isk-tile ${t.cls}`} style={`--t:var(--isk-tile);--bg:${t.bg};--a:${t.a};--b:${t.b}`}>
          {t.glyph && <span class="isk-tile__fill">{t.glyph}</span>}
        </div>
      ))}
    </div>

    <footer class="h4-footer">
      <div class="h4-wrap h4-footer__row">
        <img src="/logos/icanspeak-wordmark-dark.svg" alt="icanspeak!" class="h4-footer__logo" />
        <nav class="h4-footer__links" aria-label="Footer">
          <a href="/legal-notice" data-i18n="home.footer.link.imprint">Legal notice</a>
          <a href="/privacy" data-i18n="home.footer.link.privacy">Privacy</a>
          <a href="/terms" data-i18n="home.footer.link.terms">Terms</a>
          <a href="https://icanspeak.it/" data-i18n="home4.footer.part">part of icanspeak.it</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>
