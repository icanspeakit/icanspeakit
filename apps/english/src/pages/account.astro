---
// /account: sign in to the one icanspeak.it account (Google or an email link). Progress stays in
// this browser and, once signed in, is also saved to the account per course
// (src/lib/account/). The old account routes redirect here (astro.config.mjs, ACCOUNT_REDIRECTS).
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import AccountCard from "../components/AccountCard.astro";
---
<Layout title="Your account – icanspeak English" description="Sign in so your progress follows you to every device." noindex>
  <SiteNav />
  <main>
    <AccountCard termsHref="/terms" privacyHref="/privacy" progressHref="/progress" />
  </main>
</Layout>
