    "flow": [
      {
        "text": "near: this / these",
        "variant": "verb"
      },
      {
        "text": "far: that / those",
        "variant": "prep"
      },
      {
        "text": "noun, or on its own"
      }
    ],
    "qa": [
      {
        "html": "<strong>this</strong> and <strong>these</strong> are for things <em>near</em> you. <strong>that</strong> and <strong>those</strong> are for things <em>far</em> from you. <em>This jumper is soft. That bus is mine.</em>",
        "tag": "Near or far"
      },
      {
        "html": "One thing: <strong>this / that</strong>. More than one: <strong>these / those</strong>. <em>This coat – these coats. That child – those children.</em> The noun changes too: <em>these coat</em> is wrong.",
        "tag": "One or more"
      },
      {
        "html": "You can use them with a noun or <strong>on their own</strong>: <em>This is my sister. Those shoes are nice. Those are my keys.</em> On the phone we say <em>this</em> for ourselves and <em>that</em> for the other person: <em>Hello, this is Mei. Is that Ben?</em>",
        "tag": "On their own"
      },
      {
        "html": "<strong>which</strong> asks you to choose from a group you can see or know: <em>Which coat do you want, the red one or the blue one?</em> <strong>what</strong> asks about anything: <em>What colour is your coat?</em> Answer with <em>this one</em> or <em>that one</em>: <em>This one, please.</em>",
        "tag": "Which?"
      },
      {
        "html": "✗ <em>This shoes are new.</em> → ✓ <em>These shoes are new.</em> · ✗ <em>Those is my bag.</em> → ✓ <em>That is my bag.</em> · ✗ <em>This are my keys.</em> → ✓ <em>These are my keys.</em> · ✗ <em>What coat do you want, the red or the blue?</em> → ✓ <em>Which coat do you want?</em>",
        "tag": "Common mistakes"
      }
    ],
    "noteHtml": "<em>This, that, these, those</em> replace an article, so you cannot say <em>the this bag</em>. Revise <a href=\"/articles\">Articles</a> and <a href=\"/plurals\">Plural nouns</a>. More question words (what, where, who) are at <a href=\"/wh-questions\">Wh- questions</a>.",
