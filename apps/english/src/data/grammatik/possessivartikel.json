{
  "id": "possessivartikel",
  "name": "Possessive adjectives: my, your, his, her",
  "level": "A1",
  "subtitle": "Who does it belong to? my book, your car, her bag, Anna's phone. The word you choose depends on the owner, not on the thing.",
  "briefMarks": [
    "my",
    "your",
    "her",
    "Anna's",
    "owner"
  ],
  "source": "EnglishAcademy original English text (grammar-a1 run, 2026-10-29)",
  "concept": {
    "flow": [
      {
        "text": "owner · who?",
        "variant": "prep"
      },
      {
        "text": "my · your · his · her · its · our · their"
      },
      {
        "text": "noun",
        "variant": "verb"
      }
    ],
    "exampleHtml": "This is <span class=\"vp-prep\">my</span> brother. <span class=\"vp-prep\">Her</span> name is Zofia. This is <span class=\"vp-prep\">Anna</span><span class=\"vp-verb\">'s</span> bag.",
    "qa": [
      {
        "html": "<strong>I → my, you → your, he → his, she → her, it → its, we → our, they → their</strong>. The word never changes for singular or plural: <em>my book, my books</em>.",
        "tag": "Who owns it?"
      },
      {
        "html": "<strong>his</strong> or <strong>her</strong> depends on the <em>owner</em>, not on the thing: <em>Tom loves his sister. Anna loves her brother.</em> The sister and the brother do not matter.",
        "tag": "His or her?"
      },
      {
        "html": "<strong>its</strong> = belongs to it: <em>The dog likes its bed.</em> <strong>it's</strong> = it is: <em>It's cold today.</em> There is no apostrophe in <em>its</em>.",
        "tag": "its / it's"
      },
      {
        "html": "For a name or a person, add <strong>'s</strong>: <em>Anna's bag, my dad's car.</em> For a plural noun ending in -s, add only <strong>'</strong>: <em>my parents' house.</em> For plurals without -s, add <strong>'s</strong>: <em>the children's room.</em>",
        "tag": "'s and s'"
      },
      {
        "html": "✗ <em>I love me family.</em> → ✓ <em>I love my family.</em> · ✗ <em>Anna loves his job.</em> (Anna's job) → ✓ <em>Anna loves her job.</em> · ✗ <em>The dog likes it's bone.</em> → ✓ <em>The dog likes its bone.</em> · ✗ <em>the my bag</em> → ✓ <em>my bag</em>",
        "tag": "Common mistakes"
      }
    ],
    "noteHtml": "A possessive adjective comes <em>before a noun</em> and takes no article: <em>my bag</em>, not <em>the my bag</em>. It is not the same as <em>mine</em> or <em>yours</em> (<em>This bag is mine.</em>). Revise nouns at <a href=\"/articles\">Articles</a> and <a href=\"/plurals\">Plural nouns</a>.",
    "reference": {
