  "name": "Reflexive pronouns",
  "level": "A2",
  "status": "geprueft",
  "subtitle": "Use myself, yourself, himself and the other -self words when the person who does the action is also the person it happens to: I cut myself. Use each other when two people do the same thing to one another: They help each other.",
  "briefMarks": [
    "myself",
    "-self",
    "each other"
  ],
  "source": "icanspeak English original English text (grammar-a2 run, 2026-10-29)",
  "concept": {
    "flow": [
      {
        "text": "I / she / they"
      },
