  "name": "Have / get something done",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Use have or get + something + past participle when someone else does a job for you: I had my hair cut. She got her phone fixed. We are having the kitchen painted.",
  "briefMarks": [
    "have",
    "get",
    "past participle",
    "had my hair cut"
  ],
