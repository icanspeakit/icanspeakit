  "exercises": [
    {
      "type": "fill",
      "title": "Complete the passive.",
      "hint": "Look at the time words and the verb before the gap. In progress: being. Finished: been. After a modal: be or have been.",
      "placeholder": "Form",
      "items": [
        {
          "prompt": "Look! The old cinema ___ pulled down at the moment.",
          "answer": [
            "is being"
          ],
          "choices": [
            "is being",
            "has been",
            "will be"
          ],
          "why": "At the moment shows the action is in progress: is being + past participle."
        },
        {
          "prompt": "The parcels ___ sent yet. They are still in the office.",
          "answer": [
            "haven't been"
          ],
          "choices": [
            "haven't been",
            "weren't",
            "won't be"
          ],
          "why": "Yet goes with the present perfect: haven't been + past participle."
        },
        {
          "prompt": "When we arrived, the tables ___ laid, so we waited outside.",
          "answer": [
            "were being"
          ],
          "choices": [
            "were being",
            "are being",
            "have been"
          ],
          "why": "The action was in progress at a moment in the past: was or were being."
        },
        {
          "prompt": "The results ___ announced tomorrow.",
          "answer": [
            "will be"
          ],
          "choices": [
            "will be",
            "are being",
            "have been"
          ],
          "why": "Tomorrow is the future: will be + past participle."
        },
        {
          "prompt": "The report must ___ finished by Friday.",
          "answer": [
            "be"
          ],
          "choices": [
            "be",
            "being",
            "been"
          ],
          "why": "After a modal verb, use the base form: must be."
        },
        {
          "prompt": "The letter should ___ sent last week, but nobody did it.",
          "answer": [
            "have been"
          ],
          "choices": [
            "have been",
            "be",
            "has been"
          ],
          "why": "A past situation after a modal: should have been + past participle."
        },
        {
          "prompt": "She hates ___ told what to do.",
          "answer": [
            "being"
          ],
          "choices": [
            "being",
            "be",
            "been"
          ],
          "why": "After hate, use the -ing form: being + past participle."
        },
        {
          "prompt": "I want ___ told the truth.",
          "answer": [
            "to be"
          ],
          "choices": [
            "to be",
            "being",
            "to been"
          ],
          "why": "After want, use to + infinitive: to be + past participle."
        },
        {
          "prompt": "The window was ___ in the storm last night.",
          "answer": [
            "broken"
          ],
          "choices": [
            "broken",
            "broke",
            "breaking"
          ],
          "why": "The passive always uses the past participle: broken."
        }
      ]
    },
