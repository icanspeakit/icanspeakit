          "variant": "akk",
          "items": [
            "being = in progress: The road is being repaired.",
            "been = finished: The road has been repaired.",
            "after a modal: must be, should have been",
            "Never: ✗ is repairing, ✗ has sent"
          ]
        },
        {
          "badge": "No passive",
