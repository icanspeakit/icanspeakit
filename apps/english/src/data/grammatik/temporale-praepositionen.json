  "id": "temporale-praepositionen",
  "name": "Prepositions of time: in, on, at",
  "level": "A1",
  "status": "geprueft",
  "subtitle": "Use at for clock times, on for days and dates, and in for months, years and seasons: at 8 o'clock, on Monday, in May. Before this, next, last, every and tomorrow, use no preposition.",
  "briefMarks": ["at 8 o'clock","on Monday","in May","no preposition"],
  "source": "icanspeak English original English text (grammar-a1 run, 2026-10-29)",
  "concept": {
    "flow": [
      {
        "text": "when?",
        "variant": "verb"
      },
      {
        "text": "at · on · in",
        "variant": "prep"
      },
      {
        "text": "the time"
      }
    ],
    "exampleHtml": "The class is <span class=\"vp-prep\">on</span> Monday <span class=\"vp-prep\">at</span> 9 o'clock. — My birthday is <span class=\"vp-prep\">in</span> May.",
    "qa": [
      {
        "html": "<strong>at</strong> + clock time: <em>at 8 o'clock, at half past nine, at noon</em>. Also <em>at night, at the weekend, at Christmas</em>. The question is <em>What time…?</em> — <em>The doctor's appointment is at 10 o'clock.</em> (US: <em>on the weekend</em>.)",
        "tag": "at"
      },
      {
        "html": "<strong>on</strong> + days and dates: <em>on Monday, on 3 May, on my birthday, on Friday evening</em>. When day and time come together, the day is first: <em>on Monday at 10 o'clock</em>.",
        "tag": "on"
      },
      {
        "html": "<strong>in</strong> + months, years, seasons and parts of the day: <em>in May, in 2025, in winter, in the morning, in the afternoon, in the evening</em>. But: <em>at night</em>.",
        "tag": "in"
      },
      {
        "html": "Use <strong>no preposition</strong> before <em>this, next, last, every, today, tomorrow, yesterday</em>: <em>See you tomorrow. I work every day. She called last night.</em> Not ✗ <em>on tomorrow</em> or ✗ <em>in next week</em>.",
        "tag": "no preposition"
      },
      {
        "html": "Typical mistakes: ✗ <em>in Monday</em> → ✓ <em>on Monday</em> · ✗ <em>at 2025</em> → ✓ <em>in 2025</em> · ✗ <em>in the night</em> → ✓ <em>at night</em> · ✗ <em>on the morning</em> → ✓ <em>in the morning</em> · ✗ <em>in Monday morning</em> → ✓ <em>on Monday morning</em>",
        "tag": "Typical mistakes"
      }
    ],
    "noteHtml": "A little help: <em>at</em> is for a point in time (a clock time), <em>on</em> is for a day, <em>in</em> is for a longer time (a month, a year, a season). The same three words are used for places: see <a href=\"/prepositions-of-place\">Prepositions of place</a>. For questions with <em>when</em> and <em>what time</em>, see <a href=\"/wh-questions\">Wh- questions</a>.",
