---
// „Was hast du vor?“ — the guided way into /teachers, the teachers' counterpart to the
// learners' „Wo anfangen?“. Instead of eight cards side by side, a teacher picks a goal and
// answers one or two questions (Niveau, Themenblock); the last step lays out what to use,
// in the order of the lesson, with every link already set to that level and block:
// Stundenplan, one Arbeitsmappe with the block's grammar sheets, the Live-Quiz per grammar
// chapter, a printable game.
//
//   stunde        Niveau → Block → Material   (the next lesson)
//   kurs          Niveau → Material           (a new course: test, survey, course plan)
//   kennenlernen  Material                    (a new class, level unknown)
//   vertretung    Niveau → Material           (no preparation, ready to play)
//
// The blocks are those of /syllabus (src/data/kursinhalte.json), the grammar resolved the
// way /teachers/timetable resolves it, so the wizard only links sheets and quiz
// chapters that exist. The choice is kept in the address (?ziel=stunde&niveau=a1-1&block=2)
// and on this device, so the next visit opens where the teacher left off.
// English only (lang="en"), written into the script, no i18n keys — like the course plan
// and the Stundenplan.
import Icon from "./Icon.astro";
import data from "../data/kursinhalte.json";
import { grammarByKey } from "../lib/grammarCatalog.js";
import { lexiconCounts } from "../lib/catalog.js";
import { grammarKeys, cefrOf } from "../lib/stundenplan.js";
import { sheetTopics, topicSlug } from "../lib/arbeitsblatt/grammatik.js";
import { hasChapter } from "../lib/liveQuiz/chapters.js";

const GAME_LEVELS = ["A1", "A2", "B1", "B2"]; // what the printable games accept (src/lib/spiele/common.js)
const sheets = new Set(sheetTopics.map(topicSlug));

const levels = data.niveaus.map((l) => {
  const cefr = cefrOf(l.label);
  return {
    id: l.id,
    label: l.label,
    titel: l.titel,
    cefr,
    games: GAME_LEVELS.includes(cefr),
    words: lexiconCounts[cefr]?.words ? `/vocabulary/${cefr.toLowerCase()}` : null,
    blocks: l.bloecke.map((b) => {
      const keys = [...new Set(b.grammatik.flatMap((g) => grammarKeys(g, cefr, grammarByKey)))];
      return {
        thema: b.thema,
        ziel: b.kannZiele[0] ?? "",
        grammar: keys.map((k) => ({
          key: k,
          name: grammarByKey(k)!.name,
          href: grammarByKey(k)!.href,
          sheet: sheets.has(k),
          quiz: hasChapter(`g-${k}`),
        })),
      };
    }),
  };
});

const goals = [
  { id: "stunde", icon: "pencil", title: "Prepare the next lesson", hint: "Plan, worksheets and a quiz for one topic block" },
  { id: "kurs", icon: "graduation-cap", title: "Plan a new course", hint: "Test the class, ask what they want, course plan" },
  { id: "kennenlernen", icon: "user", title: "Get to know the class first", hint: "Level not clear yet: test and ask" },
  { id: "vertretung", icon: "sparkle", title: "Cover lesson in 5 minutes", hint: "No preparation: quiz and games" },
];
---
<section class="lw" lang="en" aria-labelledby="lw-title" data-lw>
  <h2 id="lw-title" class="lw-title">What are you planning?</h2>
  <div class="lw-goals" data-lw-goals>
    {goals.map((g) => (
      <button type="button" class="lw-goal" data-goal={g.id} aria-pressed="false">
        <span class="lw-goal-ic" aria-hidden="true"><Icon name={g.icon} size={20} /></span>
        <span class="lw-goal-txt"><b>{g.title}</b><i>{g.hint}</i></span>
      </button>
    ))}
  </div>
  <ol class="lw-steps" data-lw-steps hidden></ol>
  <div class="lw-body" data-lw-body aria-live="polite"></div>
  <script type="application/json" data-lw-data set:html={JSON.stringify(levels)}></script>
</section>

<style>
  .lw {
    margin: 0 0 var(--space-6);
    padding: 18px 16px;
    border: 1px solid color-mix(in srgb, var(--brand-blue) 45%, var(--border));
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--blue-50), var(--surface-card) 60%);
  }
  .lw-title { margin: 0 0 12px; font-size: var(--text-xl); color: var(--ink); }
  .lw-goals { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .lw-goal {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 56px; padding: 10px 12px;
    font: inherit; text-align: left; color: var(--ink); cursor: pointer;
    background: var(--surface-card); border: 1px solid var(--border-strong); border-radius: 14px;
    transition: border-color .15s, box-shadow .15s;
  }
  .lw-goal:hover { border-color: var(--brand-blue); }
  .lw-goal[aria-pressed="true"] { border-color: var(--brand-blue); box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand-blue) 35%, transparent); }
  .lw-goal:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .lw-goal-ic {
    flex: none; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px;
    background: var(--gradient-brand); color: #fff;
  }
  .lw-goal-txt { display: grid; gap: 2px; min-width: 0; }
  .lw-goal-txt b { font-size: var(--text-sm); }
  .lw-goal-txt i { font-style: normal; font-size: var(--text-xs); color: var(--muted); }
  /* Once a goal is chosen the other three shrink to one line, so the steps sit near the top
     of a phone screen; a tap on another still switches. */
  .lw.has-goal .lw-goal { min-height: 44px; padding: 6px 10px; }
  .lw.has-goal .lw-goal i, .lw.has-goal .lw-goal-ic { display: none; }
  .lw.has-goal .lw-goals { grid-template-columns: 1fr 1fr; }
  .lw.has-goal .lw-goal-txt b { font-size: var(--text-xs); }

  /* The step chips are written by the script, so their rules are :global (Astro scopes
     only what the template renders). */
  .lw-steps { display: flex; flex-wrap: wrap; gap: 6px; margin: 16px 0 10px; padding: 0; list-style: none; counter-reset: lw; }
  .lw-steps :global(li) { counter-increment: lw; }
  .lw-steps :global(button), .lw-steps :global(span) {
    display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 12px;
    font: inherit; font-size: var(--text-xs); font-weight: var(--fw-semibold);
    border-radius: var(--radius-pill); border: 1px solid var(--border); background: var(--surface-card); color: var(--muted);
  }
  .lw-steps :global(button) { cursor: pointer; color: var(--brand-blue-dark); border-color: var(--border-strong); }
  .lw-steps :global(button)::before, .lw-steps :global(span)::before { content: counter(lw); font-weight: var(--fw-bold); }
  .lw-steps :global([aria-current="step"]) { background: var(--brand-blue); border-color: var(--brand-blue); color: #fff; }

  .lw-body :global(.lw-q) { margin: 4px 0 10px; font-weight: var(--fw-semibold); color: var(--ink); }
  .lw-body :global(.lw-q small) { font-weight: var(--fw-regular); color: var(--muted); }
  .lw-body :global(.lw-pick) { display: grid; grid-template-columns: 1fr; gap: 6px; }
  .lw-body :global(.lw-pick button) {
    display: flex; align-items: baseline; gap: 10px; width: 100%; min-height: 44px; padding: 10px 12px;
    font: inherit; font-size: var(--text-sm); text-align: left; color: var(--ink); cursor: pointer;
    background: var(--surface-card); border: 1px solid var(--border); border-radius: 12px;
  }
  .lw-body :global(.lw-pick button:hover) { border-color: var(--brand-blue); }
  .lw-body :global(.lw-pick button.is-on) { border-color: var(--brand-blue); background: var(--blue-50); }
  .lw-body :global(.lw-pick b) { flex: none; min-width: 3.2em; color: var(--brand-blue-dark); }
  .lw-body :global(.lw-pick small) { display: block; margin-top: 2px; color: var(--muted); font-size: var(--text-xs); }
  .lw-body :global(.lw-aside) { margin: 10px 0 0; font-size: var(--text-sm); color: var(--muted); }
  .lw-body :global(.lw-aside a), .lw-body :global(.lw-q a), .lw-body :global(.lw-res p a) { color: var(--brand-blue-dark); font-weight: var(--fw-semibold); }

  .lw-body :global(.lw-sum) { margin: 4px 0 12px; font-size: var(--text-sm); color: var(--muted); }
  .lw-body :global(.lw-sum b) { color: var(--ink); }
  .lw-body :global(.lw-res) { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; counter-reset: lwr; }
  .lw-body :global(.lw-res > li) {
    counter-increment: lwr; position: relative; display: grid; gap: 6px;
    padding: 12px 12px 12px 46px; background: var(--surface-card); border: 1px solid var(--border); border-radius: 14px;
  }
  .lw-body :global(.lw-res > li::before) {
    content: counter(lwr); position: absolute; left: 12px; top: 12px;
    display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--brand-blue); color: #fff; font-size: var(--text-xs); font-weight: var(--fw-bold);
  }
  .lw-body :global(.lw-res h3) { margin: 0; text-align: left; font-size: var(--text-base); color: var(--ink); }
  .lw-body :global(.lw-res p) { margin: 0; font-size: var(--text-sm); line-height: 1.5; color: var(--muted); }
  .lw-body :global(.lw-acts) { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 2px; }
  .lw-body :global(.lw-acts a) {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px;
    border-radius: var(--radius-pill); border: 1px solid var(--border-strong);
    color: var(--ink); font-size: var(--text-sm); font-weight: var(--fw-semibold); text-decoration: none;
  }
  .lw-body :global(.lw-acts a:hover) { border-color: var(--brand-blue); }
  .lw-body :global(.lw-acts a.lw-main) { border-color: transparent; background: var(--gradient-brand); color: #fff; }
  .lw-body :global(.lw-acts a:focus-visible) { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .lw-body :global(.lw-next) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .lw-body :global(.lw-next button) {
    min-height: 40px; padding: 0 14px; font: inherit; font-size: var(--text-sm); font-weight: var(--fw-semibold);
    border-radius: var(--radius-pill); border: 1px solid var(--border-strong); background: var(--surface-card); color: var(--brand-blue-dark); cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lw-body :global(> *) { animation: lw-in .22s ease both; }
    @keyframes lw-in { from { opacity: 0; transform: translateY(6px); } }
  }
  @media (min-width: 720px) {
    .lw { padding: 22px; }
    .lw-goals { grid-template-columns: 1fr 1fr; }
    .lw-body :global(.lw-pick) { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
import { currentPath } from "../lib/paths.js";
  type Grammar = { key: string; name: string; href: string; sheet: boolean; quiz: boolean };
  type Block = { thema: string; ziel: string; grammar: Grammar[] };
  type Level = { id: string; label: string; titel: string; cefr: string; games: boolean; words: string | null; blocks: Block[] };
  type State = { ziel?: string; niveau?: string; block?: number; step?: string };

  const root = document.querySelector<HTMLElement>("[data-lw]");
  if (root) {
    const levels: Level[] = JSON.parse(root.querySelector("[data-lw-data]")!.textContent!);
    const goalsEl = root.querySelector<HTMLElement>("[data-lw-goals]")!;
    const stepsEl = root.querySelector<HTMLOListElement>("[data-lw-steps]")!;
    const body = root.querySelector<HTMLElement>("[data-lw-body]")!;
    const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
    const KEY = "lk-wegweiser";

    // Which questions each goal asks before the material.
    const FLOW: Record<string, string[]> = {
      stunde: ["niveau", "block", "material"],
      kurs: ["niveau", "material"],
      kennenlernen: ["material"],
      vertretung: ["niveau", "material"],
    };
    const STEP_NAME: Record<string, string> = { niveau: "Level", block: "Topic block", material: "Materials" };

    let st: State = {};
    const level = () => levels.find((l) => l.id === st.niveau) ?? null;
    const block = () => (level() && st.block ? level()!.blocks[st.block - 1] ?? null : null);

    // The first step of the flow whose answer is still missing.
    const due = () => FLOW[st.ziel!].find((s) => (s === "niveau" && !level()) || (s === "block" && !block()) || s === "material")!;

    function save() {
      const p = new URLSearchParams(location.search);
      for (const k of ["ziel", "niveau", "block"]) p.delete(k);
      if (st.ziel) p.set("ziel", st.ziel);
      if (st.niveau && FLOW[st.ziel!]?.includes("niveau")) p.set("niveau", st.niveau);
      if (st.block && FLOW[st.ziel!]?.includes("block")) p.set("block", String(st.block));
      const qs = p.toString();
      history.replaceState(null, "", currentPath() + (qs ? `?${qs}` : "") + location.hash);
      try { localStorage.setItem(KEY, JSON.stringify({ ziel: st.ziel, niveau: st.niveau, block: st.block })); } catch {}
    }

    const link = (href: string, label: string, main = false, blank = false) =>
      `<a href="${esc(href)}"${main ? ' class="lw-main"' : ""}${blank ? ' target="_blank" rel="noopener"' : ""}>${esc(label)}</a>`;
    const item = (title: string, text: string, acts: string[]) =>
      `<li><h3>${esc(title)}</h3><p>${text}</p>${acts.length ? `<div class="lw-acts">${acts.join("")}</div>` : ""}</li>`;

    function stepsBar(cur: string) {
      const flow = FLOW[st.ziel!];
      stepsEl.hidden = flow.length < 2;
      const answer: Record<string, string> = {
        niveau: level()?.label ?? "",
        block: block() ? `Block ${st.block}` : "",
      };
      stepsEl.innerHTML = flow.map((s) => {
        const label = answer[s] ? `${STEP_NAME[s]}: ${esc(answer[s])}` : STEP_NAME[s];
        if (s === cur) return `<li><span aria-current="step">${label}</span></li>`;
        // Steps already answered can be reopened; later ones are just shown.
        return answer[s] ? `<li><button type="button" data-goto="${s}">${label}</button></li>` : `<li><span>${label}</span></li>`;
      }).join("");
    }

    function askLevel() {
      body.innerHTML = `
        <p class="lw-q">What level is your class?</p>
        <div class="lw-pick">${levels.map((l) => `
          <button type="button" data-niveau="${l.id}"${l.id === st.niveau ? ' class="is-on"' : ""}><b>${esc(l.label)}</b><span>${esc(l.titel)}</span></button>`).join("")}
        </div>
        <p class="lw-aside">Not sure? <a href="/teachers/tests">Let the class take the placement test</a> on their phones via QR code.</p>`;
    }

    function askBlock() {
      const l = level()!;
      body.innerHTML = `
        <p class="lw-q">Which topic block is next? <small>(${esc(l.label)} · from the <a href="/syllabus/${l.id}">syllabus</a>)</small></p>
        <div class="lw-pick">${l.blocks.map((b, i) => `
          <button type="button" data-block="${i + 1}"${i + 1 === st.block ? ' class="is-on"' : ""}><b>${i + 1}</b><span>${esc(b.thema)}${b.grammar.length ? `<small>${esc(b.grammar.map((g) => g.name).join(" · "))}</small>` : ""}</span></button>`).join("")}
        </div>`;
    }

    const planHref = (l: Level, b: number, n: number) => `/teachers/timetable?niveau=${l.id}&block=${b}&stunden=${n}&min=90`;

    function material() {
      const l = level();
      const out: string[] = [];
      let sum = "";
      let next = "";
      if (st.ziel === "stunde" && l && block()) {
        const b = block()!;
        sum = `<b>${esc(l.label)} · Block ${st.block}: ${esc(b.thema)}</b>${b.ziel ? `<br>${esc(b.ziel)}` : ""}`;
        out.push(item("Plan the lesson", "A lesson plan with stages, timings and interaction patterns. You set the length and number of lessons there.",
          [link(planHref(l, st.block!, 1), "Open lesson plan", true)]));
        const sheets = b.grammar.filter((g) => g.sheet);
        if (sheets.length) out.push(item("Print worksheets",
          `${sheets.length === 1 ? "The worksheet" : `All ${sheets.length} worksheets`} for this block's grammar in one PDF, with answers: ${sheets.map((g) => `<a href="${esc(g.href)}">${esc(g.name)}</a>`).join(", ")}.`,
          [link(`/teachers/worksheets/folder?g=${sheets.map((g) => g.key).join(",")}`, "Open workbook", true)]));
        else out.push(item("Worksheets", "There is no grammar worksheet for this block yet. Vocabulary sheets are listed by study set.",
          [link("/teachers/worksheets", "Open worksheets")]));
        const quiz = b.grammar.filter((g) => g.quiz);
        out.push(item("Consolidate on the projector", "Live quiz: you show the QR code, everyone plays on their phone.",
          quiz.length ? quiz.map((g, i) => link(`/teachers/quiz?grammar=g-${g.key}`, `Quiz: ${g.name}`, i === 0, true))
            : [link("/teachers/quiz", "Open live quiz", true, true)]));
        if (l.games) out.push(item("Finish with a game", `A printable game with the ${l.cefr} vocabulary, shuffled anew each time.`,
          [link(`/teachers/games/bingo?level=${l.cefr}`, "Bingo", true), link(`/teachers/games/domino?level=${l.cefr}`, "Domino"), link(`/teachers/games/explain?level=${l.cefr}`, "Explain the word")]));
        if (st.block! < l.blocks.length) next = `<button type="button" data-block-next>On to block ${st.block! + 1} →</button>`;
      } else if (st.ziel === "kurs" && l) {
        sum = `<b>New course ${esc(l.label)}</b> · ${esc(l.titel)}`;
        out.push(item("Check the level", "The class takes the placement test on their phones, with names and no account. You see who stands where and which topics are not secure yet. Needs a free account.",
          [link("/teachers/tests", "Create a test", true)]));
        out.push(item("Ask what they want", "Anonymously via QR code: which grammar, more speaking or writing, what pace.",
          [link("/teachers/surveys", "Start a survey", true)]));
        out.push(item("See the whole course", `The ${l.blocks.length} topic blocks of ${esc(l.label)} with learning goals, grammar and vocabulary.`,
          [link(`/syllabus/${l.id}`, "Open syllabus", true), link(planHref(l, 1, 3), "Lesson plan for block 1")]));
        out.push(item("Set up a class", "Share the code: you see who practises between lessons. Needs a free account.",
          [link("/teachers/classes", "Set up a class", true)]));
        next = `<button type="button" data-goal-switch="stunde">Prepare the first lesson →</button>`;
      } else if (st.ziel === "kennenlernen") {
        sum = "<b>New class, level not clear yet</b>";
        out.push(item("Start relaxed", "A vocabulary live quiz on the projector: everyone plays on their phone, no sign-up.",
          [link("/teachers/quiz", "Open live quiz", true, true)]));
        out.push(item("Find out the level", "Placement test via QR code: each person's level from A1 to B2 and the most common mistakes. Needs a free account.",
          [link("/teachers/tests", "Create a test", true)]));
        out.push(item("Ask what they want", "Anonymously: what does the class want to learn, and at what pace?",
          [link("/teachers/surveys", "Start a survey", true)]));
        next = `<button type="button" data-goal-switch="kurs">Next: plan the course →</button>`;
      } else if (st.ziel === "vertretung" && l) {
        sum = `<b>Cover lesson ${esc(l.label)}</b> · no preparation, no account`;
        out.push(item("Live quiz on the projector", `In the quiz, choose “Random mix” and ${l.cefr}: words and grammar of the level, shuffled anew each round.`,
          [link("/teachers/quiz", "Open live quiz", true, true)]));
        if (l.games) out.push(item("Printable games", `With the ${l.cefr} vocabulary. All you need is a printer.`,
          [link(`/teachers/games/explain?level=${l.cefr}`, "Explain the word", true), link(`/teachers/games/bingo?level=${l.cefr}`, "Bingo"), link(`/teachers/games/domino?level=${l.cefr}`, "Domino")]));
        out.push(item("Worksheet for quiet work", "For every grammar topic and study set, with an answer sheet. Or let them fill it in online.",
          [link("/teachers/worksheets", "Open worksheets", true), ...(l.words ? [link(l.words, `Word list ${l.cefr}`)] : [])]));
      }
      body.innerHTML = `
        <p class="lw-sum">${sum}</p>
        <ol class="lw-res">${out.join("")}</ol>
        ${next ? `<div class="lw-next">${next}</div>` : ""}`;
    }

    function render(step?: string) {
      root!.classList.toggle("has-goal", !!st.ziel);
      goalsEl.querySelectorAll<HTMLButtonElement>("[data-goal]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.goal === st.ziel)));
      if (!st.ziel) { stepsEl.hidden = true; body.innerHTML = ""; return; }
      const cur = step ?? due();
      stepsBar(cur);
      if (cur === "niveau") askLevel();
      else if (cur === "block") askBlock();
      else material();
      save();
    }

    const scrollIn = () => {
      const top = root!.getBoundingClientRect().top;
      if (top < 0) root!.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
    };

    goalsEl.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-goal]");
      if (!b) return;
      st.ziel = b.dataset.goal;
      render();
    });
    stepsEl.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-goto]");
      if (b) render(b.dataset.goto);
    });
    body.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const nv = t.closest<HTMLButtonElement>("[data-niveau]");
      const bl = t.closest<HTMLButtonElement>("[data-block]");
      const sw = t.closest<HTMLButtonElement>("[data-goal-switch]");
      if (nv) {
        if (nv.dataset.niveau !== st.niveau) st.block = undefined;
        st.niveau = nv.dataset.niveau;
      } else if (bl) st.block = Number(bl.dataset.block);
      else if (t.closest("[data-block-next]")) st.block = (st.block ?? 0) + 1;
      else if (sw) { st.ziel = sw.dataset.goalSwitch; if (st.ziel === "stunde") st.block = 1; }
      else return;
      render();
      scrollIn();
    });

    // From the address first (a shared or bookmarked link), else where this device left off.
    const q = new URLSearchParams(location.search);
    let saved: State = {};
    try { saved = JSON.parse(localStorage.getItem(KEY) ?? "{}") ?? {}; } catch {}
    const from = q.get("ziel") ? { ziel: q.get("ziel")!, niveau: q.get("niveau") ?? undefined, block: Number(q.get("block")) || undefined } : saved;
    if (from.ziel && FLOW[from.ziel]) {
      st = { ziel: from.ziel, niveau: levels.some((l) => l.id === from.niveau) ? from.niveau : undefined, block: from.block };
      if (st.block && (!level() || !block())) st.block = undefined;
      render();
    }
  }
</script>
