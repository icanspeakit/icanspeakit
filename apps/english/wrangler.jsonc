{
  // icanspeak English — https://icanspeak.it/english/*
  // Assets only (no Worker code): the static build, copied under english/ by
  // `pnpm cf:prepare` (scripts/nest-dist.mjs), because the route keeps the /english prefix.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "icanspeak-english",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./cf-dist",
    "not_found_handling": "404-page",
    // Canonicals, sitemap and internal links have no trailing slash (/english/grammar); serve
    // grammar/index.html there directly instead of redirecting to /english/grammar/.
    // _headers sits at the root of cf-dist (moved there by `pnpm cf:prepare`).
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    { "pattern": "icanspeak.it/english", "zone_name": "icanspeak.it" },
    { "pattern": "icanspeak.it/english/*", "zone_name": "icanspeak.it" }
  ]
}
