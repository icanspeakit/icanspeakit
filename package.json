{
  "name": "icanspeakit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./apps/* build",
    "build:hub": "pnpm --filter @icanspeak/hub build",
    "build:english": "pnpm --filter englishacademy build",
    "build:linguistics": "pnpm --filter @icanspeak/linguistics build",
    "check:base": "pnpm -r --filter ./apps/* --if-present check:base",
    "deploy": "pnpm -r --filter ./apps/* --if-present deploy"
  }
}
