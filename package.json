{
  "name": "icanspeakit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter ./apps/* build",
    "build:hub": "pnpm --filter @icanspeak/hub build",
    "build:english": "pnpm --filter englishacademy build",
    "build:linguistics": "pnpm --filter @icanspeak/linguistics build",
    "check:base": "pnpm -r --filter ./apps/* --if-present check:base",
    "deploy": "pnpm -r --filter @icanspeak/linguistics --filter englishacademy --filter @icanspeak/spanish --filter @icanspeak/french --filter @icanspeak/italian --filter @icanspeak/hub run deploy",
    "check:links": "node scripts/check-links.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:spanish": "pnpm --filter @icanspeak/spanish build",
    "build:french": "pnpm --filter @icanspeak/french build",
    "build:portuguese": "pnpm --filter @icanspeak/portuguese build",
    "build:italian": "pnpm --filter @icanspeak/italian build",
    "build:admin": "pnpm --filter @icanspeak/admin build"
  }
}
