  "id": "trennbare-verben",
  "name": "ir a + infinitive: voy a llamar",
  "level": "A2",
  "status": "entwurf",
  "variety": "es-ES",
  "es419": { "note": "Used the same way, and very often, in Latin America. Vais a is Spain only: there people say ustedes van a." },
  "subtitle": "To talk about plans and the near future, use ir + a + infinitive: Voy a llamar al médico. Mañana vamos a buscar piso. Only ir changes. The second verb stays in the infinitive.",
  "briefMarks": ["voy a", "vas a", "va a", "vamos a", "vais a", "van a"],
  "source": "icanspeak Spanish original text (grammar-a2 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "voy · vas · va · vamos · vais · van", "variant": "verb" },
      { "text": "a", "variant": "prep" },
      { "text": "infinitive", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-verb\">Voy</span> <span class=\"vp-prep\">a</span> <span class=\"vp-verb\">llamar</span> al médico. · Mañana <span class=\"vp-verb\">vamos</span> <span class=\"vp-prep\">a</span> <span class=\"vp-verb\">comer</span> fuera. · ¿Qué <span class=\"vp-verb\">vas</span> <span class=\"vp-prep\">a</span> <span class=\"vp-verb\">hacer</span>? · No <span class=\"vp-verb\">van</span> <span class=\"vp-prep\">a</span> <span class=\"vp-verb\">venir</span>.",
    "qa": [
      {
        "html": "Use it for <strong>plans</strong> and for what you can see is about to happen: <em>Este año voy a estudiar español. Mira, va a llover.</em> It is the usual way to talk about the future in everyday speech.",
        "tag": "When"
      },
      {
        "html": "Three parts: <strong>ir</strong> in the present + <strong>a</strong> + <strong>infinitive</strong>. Don't leave out <em>a</em>. Don't change the second verb: <em>Voy a trabajar</em>, not <em>Voy a trabajo</em>.",
        "tag": "Three parts"
      },
      {
        "html": "<strong>no</strong> goes before ir: <em>No voy a ir.</em> Questions just change the tone: <em>¿Vas a venir?</em> With a question word: <em>¿Cuándo vais a volver? ¿Qué van a comprar?</em>",
        "tag": "no, questions"
      },
      {
        "html": "Small pronouns can go <strong>before ir</strong> or <strong>on the end of the infinitive</strong>: <em>Lo voy a hacer. = Voy a hacerlo. Me voy a duchar. = Voy a ducharme.</em>",
        "tag": "Pronouns"
      },
      {
        "html": "Time words: <em>luego, esta tarde, esta noche, mañana, pasado mañana, la semana que viene, el mes que viene, el año que viene</em>.",
        "tag": "Time words"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Voy trabajar</em> → ✓ <em>Voy a trabajar</em>. ✗ <em>Voy a trabajo mañana</em> → ✓ <em>Voy a trabajar mañana</em>. ✗ <em>Mañana voy a voy</em> → ✓ <em>Mañana voy a ir</em>. ✗ <em>Voy a no ir</em> → ✓ <em>No voy a ir</em>. Don't mix it up with going somewhere: <em>Voy a Madrid</em> (place) and <em>Voy a ir a Madrid</em> (plan).",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "The form",
          "head": ["Who", "ir", "a", "infinitive"],
