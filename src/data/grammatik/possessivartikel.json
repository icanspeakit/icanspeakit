{
  "id": "possessivartikel",
  "name": "Possessives: mi, tu, su, nuestro, vuestro",
  "level": "A1",
  "variety": "es-ES",
  "es419": { "note": "Latin America uses su, sus instead of vuestro for “your” with several people. Su also covers usted and ustedes." },
  "subtitle": "Whose is it? Mi casa, tu coche, su hijo. The possessive matches the thing you have, not the person who has it: mis llaves, nuestra casa. Owners can also come with de: el coche de Ana.",
  "briefMarks": ["mi", "tu", "su", "nuestro", "vuestro", "de"],
  "source": "icanspeak Spanish original text (grammar-a1 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "mi / tu / su / nuestro / vuestro", "variant": "prep" },
      { "text": "noun", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">mi</span> <span class=\"vp-verb\">hijo</span> → <span class=\"vp-prep\">mis</span> <span class=\"vp-verb\">hijos</span> · <span class=\"vp-prep\">nuestra</span> <span class=\"vp-verb\">casa</span> → <span class=\"vp-prep\">nuestras</span> <span class=\"vp-verb\">casas</span>",
    "qa": [
      {
        "html": "<strong>mi, tu, su</strong> have a plural with <strong>-s</strong>: <em>mi libro, mis libros; tu llave, tus llaves; su hijo, sus hijos</em>.",
        "tag": "mi, tu, su"
      },
      {
        "html": "<strong>nuestro</strong> and <strong>vuestro</strong> have four forms: <em>nuestro piso, nuestra casa, nuestros hijos, nuestras hijas</em>.",
        "tag": "nuestro, vuestro"
      },
      {
        "html": "The form matches the <strong>thing</strong>, not the owner: <em>Ana y Pablo tienen una casa: <strong>su</strong> casa.</em> <em>Ana tiene dos hijos: <strong>sus</strong> hijos.</em>",
        "tag": "Match the thing"
      },
      {
        "html": "<strong>su</strong> can mean his, her, its, their, or your (polite). If that is not clear, use <strong>de</strong>: <em>el coche de Ana, la casa de usted</em>.",
        "tag": "su = many things"
      },
      {
        "html": "Spanish has no <em>’s</em>. Say <strong>el / la + thing + de + owner</strong>: <em>la hija de Carmen, el piso de mis padres</em>. Not: <em>Carmen hija</em>.",
        "tag": "de for owners"
      },
      {
        "html": "<strong>tu</strong> = your. <strong>tú</strong> = you: <em>Tú tienes tu llave.</em> For your body and clothes, Spanish often uses <em>el, la</em>: <em>Me duele la cabeza.</em>",
        "tag": "tu or tú"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>mi llaves</em> → ✓ <em>mis llaves</em>. ✗ <em>nuestro casa</em> → ✓ <em>nuestra casa</em>. ✗ <em>Ana’s coche</em> → ✓ <em>el coche de Ana</em>. ✗ <em>su hijos</em> for one owner → ✓ <em>sus hijos</em>. ✗ <em>el mi libro</em> → ✓ <em>mi libro</em>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "All the forms",
          "head": ["Owner", "one thing", "more than one thing"],
          "rows": [
            ["yo", "mi", "mis"],
            ["tú", "tu", "tus"],
