              "different from mine"
            ],
            [
              "worried / angry (a thing)",
              "{about}",
              "worried about the exam"
            ],
            [
              "angry (a person)",
              "{with}",
              "angry with her brother"
            ]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "After the preposition",
          "variant": "akk",
          "items": [
            "noun: proud of my sister",
            "-ing form: good at cooking, tired of waiting",
            "Never to + infinitive: ✗ good at to cook",
            "Negative: worried about not passing"
          ]
        },
        {
          "badge": "Careful",
          "variant": "dat",
