  "id": "satzstellung",
  "name": "Countable and uncountable nouns: much, many, a few, a little",
  "level": "A2",
  "subtitle": "Count it with many and a few, measure it with much and a little: many books, much water, a few friends, a little time. A lot of works with both.",
  "briefMarks": [
    "many",
    "much",
    "a few",
    "a little",
    "a lot of"
  ],
