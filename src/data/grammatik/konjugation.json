            ["salir", "salgo", "sales", "go out, leave"],
            ["traer", "traigo", "traes", "bring"],
            ["conocer", "conozco", "conoces", "know (a person, a place)"],
            ["saber", "sé", "sabes", "know (a fact)"],
            ["ver", "veo", "ves", "see"],
            ["dar", "doy", "das", "give"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: accents",
          "variant": "dat",
          "items": [
            "estar: estás, está, están need the accent. esta without an accent means “this”.",
            "saber: sé (I know) needs the accent. se is another word."
          ]
        }
      ]
    }
  },
