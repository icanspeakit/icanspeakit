          "caption": "Noun + noun",
          "tag": "{bus} + {stop} = {bus stop}",
          "left": {
            "name": "hamsti",
            "expr": "thinking",
            "say": "What do we call the place where the bus stops?"
          },
          "right": {
            "name": "bruno",
            "expr": "happy",
            "say": "A {bus stop}! Two nouns make one new noun: {bus} + {stop}."
          }
        },
        {
          "caption": "The main word",
          "tag": "the {second} noun is the main one",
          "left": {
            "name": "regi",
            "expr": "thinking",
            "say": "Is a toothbrush a tooth or a brush?"
          },
          "right": {
            "name": "quaki",
            "expr": "happy",
            "say": "It's a {brush}! The second noun is the main one. The first noun says what kind."
          }
        },
