    "qa": [
      {
        "tag": "Wohin? Akkusativ",
        "html": "Etwas bewegt sich zu einem Ziel. <em>Ich gehe <strong>ins</strong> Kino. Ich stelle die Vase auf <strong>den</strong> Tisch.</em>"
      },
      {
        "tag": "Wo? Dativ",
        "html": "Es ist schon da, ohne Bewegung zu einem Ziel. <em>Ich bin <strong>im</strong> Kino. Die Vase steht auf <strong>dem</strong> Tisch.</em>"
      },
      {
        "tag": "Die Neun",
        "html": "<strong>in, an, auf, über, unter, vor, hinter, neben, zwischen</strong>. Nur diese neun Präpositionen wechseln zwischen Akkusativ und Dativ."
      },
      {
        "tag": "im oder ins?",
        "html": "Wohin? <em>in + das = <strong>ins</strong>, an + das = <strong>ans</strong></em>. Wo? <em>in + dem = <strong>im</strong>, an + dem = <strong>am</strong></em>."
      },
      {
        "tag": "Verbpaare",
        "html": "Wohin? <strong>stellen, legen, setzen, hängen</strong>. Wo? <strong>stehen, liegen, sitzen, hängen</strong>. Stellen und stehen: aufrecht, vertikal (Flasche, Vase). Legen und liegen: flach, horizontal (Buch, Handy). Setzen und sitzen: Menschen und Tiere."
      },
      {
        "tag": "Trick",
        "html": "Die Wohin-Verben haben ein Objekt: <em>Ich lege <strong>das Buch</strong> …</em> Die Wo-Verben haben keins: <em>Das Buch liegt …</em> Im Perfekt: <em>gelegt</em> heißt Wohin, <em>gelegen</em> heißt Wo."
      }
    ],
    "noteHtml": "Das Verb hilft: <strong>Bewegungsverben</strong> (gehen, fahren, bringen, legen, stellen) fragen <em>Wohin?</em> <strong>Zustandsverben</strong> (sein, wohnen, sitzen, stehen, liegen) fragen <em>Wo?</em>",
