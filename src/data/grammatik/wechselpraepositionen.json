  "id": "wechselpraepositionen",
  "name": "Prepositions of movement",
  "level": "A2",
  "subtitle": "Prepositions of movement show where something goes: into, out of, onto, off, through, across, along, past, up and down. Compare position and movement: She is in the room. She walks into the room.",
  "briefMarks": [
    "into",
    "out of",
    "through",
    "across"
  ],
  "source": "EnglishAcademy original English text (grammar-a2 run, 2026-10-29)",
  "concept": {
    "comic": {
      "title": "{Into} the café or {in} the café?",
      "panels": [
        {
          "caption": "The plan",
          "tag": "Movement: {into}. Position: {in}.",
          "left": {
            "name": "quaki",
            "expr": "happy",
            "say": "Let's go {into} the café!"
          },
