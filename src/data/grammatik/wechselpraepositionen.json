    "comicRule": {
      "title": "Was passiert im Comic?",
      "lead": "Im Comic passiert immer dasselbe: Erst bewegt jemand etwas, dann ist es da. Fragen Sie bei jedem Satz: <strong>Bewegt sich gerade etwas?</strong> Dann heißt die Frage <em>Wohin?</em> und es folgt der Akkusativ. <strong>Ist es schon da?</strong> Dann heißt die Frage <em>Wo?</em> und es folgt der Dativ.",
      "steps": [
        {
          "name": "hamsti",
          "expr": "happy",
          "q": "wohin",
          "say": "Ich <strong>stelle</strong> die Lampe neben <strong>das</strong> Sofa.",
          "why": "Hamsti trägt die Lampe an einen neuen Platz. Wohin stellt er sie? Neben das Sofa. Bewegung, also Akkusativ: <em>das</em> Sofa."
        },
        {
          "name": "regi",
          "expr": "thinking",
          "q": "wo",
          "say": "Jetzt <strong>steht</strong> sie neben <strong>dem</strong> Sofa.",
          "why": "Niemand bewegt die Lampe mehr, sie ist einfach da. Wo steht sie? Neben dem Sofa. Ort, also Dativ: <em>dem</em> Sofa."
        },
        {
          "name": "bruno",
          "expr": "happy",
          "q": "wohin",
          "say": "Ich <strong>hänge</strong> das Bild an <strong>die</strong> Wand.",
          "why": "Bruno tut etwas mit dem Bild. Das Bild ist das Objekt im Akkusativ, und die Wand ist das Ziel: an <em>die</em> Wand."
        },
        {
          "name": "quaki",
          "expr": "celebrate",
          "q": "wo",
          "say": "Es <strong>hängt</strong> an <strong>der</strong> Wand.",
          "why": "Dasselbe Verb, aber jetzt ohne Objekt: Das Bild ist einfach da. Wo? An <em>der</em> Wand. Erst in der Vergangenheit sieht man den Unterschied: Bruno <em>hängte</em> das Bild an die Wand. Danach <em>hing</em> es an der Wand."
        },
        {
          "name": "hamsti",
          "expr": "sleepy",
          "q": "wohin",
          "say": "Ich <strong>lege mich</strong> auf <strong>das</strong> Sofa.",
          "why": "Hier bewegt Hamsti sich selbst. Das Objekt ist <em>mich</em> (sich legen). Auch das ist Bewegung, also Akkusativ: auf <em>das</em> Sofa. Genauso: <em>sich setzen, sich stellen</em>."
        },
        {
          "name": "regi",
          "expr": "oops",
          "q": "wo",
          "say": "Du <strong>liegst</strong> auf <strong>dem</strong> Sofa und auf <strong>meinem</strong> Buch!",
          "why": "Hamsti bewegt sich nicht mehr, er liegt schon. Wo? Auf dem Sofa. Auch das Possessivpronomen steht im Dativ: auf <em>meinem</em> Buch."
        }
      ],
      "sumHtml": "Jede Bewegung endet an einem Ort: <em>Ich lege das Buch auf <strong>den</strong> Tisch.</em> Danach: <em>Das Buch liegt auf <strong>dem</strong> Tisch.</em> Im zweiten Comic geht es genauso: Quaki <em>setzt sich</em> auf <strong>den</strong> Stuhl (wohin), Regi <em>sitzt</em> schon auf <strong>dem</strong> Stuhl (wo)."
    }
