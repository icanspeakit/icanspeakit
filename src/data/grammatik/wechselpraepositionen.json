{
  "id": "wechselpraepositionen",
  "name": "a or en: going and being",
  "level": "A2",
  "variety": "es-ES",
  "es419": { "note": "The basic rule holds in Latin America. One difference: Spain says entrar en la oficina, while Latin America usually says entrar a la oficina." },
  "subtitle": "Use a for movement towards a place: Voy a Madrid. Use en for being in a place: Estoy en Madrid. With de… a and desde… hasta you say where a journey or a time starts and ends.",
  "briefMarks": ["a", "en", "al", "de… a", "desde… hasta"],
  "source": "icanspeak Spanish original text (grammar-a2 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "voy · llego · vuelvo + a", "variant": "prep" },
      { "text": "estoy · vivo · trabajo + en", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-verb\">Voy</span> <span class=\"vp-prep\">a</span> Madrid. · <span class=\"vp-verb\">Estoy</span> <span class=\"vp-prep\">en</span> Madrid. · <span class=\"vp-verb\">Llegamos</span> <span class=\"vp-prep\">al</span> trabajo a las ocho. · <span class=\"vp-verb\">Trabajo</span> <span class=\"vp-prep\">en</span> un hotel.",
    "qa": [
      {
        "html": "<strong>a</strong> = towards a place. It goes with verbs of movement: <em>ir, venir, llegar, volver, viajar, bajar, subir</em>. <em>Voy a la farmacia. Volvemos a casa.</em>",
        "tag": "Movement: a"
      },
      {
        "html": "<strong>en</strong> = inside or at a place, no movement: <em>estar, vivir, trabajar, comer, quedarse</em>. <em>Estoy en la farmacia. Vivo en Bilbao.</em>",
        "tag": "Being there: en"
      },
      {
        "html": "<strong>a + el = al</strong>: <em>Voy al médico. Llego al trabajo.</em> <em>a la, a los, a las</em> don't change.",
        "tag": "al"
      },
      {
        "html": "<strong>llegar</strong> takes <em>a</em>, even when you are there at the end: <em>Llego a Madrid a las diez.</em> <strong>entrar</strong> usually takes <em>en</em> in Spain: <em>Entro en la oficina.</em>",
        "tag": "llegar, entrar"
      },
      {
        "html": "How you travel takes <strong>en</strong>: <em>Voy en metro, en tren, en coche.</em> On foot is <strong>a pie</strong> or <strong>andando</strong>.",
        "tag": "en metro, a pie"
      },
      {
        "html": "Start and end: <strong>de… a</strong> or <strong>desde… hasta</strong>. <em>Trabajo de nueve a dos. El tren va de Madrid a Toledo. Vamos andando desde casa hasta el parque.</em> Where you come from takes <em>de</em>: <em>Vengo del trabajo.</em>",
        "tag": "Start and end"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Voy en Madrid</em> → ✓ <em>Voy a Madrid</em>. ✗ <em>Estoy a Madrid</em> → ✓ <em>Estoy en Madrid</em>. ✗ <em>Llego en casa</em> → ✓ <em>Llego a casa</em>. ✗ <em>Voy a el médico</em> → ✓ <em>Voy al médico</em>. ✗ <em>Voy por metro</em> → ✓ <em>Voy en metro</em>. For exact places, see <a href=\"/prepositions-of-place\">saying where</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "a or en",
          "head": ["Word", "Verbs", "Example"],
