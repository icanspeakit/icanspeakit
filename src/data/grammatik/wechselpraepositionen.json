          "head": ["Form", "Example", "Used for"],
          "rows": [
            ["de… a", "Trabajo de nueve a dos.", "time"],
            ["de… a", "El tren va de Madrid a Toledo.", "place"],
            ["desde… hasta", "Te espero desde las tres hasta las cinco.", "time"],
            ["desde… hasta", "Andamos desde casa hasta el parque.", "place"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful",
          "variant": "dat",
          "items": [
            "Voy a casa. / Estoy en casa. No article with casa here.",
            "Vengo de casa. / Salgo de casa.",
            "a pie, but en metro, en tren, en coche."
          ]
        }
      ]
    }
  },
