    "for two years",
    "since 2024",
    "ago",
    "during",
    "until",
    "by"
  ],
  "source": "EnglishAcademy original English text (grammar-b1 run, 2026-10-29)",
  "concept": {
    "comic": {
      "title": "How long, and since when?",
      "panels": [
        {
          "caption": "for / since",
