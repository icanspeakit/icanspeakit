  "id": "negationswoerter",
  "name": "Negative words: no, none, nobody, never",
  "level": "B2",
  "subtitle": "Use no before a noun and none instead of it: We have no milk. We have none. Nobody, nothing, nowhere and never are already negative, so the verb stays positive.",
  "briefMarks": [
    "none",
    "nothing",
    "nowhere",
    "never"
  ],
  "source": "EnglishAcademy original English text (grammar-b2 run, 2026-10-29)",
