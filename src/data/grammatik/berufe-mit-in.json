  "id": "berufe-mit-in",
  "name": "Berufe mit -in (A1): Lehrer – Lehrerin",
  "level": "A1",
  "status": "entwurf",
  "source": "Eigenentwurf EnglishAcademy (2026-10-28), ungeprüft",
  "subtitle": "Der Lehrer, die Lehrerin: Bei vielen Berufen kommt für Frauen -in ans Wort. Im Plural heißt es -innen. Beim Beruf sagt man kein ein oder eine: Ich bin Lehrerin.",
  "briefMarks": ["-in","-innen","ein","eine"],
  "concept": {
    "flow": [
      {
        "text": "der Lehrer"
      },
      {
        "text": "+ -in",
        "variant": "verb"
      },
      {
        "text": "die Lehrerin → die Lehrerinnen",
        "variant": "prep"
      }
    ],
    "exampleHtml": "der Lehrer → die Lehrer<span class=\"vp-verb\">in</span> → die Lehrer<span class=\"vp-prep\">innen</span> · Ich bin Lehrerin.",
    "qa": [
      {
        "html": "Für eine Frau hängt man <strong>-in</strong> an das Wort. <em>der Lehrer → die Lehrer<strong>in</strong></em>. Das Wort ist immer <strong>feminin</strong>: die. Im Plural: <strong>-innen</strong>. <em>die Lehrerinnen</em>.",
        "tag": "Die Regel: -in"
      },
      {
        "html": "Manche Wörter bekommen einen <strong>Umlaut</strong>. <em>der Arzt → die Ärztin. der Koch → die Köchin. der Anwalt → die Anwältin.</em>",
        "tag": "Mit Umlaut"
      },
      {
        "html": "Bei <strong>-mann</strong> wird es <strong>-frau</strong>. <em>der Kaufmann → die Kauffrau. der Feuerwehrmann → die Feuerwehrfrau.</em>",
        "tag": "-mann → -frau"
      },
      {
        "html": "Beim Beruf steht <strong>kein Artikel</strong>. <em>Ich bin Lehrerin. Er ist Arzt.</em> Die Frage: <em>Was sind Sie von Beruf?</em>",
        "tag": "Ohne Artikel"
      }
    ],
    "noteHtml": "Für eine Gruppe mit Frauen und Männern sagt man <em>die Lehrerinnen und Lehrer</em>. Bei <em>Krankenpfleger</em> heißt die Frau <em>Krankenpflegerin</em>. Das ältere Wort <em>Krankenschwester</em> gibt es nur für Frauen. Man hört es noch oft. Im Alltag sagt man auch: <em>Ich arbeite als Köchin.</em>",
    "reference": {
