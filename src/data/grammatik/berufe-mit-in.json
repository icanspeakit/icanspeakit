{
  "id": "berufe-mit-in",
  "name": "There is / there are",
  "level": "A1",
  "status": "entwurf",
  "source": "EnglishAcademy original English text (grammar-a1 run, 2026-10-29)",
  "subtitle": "Use There is for one thing and There are for more than one: There is a park. There are two shops. For none, say there isn't a or there aren't any.",
  "briefMarks": [
    "There is",
    "There are",
    "there isn't",
    "there aren't any"
  ],
  "concept": {
    "flow": [
      {
        "text": "There is / There are",
        "variant": "verb"
      },
      {
        "text": "a / some / two + noun",
        "variant": "prep"
      },
      {
        "text": "place"
      }
    ],
    "exampleHtml": "<span class=\"vp-verb\">There is</span> a <span class=\"vp-prep\">park</span> near my flat. · <span class=\"vp-verb\">There are</span> two <span class=\"vp-prep\">shops</span> in my street.",
    "qa": [
      {
        "html": "Use <strong>there is</strong> for one thing, and for things you cannot count: <em>There is a bank in my street. There is some milk in the fridge.</em> Short form: <em>There's a bank.</em>",
        "tag": "There is"
      },
      {
        "html": "Use <strong>there are</strong> for two or more: <em>There are three buses to Leeds. There are two beds in the room.</em> The verb follows the noun after it, not the word <em>there</em>.",
        "tag": "There are"
      },
      {
        "html": "<strong>Negative:</strong> <em>There isn't a lift. There aren't any chairs.</em> <strong>Question:</strong> <em>Is there a cafe here? Are there any shops?</em> <strong>Short answers:</strong> <em>Yes, there is. No, there aren't.</em> Use <em>any</em> in negatives and questions with plurals and with milk, water, time.",
        "tag": "No and questions"
      },
      {
        "html": "<strong>There is</strong> says that something exists or is in a place. <strong>It is</strong> describes a thing we already know about: <em>There is a dog in the garden. It is a big dog.</em> Do not use <em>have</em> for places: ✗ <em>It has a park near my flat.</em> ✓ <em>There is a park near my flat.</em>",
        "tag": "There or it?"
      },
      {
        "html": "Common mistakes: ✗ <em>There have two shops.</em> → ✓ <em>There are two shops.</em> · ✗ <em>There is three chairs.</em> → ✓ <em>There are three chairs.</em> · ✗ <em>Is a bank near here?</em> → ✓ <em>Is there a bank near here?</em>",
        "tag": "Mistakes"
      }
    ],
    "noteHtml": "You can put the place first: <em>Near my flat there is a park.</em> For where things are exactly, see <a href=\"/prepositions-of-place\">prepositions of place</a>. For one or more things, see <a href=\"/plurals\">plural nouns</a> and <a href=\"/articles\">articles</a>. Note: in US English people say <em>apartment</em>, in British English <em>flat</em>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "There is / there are",
          "note": "Use is with one thing or something you cannot count. Use are with more than one.",
          "head": [
            "",
            "one thing or uncountable",
            "more than one"
          ],
          "rows": [
            [
              "Positive",
              "There {is} a library.",
              "There {are} two libraries."
            ],
            [
              "Negative",
              "There {isn't} a lift.",
              "There {aren't} any lifts."
            ],
            [
              "Question",
              "{Is} there a cafe?",
              "{Are} there any cafes?"
            ],
            [
              "Short answer",
              "Yes, there is. / No, there isn't.",
              "Yes, there are. / No, there aren't."
            ]
          ]
        },
        {
          "caption": "a, some, any",
          "head": [
            "Word",
            "Use",
            "Example"
          ],
