{
  "id": "zusammengesetzte-verben",
  "name": "Present perfect vs past simple",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Use the past simple for a finished time: I saw Tom yesterday. Use the present perfect when the time is not named or not finished: I've seen that film. Have you ever been to Wales? I've just finished.",
  "briefMarks": [
    "past simple",
    "present perfect",
    "ever",
    "just"
  ],
  "source": "icanspeak Spanish original English text (grammar-b1 run, 2026-10-29)",
  "concept": {
    "comic": {
      "title": "When did it happen?",
      "panels": [
        {
          "caption": "Finished time",
