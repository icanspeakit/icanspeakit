    "flow": [
      {
        "text": "have / has + past participle",
        "variant": "verb"
      },
      {
        "text": "no finished time · experience · news · result now"
      },
      {
        "text": "past simple",
        "variant": "prep"
      },
      {
        "text": "finished time · yesterday · last week · in 2019"
      }
    ],
    "exampleHtml": "I<span class=\"vp-prep\"> saw</span> Tom yesterday. · I<span class=\"vp-verb\">'ve seen</span> that film. · <span class=\"vp-verb\">Have</span> you ever <span class=\"vp-verb\">been</span> to Wales?",
    "qa": [
      {
        "html": "<strong>have / has + past participle</strong>. Use it when the <strong>time is not named</strong> and the experience, news or result matters now: <em>I've lost my keys. She has finished her homework.</em> Negative: <em>haven't / hasn't</em>. Question: <em>Have you …? Has she …?</em>",
        "tag": "Present perfect"
      },
      {
        "html": "Use the <strong>past simple</strong> when the time is <strong>finished</strong> and you say or know when: <em>yesterday, last week, in 2019, two days ago, when</em>. <em>I lost my keys last night. When did you arrive?</em> A question with <em>when</em> or <em>what time</em> is always past simple.",
        "tag": "Past simple"
      },
      {
        "html": "<strong>ever</strong> and <strong>never</strong> talk about your life up to now. <em>Have you ever eaten sushi? I've never been to Scotland.</em> Answer: <em>Yes, I have. / No, I haven't.</em> When you say <strong>when</strong> it happened, switch to the past simple: <em>Yes, I ate it in Tokyo last year.</em>",
        "tag": "ever / never"
      },
      {
        "html": "<strong>just</strong> = a moment ago: <em>I've just woken up.</em> <strong>already</strong> = earlier than expected: <em>She's already left.</em> <strong>yet</strong> = until now, in questions and negatives, at the end: <em>Have you finished yet? I haven't finished yet.</em> <strong>US:</strong> American English often uses the past simple here: <em>I just ate.</em>",
        "tag": "just / already / yet"
      },
      {
        "html": "<strong>Unfinished time</strong> (today, this week, this year, so far) → present perfect: <em>I've drunk three coffees today.</em> (the day is not over). <strong>Finished time</strong> (yesterday, last week, in May) → past simple: <em>I drank three coffees yesterday.</em>",
        "tag": "Finished or unfinished?"
      },
      {
        "html": "✗ <em>I have seen him yesterday.</em> → ✓ <em>I saw him yesterday.</em> (yesterday is a finished time) · ✗ <em>I've never went to Wales.</em> → ✓ <em>I've never been to Wales.</em> (use the past participle, not the past simple) · ✗ <em>I've been to Paris in 2019.</em> → ✓ <em>I went to Paris in 2019.</em> (when you say the year, use the past simple)",
        "tag": "Typical mistakes"
      }
    ],
    "noteHtml": "For the form of the past simple, see <a href=\"/past-simple\">Past simple</a>. With <em>for</em> and <em>since</em> the present perfect says how long something has lasted: <em>I've lived here for five years.</em> The full story is in <a href=\"/for-since-ago\">for, since, ago</a>. If the action is still going on, you can also use the <a href=\"/present-perfect-continuous\">present perfect continuous</a>. Careful with <em>been</em> and <em>gone</em>: <em>She's been to Paris</em> (she visited and came back) but <em>She's gone to Paris</em> (she is there now).",
    "reference": {
