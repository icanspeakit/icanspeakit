  "exercises": [
    {
      "type": "fill",
      "title": "Fill in the preposition.",
      "placeholder": "Preposition…",
      "items": [
        {
          "prompt": "Amira is waiting ___ the bus.",
          "hint": "wait + …",
          "answer": "for",
          "choices": ["for", "to", "at", "on"],
          "why": "The verb is wait for."
        },
        {
          "prompt": "I love Tom's band. I often listen ___ their songs.",
          "hint": "listen + …",
          "answer": "to",
          "choices": ["to", "at", "for"],
          "why": "The verb is listen to."
        },
        {
          "prompt": "We can have a picnic, but it depends ___ the weather.",
          "hint": "depend + …",
          "answer": "on",
          "choices": ["on", "of", "from"],
          "why": "The verb is depend on, not depend of."
        },
        {
          "prompt": "Can you look ___ my cat while I'm away?",
          "hint": "look + … (= take care of)",
          "answer": "after",
          "choices": ["after", "at", "for"],
          "why": "Look after means take care of. Look at means use your eyes. Look for means search."
        },
        {
          "prompt": "This coat belongs ___ Liam.",
          "hint": "belong + …",
          "answer": "to",
          "choices": ["to", "with", "of"],
