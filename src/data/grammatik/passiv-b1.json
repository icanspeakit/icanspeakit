{
  "id": "passiv-b1",
  "name": "Passiv (B1): wird gebaut, wurde gebaut, ist gebaut worden",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Im Passiv zählt, was passiert – nicht, wer es tut: Die Straße wird repariert. Man bildet es mit werden und dem Partizip II, im Präsens, im Präteritum und im Perfekt (ist … worden).",
  "briefMarks": ["wird","werden","ist … worden"],
  "source": "Eigenentwurf EnglishAcademy (2026-10-27), ungeprüft",
  "concept": {
    "comic": {
      "title": "Was passiert hier?",
      "panels": [
        {
          "caption": "Präsens",
          "tag": "{wird} + Partizip II → das passiert jetzt",
          "left": {
            "name": "quaki",
            "expr": "thinking",
            "say": "Warum ist die Straße gesperrt?"
          },
          "right": {
            "name": "bruno",
            "expr": "happy",
            "say": "Die Straße {wird} gerade {repariert}."
          }
        },
        {
          "caption": "Präteritum",
          "tag": "{wurde} + Partizip II → so war es damals",
          "left": {
            "name": "regi",
            "expr": "thinking",
            "say": "Ist das Haus sehr alt?"
          },
          "right": {
            "name": "hamsti",
            "expr": "happy",
            "say": "Ja, es {wurde} 1910 {gebaut}."
          }
        },
        {
          "caption": "Perfekt",
          "tag": "{ist} + Partizip II + {worden} – nicht „geworden“",
          "left": {
            "name": "hamsti",
            "expr": "thinking",
            "say": "Wo ist denn dein Fahrrad?"
          },
          "right": {
            "name": "quaki",
            "expr": "oops",
            "say": "Es {ist} {gestohlen} {worden}!"
          }
        }
      ]
    },
    "flow": [
      {
        "text": "Subjekt (= Akkusativobjekt im Aktiv)"
      },
      {
        "text": "werden · Position 2",
        "variant": "verb"
      },
      {
        "text": "Partizip II · Ende",
        "variant": "prep"
      }
    ],
    "qa": [
      {
        "html": "<strong>Aktiv</strong>: Wer tut etwas? <em>Der Mechaniker repariert das Auto.</em> <strong>Passiv</strong>: Was passiert? <em>Das Auto wird repariert.</em> Das Akkusativobjekt (<em>das Auto</em>) wird zum Subjekt.",
        "tag": "Aktiv oder Passiv?"
      },
      {
        "html": "<strong>Präsens</strong>: <em>werden</em> auf Position 2, das Partizip II am Ende: <em>Das Auto <strong>wird</strong> repariert. Die Reifen <strong>werden</strong> gewechselt.</em>",
        "tag": "Präsens"
      },
      {
        "html": "<strong>Präteritum</strong>: <em>wurde</em> + Partizip II: <em>Das Haus <strong>wurde</strong> 1910 gebaut. Die Fenster <strong>wurden</strong> erneuert.</em> In Zeitungen und Berichten ist das die häufigste Form.",
        "tag": "Präteritum"
      },
      {
        "html": "<strong>Perfekt</strong>: <em>sein</em> + Partizip II + <strong>worden</strong>: <em>Mein Fahrrad <strong>ist</strong> gestohlen <strong>worden</strong>.</em> Im Passiv heißt es immer <em>worden</em>, nicht <em>geworden</em>.",
        "tag": "Perfekt"
      },
      {
        "html": "Wer es tut, sagt man nur, wenn es wichtig ist – mit <strong>von</strong> + Dativ: <em>Der Patient wird <strong>vom</strong> Arzt untersucht.</em>",
        "tag": "von + Dativ"
      }
    ],
    "noteHtml": "Sätze mit <em>man</em> sagen dasselbe: <em>Man repariert die Straße.</em> = <em>Die Straße wird repariert.</em> Es geht auch ganz ohne Subjekt: <em>Hier wird nicht geraucht.</em> Und <em>geworden</em> gibt es weiter – aber nur, wenn <em>werden</em> allein steht: <em>Sie ist Ärztin geworden.</em> Weiter geht es mit <a href=\"/passiv\">Passiv mit Modalverben</a> (<em>muss repariert werden</em>) und dem <a href=\"/zustandspassiv\">Zustandspassiv</a> (<em>ist repariert</em>).",
