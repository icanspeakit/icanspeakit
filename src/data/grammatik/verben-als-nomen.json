      "boxes": [
        {
          "badge": "Is it a preposition?",
          "variant": "akk",
          "items": [
            "look forward to + -ing (to is a preposition)",
            "I want to go. (to belongs to the verb: to + base verb)",
            "Test: can you say look forward to it? Yes → use -ing.",
            "Same rule: be used to + -ing."
          ]
        },
        {
          "badge": "Spelling the -ing form",
          "variant": "dat",
          "items": [
            "swim → swimming (double the last letter)",
            "make → making (drop the e)",
            "run → running, sit → sitting",
            "learn → learning, help → helping (just add -ing)"
          ]
        }
      ]
    }
