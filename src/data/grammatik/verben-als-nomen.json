{
  "id": "verben-als-nomen",
  "name": "Aus Verben werden Nomen: wandern, das Wandern, die Wanderung",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Aus fast jedem Verb kann man ein Nomen machen: wandern → das Wandern, die Wanderung, der Wanderer. Die Endung zeigt oft schon den Artikel. Und das Wandern ist nicht dasselbe wie die Wanderung.",
  "briefMarks": ["das Wandern","die Wanderung","der Wanderer"],
  "source": "Eigenentwurf EnglishAcademy (2026-10-22), ungeprüft",
  "concept": {
    "flow": [
