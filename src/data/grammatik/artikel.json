{
  "id": "artikel",
  "name": "Articles: el, la, los, las, un, una",
  "level": "A1",
  "variety": "es-ES",
  "subtitle": "Spanish has four words for “the”: el, la, los, las. It has four for “a” or “some”: un, una, unos, unas. The article shows if the noun is masculine or feminine, singular or plural.",
  "briefMarks": ["el", "la", "los", "las", "un", "una", "unos", "unas", "al", "del"],
  "source": "icanspeak Spanish original text (grammar-a1 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "el / la / los / las", "variant": "prep" },
      { "text": "un / una / unos / unas", "variant": "prep" },
      { "text": "noun", "variant": "verb" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">un</span> piso → <span class=\"vp-prep\">el</span> piso · <span class=\"vp-prep\">una</span> llave → <span class=\"vp-prep\">la</span> llave · <span class=\"vp-prep\">unos</span> libros → <span class=\"vp-prep\">los</span> libros · <span class=\"vp-prep\">unas</span> sillas → <span class=\"vp-prep\">las</span> sillas",
    "qa": [
      {
        "html": "<strong>el, la, los, las</strong> mean “the”. Use them for something you both know: <em>La farmacia está aquí.</em>",
        "tag": "the"
      },
      {
        "html": "<strong>un, una</strong> mean “a”. <strong>unos, unas</strong> mean “some” or “a few”. Use them for something new: <em>Busco una farmacia.</em> <em>Tengo unos amigos en Bilbao.</em>",
        "tag": "a, some"
      },
      {
        "html": "<strong>a + el = al</strong> and <strong>de + el = del</strong>: <em>Voy al médico.</em> <em>Vengo del trabajo.</em> The others do not join: <em>a la, de la, a los, de las</em>.",
        "tag": "al, del"
      },
      {
        "html": "Use no article with most jobs after <em>ser</em>: <em>Soy enfermera.</em> Not: <em>Soy una enfermera.</em> Use no article with a language after <em>hablar</em>: <em>Hablo español.</em>",
        "tag": "No article"
      },
      {
        "html": "Use <strong>el</strong> and <strong>los</strong> with days to say “on”: <em>La cita es el lunes.</em> <em>Trabajo los sábados.</em> Do not add a word for “on”.",
        "tag": "With days"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Voy a el banco</em> → ✓ <em>Voy al banco</em>. ✗ <em>Soy un camarero</em> → ✓ <em>Soy camarero</em>. ✗ <em>en lunes</em> → ✓ <em>el lunes</em>. Not sure about the gender? See <a href=\"/nouns\">Nouns and gender</a>.",
    "reference": {
