{
  "id": "da-wo-woerter",
  "name": "da- und wo-Wörter: darauf, worauf",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Für Sachen sagt man darauf, damit, daran — für Personen auf ihn, mit ihr. Beim Fragen ist es genauso: worauf? für Sachen, auf wen? für Personen.",
  "briefMarks": ["darauf","damit","daran","auf ihn","mit ihr","worauf","auf wen"],
  "source": "Eigenentwurf EnglishAcademy, geprüft von Edgar Kretschmann (2026-10-01)",
  "concept": {
    "flow": [
      {
        "text": "Sache",
        "variant": "prep"
      },
      {
        "text": "darauf · worauf?"
      },
      {
        "text": "Person",
        "variant": "verb"
      },
