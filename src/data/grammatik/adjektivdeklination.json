{
  "id": "adjektivdeklination",
  "name": "Adjektivdeklination",
  "level": "B1",
  "subtitle": "Die Endung des Adjektivs hängt nicht vom Nomen ab, sondern davon, was davorsteht. Drei Typen — bestimmter Artikel, unbestimmter Artikel, kein Artikel — und das Muster sitzt.",
  "source": "MATRIX ADJEKTIVE.pdf (vollständige Deklinationstabelle), Adjektivübung.pdf, Adjektivubung nur ABs.pdf",
  "concept": {
    "comic": {
      "title": "Wer trägt die Endung?",
      "panels": [
        {
          "caption": "Typ A · der/die/das",
          "tag": "{der} zeigt schon alles → nur {-e} oder {-en}",
          "left": {
            "name": "hamsti",
            "expr": "happy",
            "say": "Was kostet {der} alt{e} Hut?"
          },
          "right": {
            "name": "bruno",
            "expr": "happy",
            "say": "{Der} alt{e} Hut? Nur zwei Euro!"
          }
        },
        {
          "caption": "Typ B · ein/kein/mein",
          "tag": "{ein} zeigt nichts → das Adjektiv springt ein: {-er}, {-es}",
          "left": {
            "name": "quaki",
            "expr": "thinking",
            "say": "Haben Sie {ein} klein{es} Radio?"
          },
          "right": {
            "name": "bruno",
            "expr": "celebrate",
            "say": "Ja! {Ein} klein{es} Radio, hier!"
          }
        },
        {
          "caption": "Typ C · kein Artikel",
          "tag": "Kein Artikel → das Adjektiv macht die Arbeit von {der}/{die}/{das}",
          "left": {
            "name": "regi",
            "expr": "happy",
            "say": "Heiß{er} Kaffee! Frisch{e} Waffeln!"
          },
          "right": {
            "name": "hamsti",
            "expr": "celebrate",
            "say": "Einen Kaffee mit warm{er} Milch, bitte!"
          }
        }
      ]
    },
    "flow": [
      {
        "text": "Artikelwort",
        "variant": "verb"
      },
      {
        "text": "Adjektiv + Endung",
        "variant": "prep"
      },
      {
        "text": "Nomen"
      }
    ],
    "qa": [
      {
        "html": "<strong>der/die/das</strong> zeigt alles → Adjektiv nur <strong>-e</strong> oder <strong>-en</strong>: <em>der alt<strong>e</strong> Mann</em>",
        "tag": "Typ A · schwach"
      },
      {
        "html": "<strong>ein</strong> zeigt nichts → das Adjektiv springt ein: <em>ein alt<strong>er</strong> Mann</em>",
        "tag": "Typ B · gemischt"
      },
      {
        "html": "<strong>kein Artikel</strong> → das Adjektiv nimmt die Endung von der/die/das: <em>alt<strong>er</strong> Wein</em>",
        "tag": "Typ C · stark"
      }
    ],
    "noteHtml": "Typ A: <em>-e</em> nur bei <em>der/die/das</em> im Nominativ und <em>die/das</em> im Akkusativ, sonst <em>-en</em>. Plural mit Artikelwort: immer <em>-en</em>.",
