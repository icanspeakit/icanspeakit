{
  "id": "wortbildung-nomen",
  "name": "Word formation: -ción, -dad, -miento, -ero, -ería, -ito",
  "level": "B1",
  "status": "geprueft",
  "variety": "es-ES",
  "es419": { "note": "These endings work the same in Latin America, where diminutives such as cafecito and ahorita are used more often than in Spain. Coche is carro there." },
  "subtitle": "The ending of a Spanish noun often tells you what it means and its gender. -ción and -dad make feminine nouns: la información, la ciudad. -miento makes masculine ones: el nacimiento. -ero/-era is a person with a job, and -ería is the shop. -ito and -illo make things small.",
  "briefMarks": ["-ción", "-dad", "-miento", "-ero", "-era", "-ería", "-ito", "-illo"],
  "source": "icanspeak Spanish original text (grammar-b1 run, 2026-11-04)",
  "concept": {
    "comic": {
      "title": "La {panadería} de Bruno",
      "panels": [
        {
          "caption": "The shop",
          "tag": "{-ería} = the shop",
          "left": { "name": "quaki", "expr": "thinking", "say": "¿Dónde está la {panadería}?" },
          "right": { "name": "regi", "expr": "happy", "say": "Allí, en la esquina." }
        },
        {
          "caption": "The person",
          "tag": "{-ero} = the job",
          "left": { "name": "quaki", "expr": "happy", "say": "¿Eres el {panadero}?" },
          "right": { "name": "bruno", "expr": "celebrate", "say": "¡Sí! Un {momentito}, por favor." }
        }
      ]
    },
    "flow": [
      { "text": "informar · ciudad · nacer · pan", "variant": "verb" },
      { "text": "-ción · -dad · -miento · -ero · -ería", "variant": "prep" }
    ],
    "qa": [
      {
        "html": "<strong>-ción</strong> makes nouns from verbs. They are always <strong>feminine</strong>: <em>informar → la información, organizar → la organización, jubilarse → la jubilación, inscribirse → la inscripción</em>. The plural loses the accent: <em>las soluciones</em>.",
        "tag": "-ción"
      },
      {
        "html": "<strong>-dad</strong> makes nouns, often from adjectives. They are <strong>feminine</strong> too: <em>posible → la posibilidad, responsable → la responsabilidad, feliz → la felicidad</em>; also <em>la ciudad, la universidad</em>.",
        "tag": "-dad"
      },
      {
        "html": "<strong>-miento</strong> makes nouns from verbs. They are <strong>masculine</strong>: <em>nacer → el nacimiento, conocer → el conocimiento, mover → el movimiento, empadronarse → el empadronamiento</em>.",
        "tag": "-miento"
      },
      {
        "html": "<strong>-ero / -era</strong>: a person with a job. <em>el panadero, la peluquera, el zapatero, la jardinera</em>. <strong>-ería</strong>: the shop or place. <em>la panadería, la peluquería, la zapatería, la frutería</em>.",
        "tag": "-ero, -ería"
      },
      {
        "html": "<strong>-ito / -ita</strong> makes something small, or sounds kinder: <em>un momentito, una casita</em>. Watch the spelling: <em>poco → poquito</em>. Short words and words in <em>-e</em> often add <em>-cito</em>: <em>coche → cochecito, café → cafecito</em>.",
        "tag": "-ito"
      },
      {
        "html": "<strong>-illo / -illa</strong> is also a small form, but some of these are now words of their own: <em>la ventana → la ventanilla</em> (the counter at an office), <em>la mesa → la mesilla</em> (bedside table), <em>el pan → el panecillo</em> (bread roll). In some regions of Spain you will also hear <em>-ico: un momentico</em>.",
        "tag": "-illo"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>el información</em> → ✓ <em>la información</em>. ✗ <em>la nacimiento</em> → ✓ <em>el nacimiento</em>. ✗ <em>el ciudad</em> → ✓ <em>la ciudad</em>. ✗ <em>un pocito</em> → ✓ <em>un poquito</em>. Don't confuse <em>la panadera</em> (a person) with <em>la panadería</em> (a shop).",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
