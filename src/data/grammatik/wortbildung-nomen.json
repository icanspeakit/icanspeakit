{
  "id": "wortbildung-nomen",
  "name": "Wortbildung (B1): -ung, -heit, -chen, -in",
  "level": "B1",
  "status": "geprueft",
  "subtitle": "Aus Verben und Adjektiven werden Nomen: wohnen → die Wohnung, frei → die Freiheit. Die Endung verrät den Artikel und oft auch den Plural: -chen ist immer das, -in und -ung sind immer die.",
  "briefMarks": ["-chen","-in","-ung","Wohnung","Freiheit"],
  "source": "Eigenentwurf EnglishAcademy (2026-10-27), ungeprüft",
  "concept": {
    "comic": {
      "title": "Die Endung verrät den Artikel",
      "panels": [
        {
          "caption": "-chen",
          "tag": "{-chen} → immer {das} · Haus → Häuschen",
          "left": {
            "name": "quaki",
            "expr": "thinking",
            "say": "Ist das dein Haus?"
          },
          "right": {
            "name": "bruno",
            "expr": "happy",
            "say": "Ja, ein kleines {Häuschen}. Mit {-chen} wird alles klein – und immer {das}."
          }
        },
        {
          "caption": "-in",
          "tag": "{-in} → {die} · Plural {-innen}",
          "left": {
            "name": "regi",
            "expr": "thinking",
            "say": "Ist Frau Bauer Lehrer?"
          },
          "right": {
            "name": "hamsti",
            "expr": "happy",
            "say": "Nein, {Lehrerin}! Und ihre Kolleginnen sind auch {Lehrerinnen}."
          }
        },
        {
          "caption": "-ung · -heit",
          "tag": "{-ung} und {-heit} → immer {die}",
          "left": {
            "name": "hamsti",
            "expr": "thinking",
            "say": "Wie heißt wohnen als Nomen?"
          },
          "right": {
            "name": "quaki",
            "expr": "celebrate",
            "say": "Die {Wohnung}! Und frei wird zur {Freiheit}."
          }
        }
      ]
    },
    "flow": [
      {
        "text": "Grundwort (Verb, Adjektiv, Nomen)"
      },
      {
        "text": "+ Endung · -ung, -heit, -chen …",
        "variant": "verb"
      },
      {
        "text": "Nomen · Artikel steckt in der Endung",
        "variant": "prep"
      }
    ],
    "qa": [
      {
        "html": "<strong>-chen / -lein</strong> machen etwas klein oder nett und sind immer <strong>das</strong>. Der Vokal bekommt meist einen Umlaut: <em>das Haus → das <strong>Häus</strong>chen, das Buch → das <strong>Büch</strong>lein, das Brot → das Brötchen.</em> Ein End-<em>e</em> fällt weg: <em>die Blume → das Blümchen.</em> Der Plural bleibt gleich: <em>zwei Häuschen.</em>",
        "tag": "-chen · -lein → das"
      },
      {
        "html": "<strong>-in</strong> macht aus einem Mann oder Beruf die Frau: <em>der Lehrer → die Lehrer<strong>in</strong>, der Arzt → die Ärztin, der Koch → die Köchin.</em> Der Plural hat <strong>zwei n</strong>: <em>die Lehrerin → die Lehrer<strong>innen</strong>.</em>",
        "tag": "-in → die · Plural -innen"
      },
      {
        "html": "<strong>-er</strong> kommt von einem Verb und nennt die Person oder das Gerät, das etwas tut: <em>fahren → der Fahrer, drucken → der Drucker.</em> Immer <strong>der</strong>. Die Frau dazu: <em>die Fahrerin.</em> Der Plural von <em>-er</em> bleibt gleich: <em>die Fahrer.</em>",
        "tag": "-er → der"
      },
      {
        "html": "<strong>-ung</strong> kommt von einem Verb: <em>wohnen → die Wohn<strong>ung</strong>, meinen → die Mein<strong>ung</strong>.</em> <strong>-heit</strong> und <strong>-keit</strong> kommen von einem Adjektiv: <em>frei → die Freiheit, möglich → die Möglichkeit.</em> Nach <em>-lich, -ig, -bar, -sam</em> und nach <em>-er</em> steht <strong>-keit</strong>, sonst meistens <strong>-heit</strong>. Immer <strong>die</strong>, Plural auf <strong>-en</strong>: <em>die Wohnungen, die Freiheiten, die Möglichkeiten.</em>",
        "tag": "-ung · -heit · -keit → die"
      },
      {
        "html": "Auch diese Endungen verraten den Artikel: <strong>-schaft</strong> und <strong>-ion</strong> sind <strong>die</strong> (<em>die Freundschaft, die Information</em>), <strong>-ment</strong> und <strong>-um</strong> sind <strong>das</strong> (<em>das Dokument, das Museum</em>). Bei diesen vier Endungen lernt man den Plural am besten mit dem Wort: <em>die Informationen, die Dokumente, die Museen.</em>",
        "tag": "-schaft · -ion · -ment · -um"
      }
    ],
    "noteHtml": "Das ist ein Überblick für B1. Die Endungen sind eine Hilfe, keine Garantie: <em>der Frühling</em> endet auf <em>-ling</em> und <em>das Mädchen</em> hat kein Verkleinerungs-Gefühl mehr. Die vollständige Liste der Artikel-Endungen steht bei <a href=\"/artikel\">Artikel: der, die, das</a>. Ein ganzes Verb als Nomen (<em>das Lesen</em>) und die Unterschiede zwischen <em>-ung</em>, <em>-er</em> und dem Stamm zeigt <a href=\"/verben-als-nomen\">Aus Verben werden Nomen</a>. Wer Nomen in Berichten statt Nebensätze nutzt, übt das im <a href=\"/nominalisierung\">Nominalstil</a>. Wie Pluralformen allgemein funktionieren, steht bei <a href=\"/plural\">Plural</a>.",
    "reference": {
