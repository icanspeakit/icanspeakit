{
  "id": "w-fragen",
  "name": "Question words: qué, quién, dónde, cuándo …",
  "level": "A1",
  "variety": "es-ES",
  "subtitle": "Question words always have a written accent: qué, quién, dónde, adónde, cuándo, cómo, cuánto, por qué. A written question opens with ¿ and closes with ?.",
  "briefMarks": ["qué", "quién", "dónde", "cuándo", "cómo", "cuánto", "por qué"],
  "source": "icanspeak Spanish original text (grammar-a1 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "¿ question word", "variant": "prep" },
      { "text": "verb", "variant": "verb" },
      { "text": "(person) rest ?" }
    ],
    "exampleHtml": "¿<span class=\"vp-prep\">Dónde</span> <span class=\"vp-verb\">vives</span>? · ¿<span class=\"vp-prep\">Cómo</span> <span class=\"vp-verb\">te llamas</span>? · ¿<span class=\"vp-prep\">Qué</span> <span class=\"vp-verb\">quiere</span> usted? · ¿<span class=\"vp-prep\">Cuándo</span> <span class=\"vp-verb\">es</span> la cita?",
    "qa": [
      {
        "html": "<strong>qué</strong> = what. <strong>quién</strong> = who (more than one: <em>quiénes</em>). <strong>dónde</strong> = where. <strong>cuándo</strong> = when. <strong>cómo</strong> = how. <strong>por qué</strong> = why.",
        "tag": "The words"
      },
      {
        "html": "The verb comes right after the question word. A person named comes after the verb: <em>¿Dónde vive Ana?</em> Not: <em>¿Dónde Ana vive?</em>",
        "tag": "Word order"
      },
      {
        "html": "<strong>dónde</strong> is for a place: <em>¿Dónde estás?</em> <strong>adónde</strong> is for a direction: <em>¿Adónde vas?</em> <strong>de dónde</strong> is for origin: <em>¿De dónde eres?</em>",
        "tag": "dónde"
      },
      {
        "html": "<strong>cuánto</strong> matches its noun: <em>¿Cuánto dinero? ¿Cuánta leche? ¿Cuántos años? ¿Cuántas horas?</em> To ask a price: <em>¿Cuánto cuesta?</em>",
        "tag": "cuánto"
      },
      {
        "html": "Ask with <strong>por qué</strong> (two words, with an accent). Answer with <strong>porque</strong> (one word, no accent): <em>¿Por qué no vienes? – Porque estoy enfermo.</em>",
        "tag": "por qué / porque"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>¿Donde vives?</em> → ✓ <em>¿Dónde vives?</em> ✗ <em>¿Dónde Ana vive?</em> → ✓ <em>¿Dónde vive Ana?</em> ✗ <em>¿Cuántos años eres?</em> → ✓ <em>¿Cuántos años tienes?</em> ✗ <em>Dónde vives?</em> without ¿ → ✓ <em>¿Dónde vives?</em> See also <a href=\"/yes-no-questions\">Yes/no questions</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
      "tables": [
        {
          "caption": "Question words",
          "head": ["Word", "Asks about", "Example"],
          "rows": [
            ["qué", "a thing", "¿Qué necesitas?"],
            ["quién", "a person", "¿Quién es?"],
            ["dónde", "a place", "¿Dónde trabajas?"],
            ["adónde", "a direction", "¿Adónde vais?"],
            ["de dónde", "origin", "¿De dónde es usted?"],
            ["cuándo", "a time", "¿Cuándo es la cita?"],
            ["cómo", "the way, a name", "¿Cómo te llamas?"],
            ["cuánto", "an amount, a price", "¿Cuánto cuesta?"],
            ["por qué", "a reason", "¿Por qué estudias español?"]
          ]
        },
        {
          "caption": "Questions you will need",
          "head": ["Spanish", "Meaning"],
          "rows": [
            ["¿Cómo te llamas? / ¿Cómo se llama?", "What is your name?"],
            ["¿De dónde eres? / ¿De dónde es?", "Where are you from?"],
            ["¿Cuántos años tienes?", "How old are you?"],
            ["¿A qué hora es?", "What time is it at?"],
            ["¿Cuál es tu dirección?", "What is your address?"]
          ]
        }
      ],
      "boxes": [
        {
          "badge": "Careful: accents",
          "variant": "dat",
          "items": [
            "A question word has an accent: cómo, dónde, cuándo.",
            "Without an accent the word does another job: como (I eat, as), donde (where, in a statement)."
          ]
        }
      ]
    }
  },
