{
  "id": "personalpronomen",
  "name": "Subject pronouns: yo, tú, usted, vosotros",
  "level": "A1",
  "status": "geprueft",
  "variety": "es-ES",
  "es419": { "note": "Latin America uses ustedes, not vosotros, for “you all”, with friends too. Verb forms like habláis are not used there." },
  "subtitle": "Yo, tú, él, ella, usted, nosotros, vosotros, ellos, ellas, ustedes. The verb ending already shows the person, so Spanish often drops the pronoun: Vivo en Madrid.",
  "briefMarks": ["yo", "tú", "usted", "nosotros", "vosotros", "ustedes"],
  "source": "icanspeak Spanish original text (grammar-a1 run, 2026-11-04)",
  "concept": {
    "flow": [
      { "text": "(pronoun)", "variant": "prep" },
      { "text": "verb", "variant": "verb" },
      { "text": "rest" }
    ],
    "exampleHtml": "<span class=\"vp-prep\">Yo</span> <span class=\"vp-verb\">soy</span> Pablo. · <span class=\"vp-verb\">Vivo</span> en Bilbao. · ¿<span class=\"vp-prep\">Usted</span> <span class=\"vp-verb\">trabaja</span> aquí? · <span class=\"vp-prep\">Vosotros</span> <span class=\"vp-verb\">sois</span> de Jaén.",
    "qa": [
      {
        "html": "<strong>tú</strong> is for one person you know well: friends, family, children, people your age. In Spain people use <em>tú</em> a lot, also at work.",
        "tag": "tú"
      },
      {
        "html": "<strong>usted</strong> is polite: an older person, an official, or anyone you want to show respect to. The verb is the same as for <em>él</em> and <em>ella</em>: <em>¿Usted vive aquí?</em> If you are not sure at an office, start with <em>usted</em>.",
        "tag": "usted"
      },
      {
        "html": "<strong>vosotros, vosotras</strong> is “you” for two or more people you know well. <strong>ustedes</strong> is the polite form for two or more people. Its verb is the same as for <em>ellos</em>: <em>¿Ustedes viven aquí?</em>",
        "tag": "More than one"
      },
      {
        "html": "The verb ending shows the person, so people often drop the pronoun: <em>Hablo español. Tenemos dos hijos.</em> Use the pronoun for contrast or to be clear: <em>Yo trabajo y ella estudia.</em>",
        "tag": "Drop it"
      },
      {
        "html": "<strong>nosotros, vosotros, ellos</strong> are for men or mixed groups. <strong>nosotras, vosotras, ellas</strong> are only for women. There is no pronoun for “it”: <em>Es grande.</em> Not: <em>Ello es grande.</em>",
        "tag": "Women and men"
      }
    ],
    "noteHtml": "Common mistakes: ✗ <em>Yo soy, yo vivo, yo trabajo</em> in every sentence → ✓ say <em>yo</em> once or not at all. ✗ <em>¿Usted eres…?</em> → ✓ <em>¿Usted es…?</em> ✗ <em>tu</em> without an accent for “you”: <em>tú</em> = you, <em>tu</em> = your. Next: <a href=\"/present-simple\">Present tense: regular verbs</a> and <a href=\"/word-order\">ser and estar</a>.",
    "reference": {
      "showLabel": "Show overview ▼",
      "hideLabel": "Hide overview ▲",
