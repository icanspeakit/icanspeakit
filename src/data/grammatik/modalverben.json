  "id": "modalverben",
  "name": "Modal verbs",
  "level": "A2",
  "subtitle": "Can, must and should go before the base verb: She can swim. You must wait. We should go. Use have to when something is necessary, and watch the difference: mustn't means no, but don't have to means you can choose.",
  "briefMarks": [
    "Can",
    "must",
    "should",
    "have to",
    "mustn't"
  ],
  "source": "icanspeak Spanish original English text (grammar-a2 run, 2026-10-29)",
  "concept": {
    "flow": [
      {
        "text": "subject"
      },
