  "exercises": [
    {
      "type": "fill",
      "title": "Which modal verb fits?",
      "hint": "can't = not able · mustn't = not allowed · don't have to = not necessary · should = advice. Sometimes two answers are right. Then both are accepted.",
      "placeholder": "Modal verb…",
      "items": [
        {
          "prompt": "Amira is only three, so she ___ read yet.",
          "answer": [
            "can't"
          ],
          "choices": [
            "can't",
            "mustn't",
            "don't have to"
          ],
          "why": "She is too young to be able to read. Not able = can't."
        },
        {
          "prompt": "You ___ use your phone in the exam. It is not allowed.",
          "answer": [
            "mustn't"
          ],
          "choices": [
            "mustn't",
            "don't have to",
            "should"
          ],
          "why": "Not allowed = mustn't. Don't have to means 'not necessary'. That is a different idea."
        },
        {
          "prompt": "It's Sunday, so Tom ___ get up early. He can sleep late.",
          "answer": [
            "doesn't have to"
          ],
          "choices": [
            "doesn't have to",
            "mustn't",
            "has to"
          ],
          "why": "He can sleep late, so getting up is not necessary: doesn't have to."
        },
        {
