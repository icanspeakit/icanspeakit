{
  "variety": "es-ES",
  "es419": { "note": "Spain uses vosotros (fuisteis). Latin America uses ustedes with the ellos form: ¿Adónde fueron?" },
  "tandemFrageBeispiel": {
    "infinitiv": "correr",
    "kacheln": ["cuándo", "correr", "(tú)"],
    "frage": "¿Cuándo corres?",
    "antwortKacheln": ["(yo)", "correr", "por las mañanas"],
    "antwort": "Corro por las mañanas."
  },
  "tandemSoGehts": [
    "Cut the cards in the middle. Partner A takes the left half, Partner B the right half.",
    "A builds question 1 from the tiles and asks it: “¿Cuándo vuelve tu hermana?” The verb tile is the infinitive: you choose the form and the tense.",
    "B hears the question and puts the verb in the right form: vuelve (presente), comí (indefinido), ha escrito (pretérito perfecto: haber + participle). Irregular forms must be learnt: ir, fui, ido. A tile in brackets, like (yo), says who; it is not written.",
    "Then B asks question 2 and A answers. Take turns. At the end, check with the answer sheet.",
    "Finally: swap cards and do it all again, faster."
  ],
  "tandemRedemittel": [
    { "p1": "Número 1: ¿Cuándo vuelve …?", "p2": "Vuelve …" },
    { "p1": "¿Es «fui» o «he ido»?", "p2": "«Ayer fui», pero «hoy he ido»." },
    { "p1": "¿Perdona? ¿Puedes repetir, por favor?", "p2": "Número 2: ¿Qué …?" }
  ],
