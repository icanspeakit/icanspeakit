  "tandemSoGehts": [
    "Cut the cards in the middle. Partner A takes the left half, Partner B takes the right half.",
    "A builds question 1 from the tiles and asks it: \"Do you like fish?\" (You add do.)",
    "B hears the question and answers with no. The tile \"not\" is your job: with be it is isn't / aren't / wasn't, with other verbs it is don't / doesn't / didn't + the base verb.",
    "Then B asks question 2 and A answers. Take turns. At the end, check with the answer sheet.",
    "Last, swap cards and do it all again, faster."
  ],
  "tandemRedemittel": [
    { "p1": "Number 1: Do you …?", "p2": "No, I don't …" },
