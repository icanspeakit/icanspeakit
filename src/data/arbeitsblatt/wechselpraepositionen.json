  "tandemSoGehts": [
    "Cut the cards in the middle. Partner A takes the left half, Partner B the right half.",
    "A builds question 1 from the tiles and reads it out: \"Where does Tom put the bottle?\" (A adds does.)",
    "B only has tiles: the verb in its base form and the parts of the sentence. Build the answer and put the verb in the right form (puts, is, are). Watch the point: put and hang = movement, be = position.",
    "Then B asks question 2 and A answers. Take turns. At the end, check with the answer sheet.",
    "Now swap cards and do it all again, faster."
  ],
  "tandemRedemittel": [
    { "p1": "Number 1: Where does Tom put …?", "p2": "Tom puts … in the …" },
    { "p1": "Does it move or does it stay?", "p2": "Where is it? That's position: is + on." },
    { "p1": "Sorry? Can you say that again, please?", "p2": "Number 2: Where is …?" }
  ],
