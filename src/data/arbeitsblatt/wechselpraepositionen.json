{
  "_comment": "Extras for the worksheet /teachers/worksheets/grammar/wechselpraepositionen (English: position vs movement), on top of the topic's own exercises: a position/movement rule (the keys keep their old names: regel.wo = position, regel.wohin = movement, kasus = the label 'position' / 'movement'), a mascot comic, and picture exercises on the room in src/components/arbeitsblatt/ZimmerSzene.astro (numbers 1–12 are the things in the picture). In segments, a string is text and {\"a\": [...]} is a gap with every accepted answer.",
  "regel": {
    "wo": {
      "frage": "Where is it?",
      "kasus": "position",
      "was": "Place: it stays there.",
      "verben": [
        "be",
        "lie",
        "stand",
        "hang"
      ],
      "beispiel": "The book <b>is</b> <b>on</b> the bed."
    },
    "wohin": {
      "frage": "Where does it go?",
      "kasus": "movement",
      "was": "Direction: someone moves it.",
      "verben": [
        "put",
        "hang",
        "lift",
        "move"
      ],
      "beispiel": "I <b>put</b> the book <b>on</b> the bed."
    },
    "lage": [
      {
        "form": "upright",
        "verben": "stand",
        "text": "The thing is upright, like a bottle or a vase."
      },
      {
        "form": "flat",
        "verben": "lie",
        "text": "The thing is flat, like a book or a phone."
      }
    ],
    "neun": [
      "in",
      "on",
      "at",
      "above",
      "under",
      "in front of",
      "behind",
      "next to",
      "between"
    ],
    "kurz": "After put we usually say in / on: put it on the table. With go, walk, jump we say into · onto · out of · off. Into and onto stress the movement."
  },
  "comic": {
    "title": "Bruno tidies up",
    "panels": [
      {
        "caption": "put: where to?",
        "tag": "Where to? {on} the table (movement)",
        "left": {
          "name": "bruno",
          "expr": "happy",
          "say": "I {put} the book {on} the table."
        },
        "right": {
          "name": "regi",
          "expr": "thinking",
          "say": "It moves! So we say {put} + {on}."
        }
      },
      {
        "caption": "be: where?",
        "tag": "Where? {on} the table (position)",
        "left": {
          "name": "hamsti",
          "expr": "thinking",
          "say": "And where is the book now?"
        },
        "right": {
          "name": "regi",
          "expr": "happy",
          "say": "It {is} {on} the table. It stays there!"
        }
      },
      {
        "caption": "in or into?",
        "tag": "{put} it {in} or {into} the bag",
        "left": {
          "name": "quaki",
          "expr": "happy",
          "say": "I {put} my keys {in} my bag."
        },
        "right": {
          "name": "bruno",
          "expr": "celebrate",
          "say": "Great! You can say {into} too. It shows the movement."
        }
      },
      {
        "caption": "hang and hangs",
        "tag": "{hang} = movement · {hangs} = position",
        "left": {
          "name": "hamsti",
          "expr": "happy",
          "say": "I {hang} the picture {on} the wall."
        },
        "right": {
          "name": "quaki",
          "expr": "oops",
          "say": "It {hangs} {on} the wall … but it's crooked!"
        }
      }
    ]
  },
