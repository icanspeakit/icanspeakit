  "rules": [
    { "variety": "es-ES", "id": "aussage", "curve": "fall", "name": "Statement", "text": "The voice falls at the end.", "parts": [{ "t": "Vivo en Sevilla.", "type": "aussage" }] },
    { "variety": "es-ES", "id": "w", "curve": "fall", "name": "Question-word question", "text": "The voice usually falls at the end, as in a statement. Questions with qué, dónde, cuándo, quién, cómo, por qué, cuánto and cuál. With a gentle rise instead, they sound extra friendly.", "parts": [{ "t": "¿De dónde eres?", "type": "w" }] },
    { "variety": "es-ES", "id": "jn", "curve": "rise", "name": "Yes/no question", "text": "Often the same words as a statement: only the melody, and ¿ ? in writing, makes it a question. The voice rises at the end.", "parts": [{ "t": "¿Eres de Portugal?", "type": "jn" }] },
    { "variety": "es-ES", "id": "echo", "curve": "echo", "name": "Echo question", "text": "The voice rises high at the end. You're surprised or checking what you heard. Spanish often starts it with que.", "parts": [{ "t": "¿Que eres de Portugal?", "type": "echo" }] },
    { "variety": "es-ES", "id": "ausruf", "curve": "excl", "name": "Exclamation", "text": "The stressed word goes very high, then the voice falls a long way. Feeling: joy, anger, surprise.", "parts": [{ "t": "¡Qué bonito!", "type": "ausruf" }] },
    { "variety": "es-ES", "id": "liste", "curve": "flat", "name": "List", "text": "The voice stays up → until the list is finished. Then it falls ↘.", "parts": [{ "t": "Compro pan,", "type": "weiter" }, { "t": "leche", "type": "weiter" }, { "t": "y queso.", "type": "aussage" }] },
    { "variety": "es-ES", "id": "oder", "curve": "rise", "name": "Either-or question", "text": "First choice ↗, last choice ↘.", "parts": [{ "t": "¿Quieres té", "type": "jn" }, { "t": "o café?", "type": "w" }] },
    { "variety": "es-ES", "id": "cortes", "curve": "rise", "name": "Polite request", "text": "In Spain a polite request is usually a question. The voice rises gently at the end, and the friendly tone does the rest.", "parts": [{ "t": "¿Me pones un café, por favor?", "type": "jn" }] }
  ]
}
