  "rules": [
    { "id": "aussage", "curve": "fall", "name": "Statement", "text": "The voice falls at the end.", "parts": [{ "t": "I live in Leeds.", "type": "aussage" }] },
    { "id": "w", "curve": "fall", "name": "Wh- question", "text": "The voice falls at the end, as in a statement. Questions with what, where, when, who, why, how and which.", "parts": [{ "t": "Where are you from?", "type": "w" }] },
    { "id": "jn", "curve": "rise", "name": "Yes/no question", "text": "It starts with a helping verb (are, do, can, have …). The voice rises at the end.", "parts": [{ "t": "Are you from Poland?", "type": "jn" }] },
    { "id": "echo", "curve": "echo", "name": "Echo question", "text": "Word order like a statement, but the voice rises a lot. Not a normal question: you're surprised or checking. A yes/no question starts with a helping verb (“Are you from Poland?”).", "parts": [{ "t": "You're from Poland?", "type": "echo" }] },
    { "id": "ausruf", "curve": "excl", "name": "Exclamation", "text": "The stressed word goes very high, then the voice falls a long way. Feeling: joy, anger, surprise.", "parts": [{ "t": "That's really lovely!", "type": "ausruf" }] },
    { "id": "liste", "curve": "flat", "name": "List", "text": "The voice stays up → until the list is finished. Then it falls ↘.", "parts": [{ "t": "I'm buying bread,", "type": "weiter" }, { "t": "milk", "type": "weiter" }, { "t": "and cheese.", "type": "aussage" }] },
    { "id": "oder", "curve": "rise", "name": "Either-or question", "text": "First choice ↗, last choice ↘.", "parts": [{ "t": "Would you like tea", "type": "jn" }, { "t": "or coffee?", "type": "w" }] }
  ]
