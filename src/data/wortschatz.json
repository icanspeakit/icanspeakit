[
  {"front":"En mi opinión, …","note":"Giving your opinion: a safe way to start in any conversation.","variety":"es-ES","translations":{"en":"In my opinion, …","de":"Meiner Meinung nach …","fr":"À mon avis, …","pt":"Na minha opinião, …","it":"Secondo me, …"}},
  {"front":"Estoy de acuerdo.","note":"Agreeing: more natural than a bare “sí”. In Spain you will also hear “Vale”.","variety":"es-ES","translations":{"en":"I agree.","de":"Ich stimme zu.","fr":"Je suis d'accord.","pt":"Concordo.","it":"Sono d'accordo."}},
  {"front":"¿Cómo estás?","note":"A friendly greeting with tú. Answer: Bien, gracias. ¿Y tú? With usted: ¿Cómo está?","variety":"es-ES","translations":{"en":"How are you?","de":"Wie geht es dir?","fr":"Comment vas-tu ?","pt":"Como vai?","it":"Come stai?"}},
  {"front":"¿De dónde eres?","note":"Answer: Soy de [country]. With usted: ¿De dónde es?","variety":"es-ES","translations":{"en":"Where are you from?","de":"Woher kommst du?","fr":"D'où viens-tu ?","pt":"De onde você é?","it":"Di dove sei?"},"img":"/img/openmoji/1F30D.svg"},
  {"front":"¿A qué te dedicas?","note":"Asking about someone's job. Answer without un or una: Soy enfermera.","variety":"es-ES","translations":{"en":"What do you do?","de":"Was machst du beruflich?","fr":"Qu'est-ce que tu fais dans la vie ?","pt":"O que você faz da vida?","it":"Che lavoro fai?"},"img":"/img/openmoji/1F4BC.svg"},
  {"front":"¿Qué idiomas hablas?","note":"Answer: Hablo …","variety":"es-ES","translations":{"en":"Which languages do you speak?","de":"Welche Sprachen sprichst du?","fr":"Quelles langues parles-tu ?","pt":"Que línguas você fala?","it":"Che lingue parli?"},"img":"/img/openmoji/1F5E3.svg"},
  {"front":"¿Dónde vives?","note":"Answer: Vivo en …","variety":"es-ES","translations":{"en":"Where do you live?","de":"Wo wohnst du?","fr":"Où habites-tu ?","pt":"Onde você mora?","it":"Dove abiti?"},"img":"/img/openmoji/1F3E0.svg"},
  {"front":"el perro","note":"Good: great company, and it gets you outside. Bad: it needs a walk every day.","variety":"es-ES","translations":{"en":"dog","de":"der Hund","fr":"le chien","pt":"o cachorro","it":"il cane"},"img":"/img/openmoji/1F415.svg"},
  {"front":"el gato","note":"Good: it doesn't need much space. Bad: it can scratch the furniture.","variety":"es-ES","translations":{"en":"cat","de":"die Katze","fr":"le chat","pt":"o gato","it":"il gatto"},"img":"/img/openmoji/1F408.svg"},
  {"front":"el hámster","note":"A small pet: it needs little space and little food.","variety":"es-ES","translations":{"en":"hamster","de":"der Hamster","fr":"le hamster","pt":"o hamster","it":"il criceto"}},
  {"front":"la jaula","note":"You need to clean it every week.","variety":"es-ES","translations":{"en":"cage","de":"der Käfig","fr":"la cage","pt":"a gaiola","it":"la gabbia"}},
  {"front":"el veterinario, la veterinaria","note":"Take your pet to the vet when it is ill: Voy al veterinario.","variety":"es-ES","translations":{"en":"vet","de":"der Tierarzt, die Tierärztin","fr":"le vétérinaire, la vétérinaire","pt":"o veterinário, a veterinária","it":"il veterinario, la veterinaria"}},
  {"front":"planear un viaje","note":"Talk together: where to stay, what to do and how much it costs.","variety":"es-ES","translations":{"en":"to plan a trip","de":"eine Reise planen","fr":"préparer un voyage","pt":"planejar uma viagem","it":"organizzare un viaggio"},"img":"/img/openmoji/1F5FA.svg"},
  {"front":"¿Dónde nos quedamos?","note":"Planning a trip and making suggestions.","variety":"es-ES","translations":{"en":"Where shall we stay?","de":"Wo übernachten wir?","fr":"Où est-ce qu'on loge ?","pt":"Onde ficamos?","it":"Dove alloggiamo?"},"img":"/img/openmoji/1F3E8.svg"},
  {"front":"¿Cuánto queremos gastar?","note":"Asking about money when you plan something together.","variety":"es-ES","translations":{"en":"How much do we want to spend?","de":"Wie viel wollen wir ausgeben?","fr":"Combien voulons-nous dépenser ?","pt":"Quanto queremos gastar?","it":"Quanto vogliamo spendere?"},"img":"/img/openmoji/1F4B5.svg"}
]
