{
  "beruf": "buero",
  "title": "Office and admin",
  "level": "A2–B1",
  "reviewed": false,
  "_note": "spanish-for-work run, 2026-11-07: written by hand for Spain, read once by an AI second reader, not yet by a human. translations.en = English meaning; deHint = German translation (the 'German' tab). Words already in the lexicon or in another deck are refs, with this job's own example and sense. Working conditions are general orientation only.",
  "intro": "Office jobs in Spain use more written Spanish and more formal phrases on the phone. This deck has the office and its equipment, daily tasks, meetings and schedules, data protection and filing, and what you say to customers and colleagues. Among colleagues people use tú, even with the boss in most companies; with clients, start with usted.",
  "introEasy": "Do you work in an office in Spain? Learn the words for your work here.",
  "jobs": [
    "Administrativo/a",
    "Auxiliar administrativo/a",
    "Recepcionista",
    "Teleoperador/a",
    "Contable",
    "Atención al cliente"
  ],
  "tipps": [
    "On the phone, give the company and your name: «Inmobiliaria Sol, buenos días, le atiende Sara.» Spanish offices also answer with «¿Dígame?»",
    "In emails, «Estimado señor García:» is formal, and «Hola, Ana:» is fine with colleagues. Spanish uses a colon after the greeting.",
    "Don't leave personal data on your desk or send it by email without need. Ask: «¿Esto se puede enviar por correo?»"
  ],
