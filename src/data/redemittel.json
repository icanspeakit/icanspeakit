        { "de": "The ball is between the boxes.", "bild": "/img/praeposition/zwischen.svg", "en": "between", "ar": "الكرة بين الصندوقين.", "uk": "М'яч лежить між коробками.", "ru": "Мяч лежит между коробками.", "tr": "Top kutuların arasında." },
        { "de": "The picture is on the wall.", "bild": "/img/praeposition/an.svg", "en": "on", "ar": "الصورة معلّقة على الحائط.", "uk": "Картина висить на стіні.", "ru": "Картина висит на стене.", "tr": "Resim duvarda asılı." }
      ]
    }
