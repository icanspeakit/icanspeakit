        { "de": "The ball is in front of the box.", "bild": "/img/praeposition/vor.svg", "en": "in front of", "ar": "الكرة أمام الصندوق.", "uk": "М'яч лежить перед коробкою.", "ru": "Мяч лежит перед коробкой.", "tr": "Top kutunun önünde." },
