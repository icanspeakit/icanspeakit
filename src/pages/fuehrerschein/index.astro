---
// /fuehrerschein — the Führerschein (Klasse B) hub, under Prüfungen next to „Leben in
// Deutschland": a test people sit, framed the same way — kein Sprachtest, ein Wissenstest.
//
// Laid out like the Kultur hub (kultur-hub.css): a quiet title with a mascot, the actions,
// the lessons grouped by Thema-Gruppe with a picture each, then what the theory test is, the
// planned reform in its own box, and the sources at the bottom. Every count on this page is
// read from the data (fuehrerscheinData.js) and every figure from the research file.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import FsGeplant from "../../components/fuehrerschein/FsGeplant.astro";
import FsHinweis from "../../components/fuehrerschein/FsHinweis.astro";
import FsQuellen from "../../components/fuehrerschein/FsQuellen.astro";
import { groups, lessons, questions, questionsOf, lessonHref, lessonPic, vocabCount } from "../../lib/fuehrerscheinData.js";
import { fakt, faktText, sourcesFor, standMonat, RESEARCH } from "../../lib/fuehrerschein.js";
import { iconFile } from "../../lib/wortBild.js";
import "../../styles/practice.css";
import "../../styles/kultur.css";
import "../../styles/kultur-insider.css";
import "../../styles/kultur-hub.css";
import "../../styles/fuehrerschein.css";

const v = (o: Record<string, unknown>) => JSON.stringify(o);
const moji = (e: string) => `/img/openmoji/${iconFile(e)}.svg`;
const anzahl = fakt("theorie.anzahlFragenErsterwerbB").value;
const split = fakt("theorie.aufteilungGrundstoffZusatzstoff").value;
const [fpMin, fpMax] = fakt("theorie.fehlerpunkteProFrage").value;
const maxFp = fakt("theorie.maxFehlerpunkteBestehen").value;
const sprachen: string[] = fakt("theorie.pruefungssprachen").value;
const warten = faktText("theorie.wartezeitWiederholung");
const alter = faktText("theorie.mindestalterB");
const alter17 = faktText("theorie.mindestalterBF17");
const katalog = faktText("theorie.fragenkatalogGroesse");
const demo = fakt("theorie.offiziellerUebungstestB").value;
const theorieKeys = ["theorie.anzahlFragenErsterwerbB", "theorie.aufteilungGrundstoffZusatzstoff", "theorie.fehlerpunkteProFrage",
  "theorie.maxFehlerpunkteBestehen", "theorie.regelZweiFuenfPunkteFragen", "theorie.zeitlimit", "theorie.pruefungssprachen",
  "theorie.wartezeitWiederholung", "theorie.anzahlVersuche", "theorie.mindestalterB", "theorie.mindestalterBF17",
  "theorie.fragenkatalogGroesse", "theorie.fragenkatalogHerausgeberLizenz", "theorie.offiziellerUebungstestB"];
const grouped = groups.map((g: any) => ({ ...g, items: lessons.filter((l: any) => l.group === g.id) })).filter((g: any) => g.items.length);
---
<Layout
  title="Führerschein Klasse B: Theorie und Ablauf – EnglishAcademy"
  description="Führerschein in Deutschland in einfachem Deutsch: Verkehrsregeln mit animierten Szenen, eigene Übungsfragen und eine Übungssimulation, der Ablauf Schritt für Schritt und das Umschreiben eines ausländischen Führerscheins."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main practice-main--wide fs-page">
    <div class="practice-hero fs-hero">
      <p class="eyebrow" data-i18n="fs.hero.eyebrow">Prüfung</p>
      <h1 data-i18n="fs.hero.title">Führerschein Klasse B</h1>
      <div class="fs-badges">
        <span class="fs-badge fs-badge--key" data-i18n="fs.badge.knowledge">Kein Sprachtest — Wissenstest</span>
        <span class="fs-badge" data-i18n="fs.badge.level">Erklärt auf A2–B1</span>
      </div>
      <SectionMascot name="bruno" say="Ich bin dein Fahrlehrer." align="center" class="ku-hero-mascot" />
      <p class="fs-stand" data-i18n="fs.stand" data-i18n-vars={v({ m: standMonat(RESEARCH.stand) })}>Stand: {standMonat(RESEARCH.stand)}</p>
    </div>

    <nav class="fs-actions" aria-label="Führerschein-Bereich" data-i18n-attr="aria-label:fs.hero.title">
      <a class="fs-action fs-action--main" href="/fuehrerschein/ueben">
        <img src={moji("🚦")} alt="" width="44" height="44" />
        <span class="fs-action-txt">
          <b data-i18n="fs.action.ueben">Theorie üben</b>
          <i data-i18n="fs.action.uebenHint" data-i18n-vars={v({ n: questions.length, t: lessons.length })}>{questions.length} eigene Fragen zu {lessons.length} Themen — mit Erklärung</i>
        </span>
      </a>
      <a class="fs-action" href="/fuehrerschein/simulation">
        <img src={moji("⏱️")} alt="" width="34" height="34" />
        <b data-i18n="fs.action.sim">Übungssimulation</b>
        <i data-i18n="fs.action.simHint" data-i18n-vars={v({ n: anzahl })}>{anzahl} Fragen wie in der Prüfung</i>
      </a>
      <a class="fs-action" href="/fuehrerschein/fahrspiel">
        <img src={moji("🚗")} alt="" width="34" height="34" />
        <b data-i18n="fs.action.spiel">Fahrspiel</b>
        <i data-i18n="fs.action.spielHint">Du entscheidest, Quaki fährt</i>
      </a>
      <a class="fs-action" href="/fuehrerschein/ablauf">
        <img src={moji("📋")} alt="" width="34" height="34" />
        <b data-i18n="fs.action.ablauf">Ablauf & Kosten</b>
        <i data-i18n="fs.action.ablaufHint">Von der Fahrschule bis zum Führerschein</i>
      </a>
      <a class="fs-action" href="/fuehrerschein/umschreiben">
        <img src={moji("🌍")} alt="" width="34" height="34" />
        <b data-i18n="fs.action.umschreiben">Umschreiben</b>
        <i data-i18n="fs.action.umschreibenHint">Führerschein aus dem Ausland</i>
      </a>
      <a class="fs-action" href="/fuehrerschein/wortschatz">
        <img src={moji("📝")} alt="" width="34" height="34" />
        <b data-i18n="fs.action.wortschatz">Fahrschul-Wortschatz</b>
        <i data-i18n="fs.action.wortschatzHint" data-i18n-vars={v({ n: vocabCount })}>{vocabCount} Wörter und Sätze</i>
      </a>
    </nav>

    <FsHinweis />

    <h2 class="ku-group-title fs-lessons-title" data-i18n="fs.hub.lessons">Die Regeln — Thema für Thema</h2>
    {grouped.map((g: any) => (
      <section class="ku-group" id={`gruppe-${g.id}`}>
        <h2 class="ku-group-title"><span data-i18n={`fs.group.${g.id}`}>{g.title}</span></h2>
        <div class="ku-grid ku-grid--fill">
          {g.items.map((l: any) => {
            const pic = lessonPic(l);
            const n = questionsOf(l.id).length;
            return (
              <a class="ku-card" href={lessonHref(l.id)}>
                <span class="ku-card-ic ku-card-pic">{pic && <img class={pic.sign ? "fs-zeichen-pic" : ""} src={pic.src} alt="" width="40" height="40" loading="lazy" />}</span>
                <span class="ku-card-txt">
                  <b lang="de">{l.title}</b>
                  <i data-i18n={`fs.lesson.${l.id}.card`}>{l.card}</i>
                </span>
                <span class="ku-card-meta"><span class="ku-card-q" data-i18n="grammatik.card.questions" data-i18n-vars={v({ n })}>{n} Fragen</span></span>
              </a>
            );
          })}
        </div>
      </section>
    ))}

    <section class="fs-box" aria-labelledby="fs-pruefung-h">
      <h2 id="fs-pruefung-h" data-i18n="fs.exam.title">Die Theorieprüfung: so läuft sie</h2>
      <ul class="fs-facts">
        <li><b>{anzahl}</b><span data-i18n="fs.exam.count" data-i18n-vars={v({ g: split.grundstoff, z: split.zusatzstoffB })}>Fragen am Computer: {split.grundstoff} aus dem Grundstoff, {split.zusatzstoffB} aus dem Zusatzstoff für Klasse B.</span></li>
        <li><b>{fpMin}–{fpMax}</b><span data-i18n="fs.exam.points">Fehlerpunkte pro Frage. Wichtige Fragen (z. B. Vorfahrt) zählen mehr.</span></li>
        <li><b>≤ {maxFp}</b><span data-i18n="fs.exam.pass" data-i18n-vars={v({ n: maxFp })}>Bestanden mit höchstens {maxFp} Fehlerpunkten — aber nicht, wenn zwei Fragen mit 5 Punkten falsch sind.</span></li>
        <li><b>⏱</b><span data-i18n="fs.exam.time">Es gibt kein Zeitlimit.</span></li>
        <li><b>{sprachen.length}</b><span data-i18n="fs.exam.langs">Sprachen: Die Theorieprüfung geht auch in deiner Sprache.</span></li>
        <li><b>{warten}</b><span data-i18n="fs.exam.repeat">Nicht bestanden? Frühestens nach dieser Wartezeit noch einmal — so oft du willst.</span></li>
        <li><b>{alter}</b><span data-i18n="fs.exam.age" data-i18n-vars={v({ a: alter17 })}>Mindestalter für Klasse B. Begleitetes Fahren ab {alter17}.</span></li>
      </ul>
      <p class="fs-small" lang="de">{sprachen.join(" · ")}</p>
      <p data-i18n="fs.exam.catalogue" data-i18n-vars={v({ k: katalog })}>Der amtliche Fragenkatalog hat {katalog}. Er gehört der TÜV | DEKRA arge tp 21 und ist lizenziert — darum üben wir hier mit eigenen Fragen zu denselben Regeln.</p>
      <a class="fs-official" href={demo} target="_blank" rel="noopener noreferrer">
        <img src={moji("🎓")} alt="" width="32" height="32" />
        <span><b data-i18n="fs.exam.official">Offizieller Übungstest von TÜV | DEKRA</b><i data-i18n="fs.exam.officialHint">Echte Beispielprüfung, kostenlos ↗</i></span>
      </a>
    </section>

    <FsGeplant />

    <section class="ku-more">
      <div class="ku-more-head">
        <SectionMascot name="quaki" expr="thinking" say="Wie ist das mit dem Auto?" class="ku-more-mascot" />
        <p class="ku-more-lead">
          <span data-i18n="fs.more.lead">Wie viele Menschen in Deutschland ein Auto haben, warum es auf der Autobahn kein allgemeines Tempolimit gibt und was das Deutschlandticket ändert:</span>
          <a href="/culture/insider/cars-and-driving" data-i18n="fs.more.link">Mehr dazu: Deutschland und das Auto →</a>
        </p>
      </div>
    </section>

    <section class="ku-sourcing">
      <h2 data-i18n="fs.sourcing.title">Woher die Inhalte kommen</h2>
      <p data-i18n="fs.sourcing.text">Alle Regeln und Zahlen stammen aus Gesetzen (StVO, FeV, StVG, BKatV) und von Behörden; jede Zahl hat eine Quelle und ein Stand-Datum. Die Übungsfragen, Szenen und Beispiele haben wir selbst geschrieben — sie lehren dieselben Regeln wie die Prüfung, sind aber nicht die amtlichen Prüfungsfragen.</p>
    </section>
    <FsQuellen sources={sourcesFor(theorieKeys)} />
  </main>

  <script>
    // Same pop-in as the Kultur hubs (kultur-hub.css): a group's pictures appear as it
    // scrolls into view; reduced motion shows them at once.
    const sections = document.querySelectorAll(".ku-group");
    if ("IntersectionObserver" in window) {
      document.documentElement.classList.add("ku-anim");
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); }
      }, { rootMargin: "0px 0px -10% 0px" });
      sections.forEach((s) => io.observe(s));
    }
  </script>
</Layout>
