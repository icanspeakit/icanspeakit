---
import { fitTitle } from "../../../lib/seo/title.js";
// One group of the Fahrschul-Wortschatz (~30 words, one sitting).
import Layout from "../../../layouts/Layout.astro";
import VokabelTrainer from "../../../components/VokabelTrainer.astro";
import { GROUPS, cardsOf, LANGS } from "../../../lib/fuehrerscheinWortschatz.js";
import "../../../styles/fuehrerschein.css";

export function getStaticPaths() {
  return GROUPS.map((g: any) => ({ params: { gruppe: g.id }, props: { group: g } }));
}
const { group } = Astro.props as any;
const cards = cardsOf(group.id);
---
<Layout title={fitTitle(`${group.title} – Fahrschul-Wortschatz`, group.title)} description={`Fahrschul-Wortschatz: ${group.title} — ${cards.length} Wörter mit Artikel, Beispielsatz und Übersetzung.`}>
  <VokabelTrainer
    cards={cards}
    heading={group.title}
    headingKey={`fs.ws.group.${group.id}`}
    sub={`Fahrschul-Wortschatz · ${cards.length} Wörter`}
    subParts={[{ text: "Fahrschul-Wortschatz", key: "fs.ws.title" }, { text: `${cards.length} Wörter`, key: "sets.wordCount", vars: { n: cards.length } }]}
    deck={`fuehrerschein-${group.id}`}
    langs={LANGS}
  />
</Layout>
