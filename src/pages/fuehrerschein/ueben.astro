---
// /fuehrerschein/ueben — the own question bank, one topic or all mixed (?thema=<id>).
// Instant feedback with the explanation, the scene played after the answer, „Fehler
// wiederholen" at the end (fahrQuiz.js, practice mode). The Einfache-Sprache switch changes
// the explanations only; the questions stay as written.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import LeichtToggle from "../../components/LeichtToggle.astro";
import FsHinweis from "../../components/fuehrerschein/FsHinweis.astro";
import { lessons, questions, questionsOf } from "../../lib/fuehrerscheinData.js";
import "../../styles/practice.css";
import "../../styles/kultur.css";
import "../../styles/fahr-szene.css";
import "../../styles/fuehrerschein.css";

const v = (o: Record<string, unknown>) => JSON.stringify(o);
---
<Layout
  title="Führerschein-Theorie üben mit Erklärungen – EnglishAcademy"
  description="Theorie für den Führerschein Klasse B üben: eigene Übungsfragen zu Vorfahrt, Verkehrszeichen, Autobahn, Alkohol und mehr — mit Erklärung in einfachem Deutsch."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main fs-page" id="fs-page">
    <div class="ku-topbar">
      <a href="/fuehrerschein" class="vp-back-link" data-i18n="fs.back">Führerschein</a>
    </div>
    <div class="practice-hero fs-hero">
      <p class="eyebrow" data-i18n="fs.ueben.eyebrow">Theorie</p>
      <h1 data-i18n="fs.ueben.title">Theorie üben</h1>
      <p data-i18n="fs.ueben.lead" data-i18n-vars={v({ n: questions.length })}>{questions.length} eigene Fragen zu denselben Regeln wie in der Prüfung. Wähle ein Thema oder übe gemischt.</p>
      <SectionMascot name="quaki" expr="thinking" say="Ich übe mit!" align="center" class="ku-hero-mascot" />
    </div>

    <div class="fs-pick fs-pick--scroll" id="fs-pick" data-scroll-x role="group" aria-label="Thema wählen" data-i18n-attr="aria-label:fs.ueben.pick">
      <button type="button" class="active" data-thema="" data-i18n="fs.ueben.mixed">Gemischt</button>
      {lessons.map((l: any) => <button type="button" data-thema={l.id} lang="de">{l.title} <small>({questionsOf(l.id).length})</small></button>)}
    </div>
    <div class="fs-switchrow"><LeichtToggle /></div>

    <section class="ku-block ku-quizblock">
      <p class="ku-quiz-intro" id="fs-ueben-intro" data-i18n="fs.ueben.mixedIntro">20 Fragen aus allen Themen, gemischt.</p>
      <div class="quiz-card" id="fs-quiz"></div>
    </section>
    <p class="fs-hinweis" role="note"><span class="fs-hinweis-ic" aria-hidden="true">✓</span><span data-i18n="fs.ueben.mcnNote">Bei manchen Fragen sind mehrere Antworten richtig — wie in der echten Prüfung. Dann musst du alle richtigen ankreuzen.</span></p>
    <FsHinweis />
  </main>

  <script>
    import { mountFahrQuiz } from "../../lib/fahrQuiz.js";
    import { mountLeichteSprache } from "../../lib/leichteSprache.js";
    import { enhanceSwitch } from "../../lib/segSwitch.js";
    import { t } from "../../lib/uiText.js";

    import { loadFragen } from "../../lib/fahrQuizData.js";

    mountLeichteSprache(document.getElementById("fs-page") ?? document);
    // The bank is one static file shared with the simulation (fragen.json.js).
    const all = await loadFragen().catch(() => []);
    const root = document.getElementById("fs-quiz")!;
    const pick = document.getElementById("fs-pick")!;
    const intro = document.getElementById("fs-ueben-intro")!;
    const MIXED = 20;
    const shuffle = <T,>(a: T[]) => { const b = [...a]; for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; } return b; };

    function start(thema: string) {
      pick.querySelectorAll<HTMLButtonElement>("button").forEach((b) => b.classList.toggle("active", b.dataset.thema === thema));
      pick.querySelector<HTMLElement>("button.active")?.scrollIntoView({ inline: "center", block: "nearest" });
      const list = thema ? all.filter((q: any) => q.topic === thema) : shuffle(all).slice(0, MIXED);
      const title = thema ? (pick.querySelector<HTMLElement>(`[data-thema="${thema}"]`)?.firstChild?.textContent ?? "").trim() : "";
      intro.removeAttribute("data-i18n");
      intro.textContent = thema
        ? t("fs.ueben.topicIntro", "{n} Fragen zum Thema „{t}“.", { n: list.length, t: title })
        : t("fs.ueben.mixedIntro", "20 Fragen aus allen Themen, gemischt.");
      mountFahrQuiz(root, list, { mode: "practice" });
      const url = new URL(location.href);
      if (thema) url.searchParams.set("thema", thema); else url.searchParams.delete("thema");
      history.replaceState(null, "", url);
    }

    if (!all.length) root.textContent = t("fs.quiz.loadError", "Die Fragen konnten nicht geladen werden. Bitte lade die Seite neu.");
    pick.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-thema]");
      if (b) start(b.dataset.thema ?? "");
    });
    const wanted = new URLSearchParams(location.search).get("thema") ?? "";
    if (all.length) start(all.some((q: any) => q.topic === wanted) ? wanted : "");
    enhanceSwitch(pick, { content: [root] });
  </script>
</Layout>
