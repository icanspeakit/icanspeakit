---
// /fuehrerschein/umschreiben — „Woher ist dein Führerschein?" → EU/EWR, a state in FeV
// Anlage 11, or another state → what applies: the deadline, the tests, the translation,
// where to go. The official Anlage 11 is linked, never copied; country examples come only
// from the research file (laenderBeispiele, each checked against Anlage 11).
//
// Edgar's decisions (docs/fuehrerschein-quellen.md → Entscheidungen): no cities, fees only as
// „je nach Stadt etwa 30–60 €"; USA: no states listed — „hängt vom Bundesstaat ab", the
// link, and „Fahrerlaubnisbehörde fragen". Without JS all three answers stand open.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import FsHinweis from "../../components/fuehrerschein/FsHinweis.astro";
import FsQuellen from "../../components/fuehrerschein/FsQuellen.astro";
import { fakt, faktText, sourcesFor, standMonat, datum, RESEARCH } from "../../lib/fuehrerschein.js";
import { iconFile } from "../../lib/wortBild.js";
import "../../styles/practice.css";
import "../../styles/kultur.css";
import "../../styles/kultur-insider.css";
import "../../styles/fuehrerschein.css";

const v = (o: Record<string, unknown>) => JSON.stringify(o);
const moji = (e: string) => `/img/openmoji/${iconFile(e)}.svg`;
const anlage11 = fakt("umschreiben.anlage11Url").value;
const frist = faktText("umschreiben.drittstaatFahrberechtigungFrist");
const unterlagen: string[] = fakt("umschreiben.typischeUnterlagen").value;
const gebuehr = faktText("umschreiben.gebuehrSpanneSeiten");
const ukraineSeit = datum(fakt("umschreiben.ukraineAnlage11Seit").value);
const ukraineBis = datum(fakt("umschreiben.ukraineSchutzEnde").value);
// The examples that are checked and `ok` — USA is UNVERIFIED per state and stays out.
const lb = RESEARCH.laenderBeispiele as Record<string, any>;
const ohneAnlage = Object.entries(lb).filter(([, e]) => e.status === "ok" && String(e.value).startsWith("nicht in Anlage 11")).map(([k]) => k);
const keys = ["umschreiben.euEwrGueltig", "umschreiben.euEwrAusnahmen", "umschreiben.drittstaatFahrberechtigungFrist", "umschreiben.drittstaatFristVerlaengerung",
  "umschreiben.drittstaatNachFristablauf", "umschreiben.fahrenOhneFahrerlaubnis", "umschreiben.uebersetzungWannNoetig", "umschreiben.uebersetzungWerDarf",
  "umschreiben.anlage11Url", "umschreiben.anlage11Kategorien", "umschreiben.nichtAnlage11Regeln", "umschreiben.fahrschulePflichtFuerPruefung",
  "umschreiben.zustaendigeStelle", "umschreiben.typischeUnterlagen", "umschreiben.gebuehrSpanneSeiten", "umschreiben.pruefungsSprachen",
  "umschreiben.ukraineSonderregel", "umschreiben.ukraineAnlage11Seit", "laenderBeispiele.Türkei"];
---
<Layout
  title="Ausländischen Führerschein umschreiben – EnglishAcademy"
  description="Führerschein aus dem Ausland in Deutschland: Was gilt für EU-Führerscheine, für Staaten der Anlage 11 und für alle anderen? Fristen, Prüfungen, Übersetzung — einfach erklärt, mit offiziellen Quellen."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main fs-page" id="fs-page">
    <div class="ku-topbar">
      <a href="/fuehrerschein" class="vp-back-link" data-i18n="fs.back">Führerschein</a>
    </div>
    <div class="practice-hero fs-hero">
      <p class="eyebrow" data-i18n="fs.um.eyebrow">Führerschein aus dem Ausland</p>
      <h1 data-i18n="fs.um.title">Umschreiben</h1>
      <SectionMascot name="bruno" expr="thinking" say="Woher ist dein Führerschein?" align="center" class="ku-hero-mascot" />
      <p class="fs-stand" data-i18n="fs.stand" data-i18n-vars={v({ m: standMonat(RESEARCH.stand) })}>Stand: {standMonat(RESEARCH.stand)}</p>
    </div>
    <FsHinweis umschreiben />

    <h2 class="fs-q" data-i18n="fs.um.question">Woher ist dein Führerschein?</h2>
    <div class="fs-chooser" id="fs-chooser" role="group" aria-label="Woher ist dein Führerschein?" data-i18n-attr="aria-label:fs.um.question">
      <button type="button" data-for="eu"><img src={moji("🌍")} alt="" width="30" height="30" /><span><b data-i18n="fs.um.euBtn">Aus der EU oder dem EWR</b><i data-i18n="fs.um.euHint">z. B. Polen, Italien, Rumänien, Norwegen</i></span></button>
      <button type="button" data-for="a11"><img src={moji("📋")} alt="" width="30" height="30" /><span><b data-i18n="fs.um.a11Btn">Aus einem Staat der Anlage 11</b><i data-i18n="fs.um.a11Hint">z. B. Ukraine, Japan, Schweiz, Vereinigtes Königreich</i></span></button>
      <button type="button" data-for="andere"><img src={moji("🗺️")} alt="" width="30" height="30" /><span><b data-i18n="fs.um.otherBtn">Aus einem anderen Staat</b><i data-i18n="fs.um.otherHint">z. B. Türkei, Syrien, Afghanistan</i></span></button>
    </div>
    <p class="fs-small"><span data-i18n="fs.um.listNote">Welche Staaten in der Anlage 11 stehen, steht in der offiziellen Liste:</span> <a href={anlage11} target="_blank" rel="noopener noreferrer">FeV Anlage 11 ↗</a></p>

    <section class="fs-answer fs-box" id="um-eu" data-answer="eu">
      <h2 data-i18n="fs.um.eu.title">EU und EWR: Dein Führerschein gilt weiter</h2>
      <ul>
        <li data-i18n="fs.um.eu.1">Mit einem gültigen Führerschein aus der EU oder dem EWR darfst du in Deutschland weiter fahren. Du musst ihn nicht umschreiben.</li>
        <li data-i18n="fs.um.eu.2">Du kannst ihn freiwillig in einen deutschen Führerschein umtauschen.</li>
        <li data-i18n="fs.um.eu.3">Ausnahmen gibt es zum Beispiel, wenn es nur ein Lernführerschein ist oder wenn dir in Deutschland der Führerschein entzogen wurde.</li>
      </ul>
    </section>

    <section class="fs-answer fs-box" id="um-a11" data-answer="a11">
      <h2 data-i18n="fs.um.a11.title">Anlage 11: Umschreiben, oft ohne Prüfung</h2>
      <ul>
        <li data-i18n="fs.um.a11.1" data-i18n-vars={v({ f: frist })}>Du darfst {frist} nach deinem Umzug nach Deutschland mit deinem Führerschein fahren. Danach brauchst du den deutschen Führerschein.</li>
        <li data-i18n="fs.um.a11.2">Für jeden Staat und jede Klasse steht in der Liste: keine Prüfung, nur Theorie oder nur Praxis.</li>
        <li data-i18n="fs.um.a11.3">Sehtest, Erste-Hilfe-Kurs und Fahrschule brauchst du dann nicht. Die Behörde kann aber eine Prüfung verlangen, wenn sie Zweifel hat.</li>
      </ul>
      <div class="fs-box" style="margin:12px 0 0">
        <h3 lang="de">Ukraine</h3>
        <p data-i18n="fs.um.ua.1" data-i18n-vars={v({ d: ukraineSeit })}>Seit dem {ukraineSeit} steht die Ukraine in der Anlage 11: Umschreiben ohne Prüfung.</p>
        <p data-i18n="fs.um.ua.2" data-i18n-vars={v({ d: ukraineBis })}>Hast du vorübergehenden Schutz? Dann gilt dein gültiger ukrainischer Führerschein bis zum {ukraineBis} auch ohne Umschreiben.</p>
      </div>
      <div class="fs-box" style="margin:12px 0 0">
        <h3 lang="de">USA</h3>
        <p data-i18n="fs.um.us">Bei den USA hängt es vom Bundesstaat ab. Schau in die Anlage 11 und frag die Fahrerlaubnisbehörde.</p>
      </div>
    </section>

    <section class="fs-answer fs-box" id="um-andere" data-answer="andere">
      <h2 data-i18n="fs.um.other.title">Andere Staaten: Theorie- und Fahrprüfung</h2>
      <ul>
        <li data-i18n="fs.um.other.1" data-i18n-vars={v({ f: frist })}>Du darfst {frist} nach deinem Umzug nach Deutschland mit deinem Führerschein fahren. Danach nicht mehr.</li>
        <li data-i18n="fs.um.other.2">Du machst die Theorieprüfung und die praktische Prüfung. Pflicht-Fahrstunden gibt es nicht — aber eine Fahrschule muss dich zur Prüfung anmelden.</li>
        <li data-i18n="fs.um.other.3">Sehtest und Erste-Hilfe-Kurs brauchst du trotzdem.</li>
        <li data-i18n="fs.um.other.4">Die Theorieprüfung geht auch in vielen anderen Sprachen. Die praktische Prüfung ist auf Deutsch.</li>
      </ul>
      <p><span data-i18n="fs.um.other.examples">Zum Beispiel nicht in der Anlage 11:</span> <span lang="de">{ohneAnlage.join(" · ")}</span></p>
      <p><a href="/fuehrerschein/ueben" data-i18n="fs.um.other.practice">Für die Theorie üben →</a></p>
    </section>

    <section class="fs-box" id="um-alle">
      <h2 data-i18n="fs.um.all.title">Für alle aus Nicht-EU-Staaten</h2>
      <ul>
        <li><b data-i18n="fs.um.all.deadlineK">Frist:</b> <span data-i18n="fs.um.all.deadline">Stell den Antrag früh, am besten ein paar Monate vor Ende der Frist. Wer danach ohne deutschen Führerschein fährt, macht sich strafbar.</span></li>
        <li><b data-i18n="fs.um.all.extendK">Verlängern?</b> <span data-i18n="fs.um.all.extend">Nur, wenn du nicht länger als ein Jahr in Deutschland bleibst.</span></li>
        <li><b data-i18n="fs.um.all.translK">Übersetzung:</b> <span data-i18n="fs.um.all.transl">Ist dein Führerschein nicht auf Deutsch, brauchst du oft eine Übersetzung — zum Beispiel vom ADAC oder von einem beeidigten Übersetzer. Frag die Behörde, welche sie annimmt.</span></li>
        <li><b data-i18n="fs.um.all.whereK">Wo?</b> <span data-i18n="fs.um.all.where">Bei der Fahrerlaubnisbehörde (Führerscheinstelle) an deinem Wohnort. Du musst selbst hingehen.</span></li>
        <li><b data-i18n="fs.um.all.costK">Kosten:</b> <span data-i18n="fs.um.all.cost" data-i18n-vars={v({ g: gebuehr })}>Je nach Stadt etwa {gebuehr}, dazu Kosten für Sehtest, Erste-Hilfe-Kurs, Passfoto und eventuell Übersetzung. Frag die Fahrerlaubnisbehörde deiner Stadt.</span></li>
      </ul>
      <h3 data-i18n="fs.um.all.docs">Diese Unterlagen braucht man meistens</h3>
      <ul lang="de">{unterlagen.map((u) => <li>{u}</li>)}</ul>
      <div class="fs-say"><b data-i18n="fs.ablauf.say">So sagst du es</b>
        <span lang="de" style="display:block">„Ich möchte meinen ausländischen Führerschein umschreiben lassen.“</span>
        <span lang="de" style="display:block">„Brauche ich eine Übersetzung?“</span>
        <span lang="de" style="display:block">„Muss ich eine Prüfung machen?“</span>
      </div>
    </section>

    <a class="fs-official" href={anlage11} target="_blank" rel="noopener noreferrer">
      <img src={moji("📋")} alt="" width="32" height="32" />
      <span><b data-i18n="fs.um.official">Offizielle Liste: FeV Anlage 11</b><i data-i18n="fs.um.officialHint">gesetze-im-internet.de ↗</i></span>
    </a>

    <FsQuellen sources={sourcesFor(keys)} />
    <FsHinweis umschreiben />
  </main>

  <script>
    import { enhanceSwitch } from "../../lib/segSwitch.js";
    // The chooser: one answer at a time once a country group is picked. Before that — and
    // without JavaScript — every answer stands open, so nothing is hidden from anyone.
    const chooser = document.getElementById("fs-chooser")!;
    const answers = [...document.querySelectorAll<HTMLElement>("[data-answer]")];
    chooser.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-for]");
      if (!b) return;
      chooser.querySelectorAll("button").forEach((x) => { x.classList.toggle("active", x === b); x.setAttribute("aria-pressed", String(x === b)); });
      answers.forEach((a) => (a.hidden = a.dataset.answer !== b.dataset.for));
      document.getElementById(`um-${b.dataset.for}`)?.scrollIntoView({ block: "nearest", behavior: "smooth" });
    });
    enhanceSwitch(chooser, { content: answers });
  </script>
</Layout>
