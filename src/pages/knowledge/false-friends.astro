---
// /knowledge/false-friends — embarazada, éxito, carpeta: Spanish words that learners mix up,
// false friends and look-alikes. Each trap gets the funny wrong sentence
// (said by one of the crew, the wrong word in red), a reaction, the right sentence and a
// memory trick. At the foot a quiz over all of them, ten gaps a round.
//
// The words live in src/data/wortfallen.json; their pictures are OpenMoji fetched by
// scripts/fetch-openmoji.mjs. Spanish at A1–B1, explained in easy English, linked from the
// Wissen menu (navWortfallen in catalog.js). With the mascots switched off the figures
// hide and each card still reads on its own.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { mascotSvg } from "../../lib/mascots.js";
import { emojiSrc } from "../../lib/wortBild.js";
import data from "../../data/wortfallen.json";
import "../../styles/practice.css";

type Name = "bruno" | "regi" | "hamsti" | "quaki";
const NAMES: Record<Name, string> = { bruno: "Bruno", regi: "Regi", hamsti: "Hamsti", quaki: "Quaki" };
const COLORS: Record<Name, string> = { bruno: "#946620", regi: "#2b4162", hamsti: "#f2a900", quaki: "#2563eb" };

const groups = data.groups.map((g) => ({ ...g, who: g.who as Name, audio: Boolean((g as { audio?: boolean }).audio) }));
// "*éxito*" → the marked word in its own span.
const parts = (s: string) => s.split(/\*([^*]+)\*/).map((t, i) => ({ t, mark: i % 2 === 1 }));
const title = (g: (typeof groups)[number]) => g.words.map((w) => w.w.replace(/^(el|la) /, "")).join(" · ");

// Audio from scripts/generate-wortfallen-audio.mjs; a group has it once `audio` is set.
const AUDIO = "/audio/wortfallen";
const quiz = groups.flatMap((g) => g.quiz.map((q, n) => ({ ...q, g: g.id, tip: g.tip, audio: g.audio ? `${AUDIO}/${g.id}-q${n + 1}.mp3` : null })));
// The same sentences as a chapter of the teachers' live quiz (src/lib/liveQuiz/chapters.js).
const LIVE = "/teachers/quiz?grammar=g-wortfallen";
// Interface keys: what each word means, the reaction and the memory trick are translated
// (wortfallen.<id>.*); the words and sentences themselves are the Spanish being taught.
const K = (id: string) => `wortfallen.${id}`;
---
<Layout
  title="Word traps: words learners of Spanish mix up – icanspeak Spanish"
  description="Embarazada or embarrassed? Éxito or exit? Words that look alike but mean something else – with a memory trick and a quiz. Free, for A1 to B1."
>
  <SiteNav active="wissen" />
  <main class="practice-main practice-main--wide wf-page">
    <header class="practice-hero wf-hero">
      <p class="eyebrow" data-i18n="merch.filter.wf">Wortfallen</p>
      <h1 lang="en">Word traps: look-alikes and false friends</h1>
      <p class="wf-lead" data-i18n="wortfallen.lead" data-i18n-vars={JSON.stringify({ n: groups.length })}>Manche Wörter klingen fast gleich – und bedeuten etwas ganz anderes. Hier sind die {groups.length} lustigsten Fallen, jede mit Merktrick.</p>
      <div class="wf-actions">
        <a class="btn btn-primary" href="#quiz" data-i18n="wortfallen.toQuiz">Direkt zum Quiz</a>
        <span class="wf-sub">
          <a href={LIVE} data-live data-i18n="wortfallen.asLive">Als Live-Quiz</a>
          <span aria-hidden="true">·</span>
          <button type="button" data-print data-i18n="vp.rule.print">Drucken</button>
        </span>
      </div>
    </header>

    <nav class="wf-index" aria-labelledby="wf-index-h">
      <h2 id="wf-index-h" class="wf-index-h" data-i18n="wortfallen.indexTitle" data-i18n-vars={JSON.stringify({ n: groups.length })}>Alle {groups.length} Fallen</h2>
      <ol>
        {groups.map((g) => (
          <li>
            <a href={`#${g.id}`}>
              <img src={emojiSrc(g.words[0].emoji)} alt="" width="20" height="20" loading="lazy" />
              <span lang="es">{title(g)}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <ol class="wf-list">
      {groups.map((g) => (
        <li class="wf-card" id={g.id} style={`--mk:${COLORS[g.who]}`}>
          <h2 class="wf-title" lang="es">{title(g)}</h2>
          <ul class="wf-words">
            {g.words.map((w, wi) => (
              <li>
                <img src={emojiSrc(w.emoji)} alt="" width="44" height="44" loading="lazy" />
                <span><b lang="es">{w.w}</b><i data-i18n={`${K(g.id)}.m${wi + 1}`}>{w.meaning}</i></span>
              </li>
            ))}
          </ul>

          <div class="wf-oops">
            <span class="wf-fig" aria-hidden="true" data-mascot-part>
              <Fragment set:html={mascotSvg({ name: g.who, expr: "oops", view: "front", size: 56, label: "" })} />
              <span class="wf-name">{NAMES[g.who]}</span>
            </span>
            <div class="wf-bubble">
              <p class="wf-label"><span aria-hidden="true">✗</span> <span data-i18n="vt.mark.wrong">Falsch</span>{g.audio && <button class="wf-play" type="button" data-play={`${AUDIO}/${g.id}-falsch.mp3`} aria-label="Falschen Satz anhören" data-i18n-attr="aria-label:wortfallen.playWrong"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/></svg></button>}</p>
              <p class="wf-said" lang="es">{parts(g.oops).map((p) => (p.mark ? <s class="wf-bad">{p.t}</s> : p.t))}</p>
              <p class="wf-react" data-i18n={`${K(g.id)}.react`}>{g.react}</p>
            </div>
          </div>

          <div class="wf-yay">
            <div class="wf-right">
              <p class="wf-label"><span aria-hidden="true">✓</span> <span data-i18n="vt.mark.right">Richtig</span>{g.audio && <button class="wf-play" type="button" data-play={`${AUDIO}/${g.id}-richtig.mp3`} aria-label="Richtigen Satz anhören" data-i18n-attr="aria-label:wortfallen.playRight"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/></svg></button>}</p>
              <p lang="es">{parts(g.right).map((p) => (p.mark ? <b class="wf-good">{p.t}</b> : p.t))}</p>
            </div>
            <span class="wf-fig" aria-hidden="true" data-mascot-part>
              <Fragment set:html={mascotSvg({ name: g.who, expr: "happy", view: "front", size: 56, label: "" })} />
              <span class="wf-name">{NAMES[g.who]}</span>
            </span>
          </div>

          <p class="wf-tip"><span aria-hidden="true">💡</span> <b data-i18n="wortfallen.tipLabel">Merktrick:</b> <span data-i18n={`${K(g.id)}.tip`}>{g.tip}</span></p>
        </li>
      ))}
    </ol>

    {/* The quiz: ten gaps a round, drawn from every trap above. A wrong pick shows the
        right word and that trap's memory trick; the round ends with the crew cheering. */}
    <section class="wf-quiz" id="quiz" aria-labelledby="wf-quiz-h">
      <h2 id="wf-quiz-h" data-i18n="wortfallen.quiz.title">Fall nicht rein!</h2>
      <p class="wf-quiz-lead" data-i18n="wortfallen.quiz.lead">Welches Wort passt? Nach jeder Antwort hörst du den ganzen Satz.</p>
      <div class="wf-q-len" role="radiogroup" aria-label="Wie viele Sätze?" data-i18n-attr="aria-label:wortfallen.quiz.lenLabel" data-len>
        <button type="button" role="radio" aria-checked="true" data-n="10" data-i18n="wortfallen.quiz.n" data-i18n-vars='{"n":10}'>10 Sätze</button>
        <button type="button" role="radio" aria-checked="false" data-n="all" data-i18n="wortfallen.quiz.all" data-i18n-vars={JSON.stringify({ n: quiz.length })}>Alle {quiz.length} Sätze</button>
      </div>
      <div class="wf-q" data-quiz>
        <p class="wf-q-count" data-count aria-live="polite"></p>
        <p class="wf-q-s" data-sentence lang="es"></p>
        <div class="wf-q-opts" data-opts lang="es"></div>
        <p class="wf-q-fb" data-feedback aria-live="polite" hidden></p>
        <button class="wf-play wf-play--quiz" type="button" data-replay hidden aria-label="Satz noch einmal anhören" data-i18n-attr="aria-label:wortfallen.quiz.replay"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 0 0-2.5-4v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z"/></svg><span data-i18n="wg.listen">Anhören</span></button>
        <button class="btn btn-primary wf-q-next" type="button" data-next hidden data-i18n="quiz.next">Weiter</button>
        <div class="wf-q-end" data-end hidden>
          <p class="wf-q-score" data-score></p>
          <button class="btn btn-primary" type="button" data-again data-i18n="wortfallen.quiz.again">Noch eine Runde</button>
        </div>
      </div>
      <noscript><p data-i18n-skip lang="en">The quiz needs JavaScript.</p></noscript>
      <p class="wf-live">
        <span aria-hidden="true">📺</span> <span data-i18n="wortfallen.live.q">Mit der ganzen Klasse?</span> <a href={LIVE} data-live data-i18n="wortfallen.live.cta">Als Live-Quiz spielen</a> <span data-i18n="wortfallen.live.how">– am Beamer, alle antworten am Handy.</span>
      </p>
    </section>

    {/* Print only: the quiz sentences as a worksheet, with the answers on their own page. */}
    <section class="wf-print-sheet" aria-hidden="true">
      <h2 data-i18n="wortfallen.print.title">Übung: Welches Wort passt?</h2>
      <p data-i18n-html="wortfallen.print.nameDate">Name: ______________________ &nbsp; Datum: ____________</p>
      <ol class="wf-print-ex">
        {quiz.map((q) => <li lang="es">{q.s.replace("___", "__________")} <small>({[...q.o].sort((a, b) => a.localeCompare(b, "es")).join(" / ")})</small></li>)}
      </ol>
      <div class="wf-print-key">
        <h2 data-i18n="wortfallen.print.key">Lösungen</h2>
        <ol lang="es">{quiz.map((q) => <li>{q.a}</li>)}</ol>
      </div>
    </section>

    <section class="wf-more">
      <h2 data-i18n="picker.resume.cta">Weiter üben</h2>
      <div class="wf-more-links">
        <a href="/vocabulary" data-i18n="wortfallen.more.wortschatz">Wortschatz mit Karteikarten</a>
        <a href="/pronunciation" data-i18n="wortfallen.more.aussprache">Aussprache: ü, ö, ä und lange Vokale</a>
        <a href="/knowledge/learning" data-i18n="wortfallen.more.lernen">Warum Fehler beim Lernen helfen</a>
      </div>
    </section>
  </main>

  <script is:inline type="application/json" id="wf-quiz-data" set:html={JSON.stringify(quiz)}></script>

  {/* Global, not scoped: the quiz builds its buttons and gap in JS, which scoped styles
      never reach. Every class here starts with wf-. */}
  <style is:global>
    .wf-hero { text-align: center; }
    .wf-lead { max-width: 36rem; margin: 0 auto; color: var(--muted); font-size: 1.05rem; line-height: 1.55; }
    .wf-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 18px; margin-top: 20px; }
    .wf-sub { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: .95rem; }
    .wf-sub a, .wf-sub button { padding: 6px 2px; border: 0; background: none; color: var(--ink); font: inherit; font-weight: 600; text-decoration: underline; text-decoration-color: var(--border); text-underline-offset: 4px; cursor: pointer; }
    .wf-sub a:hover, .wf-sub button:hover { text-decoration-color: currentColor; }
    /* .btn sets display, which beat the hidden attribute (Weiter showed before an answer). */
    .wf-page [hidden] { display: none !important; }
    .wf-live { margin: 14px 0 0; font-size: .92rem; color: var(--muted); line-height: 1.5; }
    .wf-live a { font-weight: 600; }
    .wf-print-sheet { display: none; }

    /* A tidy table of contents: equal columns, read top to bottom, no chip cloud. */
    .wf-index { max-width: 60rem; margin: 28px auto 0; padding: 14px 16px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-card); }
    .wf-index-h { margin: 0 0 8px; font-size: .78rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
    .wf-index ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 2px 12px; margin: 0; padding: 0; list-style: none; }
    .wf-index a {
      display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 8px;
      color: var(--ink); font-size: .9rem; text-decoration: none; transition: background .15s ease;
    }
    .wf-index a span { min-width: 0; line-height: 1.3; }
    .wf-index img { flex: none; }
    .wf-index a:hover { background: color-mix(in srgb, var(--brand-teal, #2b4162) 10%, transparent); }

    .wf-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: 16px; margin: 28px 0 0; padding: 0; list-style: none; }
    .wf-card {
      display: flex; flex-direction: column; gap: 12px; padding: 18px;
      border: 1px solid var(--border); border-top: 5px solid var(--mk);
      border-radius: var(--radius-lg); background: var(--surface-card); box-shadow: var(--shadow-sm);
    }
    .wf-card:target { box-shadow: 0 0 0 3px color-mix(in srgb, var(--mk) 40%, transparent); }
    .wf-title { margin: 0; font-size: 1.2rem; }
    .wf-words { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
    .wf-words li { display: flex; align-items: center; gap: 10px; }
    .wf-words img { flex: none; }
    .wf-words span { display: flex; flex-direction: column; min-width: 0; }
    .wf-words b { font-size: 1.02rem; }
    .wf-words i { font-style: normal; font-size: .86rem; color: var(--muted); line-height: 1.35; }

    .wf-label { margin: 0 0 2px; font-size: .74rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
    .wf-oops { display: flex; align-items: flex-start; gap: 10px; }
    .wf-fig { flex: none; display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .wf-name { font-size: .72rem; color: var(--muted); }
    .wf-bubble { flex: 1; min-width: 0; padding: 10px 12px; border-radius: 4px 14px 14px 14px; background: color-mix(in srgb, #dc2626 8%, var(--surface-card)); }
    .wf-bubble .wf-label { color: #b91c1c; }
    .wf-said { margin: 0; font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
    .wf-bad { color: #dc2626; text-decoration-thickness: 2px; }
    .wf-react { margin: 6px 0 0; font-size: .9rem; font-style: italic; color: var(--muted); line-height: 1.4; }
    .wf-yay { display: flex; align-items: flex-start; gap: 10px; }
    .wf-right { flex: 1; min-width: 0; padding: 10px 12px; border-radius: 14px 4px 14px 14px; background: color-mix(in srgb, #16a34a 9%, var(--surface-card)); }
    .wf-right .wf-label { color: #15803d; }
    .wf-right p:last-child { margin: 0; font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
    .wf-good { color: #15803d; }
    .wf-tip { margin: 0; font-size: .9rem; line-height: 1.5; }

    .wf-quiz { max-width: 40rem; margin: 40px auto 0; text-align: center; scroll-margin-top: 90px; }
    .wf-quiz h2 { margin: 0 0 4px; font-size: 1.45rem; }
    .wf-quiz-lead { margin: 0 0 14px; color: var(--muted); }
    .wf-q { padding: 20px 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-card); box-shadow: var(--shadow-sm); }
    .wf-q-count { margin: 0 0 8px; font-size: .82rem; color: var(--muted); }
    .wf-q-s { margin: 0 0 16px; font-size: 1.2rem; font-weight: 600; line-height: 1.45; }
    .wf-q-gap { display: inline-block; min-width: 4.5em; border-bottom: 2px solid var(--ink); }
    .wf-q-gap.is-right { color: #15803d; border-color: #15803d; }
    .wf-q-opts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .wf-q-opts button {
      min-height: 46px; padding: 8px 18px; border-radius: 999px; border: 2px solid var(--border);
      background: var(--surface-card); color: var(--ink); font: inherit; font-weight: 600; cursor: pointer;
      transition: border-color .15s ease, background .15s ease, transform .1s ease;
    }
    .wf-q-opts button:hover:not(:disabled) { border-color: var(--brand-teal, #2b4162); }
    .wf-q-opts button:active:not(:disabled) { transform: scale(.97); }
    .wf-q-opts button.is-right { border-color: #16a34a; background: color-mix(in srgb, #16a34a 14%, var(--surface-card)); }
    .wf-q-opts button.is-wrong { border-color: #dc2626; background: color-mix(in srgb, #dc2626 12%, var(--surface-card)); animation: wf-shake .35s ease; }
    .wf-q-opts button:disabled { cursor: default; }
    @keyframes wf-shake { 25% { transform: translateX(-4px); } 75% { transform: translateX(4px); } }
    .wf-q-fb { margin: 14px 0 0; line-height: 1.5; }
    .wf-q-next { margin-top: 14px; vertical-align: top; min-height: 44px; }
    .wf-play {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px; vertical-align: middle;
      min-width: 32px; height: 32px; margin-left: 8px; padding: 0 8px; border: 0; border-radius: 999px;
      background: color-mix(in srgb, currentColor 14%, transparent); color: inherit;
      font: inherit; font-weight: 600; letter-spacing: 0; text-transform: none; cursor: pointer;
    }
    .wf-play:hover { background: color-mix(in srgb, currentColor 24%, transparent); }
    .wf-play.is-playing { animation: wf-pulse 1s ease-in-out infinite; }
    @keyframes wf-pulse { 50% { transform: scale(1.12); } }
    .wf-play--quiz { margin: 14px 8px 0 0; vertical-align: top; height: 44px; padding: 0 16px; color: var(--brand-teal, #2b4162); }
    .wf-q-len { display: inline-flex; gap: 4px; margin: 0 0 14px; padding: 4px; border-radius: 999px; background: color-mix(in srgb, var(--ink) 6%, transparent); }
    .wf-q-len button { min-height: 38px; padding: 6px 16px; border: 0; border-radius: 999px; background: transparent; color: var(--ink); font: inherit; font-weight: 600; cursor: pointer; }
    .wf-q-len button[aria-checked="true"] { background: var(--surface-card); box-shadow: var(--shadow-sm); }
    .wf-q-score { margin: 0 0 12px; font-size: 1.15rem; font-weight: 700; }

    .wf-more { max-width: 40rem; margin: 36px auto 0; text-align: center; }
    .wf-more h2 { margin: 0 0 10px; font-size: 1.1rem; }
    .wf-more-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .wf-more-links a { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--border); color: var(--ink); text-decoration: none; font-size: .9rem; }
    .wf-more-links a:hover { border-color: var(--brand-teal, #2b4162); }

    @media (max-width: 480px) {
      /* One swipeable row instead of a whole screen of chips. */
      .wf-index { margin-inline: -24px; padding: 0; border: 0; border-radius: 0; background: none; }
      .wf-index-h { padding: 0 24px; }
      .wf-index ol { display: flex; gap: 6px; overflow-x: auto; padding: 2px 24px 6px; scrollbar-width: none; }
      .wf-index li { flex: none; }
      .wf-index a { border: 1px solid var(--border); border-radius: 999px; background: var(--surface-card); padding: 6px 10px; }
      .wf-card { padding: 14px; }
      .wf-q { padding: 16px 12px; }
      .wf-q-s { font-size: 1.1rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .wf-q-opts button.is-wrong, .wf-play.is-playing { animation: none; }
      .wf-index a { transition: none; }
    }
    @media print {
      .wf-page { max-width: none; padding: 0; }
      .wf-actions, .wf-index, .wf-quiz, .wf-more, .wf-play, [data-mascot-part] { display: none !important; }
      .wf-hero { margin-bottom: 8px; }
      .wf-list { grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
      .wf-card { box-shadow: none; break-inside: avoid; padding: 10px; gap: 6px; }
      .wf-words img { width: 28px; height: 28px; }
      .wf-print-sheet { display: block; break-before: page; }
      .wf-print-ex { columns: 1; line-height: 2; }
      .wf-print-ex small { color: #555; }
      .wf-print-key { break-before: page; }
      .wf-print-key ol { columns: 3; }
    }
  </style>

  <script>
    import { celebrate } from "../../lib/mascotCelebrate.js";
    import { track } from "../../lib/track.js";
    import { enhanceSwitch } from "../../lib/segSwitch.js";
    import { t, i18nAttrs } from "../../lib/uiText.js";
    import { withBase } from "../../lib/paths.js";

    // One player for the page: a new sentence stops the one before.
    const player = new Audio();
    let playing: HTMLElement | null = null;
    const stopMark = () => { playing?.classList.remove("is-playing"); playing = null; };
    player.addEventListener("ended", stopMark);
    player.addEventListener("pause", stopMark);
    function play(src: string, btn?: HTMLElement | null) {
      player.pause();
      player.src = withBase(src);
      player.play().then(() => { if (btn) { playing = btn; btn.classList.add("is-playing"); } }).catch(() => {});
    }
    for (const b of Array.from(document.querySelectorAll<HTMLElement>(".wf-card [data-play]"))) {
      b.addEventListener("click", () => {
        play(b.dataset.play!, b);
        track("wortfallen_audio", { file: b.dataset.play!.split("/").pop() });
      });
    }
    for (const b of Array.from(document.querySelectorAll<HTMLElement>("[data-print]"))) {
      b.addEventListener("click", () => { track("wortfallen_print", {}); window.print(); });
    }
    for (const a of Array.from(document.querySelectorAll<HTMLElement>("[data-live]"))) {
      a.addEventListener("click", () => track("wortfallen_live", {}));
    }

    type Q = { s: string; o: string[]; a: string; g: string; tip: string; audio: string | null };
    let ROUND = 10;
    const all: Q[] = JSON.parse(document.getElementById("wf-quiz-data")?.textContent ?? "[]");
    const box = document.querySelector<HTMLElement>("[data-quiz]");
    const $ = <T extends HTMLElement>(sel: string) => box?.querySelector<T>(sel) ?? null;
    const PRAISE: [string, string][] = [
      ["vt.learn.right", "Richtig!"], ["wortfallen.praise.exact", "Genau!"], ["wortfallen.praise.super", "Super!"],
      ["wortfallen.praise.noTrap", "Keine Falle für dich!"], ["wortfallen.praise.perfect", "Perfekt!"],
    ];
    // A text that follows a later language switch by itself: key and numbers on the element.
    const paint = (el: HTMLElement, key: string, de: string, vars?: Record<string, unknown>) => {
      el.dataset.i18n = key;
      if (vars) el.dataset.i18nVars = JSON.stringify(vars);
      else delete el.dataset.i18nVars;
      el.textContent = t(key, de, vars);
    };

    const shuffle = <T,>(xs: T[]) => {
      const a = xs.slice();
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

    let round: Q[] = [];
    let i = 0;
    let score = 0;

    // A short round takes one question per trap, so it is not three times éxito. „Alle“
    // asks every sentence, avoiding two of the same trap in a row where it can.
    function newRound() {
      if (ROUND === Infinity) {
        let order = shuffle(all);
        for (let t = 0; t < 30 && order.some((q, k) => k > 0 && order[k - 1].g === q.g); t++) order = shuffle(all);
        round = order;
      } else {
        const byGroup = new Map<string, Q[]>();
        for (const q of shuffle(all)) byGroup.set(q.g, [...(byGroup.get(q.g) ?? []), q]);
        round = shuffle([...byGroup.values()].map((qs) => qs[0])).slice(0, ROUND);
      }
      i = 0;
      score = 0;
      $("[data-end]")!.hidden = true;
      for (const sel of ["[data-count]", "[data-sentence]", "[data-opts]"]) $(sel)!.hidden = false;
      show();
    }

    function show() {
      const q = round[i];
      paint($("[data-count]")!, "wortfallen.quiz.count", "Satz {i} von {n}", { i: i + 1, n: round.length });
      $("[data-sentence]")!.innerHTML = esc(q.s).replace("___", '<span class="wf-q-gap" data-gap>&nbsp;</span>');
      const opts = $("[data-opts]")!;
      opts.innerHTML = "";
      for (const o of shuffle(q.o)) {
        const b = document.createElement("button");
        b.type = "button";
        b.textContent = o;
        b.addEventListener("click", () => pick(b, o));
        opts.append(b);
      }
      $("[data-feedback]")!.hidden = true;
      $("[data-next]")!.hidden = true;
      $("[data-replay]")!.hidden = true;
    }

    function pick(btn: HTMLButtonElement, o: string) {
      const q = round[i];
      const ok = o === q.a;
      if (ok) score++;
      for (const b of Array.from($("[data-opts]")!.querySelectorAll("button"))) {
        b.disabled = true;
        if (b.textContent === q.a) b.classList.add("is-right");
      }
      if (!ok) btn.classList.add("is-wrong");
      const gap = $("[data-gap]")!;
      gap.textContent = q.a;
      gap.classList.add("is-right");
      const fb = $("[data-feedback]")!;
      const [pk, pde] = PRAISE[Math.floor(Math.random() * PRAISE.length)];
      fb.innerHTML = ok
        ? `<b${i18nAttrs(pk)}>${esc(t(pk, pde))}</b>`
        : `<span data-i18n-html="wortfallen.quiz.wrong" data-i18n-vars="${esc(JSON.stringify({ a: esc(q.a) }))}">${t("wortfallen.quiz.wrong", "<b>Hoppla – reingefallen!</b> Richtig ist „{a}“.", { a: esc(q.a) })}</span><br><span>💡 <span${i18nAttrs(`wortfallen.${q.g}.tip`)}>${esc(t(`wortfallen.${q.g}.tip`, q.tip))}</span></span> <a href="#${q.g}"${i18nAttrs("wortfallen.quiz.toTrap")}>${esc(t("wortfallen.quiz.toTrap", "Zur Falle"))}</a>`;
      fb.hidden = false;
      if (q.audio) {
        const re = $("[data-replay]")!;
        re.hidden = false;
        play(q.audio, re);
      }
      const next = $<HTMLButtonElement>("[data-next]")!;
      if (i + 1 < round.length) paint(next, "quiz.next", "Weiter");
      else paint(next, "fs.result", "Ergebnis");
      next.hidden = false;
      next.focus({ preventScroll: true });
    }

    function end() {
      for (const sel of ["[data-count]", "[data-sentence]", "[data-opts]", "[data-feedback]", "[data-next]", "[data-replay]"]) $(sel)!.hidden = true;
      const [mk, mde] = score === round.length ? ["wortfallen.end.perfect", "Keine einzige Falle! Du bist ein Profi."] : score >= round.length * 0.7 ? ["wortfallen.end.good", "Sehr gut – fast keine Falle erwischt dich."] : ["wortfallen.end.again", "Die Fallen sind gemein. Lies die Merktricks und versuch es noch mal!"];
      const msg = t(mk, mde);
      $("[data-score]")!.innerHTML = `<span${i18nAttrs("wortfallen.end.score", { score, n: round.length })}>${t("wortfallen.end.score", "{score} von {n} richtig.", { score, n: round.length })}</span> <span${i18nAttrs(mk)}>${esc(msg)}</span>`;
      $("[data-end]")!.hidden = false;
      track("wortfallen_quiz", { score, of: round.length });
      celebrate({ title: t("wortfallen.end.title", "{score} von {n}", { score, n: round.length }), body: msg, lead: score >= round.length * 0.7 ? "bruno" : "quaki", expr: score >= round.length * 0.7 ? "celebrate" : "oops" });
    }

    $("[data-next]")?.addEventListener("click", () => {
      i++;
      if (i < round.length) show();
      else end();
    });
    $("[data-again]")?.addEventListener("click", newRound);
    $("[data-replay]")?.addEventListener("click", () => {
      const q = round[i];
      if (q?.audio) play(q.audio, $("[data-replay]"));
    });
    // 10 Sätze / Alle: switching starts a new round.
    const len = document.querySelector<HTMLElement>("[data-len]");
    if (len) {
      for (const b of Array.from(len.querySelectorAll<HTMLButtonElement>("button"))) {
        b.addEventListener("click", () => {
          if (b.getAttribute("aria-checked") === "true") return;
          for (const o of Array.from(len.querySelectorAll("button"))) o.setAttribute("aria-checked", String(o === b));
          ROUND = b.dataset.n === "all" ? Infinity : Number(b.dataset.n);
          player.pause();
          newRound();
        });
      }
      enhanceSwitch(len, { content: box ? [box] : null });
    }
    if (box && all.length) newRound();
  </script>
</Layout>
