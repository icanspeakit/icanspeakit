    .ln-links a {
      padding: 6px 13px; border-radius: var(--radius-pill); text-decoration: none; font-weight: 600; font-size: .88rem;
      color: var(--ink); border: 1px solid color-mix(in srgb, var(--mk) 45%, var(--border));
    }
    .ln-links a:hover { background: color-mix(in srgb, var(--mk) 12%, transparent); }

    /* With the mascots switched off the figure column goes; the rule reads on its own. */
    :global(html[data-mascots="off"]) .ln-who,
    :global(html[data-mascots="off"]) .ln-crew { display: none; }

    .ln-sum {
      max-width: 46rem; margin: 28px auto 10px; padding: 20px 22px; text-align: left;
      border-radius: var(--radius-lg); background: color-mix(in srgb, var(--brand-teal, #0d9488) 9%, var(--surface-card));
      border: 1px solid color-mix(in srgb, var(--brand-teal, #0d9488) 30%, var(--border));
