      .ln-wheel-ring svg { display: none; }
      .ln-wheel-hub { position: static; border-radius: var(--radius); padding: 0 0 10px; background: none; }
      .ln-wheel ol { position: relative; display: grid; gap: 10px; }
      .ln-wheel ol::before { content: ""; position: absolute; left: 18px; top: 12px; bottom: 12px; width: 2px; background: var(--border); }
      .ln-wheel-item { position: relative; left: auto; top: auto; }
      .ln-wheel-item a, .ln-wheel-item--l a, .ln-wheel-item--b a, .ln-wheel-item--t a { transform: none; flex-direction: row; text-align: left; gap: 12px; max-width: none; width: auto; }
    }
    @media (max-width: 560px) {
      .ln-jungle-steps { grid-template-columns: minmax(0, 1fr); }
      .ln-jungle-steps li { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: 12px; align-items: start; }
      .ln-jungle-steps li > :global(svg) { grid-row: span 2; }
      .ln-jungle-steps h3 { margin: 0 0 4px; }
      .ln-rule { flex-direction: column; padding: 16px; gap: 12px; }
      .ln-who { flex: none; flex-direction: row; align-self: stretch; justify-content: flex-start; padding: 8px 12px; }
      .ln-who :global(svg) { width: 56px; height: 56px; }
      .ln-say { text-align: left; font-size: .95rem; }

    }
    @media (prefers-reduced-motion: reduce) { .ln-crew-fig, .ln-hop, .ln-crew-fig:hover .ln-hop, .ln-wheel-n { animation: none; } .ln-wheel-ring path { animation: none; stroke-dashoffset: 0; } }
  </style>
</Layout>
