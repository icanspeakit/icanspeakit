    /* Phone and narrow tablet: the wheel unrolls into a list on a vertical track, the hub
       as its heading. Same badges, same colours, nothing positioned. */
    @media (max-width: 720px) {
      .ln-jungle-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
