    .ln-studies > p { margin: 0 0 12px; color: var(--muted); font-size: .9rem; }
    .ln-studies ol { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
    .ln-studies li { display: flex; gap: 10px; padding: 8px 10px; border-radius: var(--radius-sm); scroll-margin-top: 90px; transition: background .3s ease; }
    .ln-studies li:target { background: color-mix(in srgb, var(--brand-teal, #0d9488) 12%, transparent); }
    .ln-studies-n { flex: none; width: 2.4em; font-weight: 700; color: var(--brand-teal, #0d9488); }
    .ln-studies-shows { margin: 0 0 2px; font-size: .93rem; line-height: 1.45; }
    .ln-studies-cite { margin: 0; font-size: .8rem; line-height: 1.45; color: var(--muted); overflow-wrap: anywhere; }
    .ln-studies-cite a { color: inherit; }

    .ln-wheel-hub, .ln-wheel-ring { pointer-events: none; }
    .ln-rules { display: grid; gap: 16px; max-width: 46rem; margin: 28px auto 0; padding: 0; list-style: none; }
    .ln-rule {
      display: flex; gap: 18px; align-items: flex-start;
      padding: 20px; border: 1px solid var(--border); border-left: 5px solid var(--mk);
      border-radius: var(--radius-lg); background: var(--surface-card); box-shadow: var(--shadow-sm);
      scroll-margin-top: 90px;
    }
    .ln-who {
      flex: 0 0 120px; display: flex; flex-direction: column; align-items: center; gap: 6px;
      padding: 10px 6px; border-radius: var(--radius); background: color-mix(in srgb, var(--mk) 10%, transparent);
    }
    .ln-fig { display: flex; flex-direction: column; align-items: center; gap: 2px; }
    .ln-name { font-family: var(--font-voice); font-weight: 600; font-size: .85rem; color: var(--muted); line-height: 1.2; }
    .ln-who .ln-name { color: color-mix(in srgb, var(--mk) 75%, var(--ink)); }
    .ln-say { margin: 0; font-family: var(--font-voice); font-weight: 600; font-size: .88rem; text-align: center; line-height: 1.3; }
    .ln-body { min-width: 0; flex: 1; }
    .ln-body > p { margin: 0 0 12px; line-height: 1.6; }
    .ln-num { margin: 0 0 2px !important; font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: color-mix(in srgb, var(--mk) 75%, var(--ink)); }
    .ln-body h2 { margin: 0 0 8px; font-size: 1.3rem; text-align: left; }
    .ln-why { margin: 0 0 14px; padding: 10px 14px; border-radius: var(--radius); background: var(--surface-sunken, rgba(0, 0, 0, .04)); }
    .ln-why h3 { margin: 0 0 4px; font-size: .85rem; color: var(--muted); text-align: left; }
