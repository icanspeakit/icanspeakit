---
// /knowledge/word-stories/review — Edgar's review list: every entry on one page, only what
// has to be checked before approval (root + certainty, path, cognates, the claims about
// other languages, sources), with a „Freigeben" button per word. Works in `astro dev` only:
// the button posts to /api/wortgeschichte/freigeben, which writes the JSON file. A production
// build emits a stub page, noindex, with no entries in it.
import Layout from "../../../layouts/Layout.astro";
import { ENTRIES, byDate, slugOf, hrefOf, audioOf, LANG_NAMES, STATUS, today, formatDe } from "../../../lib/wortgeschichte.js";

const DEV = Boolean(import.meta.env.DEV);
const day = today();
const list = DEV ? byDate(ENTRIES) : [];
const done = list.filter((e) => e.status === STATUS.REVIEWED).length;
const wd = (iso: string) => ["So", "Mo", "Di", "Mi", "Do", "Fr", "Sa"][new Date(iso + "T12:00:00Z").getUTCDay()];
const lang = (c: string) => LANG_NAMES[c] ?? c;
---
<Layout title="Check word stories" description="Internal checklist" noindex>
  <main class="rv">
    {!DEV ? (
      <p>This page only exists in the local preview (<code>astro dev</code>).</p>
    ) : (
      <>
        <header class="rv-head">
          <h1>Check word stories</h1>
          <p class="rv-stats">
            <b data-rv-done>{done}</b> / {list.length} approved ·
            approved without gaps until <b data-rv-until>–</b> ·
            The daily email needs 60 days in advance
          </p>
          <div class="rv-tools">
            <div class="rv-filter" role="group" aria-label="Filter">
              <button type="button" data-f="offen" aria-pressed="true">Open</button>
              <button type="button" data-f="unsicher" aria-pressed="false">Uncertain</button>
              <button type="button" data-f="frei" aria-pressed="false">Approved</button>
              <button type="button" data-f="alle" aria-pressed="false">All</button>
            </div>
            <input type="search" placeholder="Search for a word …" data-rv-q />
          </div>
          <p class="rv-legend">
            <span class="rv-c rv-c--sicher">certain</span>
            <span class="rv-c rv-c--wahrscheinlich">probable</span>
            <span class="rv-c rv-c--umstritten">disputed</span>
            <span class="rv-c rv-c--unklar">unclear</span>
            = how sure the root is. Related/borrowed/coincidence/same picture = claim about the other language.
          </p>
        </header>

        <ol class="rv-list">
          {list.map((e) => {
            const slug = slugOf(e);
            const ok = e.status === STATUS.REVIEWED;
            const audio = audioOf(e);
            const path = [e.root.form, e.root.via?.form, ...(e.stages ?? []).map((s: any) => s.form)].filter(Boolean);
            return (
              <li
                class:list={["rv-row", `rv-row--${e.root.certainty}`, ok && "is-ok", e.publishOn < day && "is-past"]}
                data-slug={slug}
                data-date={e.publishOn}
                data-cert={e.root.certainty}
                data-q={e.lemma.toLowerCase()}
              >
                <div class="rv-when">
                  <span>{wd(e.publishOn)}</span>
                  <b>{e.publishOn.slice(8, 10)}.{e.publishOn.slice(5, 7)}.</b>
                  <small>{e.publishOn.slice(0, 4)}</small>
                </div>

                <div class="rv-main">
                  <div class="rv-word">
                    <a href={hrefOf(e)} target="_blank" rel="noopener">{e.lemma}</a>
                    <span class="rv-lvl">{e.level}</span>
                    {audio && <button type="button" class="rv-play" data-audio={audio} aria-label="Listen">▶</button>}
                  </div>

                  <p class="rv-root">
                    <span class={`rv-c rv-c--${e.root.certainty}`}>{e.root.certainty}</span>
                    <b>{e.root.form}</b> <span class="rv-m">{e.root.lang}{e.root.meaning && <> ‘{e.root.meaning}’</>}</span>
                    {e.root.via && <span class="rv-m"> · via {e.root.via.lang} <b>{e.root.via.form}</b></span>}
                  </p>
                  {e.root.note && <p class="rv-note">{e.root.note}</p>}
                  <p class="rv-path">{path.join(" → ")}</p>

                  {(e.relatives?.cognates?.length > 0) && (
                    <p class="rv-cog">
                      {e.relatives.cognates.map((c: any) => (
                        <span class={`rv-k rv-k--${c.kind}`}>{lang(c.lang)} <b>{c.form}</b>{c.translit && ` (${c.translit})`} · {c.kind ?? "?"}{c.certainty && ` · ${c.certainty}`}</span>
                      ))}
                    </p>
                  )}

                  {(e.elsewhere?.length > 0) && (
                    <ul class="rv-else">
                      {e.elsewhere.map((b: any) => (
                        <li><span class={`rv-k rv-k--${b.kind}`}>{lang(b.lang)} <b>{b.word}</b> · {b.kind}{b.certainty && ` · ${b.certainty}`}</span> {b.chain?.join(" → ")}</li>
                      ))}
                    </ul>
                  )}

                  <details class="rv-more">
                    <summary>Texts &amp; sources</summary>
                    <p>{e.history}</p>
                    {e.elsewhere?.map((b: any) => <p><b>{lang(b.lang)}:</b> {b.text}</p>)}
                    <ul class="rv-src">
                      {e.sources.map((s: any) => <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.work} – {s.entry}</a> : `${s.work} – ${s.entry}`}</li>)}
                    </ul>
                  </details>
                </div>

                <div class="rv-act">
                  <button type="button" class="rv-ok" data-approve>{ok ? "✓ Approved" : "Approve"}</button>
                  {ok && <small class="rv-by">{e.checkedBy}, {formatDe(e.checkedAt)}</small>}
                </div>
              </li>
            );
          })}
        </ol>
      </>
    )}
  </main>
</Layout>

<style>
  .rv { max-width: 1100px; margin: 0 auto; padding: 16px; color: var(--ink); }
  .rv-head { position: sticky; top: 0; z-index: 5; background: var(--surface, #fff); padding: 8px 0 10px; border-bottom: 1px solid var(--border); }
  .rv-head h1 { margin: 0 0 4px; font-size: 1.4rem; }
  .rv-stats { margin: 0 0 8px; color: var(--muted); font-size: .9rem; }
  .rv-tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .rv-filter { display: flex; gap: 4px; flex-wrap: wrap; }
  .rv-filter button, .rv-ok {
    font: inherit; font-size: .85rem; padding: 6px 12px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--border); background: var(--surface-card, #fff); color: var(--ink);
  }
  .rv-filter button[aria-pressed="true"] { background: var(--brand-blue); color: #fff; border-color: var(--brand-blue); }
  .rv-tools input { font: inherit; padding: 6px 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface-card, #fff); color: var(--ink); min-width: 0; flex: 1 1 160px; max-width: 260px; }
  .rv-legend { margin: 8px 0 0; font-size: .75rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 4px 6px; align-items: center; }

  .rv-list { list-style: none; margin: 0; padding: 0; }
  .rv-row {
    display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; gap: 10px; align-items: start;
    padding: 10px 8px; border-bottom: 1px solid var(--border); border-inline-start: 4px solid var(--c, var(--border));
  }
  .rv-row[hidden] { display: none; }
  .rv-row.is-ok { background: color-mix(in srgb, #3fa66b 7%, transparent); }
  .rv-row--sicher { --c: #3fa66b; }
  .rv-row--wahrscheinlich { --c: #1d6fb8; }
  .rv-row--umstritten { --c: #d97706; }
  .rv-row--unklar { --c: #98a2b3; }
  .rv-when { display: grid; justify-items: center; line-height: 1.15; font-size: .75rem; color: var(--muted); }
  .rv-when b { font-size: .95rem; color: var(--ink); }
  .rv-word { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rv-word a { font-size: 1.1rem; font-weight: 700; color: var(--ink); }
  .rv-lvl { font-size: .7rem; font-weight: 700; padding: 1px 6px; border-radius: 99px; background: color-mix(in srgb, var(--brand-blue) 14%, transparent); }
  .rv-play { border: 1px solid var(--border); background: none; border-radius: 50%; width: 26px; height: 26px; cursor: pointer; color: var(--ink); font-size: .7rem; }
  .rv-root, .rv-path, .rv-note, .rv-cog { margin: 4px 0 0; font-size: .88rem; line-height: 1.45; }
  .rv-m { color: var(--muted); }
  .rv-note { color: var(--muted); font-size: .82rem; }
  .rv-path { font-family: ui-monospace, monospace; font-size: .8rem; color: var(--muted); }
  .rv-cog { display: flex; flex-wrap: wrap; gap: 4px; }
  .rv-c, .rv-k { display: inline-block; font-size: .72rem; padding: 1px 7px; border-radius: 99px; border: 1px solid var(--border); }
  .rv-c--sicher { background: color-mix(in srgb, #3fa66b 18%, transparent); }
  .rv-c--wahrscheinlich { background: color-mix(in srgb, #1d6fb8 16%, transparent); }
  .rv-c--umstritten { background: color-mix(in srgb, #d97706 22%, transparent); }
  .rv-c--unklar { background: color-mix(in srgb, #98a2b3 25%, transparent); }
  .rv-k--zufall, .rv-k--parallele { border-style: dashed; }
  .rv-k--entlehnt { background: color-mix(in srgb, #1d6fb8 8%, transparent); }
  .rv-else { margin: 4px 0 0; padding: 0; list-style: none; font-size: .82rem; color: var(--muted); display: grid; gap: 2px; }
  .rv-more { margin-top: 4px; font-size: .85rem; }
  .rv-more summary { cursor: pointer; color: var(--brand-blue-dark, #1d6fb8); font-size: .8rem; }
  .rv-more p { margin: 6px 0; line-height: 1.5; }
  .rv-src { margin: 4px 0; padding-inline-start: 18px; font-size: .78rem; }
  .rv-act { display: grid; justify-items: end; gap: 4px; }
  .rv-ok { white-space: nowrap; }
  .rv-row:not(.is-ok) .rv-ok { background: var(--brand-blue); color: #fff; border-color: var(--brand-blue); }
  .rv-by { font-size: .7rem; color: var(--muted); }
  @media (max-width: 600px) {
    .rv-row { grid-template-columns: 40px minmax(0, 1fr); }
    .rv-act { grid-column: 2; justify-items: start; }
  }
</style>

<script>
  const rows = [...document.querySelectorAll<HTMLElement>(".rv-row")];
  const doneEl = document.querySelector("[data-rv-done]");
  const untilEl = document.querySelector("[data-rv-until]");
  let filter = "offen";
  try { filter = sessionStorage.getItem("rv-filter") || "offen"; } catch {}
  const q = document.querySelector<HTMLInputElement>("[data-rv-q]");

  function stats() {
    if (doneEl) doneEl.textContent = String(rows.filter((r) => r.classList.contains("is-ok")).length);
    const today = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/Berlin" });
    let until = "–";
    for (const r of rows) {
      if ((r.dataset.date ?? "") < today) continue;
      if (!r.classList.contains("is-ok")) break;
      until = r.dataset.date!.split("-").reverse().join(".");
    }
    if (untilEl) untilEl.textContent = until;
  }
  function apply() {
    const term = (q?.value ?? "").trim().toLowerCase();
    for (const r of rows) {
      const ok = r.classList.contains("is-ok");
      const show =
        (filter === "alle" || (filter === "offen" && !ok) || (filter === "frei" && ok) ||
          (filter === "unsicher" && !ok && r.dataset.cert !== "sicher")) &&
        (!term || r.dataset.q!.includes(term));
      r.hidden = !show;
    }
    for (const b of document.querySelectorAll<HTMLButtonElement>("[data-f]")) b.setAttribute("aria-pressed", String(b.dataset.f === filter));
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-f]")) {
    b.addEventListener("click", () => {
      filter = b.dataset.f!;
      try { sessionStorage.setItem("rv-filter", filter); } catch {}
      apply();
    });
  }
  q?.addEventListener("input", apply);

  // Writing the JSON makes the dev server reload the page: keep the scroll position.
  try {
    const y = sessionStorage.getItem("rv-scroll");
    if (y) { scrollTo(0, Number(y)); sessionStorage.removeItem("rv-scroll"); }
  } catch {}

  for (const r of rows) {
    const btn = r.querySelector<HTMLButtonElement>("[data-approve]")!;
    btn.addEventListener("click", async () => {
      const approve = !r.classList.contains("is-ok");
      btn.disabled = true;
      try { sessionStorage.setItem("rv-scroll", String(scrollY)); } catch {}
      const res = await fetch("/api/wortgeschichte/freigeben", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({ slug: r.dataset.slug, approve }),
      }).catch(() => null);
      btn.disabled = false;
      if (!res?.ok) { btn.textContent = "Error – try again"; return; }
      r.classList.toggle("is-ok", approve);
      btn.textContent = approve ? "✓ Approved" : "Approve";
      stats();
      apply();
    });
  }

  let audio: HTMLAudioElement | null = null;
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-audio]")) {
    b.addEventListener("click", () => { audio?.pause(); audio = new Audio(b.dataset.audio!); audio.play().catch(() => {}); });
  }
  stats();
  apply();
</script>
