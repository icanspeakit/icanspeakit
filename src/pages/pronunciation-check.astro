---
// Aussprache-Check: read a sentence aloud, get a score per word from Azure's
// pronunciation assessment. /pronunciation next door is listen-and-repeat with no
// feedback; this is the half that says how it went.
//
// The page itself is static like every other exercise. The only server part is
// /api/speech-token, which trades the Azure key for a 10-minute token — and only for a
// signed-in learner. Listening works for everyone; scoring needs an account.
// Logic: src/lib/ausspracheCheck.js. Sentences: src/data/aussprache-check.json.
//
// First language (src/lib/ausspracheCheckFuerDich.js): the learner picks it here or on
// /culture/mistakes (one shared setting, src/lib/muttersprache.js). Then the result card names
// the mistakes typical for that language, „Für dich" below lists its drills
// (<AusspracheFuerDich>, the same component as on /culture/mistakes), and every finding links to
// its drill and to the explanation on /culture/mistakes. ?lang=<id>&drill=<id> opens a drill.
// Live mode reads a short text in one go and scores it sentence by sentence.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import "../styles/aussprache-check.css";
import AusspracheFuerDich from "../components/AusspracheFuerDich.astro";
import data from "../data/aussprache-check.json";
import PremiumLock from "../components/PremiumLock.astro";
import premiumFeatures from "../data/premium-features.json";

// Daily allowance (src/data/premium-features.json, counted in /api/speech-token), with the
// paywall on or off: 2 sessions a day free. The Premium lock card only with the paywall on;
// with it off a plain "morgen geht's weiter" card.
const PAYWALL = import.meta.env.PUBLIC_PAYWALL === "on";
const freeSessions = premiumFeatures.find((f) => f.id === "aussprache")!.free.limit;
import { mutterspracheInfo } from "../lib/mutterspracheData";

const levels = data.levels;
const total = levels.reduce((n, l) => n + l.sentences.length, 0);
const info = mutterspracheInfo();
---
<Layout
  title="Pronunciation check – practise English pronunciation – icanspeak Spanish"
  description="Say English sentences into the microphone and see at once which words sound right, with a score for each word and a tip for th, w and v, short and long vowels."
>
  <SiteNav active="fertigkeiten" />

  <main class="ac" id="ac-root">
    <header class="ac-head">
      <p class="ac-eyebrow" data-i18n="ac.eyebrow">Sprechen · Aussprache</p>
      <h1 class="ac-title" data-i18n="nav.skill.ausspracheCheck">Aussprache-Check</h1>
      <p class="ac-lead" data-i18n="ac.lead" data-i18n-vars={JSON.stringify({ total })}>Lies den Satz laut vor. Du siehst sofort, welche Wörter schon gut klingen — und bekommst einen Tipp für das schwierigste. {total} Sätze, A1 bis B1.</p>
      <label class="ac-mother">
        <span data-i18n="ac.mother.label">Deine Muttersprache</span>
        <select data-muttersprache>
          <option value="" data-i18n="ac.mother.none">— wählen —</option>
          {info.languages.filter((l) => info.drills[l.id]?.length).map((l) => <option value={l.id}>{l.name}</option>)}
        </select>
      </label>
      <p class="ac-mother-hint" data-i18n="ac.mother.hint">Dann siehst du Fehler, die für deine Sprache typisch sind — und Übungen dazu.</p>
    </header>

    <div class="ac-mode" role="tablist" aria-label="Modus" data-i18n-attr="aria-label:ac.mode.label">
      <button type="button" role="tab" class="ac-mode-tab" data-mode="satz" aria-selected="true" data-i18n="ac.mode.satz">Einzelne Sätze</button>
      <button type="button" role="tab" class="ac-mode-tab" data-mode="live" aria-selected="false" data-i18n="ac.mode.live">Live</button>
    </div>

    <div class="ac-levels" role="tablist" aria-label="Niveau" data-i18n-attr="aria-label:sp.level">
      {levels.map((l, i) => (
        <button type="button" role="tab" class="ac-level" data-level={l.level} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
          {l.level}<span class="ac-level-n">{l.sentences.length}</span>
        </button>
      ))}
    </div>

    <p class="ac-usage" data-ac-usage data-free={freeSessions} hidden></p>
    <section class="ac-card" aria-labelledby="ac-sentence-label" data-card>
      <div class="ac-meta">
        <span id="ac-sentence-label" data-pos lang="en">Sentence 1</span>
        <span class="ac-best" data-best></span>
      </div>
      <div class="ac-focus" data-focus aria-label="Laute in diesem Satz" data-i18n-attr="aria-label:ac.focus.aria"></div>

      <p class="ac-sentence" data-sentence lang="en" aria-live="polite"></p>

      <div class="ac-actions">
        <button type="button" class="ac-btn ac-btn--ghost" data-listen>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4Z" /><path d="M16.5 8.5a5 5 0 0 1 0 7" /></svg>
          <span data-i18n="ak.write.listen">Anhören</span>
        </button>
        <button type="button" class="ac-btn ac-btn--rec" data-record data-state="idle">
          <span class="ac-rec-dot" aria-hidden="true"></span>
          <span data-record-label>Aufnehmen</span>
        </button>
      </div>

      <p class="ac-status" data-status role="status"></p>
      <p class="ac-login" data-login hidden>
        <a class="ac-btn ac-btn--primary" href="/anmelden?next=/pronunciation-check" data-i18n="auth.nav.signIn">Anmelden</a>
        <span data-i18n="ac.login.note" data-i18n-vars={JSON.stringify({ n: freeSessions })}>Mit Konto {freeSessions}× täglich kostenlos. Anhören geht auch ohne Konto.</span>
      </p>
      <div class="ac-limit" data-ac-limit hidden>
        {PAYWALL
          ? <PremiumLock feature="aussprache" variant="limit-reached" />
          : <p class="ac-limit-note" data-i18n="ac.limit.note" data-i18n-vars={JSON.stringify({ n: freeSessions })}>Deine {freeSessions} Sitzungen für heute sind aufgebraucht. Morgen geht es weiter, und Anhören geht immer.</p>}
      </div>

      <div class="ac-results" data-results hidden>
        <div class="ac-overall">
          <div class="ac-ring" data-overall-ring style="--p:0">
            <b data-overall>0</b><small data-i18n="ac.ring.of">von 100</small>
          </div>
          <div class="ac-legend" aria-hidden="true">
            <span><i class="ac-dot ac-dot--good"></i><span data-i18n="ac.legend.good">ab 80</span></span>
            <span><i class="ac-dot ac-dot--ok"></i>60–79</span>
            <span><i class="ac-dot ac-dot--bad"></i><span data-i18n="ac.legend.bad">unter 60</span></span>
            <span data-i18n-html="ac.legend.skipped"><s>Wort</s> ausgelassen</span>
          </div>
        </div>
        <div class="ac-scores" data-scores></div>
        <div class="ac-melody" data-melody hidden></div>
        <div class="ac-detail" data-detail hidden></div>
        <div class="ac-tip" data-tip></div>
        <a class="ac-more" data-more-fehler hidden></a>
      </div>

      <nav class="ac-nav" aria-label="Sätze" data-i18n-attr="aria-label:ac.nav.aria">
        <button type="button" class="ac-btn ac-btn--quiet" data-prev aria-keyshortcuts="ArrowLeft" title="Zurück (←)" data-i18n-attr="title:ac.prev.title" data-i18n="aussprache.prev">← Zurück</button>
        <button type="button" class="ac-btn ac-btn--quiet" data-next aria-keyshortcuts="ArrowRight" title="Weiter (→)" data-i18n-attr="title:ac.next.title" data-i18n="aussprache.next">Weiter</button>
      </nav>
    </section>

    <!-- Live: a short text in one go. Each sentence is coloured as soon as its result is in. -->
    <section class="ac-card ac-live" data-live hidden aria-labelledby="ac-live-title">
      <h2 class="ac-live-title" id="ac-live-title" data-i18n="ac.live.title">Live: den ganzen Text lesen</h2>
      <p class="ac-live-lead" data-i18n="ac.live.lead">Lies die drei Sätze in einem Zug. Jeder Satz färbt sich, sobald er ausgewertet ist. Höchstens 60 Sekunden.</p>
      <div class="ac-live-text" data-live-text lang="en"></div>
      <p class="ac-live-heard" data-live-heard aria-live="polite"></p>
      <div class="ac-actions">
        <button type="button" class="ac-btn ac-btn--rec" data-live-start data-state="idle">
          <span class="ac-rec-dot" aria-hidden="true"></span>
          <span data-live-label data-i18n="ac.live.start">Live starten</span>
        </button>
        <span class="ac-live-timer" data-live-timer aria-live="off"></span>
      </div>
      <p class="ac-status" data-live-status role="status"></p>
      <div data-live-findings></div>
    </section>

    <section class="ac-fuer" aria-labelledby="ac-fuer-title">
      <h2 class="ac-fuer-title" id="ac-fuer-title" data-fuer-head data-i18n="ac.fuer.title">For you</h2>
      <p class="ac-fuer-empty" data-fuer-empty data-i18n="ac.fuer.empty">Wähle oben deine Muttersprache — dann stehen hier Übungen für genau die Laute, die aus deiner Sprache schwer sind.</p>
      <AusspracheFuerDich lang="*" />
    </section>

    <p class="ac-privacy" data-i18n-html="ac.privacy">Deine Aufnahme wird zur Auswertung an Microsoft Azure geschickt und dort nicht gespeichert. Die Satzmelodie wird direkt in deinem Browser berechnet. Mehr in der <a href="/privacy">Datenschutzerklärung</a>.</p>
  </main>

  <script type="application/json" id="ac-data" set:html={JSON.stringify({ levels, info })}></script>
  <script>
    import { mountAusspracheCheck } from "../lib/ausspracheCheck.js";
    import { mountCheckFuerDich } from "../lib/ausspracheCheckFuerDich.js";
    const root = document.getElementById("ac-root");
    const data = JSON.parse(document.getElementById("ac-data")!.textContent || "{}");
    if (root) {
      const { nativeTip } = mountCheckFuerDich(root, { info: data.info, levels: data.levels });
      mountAusspracheCheck(root, { ...data, nativeTip });
    }

    // "Heute noch 1 von 2 Sitzungen" — signed in, not Premium. The count lives on the server
    // (/api/konto/nutzung); a new token (= a new session) refreshes it. Signed out: the offer.
    import { apiFetch } from "../lib/api.js";
    import { track } from "../lib/track.js";
    import { t, onUiText } from "../lib/uiText.js";
    const usage = document.querySelector<HTMLElement>("[data-ac-usage]");
    // data-i18n with the current numbers, so a later language switch repaints it in place.
    function setUsage(key: string, de: string, vars: Record<string, number>) {
      if (!usage) return;
      usage.dataset.i18n = key;
      usage.dataset.i18nVars = JSON.stringify(vars);
      usage.textContent = t(key, de, vars);
      usage.hidden = false;
    }
    // The dictionary may arrive after the first paint.
    onUiText(() => {
      if (!usage?.dataset.i18n) return;
      usage.textContent = t(usage.dataset.i18n, usage.textContent || "", JSON.parse(usage.dataset.i18nVars || "{}"));
    });
    async function showUsage() {
      if (!usage || document.documentElement.dataset.plan === "premium") return;
      if (document.documentElement.dataset.auth !== "in") {
        setUsage("ac.usage.offer", "Mit Konto {n}× täglich kostenlos", { n: Number(usage.dataset.free) });
        return;
      }
      const res = await apiFetch("/api/konto/nutzung", { credentials: "same-origin" }).catch(() => null);
      if (!res?.ok) return;
      const a = (await res.json()).aussprache;
      if (!a || a.limit == null) return;
      setUsage("ac.usage.left", "Heute noch {left} von {limit} Sitzungen", { left: Math.max(0, a.limit - a.used), limit: a.limit });
    }
    showUsage();
    addEventListener("da:aussprache-session", () => {
      track("aussprache_session_started", {});
      showUsage();
    });
  </script>
</Layout>
