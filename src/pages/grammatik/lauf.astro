---
// The guided run — the "pick for me" answer to the chooser on /grammatik.
// Behaviour and the reasoning behind it: src/lib/grammarRun.js.
//
// Only workspace topics take part. A quiz-only topic is a single Lückentext with no
// exercise breakdown, so it cannot be walked one station at a time; putting it in would
// make the run's one promise ("never choose, always one step") untrue at that station.
// Those topics stay reachable from the hub, and a workspace file added later joins the
// run automatically.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import lehrplan from "../../data/grammatik-lehrplan.json";
import "../../styles/practice.css";
import "../../styles/verben-praepositionen.css";
import "../../styles/grammar-run.css";
import "../../styles/ui-text.css";
import { uiTr } from "../../lib/grammarUi.js";
import { isReviewed } from "../../lib/topicStatus.js";

const modules = import.meta.glob("../../data/grammatik/*.json", { eager: true });
// Topics whose exercises are paid (C1, src/paid/) are not stations: the run is free.
const workspaces = Object.values(modules)
  .map((m) => m.default ?? m)
  .filter(isReviewed)
  .filter((w) => !w.exercises?.some((ex) => ex.paid));
const byId = new Map(workspaces.map((w) => [w.id, w]));

const LEVELS = ["A1", "A2", "B1", "B2", "C1"];

// The syllabus decides what is in the run and in what order. A topic the plan does not
// name is Vertiefung: it has its page and its place in the index, but it does not lengthen
// the run (GRAMMAR-PROMPT.md, Tier 0). It used to be appended to its level instead.
//
const inPlan = (level, w) => (lehrplan.order[level] ?? []).some((k) => k === w.id || k === w.slug);

// A topic that teaches two levels on one page (exercise titles "A1: …" / "A2: …", e.g.
// Possessivartikel) can be named a second time in a later level as "id:A2". That later
// entry is a station of its own with only the exercises of that level, and the topic's
// first station then leaves them out — an A1 learner should not meet "mit meinem Bruder"
// before the run has taught the Dativ.
const levelOfEx = (ex) => (ex.title ?? "").match(/^(?:ab )?(A1|A2|B1|B2|C1)(?:\/(A1|A2|B1|B2|C1))?:/)?.slice(1).filter(Boolean) ?? [];
const partKeys = LEVELS.flatMap((level) => (lehrplan.order[level] ?? []).filter((k) => k.includes(":")).map((k) => ({ level, key: k, id: k.split(":")[0] })));
const ordered = [];
for (const level of LEVELS) {
  // By id or slug: the plan names Verben mit Präpositionen by its slug, and looking up ids
  // only used to drop it to the end of B1 whatever the plan said.
  const named = (lehrplan.order[level] ?? []).map((k) => {
    if (k.includes(":")) {
      const [id, part] = k.split(":");
      const w = byId.get(id) ?? workspaces.find((x) => x.slug === id);
      if (!w) return null;
      const only = w.exercises.flatMap((ex, i) => (levelOfEx(ex)[0] === part ? [i] : []));
      return only.length ? { ...w, level: part, part, only } : null;
    }
    const w = byId.get(k) ?? workspaces.find((x) => x.slug === k);
    if (!w) return null;
    const later = partKeys.filter((p) => p.id === w.id || p.id === w.slug).map((p) => p.key.split(":")[1]);
    if (!later.length) return w;
    const only = w.exercises.flatMap((ex, i) => (later.includes(levelOfEx(ex)[0]) ? [] : [i]));
    return { ...w, only };
  }).filter(Boolean);
  const rest = workspaces
    .filter((w) => w.level === level && !named.some((n) => n.id === w.id) && inPlan(level, w))
    .sort((a, b) => a.name.localeCompare(b.name, "de"));
  ordered.push(...named, ...rest);
}

// Only what the run actually reads, so the page does not ship every concept card and
// reference list for 21 topics to a phone.
const stations = ordered.map((w) => ({
  id: w.id,
  name: w.name,
  level: w.level,
  // The later level's part has no subtitle of its own: the name says which part it is.
  ...(w.part ? { part: w.part } : { subtitle: w.subtitle, subtitleKey: w.subtitleKey }),
  only: w.only,
  href: `/${w.slug ?? w.id}`,
  // Each exercise's title and hint in the UI languages, for grammarRun.js (uitHtml).
  exercises: w.exercises.map((ex) => ({ ...ex, titleTr: uiTr(ex.title), hintTr: uiTr(ex.hint) })),
}));

const exerciseCount = stations.reduce((n, t) => n + t.exercises.length, 0);
---
<Layout
  title="Geführter Lauf – Grammatik – EnglishAcademy"
  description={`Ein geführter Weg durch ${stations.length} Grammatikthemen von A1 bis B2 — eine Aufgabe nach der anderen, ohne dass du etwas auswählen musst.`}
>
  <SiteNav active="grammatik" />

  <main class="run-page" id="run-page">
    <a href="/grammatik" class="vp-back-link" data-i18n="run.back">Selbst auswählen</a>

    <div class="run-shell" data-run>
      <!-- The rail is the whole chrome: where you are, and nothing else to decide. -->
      <div class="run-rail">
        <div class="run-track"><i data-run-bar></i></div>
        <div class="run-rail-row">
          <span class="run-count" data-run-count></span>
          <button type="button" class="run-restart" data-run-restart data-i18n="run.restart">Von vorn</button>
        </div>
      </div>

      <p class="run-eyebrow" data-run-eyebrow></p>
      <h1 class="run-title" data-run-title></h1>

      <!-- Shown once per topic, at its first exercise: this is the syllabus speaking. -->
      <div class="run-intro" data-run-intro hidden>
        <p class="run-intro-label" data-i18n="run.newTopic">Neues Thema</p>
        <p class="run-lead" data-run-lead></p>
      </div>

      <div class="run-stage vp-card" data-run-stage></div>

      <div class="run-done" data-run-done hidden>
        <h2 data-i18n="run.done">Durch.</h2>
        <p data-i18n="run.doneText" data-i18n-vars={JSON.stringify({ n: exerciseCount, t: stations.length })}>
          Alle {exerciseCount} Aufgaben aus {stations.length} Themen von A1 bis B2. Der Lauf
          steht wieder auf Station 1 — oder such dir auf der Übersicht gezielt ein Thema aus.
        </p>
        <div class="run-done-actions">
          <button type="button" class="quiz-btn quiz-btn--primary" data-run-restart data-i18n="run.again">Noch einmal</button>
          <a class="quiz-btn" href="/grammatik" data-i18n="run.overview">Zur Übersicht</a>
        </div>
      </div>

      <div class="run-actions">
        <button type="button" class="run-next quiz-btn quiz-btn--primary" data-run-next data-quiet>Weiter</button>
        <button type="button" class="run-skip" data-run-skip data-i18n="run.skip">Thema überspringen</button>
      </div>
    </div>
  </main>

  <script type="application/json" id="run-data" set:html={JSON.stringify(stations)}></script>
  <script>
    import { mountGrammarRun } from "../../lib/grammarRun.js";
    const topics = JSON.parse(document.getElementById("run-data").textContent);
    mountGrammarRun(document.querySelector("[data-run]"), topics);
  </script>
</Layout>
