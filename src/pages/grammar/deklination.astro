---
// Nomen in allen Fällen — the Nachschlagewerk page for nouns, as /grammar/verbs is for
// verbs: type a noun, get Nominativ, Akkusativ, Dativ and Genitiv, singular and plural,
// with der/ein and die/kein ("der Kuchen, den Kuchen, dem Kuchen, des Kuchens").
//
// Every noun of the lexicon is in it. The page ships them as one compact array and the
// browser declines the chosen one with the same src/lib/deklination.js the first render
// uses, so the table looks the same either way. ?wort=Kuchen opens a word and is kept in
// the address, so a table can be shared.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import ShareButton from "../../components/ShareButton.astro";
import KasusChart from "../../components/KasusChart.astro";
import { decline, tableHtml } from "../../lib/deklination.js";
import { nouns } from "../../lib/lexicon.js";
import "../../styles/practice.css";
import "../../styles/deklination.css";

// [lemma, gender, plural, level, en], the most frequent first, one entry per lemma. A noun
// without an article is plural-only (Eltern, Ferien, Kosten): its lemma is its plural.
const seen = new Set<string>();
const list = nouns()
  .filter((n: any) => n.lemma && !seen.has(n.lemma) && seen.add(n.lemma))
  .sort((a: any, b: any) => (a.rank ?? 1e9) - (b.rank ?? 1e9))
  .map((n: any) => [n.lemma, n.gender ?? "", n.plural ?? (n.gender ? "" : n.lemma), n.level ?? "", n.en ?? ""]);
const START = "Kuchen";
const start = nouns().find((n: any) => n.lemma === START)!;
// Words a learner might try first: the most frequent A1 nouns, and one of each kind the
// rules treat differently (n-Deklination, -ns, das Herz, plural only).
const common = list.filter((w) => w[3] === "A1").slice(0, 18).map((w) => w[0]);
const special = ["Kollege", "Herr", "Name", "Student", "Herz", "Haus", "Eltern"].filter((w) => list.some((x) => x[0] === w));
---
<Layout
  title="German noun declension tables – EnglishAcademy"
  description={`Declension tables for ${list.length} German nouns. This page is left over from the German course and will be removed.`}
  breadcrumb={[{ name: "Knowledge", path: "/knowledge" }, { name: "Reference", path: "/reference" }]}
>
  <SiteNav active="grammatik" />
  <main class="practice-main dk-page" id="dk-page">
    <a href="/reference" class="vp-back-link" data-i18n="header.back">Zurück zur Übersicht</a>
    <header class="dk-head">
      <p class="eyebrow" data-i18n="nav.wissen.nachschlagen">Nachschlagewerk</p>
      <h1 data-i18n="dk.title">Nomen in allen Fällen</h1>
      <SectionMascot name="regi" say="Der Artikel verrät den Fall." />
      <p class="dk-lead" data-i18n="dk.lead" data-i18n-vars={JSON.stringify({ n: list.length })}>Schreib ein Nomen und sieh es in allen vier Fällen: Nominativ, Akkusativ, Dativ und Genitiv – im Singular und im Plural. {list.length} Wörter aus dem Wortschatz A1 bis B2.</p>
      <div class="dk-share"><ShareButton label size="sm" /></div>
    </header>

    <KasusChart />

    <form class="dk-search" role="search" id="dk-form">
      <label for="dk-q" class="dk-label" data-i18n="dk.label">Welches Nomen?</label>
      <div class="dk-field">
        <input id="dk-q" name="wort" type="search" lang="de" autocomplete="off" autocapitalize="off" spellcheck="false"
          placeholder="z. B. Kuchen, Kind, Frau" value={START} aria-controls="dk-suggest" aria-autocomplete="list" />
        <button type="submit" class="btn btn-primary" data-i18n="dk.go">Zeigen</button>
      </div>
      <ul class="dk-suggest" id="dk-suggest" role="listbox" hidden></ul>
      <p class="dk-miss" id="dk-miss" role="status" hidden></p>
    </form>

    <div class="dk-chips" lang="de">
      <span data-i18n="dk.common">Häufig:</span>
      {common.map((w) => <a class="dk-chip" href={`?wort=${encodeURIComponent(w)}`} data-wort={w}>{w}</a>)}
    </div>
    <div class="dk-chips" lang="de">
      <span data-i18n="dk.special">Besonders:</span>
      {special.map((w) => <a class="dk-chip dk-chip--special" href={`?wort=${encodeURIComponent(w)}`} data-wort={w}>{w}</a>)}
    </div>

    <div id="dk-out" aria-live="polite"><Fragment set:html={start ? tableHtml(decline(start)) : ""} /></div>

    <section class="dk-rules" aria-labelledby="dk-rules-h">
      <h2 id="dk-rules-h" data-i18n="dk.rules.title">Die Regeln in Kürze</h2>
      <ul lang="de">
        <li><b>Der Artikel zeigt den Fall.</b> Das Nomen selbst bleibt meistens gleich: <i>der, den, dem, des Kuchen(s)</i>.</li>
        <li><b>Feminin ändert sich am wenigsten:</b> <i>die Frau, die Frau, der Frau, der Frau</i>.</li>
        <li><b>Genitiv maskulin und neutral: -s oder -es.</b> <i>des Kuchens, des Autos</i> – nach s, ß, x, z und bei kurzen Wörtern <i>-es</i>: <i>des Hauses, des Tages</i>.</li>
        <li><b>Dativ Plural: immer -n.</b> <i>die Kinder → mit den Kindern</i>. Außer der Plural endet schon auf -n oder -s: <i>mit den Frauen, mit den Autos</i>.</li>
        <li><b>n-Deklination:</b> einige maskuline Nomen bekommen außer im Nominativ immer <i>-(e)n</i>: <i>der Kollege, den Kollegen, dem Kollegen</i>. <a href="/used-to">Mehr dazu</a></li>
      </ul>
      <p class="dk-more" data-i18n-html="dk.more">Fälle üben: <a href="/object-pronouns">Akkusativ</a> · <a href="/two-objects">Dativ</a> · <a href="/s-or-of">Genitiv</a>. Die Verben dazu: <a href="/grammar/verbs">Verbtabellen</a>.</p>
    </section>
  </main>
</Layout>

<script is:inline type="application/json" id="dk-data" set:html={JSON.stringify(list)}></script>

<script>
  import { decline, tableHtml } from "../../lib/deklination.js";

  type Entry = [string, string, string, string, string];
  const list: Entry[] = JSON.parse(document.getElementById("dk-data")!.textContent!);
  const form = document.getElementById("dk-form") as HTMLFormElement;
  const q = document.getElementById("dk-q") as HTMLInputElement;
  const out = document.getElementById("dk-out")!;
  const suggest = document.getElementById("dk-suggest")!;
  const miss = document.getElementById("dk-miss")!;

  // Umlauts and ß typed without them still match: "Kase" finds Käse, "Strasse" Straße.
  const fold = (s: string) => s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/ß/g, "ss")
    .replace(/^(der|die|das)\s+/, "").trim();
  const keys = list.map((w) => [fold(w[0]), fold(w[2])]);

  function find(text: string): Entry | undefined {
    const f = fold(text);
    if (!f) return;
    const i = keys.findIndex(([l, p]) => l === f || p === f);
    return i >= 0 ? list[i] : undefined;
  }

  function show(w: Entry, push = true) {
    const d = decline({ lemma: w[0], gender: w[1] || null, plural: w[2] || null });
    out.innerHTML = tableHtml(d);
    q.value = w[0];
    miss.hidden = true;
    suggest.hidden = true;
    const url = new URL(location.href);
    url.searchParams.set("wort", w[0]);
    if (push) history.replaceState(null, "", url);
  }

  function lookup(text: string) {
    const w = find(text) ?? list[keys.findIndex(([l]) => l.startsWith(fold(text)))];
    if (w && fold(text)) return show(w);
    miss.textContent = `„${text}“ ist nicht in unserem Wortschatz. Probier ein anderes Nomen.`;
    miss.hidden = false;
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    lookup(q.value);
  });

  q.addEventListener("input", () => {
    const f = fold(q.value);
    if (f.length < 2) { suggest.hidden = true; return; }
    const hits = list.filter((_, i) => keys[i][0].startsWith(f) || keys[i][0].includes(f) && f.length > 3).slice(0, 8);
    suggest.innerHTML = hits.map((w) => `<li role="option"><button type="button" data-wort="${w[0]}"><b>${w[1] || "die"}</b> ${w[0]}<span>${w[4]}</span></button></li>`).join("");
    suggest.hidden = hits.length === 0;
  });

  document.addEventListener("click", (e) => {
    const el = (e.target as Element).closest<HTMLElement>("[data-wort]");
    if (!el) return;
    const w = find(el.dataset.wort!);
    if (!w) return;
    e.preventDefault();
    show(w);
    out.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });

  const asked = new URL(location.href).searchParams.get("wort");
  if (asked) {
    const w = find(asked);
    if (w) show(w, false); else lookup(asked);
  }
</script>
