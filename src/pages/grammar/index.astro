---
import Layout from "../../layouts/Layout.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import GrammatikStartTeaser from "../../components/GrammatikStartTeaser.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/practice.css";
import "../../styles/aktiv.css";
import grammatik from "../../data/grammatik.json";
// The icons are shared with /exercises's Grammatik-Werkstatt — two surfaces drawing the
// same topic with two different pictures is how one catalogue becomes two.
import { GRAMMAR_ICON } from "../../lib/catalog.js";
import { isReviewed } from "../../lib/topicStatus.js";
import { topicPath } from "../../lib/routes.js";
import { planRank, byPlan } from "../../lib/lehrplan.js";
import { emojiSrc } from "../../lib/wortBild.js";
import "../../styles/hub-pics.css";

// The hub draws from two pools, in this order of preference:
//   - src/data/grammatik/*.json — full workspaces (concept card + up to five exercises)
//   - grammatik.json            — quiz-only topics still waiting for a workspace
// A workspace shadows the quiz entry with the same id, so promoting a topic is just
// dropping in the JSON file — no change here or in [id].astro.
const workspaceModules = import.meta.glob("../../data/grammatik/*.json", { eager: true });
// Drafts have a page for review but no card here until they are checked.
const workspaces = Object.values(workspaceModules).map((m) => m.default ?? m).filter(isReviewed);
const covered = new Set(workspaces.map((w) => w.id));

const topics = [
  ...workspaces.map((w) => ({
    id: w.id,
    slug: w.slug,
    name: w.name,
    level: w.level,
    intro: w.subtitle,
    // Titles stay German — "Wechselpräpositionen" is the term being taught. The
    // sentence under it is what a learner needs in their own language.
    introKey: `grammatik.${w.id}.intro`,
    href: topicPath(w.slug ?? w.id),
    badge: w.exercises.length + " Aufgabentypen",
    badgeKey: "grammatik.card.taskTypes",
    badgeVars: { n: w.exercises.length },
    isWorkspace: true,
    // Carries the Aktiv mode — hearing and speaking, not just reading and typing. Worth a
    // mark on the card: a learner with ten minutes and headphones is looking for exactly
    // these, and they are otherwise indistinguishable from the silent ones.
    aktiv: !!w.aktiv,
  })),
  ...grammatik
    .filter((t) => !covered.has(t.id))
    .map((t) => ({
      id: t.id,
      name: t.name,
      level: t.level,
      intro: t.intro,
      introKey: `grammatik.${t.id}.intro`,
      href: topicPath(t.id),
      badge: t.questions.length + " Fragen",
      badgeKey: "grammatik.card.questions",
      badgeVars: { n: t.questions.length },
      isWorkspace: t.id === "akkusativ",
    })),
]
  // The course's order (src/data/grammatik-lehrplan.json): what later topics build on
  // comes first. Topics the plan does not place (Vertiefung) follow by name.
  .sort((a, b) => a.name.localeCompare(b.name, "de"))
  .sort(byPlan((t) => [t.slug, t.id]));


// The guided run walks the workspaces in syllabus order (the order itself lives in
// lauf.astro). The chooser below only needs the size of it, derived rather than typed
// so the number cannot go stale when a workspace is added.
// Only topics the plan names are in the run (see lauf.astro); the rest is Vertiefung.
const inRun = workspaces.filter((w) => planRank(w.level, w.id, w.slug) !== Infinity);
const runTopics = inRun.length;
const runStations = inRun.reduce((n, w) => n + w.exercises.length, 0);

// Kern: what the guided run teaches. Vertiefung: topics with their own page that the plan
// does not place — shown under their level, folded away once there are more than three.
const isKern = (t) => planRank(t.level, t.id, t.slug) !== Infinity;
const VERTIEFUNG_OPEN_MAX = 3;

const LEVEL_ORDER = ["A1", "A2", "B1", "B2", "C1"];
const levels = LEVEL_ORDER.filter((lvl) => topics.some((t) => t.level === lvl));

// Every level row is padded with placeholder cards up to this width, so a level with only
// one real topic doesn't stretch into one giant card or look lopsided next to a fuller level.
const ROW_WIDTH = 4;
---
<Layout title="Practise Spanish grammar: A1 to C1 – icanspeak Spanish" description="Practise Spanish grammar topic by topic, by level: ser and estar, the past tenses, object pronouns, the subjunctive and more, each with a rule, examples and exercises.">
  <SiteNav active="grammatik" />
  <main class="practice-main">
    {/* A quiet title and Regi, then straight into the topics — the same first screen as
        /culture. The explanation and the guided run ("Führ mich") stand below the levels:
        between the title and A1 they pushed the topics themselves below the fold. */}
    <div class="hub-hero">
      <p class="eyebrow" data-i18n="grammatik.hero.eyebrow">Grammatik üben</p>
      <h1 data-i18n="grammatik.hero.title">Themen nach Niveau</h1>
      <SectionMascot name="regi" say="Rule by rule." sayKey="grammatik.say.hero" align="center" class="hub-mascot" />
    </div>

    {levels.map((level) => (
      <section class="level-section" id={`niveau-${level.toLowerCase()}`}>
        <div class="level-heading">
          <span class="badge badge-info">{level}</span>
        </div>
        <div class="tool-grid" data-hub-pop>
          {/* Numbered: the order is the course's, and the number is what makes it read as
              a path rather than a pile. */}
          {topics.filter((t) => t.level === level && isKern(t)).map((t, i) => (
            <a class="tool-card" href={t.href}>
              <span class="tool-card-step" aria-hidden="true">{i + 1}</span>
              <div class="tool-card-icon hub-pic"><img src={emojiSrc(GRAMMAR_ICON[t.id] || "📚")} alt="" width="40" height="40" loading="lazy" /></div>
              <h3>{t.name}</h3>
              <p data-i18n={t.introKey}>{t.intro}</p>
              <span class="tool-card-foot">
                <span class={`tool-card-count ${t.isWorkspace ? "tool-card-count--workspace" : ""}`} data-i18n={t.badgeKey} data-i18n-vars={JSON.stringify(t.badgeVars)}>{t.badge}</span>
                {t.aktiv && <span class="tool-card-aktiv" data-i18n="grammatik.card.aktiv" data-i18n-attr="title:grammatik.card.aktivTitle" title="Mit Hör- und Sprechübungen">Hören &amp; Sprechen</span>}
              </span>
            </a>
          ))}
          {Array.from({ length: Math.max(0, ROW_WIDTH - topics.filter((t) => t.level === level && isKern(t)).length) }).map(() => (
            <div class="tool-card tool-card--placeholder" aria-hidden="true">
              <div class="tool-card-icon tool-card-icon--placeholder">+</div>
              <h3 data-i18n="grammatik.card.comingSoonTitle">Weiteres Thema</h3>
              <p data-i18n="grammatik.card.comingSoonDesc">Noch nicht verfügbar.</p>
              <span class="tool-card-count tool-card-count--placeholder" data-i18n="tool.comingSoon.count">Bald verfügbar</span>
            </div>
          ))}
        </div>
        {(() => {
          const extra = topics.filter((t) => t.level === level && !isKern(t));
          if (!extra.length) return null;
          const cards = (
            <div class="tool-grid" data-hub-pop>
              {extra.map((t) => (
                <a class="tool-card" href={t.href}>
                  <div class="tool-card-icon hub-pic"><img src={emojiSrc(GRAMMAR_ICON[t.id] || "📚")} alt="" width="40" height="40" loading="lazy" /></div>
                  <h3>{t.name}</h3>
                  <p data-i18n={t.introKey}>{t.intro}</p>
                  <span class="tool-card-foot">
                    <span class={`tool-card-count ${t.isWorkspace ? "tool-card-count--workspace" : ""}`} data-i18n={t.badgeKey} data-i18n-vars={JSON.stringify(t.badgeVars)}>{t.badge}</span>
                    {t.aktiv && <span class="tool-card-aktiv" data-i18n="grammatik.card.aktiv" data-i18n-attr="title:grammatik.card.aktivTitle" title="Mit Hör- und Sprechübungen">Hören &amp; Sprechen</span>}
                  </span>
                </a>
              ))}
            </div>
          );
          const head = <span class="badge" data-i18n="grammatik.vertiefung" data-i18n-vars={JSON.stringify({ n: extra.length })}>{`Vertiefung · ${extra.length}`}</span>;
          return extra.length > VERTIEFUNG_OPEN_MAX ? (
            <details class="level-vertiefung">
              <summary class="level-heading">{head}</summary>
              {cards}
            </details>
          ) : (
            <div class="level-vertiefung">
              <div class="level-heading">{head}</div>
              {cards}
            </div>
          );
        })()}
      </section>
    ))}

    {/* Below the levels: what the page is, and the guided run for a learner who would
        rather not choose. ("Ich such mir was aus" is gone: it scrolled to the list, which
        is now the first thing on the page.) */}
    <section class="hub-more">
      <div class="hub-more-head">
        <SectionMascot name="quaki" expr="thinking" say="Rather be guided?" sayKey="grammatik.say.guided" />
        <p class="hub-more-lead" data-i18n="grammatik.hero.subtitle">Wähle ein Thema. Die meisten haben einen eigenen Übungsraum mit Erklärung und mehreren Aufgabentypen — die übrigen übst du im Lückentext-Quiz.</p>
      </div>
      {/* The free starter book, in the learner's language (/knowledge#grammatik-start). */}
      <GrammatikStartTeaser />
      <a class="mode-card mode-card--led" href="/grammar/path">
        <span class="mode-ic" aria-hidden="true">▶</span>
        <span class="mode-txt">
          <b data-i18n="grammatik.mode.guided">Führ mich</b>
          <i data-i18n="grammatik.mode.guidedSub" data-i18n-vars={JSON.stringify({ n: runStations, t: runTopics })}>
            {runStations} Aufgaben aus {runTopics} Themen, in der Reihenfolge des Lehrplans — eine nach der anderen, du wählst nichts aus.
          </i>
        </span>
      </a>
      {/* The reference: what Nomen, Verb, Adjektiv … are. The flashcards link to it too. */}
      <a class="mode-card" href="/grammar/parts-of-speech">
        <span class="mode-ic" aria-hidden="true">Aa</span>
        <span class="mode-txt">
          <b data-i18n="grammatik.wa.title">Wortarten</b>
          <i data-i18n="grammatik.wa.sub">Nomen, Verb, Adjektiv … — was sie sind und woran du sie erkennst. Zum Nachschlagen.</i>
        </span>
      </a>
      {/* The look-alikes: man ≠ der Mann, das ≠ dass — each with a gap to try. */}
      <a class="mode-card" href="/grammar/common-mistakes">
        <span class="mode-ic" aria-hidden="true">≠</span>
        <span class="mode-txt">
          <b data-i18n="grammatik.tf.title">Typische Fehler</b>
          <i data-i18n="grammatik.tf.sub">man oder Mann, das oder dass, seid oder seit — Wörter, die man leicht verwechselt. Mit Lücke zum Ausprobieren.</i>
        </span>
      </a>
      {/* The conjugation trainer: drills from the verb tables, and practice sets in sentences. */}
      <a class="mode-card" href="/grammar/conjugation">
        <span class="mode-ic" aria-hidden="true">✎</span>
        <span class="mode-txt">
          <b data-i18n="grammatik.cj.title">Conjugation trainer</b>
          <i data-i18n="grammatik.cj.sub">Drill any tense, mood and verb group, with ser/estar, por/para and subjunctive practice in sentences.</i>
        </span>
      </a>
      {/* The verb tables: sein, haben, the modal verbs … — the search links here too. */}
      <a class="mode-card" href="/grammar/verbs">
        <span class="mode-ic" aria-hidden="true">≡</span>
        <span class="mode-txt">
          <b data-i18n="grammatik.vb.title">Verbtabellen</b>
          <i data-i18n="grammatik.vb.sub">sein, haben, werden, die Modalverben und die wichtigsten unregelmäßigen Verben — Präsens, Präteritum, Perfekt. Zum Nachschlagen.</i>
        </span>
      </a>
    </section>
  </main>
  <script>
    import { mountHubPop } from "../../lib/hubPop.js";
    mountHubPop();
  </script>
</Layout>

<style>
  /* This hub is a card index, not a reading page: widen past the shared 880px article
     width and compact every block so more than one level fits on screen at once. */
  .practice-main { max-width: 1160px; padding-top: 28px; padding-bottom: 56px; }

  /* The chooser. Two answers, equal weight — the guided one is tinted because it is the
     one a new learner should take, not because it is better. */
  .mode-pick {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 28px;
  }
  .hub-more .mode-card { width: 100%; }
  .mode-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    text-align: left;
    padding: 16px 18px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-card);
    cursor: pointer;
    font: inherit;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease, transform .15s ease;
  }
  .mode-card:hover { border-color: var(--brand-blue); }
  .mode-card:active { transform: translateY(1px); }
  .mode-card--led { background: var(--blue-50); border-color: var(--blue-200); }
  .mode-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: 12px;
    background: var(--surface);
    color: var(--brand-blue-dark);
    font-size: .8rem;
  }
  .mode-card--led .mode-ic { background: var(--brand-blue); color: #fff; }
  .mode-txt { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .mode-txt b { font-size: .975rem; font-weight: var(--fw-bold); color: var(--ink); }
  .mode-txt i { font-style: normal; font-size: .8125rem; line-height: 1.45; color: var(--muted); }

  @media (max-width: 640px) {
    .mode-pick { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mode-card { transition: none; }
  }

  .level-section { margin-top: 26px; }
  .level-section:first-of-type { margin-top: 0; }
  /* The nav links straight to a level (#niveau-b1); without this the sticky site header
     lands on top of the badge the learner was aiming at. */
  .level-section { scroll-margin-top: 84px; }
  .level-heading { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .level-vertiefung { margin-top: 22px; }

  /* Fixed column count (instead of the shared tool-grid's auto-fit) so every level lines up
     the same way, whether it has 1 topic or a full row of them. */
  .tool-grid { grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 0; }
  @media (max-width: 1000px) { .tool-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 760px) { .tool-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .tool-grid { grid-template-columns: 1fr; } }

  /* Compact card: fixed icon row, description clamped to 3 lines so a long intro
     can't stretch its whole row into a wall of text. */
  .tool-card { position: relative; padding: 16px 16px 14px; display: flex; flex-direction: column; gap: 8px; }
  /* The step in the course, top right where it does not compete with the picture. */
  .tool-card-step {
    position: absolute; top: 14px; right: 14px;
    min-width: 26px; height: 26px; padding: 0 6px; border-radius: 999px;
    display: grid; place-items: center;
    background: var(--blue-50); color: var(--brand-blue-dark);
    font-family: var(--font-label); font-size: .78rem; font-weight: var(--fw-bold);
  }
  /* Count and "Hören & Sprechen" share one row at the bottom, so every card in a row ends
     on the same line whether it has the second badge or not. */
  .tool-card-foot { margin-top: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .tool-card-foot .tool-card-aktiv { margin: 0; }
  .tool-card-icon { width: 34px; height: 34px; border-radius: 12px; font-size: 1rem; margin-bottom: 2px; }
  .tool-card-icon.hub-pic { width: 44px; height: 44px; border-radius: 0; box-shadow: none; }
  .tool-card h3 { margin: 0; font-size: 1rem; }
  .tool-card p {
    margin: 0;
    font-size: .85rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tool-card-count { align-self: flex-start; font-size: .75rem; padding: 3px 10px; }
  /* A full workspace earns the brand tint; a plain quiz topic stays neutral. */
  .tool-card-count--workspace { background: var(--blue-100); color: var(--brand-blue-dark); }

  .tool-card--placeholder {
    background: var(--surface);
    border-style: dashed;
    border-color: var(--border-strong);
    cursor: default;
  }
  .tool-card--placeholder:hover { transform: none; box-shadow: none; }
  .tool-card--placeholder h3, .tool-card--placeholder p { color: var(--muted-soft); }
  .tool-card-icon--placeholder {
    background: var(--border);
    color: var(--muted-soft);
    font-size: 1.2rem;
    font-weight: 700;
  }
  .tool-card-count--placeholder { background: var(--surface); color: var(--muted-soft); border: 1px solid var(--border-strong); }
</style>
