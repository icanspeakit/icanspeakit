---
import Layout from '../../../layouts/Layout.astro';
import DialogueRoleplay from '../../../components/study/DialogueRoleplay.astro';
---

<Layout
  title="Dialogue Lab — icanspeak.it"
  description="Spiel eine echte Verhandlung am Arbeitsplatz durch — ein verzweigtes Gespräch mit echtem Feedback zu jeder Wahl."
  altHref="/study/dialogue/"
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Study · Konversation</span>
      <h1>Dialogue Lab</h1>
      <p class="lede">
        Das ist ein skriptbasierter Entscheidungsbaum, kein offenes KI-Gespräch — diese Seite hat keine
        KI-Bewertung im Hintergrund. Jede Antwort, die du wählen kannst, kommt mit echtem Feedback zu Ton
        und Grammatik, und drei Zielphrasen sind es wert, unterwegs untergebracht zu werden.
      </p>
    </div>

    <DialogueRoleplay />
  </section>
</Layout>
