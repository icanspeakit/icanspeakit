---
import Layout from '../../../layouts/Layout.astro';
import { RHETORIC_AGENT_ID, pitchPrompts } from '../../../data/exercises/rhetoric';
---

<Layout
  title="Rhetorik & Vortrag — icanspeak.it"
  description="Übe einen kurzen, überzeugenden Pitch vor einer KI-Zuhörerin, die echte Rückfragen stellt."
  altHref="/exercises/rhetoric/"
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Rhetorik &amp; Vortrag</span>
      <h1>Rhetorik &amp; Vortrag</h1>
      <p class="lede">
        Wähl ein Thema, halte laut einen 60–90-Sekunden-Überzeugungs-Pitch und sieh, wie eine leicht
        skeptische Zuhörerin reagiert. Sie kommentiert nicht deinen Akzent — sie reagiert auf dein
        Argument, so wie es eine echte Zuhörerin auch täte.
      </p>
    </div>

    <div class="card rhetoric-prompts">
      <h3>Ein Thema wählen</h3>
      <ul>
        {pitchPrompts.map((prompt) => (
          <li>{prompt}</li>
        ))}
      </ul>
      <p class="text-muted">Oder bring dein eigenes mit — jedes kurze Überzeugungsargument funktioniert.</p>
      <p class="text-muted">
        Wenn du bereit bist, nutze den Assistenten-Button unten rechts, um einen Anruf zu starten und
        deinen Pitch zu halten.
      </p>
    </div>
  </section>

  <elevenlabs-convai agent-id={RHETORIC_AGENT_ID}></elevenlabs-convai>
  <script src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript" is:inline></script>
</Layout>

<script>
  import { logEvent } from '../../../lib/progress-store';

  // The convai-widget-embed loads async, so the custom element may not
  // exist yet — poll briefly rather than assume it's there on script load.
  const attach = () => {
    const widget = document.querySelector('elevenlabs-convai');
    if (!widget) return false;
    widget.addEventListener('conversationStarted', () => logEvent('rhetoric', 'call-started'));
    return true;
  };
  if (!attach()) {
    const interval = setInterval(() => {
      if (attach()) clearInterval(interval);
    }, 300);
    setTimeout(() => clearInterval(interval), 15000);
  }
</script>

<style>
  .rhetoric-prompts ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 0.75rem;
  }

  .rhetoric-prompts li {
    padding-left: 1.1rem;
    position: relative;
  }

  .rhetoric-prompts li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

</style>
