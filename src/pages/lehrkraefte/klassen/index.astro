---
// /lehrkraefte/klassen — a teacher's classes: create one, show its code as text, QR code
// and link, renew the code, see and remove members, archive (KLASSEN-TIERED-PROMPT.md,
// Tier 1). What a class practises is on /lehrkraefte/klassen/klasse?id=… (Tier 3).
//
// Static like the rest of the section; who is signed in and whether they teach is settled
// in the browser, with the same four gates as the quiz builder. Not in the Android app
// (build-app.mjs drops /lehrkraefte).
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import MascotEmpty from "../../../components/mascots/MascotEmpty.astro";
import KlassenConsent from "../../../components/klassen/KlassenConsent.astro";
import { NIVEAUS } from "../../../lib/klassen.js";
import "../../../styles/live-quiz.css";
import "../../../styles/quiz-builder.css";
import "../../../styles/klassen.css";
---
<Layout
  title="Classes – For teachers – EnglishAcademy"
  description="Create a class, give your students the code or QR code, and see who is practising."
  noindex
>
  <SiteNav active="lehrkraefte" />

  <main class="lq kl" id="kl-root">
    <a class="qb-back" href="/lehrkraefte" data-i18n="kl.t.back">Für Lehrkräfte</a>
    <header class="lq-head">
      <p class="lq-eyebrow" data-i18n="kl.t.eyebrow">Für Lehrkräfte · Klassen</p>
      <h1 class="lq-title" data-i18n="kl.t.title">Klassen: sehen, wer übt</h1>
      <p class="lq-lead" data-i18n="kl.t.lead">Leg eine Klasse an und gib den Code weiter. Wer mit dem Code beitritt, sieht vorher genau, was du siehst, und stimmt dem zu.</p>
    </header>

    <section class="lq-card" data-gate="loading">
      <p data-i18n="kl.loading">Einen Moment …</p>
    </section>
    <section class="lq-card kl-stack" data-gate="signin" hidden>
      <h2 data-i18n="kl.t.signin.title">Melde dich an, um Klassen anzulegen</h2>
      <p data-i18n="kl.t.signin.text">Deine Klassen gehören zu deinem Konto. Das Konto ist kostenlos.</p>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/lehrkraefte/klassen" data-i18n="kl.t.signin.button">Anmelden oder registrieren</a>
    </section>
    <section class="lq-card kl-stack" data-gate="teacher" hidden>
      <h2 data-i18n="qb.teacher.title">Unterrichtest du Deutsch?</h2>
      <p data-i18n="kl.t.teacher.text">Dann schalte die Werkzeuge für Lehrkräfte frei: Klassen anlegen und eigene Live-Quizze. Du kannst das jederzeit in deinem Konto unter Einstellungen wieder ausschalten.</p>
      <button type="button" class="lq-btn lq-btn--primary" data-teacher-on data-i18n="qb.teacher.button">Ja, ich unterrichte</button>
      <p class="lq-error" data-teacher-error role="alert"></p>
    </section>

    <div class="kl-stack" data-gate="ok" hidden>
      <form class="lq-card kl-new" data-new>
        <h2 data-i18n="kl.t.new.title">Neue Klasse</h2>
        <div class="kl-new-fields">
          <label class="lq-field">
            <span data-i18n="kl.t.new.name">Name</span>
            <input type="text" maxlength="80" required data-new-name placeholder="z. B. VHS B1 Dienstag" data-i18n-attr="placeholder:kl.t.new.namePh" />
          </label>
          <label class="lq-field">
            <span data-i18n="kl.t.new.level">Niveau</span>
            <select data-new-level>
              <option value="">–</option>
              {NIVEAUS.map((n) => <option value={n}>{n}</option>)}
            </select>
          </label>
        </div>
        <p class="lq-error" data-new-error role="alert"></p>
        <div class="kl-row">
          <button type="submit" class="lq-btn lq-btn--primary" data-new-submit data-i18n="kl.t.new.button">Klasse anlegen</button>
        </div>
      </form>

      <p class="kl-status" data-status role="status" aria-live="polite"></p>
      <ul class="kl-list" data-list></ul>
      <MascotEmpty data-empty hidden text="Noch keine Klasse. Leg oben die erste an." textKey="kl.t.empty">
        <button slot="action" type="button" class="lq-btn lq-btn--primary" data-empty-go data-i18n="kl.t.new.button">Klasse anlegen</button>
      </MascotEmpty>

      <details class="kl-archive" data-archive hidden>
        <summary data-archive-summary></summary>
        <ul class="kl-list" data-archive-list></ul>
      </details>

      <KlassenConsent fuer="lehrkraft" />
    </div>
  </main>

  <script>
    import { mountKlassen } from "../../../lib/klassenLehrkraft.js";
    const root = document.getElementById("kl-root");
    if (root) mountKlassen(root);
    // The empty state's button: to the name field of „Neue Klasse“ above.
    document.querySelector("[data-empty-go]")?.addEventListener("click", () => {
      const name = document.querySelector<HTMLInputElement>("[data-new-name]");
      name?.scrollIntoView({ block: "center", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      name?.focus({ preventScroll: true });
    });
  </script>
</Layout>
