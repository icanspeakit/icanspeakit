---
import { fitTitle } from "../../../../lib/seo/title.js";
// A vocabulary worksheet for one Lernset: print it for a group session, or let learners
// fill it in on screen. Data and parts: src/lib/arbeitsblatt/wortschatz.js. Behaviour
// (modes, checking, meaning language): src/lib/arbeitsblatt/client.js.
//
// The paper itself is English (lang="en"): the words, their simple English definitions and
// the instructions, in the words of the learners' print sheet (WortschatzDruck.astro). The
// controls around it (mode, print, check) follow the site language like every other page.
import Layout from "../../../../layouts/Layout.astro";
import SiteNav from "../../../../components/SiteNav.astro";
import "../../../../styles/arbeitsblatt.css";
import "../../../../styles/teacher-switch.css";
import { wortschatzSheet, worksheetUnits, worksheetLevels, levelWords, SHEET_LANGS, LANG_NAMES } from "../../../../lib/arbeitsblatt/wortschatz.js";
import { isRtl } from "../../../../lib/languages.js";
// One meaning language at a time (arbeitsblatt.css hides .ab-m): the rule per sheet
// language, written from the registry so a new language needs no CSS edit.
// "de" is „In German": the German translation instead of the English definition (sheet.hasDe).
const meaningCss = [...SHEET_LANGS, "de"].map((l) => `#ab-root[data-lang="${l}"] .ab-m[lang="${l}"]`).join(",") + "{display:inline}";

export function getStaticPaths() {
  // A whole level too (a1 … b2): the live quiz's „whole level, mixed" and random mix
  // on paper — words drawn from the whole level (levelWords).
  return [...worksheetUnits().map((u) => u.id), ...worksheetLevels].map((unit) => ({ params: { unit } }));
}

const { unit: unitId } = Astro.params;
const isLevel = worksheetLevels.includes(unitId);
const sheet = isLevel ? wortschatzSheet(unitId, { words: levelWords(unitId) }) : wortschatzSheet(unitId);
const title = isLevel ? `Whole level ${unitId.toUpperCase()}, mixed` : sheet.unit?.title ?? unitId;
const level = isLevel ? unitId.toUpperCase() : sheet.unit?.level ?? "";
const path = `/lehrkraefte/arbeitsblaetter/wortschatz/${unitId}`;
const w = (answers: string[]) => `--w:${Math.max(4, ...answers.map((a) => a.length)) + 2}ch`;
const json = (a: string[]) => JSON.stringify(a);
// English definitions first and chosen; German translations offered after them where
// every matched word has one.
const sheetLangs = sheet.hasDe ? [...SHEET_LANGS, "de"] : SHEET_LANGS;
const firstLang = sheetLangs[0];
const langName = (l: string) => (l === "de" ? "In German" : LANG_NAMES[l]);
let gap = 0;
---
<Layout
  title={fitTitle(`Vocabulary worksheet: ${title} (${level})`, `Worksheet: ${title} (${level})`, `Worksheet: ${title.replace(/\s*[:—].*$/, "")} (${level})`, `Worksheet: ${title.replace(/\s*[:—].*$/, "")}`)}
  description={`Worksheet for the word set “${title}” (${level}): match words and meanings, add a, an or some, complete the sentences. To print or fill in online, with answers.`}
>
  <SiteNav active="lehrkraefte" />

  <style is:inline set:html={meaningCss}></style>
  <main class="ab" id="ab-root" data-mode="print" data-lang={firstLang} data-key="on">
    <div class="ab-bar">
      <a class="ab-back" href="/lehrkraefte/arbeitsblaetter" data-i18n="ab.back">Alle Arbeitsblätter</a>
      <div class="ab-seg t-sw t-sw--fill" role="group" aria-label="Ansicht" data-i18n-attr="aria-label:ab.view">
        <button type="button" data-ab-mode="print" aria-pressed="true"><span class="t-sw-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/></svg></span><span class="t-sw-txt"><b data-i18n="ab.mode.print">Zum Drucken</b><small data-i18n="ab.mode.printSub">Papier oder PDF</small></span></button>
        <button type="button" data-ab-mode="online" aria-pressed="false"><span class="t-sw-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="m9 12 2 2 4-4"/></svg></span><span class="t-sw-txt"><b data-i18n="ab.mode.online">Online ausfüllen</b><small data-i18n="ab.mode.onlineSub">am Gerät prüfen</small></span></button>
      </div>
      <div class="ab-langs t-sw" role="group" aria-label="Bedeutungen auf" data-i18n-attr="aria-label:ab.lang.label">
        <span class="ab-langs-label" data-i18n="ab.lang.label">Bedeutungen auf</span>
        {sheetLangs.map((l) => (
          <button type="button" data-ab-lang={l} aria-pressed={l === firstLang ? "true" : "false"} lang={l} data-i18n={l === "de" ? "ab.lang.de" : undefined}>{langName(l)}</button>
        ))}
      </div>
      <div class="ab-actions ab-only-print">
        <label class="ab-check"><input type="checkbox" data-ab-withkey checked /> <span data-i18n="ab.withKey">Lösungsblatt mitdrucken</span></label>
        <button type="button" class="ab-btn ab-btn--primary" data-ab-print data-i18n="ab.print">Drucken / als PDF speichern</button>
      </div>
      <div class="ab-actions ab-only-online">
        <button type="button" class="ab-btn ab-btn--primary" data-ab-check data-i18n="ab.check">Prüfen</button>
        <button type="button" class="ab-btn" data-ab-reset data-i18n="ab.reset">Leeren</button>
        <span class="ab-score" data-ab-score data-tpl="{n} von {total} richtig" data-i18n-attr="data-tpl:ab.score" aria-live="polite"></span>
      </div>
    </div>

    <article class="ab-sheet" lang="en" data-has-de={sheet.hasDe ? "" : undefined}>
      <header class="ab-head">
        <p class="ab-eyebrow">EnglishAcademy · Vocabulary worksheet · {level}</p>
        <h1 class="ab-title">{title}</h1>
        <p class="ab-namerow"><span>Name: <i></i></span><span>Date: <i></i></span></p>
      </header>

      {sheet.match.left.length > 0 && (
        <section class="ab-sec">
          <h2 class="ab-h"><b>A</b> Word and meaning</h2>
          <p class="ab-instr">Which meaning fits? Write the letter in the box.</p>
          <div class="ab-match">
            <ol class="ab-match-left">
              {sheet.match.left.map((item, i) => (
                <li>
                  <input class="ab-in ab-in--letter" data-a={json([sheet.match.answers[i]])} data-kind="letter" maxlength="1" aria-label={`Letter for ${item.de}`} autocomplete="off" />
                  <span>{item.de}</span>
                </li>
              ))}
            </ol>
            <ul class="ab-match-right">
              {sheet.match.right.map((r) => (
                <li>
                  <b>{r.letter})</b>
                  {[...SHEET_LANGS, "de"].map((l) => <span class="ab-m" lang={l} dir={isRtl(l) ? "rtl" : "ltr"}>{r.meanings[l]}</span>)}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      {sheet.nouns.length > 0 && (
        <section class="ab-sec">
          <h2 class="ab-h"><b>B</b> a, an or some?</h2>
          <p class="ab-instr">Write a, an or some.</p>
          <ul class="ab-articles">
            {sheet.nouns.map((n) => (
              <li>
                <input class="ab-in" style="--w:5ch" data-a={json([n.gender])} data-kind="text" aria-label={`a, an or some: ${n.lemma}`} autocomplete="off" autocapitalize="off" />
                <span>{n.lemma}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {sheet.sentences.length > 0 && (
        <section class="ab-sec">
          <h2 class="ab-h"><b>C</b> Gap sentences</h2>
          <p class="ab-instr">Which word is missing? The words in the box help.</p>
          <p class="ab-box">{sheet.box.map((b) => <span>{b}</span>)}</p>
          <ol class="ab-lines">
            {sheet.sentences.map((s) => (
              <li>
                {s.before}<input class="ab-in" style={w([s.answer])} data-a={json([s.answer])} data-kind="text" aria-label={`Gap ${++gap}`} autocomplete="off" autocapitalize="off" />{s.after}
              </li>
            ))}
          </ol>
        </section>
      )}

      <footer class="ab-foot">EnglishAcademy · englishacademy.com{path} · free to copy for your lessons</footer>
    </article>

    <article class="ab-sheet ab-key" lang="en" aria-label="Answers">
      <header class="ab-head">
        <p class="ab-eyebrow">EnglishAcademy · Answers · {level}</p>
        <h2 class="ab-title ab-title--key">{title}</h2>
      </header>
      {sheet.match.left.length > 0 && (
        <section class="ab-sec">
          <h3 class="ab-h"><b>A</b> Word and meaning</h3>
          <ol class="ab-keylist ab-keylist--cols">
            {sheet.match.left.map((item, i) => {
              const r = sheet.match.right.find((x) => x.letter === sheet.match.answers[i]);
              return (
                <li>
                  {item.de} – <b>{sheet.match.answers[i]}</b>{" "}
                  {[...SHEET_LANGS, "de"].map((l) => <span class="ab-m" lang={l} dir={isRtl(l) ? "rtl" : "ltr"}>({r?.meanings[l]})</span>)}
                </li>
              );
            })}
          </ol>
        </section>
      )}
      {sheet.nouns.length > 0 && (
        <section class="ab-sec">
          <h3 class="ab-h"><b>B</b> a, an or some?</h3>
          <ol class="ab-keylist ab-keylist--cols">
            {sheet.nouns.map((n) => <li><b>{n.gender}</b> {n.lemma}{n.plural && <span class="ab-muted">, pl. {n.plural}</span>}</li>)}
          </ol>
        </section>
      )}
      {sheet.sentences.length > 0 && (
        <section class="ab-sec">
          <h3 class="ab-h"><b>C</b> Gap sentences</h3>
          <ol class="ab-keylist">
            {sheet.sentences.map((s) => <li>{s.before}<b>{s.answer}</b>{s.after}</li>)}
          </ol>
        </section>
      )}
      <footer class="ab-foot">EnglishAcademy · englishacademy.com{path}</footer>
    </article>
  </main>

  <script>
    import { mountWorksheet } from "../../../../lib/arbeitsblatt/client.js";
    const root = document.getElementById("ab-root");
    if (root) mountWorksheet(root);
  </script>
</Layout>
