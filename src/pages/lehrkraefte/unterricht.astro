---
// /lehrkraefte/unterricht — a Stunde from the plan, taught step by step on the projector
// with a group: step screens, the session bar and the lesson clock. Progress is saved per
// group in public.unterrichtssitzungen. All logic in src/lib/unterricht/ (seite.js).
//
// Static like the rest of the section; sign-in and the teacher switch are settled in the
// browser, with the same gates as Klassentests. Started from "Unterricht starten" on
// /lehrkraefte/stundenplan. Not in the Android app (build-app.mjs drops /lehrkraefte).
// German only (lang="de"), like the plan.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import { unterrichtDaten } from "../../lib/unterricht/seitenDaten.js";
import "../../styles/live-quiz.css";
import "../../styles/quiz-builder.css";
import "../../styles/klassen.css";
import "../../styles/unterricht.css";

// Plan data, Einstieg photos and material, Wortfelder: shared with the learner's /stunde.
const { levels, bilder, themen, wortfelder } = unterrichtDaten();
---
<Layout
  title="Unterricht – Für Lehrkräfte – EnglishAcademy"
  description="Eine Stunde aus dem Stundenplan Schritt für Schritt am Beamer halten: Phasen, Material, Uhr und Fortschritt je Gruppe."
  noindex
>
  <SiteNav active="lehrkraefte" />
  <main class="lq kl ut" id="ut-root" lang="de">
    <section class="lq-card" data-gate="loading">
      <p>Einen Moment …</p>
    </section>
    <section class="lq-card kl-stack" data-gate="signin" hidden>
      <h2>Melde dich an, um eine Stunde zu starten</h2>
      <p>Der Fortschritt jeder Gruppe gehört zu deinem Konto, damit du nächste Woche weißt, wo ihr steht. Das Konto ist kostenlos.</p>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/lehrkraefte/stundenplan">Anmelden oder registrieren</a>
    </section>
    <section class="lq-card kl-stack" data-gate="teacher" hidden>
      <h2>Unterrichtest du Deutsch?</h2>
      <p>Dann schalte die Werkzeuge für Lehrkräfte frei: Unterricht mit Uhr, Klassentests, Umfragen, Klassen und eigene Live-Quizze. Du kannst das jederzeit in deinem Konto unter Einstellungen wieder ausschalten.</p>
      <button type="button" class="lq-btn lq-btn--primary" data-teacher-on>Ja, ich unterrichte</button>
      <p class="lq-error" data-teacher-error role="alert"></p>
    </section>

    <div data-gate="ok" hidden>
      <section class="ut-start" data-view="start" hidden>
        <a class="qb-back" data-start-plan href="/lehrkraefte/stundenplan">Zurück zum Stundenplan</a>
        <p class="ut-eyebrow" data-start-meta></p>
        <h1 class="ut-title" data-start-title>Unterricht starten</h1>
        <div class="ut-timeline" data-start-bar aria-hidden="true"></div>

        <div class="lq-card kl-stack">
          <h2>Mit welcher Gruppe?</h2>
          <div class="ut-groups" data-groups role="radiogroup" aria-label="Gruppe"></div>
          {/* One button for both ways in: a group chosen above, or a new name typed here –
              the group is created and the lesson starts in the same press (Enter too). */}
          <form class="ut-new" data-new novalidate>
            <label>Neue Gruppe <input type="text" data-new-name maxlength="80" placeholder="z. B. A1 Montag" autocomplete="off" /></label>
            <button type="submit" class="lp-btn lp-btn--primary" data-go>Unterricht starten</button>
          </form>
          <p class="kl-status" data-start-status role="status" aria-live="polite"></p>
          <div class="ut-open" data-open hidden>
            <p data-open-text></p>
            <div class="ut-row ut-row--end">
              <button type="button" class="lp-btn lp-btn--outline" data-restart>Neu starten</button>
              <button type="button" class="lp-btn lp-btn--primary" data-resume>Fortsetzen</button>
            </div>
          </div>
          <p class="ut-muted">Die Uhr läuft ab „Unterricht starten“. Schließt du den Tab oder geht der Rechner in den Ruhezustand, hält sie an; du machst mit „Weiter“ dort weiter.</p>
        </div>
      </section>

      <section class="ut-stage" data-view="stage" data-stage hidden>
        <div class="ut-stage-top">
          <p class="ut-eyebrow" data-stage-meta></p>
          <button type="button" class="ut-icon-btn" data-fullscreen title="Vollbild" aria-label="Vollbild ein oder aus">⛶</button>
        </div>
        <div class="ut-timeline ut-timeline--nav" data-stage-bar></div>
        <article class="ut-card" data-stage-card aria-live="polite"></article>
        <p class="ut-keys">Tastatur und Presenter: → nächster Schritt, ← zurück, P Pause.</p>

        <div class="ut-qr" data-qr hidden role="dialog" aria-modal="true" aria-label="Link und QR-Code für Lernende">
          <button type="button" class="ut-qr-close" data-qr-close aria-label="Schließen">✕</button>
          <div class="ut-qr-list" data-qr-list></div>
        </div>
      </section>

      <section class="lq-card kl-stack ut-done" data-view="done" hidden>
        <SectionMascot name="bruno" expr="celebrate" extra="klemmbrett" say="Gut gemacht!" />
        <h1 class="ut-title">Stunde beendet</h1>
        <p>Gebraucht: <b data-done-time></b></p>
        <table class="ut-done-table">
          <thead><tr><th scope="col">Phase</th><th scope="col">Geplant</th><th scope="col">Gebraucht</th></tr></thead>
          <tbody data-done-rows></tbody>
        </table>
        <div class="ut-row"><a class="lp-btn lp-btn--primary" data-done-plan href="/lehrkraefte/stundenplan">Zum Stundenplan</a></div>
      </section>

      <section class="lq-card kl-stack" data-view="missing" hidden>
        <h2>Diese Stunde gibt es nicht (mehr)</h2>
        <p>Der Link passt zu keiner Stunde in deinem Konto. Starte die Stunde im Stundenplan neu.</p>
        <a class="lp-btn lp-btn--primary" href="/lehrkraefte/stundenplan">Zum Stundenplan</a>
      </section>
    </div>
  </main>
  <script type="application/json" id="ut-data" set:html={JSON.stringify({ levels, bilder, themen, wortfelder })}></script>

  <script>
    import { mountUnterricht } from "../../lib/unterricht/seite.js";
    const root = document.getElementById("ut-root");
    const data = JSON.parse(document.getElementById("ut-data")!.textContent!);
    if (root) mountUnterricht(root, data);
  </script>
</Layout>
