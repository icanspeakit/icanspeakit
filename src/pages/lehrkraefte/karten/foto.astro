---
// Vokabeln vom Foto: a teacher photographs the vocab list of their course book, checks the
// words in a table and saves them as a card set (VOKABEL-FOTO-TIERED-PROMPT.md, Tier 2).
//   /lehrkraefte/karten/foto           new set
//   /lehrkraefte/karten/foto?set=<id>  edit a saved set, or add a photo's words to it
//
// Static and noindex like the quiz builder; who is signed in, and whether they teach, is
// settled in the browser (src/lib/vokabelFoto/page.js). The photo goes to
// /api/wortschatz/foto and is not stored; only the checked list is saved (table vokabel_sets).
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import "../../../styles/live-quiz.css";
import "../../../styles/quiz-builder.css";
import "../../../styles/vokabel-foto.css";

const LEVELS = ["A1", "A2", "B1", "B2", "C1"];
---
<Layout
  title="Vokabeln vom Foto – EnglishAcademy"
  description="Fotografieren Sie die Wortliste Ihres Lehrbuchs und bekommen Sie die Wörter als Karten zurück."
  noindex
>
  <SiteNav active="lehrkraefte" />

  <main class="lq qb vf" id="vf-root">
    <a class="qb-back" href="/lehrkraefte/karten">Meine Kartensets</a>
    <header class="lq-head">
      <p class="lq-eyebrow">Für Lehrkräfte · Vokabeln vom Foto</p>
      <h1 class="lq-title" data-page-title>Wortliste fotografieren oder hochladen</h1>
      <p class="lq-lead">Fotografieren Sie die Wortliste aus Ihrem Lehrbuch oder laden Sie sie als PDF oder Word-Datei hoch. Sie bekommen die Wörter als Karten zurück, mit Artikel, Plural und, wo wir sie haben, mit Aussprache und Bild. Vor dem Speichern prüfen Sie die Liste.</p>
    </header>

    <section class="lq-card qb-gate" data-gate="loading">
      <p>Einen Moment …</p>
    </section>
    <section class="lq-card qb-gate" data-gate="signin" hidden>
      <h2>Bitte melden Sie sich an</h2>
      <p>Ihre Kartensets liegen in Ihrem Konto, damit Sie sie auf jedem Gerät wiederfinden. Das Konto ist kostenlos.</p>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/lehrkraefte/karten/foto">Anmelden oder registrieren</a>
    </section>
    <section class="lq-card qb-gate" data-gate="teacher" hidden>
      <h2>Unterrichten Sie Deutsch?</h2>
      <p>Dann schalten Sie die Werkzeuge für Lehrkräfte frei. Sie können das jederzeit in Ihrem Konto unter Einstellungen wieder ausschalten.</p>
      <button type="button" class="lq-btn lq-btn--primary" data-teacher-on>Ja, ich unterrichte</button>
      <p class="lq-error" data-teacher-error role="alert"></p>
    </section>

    <div class="vf-body" data-gate="ok" hidden>
      {/* 1 · Photo */}
      <section class="lq-card vf-step" aria-labelledby="vf-photo-title">
        <h2 id="vf-photo-title" class="qb-h2" data-photo-title>1 · Foto</h2>
        <label class="vf-drop" data-drop>
          {/* No `capture`: on a phone it would open the camera straight away and hide PDFs and documents. */}
          <input type="file" accept="image/jpeg,image/png,image/webp,image/heic,application/pdf,.pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx,text/plain,.txt" multiple data-file />
          <span class="vf-drop-icon" aria-hidden="true">📷</span>
          <b>Foto, PDF oder Word-Datei wählen</b>
          <small>Foto: gerade von oben, die ganze Wortliste im Bild, bis zu 4 auf einmal. PDF und Word (.docx) gehen auch, auch mehrere Seiten.</small>
        </label>
        <p class="vf-paste-row">
          <button type="button" class="lq-btn lq-btn--ghost" data-paste hidden>📋 Bild aus der Zwischenablage einfügen</button>
          <small>Kopiertes Foto oder Screenshot: einfach mit Strg+V (Mac: Cmd+V) einfügen.</small>
        </p>
        <ul class="vf-thumbs" data-thumbs hidden></ul>
        <div class="qb-row" data-read-row hidden>
          <button type="button" class="lq-btn lq-btn--quiet" data-clear>Fotos entfernen</button>
          <button type="button" class="lq-btn lq-btn--primary" data-read>Wörter lesen</button>
        </div>
        <p class="vf-progress" data-progress role="status" aria-live="polite" hidden>
          <span class="vf-spinner" aria-hidden="true"></span> <span data-progress-text>Das Foto wird gelesen …</span>
        </p>
        <p class="lq-error" data-read-error role="alert"></p>
        <p class="vf-note">Fotos und gescannte Seiten werden nur zum Lesen an Microsoft Azure geschickt, Text aus PDF und Word liest Ihr Browser selbst. Nichts davon wird gespeichert, nur Ihre Wortliste.</p>
      </section>

      {/* 2 · Check */}
      <section class="lq-card vf-step" data-review hidden aria-labelledby="vf-review-title">
        <div class="qb-bank-head">
          <h2 id="vf-review-title" class="qb-h2">2 · Prüfen <span class="qb-count" data-count></span></h2>
          <div class="qb-bank-tools">
            <button type="button" class="qb-link" data-merge hidden>Doppelte zusammenführen</button>
          </div>
        </div>
        <p class="vf-legend">
          <span class="vf-badge vf-badge--lex">aus unserem Wortschatz</span> Karte, Aussprache und Übersetzungen kommen von uns.
          <span class="vf-badge vf-badge--ok">eigenes Wort</span> Kurz drüberschauen, Falsches direkt im Feld ändern.
        </p>
        <div class="vf-tr">
          <p class="vf-tr-head"><b>Sprachen Ihrer Klasse</b> <small>Mehrere antippen. Jede Sprache wird sofort übersetzt, „Auf Deutsch“ ist immer dabei.</small></p>
          <div class="vf-langs" data-tr-langs role="group" aria-label="Sprachen der Klasse"></div>
          <button type="button" class="lq-btn lq-btn--ghost" data-tr-fill>Fehlende Übersetzungen ergänzen</button>
          <small class="vf-tr-status" data-tr-status role="status" aria-live="polite"></small>
        </div>
        <ol class="vf-list" data-list></ol>
        <button type="button" class="lq-btn lq-btn--ghost vf-add" data-add>+ Wort hinzufügen</button>
      </section>

      {/* 3 · Save */}
      <section class="lq-card vf-step" data-save-card hidden aria-labelledby="vf-save-title">
        <h2 id="vf-save-title" class="qb-h2">3 · Speichern</h2>
        <div class="vf-save-fields">
          <label class="lq-field">
            <span>Name des Sets</span>
            <input type="text" maxlength="80" data-name placeholder="z. B. Kurs Mo/Mi · Woche 3" />
          </label>
          <label class="lq-field">
            <span>Niveau (optional)</span>
            <select data-level>
              <option value="">–</option>
              {LEVELS.map((l) => <option value={l}>{l}</option>)}
            </select>
          </label>
        </div>
        <div class="qb-save">
          <p class="qb-status" data-status role="status" aria-live="polite"></p>
          <button type="button" class="lq-btn lq-btn--primary" data-save>Set speichern</button>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { mountFotoPage } from "../../../lib/vokabelFoto/page.js";
    const root = document.getElementById("vf-root");
    if (root) mountFotoPage(root);
  </script>
</Layout>
