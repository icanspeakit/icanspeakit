---
// /wissen/land-und-kultur — the Landeskunde lobby: every area of the section as a card
// (Kulturwissen, Deutschland von innen, Fehler nach Muttersprache, Fakten, Quiz, Auto),
// then every single topic, so nothing has to be found through a sub-hub first.
// The Wissen menu's Landeskunde box points here ("Land und Kultur").
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import kultur from "../../data/kultur.json";
import insider from "../../data/kultur-insider.json";
import fehler from "../../data/fehler-nach-sprache.json";
import bilder from "../../data/kultur-bilder.json";
import { iconFile } from "../../lib/wortBild.js";
import "../../styles/practice.css";
import "../../styles/kultur.css";
import "../../styles/kultur-hub.css";
import "../../styles/land-und-kultur.css";

const bild = (emoji: string | undefined) => (emoji ? `/img/openmoji/${iconFile(emoji)}.svg` : null);
const LEVELS = ["A1", "A2", "B1", "B2", "C1", "C2"];
const byLevel = <T extends { level: string }>(list: T[]) =>
  [...list].sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level));
const quizCount = kultur.topics.reduce((n, t) => n + t.quiz.length, 0);

const areas = [
  { href: "/kultur", pic: "🏛️", title: "Kulturwissen", text: "Wie Deutschland im Alltag funktioniert: Mülltrennung, Pfand, Ämter, Feiertage, Schule.", meta: `${kultur.topics.length} Themen` },
  { href: "/kultur/insider", pic: bilder.extras.insider, title: "Deutschland von innen", text: "Wie Menschen in Deutschland leben, lieben und wählen, mit Zahlen und Quellen.", meta: `${insider.topics.length} Themen` },
  { href: "/kultur/fehler", pic: bilder.extras.fehler, title: "Typische Fehler nach Muttersprache", text: "Welche Fehler kommen aus welcher Sprache, und wie wirst du sie los?", meta: `${fehler.languages.length} Sprachen` },
  { href: "/leben-in-deutschland/fakten", pic: "🇩🇪", title: "Fakten über Deutschland", text: "Demokratie, Geschichte, Bundesländer: das Wissen für den Einbürgerungstest.", meta: "Einbürgerungstest (LiD)" },
  { href: "/kultur/quiz", pic: bilder.extras.quiz, title: "Landeskunde-Quiz", text: "Fragen aus allen Kulturwissen-Themen, gemischt oder pro Thema.", meta: `${quizCount} Fragen` },
  { href: "/kultur/insider/deutschland-und-das-auto", pic: "🚗", title: "Deutschland und das Auto", text: "Autoland, Tempolimit, Führerschein: was du über das Fahren in Deutschland wissen solltest.", meta: "Auto & Führerschein" },
];

const lists = [
  { id: "kulturwissen", title: "Kulturwissen", href: "/kultur",
    items: byLevel(kultur.topics).map((t) => ({ href: `/kultur/${t.id}`, title: t.title, level: t.level, pic: (bilder.topics as Record<string, string>)[t.id] })) },
  { id: "von-innen", title: "Deutschland von innen", href: "/kultur/insider",
    items: byLevel(insider.topics).map((t) => ({ href: `/kultur/insider/${t.id}`, title: t.title, level: t.level, pic: (bilder.insider as Record<string, string>)[t.id] })) },
  { id: "fehler", title: "Typische Fehler nach Muttersprache", href: "/kultur/fehler",
    items: fehler.languages.map((l) => ({ href: `/kultur/fehler?lang=${l.id}`, title: l.name, level: "", pic: undefined })) },
];
---
<Layout
  title="Country and culture – all topics – EnglishAcademy"
  description="Every culture topic at a glance: UK culture, life in the UK from the inside, typical mistakes by first language, facts for the Life in the UK test and the culture quiz."
>
  <SiteNav active="landeskunde" />
  <main class="practice-main practice-main--wide">
    <div class="practice-hero">
      <p class="eyebrow" data-i18n="kultur.hero.eyebrow">Landeskunde</p>
      <h1>Land und Kultur</h1>
      <SectionMascot name="bruno" say="The UK at a glance." align="center" class="ku-hero-mascot" />
    </div>

    <section class="lk-block">
      <h2 class="lk-h2">Bereiche</h2>
      <div class="ku-grid ku-grid--fill">
        {areas.map((a) => (
          <a class="ku-card" href={a.href}>
            <span class="ku-card-ic ku-card-pic"><img src={bild(a.pic)} alt="" width="40" height="40" loading="lazy" /></span>
            <span class="ku-card-txt">
              <b>{a.title}</b>
              <i>{a.text}</i>
            </span>
            <span class="ku-card-meta"><span class="ku-card-q">{a.meta}</span></span>
          </a>
        ))}
      </div>
    </section>

    <nav class="lk-jump" aria-label="Springen zu">
      {lists.map((l) => <a href={`#${l.id}`}>{l.title} <span>{l.items.length}</span></a>)}
    </nav>

    {lists.map((l) => (
      <section class="lk-block" id={l.id}>
        <h2 class="lk-h2">
          <a href={l.href}>{l.title}</a>
          <span class="lk-count">{l.items.length}</span>
        </h2>
        <ul class="lk-list">
          {l.items.map((it) => (
            <li>
              <a href={it.href}>
                {it.pic ? <img src={bild(it.pic)} alt="" width="24" height="24" loading="lazy" /> : <span class="lk-dot" aria-hidden="true" />}
                <span class="lk-title">{it.title}</span>
                {it.level && <span class="ku-badge">{it.level}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Layout>
