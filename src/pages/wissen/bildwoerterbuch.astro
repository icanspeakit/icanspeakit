---
// /wissen/bildwoerterbuch — Bildkarten: the 100 most important German words as picture
// cards, like a children's memory game with nothing on the back. One picture, one word.
// Two views: „Alle“ (every card in a grid, filtered by word class) and „Einzeln“ (one big
// card after another: arrows, swipe, keys). A tap plays the word. „Drucken“ lays the chosen
// cards out on A4 sheets with dashed cut lines — 6, 12 or 20 to a page, in colour or as
// outlines to colour in (saves ink) — built only when printing (the script, @media print).
//
// The words: src/data/bildkarten.json (30 nouns, 20 verbs, 20 adjectives, 30 little words,
// by frequency). The drawings are our own (src/lib/bildwoerter.js + src/lib/bildkarten/),
// the Mini-Crew acting out verbs and adjectives, which is why the top ten can be prints on
// /merch. Article and audio come from the lexicon.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { mascotSvg } from "../../lib/mascots.js";
import { bildSvg, hasBild } from "../../lib/bildwoerter.js";
import { byId } from "../../lib/lexicon.js";
import data from "../../data/bildkarten.json";
import "../../styles/practice.css";

type Card = { id: string; group: string; lemma: string; art: string | null; audio: string | null };
const cards: Card[] = data.groups.flatMap((g) =>
  g.words
    .filter(hasBild)
    .map((id) => byId(id))
    .filter((e): e is NonNullable<typeof e> => Boolean(e))
    .map((e) => ({
      id: e.id as string,
      group: g.id,
      lemma: e.lemma as string,
      art: (e.gender as string | null) ?? null,
      audio: e.audio ? `/audio/wortschatz/${e.audio}.mp3` : null,
    })),
);
const groups = data.groups.map((g) => ({ id: g.id, title: g.title, n: cards.filter((c) => c.group === g.id).length }));
// The lead names the four word classes with their counts, as one translatable sentence.
const groupN = Object.fromEntries(groups.map((g) => [g.id, g.n]));
const PER_PAGE = 12; // the size checked by default
const printVars = { n: cards.length, pages: Math.ceil(cards.length / PER_PAGE) };
---
<Layout
  title="Bildkarten: die 100 wichtigsten deutschen Wörter – EnglishAcademy"
  description="Haus, gehen, groß, auf: die 100 wichtigsten deutschen Wörter als Bildkarten. Ein Bild, ein Wort, zum Anhören. Alle auf einmal oder eine nach der anderen."
>
  <SiteNav active="wissen" />
  <main class="practice-main practice-main--wide bk-page" data-view="alle">
    <header class="practice-hero bk-hero">
      <p class="eyebrow" data-i18n="bildwb.eyebrow">Bildkarten</p>
      <h1 data-i18n="bildwb.title">Die 100 wichtigsten Wörter</h1>
      <p data-i18n="bildwb.lead" data-i18n-vars={JSON.stringify(groupN)}>Ein Bild, ein Wort. Tipp auf eine Karte und hör das Wort. Die Wörter, die man im Deutschen am häufigsten hört: {groupN.nomen} Nomen, {groupN.verben} Verben, {groupN.adjektive} Adjektive und {groupN.kleine} kleine Wörter.</p>
      <div class="bk-crew" aria-hidden="true" data-mascot-part>
        <Fragment set:html={mascotSvg({ name: "hamsti", expr: "happy", view: "three", size: 60, label: "" })} />
        <p class="bk-say">„<span data-i18n="bildwb.say">Erst sagen, dann tippen!</span>“</p>
      </div>
    </header>

    <div class="bk-bar">
      <div class="bk-tools">
      <div class="bk-views" role="group" aria-label="Ansicht" data-i18n-attr="aria-label:ak.view" data-views>
        <button type="button" data-view-btn="alle" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
          <span data-i18n="vt.sel.all">Alle</span>
        </button>
        <button type="button" data-view-btn="einzeln" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="18" rx="2"/></svg>
          <span data-i18n="bildwb.view.single">Einzeln</span>
        </button>
      </div>
      <button type="button" class="bk-mute" data-mute aria-pressed="false" aria-label="Ton aus" title="Ton aus">
        <svg class="bk-mute-on" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/></svg>
        <svg class="bk-mute-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4z"/><path d="M17 9.5l5 5M22 9.5l-5 5"/></svg>
      </button>
      </div>
      <div class="bk-filter" role="group" aria-label="Wortart" data-i18n-attr="aria-label:bildwb.filterLabel" data-filter>
        <button type="button" data-group-btn="" aria-pressed="true"><span data-i18n="vt.sel.all">Alle</span> <small>{cards.length}</small></button>
        {groups.map((g) => <button type="button" data-group-btn={g.id} aria-pressed="false"><span data-i18n={`bildwb.group.${g.id}`}>{g.title}</span> <small>{g.n}</small></button>)}
      </div>
    </div>

    <details class="bk-printbox" data-printbox>
      <summary>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3h10v6M7 17H4v-7a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v7h-3"/><rect x="7" y="14" width="10" height="7"/></svg>
        <span data-i18n="bildwb.print.title">Drucken und ausschneiden</span>
      </summary>
      <div class="bk-printbody">
        <p class="bk-printlead"><span data-i18n="bildwb.print.fit">Die Karten passen lückenlos auf DIN A4, mit gestrichelten Schnittlinien.</span> <span data-print-sel data-i18n-html="bildwb.print.sel" data-i18n-vars={JSON.stringify(printVars)}>Gedruckt wird deine Auswahl: <b>{printVars.n}</b> Karten auf <b>{printVars.pages}</b> Seiten.</span></p>
        <fieldset class="bk-printopt">
          <legend data-i18n="sp.bingo.size">Größe</legend>
          <label><input type="radio" name="bk-size" value="6"> <span data-i18n="bildwb.print.big">Groß</span> <small data-i18n="bildwb.print.perPage" data-i18n-vars='{"n":6}'>6 pro Seite</small></label>
          <label><input type="radio" name="bk-size" value="12" checked> <span data-i18n="bildwb.print.mid">Mittel</span> <small data-i18n="bildwb.print.perPage" data-i18n-vars='{"n":12}'>12 pro Seite</small></label>
          <label><input type="radio" name="bk-size" value="20"> <span data-i18n="bildwb.print.small">Klein</span> <small data-i18n="bildwb.print.perPage" data-i18n-vars='{"n":20}'>20 pro Seite</small></label>
        </fieldset>
        <fieldset class="bk-printopt">
          <legend data-i18n="merch.card.color">Farbe</legend>
          <label><input type="radio" name="bk-ink" value="color" checked> <span data-i18n="bildwb.print.color">Bunt</span></label>
          <label><input type="radio" name="bk-ink" value="outline"> <span data-i18n="bildwb.print.outline">Zum Ausmalen</span> <small data-i18n="bildwb.print.saveInk">spart Farbe</small></label>
        </fieldset>
        <button type="button" class="btn btn-primary" data-print data-i18n="vp.rule.print">Drucken</button>
      </div>
    </details>

    {/* Alle: every card. A tap plays the word and opens it big. */}
    <ul class="bk-grid" data-grid>
      {cards.map((c) => (
        <li data-group={c.group}>
          <button type="button" class={`bk-card bk-card--${c.group}`} data-card={c.id} data-audio={c.audio} data-word={`${c.art ? c.art + " " : ""}${c.lemma}`} aria-label={`${c.art ? c.art + " " : ""}${c.lemma}, groß zeigen und anhören`}>
            <span class="bk-pic"><Fragment set:html={bildSvg(c.id, { size: 120 })} /></span>
            <span class="bk-word" lang="de">{c.art && <span class={`bk-art bk-art--${c.art}`}>{c.art} </span>}{c.lemma}</span>
          </button>
        </li>
      ))}
    </ul>

    {/* Einzeln: one big card. Filled in by the script from the grid's cards. */}
    <section class="bk-single" data-single aria-label="Eine Karte" data-i18n-attr="aria-label:bildwb.single" hidden>
      <div class="bk-stage" data-stage>
        <button type="button" class="bk-nav bk-nav--prev" data-prev aria-label="Vorige Karte" data-i18n-attr="aria-label:bildwb.prev">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <button type="button" class="bk-card bk-card--big" data-big aria-label="Wort anhören">
          <span class="bk-pic" data-big-pic></span>
          <span class="bk-word" lang="de" data-big-word></span>
        </button>
        <button type="button" class="bk-nav bk-nav--next" data-next aria-label="Nächste Karte" data-i18n-attr="aria-label:vt.learn.nextCard">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <p class="bk-count" aria-live="polite"><span data-pos>1</span> / <span data-total>{cards.length}</span></p>
      <p class="bk-hint" data-i18n="bildwb.hint">Wischen oder ← → · Leertaste: anhören</p>
    </section>

    <aside class="bk-merch">
      <p data-i18n="bildwb.merch">Die schönsten zehn gibt es bald auch auf Shirt, Tasse, Postkarte und Geschenkkarte.</p>
      <a class="btn btn-secondary" href="/merch" data-i18n="bildwb.merchCta">Zum Merch</a>
    </aside>
    <p class="bk-foot" data-i18n-html="bildwb.foot">Alle Bilder hat EnglishAcademy selbst gezeichnet. Mehr Wörter üben: <a href="/wortschatz">Wortschatz</a> · <a href="/artikel">Artikel-Trainer</a></p>
  </main>

  <style>
    .bk-page { --der: #2f6fd6; --die: #c2415a; --das: #2e9a62; --paper: #fffdf8; --card-ink: #1a2230; }
    .bk-crew { display: flex; align-items: center; justify-content: center; gap: 10px; margin: 16px 0 0; }
    .bk-say { margin: 0 !important; font-family: var(--font-voice); font-weight: 600; color: var(--ink) !important; background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 6px 12px; }

    .bk-bar { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; margin: 28px 0 18px; }
    .bk-views, .bk-filter { display: flex; gap: 4px; padding: 4px; background: var(--surface-muted, var(--surface-2, rgba(0,0,0,.05))); border-radius: 999px; position: relative; }
    .bk-filter { overflow-x: auto; scrollbar-width: none; max-width: 100%; }
    .bk-views button, .bk-filter button {
      position: relative; z-index: 1; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;
      border: 0; background: transparent; color: var(--muted); font: inherit; font-weight: 600; font-size: var(--text-sm);
      padding: 8px 14px; border-radius: 999px; cursor: pointer;
    }
    .bk-views button[aria-pressed="true"], .bk-filter button[aria-pressed="true"] { background: var(--surface-card); color: var(--ink); box-shadow: var(--shadow-sm); }
    .bk-views svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
    .bk-filter small { font-weight: 500; opacity: .65; }
    .bk-tools { display: flex; align-items: center; gap: 8px; }
    .bk-mute { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface-card); color: var(--ink); cursor: pointer; display: grid; place-items: center; }
    .bk-mute svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .bk-mute .bk-mute-off, .bk-mute[aria-pressed="true"] .bk-mute-on { display: none; }
    .bk-mute[aria-pressed="true"] .bk-mute-off { display: block; }
    .bk-mute[aria-pressed="true"] { color: var(--muted); background: var(--surface-muted, var(--surface-2, rgba(0,0,0,.05))); }

    /* The memory card: thick paper, a rounded ink border, an inner frame in the word class's
       colour. Paper stays light in dark mode, like a real card on a dark table — the
       drawings' dark outline needs it. */
    .bk-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 14px; }
    .bk-grid li[hidden] { display: none; }
    .bk-card {
      --frame: #5eead4;
      width: 100%; aspect-ratio: 4 / 5; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      padding: 10px; cursor: pointer; font: inherit; color: var(--card-ink);
      background: var(--paper); border: 3px solid var(--card-ink); border-radius: 18px;
      box-shadow: inset 0 0 0 5px var(--paper), inset 0 0 0 8px var(--frame), 0 3px 0 var(--card-ink);
      transition: transform var(--duration-fast) var(--ease-standard), box-shadow var(--duration-fast) var(--ease-standard);
    }
    .bk-card--nomen { --frame: #5eead4; } .bk-card--verben { --frame: #fdba74; }
    .bk-card--adjektive { --frame: #c4b5fd; } .bk-card--kleine { --frame: #93c5fd; }
    .bk-card:hover { transform: translateY(-3px) rotate(-1deg); }
    .bk-card:active { transform: translateY(1px); box-shadow: inset 0 0 0 5px var(--paper), inset 0 0 0 8px var(--frame), 0 1px 0 var(--card-ink); }
    .bk-card:focus-visible { outline: 3px solid var(--brand-blue); outline-offset: 3px; }
    .bk-pic { width: 62%; aspect-ratio: 1; }
    .bk-pic :global(svg) { width: 100%; height: 100%; }
    .bk-word { font-family: var(--font-voice); font-weight: 700; font-size: 1.35rem; line-height: 1.1; text-align: center; }
    .bk-art { font-size: .72em; }
    .bk-art--der { color: var(--der); } .bk-art--die { color: var(--die); } .bk-art--das { color: var(--das); }
    .bk-card.is-playing .bk-pic { animation: bk-hop .5s var(--ease-standard); }
    @keyframes bk-hop { 40% { transform: translateY(-7px) scale(1.05); } }

    /* Einzeln */
    .bk-page[data-view="einzeln"] .bk-grid { display: none; }
    .bk-single { display: flex; flex-direction: column; align-items: center; }
    .bk-single[hidden] { display: none; }
    .bk-stage { display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%; touch-action: pan-y; }
    .bk-card--big { width: min(78vw, 380px); flex: none; border-width: 4px; border-radius: 26px; gap: 14px; }
    .bk-card--big .bk-pic { width: 70%; }
    .bk-card--big .bk-word { font-size: clamp(2rem, 9vw, 2.8rem); }
    .bk-card--big:hover { transform: none; }
    .bk-card--big.is-in-next { animation: bk-in-next .28s var(--ease-standard); }
    .bk-card--big.is-in-prev { animation: bk-in-prev .28s var(--ease-standard); }
    @keyframes bk-in-next { from { opacity: 0; transform: translateX(40px) rotate(3deg); } }
    @keyframes bk-in-prev { from { opacity: 0; transform: translateX(-40px) rotate(-3deg); } }
    .bk-nav { flex: none; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface-card); color: var(--ink); cursor: pointer; display: grid; place-items: center; box-shadow: var(--shadow-sm); }
    .bk-nav svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    .bk-nav:disabled { opacity: .35; cursor: default; }
    .bk-count { margin: 16px 0 0; font-weight: 700; font-variant-numeric: tabular-nums; }
    .bk-hint { margin: 2px 0 0; color: var(--muted); font-size: var(--text-sm); }

    .bk-printbox { margin: 0 0 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-card); }
    .bk-printbox summary { display: flex; align-items: center; gap: 8px; padding: 12px 16px; cursor: pointer; font-weight: 600; list-style: none; }
    .bk-printbox summary::-webkit-details-marker { display: none; }
    .bk-printbox summary::after { content: ""; margin-left: auto; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor; transform: rotate(45deg); transition: transform var(--duration-fast) var(--ease-standard); }
    .bk-printbox[open] summary::after { transform: rotate(-135deg); }
    .bk-printbox summary svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
    .bk-printbody { padding: 0 16px 16px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: flex-end; }
    .bk-printlead { flex-basis: 100%; margin: 0; color: var(--muted); }
    .bk-printopt { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .bk-printopt legend { font-size: var(--text-sm); font-weight: 600; margin-bottom: 6px; padding: 0; }
    .bk-printopt label { display: inline-flex; align-items: center; gap: 6px; padding: 7px 12px; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; font-size: var(--text-sm); }
    .bk-printopt label:has(input:checked) { border-color: var(--brand-blue); background: color-mix(in srgb, var(--brand-blue) 10%, transparent); }
    .bk-printopt input { accent-color: var(--brand-blue); margin: 0; }
    .bk-printopt small { color: var(--muted); }

    .bk-merch { margin: 40px auto 0; max-width: 560px; text-align: center; padding: 18px; border: 1px dashed var(--border-strong, var(--border)); border-radius: var(--radius-lg); }
    .bk-merch p { margin: 0 0 10px; }
    .bk-foot { margin-top: 28px; text-align: center; color: var(--muted); font-size: var(--text-sm); }

    @media (max-width: 480px) {
      .bk-bar { flex-direction: column; align-items: stretch; }
      .bk-views { align-self: center; }
      .bk-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .bk-word { font-size: 1.15rem; }
      /* On a phone the arrows sit under the card; swiping is the main way. */
      .bk-stage { flex-wrap: wrap; }
      .bk-card--big { order: -1; width: min(86vw, 380px); }
      .bk-nav { margin-top: 14px; }
      .bk-nav--prev { margin-right: 40px; }
    }
    /* The print sheets live on <body> (the script adds them right before printing), so they
       are :global. A4 minus 8 mm margins = 194 × 281 mm, split into equal cells; each cell
       draws its right and bottom cut line, the sheet the left and top one. */
    :global(.bk-sheets) { display: none; }
    @media print {
      @page { size: A4 portrait; margin: 8mm; }
      :global(body.bk-printing > *:not(.bk-sheets)) { display: none !important; }
      :global(body.bk-printing) { background: #fff !important; }
      :global(.bk-sheets) { display: block; color: #1a2230; font-family: var(--font-voice, "Fredoka", sans-serif); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      :global(.bk-sheet) {
        width: 194mm; height: 281mm; box-sizing: border-box; display: grid; break-after: page; overflow: hidden;
        grid-template-columns: repeat(var(--cols), 1fr); grid-template-rows: repeat(var(--rows), 1fr);
        border-left: .3mm dashed #9aa3ad; border-top: .3mm dashed #9aa3ad;
      }
      :global(.bk-sheet:last-child) { break-after: auto; }
      :global(.bk-cell) {
        border-right: .3mm dashed #9aa3ad; border-bottom: .3mm dashed #9aa3ad;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2mm; padding: 3mm; min-width: 0; min-height: 0;
      }
      :global(.bk-cell svg) { width: auto !important; height: var(--pic) !important; max-width: 100%; }
      :global(.bk-cell-word) { font-weight: 700; font-size: var(--word); line-height: 1.1; text-align: center; }
      :global(.bk-cell .bk-art) { font-size: .72em; }
      :global(.bk-cell .bk-art--der) { color: #2f6fd6; } :global(.bk-cell .bk-art--die) { color: #c2415a; } :global(.bk-cell .bk-art--das) { color: #2e9a62; }
      /* Zum Ausmalen: every fill white, the outline stays — except small solid ink (eyes). */
      :global(.bk-sheets.is-outline svg [fill]:not([fill="none"]):not([fill="#1a2230"])) { fill: #fff !important; }
      :global(.bk-sheets.is-outline svg [stroke="#fff"]) { stroke: none !important; }
      :global(.bk-sheets.is-outline .bk-art) { color: #1a2230 !important; }
    }

    @media (prefers-reduced-motion: reduce) {
      .bk-card, .bk-card.is-playing .bk-pic, .bk-card--big.is-in-next, .bk-card--big.is-in-prev { transition: none; animation: none; }
    }
  </style>

  <script>
    import { track } from "../../lib/track.js";
    import { enhanceSwitch } from "../../lib/segSwitch.js";
    import { t, onUiText } from "../../lib/uiText.js";

    const page = document.querySelector<HTMLElement>(".bk-page")!;
    const grid = page.querySelector<HTMLElement>("[data-grid]")!;
    const single = page.querySelector<HTMLElement>("[data-single]")!;
    const big = single.querySelector<HTMLButtonElement>("[data-big]")!;
    const prevBtn = single.querySelector<HTMLButtonElement>("[data-prev]")!;
    const nextBtn = single.querySelector<HTMLButtonElement>("[data-next]")!;
    const all = Array.from(grid.querySelectorAll<HTMLButtonElement>("[data-card]"));

    const KEY = "da-bildkarten-view";
    let group = "";
    let pos = 0;
    const visible = () => all.filter((c) => !group || c.closest<HTMLElement>("li")!.dataset.group === group);

    // Ton aus: the cards still hop, but stay silent. Remembered per device.
    const MUTE_KEY = "da-bildkarten-muted";
    const muteBtn = page.querySelector<HTMLButtonElement>("[data-mute]")!;
    let muted = false;
    try { muted = localStorage.getItem(MUTE_KEY) === "1"; } catch { /* ignore */ }
    const paintMute = () => {
      muteBtn.setAttribute("aria-pressed", String(muted));
      const label = muted ? t("ap.sound.on", "Ton an") : t("ap.sound.off", "Ton aus");
      muteBtn.setAttribute("aria-label", label);
      muteBtn.title = label;
    };
    muteBtn.addEventListener("click", () => {
      muted = !muted;
      if (muted) player.pause();
      try { localStorage.setItem(MUTE_KEY, muted ? "1" : "0"); } catch { /* ignore */ }
      paintMute();
      track("bildkarten_mute", { muted });
    });

    const player = new Audio();
    function play(card: HTMLElement) {
      const src = card.dataset.audio;
      card.classList.remove("is-playing");
      void card.offsetWidth;
      card.classList.add("is-playing");
      if (src && !muted) { player.src = src; player.play().catch(() => {}); }
    }

    // Einzeln: copy the chosen grid card into the big one.
    function show(i: number, dir: "next" | "prev" | null = null, sound = true) {
      const list = visible();
      if (!list.length) return;
      pos = Math.max(0, Math.min(list.length - 1, i));
      const c = list[pos];
      big.className = `bk-card bk-card--big bk-card--${c.closest<HTMLElement>("li")!.dataset.group}`;
      big.querySelector("[data-big-pic]")!.innerHTML = c.querySelector(".bk-pic")!.innerHTML;
      big.querySelector("[data-big-word]")!.innerHTML = c.querySelector(".bk-word")!.innerHTML;
      big.dataset.audio = c.dataset.audio ?? "";
      big.dataset.id = c.dataset.card;
      big.dataset.word = c.dataset.word;
      big.setAttribute("aria-label", t("bildwb.card.play", "{word}, anhören", { word: c.dataset.word ?? "" }));
      if (dir && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        void big.offsetWidth;
        big.classList.add(`is-in-${dir}`);
      }
      single.querySelector("[data-pos]")!.textContent = String(pos + 1);
      single.querySelector("[data-total]")!.textContent = String(list.length);
      prevBtn.disabled = pos === 0;
      nextBtn.disabled = pos === list.length - 1;
      history.replaceState(null, "", `#${c.dataset.card}`);
      if (sound) play(big);
    }

    function setView(view: "alle" | "einzeln", { from = null as HTMLElement | null, sound = true } = {}) {
      page.dataset.view = view;
      single.hidden = view !== "einzeln";
      for (const b of page.querySelectorAll<HTMLButtonElement>("[data-view-btn]")) b.setAttribute("aria-pressed", String(b.dataset.viewBtn === view));
      try { localStorage.setItem(KEY, view); } catch { /* ignore */ }
      if (view === "einzeln") {
        const list = visible();
        show(from ? Math.max(0, list.indexOf(from as HTMLButtonElement)) : pos, null, sound);
      } else {
        history.replaceState(null, "", location.pathname + location.search);
        const cur = visible()[pos];
        if (cur) requestAnimationFrame(() => cur.scrollIntoView({ block: "center" }));
      }
    }

    function setGroup(g: string) {
      const cur = page.dataset.view === "einzeln" ? visible()[pos] : null;
      group = g;
      for (const b of page.querySelectorAll<HTMLButtonElement>("[data-group-btn]")) b.setAttribute("aria-pressed", String(b.dataset.groupBtn === g));
      for (const c of all) c.closest("li")!.hidden = Boolean(g) && c.closest<HTMLElement>("li")!.dataset.group !== g;
      const list = visible();
      pos = cur && list.includes(cur) ? list.indexOf(cur) : 0;
      if (page.dataset.view === "einzeln") show(pos, null, false);
      track("bildkarten_filter", { group: g || "alle" });
    }

    for (const c of all) {
      c.addEventListener("click", () => {
        setView("einzeln", { from: c });
        single.scrollIntoView({ block: "center", behavior: "smooth" });
        track("bildkarten_open", { id: c.dataset.card });
      });
    }
    big.addEventListener("click", () => { play(big); track("bildkarten_play", { id: big.dataset.id }); });
    prevBtn.addEventListener("click", () => show(pos - 1, "prev"));
    nextBtn.addEventListener("click", () => show(pos + 1, "next"));
    page.querySelector("[data-views]")!.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-view-btn]");
      if (b) { setView(b.dataset.viewBtn as "alle" | "einzeln"); track("bildkarten_view", { view: b.dataset.viewBtn }); }
    });
    page.querySelector("[data-filter]")!.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-group-btn]");
      if (b) setGroup(b.dataset.groupBtn!);
    });

    document.addEventListener("keydown", (e) => {
      if (page.dataset.view !== "einzeln" || e.altKey || e.ctrlKey || e.metaKey) return;
      if ((e.target as HTMLElement).closest("input, textarea, select, [contenteditable]")) return;
      if (e.key === "ArrowRight") { e.preventDefault(); show(pos + 1, "next"); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); show(pos - 1, "prev"); }
      else if (e.key === " " && !(e.target as HTMLElement).closest("button")) { e.preventDefault(); play(big); }
    });

    // Swipe on the stage.
    let x0 = 0, y0 = 0, tracking = false;
    const stage = single.querySelector<HTMLElement>("[data-stage]")!;
    stage.addEventListener("pointerdown", (e) => { if (e.pointerType !== "mouse") { x0 = e.clientX; y0 = e.clientY; tracking = true; } });
    stage.addEventListener("pointerup", (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - x0, dy = e.clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        dx < 0 ? show(pos + 1, "next") : show(pos - 1, "prev");
        // The tap that ends a swipe must not also play the card.
        big.addEventListener("click", (ev) => ev.stopImmediatePropagation(), { capture: true, once: true });
      }
    });
    stage.addEventListener("pointercancel", () => { tracking = false; });

    // Drucken: the selected cards on A4 sheets. Built on demand and removed after printing,
    // so the page itself carries no hundred extra drawings.
    const LAYOUT: Record<string, { cols: number; rows: number; pic: string; word: string }> = {
      "6": { cols: 2, rows: 3, pic: "64mm", word: "26pt" },
      "12": { cols: 3, rows: 4, pic: "40mm", word: "18pt" },
      "20": { cols: 4, rows: 5, pic: "31mm", word: "14pt" },
    };
    const box = page.querySelector<HTMLElement>("[data-printbox]")!;
    const opt = (name: string) => box.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!.value;
    // The sentence carries its numbers as data-i18n-vars, so a language switch repaints it right.
    function printCount() {
      const n = visible().length;
      const vars = { n, pages: Math.ceil(n / +opt("bk-size")) 
    };
      const el = box.querySelector<HTMLElement>("[data-print-sel]")!;
      el.dataset.i18nVars = JSON.stringify(vars);
      el.innerHTML = t("bildwb.print.sel", "Gedruckt wird deine Auswahl: <b>{n}</b> Karten auf <b>{pages}</b> Seiten.", vars);
    }
    box.addEventListener("change", printCount);
    page.querySelector("[data-filter]")!.addEventListener("click", () => requestAnimationFrame(printCount));
    printCount();

    // Card labels name the word (German) and what a tap does (interface language).
    const paintLabels = () => {
      for (const c of all) c.setAttribute("aria-label", t("bildwb.card.open", "{word}, groß zeigen und anhören", { word: c.dataset.word ?? "" }));
      big.setAttribute("aria-label", big.dataset.word ? t("bildwb.card.play", "{word}, anhören", { word: big.dataset.word }) : t("bildwb.listen", "Wort anhören"));
    };
    paintLabels();
    paintMute();
    onUiText(() => { paintLabels(); paintMute(); });

    function buildSheets() {
      const size = opt("bk-size");
      const L = LAYOUT[size];
      const list = visible();
      const wrap = document.createElement("div");
      wrap.className = "bk-sheets" + (opt("bk-ink") === "outline" ? " is-outline" : "");
      wrap.style.cssText = `--cols:${L.cols};--rows:${L.rows};--pic:${L.pic};--word:${L.word}`;
      for (let i = 0; i < list.length; i += +size) {
        const sheet = document.createElement("div");
        sheet.className = "bk-sheet";
        // A short last page keeps its empty cells, so every card is the same size.
        const cells = list.slice(i, i + +size);
        sheet.innerHTML = Array.from({ length: +size }, (_, k) => {
          const c = cells[k];
          return c ? `<div class="bk-cell">${c.querySelector(".bk-pic")!.innerHTML}<div class="bk-cell-word" lang="de">${c.querySelector(".bk-word")!.innerHTML}</div></div>` : `<div class="bk-cell"></div>`;
        }).join("");
        wrap.append(sheet);
      }
      return wrap;
    }
    let sheets: HTMLElement | null = null;
    const cleanup = () => { sheets?.remove(); sheets = null; document.body.classList.remove("bk-printing"); };
    // Ctrl+P prints the same sheets as the button.
    addEventListener("beforeprint", () => {
      if (sheets) return;
      sheets = buildSheets();
      document.body.append(sheets);
      document.body.classList.add("bk-printing");
    });
    addEventListener("afterprint", cleanup);
    box.querySelector("[data-print]")!.addEventListener("click", () => {
      track("bildkarten_print", { size: opt("bk-size"), ink: opt("bk-ink"), n: visible().length });
      dispatchEvent(new Event("beforeprint"));
      print();
    });

    // Start: a card in the hash opens it big; else the view the learner used last.
    const hashCard = all.find((c) => c.dataset.card === decodeURIComponent(location.hash.slice(1)));
    let stored: string | null = null;
    try { stored = localStorage.getItem(KEY); } catch { /* ignore */ }
    if (hashCard) setView("einzeln", { from: hashCard, sound: false });
    else if (stored === "einzeln") setView("einzeln", { sound: false });

    enhanceSwitch(page.querySelector<HTMLElement>("[data-views]")!, { content: [grid, single] });
    enhanceSwitch(page.querySelector<HTMLElement>("[data-filter]")!, { content: [grid] });
  </script>
</Layout>
