---
import { fitTitle } from "../../../lib/seo/title.js";
// One "Deutschland von innen" topic. Same blocks as /culture/[id] (facts, prosCons, table,
// phrases, quiz), a vocab list for the words the text leans on, plus the one thing this section cannot do without: a source list with a
// Stand for every number on the page.
import Layout from "../../../layouts/Layout.astro";
import { itemPath, itemSlug, itemKey } from "../../../lib/routes.js";
import SiteNav from "../../../components/SiteNav.astro";
import Icon from "../../../components/Icon.astro";
import ShareButton from "../../../components/ShareButton.astro";
import insider from "../../../data/kultur-insider.json";
import bilder from "../../../data/kultur-bilder.json";
import { emojiSrc } from "../../../lib/wortBild.js";
import { isRtl } from "../../../lib/languages.js";
import { mascotSvg } from "../../../lib/mascots.js";
import "../../../styles/practice.css";
import "../../../styles/kultur.css";
import "../../../styles/kultur-insider.css";
import "../../../styles/ui-text.css";

export function getStaticPaths() {
  return insider.topics.map((topic, i) => ({
    params: { id: itemSlug("/culture/insider", topic.id) },
    props: {
      topic,
      prev: insider.topics[i - 1] ?? null,
      next: insider.topics[i + 1] ?? null,
    },
  }));
}

const { topic, prev, next } = Astro.props as any;
// The A1/A2 topics retell a B1/B2 one in easy language (`easyOf`). They share its numbers,
// so they share its sources, and each page points to the other version.
const original = topic.easyOf ? insider.topics.find((t: any) => t.id === topic.easyOf) : null;
const easy = insider.topics.find((t: any) => t.easyOf === topic.id) ?? null;
const sources = topic.sources ?? original?.sources ?? [];
const vars = (v: Record<string, unknown>) => JSON.stringify(v);
const LANGS = ["en", "tr", "uk", "ar"];

// Soul without a comic: the hub's picture for the topic, Quaki asking the question, and the
// numbers in the facts lifted out so a list of statistics reads at a glance. Amounts only
// (49,5 Millionen, 80 %, 130 km/h, 63 Euro) — a bare year like (2023) stays plain.
const pic = emojiSrc((bilder as any).insider?.[topic.id] ?? (original && (bilder as any).insider?.[original.id]));
const quaki = mascotSvg({ name: "quaki", expr: "thinking", view: "three", size: 48, label: "", className: "in-ask-fig" });
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const NUM = /(?:about |around |over |almost |nearly )?\d+(?:[.,]\d+)*(?:\s|\u00a0)?(?:%|euros?|€|cents?|million|billion|km\/h|g\/l|hours|years|weeks|days|minutes)/g;
const numHtml = (s: string) => esc(s).replace(NUM, (m) => `<b class="in-num">${m}</b>`);
---
<Layout
  title={fitTitle(`${topic.title} – Spain from the inside`, topic.title)}
  description={topic.intro.slice(0, 160)}
>
  <SiteNav active="landeskunde" />
  <main class="practice-main">
    <div class="ku-topbar">
      <a href="/culture/insider" class="vp-back-link" data-i18n="kultur.insider.back">Deutschland von innen</a>
      <ShareButton title={`${topic.title} – Spain from the inside`} label />
    </div>

    <article class="ku-topic">
      <header class="ku-topic-head">
        {pic
          ? <span class="ku-card-ic in-pic"><img src={pic} alt="" width="44" height="44" /></span>
          : <span class="ku-card-ic"><Icon name={topic.icon} size={22} /></span>}
        <div>
          <p class="eyebrow">{topic.eyebrow}</p>
          <h1>{topic.title}</h1>
        </div>
        <span class="ku-badge">{topic.level}</span>
      </header>

      {original && (
        <a class="in-version" href={itemPath("/culture/insider", original.id)}>
          <span class="in-version-tag" data-i18n="insider.easyTag">Simple English</span>
          <span><span data-i18n="insider.moreDetail">More detail:</span> <b>{original.title}</b> <span class="ku-badge">{original.level}</span></span>
        </a>
      )}
      {easy && (
        <a class="in-version" href={itemPath("/culture/insider", easy.id)}>
          <span class="in-version-tag" data-i18n="insider.tooHard">Too hard?</span>
          <span><span data-i18n="insider.sameEasy">The same topic in simple English:</span> <b>{easy.title}</b> <span class="ku-badge">{easy.level}</span></span>
        </a>
      )}

      <p class="ku-intro">{topic.intro}</p>
      <div class="in-ask">
        <span class="in-ask-who" data-mascot-part set:html={quaki} />
        <p class="ku-question">{topic.question}</p>
      </div>

      {topic.table && (
        <section class="ku-block">
          <h2>{topic.table.label}</h2>
          <div class="ku-tablewrap">
            <table class="ku-table">
              <thead><tr>{topic.table.columns.map((c: string) => <th>{c}</th>)}</tr></thead>
              <tbody>
                {topic.table.rows.map((row: string[]) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {topic.facts && (
        <section class="ku-block">
          <h2 data-i18n="kultur.insider.h2.facts">Facts and figures</h2>
          <ul class="ku-facts in-facts">{topic.facts.map((f: string) => <li set:html={numHtml(f)} />)}</ul>
        </section>
      )}

      {topic.prosCons && (
        <section class="ku-block">
          <h2 data-i18n="kultur.insider.h2.prosCons">Zwei Sichtweisen</h2>
          <div class="ku-proscons in-proscons">
            <div>
              <h3>{topic.prosCons.prosLabel}</h3>
              <ul>{topic.prosCons.pros.map((i: string) => <li>{i}</li>)}</ul>
            </div>
            <div>
              <h3>{topic.prosCons.consLabel}</h3>
              <ul>{topic.prosCons.cons.map((i: string) => <li>{i}</li>)}</ul>
            </div>
          </div>
        </section>
      )}

      {/* `decoder.quick`: the dictionary at a glance before the long version — per side a
          two-column list, what is said | what is meant, no reality check. */}
      {topic.decoder?.quick && (
        <section class="ku-block">
          <h2>{topic.decoder.quick.label}</h2>
          {topic.decoder.quick.intro && <p class="in-decoder-intro">{topic.decoder.quick.intro}</p>}
          {topic.decoder.groups.map((g: { title?: string; mascot?: { name: string; extra?: string; expr?: string }; items: { theme?: string; say: string; mean: string }[] }, gi: number) => (
            <div class="in-quick" lang="en">
              <p class="in-dict-head in-quick-head">
                {g.mascot && <span class="in-dict-fig" data-mascot-part set:html={mascotSvg({ name: g.mascot.name, extra: g.mascot.extra, expr: g.mascot.expr, view: "three", size: 44, label: "" })} />}
                <span>{g.title}</span>
              </p>
              <p class="in-quick-col">{gi ? "He says" : "She says"}</p>
              <p class="in-quick-col">{gi ? "Er meint" : "Sie meint"}</p>
              {g.items.flatMap((it, i) => [
                topic.decoder.groups[0].items[i].theme && <p class="in-quick-theme">{topic.decoder.groups[0].items[i].theme}</p>,
                <p class="in-quick-say">“{it.say}”</p>,
                <p class="in-quick-mean">{it.mean}</p>,
              ])}
            </div>
          ))}
        </section>
      )}

      {/* A wink in a numbers section: "gesagt → gemeint" cards. Optional `check` grounds a
          cliché in the facts above it, and `note` closes the block with the plain advice. */}
      {topic.decoder && (
        <section class="ku-block">
          <h2>{topic.decoder.label}</h2>
          {topic.decoder.intro && <p class="in-decoder-intro">{topic.decoder.intro}</p>}
          {/* `columns`: two groups side by side as a two-column dictionary (Frau | Mann).
              Entries go in pairs row by row, so a saying and its counterpart line up. */}
          {/* `scene`: two mascots in a short exchange above the dictionary, the joke in one look.
              Decorative; "Maskottchen aus" removes it whole. */}
          {topic.decoder.scene && (
            <div class="in-scene" data-mascot-part aria-hidden="true">
              {topic.decoder.scene.map((m: { name: string; extra?: string; expr?: string; say: string }, i: number) => (
                <div class:list={["in-scene-who", i % 2 && "in-scene-who--r"]}>
                  <span class="in-scene-say" lang="en">{m.say}</span>
                  <span class="in-scene-fig" set:html={mascotSvg({ name: m.name, extra: m.extra, expr: m.expr, view: "three", size: 76, label: "" })} />
                </div>
              ))}
            </div>
          )}
          {/* A long dictionary is cut into themes: an item in the first group with `theme`
              starts a new section, shown as a full-width row and as a chip to jump to. */}
          {topic.decoder.columns && topic.decoder.groups[0].items.some((it: { theme?: string }) => it.theme) && (
            <nav class="in-dict-toc" lang="en">
              {topic.decoder.groups[0].items.filter((it: { theme?: string }) => it.theme).map((it: { theme: string }, n: number) => (
                <a href={`#thema-${n + 1}`}>{it.theme}</a>
              ))}
            </nav>
          )}
          {topic.decoder.columns ? (
            <div class="in-dict" lang="en">
              {topic.decoder.groups.map((g: { title?: string; mascot?: { name: string; extra?: string; expr?: string } }) => (
                <p class="in-dict-head">
                  {g.mascot && <span class="in-dict-fig" data-mascot-part set:html={mascotSvg({ name: g.mascot.name, extra: g.mascot.extra, expr: g.mascot.expr, view: "three", size: 44, label: "" })} />}
                  <span>{g.title}</span>
                </p>
              ))}
              {topic.decoder.groups[0].items.flatMap((first: { theme?: string; themeMascot?: { name: string; sie: string; er: string } }, i: number) => [
                first.theme && (
                  <div class="in-dict-theme" id={`thema-${topic.decoder.groups[0].items.slice(0, i + 1).filter((x: { theme?: string }) => x.theme).length}`}>
                    {first.themeMascot && <span class="in-dict-theme-fig" data-mascot-part aria-hidden="true" set:html={mascotSvg({ name: first.themeMascot.name, extra: "schleife", expr: first.themeMascot.sie, view: "three", size: 52, label: "" })} />}
                    <h3>{first.theme}</h3>
                    {first.themeMascot && <span class="in-dict-theme-fig in-dict-theme-fig--r" data-mascot-part aria-hidden="true" set:html={mascotSvg({ name: first.themeMascot.name, extra: "fliege", expr: first.themeMascot.er, view: "three", size: 52, label: "" })} />}
                  </div>
                ),
                ...topic.decoder.groups.map((g: { items: { say: string; mean: string; check?: string }[] }) => g.items[i]).map((it: { say: string; mean: string; check?: string } | undefined, gi: number) => (
                  <div class:list={["in-dict-cell", gi > 0 && "in-dict-cell--r"]}>
                    {it && (
                      <>
                        <p class="in-decoder-say">“{it.say}”</p>
                        <p class="in-decoder-mean">{it.mean}</p>
                        {it.check && <p class="in-decoder-check"><b>Reality check:</b> {it.check}</p>}
                      </>
                    )}
                  </div>
                )),
              ])}
            </div>
          ) : topic.decoder.groups.map((g: { title?: string; items: { say: string; mean: string; check?: string }[] }) => (
            <>
              {g.title && <h3 class="in-decoder-title">{g.title}</h3>}
              <ul class="in-decoder">
                {g.items.map((it) => (
                  <li>
                    <p class="in-decoder-say" lang="en">“{it.say}”</p>
                    <p class="in-decoder-mean" lang="en">{it.mean}</p>
                    {it.check && <p class="in-decoder-check" lang="en"><b>Reality check:</b> {it.check}</p>}
                  </li>
                ))}
              </ul>
            </>
          ))}
          {topic.decoder.note && <p class="in-decoder-note">{topic.decoder.note}</p>}
        </section>
      )}

      {topic.context && <p class="ku-context in-tip"><img src={emojiSrc("💡")} alt="" width="28" height="28" /><span>{topic.context}</span></p>}

      {topic.phrases && (
        <section class="ku-block">
          <h2 data-i18n="kultur.h2.phrases">So sagt man das</h2>
          <ul class="ku-phrases">{topic.phrases.map((p: string) => <li>{p}</li>)}</ul>
        </section>
      )}

      {/* The words the text leans on. The meaning is scaffolding, so it follows the UI
          language (a plain-German explanation by default, see ui-text.css); the word, its
          forms and the example stay German. */}
      {topic.vocab && (
        <section class="ku-block">
          <h2 data-i18n="kultur.insider.h2.vocab">Wörter zum Thema</h2>
          <ul class="in-vocab">
            {topic.vocab.map((v: { word: string; grammar: string | null; meaning: Record<string, string>; example: string }) => (
              <li>
                <p class="in-vocab-word" lang="es"><b>{v.word}</b>{v.grammar && <span>{v.grammar}</span>}</p>
                <p class="in-vocab-meaning uit">
                  <span class="uit-de" lang="de">{v.meaning.de}</span>
                  {LANGS.filter((l) => v.meaning[l]).map((l) => (
                    <span class="uit-l" lang={l} dir={isRtl(l) ? "rtl" : "ltr"}>{v.meaning[l]}</span>
                  ))}
                </p>
                <p class="in-vocab-ex" lang="es">{v.example}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      {sources.length > 0 && (
      <section class="in-sources">
        <h2 data-i18n="kultur.insider.h2.sources">Sources</h2>
        <ol>
          {sources.map((s: { label: string; href: string; stand: string }) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
              <span class="in-stand" data-i18n="kultur.insider.stand" data-i18n-vars={vars({ stand: s.stand })}>As of: {s.stand}</span>
            </li>
          ))}
        </ol>
      </section>
      )}

      {topic.links && (
        <div class="ku-links">
          {topic.links.map((l: { label: string; href: string }) => (
            <a class="quiz-btn" href={l.href}>{l.label}</a>
          ))}
        </div>
      )}
    </article>

    {/* A topic that is only a dictionary (frau-mann-woerterbuch) has no quiz. */}
    {topic.quiz && (
      <section class="ku-block ku-quizblock">
        <h2 data-i18n="kultur.h2.quiz">Quiz zu diesem Thema</h2>
        <p class="ku-quiz-intro" data-i18n="skills.quizIntro" data-i18n-vars={vars({ n: topic.quiz.length })}>{topic.quiz.length} Fragen. Antworte per Klick — die Erklärung steht danach dabei.</p>
        <div class="quiz-card" id="in-quiz"></div>
      </section>
    )}

    {/* A topic can end in a way onward — „Deutschland und das Auto" sends the learner to the
        Führerschein section. The last block on the page, after the quiz. */}
    {topic.cta && (
      <a class="in-cta" href={topic.cta.href}>
        <span class="in-cta-txt">
          <b>{topic.cta.title}</b>
          <i>{topic.cta.text}</i>
        </span>
        <span class="in-cta-go">{topic.cta.label} →</span>
      </a>
    )}

    <nav class="ku-prevnext">
      {prev ? <a href={itemPath("/culture/insider", prev.id)}>← {prev.title}</a> : <span />}
      {next ? <a href={itemPath("/culture/insider", next.id)}>{next.title} →</a> : <span />}
    </nav>
  </main>

  <script type="application/json" id="in-quiz-data" set:html={JSON.stringify(topic.quiz ?? [])}></script>
  <script type="module">
    import { mountQuiz } from "../../../lib/quiz.js";
    import { recordAttempt } from "../../../lib/progress.js";
    import { currentPath } from "../../../lib/paths.js";

    const questions = JSON.parse(document.getElementById("in-quiz-data").textContent);
    const topicId = itemKey("/culture/insider", currentPath().split("/").filter(Boolean)[2]);
    if (questions.length) mountQuiz(document.getElementById("in-quiz"), questions, {
      mode: "choice",
      meldung: (q, i) => `k:insider/${topicId}/q${i + 1}`,
      showWrongCount: true,
      onAnswer: (ok) => recordAttempt({ skill: "kultur", correct: ok }),
    });
  </script>
</Layout>
