---
// /kursinhalte/<niveau> — what one course level teaches, block by block (KursProgression),
// under the A1.1 → C1 line (KursTimeline). One page per level, so every level has its own
// title, description and address to share. Content: src/data/kursinhalte.json.
// German only, like the course itself: lang="de" on <main>.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import KursTimeline from "../../components/KursTimeline.astro";
import KursProgression from "../../components/KursProgression.astro";
import data from "../../data/kursinhalte.json";
import "../../styles/practice.css";

export function getStaticPaths() {
  return data.niveaus.map((l) => ({ params: { level: l.id } }));
}

const level = data.niveaus.find((l) => l.id === Astro.params.level)!;
const exam = level.bloecke.some((b) => "pruefung" in b);
const description = `Deutschkurs ${level.label} (${level.titel}): ${level.bloecke.length} Themen mit Lernzielen, Grammatik und Wortschatz${exam ? ", passend zu Goethe und telc" : ""}. Dauer ${level.dauer}. Mit Selbsttest.`;
---
<Layout
  title={`Deutschkurs ${level.label} – Themen & Lernziele | EnglishAcademy`}
  description={description}
  breadcrumb={[{ name: "Kursinhalte", path: "/kursinhalte" }]}
  schema={{
    "@type": "Course",
    name: `Deutschkurs ${level.label}: ${level.titel}`,
    description: level.ziel,
    educationalLevel: level.label,
    teaches: level.bloecke.map((b) => b.thema),
  }}
>
  <SiteNav />
  <main class="practice-main ki" lang="de">
    <header class="ki-hero">
      <p class="ki-eyebrow"><a href="/kursinhalte">Kursinhalte</a> · Niveau {level.label}</p>
      <h1>Deutschkurs {level.label}: {level.titel}</h1>
      <p class="ki-lead">{level.ziel}</p>
    </header>
    <div data-kp-hide-print>
      <KursTimeline current={level.id} />
    </div>
    <KursProgression level={level.id} />
  </main>
</Layout>

<style>
  .ki { max-width: 820px; }
  .ki-hero { margin-bottom: 8px; }
  .ki-eyebrow { margin: 0 0 6px; font-size: var(--text-sm); font-weight: var(--fw-semibold); color: var(--muted); }
  .ki-eyebrow a { color: var(--brand-blue-dark); }
  .ki-hero h1 { margin: 0 0 8px; font-size: var(--text-4xl); line-height: 1.15; }
  .ki-lead { margin: 0; color: var(--muted); font-size: var(--text-lg); line-height: 1.5; }
  @media (max-width: 480px) {
    .ki { padding-left: 16px; padding-right: 16px; padding-top: 24px; }
  }
  @media print {
    .ki { padding: 0; max-width: none; }
    .ki-eyebrow { display: none; }
    .ki-hero h1 { font-size: 13pt; margin-bottom: 1pt; }
    .ki-lead { font-size: 8pt; margin-bottom: 4pt; color: #333; }
  }
</style>
