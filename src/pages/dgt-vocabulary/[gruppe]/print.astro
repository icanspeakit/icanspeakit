---
import { fitTitle } from "../../../lib/seo/title.js";
// /dgt-vocabulary/[gruppe]/print: one word group of the DGT driving deck on paper, the same sheet
// as a sector's group (english-for-work/[beruf]/[gruppe]/print.astro).
import Layout from "../../../layouts/Layout.astro";
import { workPath } from "../../../lib/routes.js";
import WortschatzDruck from "../../../components/WortschatzDruck.astro";
import { DECKS, groupsOf, rowsOf } from "../../../lib/berufeWortschatz.js";
import { wortschatzSheet, SHEET_LANGS } from "../../../lib/arbeitsblatt/wortschatz.js";

export function getStaticPaths() {
  return groupsOf("dgt").map((g: any) => ({ params: { gruppe: g.id }, props: { group: g } }));
}
const { group } = Astro.props as any;
const deck = DECKS.dgt;
const words = rowsOf("dgt", group.id);
// A sheet language only when every word of the group has it, as on the cards.
const langs = SHEET_LANGS.filter((l) => words.every((w: any) => w[l]));
const sheet = wortschatzSheet(`berufe-dgt-${group.id}`, { words, langs });
---
<Layout
  title={fitTitle(`${group.title} – ${deck.title} to print`, `${group.title} to print`)}
  description={`${deck.title}: ${group.title} as a PDF: every word with a translation and an example sentence, plus a short test with answers.`}
>
  <WortschatzDruck title={group.title} level={deck.title} words={words} sheet={sheet} langs={langs} setPath={workPath("dgt", group.id)} />
</Layout>
