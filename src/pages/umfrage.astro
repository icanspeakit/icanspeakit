---
// /umfrage — where a phone answers a teacher's class poll. The QR code on the projector
// points here with ?c=CODE; the short address and the code are there for whoever cannot
// scan. Phone-first: one question per screen, big targets, every question can be skipped.
//
// Anonymous: no name, no account, nothing asked about the person. The phone keeps a random
// token so it answers each poll once (and may change its answer); see
// supabase/migrations/*_umfragen.sql. The questions show in the interface language (the
// picker in the head), with the German underneath. Logic: src/lib/umfrage/abstimmen.js.
import Layout from "../layouts/Layout.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import "../styles/live-quiz.css";
import "../styles/klassen.css";
import "../styles/umfrage.css";
---
<Layout
  title="Survey – EnglishAcademy"
  description="Enter the code and take part in your class's survey anonymously."
  noindex
>
  <main class="lq lq--player uf uf-vote" id="uf-vote">
    <div class="lq-phone-head">
      <a class="lq-brand" href="/">EnglishAcademy</a>
      <span class="lq-phone-tools"><LanguageSwitcher /></span>
    </div>

    <section class="lq-card" data-screen="loading">
      <p data-i18n="kl.loading">One moment …</p>
    </section>

    <section data-screen="code" hidden>
      <h1 class="lq-title" data-i18n="uf.s.code.title">Umfrage</h1>
      <form class="lq-card lq-form kl-stack" data-code-form novalidate>
        <label class="lq-field">
          <span data-i18n="uf.s.code.label">Code von der Tafel</span>
          <input type="text" class="kl-code-input" data-code-input maxlength="7" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="ABC234" />
        </label>
        <p class="lq-error" data-code-error role="alert"></p>
        <button type="submit" class="lq-btn lq-btn--primary lq-btn--block" data-i18n="lq.join.next">Weiter</button>
      </form>
    </section>

    <section class="kl-stack" data-screen="intro" hidden>
      <h1 class="lq-title" data-poll-title></h1>
      <div class="lq-card uf-anon uf-anon--student">
        <p class="uf-anon-big" data-i18n="uf.s.anon.title">Diese Umfrage ist anonym.</p>
        <ul>
          <li data-i18n="uf.s.anon.1">Du gibst keinen Namen ein und brauchst kein Konto.</li>
          <li data-i18n="uf.s.anon.2">Deine Lehrkraft sieht nur, wie viele Personen was gewählt haben.</li>
          <li data-i18n="uf.s.anon.3">Du kannst jede Frage überspringen.</li>
        </ul>
      </div>
      <p class="kl-muted" data-intro-count></p>
      <p class="uf-again" data-again hidden data-i18n="uf.s.again">Du hast schon geantwortet. Du kannst deine Antwort ändern.</p>
      <button type="button" class="lq-btn lq-btn--primary lq-btn--block" data-start data-i18n="uf.s.start">Los geht's</button>
    </section>

    <section class="kl-stack" data-screen="frage" hidden>
      <div class="uf-progress" aria-hidden="true"><span data-progress-bar></span></div>
      <p class="uf-step" data-step></p>
      {/* A timed poll: this question's own clock, big, with a bar that runs down (abstimmen.js). */}
      <div class="uf-clock" data-clock role="timer" hidden>
        <span class="uf-clock-ic" aria-hidden="true">⏱</span>
        <span class="uf-clock-time" aria-hidden="true"><b data-clock-num></b> <small data-clock-unit data-i18n="uf.s.zeit.sec">Sek.</small></span>
        <span class="uf-clock-label" aria-hidden="true" data-i18n="uf.s.zeit.this">für diese Frage</span>
        <span class="uf-clock-bar" aria-hidden="true"><span data-clock-bar></span></span>
      </div>
      <p class="uf-zeit-note" data-zeit-note role="status" hidden></p>
      <fieldset class="uf-ask" data-ask>
        <legend>
          <span class="uf-ask-q" data-ask-q></span>
          <span class="uf-ask-de" data-ask-de lang="de" dir="ltr" hidden></span>
        </legend>
        <p class="uf-ask-hint" data-ask-hint></p>
        <div class="uf-opts" data-opts></div>
      </fieldset>
      <p class="lq-error" data-ask-error role="status" aria-live="polite"></p>
      <div class="uf-nav">
        <button type="button" class="lq-btn lq-btn--ghost" data-back data-i18n="header.goBack">Zurück</button>
        <button type="button" class="lq-btn lq-btn--primary" data-next></button>
      </div>
    </section>

    <section class="lq-card kl-stack uf-done" data-screen="fertig" hidden>
      <p class="uf-done-ic" aria-hidden="true">🎉</p>
      <h1 class="lq-title" data-i18n="uf.s.done.title">Danke!</h1>
      <p class="uf-timeup" data-timeup hidden data-i18n="uf.s.zeit.up">Die Zeit ist um. Was du bis hierhin beantwortet hast, ist angekommen.</p>
      <p data-i18n="uf.s.done.text">Deine Antwort ist angekommen. Sie ist anonym: Niemand sieht, was du gewählt hast.</p>
      <button type="button" class="lq-btn lq-btn--ghost lq-btn--block" data-change data-i18n="uf.s.change">Antwort ändern</button>
      <a class="lq-btn lq-btn--primary lq-btn--block" href="/uebungen" data-i18n="uf.s.practice">Practise English now</a>
    </section>

    <section class="lq-card kl-stack" data-screen="zu" hidden>
      <h1 class="lq-title" data-i18n="uf.s.closed.title">Diese Umfrage ist geschlossen</h1>
      <p data-i18n="uf.s.closed.text">Deine Lehrkraft nimmt keine Antworten mehr an. Frag sie, ob es eine neue Umfrage gibt.</p>
    </section>

    <section class="lq-card kl-stack" data-screen="fehler" hidden>
      <p class="lq-error" data-fatal role="alert"></p>
      <button type="button" class="lq-btn lq-btn--primary" data-retry data-i18n="uf.s.retry">Noch einmal versuchen</button>
    </section>
  </main>

  <script>
    import { mountAbstimmen } from "../lib/umfrage/abstimmen.js";
    const root = document.getElementById("uf-vote");
    if (root) mountAbstimmen(root);
  </script>
</Layout>
