---
// /games/countable-sprint — an endless runner where every few seconds a word gate asks for the
// article (a / an / some), the plural or a verb form, and the learner answers by riding through
// a lane. Phone-first: swipe controls, the stage fills the screen below the nav.
// Logic: src/lib/artikelSprint/ (game loop, renderer, input, questions, storage, sound).
// Words: src/data/artikel-sprint/words.json (the verbs and hand-picked nouns); Artikel and Plural also draw
// on the lexicon's nouns per level (woerter-<level>.json, loaded by main.js). enrich() adds each item's
// lexicon id and recording.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/artikel-sprint.css";
import rawWords from "../../data/artikel-sprint/words.json";
import { enrich, nounCount } from "../../lib/artikelSprint/lexWords.js";

const words = enrich(rawWords);
const modes = [
  { id: "artikel", label: "Articles", key: "sprint.mode.artikel", sub: "a · an · some" },
  { id: "plural", label: "Plural", key: "sprint.mode.plural", sub: "tables" },
  { id: "verb", label: "Verbs", key: "sprint.mode.verb", sub: "I go" },
];
const levels = ["A1", "A2", "B1"];
// Schwierigkeit: speed and lives (src/lib/artikelSprint/game.js, DIFFICULTIES). Separate from the word level.
const diffs = [
  { id: "leicht", label: "Easy", key: "sprint.diff.leicht" },
  { id: "normal", label: "Normal", key: "sprint.diff.normal" },
  { id: "schwer", label: "Hard", key: "sprint.diff.schwer" },
];
const counts = Object.fromEntries(levels.map((l) => [l, {
  nouns: nounCount(words, l),
  verbs: words.verbs.filter((v) => v.level === l).length,
}]));
---
<Layout
  title="Bruno Kart: a, an or some in a kart race – icanspeak Spanish"
  description="A racing game for learning English: drive through the right gate – a, an or some, the plural or the verb form. A1 to B1, free in the browser, on your phone too."
>
  <SiteNav active="ueben" />
  <main class="asp-page">
    <div class="asp" id="artikel-sprint" data-phase="start">
      <div class="asp-hud" data-hud hidden>
        <span class="asp-hud-item asp-lives" data-lives role="img"></span>
        <span class="asp-hud-item" title="Punkte" data-i18n-attr="title:sprint.points"><span class="asp-hud-k"><span class="asp-long" data-i18n="sprint.points">Punkte</span><span class="asp-short" data-i18n="sprint.pointsShort">Pkt.</span></span> <b data-score>0</b></span>
        <span class="asp-hud-item" title="Richtige Antworten in Folge" data-i18n-attr="title:sprint.streakTitle"><span class="asp-hud-k" data-i18n="sprint.streak">Serie</span> <b data-streak>0</b> <span class="asp-x2" data-mult hidden>×2</span></span>
        <span class="asp-hud-item" title="Münzen" data-i18n-attr="title:sprint.coins"><span class="asp-coin" aria-hidden="true"></span><b data-coins>0</b> <span class="asp-sr" data-i18n="sprint.coins">Münzen</span></span>
        <span class="asp-hud-tools">
          <button type="button" class="asp-icon-btn" data-pause aria-label="Pause (P)" title="Pause (P)" data-i18n-attr="aria-label:sprint.pauseKey;title:sprint.pauseKey">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
          </button>
          <button type="button" class="asp-icon-btn" data-mute aria-pressed="false" aria-label="Sound off" title="Sound off" data-i18n-attr="aria-label:sprint.sound.off;title:sprint.sound.off">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
          </button>
        </span>
      </div>

      <div class="asp-stage" data-stage tabindex="-1">
        <canvas class="asp-canvas" data-canvas aria-label="Game area: three lanes, you drive a kart" data-i18n-attr="aria-label:sprint.canvas" role="img"></canvas>

        <div class="asp-prompt" data-prompt hidden aria-live="polite">
          <span class="asp-tag" data-tag></span>
          <button type="button" class="asp-word" data-word aria-expanded="false"></button>
          <span class="asp-en" data-en lang="en" hidden></span>
          <div class="asp-lanes">
            <span class="asp-lane" data-lane></span>
            <span class="asp-lane" data-lane></span>
            <span class="asp-lane" data-lane></span>
          </div>
        </div>
        <p class="asp-toast" data-toast hidden role="status"></p>

        <!-- Race room: live ranking, bottom right -->
        <ol class="asp-board" data-board hidden aria-label="Ranking" data-i18n-attr="aria-label:sprint.room.rank"></ol>

        <!-- Run clock and active power-ups, bottom left over the scene -->
        <div class="asp-fx" aria-hidden="true">
          <span class="asp-timer" data-timer><b data-time>0:00</b> <small data-time-best></small></span>
          <span class="asp-power" data-power="shield" style="--c:#0ea5e9" hidden data-i18n="sprint.chip.shield">Schild</span>
          <span class="asp-power" data-power="warp" style="--c:#eab308" hidden data-i18n="sprint.chip.warp">Turbo</span>
          <span class="asp-power" data-power="magnet" style="--c:#dc2626" hidden data-i18n="sprint.chip.magnet">Magnet</span>
          <span class="asp-power" data-power="jump" style="--c:#16a34a" hidden data-i18n="sprint.chip.jump">Supersprung</span>
          <span class="asp-power" data-power="double" style="--c:#f97316" hidden data-i18n="sprint.chip.double">×2 Punkte</span>
        </div>

        <!-- Start -->
        <section class="asp-screen" data-screen="start">
          <div class="asp-card">
            <h1 class="asp-title" lang="en">Bruno Kart</h1>
            <p class="asp-lead" data-i18n="sprint.lead">Fahr durch das richtige Tor.</p>

            <!-- A challenge link (?duell=…): the friend's track, words and score -->
            <div class="asp-duel" data-duel hidden>
              <p class="asp-duel-k" data-i18n="sprint.duel.k">Herausforderung</p>
              <p class="asp-duel-text" data-duel-text></p>
              <p class="asp-duel-sub" data-duel-sub></p>
              <button type="button" class="asp-btn asp-btn--go" data-duel-go data-i18n="sprint.duel.go">Annehmen</button>
              <button type="button" class="asp-btn asp-btn--quiet" data-duel-skip data-i18n="sprint.duel.skip">Lieber normal spielen</button>
            </div>

            <div data-solo>
            <p class="asp-label" id="asp-mode-l" data-i18n="sprint.whatLabel">Was übst du?</p>
            <div class="asp-seg asp-seg--modes" data-switch role="group" aria-labelledby="asp-mode-l">
              {modes.map((m) => (
                <button type="button" class="asp-seg-btn" data-mode={m.id} aria-pressed={m.id === "artikel" ? "true" : "false"}>
                  <span data-i18n={m.key}>{m.label}</span><small lang="en">{m.sub}</small>
                </button>
              ))}
            </div>
            <p class="asp-mode-hint" data-mode-hint data-i18n="sprint.hint.artikel">a, an or some?</p>

            <p class="asp-label" id="asp-level-l" data-i18n="sprint.level">Niveau</p>
            <div class="asp-seg" data-switch role="group" aria-labelledby="asp-level-l">
              {levels.map((l) => (
                <button type="button" class="asp-seg-btn" data-level={l} aria-pressed={l === "A1" ? "true" : "false"} title={`${counts[l].nouns} nouns, ${counts[l].verbs} verbs`} data-i18n-attr="title:sprint.levelCount" data-i18n-vars={JSON.stringify({ n: counts[l].nouns, v: counts[l].verbs })}>{l}</button>
              ))}
            </div>

            <p class="asp-label" id="asp-diff-l" data-i18n="sprint.diff">Schwierigkeit</p>
            <div class="asp-seg" data-switch role="group" aria-labelledby="asp-diff-l">
              {diffs.map((d) => (
                <button type="button" class="asp-seg-btn" data-diff={d.id} aria-pressed={d.id === "normal" ? "true" : "false"} data-i18n={d.key}>{d.label}</button>
              ))}
            </div>
            <p class="asp-mode-hint" data-diff-hint data-i18n="sprint.diff.normal.hint">Wie immer, 3 Leben</p>

            <button type="button" class="asp-btn asp-btn--go" data-start data-i18n="sprint.start">Start</button>
            <p class="asp-best" data-best></p>
            <button type="button" class="asp-btn" data-daily>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg>
              <span data-i18n="sprint.daily.btn">Tagesrunde</span>
            </button>
            <p class="asp-best" data-daily-line></p>
            <button type="button" class="asp-btn" data-room-open>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 19c.6-3.2 3-5 6-5s5.4 1.8 6 5"/><circle cx="17" cy="9" r="2.6"/><path d="M16.5 14c2.4.2 4 1.7 4.5 4.6"/></svg>
              <span data-i18n="sprint.room.open">Mit Freunden spielen</span>
            </button>
            </div>

            <details class="asp-how">
              <summary data-i18n="sprint.how">So geht's</summary>
              <ul>
                <li data-i18n-html="sprint.how.lane"><b>Spur wechseln:</b> wischen nach links/rechts · <kbd>←</kbd> <kbd>→</kbd> oder <kbd>A</kbd> <kbd>D</kbd></li>
                <li data-i18n-html="sprint.how.jump"><b>Springen</b> über Kisten: nach oben wischen · <kbd>↑</kbd> oder <kbd>Leertaste</kbd></li>
                <li data-i18n-html="sprint.how.duck"><b>Ducken</b> unter Schranken: nach unten wischen · <kbd>↓</kbd></li>
                <li data-i18n-html="sprint.how.cart"><b>Wagen</b> kannst du nur ausweichen.</li>
                <li data-i18n-html="sprint.how.gateJump">Am <b>Wort-Tor</b> hängen die Antworten in Boxen: <b>spring</b> in der richtigen Spur hinein. Drunter durchfahren zählt nicht. Falsch oder ein Hindernis kostet ein Leben – auf „Leicht“ hast du fünf, auf „Normal“ drei, auf „Schwer“ eins.</li>
                <li data-i18n-html="sprint.how.wide">Über <b>Hürden</b> quer über die Strecke springst du, unter <b>gelben Balken</b> duckst du dich.</li>
                <li data-i18n-html="sprint.how.warp"><b>Turbo-Pfeile</b> auf der Straße: 3 Sekunden doppeltes Tempo, du fährst durch alles durch.</li>
                <li data-i18n-html="sprint.how.box"><b>?-Kisten</b> und lose Extras: Schild, Magnet, Supersprung, doppelte Punkte oder ein Leben.</li>
                <li data-i18n-html="sprint.how.time">Die <b>Uhr</b> läuft mit: Schlag deine Bestzeit pro Modus und Niveau.</li>
                <li data-i18n-html="sprint.how.x2">5 richtige Antworten in Folge: <b>doppelte Punkte</b>. Pause mit <kbd>P</kbd>.</li>
                <li data-i18n-html="sprint.how.friends"><b>Mit Freunden:</b> Raum erstellen, Code teilen, und alle fahren gleichzeitig dieselbe Strecke. Oder nach dem Spiel einen Link schicken: Wer schafft mehr Punkte?</li>
              </ul>
            </details>
          </div>
        </section>

        <!-- Race room: name and code, then the lobby -->
        <section class="asp-screen" data-screen="room" hidden>
          <div class="asp-card">
            <h2 class="asp-title asp-title--sm" data-i18n="sprint.room.title">Rennen mit Freunden</h2>
            <div data-room-step="entry">
              <p class="asp-lead" data-i18n="sprint.room.lead">Alle fahren dieselbe Strecke mit denselben Wörtern. Wer die meisten Punkte hat, gewinnt.</p>
              <label class="asp-label" for="asp-room-name" data-i18n="sprint.room.name">Dein Name</label>
              <input class="asp-input" id="asp-room-name" data-room-name maxlength="16" autocomplete="nickname" enterkeyhint="go" />
              <button type="button" class="asp-btn asp-btn--go" data-room-create data-i18n="sprint.room.create">Raum erstellen</button>
              <p class="asp-or" data-i18n="sprint.room.or">oder mit Code beitreten</p>
              <div class="asp-join">
                <input class="asp-input asp-input--code" data-room-code inputmode="numeric" maxlength="6" placeholder="123456" aria-label="Room code" data-i18n-attr="aria-label:sprint.room.code" enterkeyhint="go" />
                <button type="button" class="asp-btn" data-room-join data-i18n="sprint.room.join">Beitreten</button>
              </div>
              <p class="asp-room-msg" data-room-msg role="status"></p>
              <button type="button" class="asp-btn asp-btn--quiet" data-room-cancel data-i18n="sprint.room.cancel">Zurück</button>
            </div>
            <div data-room-step="lobby" hidden>
              <p class="asp-label" data-i18n="sprint.room.code">Raum-Code</p>
              <p class="asp-pin" data-room-pin></p>
              <div class="asp-invite">
                <button type="button" class="asp-btn" data-room-share data-i18n="sprint.room.share">Einladung teilen</button>
                <button type="button" class="asp-btn" data-room-qr aria-expanded="false" aria-controls="asp-room-qr" data-i18n="sprint.room.qr">QR-Code</button>
              </div>
              <figure class="asp-qr" id="asp-room-qr" hidden>
                <div class="asp-qr-img" data-room-qr-img role="img" aria-label="QR code to join the race" data-i18n-attr="aria-label:sprint.room.qrLabel"></div>
                <figcaption data-i18n="sprint.room.qrHint">Mit der Handy-Kamera scannen</figcaption>
              </figure>
              <input class="asp-input asp-link" data-room-link readonly aria-label="Invitation link" data-i18n-attr="aria-label:sprint.room.link" hidden />
              <p class="asp-label"><span data-i18n="sprint.room.players">Dabei</span> <span data-room-count></span></p>
              <ul class="asp-players" data-room-players></ul>
              <div data-room-host>
                <p class="asp-label" id="asp-room-mode-l" data-i18n="sprint.whatLabel">Was übst du?</p>
                <div class="asp-seg asp-seg--modes" data-switch role="group" aria-labelledby="asp-room-mode-l">
                  {modes.map((m) => (
                    <button type="button" class="asp-seg-btn" data-mode={m.id} aria-pressed={m.id === "artikel" ? "true" : "false"}>
                      <span data-i18n={m.key}>{m.label}</span><small lang="en">{m.sub}</small>
                    </button>
                  ))}
                </div>
                <p class="asp-label" id="asp-room-level-l" data-i18n="sprint.level">Niveau</p>
                <div class="asp-seg" data-switch role="group" aria-labelledby="asp-room-level-l">
                  {levels.map((l) => (
                    <button type="button" class="asp-seg-btn" data-level={l} aria-pressed={l === "A1" ? "true" : "false"} title={`${counts[l].nouns} nouns, ${counts[l].verbs} verbs`} data-i18n-attr="title:sprint.levelCount" data-i18n-vars={JSON.stringify({ n: counts[l].nouns, v: counts[l].verbs })}>{l}</button>
                  ))}
                </div>
                <p class="asp-label" id="asp-room-diff-l" data-i18n="sprint.diff">Schwierigkeit</p>
                <div class="asp-seg" data-switch role="group" aria-labelledby="asp-room-diff-l">
                  {diffs.map((d) => (
                    <button type="button" class="asp-seg-btn" data-diff={d.id} aria-pressed={d.id === "normal" ? "true" : "false"} data-i18n={d.key}>{d.label}</button>
                  ))}
                </div>
              </div>
              <p class="asp-room-cfg" data-room-cfg></p>
              <button type="button" class="asp-btn asp-btn--go" data-room-start data-i18n="sprint.room.start">Rennen starten</button>
              <p class="asp-room-msg" data-room-wait role="status"></p>
              <button type="button" class="asp-btn asp-btn--quiet" data-room-leave data-i18n="sprint.room.leave">Raum verlassen</button>
            </div>
          </div>
        </section>

        <!-- Race start: 3, 2, 1 over the first stretch of the track -->
        <section class="asp-screen asp-screen--count" data-screen="count" hidden>
          <p class="asp-count" data-count aria-live="assertive"></p>
        </section>

        <!-- Pause -->
        <section class="asp-screen" data-screen="pause" hidden>
          <div class="asp-card asp-card--small">
            <h2 class="asp-title" data-i18n="sprint.pause">Pause</h2>
            <button type="button" class="asp-btn asp-btn--go" data-resume data-i18n="sprint.resume">Weiter</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-quit data-i18n="sprint.quit">Beenden</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-mute aria-pressed="false" aria-label="Sound off" title="Sound off" data-i18n-attr="aria-label:sprint.sound.off;title:sprint.sound.off">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
              <span data-i18n="sprint.sound">Ton</span>
            </button>
            <div data-melden></div>
          </div>
        </section>

        <!-- Game over -->
        <section class="asp-screen" data-screen="over" hidden>
          <div class="asp-card">
            <h2 class="asp-title" data-i18n="sprint.over">Spiel vorbei</h2>
            <p class="asp-score"><b data-o-score>0</b> <span data-i18n="sprint.points">Punkte</span></p>
            <p class="asp-record" data-o-record hidden data-i18n="sprint.record.new">Neuer Rekord!</p>
            <p class="asp-record" data-o-timerecord hidden data-i18n="sprint.time.beat">Neue Bestzeit!</p>
            <p class="asp-duel-result is-win" data-o-daily hidden></p>
            <p class="asp-duel-result" data-o-duel hidden></p>
            <p class="asp-lb-line" data-o-lb hidden role="status"></p>
            <div class="asp-room-result" data-o-room hidden>
              <h3 data-i18n="sprint.room.rank">Rangliste</h3>
              <ol class="asp-players asp-players--rank" data-o-rank></ol>
            </div>
            <dl class="asp-stats">
              <div><dt data-i18n="sprint.stat.acc">Treffer</dt><dd data-o-acc>–</dd></div>
              <div><dt data-i18n="sprint.stat.answers">Antworten</dt><dd data-o-answers>0</dd></div>
              <div><dt data-i18n="sprint.stat.streak">Beste Serie</dt><dd data-o-streak>0</dd></div>
              <div><dt data-i18n="sprint.coins">Münzen</dt><dd data-o-coins>0</dd></div>
              <div><dt data-i18n="sprint.stat.record">Rekord</dt><dd data-o-best>0</dd></div>
              <div><dt data-i18n="sprint.stat.time">Zeit</dt><dd><span data-o-time>0:00</span><small class="asp-stat-sub"><span data-i18n="sprint.stat.bestTime">Bestzeit</span> <span data-o-besttime>0:00</span></small></dd></div>
            </dl>
            <div class="asp-missed" data-o-missed-wrap hidden>
              <h3 data-i18n="sprint.practise">Üben</h3>
              <ul data-o-missed></ul>
            </div>
            <p class="asp-clean" data-o-clean hidden data-i18n="sprint.clean">Kein Fehler am Tor. Stark!</p>
            <button type="button" class="asp-btn asp-btn--go" data-again data-i18n="sprint.again">Nochmal</button>
            <p class="asp-room-msg" data-o-room-msg role="status" hidden></p>
            <details class="asp-share" data-o-share>
              <summary data-i18n="sprint.duel.send">Freunde herausfordern</summary>
              <p class="asp-share-text" data-share-text></p>
              <label class="asp-label" for="asp-share-name" data-i18n="sprint.room.name">Dein Name</label>
              <input class="asp-input" id="asp-share-name" data-share-name maxlength="16" autocomplete="nickname" />
              <button type="button" class="asp-btn" data-share-go data-i18n="sprint.duel.share">Link teilen</button>
              <input class="asp-input asp-link" data-share-link readonly aria-label="Link" hidden />
              <p class="asp-room-msg" data-share-msg role="status"></p>
            </details>
            <button type="button" class="asp-btn asp-btn--quiet" data-back data-i18n="sprint.back">Modus oder Niveau ändern</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-room-leave hidden data-i18n="sprint.room.leave">Raum verlassen</button>
            <div data-melden></div>
          </div>
        </section>
      </div>
    </div>

    <!-- Ranking: best run per player for the board picked on the start screen (board.js) -->
    <section class="asp-lb" id="bestenliste" data-lb>
      <div class="asp-lb-head">
        <h2 data-i18n="sprint.lb.title">Bestenliste</h2>
        <p class="asp-lb-board" data-lb-board></p>
      </div>
      <div class="asp-seg" data-switch role="group" aria-label="Period" data-i18n-attr="aria-label:sprint.lb.period">
        <button type="button" class="asp-seg-btn" data-lb-zeit="woche" aria-pressed="true" data-i18n="sprint.lb.week">Diese Woche</button>
        <button type="button" class="asp-seg-btn" data-lb-zeit="immer" aria-pressed="false" data-i18n="sprint.lb.all">Allzeit</button>
      </div>
      <ol class="asp-players asp-players--rank asp-lb-list" data-lb-list></ol>
      <p class="asp-lb-empty" data-lb-empty hidden></p>
      <div class="asp-lb-me" data-lb-me></div>
    </section>

    <section class="asp-about">
      <h2 data-i18n="sprint.about.title">Worum geht's?</h2>
      <p data-i18n-html="sprint.about.p1">Bruno Kart verbindet ein Kartrennen mit Grammatik: Alle paar Sekunden steht ein Wort über der Strecke, und die drei Spuren tragen die Antworten. Du übst die Artikel <b>der, die, das</b>, die <b>Pluralformen</b> oder <b>Verbformen</b> – auf A1, A2 oder B1. Was du falsch hattest, steht am Ende unter „Üben“.</p>
      <p data-i18n-html="sprint.about.p2">Lieber in Ruhe? Der <a href="/articles">der/die/das-Trainer</a> fragt dieselben Artikel ohne Zeitdruck.</p>
    </section>
  </main>

