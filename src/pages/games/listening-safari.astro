---
// /games/listening-safari — Hamstis Wachtelhuhn: a listening game modelled on the classic shooting
// galleries. A voice says a noun with its article, birds (our own "Pieper") fly over a wide
// landscape carrying picture cards, and the learner hits the matching one with the
// Gummi-Blaster, a toy that fires harmless rubber pellets on a ballistic curve. 90 s and 3
// hearts, diving birds, extras, a multiple-choice quiz to reload, records and a ranking.
// (English course: the voice says a / an + noun.) Logic: src/lib/hoerSafari/. Plan: HOER-SAFARI-TIERED-PROMPT.md.
// A prototype from 2026-10-26, in the menu "Spiele" and indexed since 2026-10-27 (EXPERIMENTE.md).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { nouns } from "../../lib/lexicon.js";
import { wortBild } from "../../lib/wortBild.js";
import "../../styles/hoer-safari.css";

// Only a / an nouns with a picture: the game is about hearing a or an in front of the noun, so
// uncountables (some bread) stay out. The voice is the browser's British English one (game.js
// say()); `a` keeps the lexicon's clip slug for when English recordings exist. Short keys: the
// list is inlined.
// m = what the word means, for the end screen's word help (en/ar/uk/tr; the other interface
// languages are fetched from /vocabulary/glosses/ by the game).
const words = nouns()
  .filter((n) => (n.gender === "a" || n.gender === "an") && wortBild(n.id))
  .map((n) => ({
    id: n.id, w: n.lemma, g: n.gender, a: n.audio, i: wortBild(n.id), lv: n.level,
    m: Object.fromEntries(["en", "ar", "uk", "tr"].filter((l) => n[l]).map((l) => [l, n[l]])),
  }));
const count = (lv: string[]) => words.filter((w) => lv.includes(w.lv)).length;
const levels = [
  { id: "A1", n: count(["A1"]) },
  { id: "A2", n: count(["A2"]) },
  { id: "B1", n: count(["B1", "B2"]) },
];
---
<Layout
  title="Hamsti's Bird Safari: hear the word, hit the picture – icanspeak Spanish"
  description="A listening game in the browser: you hear a word with el or la and hit the bird with the matching picture using the rubber blaster. 90 seconds, A1 to B1, on your phone too."
>
  <SiteNav active="ueben" />
  <main class="hs-page">
    <div class="hs" id="hoer-safari" data-phase="start">
      <div class="hs-hud" data-hud hidden>
        <span class="hs-hud-item hs-time" title="Sekunden übrig" data-i18n-attr="title:hs.time.title">⏱ <b data-time>90</b></span>
        <span class="hs-hud-item hs-goal" data-goal-wrap title="Richtige Vögel bis zum Ziel" data-i18n-attr="title:hs.goal.title" hidden>🎯 <b data-goal>0/6</b></span>
        <span class="hs-hud-item hs-hearts" data-hearts role="img"></span>
        <span class="hs-hud-item" title="Punkte" data-i18n-attr="title:hs.points"><span class="hs-k" data-i18n="hs.points">Punkte</span><span class="hs-k-short" data-i18n="hs.pointsShort">Pkt.</span> <b data-score>0</b></span>
        <span class="hs-hud-item hs-streak" title="Richtige Treffer in Folge" data-i18n-attr="title:hs.streak.title"><span class="hs-k" data-i18n="hs.streak">Serie</span> <b data-streak>0</b></span>
        <button type="button" class="hs-icon hs-pause-btn" data-pause aria-label="Pause (P)" title="Pause (P)" data-i18n-attr="aria-label:hs.pauseKey;title:hs.pauseKey">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1.2" fill="currentColor"/></svg>
        </button>
        <button type="button" class="hs-icon" data-mute aria-pressed="false">🔊</button>
        <button type="button" class="hs-hint" data-replay data-hint data-state="listen" title="Wort noch einmal hören (H)" data-i18n-attr="title:hs.hint.title">
          <span aria-hidden="true">🔈</span> <span data-hint-text data-i18n="hs.listen">Listen …</span>
        </button>
      </div>

      <div class="hs-stage">
        <canvas data-canvas role="img" aria-label="Playing field: birds carrying picture cards fly over a landscape, the rubber blaster at the bottom" data-i18n-attr="aria-label:hs.canvas"></canvas>

        <button type="button" class="hs-reload" data-reload aria-pressed="false" title="Nachladen: Frage beantworten (Leertaste oder rechte Maustaste)" data-i18n-attr="title:hs.reload.title">
          <span class="hs-ammo" data-ammo role="img"></span>
          <span class="hs-reload-label" data-i18n="hs.reload">Nachladen</span>
        </button>

        <div class="hs-pause" data-pause-card hidden role="dialog" aria-modal="true" aria-labelledby="hs-pause-h">
          <div class="hs-pause-box">
            <h2 id="hs-pause-h" data-i18n="hs.pause.title">Pause</h2>
            <button type="button" class="hs-go" data-pause-go data-i18n="hs.pause.resume">Weiter</button>
            <button type="button" class="hs-quiet" data-pause-restart data-i18n="hs.pause.restart">Neu starten</button>
            <button type="button" class="hs-quiet" data-pause-quit data-i18n="hs.pause.quit">Beenden</button>
            <div data-melden></div>
          </div>
        </div>

        <section class="hs-card hs-card--start" data-start>
          <div class="hs-start-a">
          <p class="hs-eyebrow" data-i18n="hs.eyebrow">Spiel · Prototyp</p>
          <h1 lang="en">Hamsti’s Bird Safari</h1>
          <p class="hs-lead" data-i18n-html="hs.lead">You hear a word – <b>“a fork”</b>. Birds with pictures fly over the meadow. Hit the right one with the rubber blaster! Far away scores more, a wrong bird costs 10.</p>
          </div>

          <div class="hs-start-b">
          <p class="hs-label" data-i18n="hs.play.label">Spielart</p>
          <div class="hs-seg" role="group" aria-label="Mode" data-i18n-attr="aria-label:hs.play.label">
            <button type="button" class="hs-seg-btn" data-spielart="stufen" aria-pressed="true"><span data-i18n="hs.play.stufen">Level</span><small data-i18n="hs.play.stufen.sub">8 Stufen, mit Ziel</small></button>
            <button type="button" class="hs-seg-btn" data-spielart="frei" aria-pressed="false"><span data-i18n="hs.play.frei">Highscore</span><small data-i18n="hs.play.frei.sub">90 Sekunden, Bestenliste</small></button>
            <button type="button" class="hs-seg-btn" data-spielart="tag" aria-pressed="false"><span data-i18n="hs.play.tag">Tagesrunde</span><small data-i18n="hs.play.tag.sub">heute für alle gleich</small></button>
          </div>

          <p class="hs-label" data-i18n="hs.level.label">Niveau</p>
          <div class="hs-seg" role="group" aria-label="Level" data-i18n-attr="aria-label:hs.level.label">
            {levels.map((l) => (
              <button type="button" class="hs-seg-btn" data-level={l.id} aria-pressed="false">
                {l.id}<small data-i18n="hs.words" data-i18n-vars={JSON.stringify({ n: l.n })}>{l.n} Wörter</small>
              </button>
            ))}
          </div>

          <p class="hs-label" data-i18n="hs.cards.label">Auf den Karten</p>
          <div class="hs-seg" role="group" aria-label="What is on the cards" data-i18n-attr="aria-label:hs.cards.label">
            <button type="button" class="hs-seg-btn" data-mode="bild" aria-pressed="true"><span data-i18n="hs.cards.bild">Bilder</span><small data-i18n="hs.cards.bild.sub">nur hören</small></button>
            <button type="button" class="hs-seg-btn" data-mode="wort" aria-pressed="false"><span data-i18n="hs.cards.wort">Wörter</span><small data-i18n="hs.cards.wort.sub">hören + lesen</small></button>
          </div>

          <div class="hs-levels" data-levels hidden></div>

          <button type="button" class="hs-go" data-play data-i18n="hs.go">Los geht's</button>
          <p class="hs-best" data-best></p>
          </div>

          <details class="hs-how">
            <summary data-i18n="hs.how">So geht's</summary>
            <ul>
              <li data-i18n-html="hs.how.pc"><b>Computer:</b> Klicken = schießen. Leertaste oder rechte Maustaste = nachladen. Maus an den Rand = umschauen. H = Wort noch einmal.</li>
              <li data-i18n-html="hs.how.phone"><b>Handy:</b> Tippen = schießen. Wischen = umschauen. Unten rechts „Nachladen“.</li>
              <li data-i18n-html="hs.how.arc">Die Kugel fliegt im Bogen: Bewegte Vögel brauchen etwas Vorhalt, weit entfernte ein bisschen höher zielen.</li>
              <li data-i18n-html="hs.how.reload"><b>Nachladen</b> = eine Frage. Schieß auf die richtige Antwort. Falsch geraten? Dann gibt es nur ein halbes Magazin.</li>
              <li data-i18n-html="hs.how.dive">Fliegt ein Vogel auf dich zu? Schnell treffen – sonst verlierst du ein Herz. Drei Herzen hast du.</li>
              <li data-i18n-html="hs.how.extras">Ballons bringen Extras: ⏱ +5 Sekunden, ❤ ein Herz, ✳ Streuschuss, 🐌 Zeitlupe.</li>
              <li data-i18n-html="hs.how.hint">Nach 8 Sekunden steht das Wort oben – dann gibt es nur noch halbe Punkte. In der Landschaft sind zwei Dinge versteckt. Den Heißluftballon nicht treffen – da sitzen Leute drin (−30).</li>
              <li data-i18n-html="hs.how.rubber">Die Kugeln sind aus Gummi: Die Vögel sehen kurz Sterne und fliegen weg. Jeder getroffene Vogel piept und sagt sein Wort.</li>
              <li data-i18n-html="hs.how.level"><b>Level:</b> Triff genug richtige Vögel, bevor die Zeit um ist. Ohne Fehler gibt es 3 Sterne, und das nächste Level geht auf. Dein Stand bleibt auf diesem Gerät gespeichert.</li>
              <li data-i18n-html="hs.how.tag"><b>Tagesrunde:</b> Eine Highscore-Runde pro Tag. Alle bekommen heute die gleichen Wörter und Vögel. Dein Tagesbestwert bleibt auf diesem Gerät.</li>
              <li data-i18n-html="hs.how.pause">Pause: Knopf oben rechts oder Taste P.</li>
            </ul>
          </details>
        </section>

        <section class="hs-card hs-card--intro" data-intro hidden>
          <p class="hs-eyebrow" data-intro-num lang="en">Level 1 of 8</p>
          <h2 data-intro-name lang="en">First steps</h2>
          <p class="hs-lead" data-intro-goal></p>
          <p class="hs-label" data-intro-news-head data-i18n="hs.news">Neu in diesem Level</p>
          <ul class="hs-news" data-intro-news></ul>
          <p class="hs-intro-stars" data-intro-stars></p>
          <button type="button" class="hs-go" data-intro-go data-i18n="hs.start">Start</button>
          <button type="button" class="hs-quiet" data-intro-back data-i18n="hs.allLevels">Alle Level</button>
        </section>

        <section class="hs-card hs-card--end" data-end hidden>
          <h2 data-end-title lang="en">Time’s up!</h2>
          <div data-result></div>
          <p class="hs-lb-over" data-lb-over hidden></p>
          <button type="button" class="hs-go" data-next hidden data-i18n="hs.next">Next</button>
          <h3 data-i18n="hs.album">Dein Album</h3>
          <div class="hs-tiles" data-album></div>
          <div data-practice-wrap hidden>
            <h3 data-i18n="hs.practice">Noch einmal anhören</h3>
            <p class="hs-muted" data-i18n="hs.practice.sub">Hier lagst du daneben, hast den Hinweis gebraucht oder das Wort ist dir entwischt. Tippen zum Anhören.</p>
            <div class="hs-tiles" data-practice></div>
          </div>
          <button type="button" class="hs-go" data-again data-i18n="hs.again">Another round</button>
          <button type="button" class="hs-quiet" data-back data-i18n="hs.back">Change level</button>
          <div data-melden></div>
        </section>
      </div>
    </div>

    <section class="hs-lb" id="bestenliste" data-lb>
      <div class="hs-lb-head">
        <h2 data-i18n="hs.lb.title">Bestenliste</h2>
        <p class="hs-lb-board" data-lb-board></p>
      </div>
      <div class="hs-seg" role="group" aria-label="Period" data-i18n-attr="aria-label:hs.lb.range">
        <button type="button" class="hs-seg-btn" data-lb-zeit="woche" aria-pressed="true" data-i18n="hs.lb.week">Diese Woche</button>
        <button type="button" class="hs-seg-btn" data-lb-zeit="immer" aria-pressed="false" data-i18n="hs.lb.all">Allzeit</button>
      </div>
      <ol class="hs-lb-list" data-lb-list></ol>
      <p class="hs-muted" data-lb-empty hidden></p>
      <div class="hs-lb-me" data-lb-me></div>
    </section>

    <section class="hs-about">
      <h2 data-i18n="hs.about.title">Worum geht's?</h2>
      <p data-i18n-html="hs.about.p">Hamsti’s Bird Safari practises <b>listening and vocabulary</b> at the same time: you hear each noun with its el or la and have to recognise it quickly. Reloading brings el / la and picture questions. All words come from our <a href="/vocabulary">vocabulary</a> – you can also practise them there at your own pace.</p>
      <p class="hs-muted" data-i18n="hs.about.credit">Bilder: OpenMoji (CC BY-SA 4.0).</p>
    </section>
  </main>

  <script type="application/json" id="hs-data" set:html={JSON.stringify(words)}></script>
  <script>
    import { mountHoerSafari } from "../../lib/hoerSafari/game.js";
    const root = document.getElementById("hoer-safari");
    const data = JSON.parse(document.getElementById("hs-data")?.textContent || "[]");
    if (root) mountHoerSafari(root, data);
  </script>
</Layout>
