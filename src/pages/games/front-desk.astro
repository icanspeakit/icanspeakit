---
// /games/front-desk — Bruno’s Front Desk: Bruno works desk 3 at Brambleford Town Hall (resident parking permits). A
// customer slides papers across the desk; the player finds what contradicts (Check), asks a
// question in English and stamps APPROVED or REJECTED. Papers are DOM, not canvas.
// Logic: src/lib/buergeramt/. Plan: BUERGERAMT-TIERED-PROMPT.md.
// A prototype since 2026-10-28: noindex, not in the menu (EXPERIMENTE.md).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/buergeramt.css";
---
<Layout
  title="Bruno's Front Desk – EnglishAcademy"
  description="A game at the front desk of Brambleford council office: check papers, find mistakes, ask questions in English and stamp."
  noindex
>
  <SiteNav active="ueben" />
  <main class="ba-page">
    <div class="ba" id="buergeramt" data-phase="start">
      <section class="ba-card ba-start" data-start>
        <p class="ba-eyebrow" data-ui="eyebrow" lang="en">Game · Prototype</p>
        <h1 data-ui="titel" lang="en">Bruno’s Front Desk</h1>
        <p class="ba-lead" data-ui="lead"></p>
        <div data-start-body></div>
        <button type="button" class="ba-go" data-los data-ui="los" lang="en">Start your shift</button>
        <noscript><p lang="en">This game needs JavaScript.</p></noscript>
      </section>

      <div class="ba-amt is-leer" data-amt hidden>
        <div class="ba-hud">
          <span class="ba-hud-i ba-uhr" data-uhr-wrap><span aria-hidden="true">🕗</span> <b data-uhr>08:00</b></span>
          <span class="ba-hud-i"><span data-ui="wartende">Waiting</span> <b data-wartende>0</b></span>
          <span class="ba-hud-i"><span data-ui="punkte">Points</span> <b data-punkte>0</b></span>
          <span class="ba-hud-i ba-verw" data-verw role="img"></span>
          <span class="ba-hud-sp"></span>
          <button type="button" class="ba-icon" data-pause hidden aria-label="Pause">⏸</button>
          <button type="button" class="ba-icon" data-mute data-ui-title="ton" aria-pressed="false">🔊</button>
        </div>

        <div class="ba-fenster">
          <div class="ba-anzeige" aria-live="polite">
            <small data-ui="nummer">Number</small>
            <b data-nummer>–</b>
            <small data-ui="schalter" lang="en">Desk 3</small>
          </div>
          <div class="ba-kunde-wrap">
            <div class="ba-kunde" data-kunde></div>
            <div class="ba-bubble" data-bubble hidden aria-live="polite"></div>
          </div>
          <div class="ba-schlange" data-schlange aria-hidden="true"></div>
        </div>

        <div class="ba-desk" data-desk>
          <div class="ba-tabs" data-tabs role="group"></div>
          <div class="ba-docs" data-docs></div>
          <aside class="ba-side">
            <button type="button" class="ba-pruefen" data-pruefen aria-pressed="false" data-ui-title="pruefenTitel">🔍 <span data-ui="pruefen">Check</span> <kbd>P</kbd></button>
            <div class="ba-notiz" data-notiz data-count="0">
              <b data-ui="notizzettel">Notes</b>
              <ul data-notiz-list></ul>
            </div>
            <div class="ba-fragen" data-fragen hidden role="dialog"></div>
            <div class="ba-stempel-row">
              <button type="button" class="ba-stempel ba-stempel--ok" data-stempel="genehmigt"><span data-ui="genehmigt">APPROVED</span> <kbd>A</kbd></button>
              <button type="button" class="ba-stempel ba-stempel--no" data-stempel="abgelehnt"><span data-ui="abgelehnt">REJECTED</span> <kbd>R</kbd></button>
            </div>
          </aside>
          <div class="ba-rosa" data-rosa hidden role="alert"></div>
        </div>
        <svg class="ba-lines" data-lines aria-hidden="true"></svg>
        <div class="ba-toast" data-toast hidden role="status"></div>
      </div>

      <section class="ba-card ba-ende" data-ende hidden aria-live="polite"></section>
    </div>
  </main>

  <script>
    import { mountBuergeramt } from "../../lib/buergeramt/spiel.js";
    const root = document.getElementById("buergeramt");
    if (root) mountBuergeramt(root);
  </script>
</Layout>
