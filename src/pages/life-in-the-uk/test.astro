---
import ExamDisclaimer from "../../components/ExamDisclaimer.astro";
// The CCSE practice test on the exam-app shell (src/lib/examApp.js). The questions on Spain are
// our own and come in the five subject areas of the real test (meta.tareas, questions[].tarea),
// about two sittings' worth; the score on them is compared with the real pass share. The questions
// on one comunidad are an extra and do not count, because the real test has no such part.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import ExamApp from "../../components/ExamApp.astro";
import ExamFacts from "../../components/ExamFacts.astro";
import "../../styles/practice.css";
import "../../styles/pruefungen.css";
import lid from "../../data/leben-in-deutschland.json";

const { questions, meta, bundeslaender } = lid;
---
<Layout
  title="CCSE practice test – online – icanspeak Spanish"
  description="A CCSE practice test: our own questions about Spain, scored against the pass mark of the real test. Not the official question bank."
>
  <SiteNav active="pruefungen" />
  <main class="practice-main practice-main--wide practice-main--trainer">
    <a href="/progress?pruefung=leben-in-deutschland" class="vp-back-link" data-i18n="exam.backToOverview">Back to the overview</a>

    <div class="practice-hero">
      <p class="eyebrow"><span data-i18n="exam.lid.name">CCSE nationality test</span> · <span data-i18n="lid.test.eyebrow">Practice test</span></p>
      <h1><span class="hero-exam" data-i18n="exam.lid.name">CCSE nationality test</span> <span data-i18n="exam.h1.lidTest">Practice test</span></h1>
      <p data-i18n-html="lid.test.hero" data-i18n-vars={JSON.stringify({ n: meta.federalQuestions, t: meta.totalQuestions, m: meta.minutes, pass: meta.passScore })}>
        n practice questions in Spanish in the same five areas as the real test, plus extra questions on a comunidad autónoma. The real test has t questions and m minutes; you pass with pass correct answers (check the current figures with the Instituto Cervantes). Unsure of the facts? Go through the <a href="/life-in-the-uk/facts">facts page</a> first.
      </p>
    </div>
    <ExamDisclaimer />

    {/* The figures come from meta in leben-in-deutschland.json ("to verify" in the `ccse` report).
        The real test has no part on one comunidad; those questions are an extra. */}
    <ExamFacts
      title="How the test works"
      titleKey="lid.facts.title"
      rows={[
        [{ text: "Questions", key: "lid.facts.questions" }, `${meta.totalQuestions}`],
        [{ text: "Answers", key: "lid.facts.answers" }, { text: "multiple choice", key: "lid.facts.answersVal" }],
        [{ text: "Time", key: "ps.format.th.time" }, `${meta.minutes} min`],
        [{ text: "Pass", key: "sd1.facts.pass" }, `${meta.passScore} / ${meta.totalQuestions}`],
        [{ text: "Based on", key: "lid.facts.catalog" }, { text: "the public materials of the Instituto Cervantes; we do not copy them", key: "lid.facts.catalogVal" }],
      ]}
      notes={[
        { key: "lid.facts.note", html: "Our questions are our own, written from public sources; they are not the official questions. The real test has no part about one comunidad autónoma: our questions on them are extra practice. General orientation, not legal advice." },
      ]}
      sources={[
        { label: "Instituto Cervantes: CCSE", url: "https://cervantes.org/es/examenes/ccse" },
      ]}
      checked="06.11.2026"
    />

    <ExamApp brand="CCSE" sub="Practice test" subKey="lid.test.eyebrow" unit="questions" />
  </main>

  <script type="application/json" id="lid-data" set:html={JSON.stringify({ questions, meta, bundeslaender })}></script>
  <script type="module">
    import { mountExamApp } from "../../lib/examApp.js";
    import { withBase } from "../../lib/paths.js";
    import { choiceCard, el, sectionHeader, escapeHtml } from "../../lib/exam/renderHelpers.js";
    import { seededShuffle } from "../../lib/seededShuffle.js";
    import { countAnswered, countCorrect, percent } from "../../lib/exam/scoring.js";
    import { recordAttempt } from "../../lib/progress.js";
    import { readyExamI18n, tx } from "../../lib/exam/i18n.js";

    /* Resolved once, before the app mounts — see the note on start-deutsch-1.astro. The
       test holds answers in progress, so its chrome is fixed at load rather than
       re-rendered on a language switch. The questions stay Spanish, the language of the test. */
    await readyExamI18n();
    const t = (key, vars) => tx(key, key, vars);
    const T = (key, de, vars) => tx(key, de, vars);

    const { questions: federal, meta, bundeslaender } = JSON.parse(document.getElementById("lid-data").textContent);
    const LAND_KEY = "da-lid-land";

    function savedLand() {
      try {
        const id = localStorage.getItem(LAND_KEY);
        if (bundeslaender.some((l) => l.id === id)) return id;
      } catch {}
      return bundeslaender[0].id;
    }
    let landId = savedLand();
    const land = () => bundeslaender.find((l) => l.id === landId) ?? bundeslaender[0];

    // Ids are positional and prefixed per part, so a stored answer keeps meaning when a learner
    // switches comunidad and back, and answers on one comunidad never count for another.
    const federalIds = federal.map((_, i) => "bund-" + (i + 1));
    const landIds = () => land().stateQuestions.map((_, i) => "land-" + landId + "-" + (i + 1));

    // Options are lettered and the letter is what gets stored: the text can be a full sentence.
    const LETTERS = "abcdefgh";
    function askAll(main, items, ids, ctx, labelPrefix) {
      items.forEach((q, i) => {
        const id = ids[i];
        main.appendChild(
          choiceCard({
            qLabel: T("exam.qLabel.question", "Question {n}", { n: i + 1 }),
            questionText: q.prompt,
            // Fixed per-question order (the data lists the right answer first). The key stays the
            // option's original letter. Verdadero / Falso keeps its order.
            options: (q.options.length === 2 ? q.options.map((o, n) => ({ key: LETTERS[n], label: o })) : seededShuffle(q.options.map((o, n) => ({ key: LETTERS[n], label: o })), q.prompt)).map((o, pos) => ({ ...o, badge: LETTERS[pos] })),
            correctKey: LETTERS[q.options.indexOf(q.answer)],
            existing: ctx.state.answers[id],
            contentLang: "es",
            why: q.explain,
            onAnswer: (given, correct) => ctx.record(id, given, correct),
            // bund-3 → x:lid/q3, land-galicia-2 → x:lid/galicia/q2 (Tier 0 §2)
            meldung: id.replace(/^bund-(\d+)$/, "x:lid/q$1").replace(/^land-(.+)-(\d+)$/, "x:lid/$1/q$2"),
          })
        );
      });
    }

    const sections = [
      {
        key: "start",
        label: "Start",
        labelKey: "exam.sec.start",
        ids: null,
        render(main, ctx) {
          sectionHeader(main, {
            eyebrow: T("lid.test.eyebrow", "Practice test"),
            title: t("lid.chooseState"),
            instruction: escapeHtml(T("lid.test.startIntro", "The five tasks follow the areas of the real test. The questions on your comunidad are extra practice: the real test has no such part, so they don't count towards your result.")),
          });

          const picker = el("div", "topic-tabs");
          for (const l of bundeslaender) {
            const b = el("button", "topic-tab" + (l.id === landId ? " active" : ""), l.name);
            b.type = "button";
            b.addEventListener("click", () => {
              landId = l.id;
              try { localStorage.setItem(LAND_KEY, landId); } catch {}
              ctx.refresh();
            });
            picker.appendChild(b);
          }
          main.appendChild(picker);

          const l = land();
          main.appendChild(
            el("p", "format-note", l.sourced
              ? escapeHtml(T("lid.test.sourced", "{land}: {n} extra questions written by icanspeak Spanish from public sources.", { land: l.name, n: l.stateQuestions.length }))
              : escapeHtml(T("lid.test.public", "{land}: {n} extra questions written by icanspeak Spanish from well-known public facts.", { land: l.name, n: l.stateQuestions.length })))
          );

          const go = el("button", "quiz-btn quiz-btn--primary", t("exam.startTest"));
          go.type = "button";
          go.addEventListener("click", () => ctx.goTo("t1"));
          main.appendChild(el("div", "exam-actions")).appendChild(go);
        },
      },
      ...meta.tareas.map((tarea) => {
        const items = federal.filter((q) => q.tarea === tarea.n);
        const ids = federalIds.filter((_, i) => federal[i].tarea === tarea.n);
        return {
          key: "t" + tarea.n,
          label: T("lid.sec.task", "Task {n}", { n: tarea.n }),
          ids,
          render(main, ctx) {
            sectionHeader(main, {
              eyebrow: T("lid.sec.task", "Task {n}", { n: tarea.n }),
              title: tarea.title,
              instruction: escapeHtml(T(tarea.options === 2 ? "lid.test.taskIntroTf" : "lid.test.taskIntro", "", { n: items.length, real: tarea.realCount })),
            });
            askAll(main, items, ids, ctx, "Frage");
          },
        };
      }),
      {
        key: "land",
        label: "My comunidad",
        labelKey: "lid.sec.state",
        ids: landIds,
        render(main, ctx) {
          const l = land();
          sectionHeader(main, {
            eyebrow: T("lid.sec.extra", "Extra"),
            title: l.name,
            instruction: escapeHtml(T("lid.test.stateIntro", "{n} extra questions on {land}. They don't count towards your result. A different comunidad? Back to “Start”.", { n: l.stateQuestions.length, land: l.name })),
          });
          askAll(main, l.stateQuestions, landIds(), ctx, "Frage");
        },
      },
      {
        key: "ergebnis",
        label: "Ergebnis",
        labelKey: "exam.sec.result",
        ids: null,
        render(main, ctx) {
          // Only the questions on Spain count: the real test has no part on one comunidad.
          const ids = federalIds;
          const answered = countAnswered(ids, ctx.state);
          const correct = countCorrect(ids, ctx.state);
          const pct = percent(correct, ids.length);
          sectionHeader(main, { eyebrow: T("exam.result.eyebrow", "Evaluation"), title: T("exam.result.title", "Your result") });

          const card = el("div", "exam-result");
          if (!answered) {
            card.appendChild(el("p", "instruction", escapeHtml(T("lid.result.empty", "No question answered yet. Start with Task 1; your result appears here automatically."))));
          } else {
            card.appendChild(el("div", "exam-score", `${correct} <small>${escapeHtml(T("exam.result.ofCorrect", "of {n} correct", { n: ids.length }))}</small>`));
            // This bank is bigger than one sitting, so the comparison is made on the share, and
            // the rule it comes from is printed underneath.
            const passPct = Math.round((meta.passScore / meta.totalQuestions) * 100);
            const band = pct >= passPct ? ["", t("lid.abovePass")] : pct >= passPct - 12 ? ["mid", t("lid.band.near")] : ["low", t("lid.band.low")];
            card.appendChild(el("span", "exam-band " + band[0], band[1]));
            card.appendChild(el("p", "instruction", escapeHtml(T("lid.result.pct", "{pct}% correct on the questions on Spain. The real test asks for {pass} of {t} ({passPct}%); check the current figure with the Instituto Cervantes.", { pct, pass: meta.passScore, t: meta.totalQuestions, passPct }))));

            const table = el("table", "exam-breakdown");
            table.innerHTML =
              "<thead><tr><th>" + escapeHtml(t("format.th.part")) + "</th><th>" + escapeHtml(t("exam.th.correct")) + "</th></tr></thead><tbody>" +
              meta.tareas.map((tarea) => {
                const part = federalIds.filter((_, i) => federal[i].tarea === tarea.n);
                return `<tr><td lang="es">${escapeHtml(tarea.title)}</td><td>${countCorrect(part, ctx.state)} / ${part.length}</td></tr>`;
              }).join("") +
              `<tr><td>${escapeHtml(land().name)} (${escapeHtml(T("lid.sec.extra", "Extra"))})</td><td>${countCorrect(landIds(), ctx.state)} / ${landIds().length}</td></tr>` +
              "</tbody>";
            card.appendChild(table);

            if (answered < ids.length) {
              card.appendChild(el("p", "instruction", escapeHtml(T("exam.result.openQuestions", "Still open: {n} questions.", { n: ids.length - answered }))));
            }
          }
          main.appendChild(card);

          const actions = el("div", "exam-actions");
          const facts = el("a", "quiz-btn", t("lid.toFacts"));
          facts.href = withBase("/life-in-the-uk/facts");
          actions.appendChild(facts);
          main.appendChild(actions);
        },
      },
    ];

    mountExamApp(document.querySelector("[data-exam-root]"), {
      examId: "leben-in-deutschland",
      // traffic-baseline: exam_start / exam_finish
      meta: { exam: "leben-in-deutschland", set: "test", scoreIds: () => federalIds },
      sections,
      unit: "questions",
      unitKey: "exam.unit.questions",
      onAnswer: (ok) => recordAttempt({ skill: "pruefungen", correct: ok }),
    });
  </script>
</Layout>
