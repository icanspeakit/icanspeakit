---
// 404 — the one page nobody meant to open. Bruno (oops) takes the blame so the learner
// doesn't feel they did something wrong, then points three ways out.
// MASKOTTCHEN-PLATZIERUNG-PROMPT.md. With the mascots switched off the page still reads
// as complete: heading, one line, one button, three links.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { mascotSvg } from "../lib/mascots.js";

const bruno = mascotSvg({ name: "bruno", expr: "oops", view: "front", size: 150, label: "" });
---
<Layout title="Page not found – icanspeak Spanish" noindex>
  <SiteNav />
  <main class="nf">
    <div class="nf-fig" data-mascot-part set:html={bruno} />
    <p class="nf-say" data-mascot-part data-i18n="nf.say">Oops! Nothing here.</p>
    <h1 class="nf-title" data-i18n="nf.heading">This page doesn't exist.</h1>
    <p class="nf-lead" data-i18n="nf.lead">Maybe the link is old, or a letter is missing.</p>
    <a class="btn-cta nf-home" href="/" data-i18n="nf.home">To the home page</a>
    <nav class="nf-links" aria-label="Keep learning" data-i18n-attr="aria-label:nf.more">
      <a href="/grammar" data-i18n="nav.subject.grammatik">Grammar</a>
      <a href="/vocabulary" data-i18n="nav.subject.wortschatz">Vocabulary</a>
      <a href="/step-by-step">Step by step</a>
    </nav>
  </main>
</Layout>

<style>
  .nf {
    max-width: 560px;
    margin: 0 auto;
    padding: clamp(40px, 10vh, 96px) 16px 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .nf-fig :global(svg) { width: 150px; height: 150px; }
  .nf-say {
    font-family: var(--font-voice);
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--ink);
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 8px 16px;
    margin: 12px 0 20px;
    box-shadow: var(--shadow-sm);
  }
  .nf-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    margin: 0 0 8px;
  }
  .nf-lead { color: var(--muted); margin: 0 0 24px; }
  .nf-home { margin: 0 0 20px; display: inline-block; }
  .nf-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 20px; }
  .nf-links a { color: var(--brand-blue-dark); font-weight: 600; }
  @media (max-width: 480px) {
    .nf-fig :global(svg) { width: 112px; height: 112px; }
  }
</style>
