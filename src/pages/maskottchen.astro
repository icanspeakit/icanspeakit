---
// /maskottchen — the crew, introduced. Bruno, Regi, Hamsti and Quaki turn up all over the
// site (hub heroes, comics, PDFs, milestones) without ever saying who they are; this page
// is where they do. One card each: the figure, what they help with, where you meet them,
// and their moods — tap a mood and the big figure changes to it.
//
// The crew split: Bruno = Coach (start, progress, Landeskunde) and the teacher area
// (/lehrkraefte: Stundenplan, Unterricht, Live-Quiz) — the only one without a subject, so he
// guides the teacher the way he guides the learner. Regi = Grammatik, Hamsti = Wortschatz,
// Quaki = Sprechen; they stay out of the teacher shell unless a tool is about their skill.
// Bruno's job and about text are translated (mk.bruno.*); the rest of the page is German.
//
// Linked from the home page footer ("Mehr"). The texts are easy German on purpose (A2):
// the learners who meet the mascots first are beginners.
//
// "Maskottchen anzeigen: aus" (html[data-mascots="off"]) hides mascots everywhere else.
// Here they ARE the content, so this page shows them anyway and says where the switch is.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { mascotSvg, MASCOT_LABELS } from "../lib/mascots.js";
import "../styles/practice.css";

type Name = "bruno" | "regi" | "hamsti" | "quaki";
const EXPRS = [
  ["happy", "froh"],
  ["thinking", "denkt"],
  ["celebrate", "jubelt"],
  ["oops", "hoppla"],
  ["sleepy", "müde"],
] as const;

type Place = { href: string; label: string; key?: string };
const crew: { name: Name; tier: string; job: string; jobKey?: string; color: string; about: string; aboutKey?: string; say: string; places: Place[] }[] = [
  {
    name: "bruno", tier: "Dackel", job: "Dein Coach – auch für Lehrkräfte", jobKey: "mk.bruno.job", color: "#f97316",
    about: "Bruno ist immer dabei. Er zeigt dir, wo du anfängst, freut sich über jeden Fortschritt und erklärt dir, wie Deutschland funktioniert: Pfand, Feiertage, Ämter. Und wenn du unterrichtest, hilft er dir auch: beim Stundenplan, im Unterricht und beim Quiz.",
    aboutKey: "mk.bruno.about",
    say: "Schön, dass du da bist!",
    places: [
      { href: "/kultur", label: "Landeskunde" },
      { href: "/einstufungstest", label: "Einstufungstest" },
      { href: "/fortschritt", label: "Dein Fortschritt" },
      { href: "/lehrkraefte", label: "Für Lehrkräfte", key: "nav.subject.lehrkraefte" },
    ],
  },
  {
    name: "regi", tier: "Igel", job: "Grammatik", color: "#0d9488",
    about: "Regi mag Ordnung: Regeln, Tabellen, Endungen. Stachelig wird er nur, wenn ein Artikel falsch ist — und dann erklärt er dir geduldig, warum.",
    say: "Regel für Regel.",
    places: [
      { href: "/grammatik", label: "Grammatik" },
      { href: "/artikel", label: "der, die, das" },
      { href: "/grammatik/wortarten", label: "Wortarten" },
    ],
  },
  {
    name: "hamsti", tier: "Hamster", job: "Wortschatz", color: "#f2a900",
    about: "Hamsti sammelt Wörter, so wie andere Hamster Nüsse sammeln. Jeden Tag ein paar neue in die Backen — und nach ein paar Wochen ist der Vorrat groß.",
    say: "Was übst du heute?",
    places: [
      { href: "/wortschatz", label: "Wortschatz" },
      { href: "/hoeren", label: "Hören" },
      { href: "/uebungen", label: "Übungen" },
    ],
  },
  {
    name: "quaki", tier: "Frosch", job: "Sprechen", color: "#2563eb",
    about: "Quaki quakt gern — und zwar auf Deutsch. Er hilft dir beim Sprechen und bei der Aussprache. Fehler? Kein Problem. Hauptsache, du sprichst.",
    say: "Sprich einfach los!",
    places: [
      { href: "/sprechen", label: "Sprechen" },
      { href: "/aussprache", label: "Aussprache" },
      { href: "/aussprache-check", label: "Aussprache-Check" },
    ],
  },
];

const big = (name: Name, expr = "happy") => mascotSvg({ name, expr, view: "front", size: 150, label: "" });
const small = (name: Name, expr: string) => mascotSvg({ name, expr, view: "front", size: 44, label: "" });
---
<Layout
  title="Die Maskottchen – EnglishAcademy"
  description="Bruno, Regi, Hamsti und Quaki: wer sie sind, wobei sie dir helfen und wo du sie auf EnglishAcademy triffst."
>
  <SiteNav />
  <main class="practice-main practice-main--wide mk-page">
    <header class="practice-hero mk-hero">
      <p class="eyebrow">Das sind wir</p>
      <h1>Die Maskottchen</h1>
      <p class="mk-lead">Vier Freunde begleiten dich beim Deutschlernen. Jeder kennt sich mit einer Sache besonders gut aus.</p>
      <div class="mk-crew" aria-hidden="true">
        {crew.map((m, i) => (
          <a href={`#${m.name}`} class="mk-crew-fig" style={`--d:${i * 90}ms`} tabindex="-1">
            <Fragment set:html={mascotSvg({ name: m.name, expr: i === 0 ? "celebrate" : "happy", view: "three", size: 76, label: "" })} />
          </a>
        ))}
      </div>
    </header>

    <div class="mk-grid">
      {crew.map((m) => (
        <article class="mk-card" id={m.name} style={`--mk:${m.color}`} data-mk={m.name}>
          <div class="mk-stage">
            <div class="mk-big" data-mk-big><Fragment set:html={big(m.name)} /></div>
            <p class="mk-say">„{m.say}“</p>
          </div>
          <div class="mk-body">
            <p class="mk-job" data-i18n={m.jobKey}>{m.job}</p>
            <h2>{MASCOT_LABELS[m.name]}</h2>
            <p class="mk-about" data-i18n={m.aboutKey}>{m.about}</p>

            <h3>Seine Stimmungen – tipp eine an</h3>
            <div class="mk-moods" role="group" aria-label={`Stimmungen von ${m.name}`}>
              {EXPRS.map(([expr, label]) => (
                <button type="button" class:list={["mk-mood", expr === "happy" && "is-on"]} data-expr={expr} aria-pressed={expr === "happy" ? "true" : "false"}>
                  <Fragment set:html={small(m.name, expr)} />
                  <span>{label}</span>
                </button>
              ))}
            </div>

            <h3>Hier triffst du ihn</h3>
            <div class="mk-places">
              {m.places.map((p) => <a href={p.href} data-i18n={p.key}>{p.label}</a>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="mk-note">
      Tipp: Auf vielen Seiten kannst du das Maskottchen oben antippen — dann erklärt es dir die Seite.
      Lieber ohne Maskottchen? Du kannst sie unter <a href="/konto">Konto → Einstellungen</a> ausblenden.
    </p>
    <p class="mk-note">Die Crew auf Shirt, Tasse oder Cap? Schau beim <a href="/merch">Merch</a> vorbei und markiere, was du willst.</p>
  </main>

  <script>
    // A mood button swaps the big figure for that mood. The drawings are the small ones'
    // own SVG, scaled up — no second copy of the art in the page.
    for (const card of document.querySelectorAll<HTMLElement>(".mk-card")) {
      const stage = card.querySelector<HTMLElement>("[data-mk-big]");
      const buttons = [...card.querySelectorAll<HTMLButtonElement>(".mk-mood")];
      for (const b of buttons) {
        b.addEventListener("click", () => {
          const svg = b.querySelector("svg");
          if (!stage || !svg) return;
          const copy = svg.cloneNode(true) as SVGElement;
          copy.setAttribute("width", "150");
          copy.setAttribute("height", "150");
          stage.replaceChildren(copy);
          stage.classList.remove("is-pop");
          void stage.offsetWidth;
          stage.classList.add("is-pop");
          for (const o of buttons) {
            o.classList.toggle("is-on", o === b);
            o.setAttribute("aria-pressed", String(o === b));
          }
        });
      }
    }
  </script>

  <style>
    /* This page is about the mascots: the global "off" switch does not hide them here. */
    :global(html[data-mascots="off"]) .mk-page :global(.mascot) { display: block !important; }

    .mk-hero { text-align: center; }
    .mk-lead { max-width: 34rem; margin: 0 auto; color: var(--muted); font-size: 1.05rem; }
    .mk-crew { display: flex; justify-content: center; gap: clamp(2px, 3vw, 28px); margin: 22px auto 4px; }
    .mk-crew-fig { display: block; animation: mk-in .5s cubic-bezier(.2, .8, .2, 1) both; animation-delay: var(--d); }
    .mk-crew-fig:hover { transform: translateY(-4px) rotate(-3deg); transition: transform .2s ease; }
    @keyframes mk-in { from { opacity: 0; transform: translateY(14px) scale(.9); } to { opacity: 1; transform: none; } }

    .mk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 18px; margin-top: 28px; }
    .mk-card {
      display: grid; grid-template-columns: 170px 1fr; gap: 18px;
      padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-lg);
      background: var(--surface-card); box-shadow: var(--shadow-sm);
      border-top: 5px solid var(--mk);
      scroll-margin-top: 90px;
    }
    .mk-stage {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      border-radius: var(--radius); padding: 12px 6px;
      background: color-mix(in srgb, var(--mk) 10%, transparent);
    }
    .mk-big { min-height: 150px; display: grid; place-items: center; }
    .mk-big.is-pop { animation: mk-pop .35s cubic-bezier(.2, .9, .3, 1.4); }
    @keyframes mk-pop { from { transform: scale(.85); } to { transform: none; } }
    .mk-say { margin: 0; font-family: var(--font-voice); font-weight: 600; text-align: center; color: var(--ink); font-size: .95rem; }
    .mk-job { margin: 0; font-size: .78rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: color-mix(in srgb, var(--mk) 75%, var(--ink)); }
    .mk-body h2 { margin: 2px 0 8px; font-size: 1.35rem; }
    .mk-body h2, .mk-body h3, .mk-body p { text-align: left; }
    .mk-body h3 { margin: 16px 0 8px; font-size: .9rem; color: var(--muted); font-weight: 600; }
    .mk-about { margin: 0; line-height: 1.55; }

    .mk-moods { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; max-width: 360px; }
    .mk-mood {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      padding: 6px 2px 5px; min-width: 0;
      border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface);
      font: inherit; font-size: .72rem; color: var(--muted); cursor: pointer;
      transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }
    .mk-mood:hover { transform: translateY(-2px); border-color: var(--mk); }
    .mk-mood.is-on { border-color: var(--mk); background: color-mix(in srgb, var(--mk) 14%, transparent); color: var(--ink); font-weight: 600; }
    .mk-mood:focus-visible { outline: 2px solid var(--mk); outline-offset: 2px; }

    .mk-places { display: flex; flex-wrap: wrap; gap: 8px; }
    .mk-places a {
      padding: 7px 14px; border-radius: var(--radius-pill); text-decoration: none; font-weight: 600; font-size: .9rem;
      color: var(--ink); border: 1px solid color-mix(in srgb, var(--mk) 45%, var(--border));
    }
    .mk-places a:hover { background: color-mix(in srgb, var(--mk) 12%, transparent); }

    .mk-note { max-width: 40rem; margin: 30px auto 10px; text-align: center; color: var(--muted); font-size: .92rem; line-height: 1.55; }

    @media (max-width: 560px) {
      .mk-card { grid-template-columns: 1fr; padding: 16px; }
      .mk-stage { flex-direction: row; justify-content: center; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mk-crew-fig, .mk-big.is-pop { animation: none; }
    }
  </style>
</Layout>
