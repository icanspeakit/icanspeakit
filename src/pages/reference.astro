---
// /reference — the overview behind the Wissen menu's „Nachschlagewerk“ label and its
// green „Alles nachschlagen“ box, the way /culture stands behind „Alle Themen“. The pages are
// the menu's own list (navNachschlagen in catalog.js), so menu, drawer and this page never
// disagree.
//
// The page says what a Nachschlagewerk is and why it is worth knowing where the answers
// are: Regi hops in with the why, each card names a question it answers, and a short
// "Practise or look it up?" separates this shelf from the grammar topics. The explaining
// text follows the UI language. The search index (/suche.json) is still German data.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import Icon from "../components/Icon.astro";
import ShareButton from "../components/ShareButton.astro";
import { navNachschlagen } from "../lib/catalog.js";
import { mascotSvg } from "../lib/mascots.js";
import "../styles/practice.css";

// The question each page answers, as a learner would ask it.
const QUESTION: Record<string, { text: string }> = {
  "/grammar/verbs": { text: "“I have went” or “I have gone”?" },
  "/grammar/irregular-verbs": { text: "“he swimmed” or “he swam”?" },
  "/grammar/phrasal-verbs-list": { text: "“Turn off it” or “Turn it off”?" },
  "/grammar/verbs-with-prepositions": { text: "“wait for” or “wait to”?" },
  "/grammar/parts-of-speech": { text: "Is “fast” an adjective or an adverb?" },
  "/grammar/common-mistakes": { text: "“their” or “there”?" },
};
const regi = mascotSvg({ name: "regi", expr: "happy", view: "three", size: 96, label: "", className: "nsw-regi-fig" });
---
<Layout
  title="Reference: verb tables, verbs and parts of speech – EnglishAcademy"
  description="English grammar to look up: verb tables with the present, past simple and past participle, irregular verbs, phrasal verbs, verbs with prepositions and parts of speech."
  breadcrumb={[{ name: "Knowledge", path: "/knowledge" }]}
>
  <SiteNav active="wissen" />
  <main class="practice-main nsw-page">
    <div class="practice-hero">
      <p class="eyebrow" data-i18n="nav.wissen.nachschlagen">Nachschlagewerk</p>
      <h1 data-i18n="nsw.h1">Zum Nachschlagen</h1>
      <p data-i18n="nsw.lead">Tabellen und Listen, in denen du schnell etwas findest: die Formen eines Verbs, seine Präposition, die Wortart.</p>
      <div class="nsw-share"><ShareButton label size="sm" /></div>
    </div>

    {/* One box for every page below: a verb or one of its forms, a noun, "warten auf", a word
        class, "das dass". The rows come from /suche.json (the nav search's index, fetched on
        first use) and open on the entry itself. */}
    <form class="nsw-search" role="search" id="nsw-form">
      <label for="nsw-q" class="nsw-search-label" data-i18n="nsw.search.label">Was suchst du?</label>
      <input id="nsw-q" type="search" autocomplete="off" autocapitalize="off" spellcheck="false"
        placeholder="e.g. went, cake, wait for, their" data-i18n-attr="placeholder:nsw.search.placeholder" aria-controls="nsw-results" />
      <ul class="nsw-results" id="nsw-results" aria-live="polite"></ul>
      <p class="nsw-none" id="nsw-none" hidden data-i18n="nsw.search.none">Nichts gefunden. Versuch es mit der Grundform: gehen statt ging, Kuchen statt Kuchens.</p>
    </form>

    {/* Regi hops in and says why. With the mascots off the figure goes (data-mascot-part)
        and the words stay, as a plain note. */}
    <section class="nsw-regi" aria-labelledby="nsw-why">
      <div class="nsw-regi-jump" data-mascot-part><Fragment set:html={regi} /></div>
      <div class="nsw-bubble">
        <h2 id="nsw-why" data-i18n="nsw.why.title">Warum nachschlagen?</h2>
        <p data-i18n="nsw.why.p1">Niemand lernt alle Formen auswendig – auch Deutsche schauen nach. Wer weiß, wo die Antwort steht, schreibt sicherer und muss nicht raten.</p>
        <p data-i18n="nsw.why.p2">Und das Beste: Jedes Mal, wenn du etwas nachschlägst, bleibt es ein bisschen besser hängen. So lernst du nebenbei.</p>
      </div>
    </section>

    <h2 class="nsw-h2" data-i18n="nsw.list.title">Was findest du hier?</h2>
    <ul class="nsw-grid">
      {navNachschlagen.items.map((item) => (
        <li>
          <a class="nsw-card" href={item.href}>
            <span class="nsw-ic"><Icon name={navNachschlagen.icon} size={20} /></span>
            <span class="nsw-txt">
              <b data-i18n={item.titleKey}>{item.title}</b>
              <i data-i18n={item.hintKey}>{item.hint}</i>
              {QUESTION[item.href] && <span class="nsw-q">{QUESTION[item.href].text}</span>}
            </span>
            <span class="nsw-chev" aria-hidden="true"><Icon name="chevron-right" size={18} /></span>
          </a>
        </li>
      ))}
    </ul>

    <h2 class="nsw-h2" data-i18n="nsw.what.title">Was ist ein Nachschlagewerk?</h2>
    <p class="nsw-p" data-i18n="nsw.what.p">Ein Nachschlagewerk liest man nicht von vorne bis hinten. Man öffnet es, wenn man eine Frage hat – und findet die Antwort in Sekunden: als Tabelle, mit Regel und Beispielsatz.</p>

    <div class="nsw-two">
      <div class="nsw-box">
        <h3 data-i18n="nsw.ueben.title">Üben</h3>
        <p data-i18n="nsw.ueben.p">Du lernst ein Thema Schritt für Schritt: Regel, Aufgaben, Feedback.</p>
        <a href="/grammar" data-i18n="nsw.ueben.link">Zu den Grammatik-Themen</a>
      </div>
      <div class="nsw-box nsw-box--here">
        <h3 data-i18n="nsw.nach.title">Nachschlagen</h3>
        <p data-i18n="nsw.nach.p">Du hast eine konkrete Frage – bei den Hausaufgaben, in einer E-Mail, kurz vor der Prüfung. Nachsehen, weiterschreiben.</p>
      </div>
    </div>

    <h2 class="nsw-h2" data-i18n="nsw.tips.title">So hilft es dir</h2>
    <ol class="nsw-tips">
      <li><b data-i18n="nsw.tip1.t">Beim Schreiben</b> <span data-i18n="nsw.tip1.p">Unsicher bei einer Form? Nachsehen statt raten.</span></li>
      <li><b data-i18n="nsw.tip2.t">Beim Lesen</b> <span data-i18n="nsw.tip2.p">Ein Wort wie „ging“ oder „gesprungen“? In den Verbtabellen findest du den Infinitiv.</span></li>
      <li><b data-i18n="nsw.tip3.t">Vor der Prüfung</b> <span data-i18n="nsw.tip3.p">Starke Verben und Verben mit Präpositionen kommen in jeder Prüfung. Die Listen einmal durchgehen lohnt sich.</span></li>
      <li><b data-i18n="nsw.tip4.t">Im Unterricht</b> <span data-i18n="nsw.tip4.p">Jede Seite lässt sich drucken, teilen und als Live-Quiz mit der ganzen Klasse spielen.</span></li>
    </ol>
  </main>
</Layout>

<script>
  // Kinds of row and their label; the same names as the cards below.
  const KIND: Record<string, string> = {
    verb: "Verb table", nomen: "Noun forms", stark: "Irregular and regular verbs",
    trennbar: "Phrasal verbs", praep: "Verbs with prepositions", wortart: "Parts of speech", fehler: "Common mistakes",
  };
  type Row = { label: string; sub: string; href: string; kind: string; n: string; keys: Set<string> };
  const norm = (s: string) => String(s).toLowerCase().replace(/ß/g, "ss").normalize("NFD").replace(/[̀-ͯ]/g, "")
    .replace(/[^\p{L}\p{N}\s-]/gu, " ").replace(/\s+/g, " ").trim();
  const esc = (s: string) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

  const q = document.getElementById("nsw-q") as HTMLInputElement;
  const list = document.getElementById("nsw-results")!;
  const none = document.getElementById("nsw-none")!;
  let rows: Row[] | null = null;
  let loading: Promise<void> | null = null;

  const load = () => (loading ??= fetch("/suche.json").then((r) => r.json()).then((ix) => {
    const out: Row[] = [];
    for (const [inf, preview, href, forms] of ix.verbs ?? [])
      out.push({ label: inf, sub: preview, href, kind: "verb", n: norm(inf),
        keys: new Set(String(forms).split("|").flatMap((f: string) => [norm(f), ...norm(f).split(" ")])) });
    for (const [label, sub, href, kind] of ix.refs ?? [])
      // A strong or separable verb is also found by its forms ("schwamm", "rief an").
      out.push({ label, sub, href, kind, n: norm(label),
        keys: new Set(kind === "stark" || kind === "trennbar" ? norm(sub).split(" ").filter((w) => w.length > 2) : []) });
    rows = out;
  }).catch(() => { loading = null; }));

  function score(r: Row, t: string, tokens: string[]): number {
    const n = r.n;
    if (n === t) return 100;
    if (r.keys.has(t)) return 95;
    if (n.startsWith(t)) return 80 - Math.min(20, n.length - t.length);
    if (t.length >= 3 && tokens.every((w) => n.split(" ").some((x) => x.startsWith(w)))) return 60;
    if (t.length >= 4 && n.includes(t)) return 40;
    return 0;
  }

  function render() {
    const t = norm(q.value).replace(/^(der|die|das) (?=\S)/, "");
    if (t.length < 2 || !rows) { list.innerHTML = ""; none.hidden = true; return; }
    const tokens = t.split(" ");
    const hits = rows.map((r) => [score(r, t, tokens), r] as const).filter(([s]) => s > 0)
      .sort((a, b) => b[0] - a[0]).slice(0, 12);
    list.innerHTML = hits.map(([, r]) => `<li><a href="${esc(r.href)}">
      <span class="nsw-r-main"><b lang="de">${esc(r.label)}</b>${r.sub ? `<small lang="de">${esc(r.sub)}</small>` : ""}</span>
      <span class="nsw-r-kind">${esc(KIND[r.kind] ?? "")}</span></a></li>`).join("");
    none.hidden = hits.length > 0;
  }

  q.addEventListener("focus", () => { load(); }, { once: true });
  q.addEventListener("input", () => { if (rows) render(); else load()?.then(render); });
  document.getElementById("nsw-form")!.addEventListener("submit", (e) => {
    e.preventDefault();
    list.querySelector("a")?.click();
  });
</script>

<style>
  .nsw-page { padding-bottom: 56px; }

  .nsw-search { max-width: 640px; margin: 24px auto 0; text-align: left; }
  .nsw-search-label { display: block; margin-bottom: 6px; font-weight: var(--fw-semibold); }
  .nsw-search input {
    width: 100%; padding: 12px 14px; font: inherit; font-size: 1.0625rem;
    border: 1px solid var(--border-strong); border-radius: var(--radius); background: var(--surface-card); color: var(--ink);
  }
  .nsw-search input:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 1px; }
  .nsw-results { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 4px; }
  .nsw-results:empty { display: none; }
  .nsw-results a {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface-card); color: var(--ink); text-decoration: none;
  }
  .nsw-results a:hover, .nsw-results a:focus-visible { border-color: var(--blue-200); background: var(--blue-50); }
  .nsw-r-main { flex: 1; min-width: 0; }
  .nsw-r-main b { display: block; font-weight: var(--fw-semibold); }
  .nsw-r-main small { display: block; color: var(--muted); font-size: .8125rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nsw-r-kind {
    flex: none; max-width: 42%; padding: 2px 9px; border-radius: var(--radius-pill); background: var(--blue-50);
    color: var(--brand-blue-dark); font-size: .75rem; font-weight: var(--fw-semibold); text-align: center;
  }
  .nsw-none { margin: 8px 0 0; color: var(--muted); }
  .nsw-share { display: flex; justify-content: center; margin-top: 10px; }

  /* Regi and the why */
  .nsw-regi { display: flex; align-items: flex-end; gap: 14px; max-width: 760px; margin: 28px auto 8px; }
  .nsw-regi-jump { flex: none; animation: nsw-hop .9s cubic-bezier(.3, 1.5, .5, 1) .15s both; transform-origin: 50% 100%; }
  .nsw-bubble {
    position: relative; flex: 1; padding: 16px 18px; border-radius: 16px;
    border: 1px solid var(--blue-200); background: var(--blue-50);
    animation: nsw-pop .4s ease-out .75s both;
  }
  .nsw-bubble::before {
    content: ""; position: absolute; left: -8px; bottom: 22px; width: 14px; height: 14px;
    background: var(--blue-50); border-left: 1px solid var(--blue-200); border-bottom: 1px solid var(--blue-200);
    transform: rotate(45deg);
  }
  .nsw-bubble h2 { margin: 0 0 6px; font-size: 1.125rem; color: var(--brand-blue); }
  .nsw-bubble p { margin: 0; line-height: 1.55; }
  .nsw-bubble p + p { margin-top: 8px; }
  @keyframes nsw-hop {
    0% { transform: translateY(70px) scale(.6); opacity: 0; }
    45% { transform: translateY(-18px) scale(1.05); opacity: 1; }
    65% { transform: translateY(0) scale(.97, 1.03); }
    80% { transform: translateY(-6px); }
    100% { transform: none; }
  }
  @keyframes nsw-pop { from { transform: scale(.92) translateX(-8px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .nsw-regi-jump, .nsw-bubble { animation: none; } }
  @media (max-width: 560px) {
    .nsw-regi { flex-direction: column; align-items: flex-start; gap: 6px; }
    .nsw-bubble::before { left: 30px; bottom: auto; top: -8px; transform: rotate(135deg); }
  }

  .nsw-h2 { margin: 40px 0 12px; font-size: 1.25rem; }
  .nsw-p { max-width: 70ch; line-height: 1.6; }

  .nsw-grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .nsw-card {
    display: flex; align-items: center; gap: 14px; height: 100%;
    padding: 16px; border-radius: 14px;
    border: 1px solid var(--border); background: var(--surface-card);
    color: var(--ink); text-decoration: none;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .nsw-card:hover { border-color: var(--blue-200); background: var(--blue-50); }
  .nsw-card:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .nsw-ic {
    flex: none; display: grid; place-items: center; width: 40px; height: 40px;
    border-radius: 10px; background: var(--blue-50); color: var(--brand-blue);
  }
  .nsw-txt { flex: 1; min-width: 0; }
  .nsw-txt b { display: block; font-size: 1rem; font-weight: var(--fw-semibold); line-height: 1.3; }
  .nsw-txt i { display: block; margin-top: 2px; font-size: .875rem; font-style: normal; color: var(--muted); }
  .nsw-q {
    display: inline-block; margin-top: 8px; padding: 3px 9px; border-radius: 999px;
    background: var(--surface-sunken, rgba(0, 0, 0, .05)); font-size: .8125rem; font-style: italic;
  }
  .nsw-chev { flex: none; color: var(--muted); }
  .nsw-card:hover .nsw-chev { color: var(--brand-blue); }

  .nsw-two { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 16px; }
  .nsw-box { padding: 16px 18px; border-radius: 14px; border: 1px solid var(--border); background: var(--surface-card); }
  .nsw-box--here { border-color: var(--blue-200); background: var(--blue-50); }
  .nsw-two, .nsw-tips, .nsw-grid, .nsw-p { text-align: left; }
  .nsw-box h3 { margin: 0 0 6px; font-size: 1rem; font-weight: var(--fw-semibold); }
  .nsw-box p { margin: 0; line-height: 1.55; }
  .nsw-box a { display: inline-block; margin-top: 10px; font-weight: var(--fw-semibold); color: var(--brand-blue); }

  .nsw-tips { margin: 0; padding: 0; list-style: none; counter-reset: tip; display: grid; gap: 10px; }
  .nsw-tips li {
    counter-increment: tip; position: relative; padding: 12px 14px 12px 50px;
    border-radius: 12px; border: 1px solid var(--border); background: var(--surface-card); line-height: 1.5;
  }
  .nsw-tips li::before {
    content: counter(tip); position: absolute; left: 14px; top: 12px;
    display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%;
    background: var(--brand-blue); color: #fff; font-size: .8125rem; font-weight: 700;
  }
  .nsw-tips b { display: block; }
</style>
