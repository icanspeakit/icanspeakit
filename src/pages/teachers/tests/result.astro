---
// /teachers/tests/result?id=… — one test (Einstufungstest or Thementest): the QR code for the projector and the
// results as they come in (read again every few seconds while the tab is visible). Per
// student: name, score and a cell per topic; a tap opens their answers. Per question: how
// many got it right and the most common wrong answer. Above it: the topics the class is
// weakest in, with their page, worksheet and live quiz.
//
// The topics' links are settled here at build time and travel to the script as JSON.
// Static; the test is read in the browser (RLS: the owner only).
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import { grammarTopics } from "../../../lib/catalog.js";
import { sheetTopics, topicSlug } from "../../../lib/arbeitsblatt/grammatik.js";
import { hasChapter } from "../../../lib/liveQuiz/chapters.js";
import "../../../styles/live-quiz.css";
import "../../../styles/quiz-builder.css";
import "../../../styles/klassen.css";
import "../../../styles/umfrage.css";
import "../../../styles/klassentest.css";

const links = Object.fromEntries(
  grammarTopics.map((tp) => {
    const sheet = sheetTopics.find((s) => s.id === tp.id);
    return [tp.id, {
      page: tp.href,
      sheet: sheet ? `/teachers/worksheets/grammar/${topicSlug(sheet)}` : null,
      quiz: hasChapter(`g-${tp.id}`) ? `/teachers/quiz?grammar=g-${tp.id}` : null,
    }];
  }),
);
---
<Layout
  title="Test – results – EnglishAcademy"
  description="The results of your test, live, with a QR code for the projector."
  noindex
>
  <SiteNav active="lehrkraefte" />

  <main class="lq kl uf uf-res kt kt-res" id="kt-res" data-links={JSON.stringify(links)}>
    <a class="qb-back" href="/teachers/tests" data-i18n="kt.t.backList">Alle Tests</a>

    <section class="lq-card" data-gate="loading">
      <p data-i18n="kl.loading">Einen Moment …</p>
    </section>
    <section class="lq-card kl-stack" data-gate="signin" hidden>
      <h2 data-i18n="kt.t.signin.title">Melde dich an, um einen Test zu erstellen</h2>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/teachers/tests" data-i18n="kl.t.signin.button">Anmelden oder registrieren</a>
    </section>
    <section class="lq-card kl-stack" data-gate="missing" hidden>
      <h2 data-i18n="kt.t.missing.title">Diesen Test gibt es nicht</h2>
      <p data-i18n="kt.t.missing.text">Vielleicht wurde er gelöscht, oder er gehört zu einem anderen Konto.</p>
      <a class="lq-btn lq-btn--primary" href="/teachers/tests" data-i18n="kt.t.backList">Alle Tests</a>
    </section>

    <div class="kl-stack" data-gate="ok" hidden>
      <header class="uf-res-head">
        <p class="lq-eyebrow" data-eyebrow lang="en">For teachers · Test</p>
        <h1 class="lq-title" data-title></h1>
        <p class="uf-res-meta">
          <span class="kl-badge" data-level hidden></span>
          <span class="uf-state" data-state></span>
          <strong class="uf-total" data-total aria-live="polite"></strong>
        </p>
      </header>

      <section class="lq-card uf-share" data-share>
        <div class="uf-share-qr" data-qr role="img" aria-label="QR-Code zum Test" data-i18n-attr="aria-label:kt.t.qrAlt"></div>
        <div class="uf-share-text">
          <p class="uf-share-step" data-i18n="uf.t.share.step">Handy-Kamera auf den QR-Code richten, oder öffnen:</p>
          <p class="uf-share-url" data-host></p>
          <p class="uf-share-step" data-i18n="uf.t.share.code">und diesen Code eingeben:</p>
          <p class="uf-share-code" data-code></p>
          <p class="uf-share-anon" data-i18n="kt.t.share.note">Mit Namen · ohne Konto</p>
          <div class="kl-row">
            <button type="button" class="lq-btn lq-btn--ghost" data-copy data-i18n="kl.t.copy">Link kopieren</button>
            <button type="button" class="lq-btn lq-btn--ghost" data-big data-i18n="uf.t.big">Groß für den Beamer</button>
          </div>
        </div>
      </section>

      <div class="kl-row uf-tools">
        <button type="button" class="lq-btn lq-btn--ghost" data-share-toggle></button>
        <button type="button" class="lq-btn lq-btn--ghost" data-toggle></button>
        <button type="button" class="lq-btn lq-btn--quiet" data-csv data-i18n="uf.t.csv">Als Tabelle (CSV)</button>
        <button type="button" class="lq-btn lq-btn--quiet" data-print data-i18n="uf.t.print">Drucken</button>
      </div>
      <p class="kl-status" data-status role="status" aria-live="polite"></p>

      <p class="kl-muted" data-empty hidden data-i18n="kt.t.empty">Noch keine Ergebnisse. Sobald jemand abgibt, erscheint es hier, ohne Neuladen.</p>

      <div class="kt-summary" data-summary hidden></div>

      <section class="uf-next" data-next hidden aria-labelledby="kt-next-h">
        <h2 id="kt-next-h" data-i18n="kt.t.next.title">Das sollte die Klasse noch üben</h2>
        <div class="uf-next-grid" data-next-list></div>
      </section>

      <section data-students hidden aria-labelledby="kt-st-h">
        <h2 id="kt-st-h" class="kt-h" data-i18n="kt.t.students">Ergebnisse pro Person</h2>
        <p class="kl-muted kt-legend-note" data-students-hint data-i18n="kt.t.students.hint">Tippe auf einen Namen, um die Antworten zu sehen. Die Zahlen in den Spalten: Prozent richtig im Thema.</p>
        <div class="kld-scroll" data-students-table></div>
        <div data-student-detail></div>
      </section>

      <section data-questions hidden aria-labelledby="kt-q-h">
        <h2 id="kt-q-h" class="kt-h" data-i18n="kt.t.questions">Ergebnisse pro Frage</h2>
        <p class="kl-muted" data-i18n="kt.t.questions.hint">Die schwersten zuerst.</p>
        <ol class="kt-qlist" data-questions-list></ol>
      </section>
    </div>
    <div class="uf-beamer" data-beamer hidden>
      <button type="button" class="uf-beamer-close" data-beamer-close aria-label="Schließen" data-i18n-attr="aria-label:uf.t.beamerClose">✕</button>
      <div class="uf-beamer-qr" data-beamer-qr></div>
      <div class="uf-beamer-text">
        <p class="uf-beamer-title" data-beamer-title></p>
        <p class="uf-beamer-url" data-beamer-host></p>
        <p class="uf-beamer-code" data-beamer-code></p>
        <p class="uf-beamer-count" data-beamer-count aria-live="polite"></p>
      </div>
    </div>
  </main>

  <script>
    import { mountErgebnis } from "../../../lib/klassentest/ergebnis.js";
    const root = document.getElementById("kt-res");
    if (root) mountErgebnis(root);
  </script>
</Layout>
