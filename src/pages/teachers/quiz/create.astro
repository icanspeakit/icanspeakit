---
// Eigenes Quiz: a teacher puts a live quiz together for one chapter — ticks ready-made
// questions from a grammar topic or a Lernset, adds their own, saves it to their account,
// and starts it on /teachers/quiz?quiz=<id>, where the class joins by QR code as usual.
//
// Static like the rest of the section; who is signed in, and whether they teach, is
// settled in the browser (src/lib/liveQuiz/builder.js). The chapter list is in the markup;
// each chapter's questions come from /teachers/quiz-chapters/<slug>.json.
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import MascotEmpty from "../../../components/mascots/MascotEmpty.astro";
import { chapterList } from "../../../lib/liveQuiz/chapters.js";
import "../../../styles/live-quiz.css";
import "../../../styles/quiz-builder.css";

const chapters = chapterList();
const LEVELS = ["A1", "A2", "B1", "B2", "C1"];
const groups = [
  ...LEVELS.map((level) => ({ label: `Grammar ${level}`, key: "qb.group.grammar", kind: "grammatik", level, items: chapters.filter((c) => c.kind === "grammatik" && c.level === level) })),
  ...LEVELS.map((level) => ({ label: `Vocabulary ${level}`, key: "qb.group.words", kind: "wortschatz", level, items: chapters.filter((c) => c.kind === "wortschatz" && c.level === level) })),
].filter((g) => g.items.length);
---
<Layout
  title="Build your own quiz – EnglishAcademy"
  description="Put together a live quiz for a grammar topic or a word set: pick ready-made questions, add your own, save it and play it with your class via a QR code."
>
  <SiteNav active="lehrkraefte" />

  <main class="lq qb" id="qb-root">
    <a class="qb-back" href="/teachers/quiz" data-i18n="qb.back">Zum Live-Quiz</a>
    <header class="lq-head">
      <p class="lq-eyebrow" data-i18n="qb.eyebrow">Für Lehrkräfte · Eigenes Quiz</p>
      <h1 class="lq-title" data-i18n="qb.title">Quiz für ein Kapitel zusammenstellen</h1>
      <p class="lq-lead" data-i18n="qb.lead">Wähl ein Grammatikthema oder ein Lernset, kreuz die Fragen an, die du willst, und ergänze eigene. Gespeichert wird in deinem Konto — im Unterricht startest du das Quiz mit einem Klick, die Klasse scannt den QR-Code.</p>
    </header>

    {/* Who may build: decided in the browser. One of these four is shown. */}
    <section class="lq-card qb-gate" data-gate="loading">
      <p data-i18n="qb.loading">Einen Moment …</p>
    </section>
    <section class="lq-card qb-gate" data-gate="signin" hidden>
      <h2 data-i18n="qb.signin.title">Melde dich an, um Quizze zu speichern</h2>
      <p data-i18n="qb.signin.text">Deine Quizze liegen in deinem Konto, damit du sie auf jedem Gerät wiederfindest — zu Hause vorbereiten, im Kursraum starten. Das Konto ist kostenlos.</p>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/teachers/quiz/create" data-i18n="qb.signin.button">Anmelden oder registrieren</a>
    </section>
    <section class="lq-card qb-gate" data-gate="teacher" hidden>
      <h2 data-i18n="qb.teacher.title">Unterrichtest du Deutsch?</h2>
      <p data-i18n="qb.teacher.text">Dann schalte die Werkzeuge für Lehrkräfte frei: eigene Live-Quizze erstellen und speichern. Du kannst das jederzeit in deinem Konto unter Einstellungen wieder ausschalten.</p>
      <button type="button" class="lq-btn lq-btn--primary" data-teacher-on data-i18n="qb.teacher.button">Ja, ich unterrichte</button>
      <p class="lq-error" data-teacher-error role="alert"></p>
    </section>

    <div class="qb-layout" data-gate="ok" hidden>
      {/* My quizzes */}
      <aside class="lq-card qb-mine" aria-labelledby="qb-mine-title">
        <div class="qb-mine-head">
          <h2 id="qb-mine-title" data-i18n="qb.mine.title">Meine Quizze</h2>
          <button type="button" class="lq-btn lq-btn--ghost qb-new" data-new data-i18n="qb.mine.new">+ Neues Quiz</button>
        </div>
        <ul class="qb-mine-list" data-mine></ul>
        <MascotEmpty data-mine-empty hidden text="Noch keine Quizze. Stell rechts dein erstes zusammen." textKey="qb.mine.empty">
          <button slot="action" type="button" class="lq-btn lq-btn--primary" data-mine-go data-i18n="qb.mine.emptyGo">Jetzt anfangen</button>
        </MascotEmpty>
      </aside>

      {/* Editor */}
      <section class="qb-editor" aria-labelledby="qb-ed-title">
        {/* The quick way in: start right away, without scrolling to the save bar. */}
        <div class="qb-ed-head">
          <h2 id="qb-ed-title" class="qb-h2" data-ed-title data-i18n="qb.ed.new">Neues Quiz</h2>
          <button type="button" class="lq-btn lq-btn--primary qb-play-top" data-play-top data-i18n="qb.play">Speichern & live starten</button>
        </div>

        <div class="lq-card qb-step">
          <label class="lq-field">
            <span data-i18n="qb.ed.name">Titel</span>
            <input type="text" maxlength="80" data-title placeholder="z. B. Kurs B1 · Futur I" data-i18n-attr="placeholder:qb.ed.namePh" />
          </label>
          <label class="lq-field" data-chapter-field>
            <span data-i18n="qb.ed.chapter">Kapitel</span>
            <select data-chapter>
              <option value="" data-i18n="qb.ed.chapterNone">Kapitel wählen …</option>
              {groups.map((g) => (
                <optgroup label={g.label}>
                  {g.items.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
                </optgroup>
              ))}
            </select>
            <small data-i18n="qb.ed.chapterHint">Aus dem Kapitel kannst du fertige Fragen übernehmen. Eigene Fragen gehen mit jedem Kapitel — oder ganz ohne.</small>
          </label>
          <button type="button" class="qb-link" data-chapter-show hidden data-i18n="qb.ed.chapterShow">+ Add questions from a grammar chapter</button>
        </div>

        {/* Ready-made questions: the chapter, and beside it (below it on a phone) a second
            chapter of the other kind — the Lernset's words plus the grammar that goes with them. */}
        <fieldset class="lq-field lq-choice qb-dir" data-word-dir hidden>
          <legend data-i18n="qb.bank.dir">Wörter fragen als</legend>
          <label><input type="radio" name="qb-dir" value="de-meaning" checked /> <span data-i18n="lq.mode.deMeaningLabel">Deutsch → Übersetzung</span></label>
          <label><input type="radio" name="qb-dir" value="meaning-de" /> <span data-i18n="lq.mode.meaningDeLabel">Übersetzung → Deutsch</span></label>
        </fieldset>
        <div class="qb-banks" data-banks>
          <div class="lq-card qb-step" data-bank hidden>
            <div class="qb-bank-head">
              <h3 data-i18n="qb.bank.title">Fragen aus dem Kapitel</h3>
              <div class="qb-bank-tools">
                <button type="button" class="qb-link" data-bank-random data-i18n="qb.bank.random">10 zufällige</button>
                <button type="button" class="qb-link" data-bank-all data-i18n="qb.bank.all">alle</button>
                <button type="button" class="qb-link" data-bank-none data-i18n="qb.bank.none">keine</button>
              </div>
            </div>
            <div class="qb-bank" data-bank-list></div>
            <button type="button" class="lq-btn lq-btn--ghost qb-add2" data-add2 hidden></button>
          </div>

          <div class="lq-card qb-step qb-bank2" data-bank2 hidden>
            <div class="qb-bank-head">
              <h3 data-bank2-title></h3>
              <button type="button" class="qb-link" data-close2></button>
            </div>
            <label class="lq-field">
              <select data-chapter2>
                <option value="" data-chapter2-none></option>
                {groups.map((g) => (
                  <optgroup label={g.label} data-kind={g.kind}>
                    {g.items.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
                  </optgroup>
                ))}
              </select>
            </label>
            <div class="qb-bank-tools" data-bank2-tools hidden>
              <button type="button" class="qb-link" data-bank-random data-i18n="qb.bank.random">10 zufällige</button>
              <button type="button" class="qb-link" data-bank-all data-i18n="qb.bank.all">alle</button>
              <button type="button" class="qb-link" data-bank-none data-i18n="qb.bank.none">keine</button>
            </div>
            <div class="qb-bank" data-bank-list></div>
          </div>
        </div>

        {/* The quiz as it stands */}
        <div class="lq-card qb-step">
          <div class="qb-bank-head">
            <h3><span data-i18n="qb.list.title">Im Quiz</span> <span class="qb-count" data-count>0 / 50</span></h3>
            <button type="button" class="qb-link" data-shuffle data-i18n="qb.list.shuffle">mischen</button>
          </div>
          <ol class="qb-list" data-list></ol>
          <p class="qb-empty" data-list-empty data-i18n="qb.list.empty">Noch keine Fragen. Kreuz oben Fragen an oder schreib eigene.</p>
        </div>

        {/* Own question: under the list, so what is in the quiz comes first. */}
        <form class="lq-card qb-step qb-own" data-own>
          <h3 data-own-title data-i18n="qb.own.title">Eigene Frage</h3>
          <label class="lq-field">
            <span data-i18n="qb.own.prompt">Frage</span>
            <textarea rows="2" maxlength="200" data-own-prompt required placeholder="z. B. Morgen ___ es regnen." data-i18n-attr="placeholder:qb.own.promptPh"></textarea>
          </label>
          <fieldset class="lq-field qb-opts">
            <legend data-i18n="qb.own.options">Antworten — die richtige ankreuzen</legend>
            {[0, 1, 2, 3].map((i) => (
              <label class={`qb-opt lq-opt--${"abcd"[i]}`}>
                <input type="radio" name="qb-correct" value={i} checked={i === 0} aria-label={`Antwort ${i + 1} ist richtig`} />
                <input type="text" maxlength="80" data-own-opt={i} required={i < 2} placeholder={i < 2 ? `Antwort ${i + 1}` : `Antwort ${i + 1} (optional)`} />
              </label>
            ))}
          </fieldset>
          <label class="lq-field">
            <span data-i18n="qb.own.kind">Aufgabe über der Frage (optional)</span>
            <input type="text" maxlength="120" data-own-kind placeholder="z. B. Ergänze werden." data-i18n-attr="placeholder:qb.own.kindPh" />
          </label>
          <p class="lq-error" data-own-error role="alert"></p>
          <div class="qb-row">
            <button type="button" class="lq-btn lq-btn--quiet" data-own-cancel hidden data-i18n="qb.own.cancel">Abbrechen</button>
            <button type="submit" class="lq-btn lq-btn--ghost" data-own-submit data-i18n="qb.own.add">Frage hinzufügen</button>
          </div>
        </form>

        <div class="qb-save">
          <p class="qb-status" data-status role="status" aria-live="polite"></p>
          <button type="button" class="lq-btn lq-btn--quiet qb-del" data-delete hidden data-i18n="qb.delete">Löschen</button>
          <button type="button" class="lq-btn lq-btn--ghost" data-save data-i18n="qb.save">Speichern</button>
          <button type="button" class="lq-btn lq-btn--primary" data-play data-i18n="qb.play">Speichern & live starten</button>
        </div>
      </section>
    </div>
  </main>

  <script>
    import { mountBuilder } from "../../../lib/liveQuiz/builder.js";
    const root = document.getElementById("qb-root");
    if (root) mountBuilder(root);
    // The empty state’s button: to the quiz name, the first thing the editor asks for.
    document.querySelector("[data-mine-go]")?.addEventListener("click", () => {
      const title = document.querySelector<HTMLInputElement>("[data-title]");
      title?.scrollIntoView({ block: "center", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      title?.focus({ preventScroll: true });
    });
  </script>
</Layout>
