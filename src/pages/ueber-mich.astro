---
// /ueber-mich — who builds EnglishAcademy: Edgar Kretschmann, DaF/DaZ teacher since 2015.
// Facts come from his CV (Lebenslauf DaF-DaZ 2026) and edgarkretschmann.com/bio; photos from
// there too (public/assets/ueber-mich). Only teaching is told here — no address, phone or
// marketing jobs. Years are counted from the first class (Qingdao, March 2015), so the page
// says "seit 2015" and no rounded-up number.
//
// German only, in plain B1 German like /maskottchen: the readers are learners and teachers.
// Linked from the home page footer ("Mehr") and the site search.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import "../styles/practice.css";
import "../styles/ueber-mich.css";

const stats = [
  { n: "seit 2015", label: "unterrichte ich Deutsch" },
  { n: "4 Länder", label: "China, Korea, Philippinen, Deutschland" },
  { n: "A1–C1", label: "alle Niveaus, Kinder bis Ärzte" },
  { n: "bis 40", label: "Teilnehmende in einer Klasse" },
];

const stationen = [
  {
    zeit: "2015", ort: "Qingdao, China",
    titel: "Die ersten Klassen",
    text: "Deutsch und Englisch an der XDF und der Wales Language School: für Kinder, Schüler und Studierende der Universität Qingdao, in Gruppen mit 15 bis 20 Personen. Dazu Einstufungstests ab B1.",
  },
  {
    zeit: "2015–2016", ort: "Seoul, Südkorea",
    titel: "Unterricht nach telc-Standard",
    text: "An der Times Academy Gruppen von A1 bis B2. Ich habe den Unterricht dort nach telc-Standards aufgebaut und die Schulleitung zur Unterrichtsqualität beraten.",
  },
  {
    zeit: "2016–2019", ort: "Berlin",
    titel: "Sprachschulen in Berlin",
    text: "Bei Alpadia, Startcon und dem Eurasia Institute: Gruppen von A2 bis C1 und Vorbereitung auf telc und TestDaF.",
  },
  {
    zeit: "2018–2021", ort: "Philippinen",
    titel: "Pflegekräfte auf dem Weg nach Deutschland",
    text: "In Iloilo, Manila und Subic Bay habe ich Pflegekräfte auf telc B2 Pflege und Ärztinnen und Ärzte auf die Fachsprachprüfung vorbereitet. Seit 2020 auch online, in Klassen mit 20 bis 40 Personen.",
  },
  {
    zeit: "seit 2022", ort: "online",
    titel: "Eigene Online-Schule icanspeak",
    text: "Ich wähle Lehrkräfte aus, plane Unterricht und Curriculum und unterrichte selbst.",
  },
  {
    zeit: "2022–2024", ort: "Berlin",
    titel: "Berufssprachkurse und DTZ",
    text: "Bei FONS Akademie und inlingua: Präsenzkurse mit etwa 20 Personen, viele aus der Ukraine. Vorbereitung auf den DTZ – auch mit Museumsbesuchen in großen Gruppen.",
  },
  {
    zeit: "seit 2024", ort: "online",
    titel: "Integrationskurse",
    text: "BAMF-Integrationskurse für Frohsinn Augsburg und die VHS Biberach: gemischte Gruppen mit etwa 20 Personen, Vorbereitung auf den DTZ, eigene Arbeitsblätter und digitale Übungen.",
  },
  {
    zeit: "2026", ort: "englishacademy.com",
    titel: "EnglishAcademy",
    text: "Aus diesen Arbeitsblättern und Übungen ist diese Seite geworden. Ich setze sie in meinem eigenen Unterricht ein.",
  },
];

// Class photos from Edgar's folder "Lehrerphotos", cropped to 4:3 (1200 + 600 px webp).
// Zoom shots (online-*) are cropped to the video grid, 16:10, with every name label blurred.
const fotos = [
  { file: "qingdao-1", alt: "Unterricht mit Erwachsenen in Qingdao, China" },
  { file: "qingdao-2", alt: "Edgar an der Tafel vor einer Kinderklasse in Qingdao" },
  { file: "berlin-1", alt: "Gruppenfoto einer Klasse am Eurasia Institute in Berlin" },
  { file: "berlin-2", alt: "Ausflug mit einer Klasse vor einem Schloss" },
  { file: "philippinen-1", alt: "Weihnachtsfoto mit einer Klasse auf den Philippinen" },
  { file: "philippinen-2", alt: "Klasse von Pflegekräften im Kursraum auf den Philippinen" },
  { file: "berlin-3", alt: "Ausflug mit einem Kurs in Berlin" },
  { file: "berlin-4", alt: "Kursgruppe vor einem Bild des Brandenburger Tors" },
  { file: "online-1", alt: "Integrationskurs online: Teilnehmende winken in die Kamera", online: true },
  { file: "online-2", alt: "Integrationskurs online über Zoom", online: true },
  { file: "online-3", alt: "Online-Kurs über Zoom", online: true },
  { file: "online-4", alt: "Online-Kurs mit Kamera an", online: true },
];
const quali = [
  "Cambridge CELTA (Unterricht für Erwachsene)",
  "Goethe-Institut: Deutsch Lehren Lernen",
  "VHS-Lehrkräftequalifizierung",
  "BAMF-Zulassung für Integrationskurse",
  "B.A. Wirtschaft und Politik, Universität Jena",
];

const sprachen = ["Deutsch", "Englisch", "Spanisch", "Italienisch", "Französisch", "Portugiesisch", "Russisch"];
---
<Layout
  title="Über mich: Edgar Kretschmann – EnglishAcademy"
  description="Edgar Kretschmann unterrichtet seit 2015 Deutsch: in China, Korea, auf den Philippinen und in Deutschland, heute in Integrationskursen. Hier erzählt er, woher die Übungen von EnglishAcademy kommen."
>
  <SiteNav />

  <main class="vp-page um-page" lang="de">
    <header class="um-hero">
      <img class="um-portrait" src="/assets/ueber-mich/edgar.webp" alt="Edgar Kretschmann" width="240" height="240" />
      <div>
        <p class="um-eyebrow">Über mich</p>
        <h1>Hallo, ich bin Edgar.</h1>
        <p class="um-lead">
          Ich unterrichte seit 2015 Deutsch – in China, Südkorea, auf den Philippinen und in
          Deutschland. Heute unterrichte ich in Integrationskursen und bereite auf den DTZ vor.
          EnglishAcademy baue ich für meine Teilnehmenden – und für alle, die Deutsch lernen.
        </p>
      </div>
    </header>

    <ul class="um-stats">
      {stats.map((s) => <li><b>{s.n}</b><span>{s.label}</span></li>)}
    </ul>

    <section class="um-section">
      <h2>Warum diese Seite?</h2>
      <p>
        In jedem Kurs sehe ich dieselben Stellen, an denen es hakt: der Artikel, die Verbposition,
        der formelle Brief, die Durchsage, die man nur einmal hört. Dafür habe ich jahrelang
        Arbeitsblätter gemacht. Auf EnglishAcademy stehen sie jetzt so, dass man sie auf dem Handy
        üben kann – mit Erklärung, sofortiger Rückmeldung und Hilfe in vielen Sprachen.
      </p>
    </section>

    <figure class="um-photo">
      <ul class="um-gallery">
        {fotos.map((f) => (
          <li class={f.online ? "is-online" : undefined}>
            <img
              src={`/assets/ueber-mich/${f.file}.webp`}
              srcset={`/assets/ueber-mich/${f.file}-600.webp 600w, /assets/ueber-mich/${f.file}.webp 1200w`}
              sizes="(min-width: 760px) 360px, 50vw"
              alt={f.alt} width="1200" height={f.online ? 750 : 900} loading="lazy" decoding="async"
            />
          </li>
        ))}
      </ul>
      <figcaption>Meine Klassen in Qingdao, Berlin, auf den Philippinen und online.</figcaption>
    </figure>

    <section class="um-section">
      <h2>Wo ich unterrichtet habe</h2>
      <ol class="um-timeline">
        {stationen.map((s) => (
          <li>
            <p class="um-when"><span>{s.zeit}</span> · {s.ort}</p>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <div class="um-grid">
      <section class="um-section um-box">
        <h2>Ausbildung</h2>
        <ul class="um-list">{quali.map((q) => <li>{q}</li>)}</ul>
      </section>
      <section class="um-section um-box">
        <h2>Sprachen</h2>
        <p class="um-langs">{sprachen.map((l) => <span>{l}</span>)}</p>
        <p class="um-note">Ich weiß, wie es ist, eine neue Sprache zu lernen – ich habe es oft gemacht.</p>
      </section>
    </div>

    <section class="um-section">
      <h2>Fang hier an</h2>
      <div class="um-cards">
        <a class="um-card" href="/einstufungstest">
          <b>Einstufungstest</b>
          <span>Finde in ein paar Minuten heraus, welches Niveau du hast.</span>
        </a>
        <a class="um-card" href="/dtz">
          <b>DTZ-Vorbereitung</b>
          <span>So bereite ich meine Integrationskurse auf den DTZ vor.</span>
        </a>
        <a class="um-card" href="/lehrkraefte">
          <b>Für Lehrkräfte</b>
          <span>Arbeitsblätter, Live-Quiz und Spiele für den eigenen Unterricht.</span>
        </a>
      </div>
    </section>
  </main>
</Layout>
