---
import { fitTitle } from "../../../lib/seo/title.js";
// /business-spanish/[unit]/words: a unit's words in the shared flashcard trainer, the same page as a
// sector's group (english-for-work/[beruf]/[gruppe].astro). Each unit is one group of the deck "business".
import Layout from "../../../layouts/Layout.astro";
import { BUSINESS_SLUGS, businessPath, workPath } from "../../../lib/routes.js";
import VokabelTrainer from "../../../components/VokabelTrainer.astro";
import DeckActions from "../../../components/DeckActions.astro";
import { DECKS, groupsOf, cardsOf, LANGS } from "../../../lib/berufeWortschatz.js";
import "../../../styles/berufe.css";

export function getStaticPaths() {
  return groupsOf("business").map((g: any) => ({ params: { unit: (BUSINESS_SLUGS as Record<string, string>)[g.id] }, props: { group: g } }));
}
const { group } = Astro.props as any;
const deck = DECKS.business;
const cards = cardsOf("business", group.id);
const deckId = `berufe-business-${group.id}`;
const printHref = `${workPath("business", group.id)}/print`;
---
<Layout
  title={fitTitle(`${group.title} – words – ${deck.title}`, group.title)}
  description={`${deck.title}: ${group.title} — ${cards.length} words with example sentences and translations.`}
  breadcrumb={[{ name: deck.title, path: "/business-spanish" }, { name: group.title, path: businessPath(group.id) }]}
>
  <VokabelTrainer
    cards={cards}
    heading={group.title}
    sub={`${deck.title} · ${cards.length} words`}
    subParts={[{ text: deck.title }, { text: `${cards.length} words`, key: "sets.wordCount", vars: { n: cards.length } }]}
    deck={deckId}
    langs={LANGS}
    printHref={printHref}
  >
    <Fragment slot="hero">
      <DeckActions setId={deckId} print={printHref} />
    </Fragment>
    <Fragment slot="tools">
      <DeckActions setId={deckId} print={printHref} compact />
    </Fragment>
  </VokabelTrainer>
</Layout>
