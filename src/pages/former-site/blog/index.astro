---
import FormerSiteLayout from '../../../layouts/FormerSiteLayout.astro';

const posts = [
  {
    title: 'Wie suche ich Kandidaten beim Recruiting Prozess in der Sprache aus?',
    href: '/wie-suche-ich-kandidaten-beim-recruiting-prozess-in-der-sprache-aus/',
    author: 'Edgar Kretschmann',
    excerpt:
      '8 Sekunden ist unsere Aufmerksamkeitsspanne. 8 Monate dauert der Prozess, um Deutsch einigermaßen auf B2 sprechen zu können, so ist zumindest der Status Quo auf den Philippinen. Um die Ausfall- bzw. Durchfallquote zu reduzieren, sollte schon vorher getestet werden, wer fähig genug ist, die Deutsche Sprache zu beherrschen. Hierbei bedienen sich unsere Kunden eines Assessment …',
  },
];
---

<FormerSiteLayout title="Blog – icanspeak.it" description="Artikel und Erfahrungen rund um Sprachausbildung im Recruiting-Prozess.">
  <section class="section page-head">
    <div class="container">
      <h1>Blog</h1>
    </div>
  </section>

  <section class="section">
    <div class="container blog-list">
      {posts.map((post) => (
        <article class="blog-list__item">
          <h2><a href={post.href}>{post.title}</a></h2>
          <p class="blog-list__meta">
            Von {post.author} &middot; <a href={`${post.href}#comments`}>2 Kommentare</a>
          </p>
          <p>{post.excerpt}</p>
          <a href={post.href} class="button button--outline">Weiterlesen</a>
        </article>
      ))}
    </div>
  </section>
</FormerSiteLayout>

<style>
  .blog-list {
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .blog-list__item h2 {
    font-size: 1.5rem;
    margin-block-end: 0.5rem;
  }

  .blog-list__item p {
    max-width: none;
  }

  .blog-list__meta {
    color: var(--color-muted);
    font-size: 0.9rem;
    margin-block-end: 1rem;
  }
</style>
