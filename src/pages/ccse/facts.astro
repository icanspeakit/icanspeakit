---
import ExamDisclaimer from "../../components/ExamDisclaimer.astro";
// Facts page for the CCSE (data: leben-in-deutschland.json; the slug moves in `routes`).
// Every text is rendered twice: .fk-std is Spanish, the language of the test; .fk-easy is the same
// fact in English (`factsEasy`, `defEasy`). fakten-layouts.css shows the one that matches
// .fk-page[data-lang], so the three layouts need no extra JS for it, except the comunidad panel,
// which is built client-side. The translation layer (uebersetzungen/) is empty until reviewed.
// The comunidades are an extra: the real test has no part on one comunidad.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/practice.css";
import "../../styles/pruefungen.css";
import "../../styles/fakten-layouts.css";
import "../../styles/rule-intro.css";
import GrammarHelp from "../../components/GrammarHelp.astro";
import GrammarHelpText from "../../components/GrammarHelpText.astro";
// A picture per topic, and in the English view its key words underneath.
import LidGrafik from "../../components/LidGrafik.astro";
import lid from "../../data/leben-in-deutschland.json";
import lidHelp from "../../data/uebersetzungen/leben-in-deutschland.json";
import { field, item } from "../../lib/helpContent.js";

const { topics, glossary, meta, bundeslaender } = lid;
const tx = lidHelp as any;
const topicTx = (id: string) => tx.topics?.[id] ?? {};
const glossTx = (term: string) => tx.glossary?.[term] ?? {};
---
<Layout
  title="CCSE: facts to learn – icanspeak Spanish"
  description="Key facts for the CCSE: the constitution, institutions, rights, history, culture, everyday life and the comunidades autónomas of Spain. General orientation, not legal advice."
>
  <div class="fk-page" id="fk-page" data-lang="standard" data-gx="off">
  <SiteNav active="pruefungen" />

  <div class="fk-view-switcher" role="tablist" aria-label="Choose view" data-i18n-attr="aria-label:lid.fk.view.aria">
    <span class="fk-view-switcher-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5"/><path d="M3 16.5l9 5 9-5"/></svg>
    </span>
    <div class="fk-view-switcher-track">
      <span class="fk-view-switcher-indicator" aria-hidden="true"></span>
      <button type="button" class="fk-view-btn" data-layout="tabs" title="Tabs" aria-label="View: tabs" data-i18n-attr="title:lid.fk.view.tabs;aria-label:lid.fk.view.tabsAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8V6.5A1.5 1.5 0 0 1 4.5 5h4l2 2h9A1.5 1.5 0 0 1 21 8.5v9A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5V8Z"/></svg>
      </button>
      <button type="button" class="fk-view-btn" data-layout="sidebar" title="Table of contents" aria-label="View: table of contents" data-i18n-attr="title:lid.fk.view.toc;aria-label:lid.fk.view.tocAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="1.5"/><line x1="9.5" y1="4" x2="9.5" y2="20"/></svg>
      </button>
      <button type="button" class="fk-view-btn" data-layout="cards" title="Cards" aria-label="View: cards" data-i18n-attr="title:lid.fk.view.cards;aria-label:lid.fk.view.cardsAria">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.2"/><rect x="14" y="3" width="7" height="7" rx="1.2"/><rect x="3" y="14" width="7" height="7" rx="1.2"/><rect x="14" y="14" width="7" height="7" rx="1.2"/></svg>
      </button>
    </div>
  </div>

  <main class="practice-main">
    <div class="fk-hero">
      <p class="eyebrow"><span data-i18n="exam.lid.name">CCSE nationality test</span> · <span data-i18n="lid.fk.eyebrow">Facts</span></p>
      <h1 data-i18n="lid.fk.title">Facts to learn</h1>
      <p data-i18n-html="lid.fk.hero">
        Facts on Spain by topic, in Spanish and in English, plus the key facts on the comunidades autónomas. Read them before you try the <a href="/ccse/test">practice test</a>.
      </p>
      <details class="fk-source-note">
        <summary data-i18n="exam.aboutSource">About the source</summary>
        <p><span class="fk-std">{meta.sourceNote}</span><span class="fk-easy">{meta.sourceNoteEasy}</span></p>
        <GrammarHelpText class="fk-std" text={field(tx.meta?.sourceNote)} />
        <GrammarHelpText class="fk-easy" text={field(tx.meta?.sourceNoteEasy)} />
      </details>
    </div>
    <ExamDisclaimer />

    {/* A labelled two-way switch, not two more pills: it sat right above the topic tabs
        and read as two more topics. */}
    <div class="fk-lang-bar">
    <span class="fk-lang-kicker" data-i18n="lid.fk.level.kicker">Read the texts:</span>
    <div class="fk-lang-toggle" role="tablist" aria-label="Choose language" data-i18n-attr="aria-label:lid.fk.level.aria">
      <button type="button" class="fk-lang-btn" data-lang="standard">
        <span data-i18n="lid.fk.level.standard" lang="es">En español</span>
      </button>
      <button type="button" class="fk-lang-btn" data-lang="easy">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5V6a2 2 0 0 1 2-2h13.5v15H6a2 2 0 0 0-2 2Z"/><path d="M19.5 19.5H6a2 2 0 0 1 0-4h13.5"/></svg>
        <span data-i18n="lid.fk.level.en">In English</span>
      </button>
    </div>
    </div>
    {/* No translation switch while the layer is empty: it would announce a machine draft of nothing. */}
    {Object.keys(tx.topics ?? {}).length > 0 && <GrammarHelp level="A2" root="fk-page" reviewed={tx.reviewed} />}

    <!-- ================= Layout 1: Tabs ================= -->
    <section class="fk-layout fk-layout--tabs" id="fk-tabs" data-layout-panel="tabs">
      <div class="fk-tabbar" role="tablist">
        {topics.map((t) => (
          <button class="fk-tab" type="button" data-target={`fkt-${t.id}`}><span lang="es">{t.title}</span></button>
        ))}
        <button class="fk-tab" type="button" data-target="fkt-glossar" data-i18n="lid.fk.glossary">Glossary</button>
        <button class="fk-tab" type="button" data-target="fkt-bundesland" data-i18n="lid.fk.yourState">Your comunidad</button>
      </div>

      {topics.map((t, i) => (
        <div class={`fk-tab-panel${i === 0 ? " active" : ""}`} id={`fkt-${t.id}`}>
          <h3 lang="es">{t.title}</h3>
          <GrammarHelpText text={field(topicTx(t.id).title)} />
          <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std" lang="es">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
          <LidGrafik id={t.id} words={(t as any).words} />
        </div>
      ))}

      <div class="fk-tab-panel" id="fkt-glossar">
        <h3 data-i18n="lid.fk.glossary">Glossary</h3>
        <dl class="glossary-list">
          {glossary.map((g) => (<><dt lang="es">{g.term}</dt><dd><span class="fk-std" lang="es">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></dd></>))}
        </dl>
      </div>

      <div class="fk-tab-panel" id="fkt-bundesland">
        <h3 data-i18n="lid.fk.yourState">Your comunidad</h3>
        <div data-land-wrap>
          <select class="fk-land-select">
            {bundeslaender.map((l) => <option value={l.id} selected={l.id === bundeslaender[0].id}>{l.name}</option>)}
          </select>
          <div class="fk-land-detail"></div>
        </div>
      </div>

    </section>

    <!-- ================= Layout 2: Sidebar / Inhaltsverzeichnis ================= -->
    <section class="fk-layout fk-layout--sidebar" id="fk-sidebar" data-layout-panel="sidebar" hidden>
      <div class="fk-doc-grid">
        <nav class="fk-doc-nav">
          <p class="fk-doc-nav-label" data-i18n="lid.fk.topics">Topics</p>
          <ul>
            {topics.map((t) => <li><a href={`#fks-${t.id}`} lang="es">{t.title}</a></li>)}
            <li><a href="#fks-glossar" data-i18n="lid.fk.glossary">Glossary</a></li>
            <li><a href="#fks-bundesland" data-i18n="lid.fk.yourState">Your comunidad</a></li>
          </ul>
        </nav>

        <div class="fk-doc-content">
          {topics.map((t) => (
            <article class="fk-doc-section" id={`fks-${t.id}`}>
              <h3 lang="es">{t.title}</h3>
          <GrammarHelpText text={field(topicTx(t.id).title)} />
              <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std" lang="es">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
          <LidGrafik id={t.id} words={(t as any).words} />
            </article>
          ))}

          <article class="fk-doc-section" id="fks-glossar">
            <h3 data-i18n="lid.fk.glossary">Glossary</h3>
            <dl class="glossary-list">
              {glossary.map((g) => (<><dt lang="es">{g.term}</dt><dd><span class="fk-std" lang="es">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></dd></>))}
            </dl>
          </article>

          <article class="fk-doc-section" id="fks-bundesland">
            <h3 data-i18n="lid.fk.yourState">Your comunidad</h3>
            <div data-land-wrap>
              <select class="fk-land-select">
                {bundeslaender.map((l) => <option value={l.id} selected={l.id === bundeslaender[0].id}>{l.name}</option>)}
              </select>
              <div class="fk-land-detail"></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ================= Layout 3: Cards ================= -->
    <section class="fk-layout fk-layout--cards" id="fk-cards" data-layout-panel="cards" hidden>
      <div class="fk-card-grid">
        {topics.map((t, i) => (
          <details class="fk-fact-card" open={i === 0}>
            <summary>
              <span class="fk-fact-card-title" lang="es">{t.title}</span>
              <span class="fk-fact-card-count" data-i18n="lid.fk.nFacts" data-i18n-vars={JSON.stringify({ n: t.facts.length })}>{t.facts.length} Fakten</span>
            </summary>
            <ul class="fact-list">{t.facts.map((f, fi) => <li><span class="fk-std" lang="es">{f}</span><span class="fk-easy">{t.factsEasy[fi]}</span><GrammarHelpText class="fk-std" text={item(topicTx(t.id).facts, fi)} /><GrammarHelpText class="fk-easy" text={item(topicTx(t.id).factsEasy, fi)} /></li>)}</ul>
          <LidGrafik id={t.id} words={(t as any).words} />
          </details>
        ))}
      </div>

      <div class="fk-card-row">
        <details class="fk-fact-card fk-fact-card--wide">
          <summary>
            <span class="fk-fact-card-title" data-i18n="lid.fk.glossary">Glossary</span>
            <span class="fk-fact-card-count" data-i18n="lid.fk.nTerms" data-i18n-vars={JSON.stringify({ n: glossary.length })}>{glossary.length} Begriffe</span>
          </summary>
          <div class="fk-glossary-grid">
            {glossary.map((g) => (
              <div class="fk-glossary-item"><strong lang="es">{g.term}</strong><span class="fk-std" lang="es">{g.def}</span><span class="fk-easy">{g.defEasy}</span><GrammarHelpText class="fk-std" text={field(glossTx(g.term).def)} /><GrammarHelpText class="fk-easy" text={field(glossTx(g.term).defEasy)} /></div>
            ))}
          </div>
        </details>

        <details class="fk-fact-card fk-fact-card--wide">
          <summary><span class="fk-fact-card-title" data-i18n="lid.fk.yourState">Your comunidad</span></summary>
          <div data-land-wrap>
            <select class="fk-land-select">
              {bundeslaender.map((l) => <option value={l.id} selected={l.id === bundeslaender[0].id}>{l.name}</option>)}
            </select>
            <div class="fk-land-detail"></div>
          </div>
        </details>
      </div>

    </section>

    <section class="exam-section">
      <h2 data-i18n="lid.fk.testFormat">Test format</h2>
      <div class="format-table-wrap">
        <table class="format-table">
          <thead><tr><th data-i18n="format.th.part">Part</th><th data-i18n="format.th.scope">Scope</th></tr></thead>
          <tbody>
            {meta.tareas.map((t) => (
              <tr><td lang="es">{t.title}</td><td data-i18n={`lid.tarea.${t.options === 2 ? "tf" : "mc"}`} data-i18n-vars={JSON.stringify({ n: t.realCount })}>{t.realCount}</td></tr>
            ))}
            <tr><td data-i18n="format.th.time">Time</td><td data-i18n="lid.fk.minutes" data-i18n-vars={JSON.stringify({ n: meta.minutes })}>{meta.minutes} minutes</td></tr>
            <tr><td data-i18n="lid.fk.passFrom">Pass from</td><td data-i18n="lid.fk.nCorrect" data-i18n-vars={JSON.stringify({ n: meta.passScore })}>{meta.passScore} correct answers</td></tr>
          </tbody>
        </table>
      </div>
      <p class="format-note" data-i18n="lid.fk.formatNote">As reported in November 2026. Check the current format with the Instituto Cervantes.</p>
    </section>

    <div class="mock-cta">
      <h2 data-i18n="lid.fk.cta.title">Test yourself now</h2>
      <p data-i18n="lid.fk.cta.text">Multiple-choice questions on the same topics as these facts, with instant feedback. You can add a comunidad on the test page.</p>
      <a class="quiz-btn quiz-btn--primary" href="/ccse/test" data-i18n="lid.cta.test">To the practice test</a>
    </div>
  </main>
  </div>

  <script type="application/json" id="laender-data" set:html={JSON.stringify(bundeslaender)}></script>
  <script type="application/json" id="meta-data" set:html={JSON.stringify(meta)}></script>
  <script type="module">
    import { readyExamI18n, tx } from "../../lib/exam/i18n.js";
    import { onLangChange } from "../../lib/i18n.js";
    import { createRuleIntro } from "../../lib/ruleIntro.js";

    const laender = JSON.parse(document.getElementById("laender-data").textContent);
    const meta = JSON.parse(document.getElementById("meta-data").textContent);

    function esc(s) {
      const div = document.createElement("div");
      div.textContent = s;
      return div.innerHTML;
    }

    const pageRoot = document.getElementById("fk-page");
    function currentLang() {
      return pageRoot.dataset.lang === "easy" ? "easy" : "standard";
    }

    function renderLand(container, id) {
      const l = laender.find((x) => x.id === id) || laender[0];
      const easy = currentLang() === "easy";
      const borders = l.borderCountries.length ? l.borderCountries.join(", ") : tx("lid.fk.land.noBorder", "keine Auslandsgrenze");
      const stateNote = easy ? meta.stateFactsNoteEasy : meta.stateFactsNote;
      const sourceFacts = (easy ? l.sourceFactsEasy : l.sourceFacts) || null;
      container.innerHTML = `
        <div class="topic-intro" style="margin:14px 0;">
          ${l.sourced
            ? esc(tx("lid.fk.land.sourced", "Written by icanspeak Spanish from public sources."))
            : esc(tx("lid.fk.land.public", "Well-known public facts, written up by icanspeak Spanish.")) + " " + esc(stateNote)}
        </div>
        <ul class="fact-list">
          <li><strong>${esc(tx("lid.fk.land.capital", "Hauptstadt:"))}</strong> ${esc(l.capital)}</li>
          <li><strong>${esc(tx("lid.fk.land.type", "Typ:"))}</strong> ${esc(l.type)}</li>
          <li><strong>${esc(tx("lid.fk.land.population", "Einwohner:"))}</strong> ${esc(l.population)}</li>
          <li><strong>${esc(tx("lid.fk.land.borders", "Grenzt an (Ausland):"))}</strong> ${esc(borders)}</li>
          <li><strong>${esc(tx("lid.fk.land.parliament", "Landesparlament:"))}</strong> ${esc(l.parliamentName)}</li>
          <li><strong>${esc(tx("lid.fk.land.head", "Spitze der Landesregierung:"))}</strong> ${esc(l.executiveTitle)}</li>
        </ul>
        ${sourceFacts ? `<h4 style="margin:18px 0 8px;">${esc(tx("lid.fk.land.more", "Vertiefung aus dem Unterrichtsmaterial"))}</h4><ul class="fact-list">${sourceFacts.map((f) => `<li>${esc(f)}</li>`).join("")}</ul>` : ""}
      `;
    }

    const paintLands = () => document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
      renderLand(wrap.querySelector(".fk-land-detail"), wrap.querySelector(".fk-land-select").value);
    });
    document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
      const select = wrap.querySelector(".fk-land-select");
      const detail = wrap.querySelector(".fk-land-detail");
      renderLand(detail, select.value);
      select.addEventListener("change", () => renderLand(detail, select.value));
    });
    // The comunidad panel is built here, not in the static DOM: its labels (Capital, Population …)
    // are repainted once the dictionary lands and on every language switch. The names stay Spanish.
    readyExamI18n().then(paintLands);
    onLangChange(() => setTimeout(paintLands));

    // Spanish / English toggle. .fk-std/.fk-easy spans are shown/hidden purely via CSS on
    // [data-lang]; only the JS-built comunidad panel needs an explicit re-render.
    const langBtns = [...document.querySelectorAll(".fk-lang-btn")];
    function setLang(key, { remember = true } = {}) {
      pageRoot.dataset.lang = key;
      langBtns.forEach((b) => b.classList.toggle("active", b.dataset.lang === key));
      const toggle = document.querySelector(".fk-lang-toggle");
      if (toggle) toggle.dataset.on = key;
      document.querySelectorAll("[data-land-wrap]").forEach((wrap) => {
        const select = wrap.querySelector(".fk-land-select");
        const detail = wrap.querySelector(".fk-land-detail");
        renderLand(detail, select.value);
      });
      if (remember) { try { localStorage.setItem("fakten-lang", key); } catch {} }
    }
    langBtns.forEach((b) => b.addEventListener("click", () => setLang(b.dataset.lang)));

    let initialLang = "standard";
    try { initialLang = localStorage.getItem("fakten-lang") || "standard"; } catch {}
    setLang(initialLang);

    // The English-view tour, once per browser (?intro replays it), for a learner still on Spanish:
    // the switch flips to English so the facts are seen in it, the light names them, then it
    // flips back and lands on the switch. The same engine as the
    // grammar pages (ruleIntro.js); the flips never touch the stored choice — a demo is
    // not a choice the learner made.
    const EASY_TOUR = "da-fakten-easy-seen";
    const tourForced = new URLSearchParams(location.search).has("intro");
    let tourSeen = false;
    try { tourSeen = localStorage.getItem(EASY_TOUR) === "1"; } catch {}
    const easyBtn = langBtns.find((b) => b.dataset.lang === "easy");
    const firstPanel = document.querySelector("#fk-tabs .fk-tab-panel.active");
    if (easyBtn && firstPanel && (tourForced || (!tourSeen && initialLang === "standard"))
        && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      if (!tourForced) { try { localStorage.setItem(EASY_TOUR, "1"); } catch {} }
      const compact = !matchMedia("(min-width: 760px)").matches;
      const intro = createRuleIntro({
        mascot: "bruno",
        ruleEl: firstPanel,
        ruleBtn: easyBtn,
        ruleCard: firstPanel,
        setRule: (hidden) => setLang(hidden ? "standard" : "easy", { remember: false }),
        compact,
        coach: [
          ["intro.fkEasy.title", "intro.fkEasy.text"],
          ["intro.fkEasySwitch.title", compact ? "intro.fkEasySwitch.textCompact" : "intro.fkEasySwitch.text"],
        ],
      });
      setTimeout(() => intro.play(), 600);
    }

    // Layout 1: tabs
    const tabsRoot = document.getElementById("fk-tabs");
    if (tabsRoot) {
      const tabBtns = [...tabsRoot.querySelectorAll(".fk-tab")];
      const panels = [...tabsRoot.querySelectorAll(".fk-tab-panel")];
      tabBtns[0].classList.add("active");
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          tabBtns.forEach((b) => b.classList.toggle("active", b === btn));
          panels.forEach((p) => p.classList.toggle("active", p.id === btn.dataset.target));
        });
      });
    }

    // Ansicht (structural layout) switcher — Tabs is the default. Switching crossfades the old
    // section out and the new one in (instead of an instant [hidden] swap) and slides a pill
    // indicator behind the active icon, so the change reads as a transition rather than a snap.
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ANIM_MS = 180;
    const layoutBtns = [...document.querySelectorAll(".fk-view-btn")];
    const track = document.querySelector(".fk-view-switcher-track");
    const indicator = document.querySelector(".fk-view-switcher-indicator");
    const layoutSections = {
      tabs: document.getElementById("fk-tabs"),
      sidebar: document.getElementById("fk-sidebar"),
      cards: document.getElementById("fk-cards"),
    };
    let currentLayout = null;
    let animating = false;

    function moveIndicator(key) {
      const btn = layoutBtns.find((b) => b.dataset.layout === key);
      if (!btn || !indicator || !track) return;
      indicator.style.transform = `translateX(${btn.offsetLeft}px)`;
      indicator.style.width = `${btn.offsetWidth}px`;
    }

    function setLayout(key) {
      if (animating || key === currentLayout) return;
      const target = layoutSections[key];
      if (!target) return;

      layoutBtns.forEach((b) => b.classList.toggle("active", b.dataset.layout === key));
      moveIndicator(key);
      try { localStorage.setItem("fakten-layout", key); } catch {}

      const outgoing = currentLayout ? layoutSections[currentLayout] : null;
      currentLayout = key;

      if (!outgoing || reduceMotion) {
        Object.entries(layoutSections).forEach(([k, el]) => { if (el) el.hidden = k !== key; });
        return;
      }

      animating = true;
      outgoing.classList.add("fk-anim-out");
      window.setTimeout(() => {
        outgoing.hidden = true;
        outgoing.classList.remove("fk-anim-out");
        target.hidden = false;
        target.classList.add("fk-anim-in");
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            target.classList.remove("fk-anim-in");
            animating = false;
          });
        });
      }, ANIM_MS);
    }
    layoutBtns.forEach((b) => b.addEventListener("click", () => setLayout(b.dataset.layout)));
    window.addEventListener("resize", () => currentLayout && moveIndicator(currentLayout));

    let initialLayout = "tabs";
    try { initialLayout = localStorage.getItem("fakten-layout") || "tabs"; } catch {}
    setLayout(initialLayout);
  </script>
</Layout>
