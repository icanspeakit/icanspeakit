---
import { fitTitle } from "../../../lib/seo/title.js";
// /berufe/[beruf] — one profession: intro, its word groups, cross-links (later: situations and
// the PDF, Tier 2). Built only for a deck with words, plus Pflege, whose page carries the
// pflegeplace.com box even before its words are in (noindex until then).
import Layout from "../../../layouts/Layout.astro";
import SiteNav from "../../../components/SiteNav.astro";
import SectionMascot from "../../../components/mascots/SectionMascot.astro";
import LeichtToggle from "../../../components/LeichtToggle.astro";
import HubBild from "../../../components/HubBild.astro";
import { BERUFE } from "../../../lib/berufeCore.js";
import { DECKS, groupsOf, entryCount, hasPage, samplesOf } from "../../../lib/berufeWortschatz.js";
import { emojiSrc } from "../../../lib/wortBild.js";
import { pair } from "../../../lib/leichteSprache.js";
import { files as downloads } from "../../../lib/downloads.js";
import "../../../styles/practice.css";
import "../../../styles/kultur.css";
import "../../../styles/kultur-hub.css";
import "../../../styles/berufe.css";

export function getStaticPaths() {
  return BERUFE.filter((b) => hasPage(b.slug)).map((b) => ({ params: { beruf: b.slug }, props: { emoji: b.emoji } }));
}
const { beruf } = Astro.params as { beruf: string };
const { emoji } = Astro.props as { emoji: string };
const deck = DECKS[beruf];
const groups = groupsOf(beruf);
const n = entryCount(deck);
const ext = deck.external;
const samples = samplesOf(beruf, 3);
// The deck's PDF (scripts/generate-berufe-pdf.mjs, listed in src/data/downloads.json); only
// when the file is on disk — downloads.js drops a catalogue entry whose file is missing.
const pdf = downloads.find((f: any) => f.id === `berufe-${beruf}`);
const v = (o: Record<string, unknown>) => JSON.stringify(o);
---
<Layout
  title={fitTitle(`${deck.title} – English for work`, `${deck.title} – Workplace English`, deck.title)}
  description={`${deck.intro.split(/(?<=\.)\s/)[0]} Workplace vocabulary with example sentences and translations.`}
  noindex={n === 0}
>
  <SiteNav active="wortschatz" />
  <main class="practice-main practice-main--wide">
    <HubBild id={`berufe-${beruf}`} />
    <div class="practice-hero">
      <p class="eyebrow"><a href="/berufe" data-i18n="berufe.hero.title">Deutsch für den Beruf</a></p>
      <h1 lang="de">{deck.title}</h1>
      <div class="bv-badges">
        <span class="bv-badge">{deck.level}</span>
        {n > 0 && <span class="bv-badge" data-i18n="sets.wordCount" data-i18n-vars={v({ n })}>{n} Wörter</span>}
      </div>
      <SectionMascot name="hamsti" say="Wörter für deine Arbeit." align="center" class="ku-hero-mascot" />
    </div>

    {ext && (
      <aside class="bv-ext" aria-labelledby="bv-ext-top">
        <img src={emojiSrc(emoji)} alt="" width="44" height="44" />
        <div>
          <p id="bv-ext-top" data-i18n="berufe.pflege.box">Du willst mehr für die Pflege lernen? Auf pflegeplace.com gibt es viel mehr: den ganzen Fachwortschatz, Kurse und Hilfe für die Prüfung.</p>
          <a class="bv-ext-cta" href={ext.href} rel="noopener"><span data-i18n="berufe.pflege.cta">Weiter zu pflegeplace.com</span>&nbsp;↗</a>
        </div>
      </aside>
    )}

    {deck.introEasy && <div class="bv-ls"><LeichtToggle /></div>}
    <p class="bv-intro" lang="de" {...pair(deck.intro, deck.introEasy)}>{deck.intro}</p>

    {deck.jobs?.length > 0 && (
      <section class="bv-jobs" aria-labelledby="bv-jobs-h">
        <h2 id="bv-jobs-h" class="bv-sub" data-i18n="berufe.deck.jobs">Für diese Jobs</h2>
        <ul class="bv-chips" lang="de">{deck.jobs.map((j: string) => <li>{j}</li>)}</ul>
      </section>
    )}

    {groups.length > 0
      ? (
        <section class="ku-group">
          <h2 class="ku-group-title" data-i18n="berufe.deck.groups">Die Wörter — Gruppe für Gruppe</h2>
          <div class="ku-grid ku-grid--fill">
            {groups.map((g: any) => (
              <a class="ku-card" href={`/berufe/${beruf}/${g.id}`}>
                <span class="ku-card-txt"><b lang="de">{g.title}</b></span>
                <span class="bv-card-meta" data-i18n="sets.wordCount" data-i18n-vars={v({ n: g.words.length })}>{g.words.length} Wörter</span>
              </a>
            ))}
          </div>
        </section>
      )
      : <p class="bv-intro" data-i18n="berufe.deck.soon">Die Wörter für diesen Beruf kommen bald.</p>}

    {pdf && (
      <aside class="bv-pdf" aria-labelledby="bv-pdf-h">
        <span class="bv-pdf-ic" aria-hidden="true">PDF</span>
        <div class="bv-pdf-txt">
          <b id="bv-pdf-h" data-i18n="berufe.pdf.title">Wortliste zum Ausdrucken</b>
          <span class="bv-pdf-meta">{pdf.pages ? `${pdf.pages} S. · ` : ""}{pdf.size}</span>
          <div class="bv-pdf-actions">
            <a class="bv-pdf-cta" href={pdf.href} download><span data-i18n="berufe.pdf.cta">PDF herunterladen</span></a>
            {pdf.editions.map((e: any) => (
              <a class="bv-pdf-ed" href={e.href} download lang={e.lang} dir={e.rtl ? "rtl" : undefined}>{e.label}</a>
            ))}
          </div>
        </div>
      </aside>
    )}

    {samples.length > 0 && (
      <section class="bv-samples" aria-labelledby="bv-samples-h">
        <div class="bv-sec-head">
          <h2 id="bv-samples-h" class="ku-group-title" data-i18n="berufe.deck.samples">So klingt es bei der Arbeit</h2>
          <SectionMascot name="quaki" say="Lies die Sätze laut!" />
        </div>
        <ul lang="de">
          {samples.map((x) => (
            <li>
              <q>{x.example}</q>
              <span class="bv-sample-word"><b>{x.gender ? `${x.gender} ${x.lemma}` : x.lemma}</b> — {x.deHint}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    {deck.tipps?.length > 0 && (
      <section class="bv-tipps" aria-labelledby="bv-tipps-h">
        <div class="bv-sec-head">
          <h2 id="bv-tipps-h" class="ku-group-title" data-i18n="berufe.deck.tipps">Tipps für Deutsch bei der Arbeit</h2>
          <SectionMascot name="bruno" expr="thinking" say="Das hilft dir im Job." />
        </div>
        <ul lang="de">{deck.tipps.map((t: string) => <li>{t}</li>)}</ul>
      </section>
    )}

    {deck.links?.length > 0 && (
      <nav class="bv-links" aria-label="Passt dazu" data-i18n-attr="aria-label:berufe.deck.related">
        {deck.links.map((l: any) => <a href={l.href} lang="de">{l.label} →</a>)}
      </nav>
    )}

    {ext && (
      <aside class="bv-ext" aria-labelledby="bv-ext-bottom">
        <img src={emojiSrc(emoji)} alt="" width="44" height="44" />
        <div>
          <p id="bv-ext-bottom" data-i18n="berufe.pflege.box">Du willst mehr für die Pflege lernen? Auf pflegeplace.com gibt es viel mehr: den ganzen Fachwortschatz, Kurse und Hilfe für die Prüfung.</p>
          <a class="bv-ext-cta" href={ext.href} rel="noopener"><span data-i18n="berufe.pflege.cta">Weiter zu pflegeplace.com</span>&nbsp;↗</a>
        </div>
      </aside>
    )}

    <p class="bv-back"><a href="/berufe" data-i18n="berufe.back.hub">← Alle Berufe</a></p>
  </main>
</Layout>

<script>
  import { mountLeichteSprache } from "../../../lib/leichteSprache.js";
  mountLeichteSprache(document);
</script>
