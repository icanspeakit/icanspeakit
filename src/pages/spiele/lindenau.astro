---
// /spiele/lindenau — a small town RPG: walk through Lindenau and run A1 errands by talking to
// the mascots – pick the right reply or tap a sentence together. Two parts of town: the
// morning (Bäckerei, Bahnhof, Arztpraxis) and, once that is done, the afternoon (Supermarkt,
// Nachbarin, Café). Logic: src/lib/lindenau/game.js, content: src/lib/lindenau/quests.js.
// Since 2026-10-22 in the „Spiele“ menu, indexable, in every UI language (ld.* keys) and in
// the Android app; the dialogue itself is the German being learnt (EXPERIMENTE.md).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SectionMascot from "../../components/mascots/SectionMascot.astro";
import { AREAS } from "../../lib/lindenau/quests.js";
import "../../styles/practice.css";
import "../../styles/fuehrerschein.css";
import "../../styles/stadtfahrt.css";
import "../../styles/lindenau.css";
---
<Layout
  title="Die Legende von Lindenau: Deutsch-Rollenspiel im Browser – EnglishAcademy"
  description="Ein kleines Rollenspiel für Deutsch A1: Lauf durch Lindenau, kauf Brötchen, eine Fahrkarte und mach einen Arzttermin – im Gespräch mit den Leuten in der Stadt."
>
  <SiteNav active="ueben" />
  <main class="practice-main fs-page sf-page ld-page">
    <section id="ld-intro">
      <div class="practice-hero fs-hero">
        <p class="eyebrow" data-i18n="ld.eyebrow">Spiel · A1</p>
        <h1 data-i18n="ld.title">Die Legende von Lindenau</h1>
        <p data-i18n="ld.lead">Du bist neu in Lindenau. Lauf durch die Stadt, sprich mit den Leuten und erledige deine Aufgaben – erst am Morgen, dann am Nachmittag.</p>
      </div>
      <section class="fs-box">
        <h2 data-i18n="ld.howTitle">So spielst du</h2>
        <ul class="fs-facts">
          <li><b>👆</b><span data-i18n="ld.howWalk">Tipp auf die Stelle, wo du hinwillst – oder lauf mit den Pfeiltasten.</span></li>
          <li><b>❗</b><span data-i18n="ld.howTalk">Wer ein Ausrufezeichen hat, hat eine Aufgabe für dich. Tipp drauf oder drück Enter.</span></li>
          <li><b>💬</b><span data-i18n="ld.howAnswer">Wähl die passende Antwort oder bau den Satz aus Wörtern. Falsch? Kein Problem – probier's nochmal.</span></li>
          <li><b>🔊 💡</b><span data-i18n="ld.howHelp">Anhören und Hilfe gibt es bei jedem Satz.</span></li>
          <li><b>🦸</b><span data-i18n="ld.howAction2">Du bist Super-Blubb! Leertaste = springen, ↓ = ducken, X = Seifenblasen. Spring auf die Monster oder stoß von unten gegen ihre Kiste. Mach die Matschmonster sauber – am Anfang und nach jeder Aufgabe ist Schmutz-Alarm.</span></li>
        </ul>
        <label class="ld-action-opt">
          <input type="checkbox" id="ld-action" checked />
          <span data-i18n="ld.actionOpt">Mit Action-Teilen (Springen und Seifenblasen)</span>
        </label>
        <h2 data-i18n="ld.areasTitle">Wohin heute?</h2>
        <div class="ld-areas" role="group" aria-label="Stadtteil wählen" data-i18n-attr="aria-label:ld.areasLabel">
          {AREAS.map((a, k) => (
            <button type="button" class="ld-area" data-area={a.id} aria-pressed={k === 0 ? "true" : "false"}>
              <span class="ld-area-title" lang="de">{a.title}</span>
              <span class="ld-area-quests" lang="de">
                {a.quests.map((q) => <img src={`/img/openmoji/${q.item.icon}.svg`} alt="" width="22" height="22" />)}
                {a.quests.map((q) => q.role).join(" · ")}
              </span>
              {k > 0 && <span class="ld-area-lock" data-lock hidden data-i18n="ld.areaLocked">🔒 Erst den Morgen schaffen</span>}
            </button>
          ))}
        </div>
        <SectionMascot name="bruno" say="Komm, ich zeig dir die Stadt!" class="ku-hero-mascot" />
        <div class="fq-done-btns">
          <button type="button" class="quiz-btn quiz-btn--primary" id="ld-start" data-i18n="ld.start">Los geht's</button>
        </div>
      </section>
    </section>

    <section class="sf-game" id="ld-game" hidden>
      <div class="ld-hud">
        <ul class="ld-items" data-items aria-label="Deine Aufgaben" data-i18n-attr="aria-label:ld.tasks"></ul>
        <span class="ld-coins" data-coins role="img" aria-label="Münzen">🪙 <b data-coins-n>0</b></span>
        <button type="button" class="ld-sound" data-sound aria-pressed="true" aria-label="Musik und Töne" data-i18n-attr="aria-label:ld.sound">🔊</button>
        <button type="button" class="ld-sound ld-pausebtn" data-pause aria-label="Pause" data-i18n-attr="aria-label:ld.pause">⏸</button>
      </div>
      <div class="sf-stage ld-stage">
        <canvas class="sf-canvas" data-canvas tabindex="-1" role="img" aria-label="Spielfeld: die Stadt Lindenau von oben" data-i18n-attr="aria-label:ld.canvas"></canvas>
        <button type="button" class="ld-talk-btn" data-talk hidden>💬 <span data-talk-name data-i18n="ld.talk">Sprechen</span> <kbd data-i18n="ld.space">Enter</kbd></button>
        <span class="ld-clean" data-clean hidden></span>
        <div class="ld-town-pad" data-town-pad hidden>
          <button type="button" class="sf-key ld-act-shoot" data-tk="shoot" aria-label="Seifenblase" data-i18n-attr="aria-label:ld.actShoot">🫧<kbd class="ld-pad-kbd" aria-hidden="true">X</kbd></button>
          <button type="button" class="sf-key sf-key--gas" data-tk="jump" aria-label="Springen" data-i18n-attr="aria-label:ld.actJump">⤒<kbd class="ld-pad-kbd" aria-hidden="true" data-i18n="ld.space">Leertaste</kbd></button>
        </div>
        <div class="sf-panel ld-panel" data-panel hidden aria-live="polite"></div>
      </div>
    </section>
  </main>

  <script>
    import { actionOn, areaOpen, mountLindenau, setAction } from "../../lib/lindenau/game.js";
    import { setWaiting } from "../../lib/notReady.js";
    import { t } from "../../lib/uiText.js";

    const intro = document.getElementById("ld-intro")!;
    const game = document.getElementById("ld-game")!;
    const startBtn = document.getElementById("ld-start")!;
    const cards = [...document.querySelectorAll<HTMLButtonElement>("[data-area]")];
    const spiel = mountLindenau(game);
    const actionBox = document.getElementById("ld-action") as HTMLInputElement;
    actionBox.checked = actionOn();
    actionBox.addEventListener("change", () => setAction(actionBox.checked));

    // A locked part of town stays tappable and says why (src/lib/notReady.js). The newest open
    // one is picked, so a learner who finished the morning lands in the afternoon.
    let chosen = cards[0].dataset.area!;
    function paint() {
      for (const c of cards) {
        const open = areaOpen(c.dataset.area!);
        c.querySelector<HTMLElement>("[data-lock]")?.toggleAttribute("hidden", open);
        c.classList.toggle("is-locked", !open);
        setWaiting(c, open ? null : t("ld.areaLockedWhy", "Erst den Morgen in Lindenau schaffen – dann geht's hier weiter."));
        c.setAttribute("aria-pressed", String(c.dataset.area === chosen));
      }
    }
    chosen = [...cards].reverse().find((c) => areaOpen(c.dataset.area!))?.dataset.area ?? chosen;
    paint();
    for (const c of cards) c.addEventListener("click", () => {
      if (c.getAttribute("aria-disabled") === "true") return;
      chosen = c.dataset.area!;
      paint();
    });
    game.addEventListener("ld:area", (e) => { chosen = (e as CustomEvent<string>).detail; paint(); });
    // Back on the result screen (Escape, Android back): to the start screen.
    game.addEventListener("ld:exit", () => {
      game.hidden = true;
      intro.hidden = false;
      paint();
      startBtn.focus({ preventScroll: true });
      intro.scrollIntoView({ block: "start" });
    });

    startBtn.addEventListener("click", () => {
      intro.hidden = true;
      game.hidden = false;
      game.scrollIntoView({ block: "start" });
      spiel.start(chosen);
    });
  </script>
</Layout>
