---
// /spiele/vorfahrt — Quaki kreuzt: Bruno Kart's road and look, but with crossings. Before
// each one the learner decides by driving: brake (warten) or keep going (fahren), from the
// signs, the light and who else is there. A wrong choice ends in a near miss and a short
// „Warum?“ with the rule (German, with the learner's UI language underneath), and that kind
// of crossing comes back later in the drive. Also a Tagesfahrt: the same 20 crossings for
// everyone on that day. Logic: src/lib/vorfahrt/ (rules, game loop, renderer, page wiring).
// All texts are vf.* keys in public/i18n/*.json. noindex; listed in the games menu (catalog.js).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/artikel-sprint.css";
import "../../styles/vorfahrt.css";
---
<Layout
  title="Quaki kreuzt: Vorfahrtsregeln im Fahrspiel – EnglishAcademy"
  description="Ein Fahrspiel zur Führerschein-Theorie: An jeder Kreuzung entscheidest du – fahren oder warten, und blinkst du richtig? Rechts vor links, Vorfahrt achten, Stoppschild, Ampel, Grünpfeil, Kreisverkehr, Bahnübergang, Engstelle, Zebrastreifen."
  noindex
>
  <SiteNav active="ueben" />
  <main class="asp-page">
    <div class="asp vf" id="vorfahrt" data-phase="start">
      <div class="asp-hud" data-hud hidden>
        <span class="asp-hud-item vf-hearts" data-hearts role="img" aria-label="5 von 5 Herzen" title="Herzen: ein Fehler kostet eins, 8 richtig in Folge bringen eins zurück" data-i18n-attr="title:vf.heartsTitle"></span>
        <span class="asp-hud-item"><span class="asp-hud-k"><span class="asp-long" data-i18n="vf.points">Punkte</span><span class="asp-short" data-i18n="vf.pts">Pkt.</span></span> <b data-score>0</b></span>
        <span class="asp-hud-item"><span class="asp-hud-k" data-i18n="vf.streak">Serie</span> <b data-streak>0</b></span>
        <span class="asp-hud-item" title="Kreuzungen" data-i18n-attr="title:vf.crossings"><span class="asp-hud-k vf-cross" aria-hidden="true">✚</span><b data-n>0</b><span class="vf-errs-of" data-n-of></span><span class="asp-sr" data-i18n="vf.crossings">Kreuzungen</span></span>
        <span class="asp-hud-tools">
          <button type="button" class="asp-icon-btn" data-pause aria-label="Pause (P)" title="Pause (P)" data-i18n-attr="aria-label:vf.pauseBtn;title:vf.pauseBtn">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/></svg>
          </button>
          <button type="button" class="asp-icon-btn" data-mute aria-pressed="false" aria-label="Ton aus" title="Ton aus" data-i18n-attr="aria-label:vf.soundOff;title:vf.soundOff">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
          </button>
        </span>
      </div>

      <div class="asp-stage" data-stage tabindex="-1">
        <canvas class="asp-canvas" data-canvas role="img" aria-label="Spielfeld: eine Straße mit Kreuzungen, du fährst das rote Auto" data-i18n-attr="aria-label:vf.canvas"></canvas>

        <!-- Where the route goes at the next crossing, and the question -->
        <div class="vf-nav" aria-live="polite">
          <span class="vf-arrow" data-arrow aria-hidden="true">⬆</span>
          <span class="vf-turn" data-turn>geradeaus</span>
          <span class="vf-again" data-retry hidden data-i18n="vf.again">Nochmal geübt</span>
          <span class="vf-ask" data-ask data-i18n="vf.ask">Fahren oder warten?</span>
        </div>

        <div class="vf-ctl">
          <button type="button" class="vf-blink" data-blink="left" aria-pressed="false" aria-label="Links blinken" title="Links blinken (←)" data-i18n-attr="aria-label:vf.blinkL;title:vf.blinkLKey"><span aria-hidden="true">◀</span></button>
          <button type="button" class="vf-btn vf-btn--wait" data-act="wait" aria-pressed="false"><span aria-hidden="true">✋</span> <span data-i18n="vf.wait">Warten</span></button>
          <button type="button" class="vf-btn vf-btn--go" data-act="go" aria-pressed="false"><span data-i18n="vf.go">Fahren</span> <span aria-hidden="true">▶</span></button>
          <button type="button" class="vf-blink" data-blink="right" aria-pressed="false" aria-label="Rechts blinken" title="Rechts blinken (→)" data-i18n-attr="aria-label:vf.blinkR;title:vf.blinkRKey"><span aria-hidden="true">▶</span></button>
        </div>

        <p class="asp-toast vf-toast" data-toast hidden role="status"></p>

        <!-- Start -->
        <section class="asp-screen" data-screen="start">
          <div class="asp-card">
            <h1 class="asp-title">Quaki kreuzt</h1>
            <p class="asp-lead" data-i18n-html="vf.lead">Wer fährt zuerst? An jeder Kreuzung entscheidest du: <b>fahren</b> oder <b>warten</b>.</p>
            <button type="button" class="asp-btn asp-btn--go" data-start data-i18n="vf.start">Losfahren</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-daily data-i18n="vf.daily">Tagesfahrt</button>
            <p class="asp-best" data-best></p>
            <p class="asp-best" data-daily-info></p>
            <details class="asp-how" open>
              <summary data-i18n="vf.how">So geht's</summary>
              <ul>
                <li data-i18n-html="vf.how1"><b>Warten:</b> Knopf „Warten“, nach unten wischen · <kbd>↓</kbd> oder <kbd>Leertaste</kbd>. Du bremst bis zur Haltlinie.</li>
                <li data-i18n-html="vf.how2"><b>Fahren:</b> Knopf „Fahren“, nach oben wischen · <kbd>↑</kbd> – oder einfach nichts tun.</li>
                <li data-i18n="vf.how3">Bis kurz vor der Kreuzung kannst du dich umentscheiden. Der Pfeil oben zeigt, wohin du fährst.</li>
                <li data-i18n-html="vf.howBlink"><b>Blinken:</b> Zeigt das Navi nach links oder rechts, setz vorher den Blinker – Knöpfe ◀ ▶, zur Seite wischen · <kbd>←</kbd> <kbd>→</kbd>. Geradeaus und in den Kreisverkehr hinein: kein Blinker.</li>
                <li data-i18n-html="vf.howLook">Schau auf <b>Schilder</b>, <b>Ampel</b>, <b>Autos von rechts und links</b>, den <b>Gegenverkehr</b>, <b>Fußgänger</b> – und auf <b>Kreisverkehr</b>, <b>Bahnübergang</b> und <b>Engstellen</b>.</li>
                <li data-i18n="vf.howHearts">Du hast 5 Herzen. Jeder Fehler kostet eins, und du siehst, warum. 8 richtig in Folge bringen ein Herz zurück.</li>
                <li data-i18n="vf.how6">Was du falsch hattest, kommt kurz danach noch einmal – so bleibt die Regel hängen.</li>
              </ul>
            </details>
          </div>
        </section>

        <!-- Pause -->
        <section class="asp-screen" data-screen="pause" hidden>
          <div class="asp-card asp-card--small">
            <h2 class="asp-title" data-i18n="vf.pause">Pause</h2>
            <button type="button" class="asp-btn asp-btn--go" data-resume data-i18n="vf.resume">Weiter</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-quit data-i18n="vf.quit">Beenden</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-mute aria-pressed="false">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z" fill="currentColor"/><path class="asp-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13"/><path class="asp-sound-off" d="m16 9 6 6m0-6-6 6"/></svg>
              <span data-i18n="vf.sound">Ton</span>
            </button>
            <div data-melden></div>
          </div>
        </section>

        <!-- Why: after a wrong choice. The German explanation first, the learner's language under it. -->
        <section class="asp-screen" data-screen="card" hidden>
          <div class="asp-card vf-card">
            <h2 class="asp-title asp-title--sm" data-c-title>Das war knapp!</h2>
            <p class="vf-should" data-c-should></p>
            <p class="vf-why" data-c-why lang="de" dir="ltr"></p>
            <p class="vf-why vf-tr" data-c-tr hidden></p>
            <p class="vf-sign" data-c-sign lang="de" dir="ltr"></p>
            <p class="vf-left" data-c-left></p>
            <p class="vf-back" data-c-back hidden></p>
            <button type="button" class="asp-btn asp-btn--go" data-c-go>Weiter</button>
            <a class="asp-btn asp-btn--quiet" data-c-link href="/fuehrerschein/regeln/vorfahrt" target="_blank" rel="noopener" data-i18n="vf.card.read">Regel nachlesen</a>
            <div data-melden></div>
          </div>
        </section>

        <!-- Game over -->
        <section class="asp-screen" data-screen="over" hidden>
          <div class="asp-card">
            <h2 class="asp-title" data-o-title>Fahrt vorbei</h2>
            <p class="asp-score"><b data-o-score>0</b> <span data-i18n="vf.over.points">Punkte</span></p>
            <p class="asp-record" data-o-record hidden>Neuer Rekord!</p>
            <dl class="asp-stats">
              <div><dt data-i18n="vf.crossings">Kreuzungen</dt><dd data-o-n>0</dd></div>
              <div><dt data-i18n="vf.over.right">Richtig</dt><dd data-o-right>0</dd></div>
              <div><dt data-i18n="vf.over.streak">Beste Serie</dt><dd data-o-streak>0</dd></div>
              <div><dt data-o-best-k>Rekord</dt><dd data-o-best>0</dd></div>
            </dl>
            <div class="asp-missed vf-missed" data-o-missed-wrap hidden>
              <h3 data-i18n="vf.over.missed">Nochmal anschauen</h3>
              <ul data-o-missed></ul>
            </div>
            <button type="button" class="asp-btn asp-btn--go" data-again data-i18n="vf.over.again">Nochmal</button>
            <button type="button" class="asp-btn asp-btn--quiet" data-other>Tagesfahrt</button>
            <a class="asp-btn asp-btn--quiet" href="/fuehrerschein/regeln/vorfahrt" data-i18n="vf.over.lesson">Lektion Vorfahrt</a>
            <div data-melden></div>
          </div>
        </section>
      </div>
    </div>

    <section class="asp-about">
      <h2 data-i18n="vf.about.h">Worum geht's?</h2>
      <p data-i18n-html="vf.about.p1">Quaki kreuzt übt die Vorfahrtsregeln aus der Führerschein-Theorie: <b>rechts vor links</b>, <b>Vorfahrtstraße</b>, <b>Vorfahrt achten</b>, das <b>Stoppschild</b>, die <b>Ampel</b>, <b>Zebrastreifen</b>, <b>Linksabbiegen</b> mit Gegenverkehr und Fahrzeuge mit <b>Blaulicht</b>. Ein Übungsspiel – nicht die amtlichen Prüfungsfragen.</p>
      <p data-i18n-html="vf.about.p2">In Ruhe nachlesen: die Lektion <a href="/fuehrerschein/regeln/vorfahrt">Vorfahrt</a>.</p>
    </section>
  </main>

  <script>
    import { mountVorfahrt } from "../../lib/vorfahrt/main.js";
    const root = document.getElementById("vorfahrt");
    if (root) mountVorfahrt(root);
  </script>
</Layout>
