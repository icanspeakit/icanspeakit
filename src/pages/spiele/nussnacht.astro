---
// /spiele/nussnacht — Hamstis Nussnacht: an article survivor. Night in Hamsti's garden, word
// creatures crawl in from all sides; Hamsti fires on his own, the learner moves and switches
// the article of the shots (der / die / das). Right article hurts, wrong article makes the word
// angrier. Survive 10 minutes. Logic: src/lib/nussnacht/. Plan: NUSSNACHT-TIERED-PROMPT.md.
// A prototype since 2026-10-28: noindex and not in the menu (EXPERIMENTE.md).
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { woerterFuer, LEVELS } from "../../lib/nussnacht/woerter.js";
import { bosseFuer } from "../../lib/nussnacht/bosse.js";
import "../../styles/nussnacht.css";

// Each level's own words once; the page hands the level below to the game as the third.
const words = Object.fromEntries(LEVELS.map((lv) => [lv, woerterFuer(lv).words]));
const bosse = Object.fromEntries(LEVELS.map((lv) => {
  const { bosse: list, misses } = bosseFuer(lv);
  if (misses.length) console.warn(`[nussnacht] Bosse ohne Lexikon-Treffer (${lv}): ${misses.join(", ")}`);
  return [lv, list];
}));
const data = { words, bosse };
---
<Layout
  title="Hamsti's Nut Night: a, an or some in a survival game – EnglishAcademy"
  description="An article game in the browser: words crawl towards Hamsti from all sides. Choose a, an or some – only the right one hits. Survive for 10 minutes. A1 to B1."
  noindex
>
  <SiteNav active="ueben" />
  <main class="nn-page">
    <div class="nn" id="nussnacht" data-phase="start">
      <div class="nn-stage" data-stage data-cur-art="der">
        <canvas class="nn-canvas" data-canvas role="img" aria-label="Spielfeld: ein Garten bei Nacht, Hamsti in der Mitte, Wörter krabbeln auf ihn zu"></canvas>

        <div class="nn-hud" data-hud hidden>
          <span class="nn-hud-item nn-time" title="Zeit"><b data-time>0:00</b></span>
          <span class="nn-hud-item nn-lv" title="Level"><span class="nn-k">Lv</span> <b data-lv>1</b>
            <span class="nn-xp" aria-hidden="true"><span data-xp style="width:0%"></span></span></span>
          <span class="nn-hud-item" title="Besiegte Wörter"><span aria-hidden="true">🌰</span> <b data-kills>0</b></span>
          <button type="button" class="nn-icon" data-pause aria-label="Pause (Esc)" title="Pause (Esc)">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1.2" fill="currentColor"/></svg>
          </button>
        </div>

        <div class="nn-touch" data-touch hidden>
          <button type="button" class="nn-skill" data-skill title="Hamsterbacken-Wirbel: räumt alles um Hamsti weg (lädt 30 s) – Leertaste" aria-label="Hamsterbacken-Wirbel">
            <span class="nn-skill-fill" data-skill-fill style="width:0%"></span>
            <span class="nn-skill-label">🌀 <span class="nn-key">Leer</span></span>
          </button>
          <div class="nn-arts" role="group" aria-label="Artikel der Schüsse">
            <button type="button" class="nn-art nn-art--der" data-art="der" aria-pressed="true"><span class="nn-key">1</span>der</button>
            <button type="button" class="nn-art nn-art--die" data-art="die" aria-pressed="false"><span class="nn-key">2</span>die</button>
            <button type="button" class="nn-art nn-art--das" data-art="das" aria-pressed="false"><span class="nn-key">3</span>das</button>
          </div>
        </div>

        <div class="nn-stick" data-stick hidden aria-hidden="true"><div class="nn-knob" data-knob></div></div>
        <div class="nn-toast" data-toast hidden role="status"></div>
        <p class="nn-fps" data-fps hidden></p>

        <section class="nn-card nn-card--start" data-start data-nn-card>
          <p class="nn-eyebrow">Spiel · Prototyp</p>
          <h1>Hamstis Nussnacht</h1>
          <p class="nn-lead">Nacht im Garten. Von allen Seiten krabbeln Wörter auf Hamsti zu. Hamsti schießt von selbst – <b>du wählst den Artikel</b>: <span class="nn-a nn-a--der">der</span>, <span class="nn-a nn-a--die">die</span> oder <span class="nn-a nn-a--das">das</span>. Nur der richtige trifft. Der falsche macht das Wort größer und wütender. Überlebe 10 Minuten!</p>
          <p class="nn-label">Niveau</p>
          <div class="nn-seg" role="group" aria-label="Niveau">
            {LEVELS.map((lv) => (
              <button type="button" class="nn-seg-btn" data-level={lv} aria-pressed={lv === "A1" ? "true" : "false"}>{lv}<small>{words[lv].length} Wörter</small></button>
            ))}
          </div>
          <button type="button" class="nn-go" data-play>Los geht's</button>
          <details class="nn-how">
            <summary>So geht's</summary>
            <ul>
              <li><b>Computer:</b> WASD oder Pfeiltasten = laufen. 1 / 2 / 3 oder J / K / L = der / die / das. Leertaste = Wirbel. Esc = Pause.</li>
              <li><b>Handy:</b> links mit dem Daumen laufen (der Knopf erscheint, wo du tippst), rechts der / die / das tippen.</li>
              <li>Hamsti zielt auf das nächste Wort mit deinem Artikel. Ist keins in der Nähe, trifft er das nächste – und mit dem falschen Artikel wird es nur größer.</li>
              <li>Besiegte Wörter lassen Nüsse fallen. Volle Backen = Level-up: Such dir eins von drei Extras aus.</li>
              <li>Jede Minute kommt ein Boss – ein berühmtes Artikel-Rätsel. Besiegst du ihn, siehst du die Regel.</li>
            </ul>
          </details>
        </section>

        <section class="nn-card nn-card--up" data-up data-nn-card hidden role="dialog" aria-modal="true" aria-labelledby="nn-up-h">
          <h2 id="nn-up-h" data-up-title>Level 2!</h2>
          <p class="nn-muted">Such dir eins aus (1, 2 oder 3).</p>
          <div class="nn-up-list" data-up-list></div>
        </section>

        <section class="nn-card nn-card--pause" data-pause-card data-nn-card hidden role="dialog" aria-modal="true" aria-labelledby="nn-pause-h">
          <h2 id="nn-pause-h">Pause</h2>
          <button type="button" class="nn-go" data-pause-go>Weiter</button>
          <button type="button" class="nn-quiet" data-pause-restart>Neu starten</button>
          <button type="button" class="nn-quiet" data-pause-quit>Beenden</button>
        </section>

        <section class="nn-card nn-card--end" data-end data-nn-card hidden>
          <h2 data-end-title>Erwischt!</h2>
          <div data-result></div>
          <button type="button" class="nn-go" data-again>Noch eine Nacht</button>
          <button type="button" class="nn-quiet" data-back>Niveau wechseln</button>
        </section>
      </div>
    </div>
  </main>

  <script type="application/json" id="nn-data" set:html={JSON.stringify(data)}></script>
  <script>
    import { mountNussnacht } from "../../lib/nussnacht/main.js";
    const root = document.getElementById("nussnacht");
    const data = JSON.parse(document.getElementById("nn-data")?.textContent || "{}");
    if (root) mountNussnacht(root, data);
  </script>
</Layout>
