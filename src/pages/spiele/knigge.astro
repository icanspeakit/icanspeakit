---
// /spiele/knigge — Der Knigge-Simulator: manners and small talk in Germany as a little life
// sim (A2–B1). Pick a mascot, live through a day of scenes, and every reply moves the
// Sympathie of the person you talk to and your Ruf. Logic: src/lib/knigge/game.js, scenes:
// src/lib/knigge/scenes.js. A prototype (EXPERIMENTE.md): noindex, not in the „Spiele“ menu.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { mascotSvg, MASCOT_LABELS } from "../../lib/mascots.js";
import { PLAYERS } from "../../lib/knigge/scenes.js";
import "../../styles/practice.css";
import "../../styles/fuehrerschein.css";
import "../../styles/stadtfahrt.css";
import "../../styles/knigge.css";
---
<Layout
  title="Der Knigge-Simulator: Benehmen & Smalltalk in Deutschland – EnglishAcademy"
  description="Ein kleines Lebens-Spiel über Benehmen und Smalltalk in Deutschland (A2–B1): Bäckerei, S-Bahn, Büro, Nachbarn, Date. Jede Antwort macht dich sympathischer – oder nicht."
  noindex
>
  <SiteNav active="ueben" />
  <main class="practice-main fs-page kn-page">
    <section id="kn-intro">
      <div class="practice-hero fs-hero">
        <p class="eyebrow" data-i18n="kn.eyebrow">Spiel · A2–B1</p>
        <h1 data-i18n="kn.title">Der Knigge-Simulator</h1>
        <p data-i18n="kn.lead">Benehmen & Smalltalk in Deutschland: Erleb einen ganzen Tag – unterwegs, bei der Arbeit, mit den Nachbarn, beim Date und im Deutschkurs. Jede Antwort macht dich sympathischer. Oder eben nicht.</p>
      </div>
      <section class="fs-box">
        <h2 data-i18n="kn.howTitle">So spielst du</h2>
        <ul class="fs-facts">
          <li><b>💬</b><span data-i18n="kn.howTalk">Jemand spricht dich an. Wähl eine von 3–4 Antworten (oder Taste 1–4).</span></li>
          <li><b>❤️</b><span data-i18n="kn.howSymp">Jede Antwort ändert die Sympathie der Person – und deinen Ruf. Es gibt nicht nur eine richtige Antwort.</span></li>
          <li><b>🤔</b><span data-i18n="kn.howWhy">Nach jeder Wahl steht da, warum. Auch bei guten Antworten.</span></li>
          <li><b>🔊 💡</b><span data-i18n="kn.howHelp">Anhören und Hilfe gibt es bei jedem Satz.</span></li>
        </ul>
        <h2 data-i18n="kn.pickTitle">Wer bist du heute?</h2>
        <div class="kn-picker" role="group" aria-label="Figur wählen" data-i18n-attr="aria-label:kn.pickLabel">
          {PLAYERS.map((name) => (
            <button type="button" class="kn-pick" data-player={name} aria-pressed="false">
              <Fragment set:html={mascotSvg({ name, size: 72, label: "" })} />
              <span>{MASCOT_LABELS[name] ?? name}</span>
            </button>
          ))}
        </div>
        <div class="fq-done-btns">
          <button type="button" class="quiz-btn quiz-btn--primary" id="kn-start" data-i18n="kn.start">Los geht's</button>
        </div>
      </section>
    </section>

    <section class="kn-game" id="kn-game" hidden>
      <div class="kn-top">
      <div class="kn-hud">
        <span class="kn-ruf" data-ruf role="img" aria-label="Ruf: 50 von 100">
          <span class="kn-ruf-k" data-i18n="kn.ruf">Ruf</span>
          <span class="kn-bar-track kn-ruf-track"><i data-ruf-bar style="width:50%"></i></span>
          <b data-ruf-n>50</b>
        </span>
        <button type="button" class="sf-icon-btn" data-sound aria-pressed="true" aria-label="Stimmen an/aus" data-i18n-attr="aria-label:kn.sound">🔊</button>
      </div>
      <div class="kn-stage" data-stage></div>
      </div>
      <div class="kn-sheet" data-sheet aria-live="polite"></div>
      <p class="kn-sr" data-live aria-live="polite"></p>
    </section>
  </main>

  <script>
    import { mountKnigge, setPlayer, storedPlayer } from "../../lib/knigge/game.js";

    const intro = document.getElementById("kn-intro")!;
    const game = document.getElementById("kn-game")!;
    const startBtn = document.getElementById("kn-start")!;
    const picks = [...document.querySelectorAll<HTMLButtonElement>("[data-player]")];
    const spiel = mountKnigge(game);

    let chosen = storedPlayer();
    const paint = () => picks.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.player === chosen)));
    paint();
    for (const b of picks) b.addEventListener("click", () => { chosen = b.dataset.player!; setPlayer(chosen); paint(); });

    game.addEventListener("kn:exit", () => {
      game.hidden = true;
      intro.hidden = false;
      startBtn.focus({ preventScroll: true });
      intro.scrollIntoView({ block: "start" });
    });
    startBtn.addEventListener("click", () => {
      setPlayer(chosen);
      intro.hidden = true;
      game.hidden = false;
      game.scrollIntoView({ block: "start" });
      spiel.start();
    });
  </script>
</Layout>
