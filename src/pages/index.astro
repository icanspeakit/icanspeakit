---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import ExerciseGrid from '../components/ExerciseGrid.astro';
import DashboardShell from '../components/dashboard/DashboardShell.astro';
import { topics } from '../data/exercises/topics';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const dateFmt = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Layout title="icanspeak.it — Word origins & speaking practice" altHref="/de/">
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">A language hub for the curious</p>
      <h1>Every word has a story. Every sound has a mechanism.</h1>
      <p class="lede">
        icanspeak.it is a small, ad-free corner of the internet about language — where words came from,
        and how to actually say them. Dig into etymology, or train the sounds, stress, and rhythm of
        English with audio-driven exercises that explain the mechanics instead of just scoring your accent.
      </p>
      <div class="hero__actions">
        <a href="/exercises/" class="button button--primary">Start practicing</a>
        <a href="/blog/" class="button button--ghost">Read the blog</a>
      </div>
    </div>
  </section>

  <section class="progress-teaser">
    <div class="container progress-teaser__intro">
      <p class="eyebrow">New</p>
      <h2>Watch your practice add up</h2>
      <p class="text-muted">
        One dashboard for every format: practice the drills, check real accuracy and session history, or
        see all seven at a glance. Try it live below, or open it full-screen.
      </p>
      <a href="/dashboard/" class="button button--primary">Open full-screen →</a>
    </div>
    <div class="container">
      <DashboardShell activeLens="progress" />
    </div>
  </section>

  <section class="practice">
    <div class="container">
      <div class="section-head practice__head">
        <div>
          <p class="eyebrow">Practice</p>
          <h2>Sound mechanics, not accent scores</h2>
        </div>
        <span class="practice__count">{topics.length} formats</span>
      </div>
      <ExerciseGrid topics={topics} />
    </div>
  </section>

  <section class="why">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why bother with etymology?</p>
        <h2>Because language is the longest-running story we've ever told</h2>
      </div>
      <div class="why__grid">
        <a class="card why-card" href="/blog/salary-a-tiny-history-lesson/">
          <h3>Every word is a tiny history lesson</h3>
          <p class="text-muted">
            "Salary" comes from the Latin for salt, once part of a Roman soldier's pay. Say the word and
            you're quoting a two-thousand-year-old paycheck.
          </p>
          <span class="why-card__more">Read the full story →</span>
        </a>
        <a class="card why-card" href="/blog/how-languages-borrow-from-each-other/">
          <h3>Languages secretly borrow from each other</h3>
          <p class="text-muted">
            English alone has pulled words from more than 350 languages. "Ketchup" traveled from a Hokkien
            fish sauce through Malay trade routes before it ever met a tomato.
          </p>
          <span class="why-card__more">Read the full story →</span>
        </a>
        <a class="card why-card" href="/blog/how-word-meanings-drift/">
          <h3>Meanings drift — sometimes on purpose</h3>
          <p class="text-muted">
            "Nice" once meant "foolish" in Latin. Give a word three centuries and enough gossip, and it can
            end up meaning almost the opposite of where it started.
          </p>
          <span class="why-card__more">Read the full story →</span>
        </a>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="latest">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">From the blog</p>
          <h2>Recent deep dives</h2>
        </div>
        <div class="latest__grid">
          {posts.map((post) => (
            <a class="post-card" href={`/blog/${post.id}/`}>
              {post.data.word && <span class="tag">{post.data.word}</span>}
              <h3>{post.data.title}</h3>
              <p class="text-muted">{post.data.description}</p>
              <span class="post-card__date">{dateFmt.format(post.data.pubDate)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="cta">
    <div class="container cta__inner">
      <p class="eyebrow">Keep going</p>
      <h2>Pick a word, pull the thread</h2>
      <p class="lede">
        The word-card wall has bite-sized origin stories you can flip through in a coffee break —
        false friends, loanwords, and words invented on purpose.
      </p>
      <a href="/words/" class="button button--primary">Open the word cards</a>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block-start: clamp(3.5rem, 7vw, 6rem); }
  .hero__inner { max-width: 46rem; }
  .hero h1 { margin-block: 0.75rem 1.25rem; }
  .hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-block-start: 1.75rem; }

  .progress-teaser__intro {
    max-width: 42rem;
    margin-block-end: clamp(1.5rem, 3vw, 2rem);
  }

  .progress-teaser__intro h2 {
    margin-block: 0.6rem 0.75rem;
  }

  .progress-teaser__intro .button {
    margin-block-start: 1.5rem;
  }

  .practice { padding-block-start: 0; }

  .practice__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .practice__count {
    font-size: 0.85rem;
    color: var(--color-muted);
    white-space: nowrap;
  }

  .why__grid,
  .latest__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .why__grid h3 { margin-block-end: 0.6rem; }

  .why-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .why-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .why-card__more {
    margin-block-start: auto;
    padding-block-start: 0.9rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-primary);
  }

  @media (max-width: 860px) {
    .why__grid, .latest__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .why__grid, .latest__grid { grid-template-columns: 1fr; }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 2vw, 1.5rem);
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .post-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .post-card h3 { font-size: 1.15rem; }
  .post-card__date { font-size: 0.8rem; color: var(--color-muted); margin-block-start: auto; }

  .cta {
    background: var(--color-bg-soft);
    border-block: 1px solid var(--color-border);
  }

  .cta__inner { max-width: 40rem; text-align: left; }
  .cta__inner h2 { margin-block: 0.5rem 0.9rem; }
  .cta__inner .button { margin-block-start: 1.5rem; }
</style>
