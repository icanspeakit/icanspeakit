---
// /beitreten — a student joins a teacher's class with the six-character code (or the QR
// link /beitreten?code=XXXXXX). Before the button, a plain list of what the teacher will
// and will not see: that list is the consent (KLASSEN-TIERED-PROMPT.md, Tier 1).
//
// Static; who is signed in is settled in the browser. Signed out → /anmelden, which comes
// back here with the code still in the URL. Joining itself is the klasse_beitreten()
// database function (src/lib/klassen.js).
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import KlassenConsent from "../components/klassen/KlassenConsent.astro";
import "../styles/live-quiz.css";
import "../styles/klassen.css";
---
<Layout
  title="Einer Klasse beitreten – EnglishAcademy"
  description="Mit dem Code deiner Lehrkraft einer Klasse beitreten. Vorher siehst du genau, was deine Lehrkraft sieht und was nicht."
  noindex
>
  <SiteNav />

  <main class="lq kl" id="kl-join">
    <header class="lq-head">
      <p class="lq-eyebrow" data-i18n="kl.join.eyebrow">Klasse</p>
      <h1 class="lq-title" data-i18n="kl.join.title">Einer Klasse beitreten</h1>
      <p class="lq-lead" data-i18n="kl.join.lead">Deine Lehrkraft hat dir einen Code oder einen QR-Code gegeben. Damit sieht sie, was du hier übst, und kann dir besser helfen.</p>
    </header>

    <section class="lq-card" data-gate="loading">
      <p data-i18n="kl.loading">Einen Moment …</p>
    </section>

    <section class="lq-card kl-stack" data-gate="signin" hidden>
      <h2 data-i18n="kl.join.signin.title">Erst anmelden</h2>
      <p data-i18n="kl.join.signin.text">Eine Klasse gehört zu deinem Konto, damit deine Lehrkraft dich auf jedem Gerät wiederfindet. Das Konto ist kostenlos. Danach kommst du hierher zurück, der Code bleibt drin.</p>
      <a class="lq-btn lq-btn--primary" data-signin-link href="/anmelden?next=/beitreten" data-i18n="kl.join.signin.button">Anmelden oder registrieren</a>
    </section>

    <form class="kl-stack" data-gate="form" hidden novalidate>
      <div class="lq-card kl-stack">
        <label class="lq-field">
          <span data-i18n="kl.join.code">Code</span>
          <input type="text" class="kl-code-input" data-code maxlength="7" autocomplete="off" autocapitalize="characters" spellcheck="false" inputmode="text" placeholder="ABC234" required />
        </label>
        <label class="lq-field">
          <span data-i18n="kl.join.name">Dein Name in der Klasse</span>
          <input type="text" data-name maxlength="40" autocomplete="given-name" required />
          <small data-i18n="kl.join.nameHint">So sieht dich deine Lehrkraft. Deine E-Mail-Adresse sieht sie nicht.</small>
        </label>
      </div>

      <KlassenConsent />

      <p class="lq-error" data-error role="alert"></p>
      <button type="submit" class="lq-btn lq-btn--primary lq-btn--block" data-submit data-i18n="kl.join.button">Beitreten</button>
    </form>

    <section class="lq-card kl-stack kl-done" data-gate="done" hidden>
      <h2 data-done-title></h2>
      <p data-i18n="kl.join.done.text">Ab jetzt sieht deine Lehrkraft, was du hier übst. Verlassen kannst du die Klasse jederzeit in deinem Konto.</p>
      <div class="kl-row">
        <a class="lq-btn lq-btn--primary" href="/uebungen" data-i18n="kl.join.done.practice">Weiter üben</a>
        <a class="lq-btn lq-btn--ghost" href="/konto" data-i18n="kl.join.done.account">Meine Klassen</a>
      </div>
    </section>
  </main>

  <script>
    import { createBrowserSupabase } from "../lib/supabase/browser.js";
    import { beitreten, isCode, normCode } from "../lib/klassen.js";
    import { loadText, t } from "../lib/liveQuiz/text.js";

    const root = document.getElementById("kl-join")!;
    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const gates = [...root.querySelectorAll<HTMLElement>("[data-gate]")];
    const gate = (name: string) => gates.forEach((g) => (g.hidden = g.dataset.gate !== name));

    const ERR: Record<string, [string, string]> = {
      code: ["kl.join.err.code", "Diesen Code gibt es nicht. Prüf ihn noch einmal, oder frag deine Lehrkraft nach dem aktuellen Code."],
      limit: ["kl.join.err.limit", "Zu viele falsche Codes. Warte eine Stunde und versuch es dann noch einmal."],
      voll: ["kl.join.err.full", "Diese Klasse ist voll (60 Personen). Sag deiner Lehrkraft Bescheid."],
      name: ["kl.join.err.name", "Schreib einen Namen, 1 bis 40 Zeichen."],
      anmelden: ["kl.join.err.signin", "Du bist nicht mehr angemeldet. Lade die Seite neu."],
      netz: ["kl.join.err.net", "Das hat gerade nicht geklappt. Prüf die Internetverbindung und versuch es noch einmal."],
    };

    (async () => {
      await loadText();
      const params = new URLSearchParams(location.search);
      const fromUrl = normCode(params.get("code"));
      $<HTMLAnchorElement>("[data-signin-link]").href = `/anmelden?next=${encodeURIComponent(location.pathname + location.search)}`;

      let user = null;
      try {
        user = (await createBrowserSupabase().auth.getSession()).data?.session?.user ?? null;
      } catch {}
      if (!user) return gate("signin");

      const codeIn = $<HTMLInputElement>("[data-code]");
      const nameIn = $<HTMLInputElement>("[data-name]");
      const error = $("[data-error]");
      const submit = $<HTMLButtonElement>("[data-submit]");
      codeIn.value = fromUrl;
      // A first name is a sensible default; the student can change it before joining.
      const full = String(user.user_metadata?.full_name || user.user_metadata?.name || "").trim();
      nameIn.value = full.split(/\s+/)[0]?.slice(0, 40) ?? "";
      gate("form");
      (fromUrl ? nameIn : codeIn).focus();

      codeIn.addEventListener("input", () => {
        codeIn.value = normCode(codeIn.value);
        error.textContent = "";
      });

      $<HTMLFormElement>("form").addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!isCode(codeIn.value)) {
          error.textContent = t("kl.join.err.format", "Der Code hat sechs Zeichen, Buchstaben und Ziffern, zum Beispiel ABC234.");
          return codeIn.focus();
        }
        if (!nameIn.value.trim()) {
          error.textContent = t(...ERR.name);
          return nameIn.focus();
        }
        submit.disabled = true;
        error.textContent = "";
        const res = await beitreten(codeIn.value, nameIn.value);
        submit.disabled = false;
        if (!res?.ok) {
          error.textContent = t(...(ERR[res?.fehler] ?? ERR.netz));
          return;
        }
        $("[data-done-title]").textContent = res.schon
          ? t("kl.join.done.already", "Du bist schon in der Klasse „{name}“.", { name: res.name })
          : t("kl.join.done.title", "Du bist jetzt in der Klasse „{name}“.", { name: res.name });
        gate("done");
        history.replaceState(null, "", location.pathname);
      });
    })();
  </script>
</Layout>
