---
// /entdecken: what „Entdecken" in the top bar opens when clicked – the same four cards as its
// menu (catalog.js navEntdecken), big, as a page of their own. The menu shows them on hover;
// on a phone and for a plain click this is where they are again.
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { mascotSvg } from "../../lib/mascots.js";
import { navEntdecken } from "../../lib/catalog.js";

const APP_BUILD = import.meta.env.PUBLIC_TARGET === "app";
const items = navEntdecken.items.filter((item) => !(APP_BUILD && item.shop));
---
<Layout
  title="Entdecken – EnglishAcademy"
  description="Mehr als Übungen: die Maskottchen, die Live-Fragestunde, kurze Filme, wie alles funktioniert, und Merch mit der Crew."
>
  <SiteNav active="entdecken" />
  <main class="en">
    <header class="en-head">
      <h1 data-i18n={navEntdecken.nameKey}>{navEntdecken.name}</h1>
      <p>Mehr als Übungen: wer dir hilft, wo du live fragen kannst und wie alles funktioniert.</p>
    </header>
    <ul class="en-cards">
      {items.map((item, i) => (
        <li style={`--d:${i * 70}ms`}>
          <a class="en-card" href={item.href}>
            <span class="en-fig" set:html={mascotSvg({ name: item.mascot, expr: item.expr, extra: item.extra, view: "three", size: 112, label: "" })} />
            <b data-i18n={item.titleKey}>{item.title}</b>
            <span class="en-hint" data-i18n={item.hintKey}>{item.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .en { max-width: 960px; margin: 0 auto; padding: 28px 16px 96px; }
  .en-head { margin-bottom: 24px; }
  .en-head h1 { margin: 0 0 8px; font-size: clamp(1.8rem, 5vw, 2.4rem); line-height: 1.1; }
  .en-head p { margin: 0; color: var(--muted); max-width: 52ch; }
  .en-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 820px) { .en-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .en-cards li { animation: en-in .45s var(--d, 0ms) ease-out both; }
  .en-card {
    display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%;
    padding: 18px 14px 20px; text-align: center; text-decoration: none; color: var(--ink);
    background: var(--blue-50); border: 1px solid var(--blue-200); border-radius: 18px;
    transition: transform .2s ease, border-color .2s ease;
  }
  .en-card:hover { transform: translateY(-3px); border-color: var(--brand-blue); }
  .en-card:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 3px; }
  .en-fig { display: grid; place-items: center; width: 112px; height: 112px; margin-bottom: 4px; transition: transform .2s ease; }
  .en-card:hover .en-fig { transform: rotate(-6deg) scale(1.05); }
  .en-card b { font-size: 1.05rem; line-height: 1.25; text-wrap: balance; }
  .en-hint { font-size: .88rem; line-height: 1.4; color: var(--muted); }
  @media (max-width: 420px) {
    .en-fig { width: 84px; height: 84px; }
    .en-fig :global(svg) { width: 84px; height: 84px; }
    .en-card { padding: 14px 10px 16px; }
  }
  @keyframes en-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .en-cards li { animation: none; }
    .en-card, .en-fig { transition: none; }
    .en-card:hover { transform: none; }
  }
</style>
