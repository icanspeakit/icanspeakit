---
// /politik — political education for learners: how debate and the party landscape work in
// Germany, Austria and Switzerland, ending in „Wo stehe ich?“ (POLITISCHE-BILDUNG-PROMPT.md).
//
// Rules that shape every line here (Beutelsbacher Konsens):
//   - No verdicts: the page explains positions, it never says which is right.
//   - Pro and contra get the same length and weight (checked by npm run check:politik).
//   - Parties in seat order (parliaments) or by country and seats (matrix), all drawn alike;
//     colours only to tell them apart, the abbreviation is always written next to them.
//   - Every number comes from src/data/politik/*.json, each with source and date.
//
// Two German registers (Einfaches Deutsch / Deutsch B1/B2) are both in the HTML; the switch
// (the site's Leichte-Sprache setting, src/lib/leichteSprache.js) shows one. Translations
// into the help languages sit under the German as machine drafts (GrammarHelp), driven by
// the header's language menu like every other text page.
//
// No analytics on this page (Layout noTracking): the quiz promises that nothing about the
// visitor leaves the browser, and that should be true of the whole page.
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import GrammarHelp from "../components/GrammarHelp.astro";
import GrammarHelpText from "../components/GrammarHelpText.astro";
import texte from "../data/politik/texte.json";
import glossar from "../data/politik/glossar.json";
import debatten from "../data/politik/debatten.json";
import quiz from "../data/politik/quiz.json";
import ches from "../data/politik/ches.json";
import parteien from "../data/politik/parteien.json";
import parlamente from "../data/politik/parlamente.json";
import ess from "../data/politik/selbsteinstufung.json";
import material from "../data/politik/material.json";
import uebersetzung from "../data/uebersetzungen/politik.json";
import ohneSitz from "../data/politik/ohne-sitz.json";
import HubBild from "../components/HubBild.astro";
import MascotComic from "../components/MascotComic.astro";
import { mascotSvg } from "../lib/mascots.js";
import { reg, rich, esc, num, matrixSvg, quadrantSvg, donutSvg, histogramSvg, shade } from "../lib/politik/render.js";
import "../styles/politik.css";

const T = texte;
const tr = (id: string) => (uebersetzung.entries as Record<string, Record<string, string>>)[id] ?? null;
// The same as plain text, for the parts the script writes with textContent (glossary, quiz).
const unesc = (s: string) => s.replace(/&(amp|lt|gt|quot);/g, (_, e) => ({ amp: "&", lt: "<", gt: ">", quot: '"' })[e as "amp"]);
const trText = (id: string) => { const t = tr(id); return t && Object.fromEntries(Object.entries(t).map(([l, v]) => [l, unesc(v)])); };
const COUNTRIES = [
  { code: "DE", name: "Deutschland" },
  { code: "AT", name: "Österreich" },
  { code: "CH", name: "Schweiz" },
];
const cname = (c: string) => COUNTRIES.find((x) => x.code === c)?.name ?? c;

// Parliaments, parties in seat order.
const parl = parlamente.parliaments.map((p: any) => ({
  ...p,
  parties: [...p.parties].sort((a: any, b: any) => b.seats - a.seats || a.abbrev.localeCompare(b.abbrev, "de")),
}));
const seatsOf = (country: string, parlAbbrev: string | null) =>
  parlAbbrev ? (parl.find((p: any) => p.country === country)?.parties.find((x: any) => x.abbrev === parlAbbrev)?.seats ?? 0) : 0;
const beschreibungen = { ...(parlamente as any).beschreibungen, ...ohneSitz } as Record<string, any>;
const descOf = (country: string, short: string) => beschreibungen[`${country}:${short}`]?.description_de ?? null;

// Matrix parties: CHES values joined to display data; by country, then seats, then name.
const meta = new Map(parteien.parties.map((p) => [p.ches, p]));
const matrixParties = ches.parties
  .map((c: any) => {
    const m: any = meta.get(c.ches_party_id);
    return m && {
      id: `${c.country}-${c.ches_party_id}`, country: c.country, short: m.short, name: m.name, color: m.color,
      x: c.lrecon, y: c.galtan, seats: seatsOf(c.country, m.parl), parl: m.parl,
      desc: descOf(c.country, m.short), ches: c,
    };
  })
  .filter(Boolean)
  .sort((a: any, b: any) => COUNTRIES.findIndex((x) => x.code === a.country) - COUNTRIES.findIndex((x) => x.code === b.country) || b.seats - a.seats || a.short.localeCompare(b.short, "de"));
const wave = ches.waves[0];
const axisLabels = {
  xLow: T.achsen.wirtschaft.pole.low.de, xHigh: T.achsen.wirtschaft.pole.high.de,
  yLow: T.achsen.gesellschaft.pole.low.de, yHigh: T.achsen.gesellschaft.pole.high.de,
  you: T.quiz.ergebnis.punkt.de,
  aria: "Parteien auf zwei Achsen: Wirtschaft (links–rechts) und Gesellschaft (GAL–TAN). Die Werte stehen auch in der Tabelle darunter.",
};

// What the script needs: parties (for tooltips and the quiz), glossary, quiz items, texts it builds at runtime.
const pageData = {
  parties: matrixParties.map(({ ches: _c, ...p }: any) => p),
  glossar: Object.fromEntries(Object.entries(glossar.terms).map(([id, g]: any) => [id, { ...g, tr: trText(`glossar.${id}`) }])),
  quiz: quiz.items.map((i) => ({ ...i, tr: trText(`quiz.${i.id}`) })),
  t: { quiz: T.quiz, matrix: T.matrix, parlamente: T.parlamente.rechner, debatten: { deineAntwort: T.debatten.deineAntwort, optionen: T.debatten.optionen } },
  wave: wave.year,
  parl: parl.map((p: any) => ({ country: p.country, total: p.total_seats, majority: p.majority })),
};

const debatteSources = debatten.items.filter((d) => d.ches);
const toolLinks = {
  DE: material.items.find((m: any) => m.id === "bpb-wahl-o-mat"),
  AT: material.items.find((m: any) => m.id === "at-wahlkabine"),
  CH: material.items.find((m: any) => m.id === "ch-smartvote"),
};
const datum = (iso: string) => new Date(iso).toLocaleDateString("de-DE", { day: "numeric", month: "long", year: "numeric" });

const toc = [
  ["pk-intro", T.intro.title], ["pk-achsen", T.achsen.title], ["pk-matrix", T.matrix.title], ["pk-parlamente", T.parlamente.title],
  ["pk-mitte", T.mitte.title], ["pk-debatten", T.debatten.title], ["pk-quiz", T.quiz.title], ["pk-material", T.material.title], ["pk-methoden", T.methoden.title],
] as const;
// One picture per section: on the contents tiles and in front of each heading.
const ICON: Record<string, string> = {
  "pk-intro": "💬", "pk-achsen": "🧭", "pk-matrix": "📍", "pk-parlamente": "🏛️", "pk-mitte": "📊",
  "pk-debatten": "⚖️", "pk-quiz": "🙋", "pk-material": "📚", "pk-methoden": "🔎",
};
const nOf = (id: string) => toc.findIndex(([x]) => x === id) + 1;
// A section heading: its number and picture, then the title in both registers.
const h2 = (id: string, title: any) => `<span class="pk-h2-badge" aria-hidden="true"><span class="pk-h2-icon">${ICON[id]}</span><span class="pk-h2-n">${nOf(id)}</span></span><span class="pk-h2-t">${reg(title)}</span>`;

// The mascot guides (texte.json → guide): how to read a section, never what to think.
// Decorative like SectionMascot: aria-hidden, and data-mascot-part so "Maskottchen: aus"
// removes them.
const guide = (key: keyof typeof T.guide, name: "bruno" | "regi" | "hamsti" | "quaki", expr = "happy", side = "left") =>
  `<div class="pk-guide pk-guide--${side}" data-mascot-part aria-hidden="true">${mascotSvg({ name, expr, view: "three", size: 64, label: "", className: "pk-guide-fig" })}<p class="pk-guide-say">${reg((T.guide as any)[key])}</p></div>`;
// Each parliament card shows its building (src/data/hub-bilder.json).
const BUILDING: Record<string, string> = { DE: "politik", AT: "politik-at", CH: "politik-ch" };
---
<Layout
  title="Politik in Deutschland, Österreich und der Schweiz – einfach erklärt | EnglishAcademy"
  description="Parteien, Parlamente und Streitfragen in Deutschland, Österreich und der Schweiz – neutral erklärt, mit Quellen, in einfachem Deutsch oder B1/B2. Mit Test: Wo stehe ich?"
  noTracking
>
  <script is:inline>
    try { if (localStorage.getItem("da-leichte-sprache") === "1") document.documentElement.classList.add("is-leicht"); } catch (e) {}
  </script>
  <SiteNav />

  <main class="pk" id="pk-page" lang="de" dir="ltr">
    <header class="pk-hero">
      <HubBild id="politik" />
      <p class="pk-eyebrow" set:html={reg(T.hero.eyebrow)} />
      <h1 set:html={reg(T.hero.title)} />
      <p class="pk-lead" set:html={reg(T.hero.lead)} />
      <GrammarHelpText text={tr("hero.lead")} />
      <Fragment set:html={guide("hero", "bruno", "happy")} />
      <div class="pk-level" role="group" aria-label={T.ui.level.de}>
        <span class="pk-level-label" set:html={reg(T.ui.level)} />
        <div class="pk-seg" data-level-switch>
          <button type="button" data-level="leicht" aria-pressed="false">{T.ui.einfach.de}</button>
          <button type="button" data-level="normal" aria-pressed="true">{T.ui.normal.de}</button>
        </div>
      </div>
      <GrammarHelp root="pk-page" reviewed={uebersetzung.reviewed} />
      <nav class="pk-toc" aria-label={T.ui.inhalt.de}>
        <ol>{toc.map(([id, t]) => <li><a href={`#${id}`}><span class="pk-toc-icon" aria-hidden="true">{ICON[id]}</span><span class="pk-toc-n" aria-hidden="true">{nOf(id)}</span><span class="pk-toc-t" set:html={reg(t)} /></a></li>)}</ol>
      </nav>
    </header>

    <!-- 3.1 Intro -->
    <section class="pk-sec" id="pk-intro" aria-labelledby="pk-intro-h">
      <h2 id="pk-intro-h" class="pk-head" set:html={h2("pk-intro", T.intro.title)} />
      {T.intro.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`intro.paras.${i}`)} /></Fragment>)}
      <p class="pk-howto" set:html={reg(T.intro.howto)} />
      <GrammarHelpText text={tr("intro.howto")} />
      {/* Disagreement and a vote, on a question that is not political: what the page means by
          „Streit ist normal". */}
      <div class="pk-comic"><MascotComic comic={T.comic as any} chip="form" fit /></div>
    </section>

    <!-- 3.2 Axes -->
    <section class="pk-sec" id="pk-achsen" aria-labelledby="pk-achsen-h">
      <h2 id="pk-achsen-h" class="pk-head" set:html={h2("pk-achsen", T.achsen.title)} />
      <Fragment set:html={guide("achsen", "regi", "thinking", "right")} />
      {T.achsen.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`achsen.paras.${i}`)} /></Fragment>)}
      <div class="pk-axes">
        {(["wirtschaft", "gesellschaft"] as const).map((k) => (
          <article class="pk-card">
            <h3 set:html={reg(T.achsen[k].title)} />
            <p set:html={reg(T.achsen[k].text)} />
            <GrammarHelpText text={tr(`achsen.${k}.text`)} />
            <p class="pk-example" set:html={reg(T.achsen[k].beispiel)} />
            <GrammarHelpText text={tr(`achsen.${k}.beispiel`)} />
            <div class="pk-scale" aria-hidden="true"><span set:html={reg(T.achsen[k].pole.low)} /><span class="pk-scale-bar" /><span set:html={reg(T.achsen[k].pole.high)} /></div>
          </article>
        ))}
      </div>
      <figure class="pk-figure pk-quad-fig">
        <figcaption set:html={reg(T.achsen.quadranten.title)} />
        <Fragment set:html={quadrantSvg(
          { lt: T.achsen.quadranten.items.lt.de, rt: T.achsen.quadranten.items.rt.de, lg: T.achsen.quadranten.items.lg.de, rg: T.achsen.quadranten.items.rg.de },
          { x: "Wirtschaft", ends: { left: T.achsen.wirtschaft.pole.low.de, right: T.achsen.wirtschaft.pole.high.de, top: T.achsen.gesellschaft.pole.high.de, bottom: T.achsen.gesellschaft.pole.low.de }, aria: "Vier Felder: oben Tradition, unten Wandel; links mehr Staat, rechts mehr Markt." },
        )} />
        <p class="pk-note" set:html={reg(T.achsen.quadranten.note)} />
        <GrammarHelpText text={tr("achsen.quadranten.note")} />
      </figure>
    </section>

    <!-- 3.3 Party matrix -->
    <section class="pk-sec" id="pk-matrix" aria-labelledby="pk-matrix-h">
      <h2 id="pk-matrix-h" class="pk-head" set:html={h2("pk-matrix", T.matrix.title)} />
      <Fragment set:html={guide("matrix", "quaki", "happy", "left")} />
      {T.matrix.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`matrix.paras.${i}`)} /></Fragment>)}
      <div class="pk-filter" role="group" aria-label={T.matrix.filter.de} data-country-filter>
        {[...COUNTRIES, { code: "ALL", name: T.matrix.alle.de }].map((c) => (
          <button type="button" data-country={c.code} aria-pressed={c.code === "DE" ? "true" : "false"}>{c.name}</button>
        ))}
      </div>
      <figure class="pk-figure pk-matrix-fig" data-matrix data-show="DE">
        <Fragment set:html={matrixSvg(matrixParties, axisLabels)} />
        <div class="pk-tip" data-tip hidden role="dialog" aria-live="polite"></div>
        <figcaption class="pk-source">{T.ui.quelle.de}: <a href={wave.url} rel="noopener">Chapel Hill Expert Survey {wave.year}</a> (Rovny u. a. 2025), Variablen lrecon und galtan.</figcaption>
      </figure>
      <p class="pk-note" set:html={reg(T.matrix.hinweis)} />
      <GrammarHelpText text={tr("matrix.hinweis")} />
      <details class="pk-table-wrap">
        <summary set:html={reg(T.matrix.tabelle)} />
        <div class="pk-scroll">
          <table class="pk-table">
            <thead><tr><th>Partei</th><th>Land</th><th class="pk-num">Wirtschaft (lrecon)</th><th class="pk-num">Gesellschaft (galtan)</th></tr></thead>
            <tbody>{matrixParties.map((p: any) => <tr><th scope="row"><span class="pk-swatch" style={`background:${p.color}`} />{p.short} <small>{p.name}</small></th><td>{p.country}</td><td class="pk-num">{num(p.x)}</td><td class="pk-num">{num(p.y)}</td></tr>)}</tbody>
          </table>
        </div>
      </details>
    </section>

    <!-- 3.4 Parliaments -->
    <section class="pk-sec" id="pk-parlamente" aria-labelledby="pk-parl-h">
      <h2 id="pk-parl-h" class="pk-head" set:html={h2("pk-parlamente", T.parlamente.title)} />
      <Fragment set:html={guide("parlamente", "hamsti", "happy", "right")} />
      {T.parlamente.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`parlamente.paras.${i}`)} /></Fragment>)}
      <div class="pk-parl-grid">
        {parl.map((p: any) => {
          const colorOf = (abbrev: string) => parteien.parties.find((x) => x.country === p.country && x.parl === abbrev)?.color ?? "#8a94a3";
          const list = p.parties.map((x: any) => ({ ...x, short: x.abbrev, color: colorOf(x.abbrev) }));
          return (
            <article class="pk-card pk-parl" data-parl={p.country}>
              <HubBild id={BUILDING[p.country]} variant="card" />
              <h3>{p.name} <small>{cname(p.country)}</small></h3>
              <Fragment set:html={donutSvg(list, p.total_seats, `${p.name}: ${list.map((x: any) => `${x.short} ${x.seats}`).join(", ")} von ${p.total_seats} Sitzen`)} />
              <p class="pk-parl-facts">
                <strong>{p.total_seats} <span set:html={reg(T.parlamente.sitze)} /></strong> ·
                <span class="pk-de">{T.parlamente.mehrheit.de.replace("{n}", p.majority)}</span><span class="pk-le">{T.parlamente.mehrheit.leicht.replace("{n}", p.majority)}</span>
              </p>
              <ul class="pk-legend">
                {list.map((x: any) => (
                  <li>
                    <label>
                      <input type="checkbox" data-coal value={x.seats} aria-label={`${x.short} (${x.seats})`} />
                      <span class="pk-swatch" style={`background:${x.color}`} />
                      <span class="pk-legend-name" title={x.name}>{x.short}</span>
                      <span class="pk-num">{x.seats}</span>
                    </label>
                  </li>
                ))}
              </ul>
              <p class="pk-coal" data-coal-out aria-live="polite"></p>
              <p class="pk-gov"><strong set:html={reg(T.parlamente.regierung)} />: {p.government.note}</p>
              {p.country === "CH" && <Fragment><p class="pk-note" set:html={reg(T.parlamente.ch_konkordanz)} /><GrammarHelpText text={tr("parlamente.ch_konkordanz")} /></Fragment>}
              <p class="pk-source">{T.ui.quelle.de}: <a href={p.source.url} rel="noopener">{p.source.label}</a>, {T.parlamente.stand.de} {datum(p.data_as_of)}{p.government.source?.url && <Fragment> · <a href={p.government.source.url} rel="noopener">{p.government.source.label}</a></Fragment>}</p>
            </article>
          );
        })}
      </div>
      <div class="pk-card pk-rechner">
        <h3 set:html={reg(T.parlamente.rechner.title)} />
        <p set:html={reg(T.parlamente.rechner.text)} />
        <GrammarHelpText text={tr("parlamente.rechner.text")} />
      </div>
    </section>

    <!-- 3.5 Self-placement -->
    <section class="pk-sec" id="pk-mitte" aria-labelledby="pk-mitte-h">
      <h2 id="pk-mitte-h" class="pk-head" set:html={h2("pk-mitte", T.mitte.title)} />
      <Fragment set:html={guide("mitte", "bruno", "thinking", "left")} />
      {T.mitte.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`mitte.paras.${i}`)} /></Fragment>)}
      <div class="pk-hist-grid">
        {ess.countries.map((c: any) => (
          <figure class="pk-card pk-figure">
            <figcaption><strong>{cname(c.country)}</strong> <span class="pk-de">{T.mitte.mittelwert.de.replace("{m}", num(c.mean))}</span><span class="pk-le">{T.mitte.mittelwert.leicht.replace("{m}", num(c.mean))}</span></figcaption>
            <Fragment set:html={histogramSvg(c, { mean: `Ø ${num(c.mean)}`, aria: `${cname(c.country)}: Anteile von 0 bis 10: ${c.shares.map((s: number, i: number) => `${i}: ${num(s)} %`).join(", ")}` })} />
            <p class="pk-tiny">{T.mitte.skala.de} · n = {c.n.toLocaleString("de-DE")} · <span class="pk-de">{T.mitte.keineAntwort.de.replace("{p}", num(c.missing_share))}</span><span class="pk-le">{T.mitte.keineAntwort.leicht.replace("{p}", num(c.missing_share))}</span></p>
          </figure>
        ))}
      </div>
      <p class="pk-source">{T.ui.quelle.de}: <a href={ess.source.url} rel="noopener">{ess.source.label}</a>, {ess.source.round}, Feldzeit {ess.source.fieldwork.split(" (")[0]}; gewichtet (pspwght). Kurve: Normalverteilung mit Mittelwert und Standardabweichung der Umfrage.</p>
      <details class="pk-table-wrap">
        <summary>Werte als Tabelle</summary>
        <div class="pk-scroll">
          <table class="pk-table">
            <thead><tr><th>Wert</th>{ess.countries.map((c: any) => <th class="pk-num">{cname(c.country)}</th>)}</tr></thead>
            <tbody>{Array.from({ length: 11 }, (_, i) => <tr><th scope="row">{i}</th>{ess.countries.map((c: any) => <td class="pk-num">{num(c.shares[i])} %</td>)}</tr>)}</tbody>
          </table>
        </div>
      </details>
    </section>

    <!-- 3.6 Debates -->
    <section class="pk-sec" id="pk-debatten" aria-labelledby="pk-deb-h">
      <h2 id="pk-deb-h" class="pk-head" set:html={h2("pk-debatten", T.debatten.title)} />
      <Fragment set:html={guide("debatten", "quaki", "thinking", "right")} />
      {T.debatten.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`debatten.paras.${i}`)} /></Fragment>)}
      <HubBild id="politik-debatte" variant="card" />
      <div class="pk-deb-list">
        {debatten.items.map((d) => (
          <article class="pk-card pk-deb" data-deb={d.id}>
            <h3><span aria-hidden="true">{d.icon}</span> <Fragment set:html={reg(d.title)} /></h3>
            <p class="pk-deb-q" set:html={reg(d.frage)} />
            <GrammarHelpText text={tr(`debatten.${d.id}.frage`)} />
            <div class="pk-procon">
              {(["pro", "contra"] as const).map((side) => (
                <div class={`pk-side pk-side--${side}`}>
                  <h4 set:html={reg(T.debatten[side])} />
                  <ul>{d[side].map((a, i) => <li><Fragment set:html={reg(a)} /><GrammarHelpText text={tr(`debatten.${d.id}.${side}.${i}`)} /></li>)}</ul>
                </div>
              ))}
            </div>
            <fieldset class="pk-mini" data-mini>
              <legend set:html={reg(T.debatten.umfrage)} />
              {(["ja", "unsicher", "nein"] as const).map((o) => (
                <label><input type="radio" name={`mini-${d.id}`} value={o} /> <span set:html={reg(T.debatten.optionen[o])} /></label>
              ))}
              <p class="pk-tiny" set:html={reg(T.debatten.umfrageNote)} />
            </fieldset>
          </article>
        ))}
      </div>

      <h3 class="pk-sub" set:html={reg(T.debatten.heatmap.title)} />
      <p set:html={reg(T.debatten.heatmap.text)} />
      <GrammarHelpText text={tr("debatten.heatmap.text")} />
      <div class="pk-filter" role="group" aria-label={T.matrix.filter.de} data-heat-filter>
        {COUNTRIES.map((c) => <button type="button" data-country={c.code} aria-pressed={c.code === "DE" ? "true" : "false"}>{c.name}</button>)}
      </div>
      <div class="pk-scroll" data-heat data-show="DE">
        <table class="pk-table pk-heat">
          <thead>
            <tr><th>Partei</th>{debatten.items.map((d) => <th class="pk-heat-h"><span set:html={reg(d.title)} />{d.ches && <small> ({d.ches.var}): 10 = <span set:html={reg(d.ches.high)} /></small>}</th>)}</tr>
          </thead>
          <tbody>
            {matrixParties.map((p: any) => (
              <tr data-country={p.country}>
                <th scope="row"><span class="pk-swatch" style={`background:${p.color}`} />{p.short}</th>
                {debatten.items.map((d) => {
                  const v = d.ches ? p.ches[d.ches.var] : null;
                  return v == null ? <td class="pk-h-none"><span class="pk-de">{T.debatten.heatmap.keineDaten.de}</span><span class="pk-le">{T.debatten.heatmap.keineDaten.leicht}</span></td> : <td class={shade(v)}>{num(v)}</td>;
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pk-source">{T.ui.quelle.de}: Chapel Hill Expert Survey {wave.year}, Variablen {debatteSources.map((d) => d.ches!.var).join(", ")} (je 0–10). Für Rente, Verteidigung und Wohnen enthält die Befragung keine passende Frage.</p>
    </section>

    <!-- 3.7 Quiz -->
    <section class="pk-sec pk-quiz" id="pk-quiz" aria-labelledby="pk-quiz-h" data-quiz>
      <h2 id="pk-quiz-h" class="pk-head" set:html={h2("pk-quiz", T.quiz.title)} />
      <Fragment set:html={guide("quiz", "bruno", "celebrate", "left")} />
      {T.quiz.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`quiz.paras.${i}`)} /></Fragment>)}
      <p class="pk-shared" data-shared hidden></p>
      <button type="button" class="pk-btn pk-btn--primary" data-quiz-start set:html={reg(T.quiz.start)} />

      <div class="pk-q" data-quiz-q hidden>
        <div class="pk-progress" aria-hidden="true"><span data-quiz-bar></span></div>
        <p class="pk-step" data-quiz-step></p>
        <fieldset class="pk-q-field">
          <legend class="pk-q-text" data-quiz-text></legend>
          <div class="pk-q-help" data-quiz-help></div>
          <div class="pk-scale5">
            {["2", "1", "0", "-1", "-2"].map((v) => (
              <button type="button" class="pk-ans" data-ans={v} set:html={reg((T.quiz.skala as any)[v])} />
            ))}
          </div>
        </fieldset>
        <div class="pk-q-nav">
          <button type="button" class="pk-btn" data-quiz-back set:html={reg(T.quiz.zurueck)} />
          <button type="button" class="pk-btn pk-btn--quiet" data-quiz-skip set:html={reg(T.quiz.skip)} />
        </div>
      </div>

      <div class="pk-result" data-quiz-result hidden tabindex="-1">
        <h3 set:html={reg(T.quiz.ergebnis.title)} />
        <p class="pk-result-vals" data-result-vals></p>
        <p class="lq-error" data-result-few hidden set:html={reg(T.quiz.ergebnis.zuWenig)} />
        <div class="pk-filter" role="group" aria-label={T.matrix.filter.de} data-result-filter>
          {[...COUNTRIES, { code: "ALL", name: T.matrix.alle.de }].map((c) => (
            <button type="button" data-country={c.code} aria-pressed={c.code === "DE" ? "true" : "false"}>{c.name}</button>
          ))}
        </div>
        <figure class="pk-figure" data-result-matrix data-show="DE">
          <Fragment set:html={matrixSvg(matrixParties, axisLabels, { you: { x: 5, y: 5 } })} />
        </figure>
        <h4 set:html={reg(T.quiz.ergebnis.naechste)} />
        <div class="pk-near" data-result-near></div>
        <p class="pk-note pk-note--strong" set:html={reg(T.quiz.ergebnis.hinweis)} />
        <GrammarHelpText text={tr("quiz.ergebnis.hinweis")} />
        <ul class="pk-tools">
          {COUNTRIES.map((c) => toolLinks[c.code as "DE"]?.url && <li><a href={toolLinks[c.code as "DE"]!.url} rel="noopener">{toolLinks[c.code as "DE"]!.title}</a> <small>({c.name})</small></li>)}
        </ul>
        <div class="pk-q-nav">
          <button type="button" class="pk-btn" data-quiz-again set:html={reg(T.quiz.ergebnis.neu)} />
          <button type="button" class="pk-btn pk-btn--primary" data-quiz-share set:html={reg(T.quiz.ergebnis.teilen)} />
        </div>
        <p class="pk-tiny" data-share-status role="status" aria-live="polite"></p>
      </div>
    </section>

    <!-- 3.8 Material -->
    <section class="pk-sec" id="pk-material" aria-labelledby="pk-mat-h">
      <h2 id="pk-mat-h" class="pk-head" set:html={h2("pk-material", T.material.title)} />
      <Fragment set:html={guide("material", "hamsti", "happy", "right")} />
      {T.material.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`material.paras.${i}`)} /></Fragment>)}
      <div class="pk-mat-grid">
        {material.items.map((m: any) => (
          <article class:list={["pk-card pk-mat", m.simple_language && "pk-mat--einfach"]}>
            <p class="pk-mat-badges">
              <span class="pk-badge">{m.country === "DACH" ? "DE · AT · CH" : cname(m.country)}</span>
              {/^kostenlos/.test(m.cost) && <span class="pk-badge pk-badge--free" set:html={reg(T.material.kostenlos)} />}
              {/Pauschale/.test(m.cost) && <span class="pk-badge" set:html={reg(T.material.pauschale)} />}
              {m.simple_language && <span class="pk-badge pk-badge--easy" set:html={reg(T.material.einfach)} />}
            </p>
            <h3><a href={m.url} rel="noopener">{m.title}</a></h3>
            <p class="pk-tiny"><span set:html={reg(T.material.herausgeber)} />: {m.publisher}</p>
            <p>{m.desc_de}</p>
            <GrammarHelpText text={tr(`material.${m.id}`)} />
            {m.perspective && !/^Siehe /.test(m.perspective) && <p class="pk-tiny"><span set:html={reg(T.material.perspektive)} />: {m.perspective}</p>}
            {m.pdf_url && <p class="pk-tiny"><a href={m.pdf_url} rel="noopener">PDF</a></p>}
          </article>
        ))}
      </div>
      <p class="pk-source"><span class="pk-de">{T.material.stand.de.replace("{d}", datum(material.checked))}</span><span class="pk-le">{T.material.stand.leicht.replace("{d}", datum(material.checked))}</span>. Preise und Lieferbarkeit können sich ändern; maßgeblich ist die verlinkte Seite.</p>
    </section>

    <!-- 3.9 Methods -->
    <section class="pk-sec" id="pk-methoden" aria-labelledby="pk-meth-h">
      <h2 id="pk-meth-h" class="pk-head" set:html={h2("pk-methoden", T.methoden.title)} />
      <Fragment set:html={guide("methoden", "regi", "happy", "left")} />
      {T.methoden.paras.map((p, i) => <Fragment><p set:html={reg(p)} /><GrammarHelpText text={tr(`methoden.paras.${i}`)} /></Fragment>)}
      <h3 class="pk-sub" set:html={reg(T.methoden.quellen)} />
      <ul class="pk-sources">
        <li>{wave.citation} <a href={wave.url} rel="noopener">{wave.url}</a> (Datei: <a href={wave.file} rel="noopener">CHES_{wave.year}</a>, abgerufen {datum(ches.retrieved)})</li>
        <li>{ess.source.citation} <a href={ess.source.url} rel="noopener">ESS Data Portal</a>; Gewichtung: pspwght.</li>
        {parl.map((p: any) => <li>{p.name} ({cname(p.country)}): <a href={p.source.url} rel="noopener">{p.source.label}</a>, Stand {datum(p.data_as_of)}{p.government.source?.url && <Fragment>; Regierung: <a href={p.government.source.url} rel="noopener">{p.government.source.label}</a></Fragment>}</li>)}
        <li>Parteibeschreibungen: zusammengefasst nach der Selbstdarstellung und den Programmen der Parteien (Links unten).</li>
        <li>Weiterlernen: geprüft am {datum(material.checked)}, Links oben.</li>
      </ul>
      <details class="pk-table-wrap">
        <summary>Programme der Parteien</summary>
        <ul class="pk-sources">
          {Object.entries(beschreibungen).map(([k, x]: any) => <li>{x.name} ({k.split(":")[1]}, {cname(k.split(":")[0])}): {x.programme_url && <a href={x.programme_url} rel="noopener">Programm</a>}{x.programme_url && x.website && " · "}{x.website && <a href={x.website} rel="noopener">Website</a>}</li>)}
        </ul>
      </details>
    </section>

    <div class="pk-gloss" data-gloss hidden role="dialog" aria-modal="false" aria-labelledby="pk-gloss-h">
      <button type="button" class="pk-gloss-x" data-gloss-close aria-label={T.ui.schliessen.de}>✕</button>
      <h3 id="pk-gloss-h" data-gloss-term></h3>
      <p data-gloss-text></p>
      <p class="pk-gloss-tr" data-gloss-tr></p>
    </div>
  </main>

  <script type="application/json" id="pk-data" set:html={JSON.stringify(pageData).replace(/</g, "\\u003c")} />
  <script>
    import { mountPolitik } from "../lib/politik/seite.js";
    mountPolitik(document.getElementById("pk-page")!, JSON.parse(document.getElementById("pk-data")!.textContent!));
  </script>
</Layout>
