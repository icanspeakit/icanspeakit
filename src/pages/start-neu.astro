---
// /start-neu — Entwurf: aufgeräumte Startseite + schlankes Menü (EXPERIMENTE.md).
// Nur ein Mock: eigenes Menü, keine geteilten Komponenten, noindex.
import Layout from "../layouts/Layout.astro";

const menu = [
  {
    id: "ueben", label: "Üben", href: "/uebungen",
    cols: [
      { title: "Sprache", links: [
        ["/grammatik", "Grammatik", "Alle Themen von A1 bis C1"],
        ["/wortschatz", "Wortschatz", "Wörter nach Thema und Niveau"],
        ["/artikel", "der, die, das", "Artikel-Trainer"],
      ]},
      { title: "Fertigkeiten", links: [
        ["/hoeren", "Hören", ""],
        ["/sprechen/", "Sprechen & Aussprache", ""],
        ["/lesen", "Lesen & Schreiben", ""],
      ]},
    ],
    extra: ["/spiele/lindenau", "🎮 Lieber spielen? Zu den Spielen"],
    all: ["/uebungen", "Alle Übungen"],
  },
  {
    id: "pruefungen", label: "Prüfungen", href: "/pruefungen",
    cols: [
      { title: "Sprachprüfungen", links: [
        ["/goethe", "Goethe-Zertifikat", "A1–C2"],
        ["/telc", "telc", "A1–C2"],
        ["/dtz", "DTZ", "A2 / B1"],
        ["/testdaf", "TestDaF", "B2–C1"],
      ]},
      { title: "Für das Leben hier", links: [
        ["/leben-in-deutschland", "Einbürgerungstest", "Leben in Deutschland"],
        ["/fuehrerschein", "Führerschein", "Klasse B"],
      ]},
    ],
    all: ["/pruefungen", "Alle Prüfungen"],
  },
  {
    id: "leben", label: "Leben in DE", href: "/wissen",
    cols: [
      { title: "Land & Leute", links: [
        ["/kultur", "Kultur & Alltag", "Was Deutsche wirklich meinen"],
        ["/politik", "Politik in D, A, CH", ""],
        ["/wissen/dialekte", "Dialekte", "Die Karte"],
      ]},
      { title: "Nachschlagen", links: [
        ["/nachschlagewerk", "Nachschlagewerk", "Verbtabellen, Wortarten"],
        ["/wissen/umgangssprache", "Umgangssprache", ""],
      ]},
    ],
    all: ["/wissen", "Alles zu Land & Leuten"],
  },
];

const levels = ["A1", "A2", "B1", "B2", "C1"];

const paths = [
  { icon: "/email/hamsti.png", title: "Deutsch üben", text: "Grammatik, Wörter, Hören und Sprechen. Kurze Übungen, sofort Feedback.",
    links: [["/grammatik", "Grammatik"], ["/wortschatz", "Wortschatz"], ["/artikel", "der, die, das"]], href: "/uebungen", cta: "Zu den Übungen" },
  { icon: "/email/regi.png", title: "Prüfung bestehen", text: "Echte Prüfungsformate mit Zeit, Punkten und Erklärung zu jeder Antwort.",
    links: [["/goethe", "Goethe"], ["/telc", "telc"], ["/dtz", "DTZ"]], href: "/pruefungen", cta: "Zu den Prüfungen" },
  { icon: "/email/quaki.png", title: "In Deutschland leben", text: "Einbürgerungstest, Führerschein, Ämter und Alltag. Was man wirklich braucht.",
    links: [["/leben-in-deutschland", "Einbürgerungstest"], ["/fuehrerschein", "Führerschein"], ["/kultur", "Kultur"]], href: "/wissen", cta: "Mehr dazu" },
];
---
<Layout title="Startseite – Entwurf" noindex>
  <div class="sn">
    <p class="sn-draft">Entwurf · nur zum Anschauen · <a href="/">heutige Startseite</a></p>

    <!-- MENÜ: 3 Bereiche + Lehrkräfte, Suche, ein Haupt-Knopf -->
    <header class="sn-nav">
      <div class="sn-nav-in">
        <a href="/start-neu" class="sn-logo"><img src="/assets/logo.png" alt="EnglishAcademy" /></a>

        <nav class="sn-menu" aria-label="Hauptmenü">
          {menu.map((m) => (
            <div class="sn-item" data-item>
              <button class="sn-top" aria-expanded="false" data-top>{m.label} <span aria-hidden="true">▾</span></button>
              <div class="sn-panel" hidden data-panel>
                <div class="sn-cols">
                  {m.cols.map((c) => (
                    <div>
                      <p class="sn-col-title">{c.title}</p>
                      <ul>
                        {c.links.map(([href, t, s]) => (
                          <li><a href={href}><strong>{t}</strong>{s && <span>{s}</span>}</a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <div class="sn-panel-foot">
                  {m.extra && <a href={m.extra[0]} class="sn-extra">{m.extra[1]}</a>}
                  <a href={m.all[0]} class="sn-all">{m.all[1]} →</a>
                </div>
              </div>
            </div>
          ))}
          <a href="/lehrkraefte" class="sn-top sn-top--link">Für Lehrkräfte</a>
        </nav>

        <div class="sn-right">
          <button class="sn-icon" aria-label="Suchen" title="Suchen">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          </button>
          <a href="/anmelden" class="sn-login">Anmelden</a>
          <a href="/einstufungstest" class="sn-btn sn-btn--sm">Niveau testen</a>
          <button class="sn-burger" aria-label="Menü" aria-expanded="false" data-burger>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>

      <!-- Handy: dieselben 3 Bereiche als Akkordeon -->
      <div class="sn-drawer" hidden data-drawer>
        {menu.map((m) => (
          <details>
            <summary>{m.label}</summary>
            <ul>
              {m.cols.flatMap((c) => c.links).map(([href, t]) => <li><a href={href}>{t}</a></li>)}
              <li><a href={m.all[0]} class="sn-all">{m.all[1]} →</a></li>
            </ul>
          </details>
        ))}
        <a href="/lehrkraefte" class="sn-drawer-link">Für Lehrkräfte</a>
        <a href="/einstufungstest" class="sn-btn">Niveau testen</a>
      </div>
    </header>

    <main>
      <!-- 1 · HERO: eine Frage statt Text -->
      <section class="sn-hero">
        <div class="sn-wrap sn-hero-in">
          <div>
            <h1>Deutsch lernen.<br /><span>Schritt für Schritt.</span></h1>
            <p class="sn-lead">Kostenlose Übungen von A1 bis C1, im echten Deutschkurs getestet. Ohne Konto.</p>
            <p class="sn-q">Wo stehst du?</p>
            <div class="sn-levels">
              {levels.map((l) => <a href={`/grammatik?niveau=${l.toLowerCase()}`} class="sn-level">{l}</a>)}
              <a href="/einstufungstest" class="sn-level sn-level--test">Weiß ich nicht → Test (5 Min.)</a>
            </div>
          </div>
          <img class="sn-hero-img" src="/email/bruno-happy.png" alt="" width="260" height="260" />
        </div>
      </section>

      <!-- 2 · DREI WEGE statt vieler Kacheln -->
      <section class="sn-sec">
        <div class="sn-wrap">
          <h2>Was hast du vor?</h2>
          <div class="sn-paths">
            {paths.map((p) => (
              <article class="sn-path">
                <img src={p.icon} alt="" width="56" height="56" />
                <h3>{p.title}</h3>
                <p>{p.text}</p>
                <ul class="sn-chips">
                  {p.links.map(([href, t]) => <li><a href={href}>{t}</a></li>)}
                </ul>
                <a href={p.href} class="sn-path-cta">{p.cta} →</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- 3 · VERTRAUEN: eine Zeile -->
      <section class="sn-trust">
        <div class="sn-wrap sn-trust-in">
          <p><strong>10 Jahre</strong> Unterricht</p>
          <p><strong>A1–C1</strong> alle Niveaus</p>
          <p><strong>Kostenlos</strong> ohne Konto</p>
          <p><strong>11 Sprachen</strong> Oberfläche</p>
        </div>
      </section>

      <!-- 4 · LEHRKRÄFTE: eigener Bereich, ein Band -->
      <section class="sn-sec">
        <div class="sn-wrap sn-teach">
          <img src="/email/bruno-thinking.png" alt="" width="120" height="120" />
          <div>
            <h2>Du unterrichtest Deutsch?</h2>
            <p>Stundenplan-Generator, Klassen, Live-Quiz und Partnerübungen. Alles an einem Ort.</p>
          </div>
          <a href="/lehrkraefte" class="sn-btn sn-btn--ghost">Zum Lehrkräfte-Bereich</a>
        </div>
      </section>

      <!-- 5 · ABSCHLUSS: Premium kurz, ein Knopf -->
      <section class="sn-final">
        <div class="sn-wrap">
          <h2>Bereit? Finde dein Niveau in 5 Minuten.</h2>
          <p>Danach zeigen wir dir nur, was zu dir passt. <a href="/preise">Premium ansehen</a></p>
          <a href="/einstufungstest" class="sn-btn sn-btn--lg">Einstufungstest starten</a>
        </div>
      </section>
    </main>

    <footer class="sn-foot">
      <div class="sn-wrap sn-foot-in">
        <p>Da für Dich!</p>
        <nav>
          <a href="/maskottchen">Bruno & die Crew</a>
          <a href="/merch">Merch</a>
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<script>
  const items = [...document.querySelectorAll<HTMLElement>("[data-item]")];
  const close = (except?: HTMLElement) => items.forEach((it) => {
    if (it === except) return;
    it.querySelector("[data-panel]")?.setAttribute("hidden", "");
    it.querySelector("[data-top]")?.setAttribute("aria-expanded", "false");
  });
  const open = (it: HTMLElement) => {
    close(it);
    it.querySelector("[data-panel]")?.removeAttribute("hidden");
    it.querySelector("[data-top]")?.setAttribute("aria-expanded", "true");
  };
  for (const it of items) {
    let t: number | undefined;
    it.addEventListener("mouseenter", () => { clearTimeout(t); open(it); });
    it.addEventListener("mouseleave", () => { t = window.setTimeout(() => close(), 180); });
    it.querySelector("[data-top]")?.addEventListener("click", () => {
      // With a mouse, hover already opened it: a click must not close it again.
      const isOpen = it.querySelector("[data-top]")?.getAttribute("aria-expanded") === "true";
      if (isOpen && !matchMedia("(hover: hover)").matches) close(); else open(it);
    });
  }
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  document.addEventListener("click", (e) => { if (!(e.target as Element).closest("[data-item]")) close(); });

  const burger = document.querySelector<HTMLElement>("[data-burger]");
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  burger?.addEventListener("click", () => {
    const on = drawer?.hasAttribute("hidden");
    on ? drawer?.removeAttribute("hidden") : drawer?.setAttribute("hidden", "");
    burger.setAttribute("aria-expanded", String(!!on));
  });
</script>

<style>
  .sn { background: var(--page-bg); color: var(--ink); font-family: var(--font-body); min-height: 100vh; }
  .sn a { color: inherit; }
  .sn-wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
  .sn-draft { margin: 0; padding: 6px 16px; text-align: center; font-size: 13px; background: var(--warning-soft); color: var(--ink); border-bottom: 1px solid var(--warning-border); }

  /* Menü */
  .sn-nav { position: sticky; top: 0; z-index: 50; background: var(--page-bg); border-bottom: 1px solid var(--border); }
  .sn-nav-in { max-width: 1120px; margin: 0 auto; padding: 0 20px; height: 64px; display: flex; align-items: center; gap: 28px; }
  .sn-logo img { height: 34px; display: block; }
  .sn-menu { display: flex; align-items: center; gap: 4px; flex: 1; }
  .sn-item { position: relative; }
  .sn-top { font: 600 15px var(--font-label); background: none; border: 0; color: var(--ink); padding: 10px 12px; border-radius: var(--radius-sm); cursor: pointer; text-decoration: none; }
  .sn-top span { font-size: 11px; color: var(--muted); }
  .sn-top:hover, .sn-top[aria-expanded="true"] { background: var(--surface); }
  .sn-panel { position: absolute; top: calc(100% + 8px); left: -8px; width: 520px; background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-raised); padding: 20px 22px 14px; }
  .sn-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .sn-col-title { margin: 0 0 8px; font: 700 12px var(--font-label); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .sn-panel ul { list-style: none; margin: 0; padding: 0; }
  .sn-panel li a { display: block; padding: 7px 8px; margin: 0 -8px; border-radius: var(--radius-sm); text-decoration: none; }
  .sn-panel li a:hover { background: var(--surface); }
  .sn-panel li strong { display: block; font: 600 15px var(--font-label); }
  .sn-panel li span { display: block; font-size: 13px; color: var(--muted); }
  .sn-panel-foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); font: 600 14px var(--font-label); }
  .sn-extra { color: var(--muted) !important; text-decoration: none; }
  .sn-all { color: var(--brand-blue) !important; text-decoration: none; margin-left: auto; }
  .sn-right { display: flex; align-items: center; gap: 10px; }
  .sn-icon, .sn-burger { background: none; border: 0; color: var(--ink); padding: 8px; border-radius: var(--radius-sm); cursor: pointer; display: grid; place-items: center; }
  .sn-icon:hover { background: var(--surface); }
  .sn-login { font: 600 15px var(--font-label); text-decoration: none; padding: 8px 10px; }
  .sn-burger { display: none; }

  .sn-btn { display: inline-block; background: var(--accent); color: #fff !important; font: 700 16px var(--font-label); padding: 13px 22px; border-radius: var(--radius-pill); text-decoration: none; box-shadow: 0 6px 16px rgba(249,115,22,.28); text-align: center; }
  .sn-btn:hover { background: var(--accent-dark); }
  .sn-btn--sm { font-size: 14px; padding: 9px 16px; box-shadow: none; }
  .sn-btn--lg { font-size: 18px; padding: 16px 30px; }
  .sn-btn--ghost { background: transparent; color: var(--brand-blue) !important; border: 2px solid var(--brand-blue); box-shadow: none; }
  .sn-btn--ghost:hover { background: var(--blue-50, #f0fdfa); }

  .sn-drawer { border-top: 1px solid var(--border); padding: 8px 20px 20px; display: grid; gap: 4px; }
  .sn-drawer[hidden] { display: none; }
  .sn-drawer summary { font: 700 17px var(--font-label); padding: 14px 0; cursor: pointer; border-bottom: 1px solid var(--border); }
  .sn-drawer ul { list-style: none; margin: 0; padding: 6px 0 10px 12px; }
  .sn-drawer li a { display: block; padding: 9px 0; text-decoration: none; }
  .sn-drawer-link { font: 700 17px var(--font-label); padding: 14px 0 18px; text-decoration: none; }

  /* Hero */
  .sn-hero { background: var(--gradient-brand-soft); padding: 72px 0 64px; }
  .sn-hero-in { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 40px; }
  .sn-hero h1 { font: 800 clamp(40px, 6vw, 68px)/1.02 var(--font-display); margin: 0 0 18px; letter-spacing: -.01em; }
  .sn-hero h1 span { color: var(--brand-blue); }
  .sn-lead { font-size: 19px; color: var(--muted); max-width: 520px; margin: 0 0 32px; }
  .sn-q { font: 700 15px var(--font-label); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 12px; }
  .sn-levels { display: flex; flex-wrap: wrap; gap: 10px; }
  .sn-level { font: 700 18px var(--font-label); text-decoration: none; background: var(--surface-card); border: 2px solid var(--border-strong); border-radius: var(--radius); min-width: 64px; padding: 14px 16px; text-align: center; transition: all var(--duration-fast) var(--ease-standard); }
  .sn-level:hover { border-color: var(--brand-blue); color: var(--brand-blue); transform: translateY(-2px); }
  .sn-level--test { background: var(--accent); border-color: var(--accent); color: #fff !important; font-size: 16px; }
  .sn-level--test:hover { background: var(--accent-dark); border-color: var(--accent-dark); }
  .sn-hero-img { width: 260px; height: auto; }

  /* Abschnitte */
  .sn-sec { padding: 72px 0; }
  .sn-sec h2, .sn-final h2 { font: 800 clamp(28px, 3.6vw, 40px)/1.1 var(--font-display); margin: 0 0 28px; }
  .sn-paths { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .sn-path { text-align: left; background: var(--surface-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 26px; display: flex; flex-direction: column; box-shadow: var(--shadow-sm); transition: box-shadow var(--duration-fast); }
  .sn-path:hover { box-shadow: var(--shadow-hover); }
  .sn-path img { width: 56px; height: 56px; object-fit: contain; }
  .sn-path h3 { font: 800 24px var(--font-display); margin: 14px 0 8px; }
  .sn-path p { color: var(--muted); margin: 0 0 18px; flex: 1; }
  .sn-chips { list-style: none; padding: 0; margin: 0 0 20px; display: flex; flex-wrap: wrap; gap: 8px; }
  .sn-chips a { display: inline-block; font: 600 14px var(--font-label); padding: 6px 12px; border-radius: var(--radius-pill); background: var(--surface); text-decoration: none; }
  .sn-chips a:hover { background: var(--blue-100, #ccfbf1); }
  .sn-path-cta { font: 700 16px var(--font-label); color: var(--brand-blue) !important; text-decoration: none; }

  .sn-trust { background: var(--inverse-surface); color: #fff; padding: 28px 0; }
  .sn-trust-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; text-align: center; }
  .sn-trust p { margin: 0; color: rgba(255,255,255,.75); font-size: 15px; }
  .sn-trust strong { display: block; color: #fff; font: 800 26px var(--font-display); }

  .sn-teach { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 28px; background: var(--surface); border-radius: var(--radius-lg); padding: 28px 32px; }
  .sn-teach h2 { margin: 0 0 6px; font-size: 28px; }
  .sn-teach p { margin: 0; color: var(--muted); }
  .sn-teach img { width: 110px; height: auto; }

  .sn-final { text-align: center; padding: 80px 0; background: var(--gradient-accent-soft); }
  .sn-final h2 { margin-bottom: 10px; }
  .sn-final p { color: var(--muted); margin: 0 0 28px; }
  .sn-final p a { color: var(--brand-blue); font-weight: 600; }

  .sn-foot { border-top: 1px solid var(--border); padding: 28px 0; font-size: 14px; color: var(--muted); }
  .sn-foot-in { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; }
  .sn-foot p { margin: 0; font: 800 18px var(--font-display); color: var(--ink); }
  .sn-foot nav { display: flex; flex-wrap: wrap; gap: 18px; }
  .sn-foot nav a { text-decoration: none; }

  @media (max-width: 960px) {
    .sn-menu, .sn-login { display: none; }
    .sn-burger { display: grid; }
    .sn-nav-in { justify-content: space-between; }
    .sn-hero { padding: 40px 0; }
    .sn-hero-in { grid-template-columns: 1fr; }
    .sn-hero-img { display: none; }
    .sn-paths { grid-template-columns: 1fr; }
    .sn-trust-in { grid-template-columns: repeat(2, 1fr); }
    .sn-teach { grid-template-columns: 1fr; text-align: left; padding: 24px; }
    .sn-teach img { display: none; }
    .sn-sec { padding: 48px 0; }
  }
  @media (max-width: 420px) {
    .sn-btn--sm { display: none; }
    .sn-wrap, .sn-nav-in { padding: 0 16px; }
  }
</style>
