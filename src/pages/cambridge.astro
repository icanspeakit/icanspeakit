---
import Layout from "../layouts/Layout.astro";
import ExamShell from "../components/ExamShell.astro";
import ExamPractice from "../components/ExamPractice.astro";
import ExamFormat from "../components/ExamFormat.astro";
import SatzListe from "../components/SatzListe.astro";
import goetheFormate from "../data/pruefungen/goethe-formate.json";
import { external } from "../lib/downloads.js";

// Every level's official Modellsatz, from the same list /knowledge shows (src/data/downloads.json).
const modellsaetze = external.filter((e) => e.id.startsWith("goethe-"));
---
<Layout
  title="Cambridge English exams A2–B2: format and practice – icanspeak Spanish"
  description="Cambridge English A2 Key, B1 Preliminary and B2 First: who they are for, how each exam works, and free practice for every level."
>
  <ExamShell
    bild="goethe"
    header="Cambridge English"
    title="Cambridge English"
    lead="Die eigenen Prüfungen des Goethe-Instituts — weltweit anerkannt für Visa, Studium und Arbeitgeber."
    leadKey="goethe.lead"
    badges={["A1–C2"]}
    practiceHeading="Für Goethe üben"
    practiceHeadingKey="goethe.practiceHeading"
  >
    <Fragment slot="info">
      <section class="exam-section">
        <h2 data-i18n="goethe.who.title">Für wen ist das Goethe-Zertifikat?</h2>
        <div class="exam-meta-row">
          <span class="exam-meta-badge" data-i18n="telc.who.badge.level">Niveau A1–C2</span>
          <span class="exam-meta-badge" data-i18n="goethe.who.badge.perLevel">Ein Zertifikat pro Niveau</span>
        </div>
        <p data-i18n="goethe.who.text">
          Anders als telc ist jedes Goethe-Zertifikat eine eigenständige Prüfung für genau ein Niveau
          (z. B. Goethe-Zertifikat B1, nicht "B1 oder B2"). Goethe-Zertifikat A1 ("Start Deutsch 1") wird
          häufig für den Ehegattennachzug (Familienzusammenführung) verlangt; höhere Niveaus werden für
          Studium, Beruf und Einbürgerung genutzt.
        </p>
      </section>

      <section class="exam-section">
        <h2 data-i18n="exam.skills.title">Geprüfte Fertigkeiten</h2>
        <div class="skill-grid">
          <div class="skill-card"><div class="skill-card-icon">📖</div><h4 data-i18n="skill.lesen">Lesen</h4><p data-i18n="skill.lesen.desc">Leseverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">🎧</div><h4 data-i18n="skill.hoeren">Hören</h4><p data-i18n="skill.hoeren.desc">Hörverstehen</p></div>
          <div class="skill-card"><div class="skill-card-icon">✍️</div><h4 data-i18n="skill.schreiben">Schreiben</h4><p data-i18n="skill.schreiben.desc">Schriftlicher Ausdruck</p></div>
          <div class="skill-card"><div class="skill-card-icon">🗣️</div><h4 data-i18n="skill.sprechen">Sprechen</h4><p data-i18n="skill.sprechen.pairDesc">Mündliche Prüfung, meist paarweise</p></div>
        </div>
      </section>

      {goetheFormate.formate.map((f) => <ExamFormat format={f} />)}

      <section class="exam-section" id="modellsaetze">
        <h2 data-i18n="goethe.modell.title">Modellsätze für jedes Niveau</h2>
        <p class="format-note" data-i18n="goethe.moreLevels.text">
          Für jedes Niveau von A1 bis C2 gibt es einen offiziellen Modellsatz des Goethe-Instituts als PDF,
          kostenlos und ohne Anmeldung. Den Aufbau oben haben wir für A1 aus dem Übungssatz abgelesen; für
          die anderen Niveaus stehen Zeiten, Aufgaben und Bestehensgrenzen im jeweiligen Modellsatz. Wir
          tragen hier nur ein, was wir belegen können, statt Werte zu schätzen.
        </p>
        <ul class="gz-modell">
          {modellsaetze.map((m) => (
            <li>
              <a href={m.href} target="_blank" rel="noopener noreferrer">
                <span class="gz-level">{m.level}</span>
                <span class="gz-txt">
                  <b>{m.title}</b>
                  <i>PDF · {m.size} · {m.source}</i>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </Fragment>

    <SatzListe exam="goethe" />

    <div class="mock-cta">
      <p class="joint-exam" aria-label="Gemeinsame Prüfung von Goethe-Institut und telc" data-i18n-attr="aria-label:exam.joint.label">
        <span>Goethe-Institut</span><b aria-hidden="true">×</b><span>telc</span>
      </p>
      <h2 data-i18n="goethe.a1.title">A1: eine Prüfung von Goethe und telc</h2>
      <p data-i18n="goethe.a1.text">
        Auf A1 gibt es kein eigenes Goethe-Zertifikat und kein eigenes telc-Zertifikat: Beide bieten
        dieselbe Prüfung an, Start Deutsch 1 — gleiche Teile, gleiche Aufgabentypen, gleiches Niveau.
        Unser Übungssatz passt also für beide. Die telc-Seite zeigt Punkte und Notenskala.
      </p>
      <a class="quiz-btn quiz-btn--primary" href="/a1-test" data-i18n="exam.startSet">Übungssatz starten</a>
      <a class="quiz-btn" href="/trinity" data-i18n="goethe.a1.telcLink">Zur telc-Seite</a>
    </div>

    <ExamPractice
      heading="Grundlagen trainieren"
      headingKey="exam.practice.heading"
      intro="Diese Tools sind niveau- und prüfungsübergreifend nützlich. Sie stammen aus dem DTZ-Unterrichtsmaterial und prüfen allgemeine Artikel-, Grammatik- und Wortschatzkenntnisse — keine Goethe-spezifischen Aufgabenformate."
      introKey="goethe.practice.intro"
      tools={["artikel", "grammatik", "wortschatz"]}
    />
  </ExamShell>
</Layout>

<style>
  .gz-modell { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 8px; }
  .gz-modell a {
    display: flex; align-items: center; gap: 14px; min-height: 56px; padding: 10px 14px;
    border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-card);
    color: var(--ink); text-decoration: none; transition: border-color .15s ease;
  }
  .gz-modell a:hover { border-color: var(--brand-blue); }
  .gz-level {
    flex: none; min-width: 40px; padding: 4px 8px; border-radius: 999px; text-align: center;
    background: var(--blue-100); color: var(--brand-blue-dark); font-weight: var(--fw-semibold); font-size: .85rem;
  }
  .gz-txt { display: grid; gap: 2px; min-width: 0; }
  .gz-txt b { font-weight: var(--fw-semibold); overflow-wrap: anywhere; }
  .gz-txt i { font-style: normal; font-size: .82rem; color: var(--muted); }
</style>
