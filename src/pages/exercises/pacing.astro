---
import Layout from '../../layouts/Layout.astro';
import PaceExercise from '../../components/exercises/PaceExercise.astro';
---

<Layout
  title="Pace & pausing — icanspeak.it"
  description="Model audio with exact pause placement, plus playback-speed shadowing to build a natural pace."
  altHref="/de/exercises/pacing/"
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Pace &amp; pausing</span>
      <h1>Pace &amp; pausing</h1>
      <p class="lede">
        Listen to where a native speaker pauses ("/" = short pause, "//" = long pause), slow it down to
        study it, then speed back up and shadow it.
      </p>
      <button type="button" class="button button--ghost" id="print-worksheet">🖨 Print worksheet</button>
    </div>

    <PaceExercise />
  </section>
</Layout>

<script>
  document.getElementById('print-worksheet')?.addEventListener('click', () => {
    window.print();
  });
</script>
