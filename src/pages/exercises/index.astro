---
import Layout from '../../layouts/Layout.astro';
import ExerciseGrid from '../../components/ExerciseGrid.astro';
import { topics } from '../../data/exercises/topics';
---

<Layout title="Exercises — icanspeak.it" description="Audio-driven exercises for the mechanics behind sounding clear in English." altHref="/de/exercises/">
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Practice</span>
      <h1>Exercises</h1>
      <p class="lede">
        Hear the model, try it yourself, and listen back side by side — self-checking practice built around the
        mechanics of pronunciation, not a pass/fail score.
      </p>
    </div>

    <ExerciseGrid topics={topics} />
  </section>
</Layout>
