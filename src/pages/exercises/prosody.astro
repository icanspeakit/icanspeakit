---
import Layout from '../../layouts/Layout.astro';
import ProsodyExercise from '../../components/exercises/ProsodyExercise.astro';
---

<Layout
  title="Prosody — icanspeak.it"
  description="Word stress and sentence stress: mark the pattern, hear how it changes a word's role or a sentence's meaning."
  altHref="/de/exercises/prosody/"
>
  <div class="prosody-page container">
    <section class="prosody-hero">
      <div>
        <span class="prosody-eyebrow">Exercise</span>
        <h1 class="prosody-title">Prosody</h1>
        <p class="prosody-lede">
          Word stress below is still a worksheet — ElevenLabs' emphasis on a single word is best-effort,
          not precise enough to grade. Sentence stress is different: it traces the actual pitch of the
          generated clip, frame by frame, so the rise you see is real, not a hand-placed mark.
        </p>
      </div>
      <button type="button" class="prosody-print" id="print-worksheet"><span aria-hidden="true">⎙</span>Print worksheet</button>
    </section>

    <ProsodyExercise />
  </div>
</Layout>

<script>
  document.getElementById('print-worksheet')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,400;0,600;0,700;1,400&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap');

  .prosody-page {
    --pr-ink: #1e2c44;
    --pr-border: #ddd2bd;
    --pr-accent-dark: #a37a35;
    --pr-serif: 'Spectral', Georgia, serif;
    --pr-sans: 'Public Sans', Helvetica, Arial, sans-serif;
    --pr-mono: 'IBM Plex Mono', monospace;

    font-family: var(--pr-sans);
    color: var(--pr-ink);
  }

  .prosody-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: end;
    padding: 64px 0 34px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--pr-border);
  }

  .prosody-eyebrow {
    font-family: var(--pr-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--pr-accent-dark);
    text-transform: uppercase;
  }

  .prosody-title {
    font-family: var(--pr-serif);
    font-size: clamp(2.6rem, 2rem + 2.5vw, 3.75rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--pr-ink);
    margin: 12px 0 0;
  }

  .prosody-lede {
    font-family: var(--pr-sans);
    font-size: 16.5px;
    line-height: 1.55;
    color: #46505f;
    max-width: 78ch;
    margin: 18px 0 0;
  }

  .prosody-print {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    background: var(--pr-ink);
    color: #fbf8f1;
    border: 0;
    border-radius: 2px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--pr-sans);
    cursor: pointer;
    white-space: nowrap;
  }

  .prosody-print:hover {
    background: #2b3d5c;
  }

  @media (max-width: 560px) {
    .prosody-hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media print {
    .prosody-print {
      display: none !important;
    }
  }
</style>
