---
import Layout from '../../layouts/Layout.astro';
import WritingTask from '../../components/study/WritingTask.astro';
---

<Layout
  title="Writing Desk — icanspeak.it"
  description="Write a real reply against a brief, with a live checklist and a model answer to compare against."
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Study · Writing</span>
      <h1>Writing Desk</h1>
      <p class="lede">
        The checklist on the right is a real, live check against your own draft — not a demo, and not AI grading
        (there's no AI backend behind this site). Use it as a self-check, then compare against the model answer.
      </p>
    </div>

    <WritingTask />
  </section>
</Layout>
