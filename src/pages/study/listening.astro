---
import Layout from '../../layouts/Layout.astro';
import ListeningClip from '../../components/study/ListeningClip.astro';
---

<Layout
  title="Listening Board — icanspeak.it"
  description="A real spoken clip with a transcript that reveals itself as you listen, plus dictation, word order, and shadowing."
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Study · Listening</span>
      <h1>Listening Board</h1>
      <p class="lede">
        One real clip, generated and analyzed the same way as the pitch contour on the Prosody page — the transcript
        reveals itself in sync with actual word timing, not a fixed animation.
      </p>
    </div>

    <ListeningClip />
  </section>
</Layout>
