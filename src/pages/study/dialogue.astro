---
import Layout from '../../layouts/Layout.astro';
import DialogueRoleplay from '../../components/study/DialogueRoleplay.astro';
---

<Layout
  title="Dialogue Lab — icanspeak.it"
  description="Roleplay a real workplace negotiation — a branching conversation with genuine feedback on every choice."
  altHref="/de/study/dialogue/"
>
  <section class="container">
    <div class="section-head">
      <span class="eyebrow">Study · Conversation</span>
      <h1>Dialogue Lab</h1>
      <p class="lede">
        This is a scripted decision tree, not open-ended AI chat — there's no live AI grading behind this site. Each
        response you can pick comes with real feedback on tone and grammar, and three goal phrases are worth landing
        along the way.
      </p>
    </div>

    <DialogueRoleplay />
  </section>
</Layout>
