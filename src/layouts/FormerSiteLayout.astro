---
import Header from '../components/former-site/Header.astro';
import Footer from '../components/former-site/Footer.astro';
import '../styles/former-site.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Sprachausbildung für Fachkräfte im Recruiting-Prozess – organisiert, effizient und mit messbarer Qualität.',
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
