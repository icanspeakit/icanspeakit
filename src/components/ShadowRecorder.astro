---
interface Props {
  audioSrc: string;
  label?: string;
}

const copy = {
  en: {
    defaultLabel: 'Shadow this',
    playModel: '▶ Play model',
    record: '● Record yourself',
    stop: '■ Stop',
    playMine: '▶ Play your take',
    recording: 'Recording…',
    recorded: 'Recorded.',
    denied: 'Microphone access denied.',
  },
  de: {
    defaultLabel: 'Nachsprechen',
    playModel: '▶ Modell abspielen',
    record: '● Dich aufnehmen',
    stop: '■ Stopp',
    playMine: '▶ Deine Aufnahme abspielen',
    recording: 'Aufnahme läuft…',
    recorded: 'Aufgenommen.',
    denied: 'Mikrofonzugriff verweigert.',
  },
} as const;

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = copy[locale];
const { audioSrc, label = t.defaultLabel } = Astro.props;
---

<div
  class="shadow-recorder"
  data-label-record={t.record}
  data-label-stop={t.stop}
  data-label-recording={t.recording}
  data-label-recorded={t.recorded}
  data-label-denied={t.denied}
>
  <p class="shadow-recorder__label">{label}</p>

  <div class="shadow-recorder__row">
    <button type="button" class="button button--ghost" data-role="play-model">{t.playModel}</button>
    <audio data-role="model-audio" src={audioSrc} preload="none"></audio>
  </div>

  <div class="shadow-recorder__row">
    <button type="button" class="button button--primary" data-role="record-toggle">{t.record}</button>
    <span class="shadow-recorder__status" data-role="status" aria-live="polite"></span>
  </div>

  <div class="shadow-recorder__row" data-role="playback-row" hidden>
    <button type="button" class="button button--ghost" data-role="play-mine">{t.playMine}</button>
    <audio data-role="mine-audio"></audio>
  </div>
</div>

<script>
  const recorders = document.querySelectorAll<HTMLElement>('.shadow-recorder');

  recorders.forEach((recorder) => {
    const modelAudio = recorder.querySelector<HTMLAudioElement>('[data-role="model-audio"]');
    const mineAudio = recorder.querySelector<HTMLAudioElement>('[data-role="mine-audio"]');
    const playModelBtn = recorder.querySelector<HTMLButtonElement>('[data-role="play-model"]');
    const recordToggleBtn = recorder.querySelector<HTMLButtonElement>('[data-role="record-toggle"]');
    const playMineBtn = recorder.querySelector<HTMLButtonElement>('[data-role="play-mine"]');
    const playbackRow = recorder.querySelector<HTMLElement>('[data-role="playback-row"]');
    const status = recorder.querySelector<HTMLElement>('[data-role="status"]');
    const labels = recorder.dataset;

    let mediaRecorder: MediaRecorder | null = null;
    let chunks: BlobPart[] = [];
    let stream: MediaStream | null = null;

    playModelBtn?.addEventListener('click', () => {
      modelAudio?.play();
    });

    recordToggleBtn?.addEventListener('click', async () => {
      if (mediaRecorder && mediaRecorder.state === 'recording') {
        mediaRecorder.stop();
        return;
      }

      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch {
        if (status) status.textContent = labels.labelDenied ?? 'Microphone access denied.';
        return;
      }

      chunks = [];
      mediaRecorder = new MediaRecorder(stream);
      mediaRecorder.ondataavailable = (event) => chunks.push(event.data);
      mediaRecorder.onstop = () => {
        const blob = new Blob(chunks, { type: 'audio/webm' });
        if (mineAudio) mineAudio.src = URL.createObjectURL(blob);
        if (playbackRow) playbackRow.hidden = false;
        if (status) status.textContent = labels.labelRecorded ?? 'Recorded.';
        if (recordToggleBtn) recordToggleBtn.textContent = labels.labelRecord ?? '● Record yourself';
        stream?.getTracks().forEach((track) => track.stop());
        // Lets a parent exercise (e.g. Pace's pause-matching) analyze the
        // real recording — purely additive, most consumers ignore this.
        recorder.dispatchEvent(new CustomEvent('shadow:recorded', { detail: { blob }, bubbles: true }));
      };

      mediaRecorder.start();
      if (status) status.textContent = labels.labelRecording ?? 'Recording…';
      if (recordToggleBtn) recordToggleBtn.textContent = labels.labelStop ?? '■ Stop';
    });

    playMineBtn?.addEventListener('click', () => {
      mineAudio?.play();
    });
  });
</script>

<style>
  .shadow-recorder {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg-soft);
  }

  .shadow-recorder__label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-muted);
    max-width: none;
  }

  .shadow-recorder__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .shadow-recorder__row[hidden] {
    display: none;
  }

  .shadow-recorder__status {
    font-size: 0.85rem;
    color: var(--color-muted);
  }
</style>
