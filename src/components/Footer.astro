---
const locale = Astro.currentLocale ?? 'en';
const year = new Date().getFullYear();

const copy = {
  en: {
    blurb: 'A small corner of the internet for people who stop mid-sentence to wonder where a word came from.',
    explore: 'Explore',
    nav: [
      { href: '/blog/', label: 'Blog' },
      { href: '/words/', label: 'Word Cards' },
      { href: '/about/', label: 'About' },
    ],
    former: 'Looking for the original icanspeak.it language-training site?',
    formerLink: 'It still lives here →',
    rights: `© ${year} icanspeak.it`,
  },
  de: {
    blurb: 'Eine kleine Ecke des Internets für alle, die mitten im Satz innehalten und sich fragen, woher ein Wort eigentlich kommt.',
    explore: 'Entdecken',
    nav: [
      { href: '/de/words/', label: 'Wortkarten' },
      { href: '/de/about/', label: 'Über uns' },
    ],
    former: 'Auf der Suche nach der ursprünglichen icanspeak.it Sprachtraining-Seite?',
    formerLink: 'Sie lebt hier weiter →',
    rights: `© ${year} icanspeak.it`,
  },
} as const;

const t = copy[locale as 'en' | 'de'] ?? copy.en;
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-col footer-col--brand">
      <a href={locale === 'de' ? '/de/' : '/'} class="brand">
        <span class="brand__mark">i</span>
        <span>icanspeak.it</span>
      </a>
      <p class="text-muted">{t.blurb}</p>
    </div>

    <div class="footer-col">
      <h4>{t.explore}</h4>
      <ul>
        {t.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="footer-col footer-col--former">
      <p class="text-muted">{t.former}</p>
      <a href="/former-site/" class="former-link">{t.formerLink}</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom__inner">
      <p>{t.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: #cdd6e2;
    margin-block-start: clamp(3rem, 6vw, 5rem);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 4vw, 4rem);
  }

  @media (max-width: 860px) {
    .footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .footer-main { grid-template-columns: minmax(0, 1fr); }
  }

  .footer-col--brand .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    color: #fff;
    margin-block-end: 1rem;
    font-size: 1.05rem;
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--color-accent);
    color: var(--color-primary-dark);
    font-family: var(--font-display);
    font-style: italic;
  }

  .footer-col--brand p { font-size: 0.9rem; max-width: 32ch; color: #aab5c6; }

  .footer-col h4 {
    font-family: var(--font-sans);
    color: #fff;
    margin-block-end: 1rem;
    font-size: 0.95rem;
  }

  .footer-col ul { display: flex; flex-direction: column; gap: 0.65rem; }
  .footer-col a { color: #cdd6e2; }
  .footer-col a:hover { color: #fff; }

  .footer-col--former p { font-size: 0.85rem; color: #aab5c6; margin-block-end: 0.5rem; }
  .former-link { font-weight: 600; color: var(--color-accent); }
  .former-link:hover { color: #fff; }

  .footer-bottom { border-top: 1px solid rgba(255, 255, 255, 0.12); }

  .footer-bottom__inner {
    padding-block: 1.1rem;
    font-size: 0.82rem;
    color: #8b95a8;
  }
</style>
