---
// One level of the course plan: Dauer and the textbook series it fits, the thematic blocks
// as an accordion, the "Ist das mein Niveau?" self-check and the two CTAs (Probestunde,
// Kursplan drucken). Content: src/data/kursinhalte.json — nothing is written in here.
// English only, like the course (lang="en"): written into the markup, no i18n keys.
//
// `heading` is the level of this section's own headings (default 2, under the page's h1);
// the block titles sit one below. The print rules at the end make window.print() give a
// one-page plan of this level and nothing else of the page.
import data from "../data/kursinhalte.json";
import { LEGAL } from "../lib/legal.js";

interface Props {
  level: string;
  heading?: 2 | 3;
}
const { level: id, heading = 2 } = Astro.props;
const levels = data.niveaus;
const i = levels.findIndex((l) => l.id === id);
if (i < 0) throw new Error(`KursProgression: unbekanntes Niveau „${id}“ (src/data/kursinhalte.json)`);
const level = levels[i];
const below = i > 0 ? levels[i - 1] : null;
const books: string[] = data.lehrwerke[level.lehrwerke as keyof typeof data.lehrwerke] ?? [];

const H = `h${heading}` as "h2" | "h3";
const HB = `h${heading + 1}` as "h3" | "h4";
const probestunde = data.probestunde.href
  ? data.probestunde.href.replaceAll("{niveau}", level.label)
  : `mailto:${LEGAL.contactEmail}?subject=${encodeURIComponent(`Trial lesson ${level.label}`)}`;
const url = `englishacademy.com/kursinhalte/${level.id}`;
---
<div class="kp" lang="en" data-kp data-level={level.label}>
  <dl class="kp-meta">
    <div>
      <dt>Length</dt>
      <dd>{level.dauer}</dd>
    </div>
    <div>
      <dt>Blocks</dt>
      <dd>{level.bloecke.length} topics</dd>
    </div>
    {books.length > 0 && (
      <div class="kp-meta-books">
        <dt>Fits these coursebooks</dt>
        <dd><ul>{books.map((b) => <li>{b}</li>)}</ul></dd>
      </div>
    )}
  </dl>

  <section class="kp-sec" aria-labelledby={`kp-${level.id}-themen`}>
    <div class="kp-sec-head">
      <H id={`kp-${level.id}-themen`}>Topics &amp; learning goals</H>
      <button type="button" class="kp-all" data-kp-all aria-expanded="false">Open all</button>
    </div>
    <ol class="kp-blocks">
      {level.bloecke.map((b, n) => {
        const bid = `kp-${level.id}-b${n + 1}`;
        return (
          <li class="kp-block">
            <HB class="kp-block-h">
              <button type="button" class="kp-toggle" id={`${bid}-btn`} aria-expanded="false" aria-controls={bid} data-kp-toggle>
                <span class="kp-num">Block {n + 1}</span>
                <span class="kp-thema">{b.thema}</span>
                <svg class="kp-chev" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 7.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
            </HB>
            <div class="kp-panel" id={bid} role="region" aria-labelledby={`${bid}-btn`} hidden>
              <div class="kp-part">
                <p class="kp-label">What you learn</p>
                <ul class="kp-kann">{b.kannZiele.map((k) => <li>{k}</li>)}</ul>
              </div>
              <div class="kp-part">
                <p class="kp-label">Grammar</p>
                <ul class="kp-chips">{b.grammatik.map((g) => <li>{g}</li>)}</ul>
              </div>
              <div class="kp-part">
                <p class="kp-label">Vocabulary</p>
                <p class="kp-words">{b.wortschatz.join(" · ")}</p>
              </div>
              <a class="kp-plan" href={`/lehrkraefte/stundenplan?niveau=${level.id}&block=${n + 1}`}>For teachers: lesson plan for this block</a>
              {b.pruefung?.length && (
                <div class="kp-part">
                  <p class="kp-label">Exam</p>
                  <ul class="kp-exam">{b.pruefung.map((p) => <li>{p}</li>)}</ul>
                </div>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="kp-sec kp-check" aria-labelledby={`kp-${level.id}-check`}>
    <H id={`kp-${level.id}-check`}>Is {level.label} my level?</H>
    <fieldset class="kp-check-list">
      <legend>Tick what you can already do.</legend>
      {level.selbstcheck.map((s) => (
        <label><input type="checkbox" data-kp-check /> <span>{s}</span></label>
      ))}
    </fieldset>
    <div class="kp-result" role="status" aria-live="polite" data-kp-result></div>
    {/* The three answers, filled in by the script. Here so the texts stay in the markup. */}
    <template data-kp-ok>
      <p><b>Good fit!</b> {level.label} is the right level for you.</p>
      <a class="lp-btn lp-btn--primary" href={probestunde}>Book a trial lesson</a>
    </template>
    <template data-kp-low>
      {below ? (
        <>
          <p>Better start with <b>{below.label}</b>. There you learn what you still need for {level.label}.</p>
          <a class="lp-btn lp-btn--outline" href={`/kursinhalte/${below.id}`}>Go to {below.label}: {below.titel}</a>
        </>
      ) : (
        <>
          <p>{level.selbstcheckNiedrig}</p>
          <a class="lp-btn lp-btn--primary" href={probestunde}>Book a trial lesson</a>
        </>
      )}
    </template>
  </section>

  <div class="kp-cta">
    <a class="lp-btn lp-btn--primary" href={probestunde}>Book a trial lesson</a>
    <button type="button" class="lp-btn lp-btn--outline" data-kp-print>Course plan as PDF</button>
  </div>

  <p class="kp-note">
    We name the coursebooks only as a guide: this course fits alongside them. The topics and
    learning goals here are our own, based on the Common European Framework of Reference (CEFR).
  </p>
  <p class="kp-print-foot">{url}</p>
</div>

<noscript><style>.kp-panel[hidden] { display: block !important; } .kp-all, .kp-chev, [data-kp-print] { display: none !important; }</style></noscript>

<style>
  .kp { --kp-gap: 14px; }
  .kp-meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px;
    margin: 0 0 28px; padding: 0;
  }
  .kp-meta > div {
    padding: 12px 14px; border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--surface-card);
  }
  .kp-meta .kp-meta-books { grid-column: 1 / -1; }
  .kp-meta dt { font-size: var(--text-xs); color: var(--muted); font-weight: var(--fw-semibold); text-transform: uppercase; letter-spacing: .04em; }
  .kp-meta dd { margin: 4px 0 0; font-weight: var(--fw-bold); color: var(--ink); }
  .kp-meta ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .kp-meta li {
    padding: 3px 10px; border-radius: var(--radius-pill); background: var(--surface);
    border: 1px solid var(--border); font-size: var(--text-sm); font-weight: var(--fw-semibold);
  }

  .kp-sec { margin: 0 0 32px; }
  .kp-sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .kp-sec h2, .kp-sec h3:not(.kp-block-h) { margin: 0 0 12px; font-size: var(--text-xl); }
  .kp-all {
    flex: none; font: inherit; font-size: var(--text-sm); font-weight: var(--fw-semibold);
    color: var(--brand-blue-dark); background: none; border: 0; padding: 8px 4px; cursor: pointer;
  }
  .kp-all:hover { text-decoration: underline; }

  .kp-blocks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .kp-block { border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface-card); }
  .kp-block:has(.kp-toggle[aria-expanded="true"]) { border-color: var(--brand-blue); }
  .kp-block-h { margin: 0; font-size: inherit; }
  .kp-toggle {
    width: 100%; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 4px 12px;
    min-height: 56px; padding: 12px 14px; font: inherit; text-align: left; color: var(--ink);
    background: none; border: 0; border-radius: var(--radius); cursor: pointer;
  }
  .kp-toggle:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .kp-num {
    padding: 3px 9px; border-radius: var(--radius-pill); background: var(--blue-100);
    color: var(--brand-blue-dark); font-size: var(--text-xs); font-weight: var(--fw-bold); white-space: nowrap;
  }
  .kp-thema { font-weight: var(--fw-bold); font-size: var(--text-base); min-width: 0; overflow-wrap: anywhere; }
  .kp-chev { color: var(--muted); transition: transform .2s ease; }
  .kp-toggle[aria-expanded="true"] .kp-chev { transform: rotate(180deg); }

  .kp-panel { padding: 0 14px 16px; display: grid; gap: var(--kp-gap); }
  .kp-panel[hidden] { display: none; }
  .kp-label { margin: 0 0 6px; font-size: var(--text-xs); font-weight: var(--fw-bold); text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
  .kp-kann { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .kp-kann li { position: relative; padding-left: 26px; line-height: 1.45; }
  .kp-kann li::before {
    content: "✓"; position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-radius: 50%;
    display: grid; place-items: center; font-size: 11px; font-weight: 700;
    background: var(--success-soft); color: var(--success); border: 1px solid var(--success-border);
  }
  .kp-chips { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .kp-chips li {
    padding: 4px 10px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border);
    font-size: var(--text-sm); line-height: 1.35;
  }
  .kp-words { margin: 0; color: var(--ink); font-size: var(--text-sm); }
  .kp-plan {
    order: 9; justify-self: start; font-size: var(--text-sm); font-weight: var(--fw-semibold);
    color: var(--brand-blue-dark); padding: 6px 12px; margin-left: -12px; border-radius: var(--radius-pill);
  }
  .kp-plan:hover { background: var(--surface); }
  .kp-exam { margin: 0; padding-left: 18px; font-size: var(--text-sm); display: grid; gap: 2px; }

  .kp-check {
    padding: 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface);
  }
  .kp-check-list { border: 0; margin: 0; padding: 0; display: grid; gap: 4px; }
  .kp-check-list legend { padding: 0; margin-bottom: 8px; color: var(--muted); font-size: var(--text-sm); }
  .kp-check-list label {
    display: flex; gap: 10px; align-items: flex-start; padding: 8px 6px; min-height: 44px;
    border-radius: var(--radius-sm); cursor: pointer; line-height: 1.45;
  }
  .kp-check-list label:hover { background: var(--surface-card); }
  .kp-check-list input { flex: none; width: 20px; height: 20px; margin: 1px 0 0; accent-color: var(--brand-blue); }
  .kp-result:not(:empty) {
    margin-top: 12px; padding: 14px; border-radius: var(--radius); background: var(--surface-card);
    border: 1px solid var(--border); display: grid; gap: 10px; justify-items: start;
  }
  .kp-result.is-ok { border-color: var(--success-border); background: var(--success-soft); }
  .kp-result p { margin: 0; }

  .kp-cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 20px; }
  .kp-note { font-size: var(--text-sm); color: var(--muted); margin: 0; }
  .kp-print-foot { display: none; }

  @media (max-width: 480px) {
    .kp-toggle { grid-template-columns: 1fr auto; }
    .kp-num { justify-self: start; grid-column: 1; }
    .kp-thema { grid-column: 1; }
    .kp-chev { grid-column: 2; grid-row: 1 / span 2; }
    .kp-cta .lp-btn { flex: 1 1 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kp-chev { transition: none; }
  }

  /* Kursplan als PDF: only this level, every block open, two columns, one page. */
  @media print {
    @page { size: A4; margin: 10mm; }
    :global(body:has(.kp) > :not(main)) { display: none !important; }
    :global(body:has(.kp) [data-kp-hide-print]) { display: none !important; }
    .kp { color: #000; }
    .kp, .kp li, .kp p, .kp dd { font-size: 7.5pt; line-height: 1.3; }
    .kp-meta { display: flex; flex-wrap: wrap; gap: 2pt 14pt; margin: 0 0 6pt; }
    .kp-meta > div { display: flex; gap: 4pt; align-items: baseline; padding: 0; border: 0; background: none; }
    .kp-meta dt { font-size: 7pt; }
    .kp-meta dd { margin: 0; }
    .kp-meta ul { gap: 0 6pt; }
    .kp-meta li { padding: 0; border: 0; background: none; }
    .kp-meta li + li::before { content: "· "; }
    .kp-sec { margin-bottom: 4pt; }
    .kp-sec h2, .kp-sec h3:not(.kp-block-h) { font-size: 10pt; margin-bottom: 3pt; }
    .kp-all, .kp-chev, .kp-check, .kp-cta, .kp-plan { display: none !important; }
    .kp-blocks { grid-template-columns: 1fr 1fr; gap: 4pt; }
    .kp-block { break-inside: avoid; border-color: #bbb; border-radius: 6pt; }
    .kp-toggle { min-height: 0; padding: 3pt 6pt 1pt; gap: 0 5pt; grid-template-columns: auto 1fr; }
    .kp-num { padding: 0 4pt; font-size: 6.5pt; }
    .kp-thema { font-size: 8.5pt; }
    .kp-panel, .kp-panel[hidden] { display: grid !important; padding: 0 6pt 3pt; gap: 1.5pt; }
    .kp-part { display: flex; gap: 4pt; align-items: baseline; }
    .kp-part:first-child { display: block; }
    .kp-part:first-child .kp-label { display: none; }
    .kp-label { flex: none; width: 60pt; font-size: 6pt; margin: 0; }
    .kp-kann { gap: 0; }
    .kp-kann li { padding-left: 9pt; }
    .kp-kann li::before { width: auto; height: auto; border: 0; background: none; font-size: 7pt; }
    .kp-chips { display: block; }
    .kp-chips li { display: inline; padding: 0; border: 0; background: none; }
    .kp-chips li + li::before { content: " · "; }
    .kp-exam { display: block; padding: 0; list-style: none; }
    .kp-exam li { display: inline; }
    .kp-exam li + li::before { content: " · "; }
    .kp-note { font-size: 6.5pt; margin-top: 4pt; }
    .kp-print-foot { display: block; margin: 1pt 0 0; font-size: 6.5pt; color: #555; }
  }
</style>

<script>
  // Accordion (aria-expanded + hidden), "Alle öffnen", arrow keys between the block headers,
  // the self-check and print. Several .kp on one page work independently.
  for (const root of document.querySelectorAll<HTMLElement>("[data-kp]")) {
    const toggles = [...root.querySelectorAll<HTMLButtonElement>("[data-kp-toggle]")];
    const all = root.querySelector<HTMLButtonElement>("[data-kp-all]")!;
    const panel = (b: HTMLButtonElement) => document.getElementById(b.getAttribute("aria-controls")!)!;
    const set = (b: HTMLButtonElement, open: boolean) => {
      b.setAttribute("aria-expanded", String(open));
      panel(b).hidden = !open;
    };
    const syncAll = () => {
      const open = toggles.every((b) => b.getAttribute("aria-expanded") === "true");
      all.textContent = open ? "Close all" : "Open all";
      all.setAttribute("aria-expanded", String(open));
    };

    toggles.forEach((b, n) => {
      b.addEventListener("click", () => {
        set(b, b.getAttribute("aria-expanded") !== "true");
        syncAll();
      });
      b.addEventListener("keydown", (e) => {
        const to = { ArrowDown: n + 1, ArrowUp: n - 1, Home: 0, End: toggles.length - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        toggles[(to + toggles.length) % toggles.length].focus();
      });
    });
    all.addEventListener("click", () => {
      const open = all.getAttribute("aria-expanded") !== "true";
      toggles.forEach((b) => set(b, open));
      syncAll();
    });

    // Self-check: 4 of 5 ticked → this level; fewer → the one below (or, for the first
    // level, a word that no prior knowledge is needed). Nothing ticked → no answer yet.
    const checks = [...root.querySelectorAll<HTMLInputElement>("[data-kp-check]")];
    const result = root.querySelector<HTMLElement>("[data-kp-result]")!;
    const tpl = (sel: string) => (root.querySelector<HTMLTemplateElement>(sel)!).content.cloneNode(true);
    const update = () => {
      const n = checks.filter((c) => c.checked).length;
      result.classList.toggle("is-ok", n >= 4);
      if (!n) return result.replaceChildren();
      const count = Object.assign(document.createElement("p"), { className: "kp-count", textContent: `${n} of ${checks.length} ticked.` });
      result.replaceChildren(count, tpl(n >= 4 ? "[data-kp-ok]" : "[data-kp-low]"));
    };
    checks.forEach((c) => c.addEventListener("change", update));
    update(); // a browser that restores ticked boxes on "back"

    // Print: open every block first, so the plan is complete even without the print CSS.
    root.querySelector("[data-kp-print]")!.addEventListener("click", () => {
      toggles.forEach((b) => set(b, true));
      syncAll();
      window.print();
    });
  }
</script>
