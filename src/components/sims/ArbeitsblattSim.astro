---
// A little looping film of how worksheets and games get printed, for MascotGuide's "sim" slot on
// /lehrkraefte/arbeitsblaetter. Three scenes, 4 s each, in step with the guide's three steps:
//   1  laptop: a grid of six worksheet thumbnails, the cursor taps one, it lights up
//   2  laptop: the sheet preview (lines with gaps and small boxes) and a print button, the
//      cursor taps print
//   3  printer: a sheet slides out and down onto the desk, a game card with a die pops up beside it
//
// Same make as UmfrageSim.astro: pure SVG + CSS, no words inside, one 12 s cycle, theme tokens
// so dark mode just works. Reduced motion: no film, the preview scene stands still.
---
<div class="sim" aria-hidden="true">
  <svg viewBox="0 0 320 180" role="presentation">
    <rect class="desk" x="0" y="0" width="320" height="180" rx="14" />

    <!-- 1 · aussuchen -->
    <g class="sc sc1">
      <rect class="bezel" x="86" y="16" width="148" height="100" rx="7" />
      <rect class="screen" x="93" y="23" width="134" height="86" rx="3" />
      <path class="base" d="M66 116h188l-10 14H76z" />
      {[0, 1, 2, 3, 4, 5].map((i) => {
        const x = 101 + (i % 3) * 41, y = 29 + Math.floor(i / 3) * 40;
        return (
          <g>
            <rect class="paper" x={x} y={y} width="34" height="34" rx="3" />
            <rect class="line" x={x + 5} y={y + 6} width="18" height="3" rx="1.5" />
            <rect class="line line--soft" x={x + 5} y={y + 14} width="24" height="3" rx="1.5" />
            <rect class="line line--soft" x={x + 5} y={y + 21} width="20" height="3" rx="1.5" />
            <rect class="line line--soft" x={x + 5} y={y + 28} width="14" height="3" rx="1.5" />
          </g>
        );
      })}
      <rect class="in hl" style="animation-delay:1.9s" x="140" y="67" width="38" height="38" rx="5" />
      <path class="cursor" d="M0 0v14l4-3.5 3 6.5 2.5-1.2-3-6.3H12z" />
    </g>

    <!-- 2 · drucken -->
    <g class="sc sc2">
      <rect class="bezel" x="86" y="16" width="148" height="100" rx="7" />
      <rect class="screen" x="93" y="23" width="134" height="86" rx="3" />
      <path class="base" d="M66 116h188l-10 14H76z" />
      <rect class="paper" x="102" y="28" width="66" height="76" rx="3" />
      <rect class="line" x="109" y="35" width="34" height="4" rx="2" />
      {[0, 1, 2, 3].map((i) => (
        <g class="in" style={`animation-delay:${4.3 + i * 0.3}s`}>
          <rect class="line line--soft" x="109" y={48 + i * 14} width={28 - (i % 2) * 6} height="4" rx="2" />
          <rect class="gap" x={141 - (i % 2) * 6} y={46 + i * 14} width="16" height="8" rx="2" />
        </g>
      ))}
      <rect class="line line--soft" x="180" y="36" width="36" height="4" rx="2" />
      <rect class="line line--soft" x="180" y="46" width="28" height="4" rx="2" />
      <rect class="btn" x="180" y="82" width="40" height="16" rx="8" />
      <rect class="btn-flash" x="180" y="82" width="40" height="16" rx="8" />
      <rect class="btn-ico" x="193" y="86" width="14" height="5" rx="1.5" />
      <rect class="btn-ico" x="196" y="91" width="8" height="4" rx="1" />
      <path class="cursor cursor--2" d="M0 0v14l4-3.5 3 6.5 2.5-1.2-3-6.3H12z" />
    </g>

    <!-- 3 · ausdrucken und spielen -->
    <g class="sc sc3">
      <g class="slide">
        <rect class="paper" x="64" y="84" width="46" height="58" rx="3" />
        <rect class="line" x="71" y="92" width="24" height="4" rx="2" />
        <rect class="line line--soft" x="71" y="102" width="32" height="3" rx="1.5" />
        <rect class="line line--soft" x="71" y="109" width="28" height="3" rx="1.5" />
        <rect class="gap" x="71" y="117" width="14" height="7" rx="2" />
        <rect class="line line--soft" x="71" y="129" width="24" height="3" rx="1.5" />
      </g>
      <rect class="printer" x="40" y="34" width="94" height="52" rx="8" />
      <rect class="tray" x="52" y="76" width="70" height="6" rx="3" />
      <circle class="led" cx="120" cy="48" r="3.5" />
      <rect class="lbl" x="50" y="46" width="30" height="4" rx="2" />
      <g class="in" style="animation-delay:10.2s">
        <rect class="paper" x="176" y="52" width="82" height="92" rx="8" />
        <rect class="line" x="188" y="63" width="40" height="5" rx="2.5" />
        <circle class="chip" cx="244" cy="66" r="6" />
        <rect class="die" x="190" y="82" width="38" height="38" rx="8" />
        {[[200, 92], [218, 92], [209, 101], [200, 110], [218, 110]].map(([x, y]) => <circle class="pip" cx={x} cy={y} r="3.2" />)}
        <rect class="line line--soft" x="188" y="128" width="56" height="4" rx="2" />
      </g>
    </g>
  </svg>
</div>

<style>
  .sim { width: 100%; }
  .sim svg { display: block; width: 100%; height: auto; }

  .desk { fill: var(--blue-100); }
  .bezel, .printer { fill: var(--rail-surface); }
  .screen { fill: var(--surface-card); }
  .base { fill: var(--border-strong); }
  .paper { fill: var(--surface-card); stroke: var(--border-strong); stroke-width: 1.2; }
  .line { fill: var(--border-strong); }
  .line--soft { fill: var(--border); }
  .gap { fill: none; stroke: var(--brand-blue); stroke-width: 1.4; }
  .hl { fill: none; stroke: var(--brand-blue); stroke-width: 2.4; }
  .btn { fill: var(--brand-blue); }
  .btn-ico { fill: #fff; }
  .btn-flash { fill: var(--ink); opacity: 0; }
  .cursor { fill: var(--ink); stroke: var(--surface-card); stroke-width: 1; }
  .tray { fill: var(--border-strong); }
  .led { fill: var(--success); }
  .lbl { fill: var(--surface-card); opacity: .6; }
  .die { fill: var(--brand-blue); }
  .pip { fill: #fff; }
  .chip { fill: var(--accent); }

  /* everything timed: one 12 s cycle, started per part by animation-delay */
  .sc, .in, .cursor, .btn-flash, .slide {
    animation-duration: 12s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-out;
    transform-box: fill-box;
  }
  .sc { opacity: 0; animation-name: ab-sim-scene; }
  .sc2 { animation-delay: 4s; }
  .sc3 { animation-delay: 8s; }
  @keyframes ab-sim-scene { 0% { opacity: 0 } 2%, 31% { opacity: 1 } 33%, 100% { opacity: 0 } }

  /* pops in, stays to the end of its scene */
  .in { opacity: 0; transform-origin: center; animation-name: ab-sim-in; }
  @keyframes ab-sim-in {
    0% { opacity: 0; transform: scale(.4) }
    3% { opacity: 1; transform: scale(1.15) }
    5%, 31% { opacity: 1; transform: scale(1) }
    33%, 100% { opacity: 0 }
  }

  /* scene 1: glide to a thumbnail, tap */
  .sc1 .cursor { animation-name: ab-sim-cursor1; }
  @keyframes ab-sim-cursor1 {
    0%, 8% { transform: translate(200px, 40px) }
    15% { transform: translate(156px, 88px) }
    17% { transform: translate(156px, 88px) scale(.8) }
    19%, 100% { transform: translate(156px, 88px) }
  }

  /* scene 2: glide to print, press */
  .cursor--2 { animation-name: ab-sim-cursor2; animation-delay: 4s; }
  @keyframes ab-sim-cursor2 {
    0%, 14% { transform: translate(200px, 50px) }
    22% { transform: translate(206px, 90px) }
    24% { transform: translate(206px, 90px) scale(.8) }
    26%, 100% { transform: translate(206px, 90px) }
  }
  .btn-flash { animation-name: ab-sim-flash; animation-delay: 4s; }
  @keyframes ab-sim-flash { 0%, 23% { opacity: 0 } 24% { opacity: .35 } 27%, 100% { opacity: 0 } }

  /* scene 3: the sheet slides out from behind the printer onto the desk */
  .slide { animation-name: ab-sim-slide; animation-delay: 8s; }
  @keyframes ab-sim-slide {
    0%, 4% { transform: translateY(-58px); opacity: 0 }
    5% { opacity: 1 }
    16%, 31% { transform: none; opacity: 1 }
    33%, 100% { opacity: 0 }
  }

  /* MascotGuide's pause button */
  :global(.mg-paused) .sim * { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .sim * { animation: none !important; }
    .sc2, .sc2 .in { opacity: 1; }
  }
</style>
