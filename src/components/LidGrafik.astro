---
// One picture per CCSE topic, drawn here as inline SVG in the site's colours: no photos, so
// nothing to license and nothing to download. Each one shows the topic's structure: the three
// powers, the five qualities of the vote, the timeline. Labels are Spanish, the language of the
// test. Used under the facts in all three layouts of the facts page, followed in the English
// view by the topic's key words (Spanish word and English meaning).
interface Props {
  id: string;
  words?: { de: string; easy: string }[];
}
const { id, words = [] } = Astro.props;
const uid = `lg-${id}-${Math.random().toString(36).slice(2, 7)}`;
---
<figure class="lg" data-topic={id}>
  {id === "government-parliament" && (
    <svg viewBox="0 0 560 250" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>The three powers under the Constitution: legislative, executive and judicial</title>
      <path d="M40 70 L280 18 L520 70 Z" class="lg-fill-soft lg-stroke" />
      <text x="280" y="58" class="lg-t lg-t-b" text-anchor="middle">Constitución de 1978</text>
      {[
        { x: 44, t: "Hacer las leyes", s: "Congreso · Senado", w: "Legislativo" },
        { x: 210, t: "Gobernar", s: "Gobierno · presidente", w: "Ejecutivo" },
        { x: 376, t: "Juzgar", s: "Jueces · tribunales", w: "Judicial" },
      ].map((p) => (
        <g>
          <rect x={p.x} y="82" width="140" height="104" rx="8" class="lg-fill lg-stroke" />
          <text x={p.x + 70} y="116" class="lg-t lg-t-b" text-anchor="middle">{p.t}</text>
          <text x={p.x + 70} y="138" class="lg-t lg-t-s" text-anchor="middle">{p.s}</text>
          <text x={p.x + 70} y="168" class="lg-t lg-t-m" text-anchor="middle">{p.w}</text>
        </g>
      ))}
      <rect x="40" y="194" width="480" height="12" rx="3" class="lg-fill-soft lg-stroke" />
      {[0, 1, 2, 3, 4, 5, 6].map((i) => (
        <g transform={`translate(${196 + i * 28} 224)`} class="lg-person">
          <circle r="6" cy="-4" /><path d="M-9 14 Q0 2 9 14 Z" />
        </g>
      ))}
      <text x="160" y="232" class="lg-t lg-t-s" text-anchor="end">El pueblo elige</text>
    </svg>
  )}

  {id === "elections" && (
    <svg viewBox="0 0 560 170" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>The vote is universal, free, equal, direct and secret</title>
      {[
        { t: "universal", s: "desde los 18" },
        { t: "libre", s: "tú decides" },
        { t: "igual", s: "un voto cada uno" },
        { t: "directo", s: "sin intermediarios" },
        { t: "secreto", s: "nadie lo ve" },
      ].map((p, i) => {
        const x = 8 + i * 110;
        return (
          <g>
            <rect x={x} y="12" width="104" height="110" rx="12" class="lg-fill lg-stroke" />
            <text x={x + 52} y="60" class="lg-t lg-t-b" text-anchor="middle">{p.t}</text>
            <text x={x + 52} y="84" class="lg-t lg-t-s" text-anchor="middle">{p.s}</text>
          </g>
        );
      })}
      <text x="280" y="152" class="lg-t lg-t-s" text-anchor="middle">Congreso: cada 4 años · Parlamento Europeo: cada 5 años</text>
    </svg>
  )}

  {id === "values-law" && (
    <svg viewBox="0 0 560 190" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>The Constitution protects equality, freedom of religion, freedom of expression and the right to strike</title>
      <g transform="translate(20 20)">
        <rect width="110" height="150" rx="6" class="lg-fill-strong" />
        <rect x="8" y="0" width="4" height="150" class="lg-fill-soft" />
        <text x="60" y="70" class="lg-t lg-t-inv lg-t-b" text-anchor="middle">CONSTI-</text>
        <text x="60" y="90" class="lg-t lg-t-inv lg-t-b" text-anchor="middle">TUCIÓN</text>
      </g>
      {[
        { t: "Igualdad", s: "art. 14" },
        { t: "Religión", s: "art. 16" },
        { t: "Expresión", s: "art. 20" },
        { t: "Huelga", s: "art. 28" },
      ].map((p, i) => {
        const x = 150 + (i % 2) * 200, y = 20 + Math.floor(i / 2) * 80;
        return (
          <g>
            <rect x={x} y={y} width="188" height="68" rx="10" class="lg-fill lg-stroke" />
            <text x={x + 94} y={y + 32} class="lg-t lg-t-b" text-anchor="middle">{p.t}</text>
            <text x={x + 94} y={y + 52} class="lg-t lg-t-s" text-anchor="middle">{p.s}</text>
          </g>
        );
      })}
    </svg>
  )}

  {id === "four-nations" && (
    <svg viewBox="0 0 560 120" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>Spain has 17 comunidades autónomas, 2 ciudades autónomas and 50 provinces</title>
      {[
        { n: "17", t: "comunidades", s: "autónomas" },
        { n: "2", t: "ciudades", s: "autónomas" },
        { n: "50", t: "provincias", s: "en toda España" },
      ].map((p, i) => (
        <g>
          <rect x={12 + i * 180} y="20" width="170" height="80" rx="12" class="lg-fill lg-stroke" />
          <text x={50 + i * 180} y="74" class="lg-t lg-num" text-anchor="middle">{p.n}</text>
          <text x={82 + i * 180} y="56" class="lg-t lg-t-b">{p.t}</text>
          <text x={82 + i * 180} y="76" class="lg-t lg-t-s">{p.s}</text>
        </g>
      ))}
    </svg>
  )}

  {id === "history" && (
    <svg viewBox="0 0 560 190" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>Timeline of Spanish history from 1492 to 1986</title>
      <line x1="20" y1="96" x2="540" y2="96" class="lg-line" />
      {[
        { y: "1492", t: "Colón", t2: "en América", x: 40, tone: "mid" },
        { y: "1812", t: "Constitución", t2: "de Cádiz", x: 120, tone: "ok" },
        { y: "1931", t: "Segunda", t2: "República", x: 200, tone: "ok" },
        { y: "1936", t: "Guerra", t2: "Civil", x: 280, tone: "bad" },
        { y: "1939", t: "Dictadura", t2: "de Franco", x: 360, tone: "bad" },
        { y: "1978", t: "Constitución", t2: "actual", x: 440, tone: "ok" },
        { y: "1986", t: "Entrada", t2: "en la CEE", x: 520, tone: "ok" },
      ].map((e, i) => (
        <g>
          <circle cx={e.x} cy="96" r="9" class={`lg-dot lg-dot--${e.tone}`} />
          <text x={e.x} y={i % 2 ? 128 : 72} class="lg-t lg-t-b" text-anchor="middle">{e.y}</text>
          <text x={e.x} y={i % 2 ? 150 : 32} class="lg-t lg-t-s" text-anchor="middle">{e.t}</text>
          <text x={e.x} y={i % 2 ? 166 : 48} class="lg-t lg-t-s" text-anchor="middle">{e.t2}</text>
        </g>
      ))}
    </svg>
  )}

  {id === "everyday-life" && (
    <svg viewBox="0 0 560 120" role="img" aria-labelledby={`${uid}-t`} lang="es">
      <title id={`${uid}-t`}>Key figures: emergency number 112, school from 6 to 16, national day on 12 October</title>
      {[
        { n: "112", t: "emergencias", s: "en toda España" },
        { n: "16", t: "fin de la escuela", s: "obligatoria: de 6 a 16" },
        { n: "12", t: "de octubre", s: "Fiesta Nacional" },
      ].map((p, i) => (
        <g>
          <rect x={12 + i * 180} y="20" width="170" height="80" rx="12" class="lg-fill lg-stroke" />
          <text x={46 + i * 180} y="74" class="lg-t lg-num" style="font-size:26px" text-anchor="middle">{p.n}</text>
          <text x={78 + i * 180} y="56" class="lg-t lg-t-b" style="font-size:12px">{p.t}</text>
          <text x={78 + i * 180} y="76" class="lg-t lg-t-s" style="font-size:10px">{p.s}</text>
        </g>
      ))}
    </svg>
  )}

  {words.length > 0 && (
    <div class="lg-words fk-easy">
      <p class="lg-words-h" data-i18n="lid.fk.words">Key words</p>
      <dl>
        {words.map((w) => (<div><dt lang="es">{w.de}</dt><dd>{w.easy}</dd></div>))}
      </dl>
    </div>
  )}
</figure>

<style is:global>
  .lg { margin: 18px 0 6px; }
  .lg svg { display: block; width: 100%; height: auto; max-width: 620px; margin: 0 auto; }
  /* On a phone a 560-wide drawing scaled to 330px puts its labels at 7px. It keeps a
     readable width instead and scrolls sideways inside the figure. */
  @media (max-width: 600px) {
    .lg { overflow-x: auto; -webkit-overflow-scrolling: touch; margin-inline: -4px; padding-bottom: 6px; }
    .lg svg { min-width: 500px; }
    .lg-words { min-width: 0; position: sticky; left: 0; }
  }
  .lg .lg-fill { fill: var(--surface-card); }
  .lg .lg-fill-soft { fill: color-mix(in srgb, var(--brand-blue) 10%, var(--surface-card)); }
  .lg .lg-fill-strong { fill: var(--brand-blue); }
  .lg .lg-stroke { stroke: color-mix(in srgb, var(--brand-blue) 45%, var(--border)); stroke-width: 1.5; }
  .lg .lg-line { stroke: var(--border-strong); stroke-width: 3; stroke-linecap: round; }
  .lg .lg-t { fill: var(--ink); font-family: var(--font-body); font-size: 13px; }
  .lg .lg-t-b { font-weight: 700; font-size: 14px; }
  .lg .lg-t-s { fill: var(--muted); font-size: 11.5px; }
  .lg .lg-t-m { fill: var(--brand-blue-dark, var(--brand-blue)); font-weight: 700; font-size: 12px; letter-spacing: .04em; }
  .lg .lg-t-muted { fill: var(--muted-soft, var(--muted)); }
  .lg .lg-t-inv { fill: #fff; }
  .lg .lg-num { fill: var(--brand-blue); font-size: 34px; font-weight: 700; }
  .lg .lg-icon { fill: none; stroke: var(--brand-blue); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .lg .lg-icon .lg-ok { stroke: var(--success, #047857); }
  .lg .lg-person { fill: color-mix(in srgb, var(--brand-blue) 55%, var(--surface-card)); }
  .lg .lg-dot { stroke: var(--surface-card); stroke-width: 3; }
  .lg .lg-dot--ok { fill: var(--success, #047857); }
  .lg .lg-dot--bad { fill: var(--danger, #c1462f); }
  .lg .lg-dot--mid { fill: var(--muted); }

  /* The key words, only in the English view (.fk-easy, fakten-layouts.css). */
  .lg-words { margin: 18px auto 0; max-width: 620px; padding: 14px 16px; border-radius: 12px; background: color-mix(in srgb, var(--brand-blue) 7%, var(--surface-card)); border: 1px solid color-mix(in srgb, var(--brand-blue) 25%, var(--border)); }
  .lg-words-h { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-blue-dark, var(--brand-blue)); }
  .lg-words dl { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px 18px; }
  .lg-words dt { font-weight: 700; color: var(--ink); }
  .lg-words dd { margin: 0; color: var(--muted); font-size: .95rem; }
</style>
