---
// „Bruno Kart spielen“ — the game (/spiele/artikel-sprint) pointed to from the
// der/die/das-Trainer, the same words as a race instead of a card. Same shape as
// GrammatikStartTeaser.astro.
//
// Hamsti stands outside the data-i18n elements: the i18n pass replaces textContent and
// would wipe the SVG. data-mascot-part lets „Maskottchen: aus“ remove him and keep the link.
import { mascotSvg } from "../lib/mascots.js";

const hamsti = mascotSvg({ name: "hamsti", expr: "celebrate", view: "three", size: 42, label: "" });
---
<a class="sp-teaser" href="/spiele/artikel-sprint">
  <span class="sp-teaser-fig" data-mascot-part aria-hidden="true"><Fragment set:html={hamsti} /></span>
  <span class="sp-teaser-txt">
    <b data-i18n="sprint.teaser.title">Lieber spielen? Bruno Kart</b>
    <span data-i18n="sprint.teaser.sub">der, die, das im Laufspiel – auch gegen Freunde</span>
  </span>
  <span class="sp-teaser-go" aria-hidden="true">→</span>
</a>

<style>
  .sp-teaser {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-lg, 14px);
    border: 1px solid var(--border);
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease, transform .15s ease;
  }
  .sp-teaser:hover { border-color: var(--brand-blue); }
  .sp-teaser:active { transform: translateY(1px); }
  .sp-teaser-fig { flex: none; display: inline-flex; }
  .sp-teaser-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .sp-teaser-txt b { font-size: .975rem; font-weight: var(--fw-bold, 700); color: var(--ink); }
  .sp-teaser-txt span { font-size: .8125rem; line-height: 1.45; color: var(--muted); }
  .sp-teaser-go {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-blue);
    color: #fff;
    font-weight: 700;
  }
</style>
