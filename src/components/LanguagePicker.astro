---
// The interface-language button and its nested menu (src/lib/languagePicker.js), used by
// LanguageSwitcher in the header and the nav drawer. The flashcards open the same menu
// from their „Mehr ▾" tab (wortschatz-app.js).
//
// The mark is the "translate" glyph (a CJK character beside a Latin A), not a globe: a globe
// reads as "website / region" to someone who cannot read the "DE" beside it, the
// A-and-character pair reads as "language" in every script. Flags were tried and rejected —
// a flag names a country, not a language (whose flag is Arabic?), and Windows renders flag
// emoji as the two letters "DE" anyway.
//
// The accessible name is "Sprache · Language", and the script adds the word for "language"
// in the visitor's own browser language (registry `word`), so it reads for that visitor
// however many languages there are. Deliberately not in public/i18n: it is for the reader
// who cannot read the current page language.
const LABEL = "Sprache · Language";
---
<div class="lang-switcher" data-lang-switcher>
  <button type="button" class="lang-switcher-btn" data-lang-btn aria-haspopup="dialog" aria-expanded="false" aria-label={LABEL} title={LABEL}>
    <svg class="lang-switcher-ic" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0 0 14.07 6H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/></svg>
    <span data-lang-code>DE</span>
    <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<style>
  .lang-switcher { position: relative; }
  .lang-switcher-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: .85rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  .lang-switcher-btn:hover { border-color: var(--brand-blue); }
  .lang-switcher-ic { color: var(--brand-blue); flex: none; }
</style>

<script>
  import { getLang, setLang, onLangChange } from "../lib/i18n.js";
  import { languagesFor, LANGUAGE_REGISTRY } from "../lib/languages.js";
  import { openLanguagePicker, suggestedLang } from "../lib/languagePicker.js";

  const UI = languagesFor("ui");
  const BASE_LABEL = "Sprache · Language";

  // "language" in the visitor's browser language, when that is neither German nor English.
  const asked = suggestedLang(LANGUAGE_REGISTRY.filter((l) => l.word).map((l) => l.code));
  const extra = asked && asked !== "de" && asked !== "en" ? LANGUAGE_REGISTRY.find((l) => l.code === asked)?.word : null;
  const label = extra ? `${BASE_LABEL} · ${extra}` : BASE_LABEL;

  document.querySelectorAll("[data-lang-switcher]").forEach((root) => {
    const btn = root.querySelector("[data-lang-btn]");
    const codeEl = root.querySelector("[data-lang-code]");
    btn.setAttribute("aria-label", label);
    btn.title = label;

    const reflect = (code) => {
      codeEl.textContent = (UI.find((l) => l.code === code) ?? UI[0]).code.toUpperCase();
    };
    reflect(getLang());
    onLangChange(reflect);

    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      openLanguagePicker({
        anchor: btn,
        surface: "ui",
        items: UI,
        current: getLang(),
        label,
        onPick: (code) => setLang(code),
      });
    });
  });
</script>
