---
// The /nav1–/nav6 comparison pages: the whole site nav with one Wissen-panel variant each,
// the panel open on arrival. noindex, and to be deleted once a variant is chosen.
import Layout from "../layouts/Layout.astro";
import SiteNav from "./SiteNav.astro";

interface Props { n: 1 | 2 | 3 | 4 | 5 | 6 }
const { n } = Astro.props;
const VARIANTS = {
  1: { key: "current", name: "Fünf Spalten", what: "Fünf Bereiche nebeneinander, das Nachschlagewerk (Verbtabellen, Wortarten) als eigene Spalte. Bis 2026-10-08 das Menü der Seite." },
  2: { key: "old", name: "Vorher", what: "Das Wissen-Menü vor dem 7. Oktober: vier Spalten, ohne Nachschlagewerk." },
  4: { key: "oldplus", name: "Vorher + Nachschlagewerk", what: "Von 2026-10-08 bis 2026-10-23 das Menü der ganzen Seite. Die vier Spalten von vorher, unverändert. Das Nachschlagewerk (Verbtabellen, Wortarten und Co.) steht als Leiste darunter, über die ganze Breite und an den Spalten ausgerichtet." },
  5: { key: "oldbooks", name: "Vorher + in Bücher", what: "Die vier Spalten von vorher. Das Nachschlagewerk steht als zweite Gruppe in der Bücher-Spalte: beides schlägt man nach, statt es zu üben." },
  6: { key: "oldchips", name: "Vorher + Chips oben", what: "Die vier Spalten von vorher. Darüber eine Zeile mit dem Nachschlagewerk als Chips: kurz, immer sichtbar, ohne Beschreibung." },
  3: { key: "tabs", name: "Neu: Leiste", what: "Die Bereiche als Leiste links, rechts die Links des Bereichs, auf den man zeigt. Gleich breit und gleich hoch, egal wie viele Bereiche dazukommen." },
} as const;
const v = VARIANTS[n];
---
<Layout title={`Nav ${n} – ${v.name}`} noindex>
  <SiteNav active="wissen" wissenVariant={v.key} />
  <main class="nv-main">
    <p class="nv-tabs">
      {([1, 2, 4, 5, 6, 3] as const).map((i) => (
        <a href={`/nav${i}`} aria-current={i === n ? "page" : undefined}>/nav{i} · {VARIANTS[i].name}</a>
      ))}
    </p>
    <h1>Nav {n}: {v.name}</h1>
    <p>{v.what}</p>
    <p class="nv-hint">Das Wissen-Menü ist beim Laden offen. Danach wie immer: mit der Maus auf „Wissen“ zeigen. Unter 1080&nbsp;px Breite gibt es die Leiste nicht, dort öffnet das Burger-Menü die Handy-Schublade.</p>
  </main>
</Layout>

<script>
  // Open the Wissen panel once, so the variant is on screen without hunting for it.
  const menu = document.querySelector<HTMLElement>('[data-menu="wissen"]');
  const panel = menu?.querySelector<HTMLElement>("[data-menu-panel]");
  if (menu && panel && matchMedia("(min-width: 1081px)").matches) {
    panel.removeAttribute("hidden");
    menu.classList.add("is-open");
    menu.querySelector("[data-menu-btn]")?.setAttribute("aria-expanded", "true");
  }
</script>

<style>
  .nv-main { max-width: 760px; margin: 0 auto; padding: 600px 16px 64px; }
  .nv-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
  .nv-tabs a { padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; color: var(--ink); text-decoration: none; font-size: 14px; }
  .nv-tabs a[aria-current="page"] { background: var(--blue-50); border-color: var(--blue-200); color: var(--brand-blue); font-weight: 600; }
  .nv-hint { color: var(--muted); font-size: 14px; }
  @media (max-width: 1080px) { .nv-main { padding-top: 32px; } }
</style>
