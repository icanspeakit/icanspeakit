---
// The account control's slot in the nav, without an account system (src/lib/backend.js:
// BACKEND.auth = false). Progress lives in this browser only, so the slot links to it.
//
// Same markup classes as the old Supabase island (auth/AuthStatus.jsx in icanspeak Spanish),
// so src/styles/auth.css styles it unchanged. When accounts arrive, replace this file with
// an island that renders "Sign in" / the avatar here.
import "../styles/auth.css";

interface Props {
  /** "nav": the pill in the desktop cluster; "drawer": the card in the mobile panel. */
  variant?: "nav" | "drawer";
}
const { variant = "nav" } = Astro.props;
---
{variant === "drawer" ? (
  <div class="da-acct-card">
    <a class="da-acct-card-main" href="/progress">
      <span class="lp-drawer-ic" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 14a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z" fill-rule="evenodd" />
          <circle cx="12" cy="12" r="1.4" />
        </svg>
      </span>
      <span class="lp-drawer-txt">
        <b data-i18n="nav.account.progress.short">Progress</b>
        <i data-i18n="auth.nav.localOnly">Only on this device</i>
      </span>
    </a>
  </div>
) : (
  <a class="da-auth-signin" href="/progress">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 3v18h18" />
      <path d="m7 15 4-4 3 3 5-6" />
    </svg>
    <span data-i18n="nav.account.progress.short">Progress</span>
  </a>
)}
