---
// The exam switcher on a /exams detail page (ExamShell.astro): Übersicht, then every
// exam by the name a learner knows it by, the current one marked. It used to be a side
// rail on the /exams hub itself — but there the page body already lists every exam
// as a card, so the rail said the same thing twice. One level deeper it is the way
// sideways from one exam to the next without going back up.
//
// A chip row rather than a side column: the detail pages are already two columns (the
// practice and the sliding explanation), and a third would not fit beside them.
//
// Two levels, not seven equal pills: the way up ("← Alle Prüfungen") is a quiet link above,
// and the exams are one underlined tab row — the current one in ink with a brand underline,
// the rest muted. The CCSE stands apart behind a divider: it is the nationality
// knowledge test, not a language exam with a level. Names follow docs/content-plan.md §2;
// the hrefs are the old slots until the `routes` item renames them.
import "../styles/exam-rail.css";
import { stripBase } from "../lib/paths.js";

const exams = [
  { name: "DELE A1", href: "/a1-test", level: "A1" },
  { name: "DELE", href: "/cambridge", level: "A1–C2" },
  { name: "DELE A2 for nationality", href: "/trinity/ise-1", level: "A2" },
  { name: "SIELE", href: "/ielts", level: "A1–C1" },
  { name: "SIELE by level", href: "/trinity", level: "A2–C1" },
];
const lid = { name: "CCSE", href: "/life-in-the-uk" };
const here = stripBase(Astro.url.pathname).replace(/\/+$/, "");
---
<nav class="ex-rail" aria-label="Exams" data-i18n-attr="aria-label:nav.exams">
  <a class="ex-rail-up" href="/exams"><span data-i18n="nav.panel.allExams">See all exams</span></a>
  <div class="ex-rail-tabs">
    {exams.map((e) => (
      <a class="ex-rail-item" href={e.href} aria-current={here === e.href ? "page" : undefined}>
        {e.name}<span class="ex-rail-level">{e.level}</span>
      </a>
    ))}
    <span class="ex-rail-sep" aria-hidden="true"></span>
    <a class="ex-rail-item" href={lid.href} aria-current={here === lid.href ? "page" : undefined}>{lid.name}</a>
  </div>
</nav>


<script>
  // On a phone the row scrolls; start it at the exam you are on, not cut off at the edge.
  const cur = document.querySelector<HTMLElement>(".ex-rail-item[aria-current='page']");
  const row = cur?.parentElement;
  if (cur && row && row.scrollWidth > row.clientWidth) row.scrollLeft = cur.offsetLeft - (row.clientWidth - cur.offsetWidth) / 2;
</script>
