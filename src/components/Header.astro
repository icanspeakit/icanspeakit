---
interface Props {
  altHref?: string;
}

const { altHref } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

const copy = {
  en: {
    tagline: 'Word origins & speaking practice',
  },
  de: {
    tagline: 'Wortursprünge & Sprechtraining',
  },
} as const;

const t = copy[locale as 'en' | 'de'] ?? copy.en;
const otherLocale = locale === 'de' ? 'en' : 'de';
const otherHref = altHref ?? (locale === 'de' ? '/' : '/de/');
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href={locale === 'de' ? '/de/' : '/'} class="brand">
      <span class="brand__word">
        icanspeak<span class="brand__it">ı<span class="brand__dot"></span>t</span>
      </span>
      <span class="brand__tagline">{t.tagline}</span>
    </a>

    <a href={otherHref} class="lang-switch" hreflang={otherLocale} lang={otherLocale}>
      {otherLocale.toUpperCase()}
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 247, 239, 0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    grid-column: 2;
    line-height: 1;
    text-align: center;
  }

  .brand__word {
    font-family: 'Literata', var(--font-display);
    font-weight: 500;
    font-size: 1.55rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  .brand__it {
    position: relative;
    display: inline-block;
    margin-left: 0.12em;
  }

  .brand__dot {
    position: absolute;
    left: 0.07em;
    top: -0.07em;
    width: 0.18em;
    height: 0.18em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .brand__tagline {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    grid-column: 3;
    justify-self: end;
  }

  .lang-switch:hover {
    border-color: var(--color-primary);
    background: var(--color-primary-soft);
  }
</style>
