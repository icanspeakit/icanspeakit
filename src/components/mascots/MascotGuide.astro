---
// A mascot that explains how a tool works, in a few numbered steps — and can be folded away.
//
//   <MascotGuide id="umfragen" title="So funktioniert's" titleKey="uf.t.guide.title">
//     <li data-i18n="…">Erstellen: …</li>
//   </MascotGuide>
//
// A <details>: open on the first visit, folded to a one-line pill once the person folds it.
// That choice is remembered per guide on this device (localStorage "da_guide_<id>"); the inline
// script runs before paint, so a folded guide never flashes open. With storage blocked it just
// opens again.
//
// Only the figure hides with "Maskottchen ausblenden" (it carries .mascot) — the steps stay,
// they are the explanation. Keep the mascot OUTSIDE data-i18n elements (the i18n pass would
// wipe the SVG); the slot holds <li> items with their own data-i18n.
//
// Optional slot "sim": a little looping film beside the steps (e.g. sims/UmfrageSim.astro).
// It must run a 12 s cycle in three 4 s scenes — the first three steps light up in time with
// it. A pause button sits under the film (moving content longer than 5 s needs one).
//
// `once` (the /explore/films page): the film waits until it is on screen, plays its 12 s one
// time and stops on its last scene with every step lit; the button under it is „Nochmal“.
import { mascotSvg } from "../../lib/mascots.js";

interface Props {
  id: string;
  title: string;
  titleKey?: string;
  name?: "bruno" | "regi" | "hamsti" | "quaki";
  expr?: "happy" | "thinking" | "celebrate" | "oops" | "sleepy";
  /** An accessory (src/lib/mascots.js): "klemmbrett" = Bruno in the teacher area; the film
   *  props (pfeife, stoppuhr, lupe …) give every film's mascot its own gimmick, moving after the walk-in. */
  extra?: "schleife" | "fliege" | "klemmbrett" | "pfeife" | "stoppuhr" | "megafon" | "pokal" | "ballon" | "zeigestock" | "bleistift" | "lupe" | "mikrofon" | "karten";
  class?: string;
  /** Play the film once when it comes into view, then stop; the button replays it. */
  once?: boolean;
}
const { id, title, titleKey, name = "bruno", expr = "happy", extra, class: cls, once = false } = Astro.props;
const svg = mascotSvg({ name, expr, view: "three", size: 56, extra, label: "", className: "mg-fig" });
const key = `da_guide_${id}`;
const hasSim = Astro.slots.has("sim");
---
<details class:list={["mg", hasSim && "mg--sim", once && hasSim && ["mg--once", "mg-paused"], cls]} open data-guide={key} data-once={once && hasSim ? "" : undefined}>
  <summary class="mg-sum">
    <Fragment set:html={svg} />
    <span class="mg-title" data-i18n={titleKey}>{title}</span>
    <span class="mg-fold" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="18" height="18"><path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </summary>
  <div class="mg-body">
    {hasSim && (
      <div class="mg-sim">
        <slot name="sim" />
        {once ? (
          <button type="button" class="mg-pause mg-replay" data-guide-replay>
            <span data-i18n="guide.replay">↻ Nochmal ansehen</span>
          </button>
        ) : (
          <button type="button" class="mg-pause" data-guide-pause>
            <span class="mg-pause-off" data-i18n="guide.pause">❚❚ Pause</span>
            <span class="mg-pause-on" data-i18n="guide.play">▶ Abspielen</span>
          </button>
        )}
      </div>
    )}
    <ol class="mg-steps"><slot /></ol>
  </div>
</details>
<script is:inline define:vars={{ key }}>
  (() => {
    const el = document.querySelector(`[data-guide="${key}"]`);
    if (!el) return;
    try { if (localStorage.getItem(key) === "zu") el.open = false; } catch {}
    // Bruno walks in from the right edge to his place once the box is on screen – open or
    // folded – and „So funktioniert's“ appears when he is there: slow enough to be noticed,
    // nothing else moves. Set before paint (data-walk hides him), started by the observer.
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!calm && "IntersectionObserver" in window) {
      el.setAttribute("data-walk", "");
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const sum = el.querySelector(".mg-sum");
        const fig = sum?.querySelector(".mg-fig");
        if (!fig) return el.removeAttribute("data-walk");
        // A slow trot from close by: at most 240 px to his right (still inside the column),
        // about 85 px a second, a step every 0.32 s; a jump when he is there.
        const edge = (el.parentElement ?? el).getBoundingClientRect().right;
        const from = Math.max(0, Math.min(240, edge - fig.getBoundingClientRect().right - 8));
        const dur = Math.max(1.6, from / 85);
        el.style.setProperty("--mg-from", `${from}px`);
        el.style.setProperty("--mg-dur", `${dur}s`);
        el.style.setProperty("--mg-hops", String(Math.max(4, Math.round(dur / 0.32))));
        el.classList.add("is-walking");
      }, { threshold: 0.6 });
      io.observe(el);
    }
    el.querySelector("[data-guide-pause]")?.addEventListener("click", () => el.classList.toggle("mg-paused"));
    // Once: paused from the server (mg-paused), started when the film is half on screen, frozen
    // just before the 12 s loop would jump back to its first frame. Replay restarts every
    // animation in the film and the steps by dropping them for one frame.
    if (el.hasAttribute("data-once")) {
      const sim = el.querySelector(".mg-sim");
      let timer;
      const done = () => el.classList.add("mg-paused", "mg-done");
      const play = () => {
        el.classList.remove("mg-done");
        el.classList.add("mg-restart");
        void el.offsetWidth;
        el.classList.remove("mg-restart", "mg-paused");
        clearTimeout(timer);
        timer = setTimeout(done, 11600);
      };
      if (calm || !sim || !("IntersectionObserver" in window)) done();
      else {
        const seen = new IntersectionObserver((es) => {
          if (!es.some((e) => e.isIntersecting)) return;
          seen.disconnect();
          play();
        }, { threshold: 0.5 });
        seen.observe(sim);
      }
      el.querySelector("[data-guide-replay]")?.addEventListener("click", play);
    }
    el.addEventListener("toggle", () => {
      try { el.open ? localStorage.removeItem(key) : localStorage.setItem(key, "zu"); } catch {}
    });
  })();
</script>

<style>
  .mg {
    background: var(--blue-50);
    border: 1px solid var(--blue-200);
    border-radius: 18px;
    margin: 0 0 18px;
  }
  .mg:not([open]) {
    display: inline-block;
    border-radius: 999px;
  }
  .mg-sum {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px 10px 10px;
    cursor: pointer;
    list-style: none;
    border-radius: inherit;
  }
  .mg-sum::-webkit-details-marker { display: none; }
  .mg-sum:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .mg-sum :global(.mg-fig) { flex: none; transition: width .2s ease, height .2s ease; }
  .mg:not([open]) .mg-sum { padding: 4px 14px 4px 6px; }
  .mg:not([open]) .mg-sum :global(.mg-fig) { width: 34px; height: 34px; }
  .mg-title {
    flex: 1;
    font-family: var(--font-voice);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
  }
  .mg:not([open]) .mg-title { font-size: .95rem; }
  .mg-fold {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--brand-blue-dark);
    background: var(--surface-card);
    border: 1px solid var(--blue-200);
    transform: rotate(180deg);
    transition: transform .2s ease;
  }
  .mg:not([open]) .mg-fold { transform: none; width: 24px; height: 24px; }
  .mg-body { padding: 0 16px 14px; }
  .mg--sim .mg-body { display: grid; gap: 14px; }
  @media (min-width: 720px) {
    .mg--sim .mg-body { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 20px; }
  }
  .mg-sim { display: grid; gap: 6px; justify-items: end; }
  .mg-pause {
    font: inherit;
    font-size: .8rem;
    font-weight: 600;
    color: var(--brand-blue-dark);
    background: var(--surface-card);
    border: 1px solid var(--blue-200);
    border-radius: 999px;
    padding: 4px 12px;
    min-height: 32px;
    cursor: pointer;
  }
  .mg-pause:focus-visible { outline: 2px solid var(--brand-blue); outline-offset: 2px; }
  .mg-pause-on, .mg-paused .mg-pause-off { display: none; }
  .mg-paused .mg-pause-on { display: inline; }
  .mg-steps {
    counter-reset: mg;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .mg-steps :global(li) {
    counter-increment: mg;
    position: relative;
    padding-left: 36px;
    color: var(--ink);
    line-height: 1.45;
  }
  .mg-steps :global(li)::before {
    content: counter(mg);
    position: absolute;
    left: 0;
    top: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: .85rem;
    color: #fff;
    background: var(--brand-blue);
  }
  .mg-steps :global(li.mg-tip) { color: var(--muted); font-size: .92rem; }
  .mg-steps :global(li.mg-tip)::before { content: "💡"; background: none; font-size: 1rem; }
  /* with a film: the step whose scene plays is lit, the others wait half-faded */
  .mg--sim .mg-steps :global(li:not(.mg-tip)) {
    opacity: .5;
    animation: mg-step 12s infinite;
  }
  .mg--sim .mg-steps :global(li:nth-child(2)) { animation-delay: 4s; }
  .mg--sim .mg-steps :global(li:nth-child(3)) { animation-delay: 8s; }
  .mg--sim .mg-steps :global(li:nth-child(n + 4):not(.mg-tip)) { animation: none; }
  .mg-paused .mg-steps :global(li) { animation-play-state: paused; }
  /* once: run through, then every step stays lit; the replay button appears when it is over */
  .mg--sim.mg-done .mg-steps :global(li:not(.mg-tip)) { animation: none; opacity: 1; transition: opacity .4s ease; }
  .mg-restart :global(.sim *), .mg-restart .mg-steps :global(li) { animation: none !important; }
  .mg--once:not(.mg-done) .mg-replay { visibility: hidden; }
  @keyframes mg-step { 0% { opacity: .5 } 2%, 31% { opacity: 1 } 33%, 100% { opacity: .5 } }
  /* the walk-in: hidden until the box is seen, then he trots in from the right (the figure
     faces left, the way he goes), jumps for joy at his place, and the title follows */
  .mg[data-walk] .mg-sum :global(.mg-fig),
  .mg[data-walk] .mg-title { opacity: 0; }
  .mg.is-walking .mg-sum :global(.mg-fig) {
    position: relative; z-index: 1; transform-origin: 50% 90%;
    animation:
      mg-walk var(--mg-dur, 2s) cubic-bezier(.2, .1, .6, 1) forwards,
      mg-hop .32s ease-in-out var(--mg-hops, 6),
      mg-arrive .7s var(--mg-dur, 2s) ease-out;
  }
  .mg.is-walking .mg-title { animation: mg-title-in .5s calc(var(--mg-dur, 2s) + .45s) ease-out forwards; }
  @keyframes mg-walk {
    0% { opacity: 0; translate: var(--mg-from, 80px) 0; }
    6% { opacity: 1; }
    100% { opacity: 1; translate: 0 0; }
  }
  /* one trot step: up with the nose down, land with a little squash, tail end up */
  @keyframes mg-hop {
    0%, 100% { transform: none; }
    25% { transform: translateY(-9px) rotate(-7deg); }
    55% { transform: translateY(0) rotate(5deg) scale(1.04, .94); }
    75% { transform: translateY(-2px) rotate(2deg); }
  }
  /* there: crouch, jump, land */
  @keyframes mg-arrive {
    0% { transform: none; }
    15% { transform: scale(1.1, .86); }
    45% { transform: translateY(-22px) rotate(-10deg) scale(.95, 1.06); }
    75% { transform: translateY(0) scale(1.08, .9); }
    100% { transform: none; }
  }
  @keyframes mg-title-in {
    from { opacity: 0; transform: translateX(-6px); }
    to { opacity: 1; transform: none; }
  }
  /* The film props (mascots.js PROPS): one small move each, every few seconds, starting once
     the mascot has arrived – so no two of the ten films look alike. */
  .mg :global(.mg-fig [class^="mx-"]) { animation: 4s 3s infinite ease-in-out both; }
  .mg :global(.mx-toot) { animation-name: mx-toot; opacity: 0; }
  .mg :global(.mx-pfeife) { animation-name: mx-blow; }
  .mg :global(.mx-hand) { animation: mx-tick 8s 3s infinite steps(8); }
  .mg :global(.mx-wellen) { animation-name: mx-shout; opacity: 0; }
  .mg :global(.mx-glanz) { animation-name: mx-glint; }
  .mg :global(.mx-ballon) { animation-name: mx-bob; animation-duration: 3s; }
  .mg :global(.mx-zeig) { animation-name: mx-tap; }
  .mg :global(.mx-stift) { animation-name: mx-write; animation-duration: 3s; }
  .mg :global(.mx-lupe) { animation-name: mx-scan; animation-duration: 5s; }
  .mg :global(.mx-n1), .mg :global(.mx-n2) { animation-name: mx-note; opacity: 0; }
  .mg :global(.mx-n2) { animation-delay: 3.5s; }
  .mg :global(.mx-karte) { animation-name: mx-flip; }
  .mg-paused :global(.mg-fig [class^="mx-"]) { animation-play-state: paused; }
  @keyframes mx-blow { 0%, 60%, 100% { transform: none; } 66%, 82% { transform: scale(1.12); } }
  @keyframes mx-toot { 0%, 62%, 100% { opacity: 0; transform: scale(.6); } 68%, 84% { opacity: 1; transform: scale(1.1); } }
  @keyframes mx-tick { to { transform: rotate(360deg); } }
  @keyframes mx-shout { 0%, 55%, 100% { opacity: 0; translate: -6px 0; } 65%, 85% { opacity: 1; translate: 0 0; } }
  @keyframes mx-glint { 0%, 70%, 100% { transform: scale(0) rotate(0); } 80% { transform: scale(1.2) rotate(45deg); } 90% { transform: scale(.9) rotate(90deg); } }
  @keyframes mx-bob { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(5deg) translateY(-3px); } }
  @keyframes mx-tap { 0%, 60%, 100% { transform: none; } 68% { transform: rotate(-9deg); } 76% { transform: none; } 84% { transform: rotate(-9deg); } }
  @keyframes mx-scan { 0%, 100% { transform: none; } 30% { transform: rotate(-8deg) translate(-2px, -2px); } 65% { transform: rotate(6deg) translate(2px, 1px); } }
  @keyframes mx-note { 0%, 45% { opacity: 0; translate: 0 6px; } 60% { opacity: 1; } 90% { opacity: 1; translate: 3px -6px; } 100% { opacity: 0; translate: 4px -10px; } }
  @keyframes mx-flip { 0%, 55%, 100% { transform: none; } 65% { transform: scaleX(0); } 75% { transform: scaleX(-1); } 85%, 95% { transform: scaleX(1); } }
  @keyframes mx-write { 0%, 100% { transform: none; } 20% { transform: rotate(4deg) translate(2px, 1px); } 40% { transform: rotate(-3deg); } 60% { transform: rotate(4deg) translate(3px, 2px); } 80% { transform: rotate(-2deg); } }
  @media (prefers-reduced-motion: reduce) {
    .mg :global(.mg-fig [class^="mx-"]) { animation: none; }
    .mg :global(.mx-toot), .mg :global(.mx-wellen), .mg :global(.mx-n1), .mg :global(.mx-n2) { opacity: 1; }
    .mg--sim .mg-steps :global(li:not(.mg-tip)) { animation: none; opacity: 1; }
    .mg-pause { display: none; }
    .mg-fold, .mg-sum :global(.mg-fig) { transition: none; }
  }
</style>
