---
// The way from a lexicon Lernset about work to Deutsch für den Beruf (FACHVOKABULAR Tier 3,
// cross-links). One line in the trainer's hero slot. Pflege goes to its own short page,
// which in turn sends the learner on to pflegeplace.com.
interface Props { setId: string }
const { setId } = Astro.props;
const LINKS: Record<string, string> = {
  "a1-12": "/english-for-work",
  "a2-10": "/english-for-work",
  "b1-32": "/english-for-work",
  "b1-33": "/english-for-work/care-work",
};
const href = LINKS[setId];
---
{href && (
  <div class="bv-xlink">
    <a href={href}>
      <span data-i18n="berufe.xlink">Mehr Wörter für deinen Beruf: Deutsch für den Beruf</span>&nbsp;→
    </a>
  </div>
)}

<style>
  .bv-xlink { margin: 6px 0 0; font-size: .86rem; text-align: center; }
</style>
