---
// "Wie oft kommt welcher Fall vor?" — a donut of how often a noun stands in each case, on
// /grammar/deklination. Data: src/data/kasus-haeufigkeit.json (two UD treebanks).
//
// Both sources are drawn on the server and the switch only swaps which one shows, so the
// chart needs no script to be read. Each case keeps its colour in both (colour follows the
// case, not its rank); the legend carries name, percent and count, so nothing rests on
// colour alone, and it doubles as the table view. Palette: the dataviz reference slots
// 1–4, validated light and dark (adjacent pairs).
import data from "../data/kasus-haeufigkeit.json";

const CASES = [
  { id: "nom", name: "Nominativ", hint: "Subjekt: Der Hund bellt." },
  { id: "akk", name: "Akkusativ", hint: "Objekt, für, ohne: Ich sehe den Hund." },
  { id: "dat", name: "Dativ", hint: "mit, von, bei, in: mit dem Hund" },
  { id: "gen", name: "Genitiv", hint: "wegen, während: des Hundes" },
];
const R = 70, W = 26, GAP = 2.5, C = 2 * Math.PI * R;
const fmt = (n: number) => n.toLocaleString("de-DE");

const sources = data.sources.map((s) => {
  const total = CASES.reduce((a, c) => a + (s.counts as any)[c.id], 0);
  let at = 0;
  const parts = CASES.map((c) => {
    const n = (s.counts as any)[c.id] as number;
    const share = n / total;
    const part = { ...c, n, pct: Math.round(share * 100), dash: Math.max(share * C - GAP, 0), offset: -at };
    at += share * C;
    return part;
  });
  const top = parts.reduce((a, b) => (b.n > a.n ? b : a));
  return { ...s, total, parts, top };
});
---
<section class="kc" aria-labelledby="kc-h" lang="de">
  <h2 id="kc-h" data-i18n="dk.chart.title">Wie oft kommt welcher Fall vor?</h2>
  <p class="kc-lead" data-i18n="dk.chart.lead">So oft steht ein Nomen in geschriebenen deutschen Texten in jedem Fall.</p>

  <div class="kc-switch" role="radiogroup" aria-label="Textsorte" data-i18n-attr="aria-label:dk.chart.kind">
    {sources.map((s, i) => (
      <button type="button" role="radio" aria-checked={i === 0 ? "true" : "false"} data-src={s.id} data-i18n={`dk.chart.${s.id}`}>{s.name}</button>
    ))}
  </div>

  {sources.map((s, i) => (
    <div class="kc-body" data-src={s.id} hidden={i !== 0}>
      <div class="kc-fig">
        <svg viewBox="0 0 200 200" role="img" aria-label={s.parts.map((p) => `${p.name} ${p.pct} %`).join(", ")}>
          <g transform="rotate(-90 100 100)">
            {s.parts.map((p) => (
              <circle class={`kc-seg kc-${p.id}`} data-case={p.id} cx="100" cy="100" r={R} fill="none" stroke-width={W}
                stroke-dasharray={`${p.dash} ${C}`} stroke-dashoffset={p.offset}>
                <title data-i18n="dk.chart.tip" data-i18n-vars={JSON.stringify({ c: p.name, p: p.pct, n: fmt(p.n) })}>{`${p.name}: ${p.pct} % (${fmt(p.n)} Nomen)`}</title>
              </circle>
            ))}
          </g>
        </svg>
        <div class="kc-center" aria-hidden="true">
          <b>{s.top.pct} %</b><span>{s.top.name}</span>
        </div>
      </div>
      <ul class="kc-legend">
        {s.parts.map((p) => (
          <li data-case={p.id} tabindex="0">
            <i class={`kc-${p.id}`}></i>
            <span class="kc-name">{p.name}<small>{p.hint}</small></span>
            <b>{p.pct} %</b>
          </li>
        ))}
      </ul>
      <p class="kc-src">
        <span data-i18n="dk.chart.counted" data-i18n-vars={JSON.stringify({ n: fmt(s.total) })}>{fmt(s.total)} Nomen gezählt</span> ·
        <a href={s.url} rel="noopener" target="_blank" data-i18n={`dk.chart.${s.id}Detail`}>{s.detail}</a>
      </p>
    </div>
  ))}

  <p class="kc-why" data-i18n-html="dk.chart.why"><b>Warum so viel Dativ?</b> Fast jede Präposition will einen Fall, und die häufigsten – <i>in, mit, von, zu, bei, an</i> – stehen oft mit Dativ. Der Akkusativ ist der Fall der Objekte, der Genitiv steht vor allem in geschriebener Sprache.</p>
</section>

<script>
  import { enhanceSwitch } from "../lib/segSwitch.js";

  document.querySelectorAll<HTMLElement>(".kc").forEach((root) => {
    const sw = root.querySelector<HTMLElement>(".kc-switch")!;
    const bodies = [...root.querySelectorAll<HTMLElement>(".kc-body")];
    sw.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>("button[data-src]");
      if (!btn) return;
      sw.querySelectorAll("button").forEach((b) => b.setAttribute("aria-checked", String(b === btn)));
      bodies.forEach((b) => (b.hidden = b.dataset.src !== btn.dataset.src));
    });
    enhanceSwitch(sw, { content: bodies });

    // Pointing at a slice or a legend row picks that case out in both, and the centre
    // names it; leaving goes back to the biggest.
    bodies.forEach((body) => {
      const center = body.querySelector(".kc-center")!;
      const initial = center.innerHTML;
      const pick = (id: string | null) => {
        body.dataset.hi = id ?? "";
        if (!id) { center.innerHTML = initial; return; }
        const row = body.querySelector<HTMLElement>(`li[data-case="${id}"]`)!;
        center.innerHTML = `<b>${row.querySelector("b")!.textContent}</b><span>${row.querySelector(".kc-name")!.firstChild!.textContent}</span>`;
      };
      body.querySelectorAll<HTMLElement>("[data-case]").forEach((el) => {
        el.addEventListener("pointerenter", () => pick(el.dataset.case!));
        el.addEventListener("pointerleave", () => pick(null));
        el.addEventListener("focus", () => pick(el.dataset.case!));
        el.addEventListener("blur", () => pick(null));
      });
    });
  });
</script>

<style>
  .kc {
    --kc-nom: #2a78d6; --kc-akk: #eb6834; --kc-dat: #1baf7a; --kc-gen: #eda100;
    max-width: 760px; margin: 28px auto 0; padding: 18px 16px 16px; text-align: left;
    border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface-card);
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .kc { --kc-nom: #3987e5; --kc-akk: #d95926; --kc-dat: #199e70; --kc-gen: #c98500; }
  }
  :root[data-theme="dark"] .kc { --kc-nom: #3987e5; --kc-akk: #d95926; --kc-dat: #199e70; --kc-gen: #c98500; }

  .kc h2 { margin: 0; font-size: 1.25rem; }
  .kc-lead { margin: 4px 0 12px; color: var(--muted); }
  .kc-switch {
    display: inline-flex; gap: 2px; padding: 3px; border-radius: var(--radius-pill);
    background: var(--blue-50); border: 1px solid var(--blue-200);
  }
  .kc-switch button {
    padding: 6px 14px; border: 0; border-radius: var(--radius-pill); background: none;
    color: var(--ink); font: inherit; font-size: .875rem; cursor: pointer;
  }
  .kc-switch button[aria-checked="true"] { background: var(--surface-card); box-shadow: var(--shadow-sm); font-weight: var(--fw-semibold); }

  .kc-body { display: grid; grid-template-columns: 220px 1fr; gap: 8px 24px; align-items: center; margin-top: 14px; }
  .kc-body[hidden] { display: none; }
  .kc-fig { position: relative; width: 220px; max-width: 100%; justify-self: center; }
  .kc-fig svg { display: block; width: 100%; height: auto; }
  .kc-seg { transition: opacity .15s ease; }
  .kc-seg.kc-nom { stroke: var(--kc-nom); } .kc-seg.kc-akk { stroke: var(--kc-akk); }
  .kc-seg.kc-dat { stroke: var(--kc-dat); } .kc-seg.kc-gen { stroke: var(--kc-gen); }
  .kc-body[data-hi="nom"] .kc-seg:not(.kc-nom), .kc-body[data-hi="akk"] .kc-seg:not(.kc-akk),
  .kc-body[data-hi="dat"] .kc-seg:not(.kc-dat), .kc-body[data-hi="gen"] .kc-seg:not(.kc-gen) { opacity: .3; }
  .kc-center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
  .kc-center b { font-size: 1.75rem; line-height: 1.1; color: var(--ink); }
  .kc-center span { font-size: .875rem; color: var(--muted); }

  .kc-legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .kc-legend li { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius-sm); outline-offset: 1px; }
  .kc-legend li:hover, .kc-legend li:focus-visible { background: var(--blue-50); }
  .kc-legend i { flex: none; width: 12px; height: 12px; border-radius: 3px; }
  .kc-legend i.kc-nom { background: var(--kc-nom); } .kc-legend i.kc-akk { background: var(--kc-akk); }
  .kc-legend i.kc-dat { background: var(--kc-dat); } .kc-legend i.kc-gen { background: var(--kc-gen); }
  .kc-name { flex: 1; min-width: 0; font-weight: var(--fw-semibold); }
  .kc-name small { display: block; font-weight: var(--fw-regular); color: var(--muted); font-size: .8125rem; }
  .kc-legend b { font-variant-numeric: tabular-nums; font-size: 1.0625rem; }
  .kc-src { grid-column: 1 / -1; margin: 4px 0 0; font-size: .8125rem; color: var(--muted); }
  .kc-src a { color: inherit; }
  .kc-why { margin: 14px 0 0; padding-top: 12px; border-top: 1px solid var(--border); line-height: 1.55; }
  .kc-why b { display: block; }

  @media (max-width: 560px) {
    .kc-body { grid-template-columns: 1fr; }
    .kc-fig { width: 200px; }
  }
</style>
