---
// A source list with a Stand for every row (the „Deutschland von innen" pattern,
// kultur-insider.css). Rows come from the research file: sourcesFor(cited keys).
import { standMonat } from "../../lib/fuehrerschein.js";
interface Props { sources: Array<{ label: string; href: string; stand?: string }>; title?: string; titleKey?: string }
const { sources, title = "Quellen", titleKey = "kultur.insider.h2.sources" } = Astro.props;
---
{sources.length > 0 && (
  <section class="in-sources">
    <h2 data-i18n={titleKey}>{title}</h2>
    <ol>
      {sources.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>
          {s.stand && <span class="in-stand" data-i18n="fs.stand" data-i18n-vars={JSON.stringify({ m: standMonat(s.stand) })}>Stand: {standMonat(s.stand)}</span>}
        </li>
      ))}
    </ol>
  </section>
)}
