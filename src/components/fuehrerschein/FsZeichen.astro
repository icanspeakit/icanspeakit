---
// A grid of Verkehrszeichen with their names, and the credit line § 5 Abs. 2 UrhG asks for
// (the source named; the drawings are not changed). Every key must have an `ok` licence
// entry in the research file — zeichen() throws otherwise.
//
// A tap on a sign opens its sheet: the sign big, what it means and what you do
// (src/data/fuehrerschein/zeichen.json), and the bank's questions that show this sign, as a
// short quiz. ‹ › step through the signs of the grid.
import { zeichen, fillDeep, prepareQuestion } from "../../lib/fuehrerschein.js";
import { questions, lessonLinks } from "../../lib/fuehrerscheinData.js";
import bedeutung from "../../data/fuehrerschein/zeichen.json";
interface Props { keys: string[] }
const ART = {
  gefahr: ["fs.sign.art.gefahr", "Gefahrzeichen"],
  vorschrift: ["fs.sign.art.vorschrift", "Vorschriftzeichen"],
  richt: ["fs.sign.art.richt", "Richtzeichen"],
  zusatz: ["fs.sign.art.zusatz", "Zusatzzeichen"],
} as const;
const label = (key: string) => (key.startsWith("1002") ? `Zusatzzeichen ${key}` : `Zeichen ${key.replace(/-\d+$/, "")}`);
const signs = Astro.props.keys.map((key) => {
  const z = zeichen(key);
  const b = fillDeep((bedeutung.zeichen as Record<string, any>)[key] ?? null);
  if (!b) throw new Error(`FsZeichen: „${key}“ fehlt in zeichen.json`);
  const quiz = questions.filter((q: any) => q.sign === key).map((q: any) => prepareQuestion(q, lessonLinks));
  return { ...z, label: label(key), art: b.art as keyof typeof ART, heisst: b.heisst, tun: b.tun, quiz };
});
const data = signs.map(({ key, src, name, label, art, heisst, tun, quiz }) => ({ key, src, name, label, art, heisst, tun, quiz }));
---
{signs.length > 0 && (
  <div class="fs-signs-wrap" data-fs-signs>
    <ul class="fs-signs">
      {signs.map((z, i) => (
        <li>
          <button type="button" class="fs-sign" data-fs-sign={i} aria-haspopup="dialog">
            <img src={z.src} alt="" width="56" height="56" loading="lazy" />
            <span lang="de">{z.name}</span>
            <small>{z.label}</small>
          </button>
        </li>
      ))}
    </ul>
    <p class="fs-credit">
      <span data-i18n="fs.signs.credit">Verkehrszeichen: amtliche Werke (§ 5 UrhG), Zeichnungen von Wikimedia Commons, gemeinfrei.</span>{" "}
      <a href="https://commons.wikimedia.org/wiki/Category:Diagrams_of_road_signs_of_Germany" target="_blank" rel="noopener noreferrer">Commons ↗</a>
    </p>

    <dialog class="fs-zs" aria-labelledby="fs-zs-name">
      <div class="fs-zs-head">
        <span class="fs-zs-pos" data-zs-pos></span>
        <button type="button" class="fs-zs-x" data-zs-close aria-label="Schließen" data-i18n-attr="aria-label:fs.sign.close">×</button>
      </div>
      <div class="fs-zs-body">
        <div class="fs-zs-top">
          <button type="button" class="fs-zs-step" data-zs-step="-1" aria-label="Voriges Zeichen" data-i18n-attr="aria-label:fs.sign.prev">‹</button>
          <img class="fs-zs-img" data-zs-img src="" alt="" width="132" height="132" />
          <button type="button" class="fs-zs-step" data-zs-step="1" aria-label="Nächstes Zeichen" data-i18n-attr="aria-label:fs.sign.next">›</button>
        </div>
        <p class="fs-zs-art">
          {Object.entries(ART).map(([id, [k, de]]) => <span data-zs-art={id} data-i18n={k} hidden>{de}</span>)}
          <span data-zs-label></span>
        </p>
        <h3 class="fs-zs-name" id="fs-zs-name" lang="de" data-zs-name></h3>
        <dl class="fs-zs-dl">
          <dt data-i18n="fs.sign.heisst">Das heißt</dt>
          <dd lang="de" data-zs-heisst></dd>
          <dt data-i18n="fs.sign.tun">Das tust du</dt>
          <dd lang="de" data-zs-tun></dd>
        </dl>
        <section class="fs-zs-quiz" data-zs-quizwrap hidden>
          <p class="fs-zs-quiz-h" data-i18n="fs.sign.quiz">Teste dich</p>
          <div class="quiz-card" data-zs-quiz></div>
        </section>
      </div>
    </dialog>
    <script type="application/json" data-zs-data set:html={JSON.stringify(data).replace(/</g, "\\u003c")}></script>
  </div>
)}

<script>
  import { mountFahrQuiz } from "../../lib/fahrQuiz.js";
  import { t } from "../../lib/uiText.js";

  for (const wrap of document.querySelectorAll<HTMLElement>("[data-fs-signs]")) {
    const signs = JSON.parse(wrap.querySelector("[data-zs-data]")?.textContent ?? "[]");
    const dlg = wrap.querySelector<HTMLDialogElement>("dialog.fs-zs")!;
    const $ = (s: string) => dlg.querySelector<HTMLElement>(s)!;
    let at = 0;

    function show(i: number) {
      at = (i + signs.length) % signs.length;
      const z = signs[at];
      const img = $("[data-zs-img]") as HTMLImageElement;
      img.src = z.src;
      $("[data-zs-name]").textContent = z.name;
      $("[data-zs-label]").textContent = z.label;
      dlg.querySelectorAll<HTMLElement>("[data-zs-art]").forEach((el) => { el.hidden = el.dataset.zsArt !== z.art; });
      $("[data-zs-heisst]").textContent = z.heisst;
      $("[data-zs-tun]").textContent = z.tun;
      $("[data-zs-pos]").textContent = t("fs.sign.pos", "{n} von {total}", { n: at + 1, total: signs.length });
      const quiz = $("[data-zs-quiz]");
      quiz.innerHTML = "";
      $("[data-zs-quizwrap]").hidden = !z.quiz.length;
      if (z.quiz.length) mountFahrQuiz(quiz, z.quiz, { mode: "practice", shuffle: false });
      dlg.querySelectorAll<HTMLElement>("[data-zs-step]").forEach((b) => { b.hidden = signs.length < 2; });
      $(".fs-zs-body").scrollTop = 0;
    }

    wrap.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-fs-sign]");
      if (!btn) return;
      show(Number(btn.dataset.fsSign));
      dlg.showModal();
    });
    dlg.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el === dlg || el.closest("[data-zs-close]")) return dlg.close();
      const step = el.closest<HTMLElement>("[data-zs-step]");
      if (step) show(at + Number(step.dataset.zsStep));
    });
    dlg.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") show(at + 1);
      else if (e.key === "ArrowLeft") show(at - 1);
    });
  }
</script>
