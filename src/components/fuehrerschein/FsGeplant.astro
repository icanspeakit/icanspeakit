---
// The one place the 2025/26 Führerscheinreform appears: a clearly marked „Geplant" box.
// Edgar's decision (docs/fuehrerschein-quellen.md → Entscheidungen, 2026-10-01): no fixed
// date stated as fact; „Eine Reform ist geplant, aber noch nicht beschlossen. Der Entwurf
// nennt den 1. Juli 2027." Everywhere else the pages state today's law. The date and the
// sources come from the research file; the box carries its own Stand.
import { fakt, datum, standMonat } from "../../lib/fuehrerschein.js";

const geplant = fakt("reform.inkrafttretenGeplant");
const quellen = ["reform.parlamentStatus", "reform.kabinettsbeschluss", "reform.inkrafttretenGeplant"].map((k) => fakt(k).entry);
const seen = new Set();
const sources = quellen.filter((e) => !seen.has(e.source.url) && seen.add(e.source.url)).map((e) => e.source);
---
<aside class="fs-box fs-geplant" aria-labelledby="fs-geplant-h">
  <span class="fs-geplant-tag" data-i18n="fs.plan.tag">Geplant</span>
  <h2 id="fs-geplant-h" data-i18n="fs.plan.title">Eine Reform ist geplant — sie gilt noch nicht</h2>
  <p>
    <span data-i18n="fs.plan.lead">Eine Reform ist geplant, aber noch nicht beschlossen.</span>
    <span data-i18n="fs.plan.date" data-i18n-vars={JSON.stringify({ d: datum(geplant.value) })}>Der Entwurf nennt den {datum(geplant.value)}.</span>
    <span data-i18n="fs.plan.today">Bis dahin gilt alles, was auf diesen Seiten steht.</span>
  </p>
  <p data-i18n="fs.plan.listLead">Geplant ist unter anderem:</p>
  <ul>
    <li data-i18n="fs.plan.item.theory">Theorie: Die Pflicht, im Unterricht in der Fahrschule zu sitzen, soll wegfallen. Lernen mit Apps soll erlaubt sein.</li>
    <li data-i18n="fs.plan.item.catalogue">Der Fragenkatalog für die Theorieprüfung soll deutlich kleiner werden.</li>
    <li data-i18n="fs.plan.item.drives">Die Zahl der Pflichtfahrten soll sinken.</li>
    <li data-i18n="fs.plan.item.exam">Die praktische Prüfung soll kürzer werden.</li>
    <li data-i18n="fs.plan.item.prices">Fahrschulen sollen ihre Preise und Erfolgsquoten online zeigen.</li>
  </ul>
  <p class="fs-small">
    <span data-i18n="fs.stand" data-i18n-vars={JSON.stringify({ m: standMonat(geplant.entry.stand) })}>Stand: {standMonat(geplant.entry.stand)}</span> ·
    {sources.map((s, i) => <>{i > 0 && " · "}<a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></>)}
  </p>
</aside>
