---
// The short disclaimer (FUEHRERSCHEIN-TIERED-PROMPT.md, rule 4): no legal advice, no
// substitute for the Fahrschule or the Fahrerlaubnisbehörde. `umschreiben` adds that the
// rules for converting a licence depend on the country and the local authority.
interface Props { umschreiben?: boolean }
const { umschreiben = false } = Astro.props;
---
<p class="fs-hinweis" role="note">
  <span class="fs-hinweis-ic" aria-hidden="true">ℹ️</span>
  {umschreiben
    ? <span data-i18n="fs.note.convert">Diese Seite erklärt die Regeln einfach. Sie ist keine Rechtsberatung. Was für deinen Führerschein gilt, hängt vom Land ab, aus dem er kommt, und von der Fahrerlaubnisbehörde deiner Stadt. Frag dort nach.</span>
    : <span data-i18n="fs.note.general">Wir erklären die Regeln einfach und mit eigenen Beispielen. Das ersetzt nicht die Fahrschule und nicht die Fahrerlaubnisbehörde. Verbindlich sind die Gesetze und die Auskunft der Behörde.</span>}
</p>
