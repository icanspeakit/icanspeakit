---
import type { Topic } from '../data/exercises/topics';

interface Props {
  topics: Topic[];
}

const { topics } = Astro.props;
---

<div class="exercise-grid">
  {topics.map((topic) => (
    <a
      href={topic.href}
      class:list={['exercise-card', { 'exercise-card--featured': topic.featured }]}
      data-status={topic.status}
    >
      <span class="exercise-card__category">{topic.category}</span>
      <h3>{topic.title}</h3>
      <p class="text-muted">{topic.description}</p>
    </a>
  ))}
</div>

<style>
  .exercise-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .exercise-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    padding: clamp(1.15rem, 2vw, 1.5rem);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    text-decoration: none;
    color: inherit;
  }

  .exercise-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .exercise-card--featured {
    border: 2px solid var(--color-primary);
  }

  .exercise-card__category {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .exercise-card h3 {
    font-size: 1.2rem;
    margin: 0;
  }

  .exercise-card > p {
    font-size: 0.92rem;
    max-width: none;
  }
</style>
