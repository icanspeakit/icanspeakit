---
// A real, computed pitch (F0) contour for one sentence — not a decorative
// curve. The client script fetches the clip's audio + ElevenLabs' forced
// character alignment from `/api/tts-timestamps`, runs autocorrelation
// pitch tracking on the decoded audio (see ../lib/pitch-contour.ts), and
// draws a small trace scaled to the clip's real duration, with a marker at
// the stressed word's real spoken timestamp.
interface Props {
  ttsSrc: string;
  words: string[];
  stressIndex: number;
  meaning: string;
}

const copy = {
  en: {
    play: 'Play',
    analyzing: 'Analyzing pitch…',
    noTrace: "Couldn't find a clear pitch trace in this clip.",
    failed: "Couldn't analyze this clip — the audio is still playable below.",
    stressedWord: 'Stressed word: ________',
  },
  de: {
    play: 'Abspielen',
    analyzing: 'Tonhöhe wird analysiert…',
    noTrace: 'In diesem Clip wurde kein klarer Tonhöhenverlauf gefunden.',
    failed: 'Dieser Clip konnte nicht analysiert werden — die Audiodatei ist trotzdem abspielbar.',
    stressedWord: 'Betontes Wort: ________',
  },
} as const;

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = copy[locale];
const { ttsSrc, words, stressIndex, meaning } = Astro.props;
---

<div
  class="pitch-row"
  data-role="pitch-contour"
  data-src={ttsSrc}
  data-words={JSON.stringify(words)}
  data-stress-index={stressIndex}
  data-msg-no-trace={t.noTrace}
  data-msg-failed={t.failed}
>
  <div class="pitch-left">
    <div class="pitch-tokens">
      {words.map((w, i) => (
        <span class={i === stressIndex ? 'pt-word pt-word--stressed' : 'pt-word'}>{w}</span>
      ))}
    </div>
    <div class="pitch-controls">
      <button type="button" class="pitch-play" data-role="play" aria-label={t.play} disabled>▶</button>
      <span class="pitch-meaning text-muted" data-role="meaning">{meaning}</span>
    </div>
    <p class="pitch-status" data-role="status">{t.analyzing}</p>
    <audio data-role="audio" preload="none"></audio>
  </div>

  <svg class="pitch-trace" data-role="svg" viewBox="0 0 130 54" preserveAspectRatio="none" hidden></svg>

  <p class="pitch-print">
    {words.join(' ')}
    <br />{t.stressedWord}
  </p>
</div>

<script>
  import { estimatePitchContour } from '../lib/pitch-contour';
  import { wordSpansFromAlignment, base64ToBytes, type TtsTimestampsResponse } from '../lib/alignment';
  import { logEvent } from '../lib/progress-store';

  const SVG_NS = 'http://www.w3.org/2000/svg';
  const VIEW_W = 130;
  const Y_TOP = 6;
  const Y_BOTTOM = 48;

  async function initPitchContour(root: HTMLElement) {
    if (root.dataset.pitchInitialized) return;
    root.dataset.pitchInitialized = 'true';

    const src = root.dataset.src;
    const words: string[] = JSON.parse(root.dataset.words ?? '[]');
    const stressIndex = Number(root.dataset.stressIndex ?? -1);

    const status = root.querySelector<HTMLElement>('[data-role="status"]');
    const svg = root.querySelector<SVGSVGElement>('[data-role="svg"]');
    const playBtn = root.querySelector<HTMLButtonElement>('[data-role="play"]');
    const audio = root.querySelector<HTMLAudioElement>('[data-role="audio"]');

    if (!src || !status || !svg || !playBtn || !audio) return;

    try {
      const res = await fetch(src);
      if (!res.ok) throw new Error(`tts-timestamps request failed (${res.status})`);
      const data: TtsTimestampsResponse = await res.json();

      // Decode once for analysis (decodeAudioData can consume the buffer
      // it's given), and separately for the playable clip.
      const analysisBytes = base64ToBytes(data.audioBase64);
      const AudioCtx = window.AudioContext ?? (window as any).webkitAudioContext;
      const ctx = new AudioCtx();
      const buffer = await ctx.decodeAudioData(analysisBytes.buffer.slice(0));

      const playbackBytes = base64ToBytes(data.audioBase64);
      const blob = new Blob([playbackBytes], { type: 'audio/mpeg' });
      audio.src = URL.createObjectURL(blob);

      const frames = estimatePitchContour(buffer);
      const spans = wordSpansFromAlignment(
        data.alignment.characters,
        data.alignment.characterStartTimesSeconds,
        data.alignment.characterEndTimesSeconds
      );

      const voiced = frames.filter((f) => f.hz != null) as { t: number; hz: number }[];
      if (voiced.length < 2) {
        status.textContent = root.dataset.msgNoTrace ?? "Couldn't find a clear pitch trace in this clip.";
        playBtn.disabled = false;
        return;
      }

      const duration = buffer.duration;
      const logHz = voiced.map((f) => Math.log2(f.hz));
      const minLog = Math.min(...logHz);
      const maxLog = Math.max(...logHz);
      const span = maxLog - minLog || 1;

      const x = (t: number) => (t / duration) * VIEW_W;
      const y = (hz: number) => {
        const norm = (Math.log2(hz) - minLog) / span; // 0 (low) .. 1 (high)
        return Y_BOTTOM - norm * (Y_BOTTOM - Y_TOP);
      };

      // Break the line at any gap where two consecutive voiced frames are
      // far apart in time (an unvoiced/silent stretch) — real speech isn't
      // one continuous pitch, so the line shouldn't pretend it is.
      const maxGap = 0.12;
      const runs: { t: number; hz: number }[][] = [];
      let current: { t: number; hz: number }[] = [];
      for (const f of voiced) {
        if (current.length && f.t - current[current.length - 1].t > maxGap) {
          runs.push(current);
          current = [];
        }
        current.push(f);
      }
      if (current.length) runs.push(current);

      for (const run of runs) {
        if (run.length < 2) continue;
        const d = run.map((f, i) => `${i === 0 ? 'M' : 'L'} ${x(f.t).toFixed(1)},${y(f.hz).toFixed(1)}`).join(' ');
        const path = document.createElementNS(SVG_NS, 'path');
        path.setAttribute('d', d);
        path.setAttribute('fill', 'none');
        path.setAttribute('stroke', 'var(--pr-accent)');
        path.setAttribute('stroke-width', '1.8');
        path.setAttribute('stroke-linejoin', 'round');
        svg.appendChild(path);
      }

      // Mark the stressed word's real spoken timestamp on the curve, using
      // its forced-alignment span — this is what ties the trace back to an
      // actual moment in the clip rather than a generic shape.
      const stressSpan = spans[stressIndex];
      if (stressSpan) {
        const mid = (stressSpan.start + stressSpan.end) / 2;
        const nearest = voiced.reduce((a, b) => (Math.abs(b.t - mid) < Math.abs(a.t - mid) ? b : a));
        const dot = document.createElementNS(SVG_NS, 'circle');
        dot.setAttribute('cx', x(mid).toFixed(1));
        dot.setAttribute('cy', y(nearest.hz).toFixed(1));
        dot.setAttribute('r', '3');
        dot.setAttribute('fill', 'var(--pr-accent)');
        svg.appendChild(dot);
      }

      status.hidden = true;
      svg.hidden = false;
      playBtn.disabled = false;
    } catch (error) {
      console.error('Pitch contour failed:', error);
      status.textContent =
        root.dataset.msgFailed ?? "Couldn't analyze this clip — the audio is still playable below.";
      playBtn.disabled = false;
    }

    playBtn.addEventListener('click', () => {
      audio.currentTime = 0;
      audio.play();
      logEvent('prosody', 'played');
    });
  }

  // Only analyze clips that are actually visible on load — a Prosody card
  // embedded in a hidden dashboard tab shouldn't fire real ElevenLabs calls
  // and audio decoding just because it exists in the DOM. Hidden ones are
  // initialized lazily when their panel is shown (see the
  // "exercise-panel-shown" event dispatched by the dashboard's tab switcher).
  document.querySelectorAll<HTMLElement>('[data-role="pitch-contour"]').forEach((root) => {
    if (!root.closest('[hidden]')) initPitchContour(root);
  });

  document.addEventListener('exercise-panel-shown', (event) => {
    const panel = event.target as HTMLElement;
    panel.querySelectorAll<HTMLElement>('[data-role="pitch-contour"]').forEach(initPitchContour);
  });
</script>

<style>
  .pitch-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(90px, 130px);
    gap: 20px;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px solid var(--pr-border-soft);
  }

  .pitch-left {
    min-width: 0;
  }

  .pitch-tokens {
    font-family: var(--pr-serif);
    font-size: 19px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    display: flex;
    flex-wrap: wrap;
    gap: 0 6px;
  }

  .pt-word {
    color: #655c4a;
    font-weight: 400;
  }

  .pt-word--stressed {
    color: var(--pr-ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--pr-accent);
  }

  .pitch-controls {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .pitch-play {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 0;
    background: var(--pr-ink);
    color: #fbf8f1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9.5px;
    padding: 0;
  }

  .pitch-play:hover:not(:disabled) {
    background: #2b3d5c;
  }

  .pitch-play:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .pitch-meaning {
    font-size: 13px;
    line-height: 1.45;
    color: var(--pr-muted);
  }

  .pitch-status {
    font-size: 12px;
    color: var(--pr-muted2);
    margin: 8px 0 0;
  }

  .pitch-trace {
    width: 100%;
    height: 54px;
    display: block;
  }

  .pitch-print {
    display: none;
  }

  /* Below ~480px the fixed 90–130px trace column leaves too little room
     for the sentence tokens — stack the trace under the text instead of
     squeezing both into one row. */
  @media (max-width: 480px) {
    .pitch-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .pitch-play {
      width: 44px;
      height: 44px;
      font-size: 12px;
    }
  }

  @media print {
    .pitch-controls,
    .pitch-trace,
    .pitch-status {
      display: none !important;
    }

    .pitch-print {
      display: block;
      font-family: var(--pr-serif);
      font-size: 1.1rem;
      max-width: none;
    }
  }
</style>
