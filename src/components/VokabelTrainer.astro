---
// The flashcard trainer's shell, shared by every deck that mounts it.
//
// Lifted out of src/pages/wortschatz.astro when the nav's Niveaus menu gained
// per-level word lists: /wortschatz (the curated Redemittel deck) and
// /wortschatz/a1 (the lexicon's A1 words) are the same tool over different
// cards, and a second copy of this markup would have drifted from the first inside a
// week. The page decides which cards to hand over; everything below is identical.
//
// Cards arrive already in the engine's shape: `{ front, note, translations }`.
import { existsSync } from "node:fs";
import path from "node:path";
import { satzSlug, solvedHint } from "../lib/audioSlug.js";
import { LANGUAGE_REGISTRY } from "../lib/languages.js";
import { fetchedLangsFor } from "../lib/glossen.js";
import SiteNav from "./SiteNav.astro";
import SectionMascot from "./mascots/SectionMascot.astro";
import LernsetPicker from "./LernsetPicker.astro";
import NavLayout from "./NavLayout.astro";
import ShareButton from "./ShareButton.astro";
import PremiumLock from "./PremiumLock.astro";
// The free daily meter's lock (paywall on only; src/lib/access.js).
const PAYWALL = import.meta.env.PUBLIC_PAYWALL === "on";
import "../styles/practice.css";
// The split layout itself — the grid, the sliding column, the phone collapse — is the
// same stylesheet the grammar topics and the exam pages load. Only the width tokens and
// the card's own look are overridden, in vokabeltrainer.css.
import "../styles/verben-praepositionen.css";
// The scrim, spotlight and coach mark the one-time tour draws. Same stylesheet the
// grammar topics load — without it the tour still runs and nothing is visible.
import "../styles/rule-intro.css";
import "../styles/vokabeltrainer.css";
import "../styles/vt-round.css";
import "../styles/vt-zen.css";

interface Props {
  /** `{ front, note, translations }` rows — see src/lib/wortschatz-app.js. */
  cards: Array<{ front: string; note?: string; translations?: Record<string, string> }>;
  /** The deck's <h1> — the curated deck and a level deck are named differently. */
  heading: string;
  /** i18n key for the heading, when the deck has a translated name. */
  headingKey?: string;
  /** Interpolation values for `headingKey`, for the generated deck names. */
  headingVars?: Record<string, unknown>;
  /** Deck id for the picker: "redemittel", a level ("a1") or a unit id ("a1-04"). */
  deck: string;
  /** Where this deck sits — "A1 · Wohnen · 25 Wörter". Shown on the picker bar. */
  sub: string;
  /**
   * The same line as keyed parts, joined with " · ". One string could not be translated:
   * the middle segment is a module name that needs its own key, and the others are counts
   * with their own plural shape. Each part carries `text` plus an optional `key`/`vars`;
   * a part with no key renders as-is (a CEFR code is a code in every language).
   */
  subParts?: Array<{ text: string; key?: string; vars?: Record<string, unknown> }>;
  /**
   * Which languages this deck actually has. A deck must not render a tab that resolves to
   * "Übersetzung folgt" on every card — that is a promise the content cannot keep. Since
   * the ar/ru/tr sidecars were filled (src/content/lexicon/i18n/) a lexicon deck passes
   * all four too, but it passes what `langsOf()` measured rather than what it hopes for:
   * a level added tomorrow with no translations yet drops back to `en` on its own.
   */
  langs?: string[];
  /** The deck's printable sheet (/wortschatz/drucken/<set>), offered in the Wortliste tab. */
  printHref?: string;
  /**
   * Cards come at runtime, not from the build (a teacher's private set, /lehrkraefte/karten/lernen):
   * the page fills #fc-data / #fc-langs and sets `window.__vtCardsReady` + fires `vt:cards`.
   */
  runtime?: boolean;
}
const { cards: rawCards, heading, headingKey, headingVars, deck, sub, subParts, langs = ["en"], printHref, runtime = false } = Astro.props;

// The example sentence gets a play button only when scripts/generate-satz-audio.mjs has
// voiced it — checked on disk here, at build time, the same way aussprache.astro does, so
// a button never points at a 404.
const satzOnDisk = (example: string) => {
  const src = `/audio/saetze/${satzSlug(example)}.mp3`;
  return existsSync(path.join(process.cwd(), "public", src)) ? src : null;
};
// The "Auf Deutsch" explanation, read aloud beside the sentence on the Erklärung face
// (generate-satz-audio.mjs --only erklaerung). Gap sentences have none: they are voiced solved.
const erklaerungOnDisk = (text: string) => {
  const src = `/audio/erklaerung/${satzSlug(text)}.mp3`;
  return existsSync(path.join(process.cwd(), "public", src)) ? src : null;
};
const cards = rawCards.map((c: any) => {
  const exampleAudio = c.example ? satzOnDisk(c.example) : null;
  // The solved gap sentence, read after the word by the card's own speaker.
  const solved = c.deFill && c.translations?.de ? solvedHint(c.translations.de, c.deFill) : null;
  const solvedAudio = solved ? satzOnDisk(solved) : null;
  const de = c.translations?.de;
  const deAudio = de && !de.includes("…") ? erklaerungOnDisk(de) : null;
  return exampleAudio || solvedAudio || deAudio
    ? {
        ...c,
        ...(exampleAudio ? { exampleAudio } : {}),
        ...(solvedAudio ? { solvedAudio } : {}),
        ...(deAudio ? { deAudio } : {}),
      }
    : c;
});

// The trainer quizzes German against one other language at a time: every registry language
// a deck can carry (lexicon, Berufe, Fahrschule), in registry order. "ins Englische" →
// deInto is the German name + "e".
const ALL_LANGUAGES = [
  ...LANGUAGE_REGISTRY.filter((l) => l.code !== "de" && (l.surfaces.cards || l.surfaces.berufe || l.surfaces.fuehrerschein)).map((l) => ({
    code: l.code,
    label: l.native,
    deName: l.de,
    deInto: `${l.de}e`,
    ...(l.dir === "rtl" ? { rtl: true } : {}),
    // Glosses not in fc-data: wortschatz-app.js loads /wortschatz/glossen/<code>.json on first use.
    ...(l.surfaces.cards?.fetch ? { fetch: true } : {}),
  })),
  // Not a translation: a synonym or a short explanation in simple German (lexicon.js deHint).
  { code: "de", label: "Auf Deutsch", deName: "Erklärung", deInto: "Erklärung" },
];
/* "de" is the German synonym or explanation („Erklärung auf Deutsch", a toggle in the trainer),
   then the translations. Several languages on one card for a class in front of one screen are
   the teachers' Klassenansicht (src/lib/klassenansicht.js), chosen per class – no longer a
   learner's „Alle Sprachen" tab (KARTENSPRACHE Tier 4). */
// The fetched languages (src/lib/glossen.js) are checked here, against the cards' lexicon ids:
// offered only when every card of this deck has a gloss, the same rule as langsIn().
const fetched = fetchedLangsFor(rawCards);
const found = ALL_LANGUAGES.filter((l) => langs.includes(l.code) || fetched.includes(l.code));
const translated = found.filter((l) => l.code !== "de");
const languages = [
  ...found.filter((l) => l.code === "de"),
  ...translated,
  // Not offered: the registry languages this deck does not fully cover. The picker shows them
  // greyed under „Bald" (src/lib/cardLangPicker.js), so a learner sees theirs is coming.
  ...notCovered(),
];
function notCovered() {
  return ALL_LANGUAGES.filter((l) => l.code !== "de" && !found.includes(l)).map((l) => ({ ...l, soon: true }));
}
---
<!-- No title. The bar carried "Wortliste A1" directly above an <h1> reading "Wortschatz
     A1" — the same deck named twice, 50px apart, and the bar does not stick, so the copy
     up here was read once and scrolled past. The <h1> keeps the name. -->
<SiteNav active="wortschatz" />

<!-- The same split layout the grammar topics use (src/lib/ruleColumn.js): a column that
     is sticky beside the work on a desktop and collapses behind one button on a phone.
     Rendered collapsed, then opened by the script — which state that ends up being is a
     remembered per-browser preference, defaulting to open on a desktop, where a nav
     column costs the trainer nothing, and closed on a phone, where it costs a screen. -->
<main class="vt-shell vp-page vp-page--split vp-page--sheet vt-split" id="vp-page" data-rule="hidden" data-anim="off" data-navlayout="a" data-print-href={printHref}>
  <div class="vt-hero">
    {/* A Lernset's scene photo (HubBild set="szenen"), above everything in the hero. */}
    <slot name="banner" />
    <!-- Still in the DOM and still updated by the engine — it names what the workspace
         is showing — but not drawn: it read "Karteikarten" over a tab row whose
         "Karteikarten" is underlined 80px below it. -->
    <SectionMascot name="hamsti" say="Wort für Wort." size={44} />
    <p class="eyebrow vt-eyebrow-quiet" id="vt-eyebrow">Karteikarten</p>
    <h1 data-i18n={headingKey} data-i18n-vars={headingVars ? JSON.stringify(headingVars) : undefined}>{heading}</h1>
    {/* The deck's name in the learner's card language, when that differs from the page's
        (src/lib/cardLangGloss.js; LernsetPicker starts it). */}
    {headingKey && <p class="vt-hero-gloss" data-gloss-key={headingKey} data-gloss-vars={headingVars ? JSON.stringify(headingVars) : undefined} hidden></p>}
    <p class="vt-hero-sub">
      {subParts
        ? subParts.map((part, i) => (
            <>
              {i > 0 && " · "}
              <span data-i18n={part.key} data-i18n-vars={part.vars ? JSON.stringify(part.vars) : undefined}>{part.text}</span>
            </>
          ))
        : sub}
    </p>
    {/* A line under the heading for the page that knows more about its deck than the
        trainer does — the Lernset page's teacher link (LiveQuizLink.astro). */}
    <slot name="hero" />
  </div>

  <div class="vp-workspace">
    <!-- First in the DOM so that on a phone — where scroll order is the only hierarchy
         there is — you meet "which set am I doing" before the cards. The card under it
         collapses to zero height, so "first" costs the trainer one button. -->
    <aside class="vp-col vp-col--rule" id="vp-rule">
      <div class="vp-card vp-rule-card" id="vp-rule-card">
        <!-- On a desktop this head is just the card's label. On a phone the card is a
             bottom sheet and the head is its handle: pinned to the top of the sheet with
             the ✕, so the way out is never a scroll away no matter how far down the list
             the learner has gone. -->
        <div class="vp-sheet-head">
          <div class="vp-card-label" data-i18n="sets.lernsets">Lernsets</div>
          <button
            type="button"
            class="vp-sheet-fold"
            data-sheet-close
            aria-label="Lernsets einklappen"
            data-i18n-attr="aria-label:sets.collapse"
            aria-controls="vp-rule-card"
          >
            <span data-i18n="vp.rule.collapseShort">Einklappen</span>
            {/* Down, because that is where the sheet goes. */}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <button
            type="button"
            class="vp-sheet-x"
            data-sheet-close
            aria-label="Lernsets schließen"
            data-i18n-attr="aria-label:sets.close"
            aria-controls="vp-rule-card"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
          </button>
        </div>
        <!-- --flush because what goes in here is the rail, which brings its own
             scrolling panel: a body that scrolled too would carry the rail off the top
             of the sheet with the list. -->
        <div class="vp-sheet-body vp-sheet-body--flush">
          <LernsetPicker current={deck} />
        </div>
      </div>

      <button
        type="button"
        class="vp-rule-peek"
        id="vp-rule-peek"
        data-show="Lernset wechseln"
        data-hide="Lernsets ausblenden"
        data-i18n-attr="data-show:sets.switch;data-hide:sets.hide"
        data-i18n="sets.switch"
        aria-controls="vp-rule-card"
      >Lernset wechseln</button>
    </aside>

    <!-- The sheet's backdrop. Outside .vp-col--rule for the same reason the pivot is:
         that column goes inert when it collapses, and a control inside it would go with
         it — and this one's whole job is to be tappable while the column is "away". -->
    <div class="vp-sheet-scrim" data-sheet-close aria-hidden="true"></div>

    <section class="vp-col vp-col--ex">
      <div class="vt-tool">
        <!-- The mode tabs and the column switch share one row, and the hairline under it
             belongs to the row rather than to the tabs. The switch used to sit in the
             toolbar below that line, among the per-deck controls — which put a control
             over the whole page's layout inside the group that changes what this deck
             shows. Above the line it reads as what it is: page chrome, at the same
             altitude as the tabs.

             #vt-tabs stays its own element with exactly the three tabs inside it:
             wortschatz-app.js iterates tabsEl.children to set the active one. -->
        <div class="vt-tabrow">
          <div class="vt-tabs" id="vt-tabs">
            <button class="vt-tab active" type="button" data-tab="cards" data-i18n="wortschatz.tab.cards">Karteikarten</button>
            <button class="vt-tab" type="button" data-tab="learn" data-i18n="wortschatz.tab.learn">Lernen</button>
            <button class="vt-tab" type="button" data-tab="list" data-i18n="wortschatz.tab.list">Wortliste</button>
          </div>
          {/* Share the deck itself: a teacher sends a Lernset to the class, a learner sends it
              to a friend. The page URL without its query. */}
          <span class="vt-share"><ShareButton title={`${heading} – Wortschatz`} size="sm" label /></span>
          {/* Zen: only the card, over the whole screen (src/lib/vtZen.js). */}
          <button type="button" class="vt-zen-btn" data-zen-toggle aria-pressed="false" title="Nur die Karte, ohne Ablenkung" data-i18n-attr="title:vt.zen.title">
            <svg data-zen-on viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
            <svg data-zen-off viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" /></svg>
            <span data-zen-on data-i18n="vt.zen.on">Zen</span>
            <span data-zen-off data-i18n="vt.zen.off">Zen beenden</span>
          </button>
        </div>

        <div class="vt-toolbar">
          {/* The card language and its direction, one control (wortschatz-app.js renderLangControl). */}
          <div class="vt-lang-tabs" id="vt-lang-tabs"></div>
          <div class="vt-toolbar-right">
            <button class="vt-pill" id="vt-deck-chip" type="button"></button>
            {/* Print and live quiz as icons beside the counter (DeckActions compact), shown
                only once the hero's labelled row has scrolled away: one place at a time. */}
            <slot name="tools" />
            <span class="vt-position" id="vt-position"></span>
          </div>
        </div>

        <p class="vt-due" data-vt-due hidden></p>
        <div id="vt-content"></div>
        {PAYWALL && <div class="vt-limit" data-vt-limit hidden><PremiumLock feature="wortschatz" variant="limit-reached" /></div>}
      </div>
    </section>
  </div>

  <!-- Dev only, same as the grammar topics: the tour runs once per browser and there is
       no way to un-see it, so there has to be a way to un-remember it. A reload rather
       than intro.play(), because the interesting part is everything that happens BEFORE
       the tour decides to run — the restored preference, the collapsed first paint. This
       wipes both stored flags and reloads clean. Our own devices only (DemoDock.astro). -->
  <button type="button" class="vp-dev-reset" id="vp-dev-reset" title="Tour-Flags löschen und neu laden" data-i18n-attr="title:vp.devReset.title" data-i18n="vp.devReset">↻ Tour neu</button>

  {/* Where the side nav sits (variant A, decided 2026-10-03) — see NavLayout.astro. */}
  <NavLayout />
</main>

<script type="application/json" id="fc-data" data-runtime={runtime ? "" : undefined} set:html={JSON.stringify(cards)}></script>
<script type="application/json" id="fc-langs" set:html={JSON.stringify(languages)}></script>
<script>
  import { mountWortschatzApp } from "../lib/wortschatz-app.js";
  import { mountRuleColumn } from "../lib/ruleColumn.js";
  import { recordAttempt, recordSession } from "../lib/progress.js";
  import { cardId, dueCount, grade, nextDue, reviewsToday } from "../lib/srs.js";
  import { noteGrade, startSrsSync } from "../lib/srsSync.js";
  import { can, limitFor, PAYWALL } from "../lib/access.js";
  import { freeLimit as freeLimitOf, wouldLock } from "../lib/intent.js";
  import { initDeckSwap } from "../lib/deckSwap.js";
  import { nudgeStep } from "../lib/mascotNudge.js";
  import { mountZen } from "../lib/vtZen.js";

  // Once per page, not per deck: Zen stays on across a deck swap.
  mountZen();

  // Its own keys: whether you keep a grammar rule open says nothing about whether you
  // want the Lernset list beside your cards.
  //
  // Unlike a rule, this column is navigation, so it opens by default where there is room
  // for it — which is also why its tour is the other way round from a grammar page's. On
  // a desktop the learner can already see the list, so there is nothing to reveal; what
  // they cannot guess is that it folds away and leaves a tab behind, so that is what the
  // tour shows. On a phone the column starts collapsed like any other and the ordinary
  // telling applies.
  // On a desktop the column is always there — only its list folds, by the tab on its edge
  // (src/lib/sideNavFold.js) — so there is no layout preference left to store, and no
  // desktop tour: the list is on screen, and the tour's second beat pointed at a "hide the
  // whole column" switch that no longer exists. The phone keeps its one-beat telling.
  mountRuleColumn(document.getElementById("vp-page"), {
    seenKey: "da-wortschatz-lernsets-seen",
    mascot: "hamsti",
    defaultHidden: ({ wide }) => !wide,
    intro: !matchMedia("(min-width: 1001px)").matches,
    // Below 1001px the picker is a bottom sheet rather than an accordion — see the long
    // note in ruleColumn.js. Every row in it is a link to another page, so there was
    // never a reason for it to share the screen with the cards.
    sheet: true,
    coach: [
      ["intro.sets.title", "intro.sets.text"],
      ["intro.setsAway.title", "intro.setsAway.text"],
    ],
    // One beat on a phone, not two: the button opens a sheet over the cards, so there is
    // no "and this is how you put it away again" to tell — the sheet carries its own ✕.
    coachCompact: [
      ["intro.setsCompact.title", "intro.setsCompact.text"],
    ],
  });

  // Premium pulls the spaced-repetition state from the account first (src/lib/srsSync.js).
  await Promise.race([startSrsSync(), new Promise((r) => setTimeout(r, 1500))]);

  // One deck at a time: mounted here, and again whenever another set is picked from the
  // list and swapped in without a page load (src/lib/deckSwap.js).
  function mountDeck() {
  const deckCards = JSON.parse(document.getElementById("fc-data").textContent);
  const languages = JSON.parse(document.getElementById("fc-langs").textContent);

  // Spaced repetition (src/lib/srs.js): due cards first, then a few new ones, then the rest.
  const ids = deckCards.map(cardId);
  // The cards graded in this deck so far, for the mascot's "Noch 4" (mascotNudge.js).
  const answered = new Set();
  const deckId = location.pathname;
  const cards = nextDue(ids).map((i) => deckCards[i]);
  const dueEl = document.querySelector("[data-vt-due]");
  const showDue = () => {
    const n = dueCount(ids);
    dueEl.hidden = n === 0;
    dueEl.textContent = `Heute fällig: ${n}`;
  };
  showDue();

  // The free daily meter: 20 graded cards a day on this device (premium-features.json).
  // DELIBERATELY CLIENT-SIDE: the words are public and a review costs nothing; what Premium
  // pays for is the synced state above. Never put paid content behind a check like this.
  const meterOn = PAYWALL && !can("wortschatz");
  const freeLimit = limitFor("wortschatz").limit ?? Infinity;
  const limitEl = document.querySelector("[data-vt-limit]");
  const underLimit = () => !meterOn || reviewsToday() < freeLimit;
  const showLimit = () => {
    if (limitEl && !underLimit()) limitEl.hidden = false;
  };
  showLimit();

  // Night mode used to be page-local here; it is now the site-wide toggle in the
  // header, so .vt-shell just reads <html data-theme> from vokabeltrainer.css.

  return mountWortschatzApp(
    {
      tabsEl: document.getElementById("vt-tabs"),
      langTabsEl: document.getElementById("vt-lang-tabs"),
      deckChip: document.getElementById("vt-deck-chip"),
      counterEl: document.getElementById("vt-position"),
      contentEl: document.getElementById("vt-content"),
      eyebrowEl: document.getElementById("vt-eyebrow"),
    },
    cards,
    languages,
    {
      // Checked after each grade: at the limit the round ends on its result screen and the
      // lock appears under it. A learner who opens the page at the limit still sees the
      // cards and the list — only grading more is what the lock is about.
      canContinue: () => {
        const ok = underLimit();
        if (!ok) showLimit();
        return ok;
      },
      onAnswer: (ok, card) => {
        grade(cardId(card), ok);
        // traffic-baseline: would_lock — the meter's own check (reviewsToday() against the
        // free limit), whether or not the paywall is on: the next card would be refused.
        wouldLock("wortschatz", reviewsToday() >= freeLimitOf("wortschatz"));
        noteGrade();
        showDue();
        recordAttempt({ skill: "wortschatz", correct: ok, id: card.front, trackVocab: true });
        // The side nav's "12/25" per set listens for this.
        dispatchEvent(new CustomEvent("da:progress", { detail: { topic: "wortschatz", correct: ok } }));
        // Hamsti, now and then, with a quiet word — and "Noch 4" near the end of the deck.
        answered.add(cardId(card));
        nudgeStep({ area: "wortschatz", correct: ok, left: deckCards.length - answered.size, set: deckId });
      },
      onSessionStart: () => recordSession("wortschatz"),
    }
  );
  }

  // A runtime deck (prop `runtime`): wait until the page has put its cards in.
  if (document.getElementById("fc-data").hasAttribute("data-runtime")) {
    await new Promise((r) => ((window as any).__vtCardsReady ? r(null) : addEventListener("vt:cards", r, { once: true })));
  }
  let app = mountDeck();
  initDeckSwap({
    onSwap: () => {
      app.destroy();
      app = mountDeck();
    },
  });
</script>
