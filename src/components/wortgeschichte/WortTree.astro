---
// The Stammbaum of a Wortgeschichte entry, drawn as a tree: the root word at the bottom
// with its roots, a trunk, one branch per language family, and the modern words up in the
// leaves (like the "Mother tongue" tree). The words are HTML chips placed on a CSS grid —
// they wrap and stay crisp on a phone — and src/lib/wortTreeDraw.js draws trunk, branches
// and leaves behind them as SVG, measured from where the chips actually landed.
//
// Grid rows, top to bottom: [twig row] · node rows (newest at the top) · branch names ·
// trunk · root. Columns: one per branch. The DOM keeps the nesting (branch > nodes), so it
// still reads as nested lists without CSS or to a screen reader.
interface Node { form: string; lang?: string; meaning?: string; certainty?: string }
interface Props {
  tree: { root: Node; branches: { name: string; nodes: Node[]; twig?: Node }[] };
}
const { tree } = Astro.props;
const CERT_DE: Record<string, string> = { sicher: "sicher", wahrscheinlich: "wahrscheinlich", umstritten: "umstritten", unklar: "unklar" };

const branches = tree.branches.filter((b) => b.nodes?.length);
const T = branches.some((b) => b.twig) ? 1 : 0;
const maxK = Math.max(1, ...branches.map((b) => b.nodes.length));
const R = T + maxK;
const cols = Math.max(1, branches.length);
/** Oldest node i of k sits lowest; the newest is at the top of the node rows. */
const rowOf = (k: number, i: number) => 1 + T + (k - 1 - i);
---
<figure class="wg-tree" lang="de" data-wg-tree>
  <figcaption class="wg-sub" data-i18n="wg.tree">Der Stammbaum</figcaption>
  <div class="wg-tree-grid" data-cols={cols} style={`--wg-cols:${cols};--wg-rows:${R}`}>
    <svg class="wg-tree-lines" aria-hidden="true" focusable="false"></svg>
    <ul class="wg-branches">
      {branches.map((b, c) => (
        <li class="wg-branch" data-col={c}>
          <h3 class="wg-branch-name" style={`grid-row:${R + 1};grid-column:${c + 1}`}>{b.name}</h3>
          <ol>
            {b.nodes.map((n, i) => (
              <li
                class:list={["wg-leaf", i === b.nodes.length - 1 && "is-top"]}
                data-i={i}
                style={`grid-row:${rowOf(b.nodes.length, i)};grid-column:${c + 1}`}
              >
                <b>{n.form}</b>{n.lang && <small>{n.lang}</small>}{n.meaning && <i>‚{n.meaning}‘</i>}
              </li>
            ))}
          </ol>
          {b.twig && (
            <p class="wg-leaf is-twig" style={`grid-row:1;grid-column:${c + 1}`}>
              <b>{b.twig.form}</b>{b.twig.lang && <small>{b.twig.lang}</small>}{b.twig.meaning && <i>‚{b.twig.meaning}‘</i>}
            </p>
          )}
        </li>
      ))}
    </ul>
    <div class="wg-tree-rootcell" style={`grid-row:${R + 3}`}>
      <div class="wg-leaf is-root">
        <small>{tree.root.lang}</small>
        <b>{tree.root.form}</b>
        {tree.root.meaning && <i>‚{tree.root.meaning}‘</i>}
        {tree.root.certainty && <span class={`wg-cert wg-cert--${tree.root.certainty}`} data-i18n={`wg.cert.${tree.root.certainty}`}>{CERT_DE[tree.root.certainty]}</span>}
      </div>
    </div>
  </div>
</figure>
