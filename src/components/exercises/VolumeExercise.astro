---
import ShadowRecorder from '../ShadowRecorder.astro';
import { referencePhrase, volumeLevels, readingPassage } from '../../data/exercises/volume';

const ttsUrl = (text: string) => `/api/tts?text=${encodeURIComponent(text)}`;
---

<div class="volume-block">
  <h2>Record &amp; compare</h2>
  <p class="text-muted">
    Play the model line for pacing and content, then record yourself at each level below. Use the meter
    further down to find the zone first, then try landing in it without looking.
  </p>

  <div class="level-list">
    {volumeLevels.map((level) => (
      <div class="card level-row">
        <div class="level-row__head">
          <span class="tag">{level.label}</span>
          <span class="text-muted level-row__hint">{level.hint}</span>
        </div>
        <ShadowRecorder audioSrc={ttsUrl(referencePhrase)} label={`Model: "${referencePhrase}"`} />
      </div>
    ))}
  </div>
</div>

<div class="volume-block">
  <h2>Find the zones</h2>
  <p class="text-muted">
    This meter reads your microphone's relative level, not a calibrated decibel — it's here so you can
    <em>see</em> quiet, conversational, and projected before you try to hit them from memory. Read the
    passage below at a few different levels and watch where the needle lands.
  </p>
  <div class="card meter-card">
    <div class="meter-controls">
      <button type="button" class="button button--primary" data-role="meter-toggle">🎙 Start meter</button>
      <span class="meter-status text-muted" data-role="meter-status" aria-live="polite"></span>
    </div>
    <div class="meter" data-role="meter">
      <div class="meter__track">
        <div class="meter__fill" data-role="meter-fill"></div>
        <div class="meter__mark" style="left: 30%"></div>
        <div class="meter__mark" style="left: 65%"></div>
      </div>
      <div class="meter__zones">
        <span>Quiet</span>
        <span>Conversational</span>
        <span>Projected</span>
      </div>
    </div>
    <p class="meter-passage">{readingPassage}</p>
  </div>
</div>

<script>
  const meters = document.querySelectorAll<HTMLElement>('[data-role="meter"]');

  meters.forEach((meter) => {
    const card = meter.closest('.meter-card');
    const toggleBtn = card?.querySelector<HTMLButtonElement>('[data-role="meter-toggle"]');
    const status = card?.querySelector<HTMLElement>('[data-role="meter-status"]');
    const fill = meter.querySelector<HTMLElement>('[data-role="meter-fill"]');

    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let stream: MediaStream | null = null;
    let rafId: number | null = null;
    let data: Uint8Array | null = null;

    function stop() {
      if (rafId != null) cancelAnimationFrame(rafId);
      rafId = null;
      stream?.getTracks().forEach((track) => track.stop());
      stream = null;
      audioCtx?.close();
      audioCtx = null;
      analyser = null;
      if (fill) fill.style.width = '0%';
      if (toggleBtn) toggleBtn.textContent = '🎙 Start meter';
      if (status) status.textContent = '';
    }

    function tick() {
      if (!analyser || !data || !fill) return;
      analyser.getByteTimeDomainData(data);
      let sumSquares = 0;
      for (let i = 0; i < data.length; i++) {
        const centered = (data[i] - 128) / 128;
        sumSquares += centered * centered;
      }
      const rms = Math.sqrt(sumSquares / data.length);
      // Perceptual compression so quiet speech still moves the needle
      // noticeably, instead of the meter only reacting once it's loud.
      const level = Math.min(100, Math.pow(rms, 0.6) * 220);
      fill.style.width = `${level}%`;
      rafId = requestAnimationFrame(tick);
    }

    toggleBtn?.addEventListener('click', async () => {
      if (audioCtx) {
        stop();
        return;
      }

      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch {
        if (status) status.textContent = 'Microphone access denied.';
        return;
      }

      const AudioCtx = window.AudioContext ?? (window as any).webkitAudioContext;
      audioCtx = new AudioCtx();
      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 2048;
      data = new Uint8Array(analyser.frequencyBinCount);

      const source = audioCtx.createMediaStreamSource(stream);
      source.connect(analyser); // analysis only — never connected to destination, so no feedback

      if (toggleBtn) toggleBtn.textContent = '■ Stop meter';
      if (status) status.textContent = 'Listening…';
      tick();
    });
  });
</script>

<style>
  .volume-block {
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .volume-block h2 {
    margin-block-end: 0.4rem;
  }

  .meter-card {
    margin-block-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .meter-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .meter-status {
    font-size: 0.85rem;
  }

  .meter__track {
    position: relative;
    height: 14px;
    border-radius: 999px;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .meter__fill {
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
    transition: width 0.06s linear;
  }

  .meter__mark {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(36, 32, 27, 0.35);
  }

  .meter__zones {
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  .meter-passage {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text);
    max-width: 60ch;
    margin: 0;
  }

  .level-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block-start: 1.25rem;
  }

  .level-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .level-row__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .level-row__hint {
    font-size: 0.88rem;
  }
</style>
