---
import { breathingRoutineText, selfAssessmentChecklist } from '../../data/exercises/voice';

const ttsUrl = (text: string) => `/api/tts?text=${encodeURIComponent(text)}`;
---

<div class="voice-block">
  <h2>Guided breath support</h2>
  <p class="text-muted">
    Most strain in a speaking voice starts with shallow, chest-only breathing. This routine paces a
    low, steady breath — in for four, hold for two, out for six — three times through.
  </p>
  <div class="card breathing-player">
    <audio id="breathing-audio" src={ttsUrl(breathingRoutineText)} preload="none"></audio>
    <button type="button" class="button button--primary" id="play-breathing">▶ Start the routine (~40s)</button>
  </div>
</div>

<div class="voice-block">
  <h2>Self-assessment checklist</h2>
  <p class="text-muted">Go through this after a few minutes of talking or reading aloud.</p>
  <div class="card checklist-card">
    <ul class="checklist">
      {selfAssessmentChecklist.map((item) => (
        <li>
          <label>
            <input type="checkbox" />
            {item.label}
          </label>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  document.getElementById('play-breathing')?.addEventListener('click', () => {
    const audio = document.getElementById('breathing-audio') as HTMLAudioElement | null;
    audio?.play();
  });
</script>

<style>
  .voice-block {
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }

  .voice-block h2 {
    margin-block-end: 0.4rem;
  }

  .breathing-player {
    margin-block-start: 1.25rem;
    display: flex;
    align-items: center;
  }

  .checklist-card {
    margin-block-start: 1.25rem;
  }

  .checklist {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .checklist label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.95rem;
  }

  .checklist input {
    margin-top: 0.2rem;
  }

  @media print {
    .site-header,
    .site-footer,
    #print-worksheet,
    .breathing-player {
      display: none !important;
    }
  }
</style>
