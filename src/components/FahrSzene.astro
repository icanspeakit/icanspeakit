---
// One top-down traffic scene (src/lib/fahrSzene.js, data in src/data/fuehrerschein/szenen.json).
//
// Server-rendered as a still: every vehicle at its start, numbered arrows for what happens,
// and the steps written out below as a numbered list — that is what a page without
// JavaScript, a screen reader, or reduced motion gets, and it is complete on its own.
// With motion welcome, the scene plays once when most of it is in view (fahrSzenePlayer.js):
// the vehicles drive their arrows step by step, the step being played lights up in the list,
// and the dots let a learner jump back to any step. „Nochmal ansehen" plays it from the start.
//
// The scene is content and always stays. Only the mascot faces — in the cars and in front of
// the sentences — are data-mascot-part, so „Maskottchen anzeigen: aus" leaves plain cars;
// the names stay, as the characters of the story. The sentences are the German to learn —
// never translated.
import { szeneFigureHtml } from "../lib/fahrSzene.js";
import { szene, fillDeep } from "../lib/fuehrerschein.js";
import "../styles/fahr-szene.css";

interface Props {
  /** A scene id in szenen.json, or the scene itself. */
  id?: string;
  scene?: any;
  compact?: boolean;
}
const { id, scene: given, compact = false } = Astro.props;
// Every {{fakt:…}} in the sentences filled from the research file, like all page copy.
const scene = given ? fillDeep(given) : szene(id!);
---
<Fragment set:html={szeneFigureHtml(scene, { compact })} />

<script>
  import { mountSzenen } from "../lib/fahrSzenePlayer.js";
  mountSzenen();
</script>
