---
// „Free PDF: English Grammar Start“ — the free starter book
// (scripts/generate-grammatik-start-pdf.mjs), pointed to from the Grammatik hub and the
// homepage's Grammatik card. Opens its sheet on /knowledge (the card's id is the hash).
//
// Regi stands outside the data-i18n elements: the i18n pass replaces textContent and
// would wipe the SVG (MASKOTTCHEN-PLATZIERUNG-PROMPT.md). data-mascot-part lets
// „Maskottchen: aus“ remove him and keep the link.
import { mascotSvg } from "../lib/mascots.js";

interface Props {
  /** Small, for inside a card (the homepage). */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const regi = mascotSvg({ name: "regi", expr: "happy", view: "three", size: compact ? 34 : 46, label: "" });
---
<a class:list={["gs-teaser", compact && "gs-teaser--compact"]} href="/knowledge#grammatik-start">
  <span class="gs-teaser-fig" data-mascot-part aria-hidden="true"><Fragment set:html={regi} /></span>
  <span class="gs-teaser-txt">
    <b data-i18n="gs.teaser.title">Free PDF: English Grammar Start</b>
    <span data-i18n="gs.teaser.sub">The 10 most important chapters, A1 to B1</span>
  </span>
  <span class="gs-teaser-go" aria-hidden="true">→</span>
</a>

<style>
  .gs-teaser {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-lg, 14px);
    border: 1px solid var(--border);
    background: var(--surface-card);
    color: inherit;
    text-decoration: none;
    transition: border-color .15s ease, transform .15s ease;
  }
  .gs-teaser:hover { border-color: var(--brand-blue); }
  .gs-teaser:active { transform: translateY(1px); }
  .gs-teaser-fig { flex: none; display: inline-flex; }
  .gs-teaser-txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; flex: 1; }
  .gs-teaser-txt b { font-size: .975rem; font-weight: var(--fw-bold, 700); color: var(--ink); }
  .gs-teaser-txt span { font-size: .8125rem; line-height: 1.45; color: var(--muted); }
  .gs-teaser-go {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--brand-blue);
    color: #fff;
    font-weight: 700;
  }
  .gs-teaser--compact { padding: 8px 10px; gap: 8px; margin-top: 4px; }
  .gs-teaser--compact .gs-teaser-txt b { font-size: .875rem; }
  .gs-teaser--compact .gs-teaser-txt span { font-size: .75rem; }
  .gs-teaser--compact .gs-teaser-go { width: 24px; height: 24px; font-size: .8rem; }
</style>
